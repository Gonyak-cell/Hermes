{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hermes.local/schemas/desktop-authority-boundary.schema.json",
  "title": "Hermes Desktop Authority Boundary",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "capability_id",
    "desktop_authority_contract",
    "forbidden_capability_rows",
    "electron_security_rows",
    "operator_handbook_binding_rows",
    "desktop_authority_boundary",
    "validation_items",
    "validation",
    "summary"
  ],
  "properties": {
    "schema_version": { "const": "desktop-authority-boundary.v1" },
    "capability_id": { "const": "desktop.authority_boundary" },
    "forbidden_capability_rows": { "type": "array", "minItems": 14, "items": { "$ref": "#/$defs/verdictRow" } },
    "electron_security_rows": { "type": "array", "minItems": 10, "items": { "$ref": "#/$defs/verdictRow" } },
    "operator_handbook_binding_rows": { "type": "array", "minItems": 8, "items": { "$ref": "#/$defs/verdictRow" } },
    "desktop_authority_boundary": {
      "type": "object",
      "required": [
        "boundary_status",
        "read_only",
        "operator_surface_only",
        "operator_handbook_bound",
        "operator_surface_parallel_definition_created",
        "source_of_truth",
        "command_execution_allowed_now",
        "shell_execution_allowed_now",
        "renderer_shell_execution_allowed_now",
        "filesystem_write_allowed_now",
        "git_push_allowed_now",
        "git_write_allowed_now",
        "approval_application_allowed_now",
        "receipt_application_allowed_now",
        "connector_write_allowed_now",
        "secret_read_allowed_now",
        "raw_source_exposure_allowed",
        "external_renderer_network_allowed_now",
        "deployment_allowed_now",
        "release_approval_allowed_now",
        "write_action_allowed_now",
        "runtime_execution_allowed_now",
        "protected_action_allowed_now",
        "protected_closeout_enabled",
        "production_pass_enabled",
        "enterprise_pass_enabled",
        "enterprise_trust_claim_allowed_now",
        "desktop_write_authority_enabled",
        "human_gate_bypass_allowed",
        "final_approval_ui_enabled",
        "codex_final_approval_ui_enabled",
        "claude_final_approval_ui_enabled",
        "unsafe_flag_count",
        "ready_for_desktop_read_model"
      ],
      "properties": {
        "boundary_status": {
          "enum": ["enforced_read_only_desktop_boundary", "blocked_desktop_boundary"]
        },
        "read_only": { "const": true },
        "operator_surface_only": { "const": true },
        "operator_handbook_bound": { "type": "boolean" },
        "operator_surface_parallel_definition_created": { "const": false },
        "source_of_truth": { "const": false },
        "command_execution_allowed_now": { "const": false },
        "shell_execution_allowed_now": { "const": false },
        "renderer_shell_execution_allowed_now": { "const": false },
        "filesystem_write_allowed_now": { "const": false },
        "git_push_allowed_now": { "const": false },
        "git_write_allowed_now": { "const": false },
        "approval_application_allowed_now": { "const": false },
        "receipt_application_allowed_now": { "const": false },
        "connector_write_allowed_now": { "const": false },
        "secret_read_allowed_now": { "const": false },
        "raw_source_exposure_allowed": { "const": false },
        "external_renderer_network_allowed_now": { "const": false },
        "deployment_allowed_now": { "const": false },
        "release_approval_allowed_now": { "const": false },
        "write_action_allowed_now": { "const": false },
        "runtime_execution_allowed_now": { "const": false },
        "protected_action_allowed_now": { "const": false },
        "protected_closeout_enabled": { "const": false },
        "production_pass_enabled": { "const": false },
        "enterprise_pass_enabled": { "const": false },
        "enterprise_trust_claim_allowed_now": { "const": false },
        "desktop_write_authority_enabled": { "const": false },
        "human_gate_bypass_allowed": { "const": false },
        "final_approval_ui_enabled": { "const": false },
        "codex_final_approval_ui_enabled": { "const": false },
        "claude_final_approval_ui_enabled": { "const": false },
        "unsafe_flag_count": { "const": 0 },
        "ready_for_desktop_read_model": { "type": "boolean" }
      }
    },
    "validation": {
      "type": "object",
      "required": ["valid", "error_count", "errors"],
      "properties": {
        "valid": { "type": "boolean" },
        "error_count": { "type": "integer", "minimum": 0 },
        "errors": { "type": "array" }
      }
    },
    "summary": {
      "type": "object",
      "required": [
        "desktop_authority_boundary_status",
        "forbidden_capability_count",
        "closed_forbidden_capability_count",
        "electron_security_row_count",
        "ready_electron_security_row_count",
        "operator_handbook_bound",
        "source_of_truth",
        "command_execution_allowed_now",
        "shell_execution_allowed_now",
        "git_push_allowed_now",
        "approval_application_allowed_now",
        "receipt_application_allowed_now",
        "connector_write_allowed_now",
        "secret_read_allowed_now",
        "raw_source_exposure_allowed",
        "external_renderer_network_allowed_now",
        "deployment_allowed_now",
        "production_pass_enabled",
        "enterprise_pass_enabled",
        "protected_closeout_enabled",
        "desktop_write_authority_enabled",
        "human_gate_bypass_allowed",
        "unsafe_flag_count",
        "validation_error_count"
      ],
      "properties": {
        "desktop_authority_boundary_status": {
          "enum": ["enforced_read_only_desktop_boundary", "blocked_desktop_boundary"]
        },
        "forbidden_capability_count": { "type": "integer", "minimum": 14 },
        "closed_forbidden_capability_count": { "type": "integer", "minimum": 0 },
        "electron_security_row_count": { "type": "integer", "minimum": 10 },
        "ready_electron_security_row_count": { "type": "integer", "minimum": 0 },
        "operator_handbook_bound": { "type": "boolean" },
        "source_of_truth": { "const": false },
        "command_execution_allowed_now": { "const": false },
        "shell_execution_allowed_now": { "const": false },
        "git_push_allowed_now": { "const": false },
        "approval_application_allowed_now": { "const": false },
        "receipt_application_allowed_now": { "const": false },
        "connector_write_allowed_now": { "const": false },
        "secret_read_allowed_now": { "const": false },
        "raw_source_exposure_allowed": { "const": false },
        "external_renderer_network_allowed_now": { "const": false },
        "deployment_allowed_now": { "const": false },
        "production_pass_enabled": { "const": false },
        "enterprise_pass_enabled": { "const": false },
        "protected_closeout_enabled": { "const": false },
        "desktop_write_authority_enabled": { "const": false },
        "human_gate_bypass_allowed": { "const": false },
        "unsafe_flag_count": { "const": 0 },
        "validation_error_count": { "type": "integer", "minimum": 0 }
      }
    }
  },
  "$defs": {
    "verdictRow": {
      "type": "object",
      "required": ["row_id", "current_verdict", "generated_at"],
      "properties": {
        "row_id": { "type": "string", "minLength": 1 },
        "current_verdict": { "enum": ["pass", "blocked"] },
        "generated_at": { "type": "string" }
      }
    }
  }
}
