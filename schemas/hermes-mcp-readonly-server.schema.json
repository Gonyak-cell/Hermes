{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hermes.local/schemas/hermes-mcp-readonly-server.schema.json",
  "title": "Hermes MCP Read-Only Server",
  "type": "object",
  "required": [
    "schema_version",
    "generated_at",
    "hermes_mcp_readonly_server_id",
    "server_id",
    "command_name",
    "serve_script_name",
    "protocol_version",
    "mcp_tranche",
    "mcp_mode",
    "inputs",
    "source_registry",
    "server_capabilities",
    "mcp_resources",
    "mcp_tools",
    "authority_boundary",
    "validation_items",
    "validation",
    "summary"
  ],
  "properties": {
    "schema_version": { "const": "hermes-mcp-readonly-server.v1" },
    "server_id": { "const": "platform.hermes_mcp.readonly_server" },
    "command_name": { "const": "platform:hermes-mcp-readonly-server" },
    "serve_script_name": { "const": "mcp:serve" },
    "protocol_version": { "const": "2025-06-18" },
    "mcp_tranche": { "const": "H-MCP-03" },
    "mcp_mode": { "const": "stdio_check_only_tool_adapter" },
    "source_registry": {
      "type": "object",
      "required": ["schema_version", "registry_id", "status", "resource_count", "tool_count", "blocked_authority_count", "source_of_truth", "validation_error_count"],
      "properties": {
        "schema_version": { "const": "hermes-mcp-capability-registry.v1" },
        "status": { "const": "ready_for_hermes_mcp_capability_registry" },
        "source_of_truth": { "const": "repo_artifacts_schemas" },
        "validation_error_count": { "const": 0 }
      }
    },
    "server_capabilities": {
      "type": "object",
      "required": ["resources", "tools"],
      "properties": {
        "resources": { "type": "object" },
        "tools": { "type": "object" }
      }
    },
    "mcp_resources": {
      "type": "array",
      "minItems": 8,
      "items": {
        "type": "object",
        "required": [
          "uri",
          "name",
          "title",
          "description",
          "mimeType",
          "source_ref",
          "read_model_kind",
          "read_model_available",
          "mutation_allowed_now",
          "protected_action_allowed_now",
          "raw_secret_context_allowed",
          "raw_restricted_payload_allowed",
          "source_status"
        ],
        "properties": {
          "mimeType": { "const": "application/json" },
          "mutation_allowed_now": { "const": false },
          "protected_action_allowed_now": { "const": false },
          "raw_secret_context_allowed": { "const": false },
          "raw_restricted_payload_allowed": { "const": false }
        }
      }
    },
    "mcp_tools": {
      "type": "array",
      "minItems": 8,
      "items": {
        "type": "object",
        "required": [
          "name",
          "title",
          "description",
          "inputSchema",
          "outputSchema",
          "annotations",
          "package_script",
          "check_invocation",
          "check_command",
          "adapter_allowlisted",
          "check_mode_required",
          "check_timeout_ms",
          "invocation_mode",
          "mutation_allowed_now",
          "connector_write_allowed_now",
          "deployment_allowed_now",
          "protected_action_allowed_now",
          "final_approval_allowed_now"
