  "golden_cases": [
    {
      "case_id": "golden.trading.research_backtest_paper.safe_fixture",
      "description": "Research, backtest, and paper artifacts validate while live trading, live adapters, plaintext secrets, market orders, leverage, and shorting remain blocked.",
      "input_ref": "examples/trading/research-backtest-paper-sample.json",
      "expected_gate_results": ["classification_gate", "tool_permission_gate", "secrets_gate", "test_gate", "human_approval_gate"]
    },
    {
      "case_id": "golden.trading.strategy_taxonomy.p036_p060",
      "description": "P036-P060 strategy taxonomy registers archetypes, event models, risk, signal, conflict, correlation, capacity, and lifecycle contracts without generating live recommendations or orders.",
      "input_ref": "examples/trading/strategy-archetype-registry.json",
      "expected_gate_results": ["classification_gate", "tool_permission_gate", "secrets_gate", "test_gate", "human_approval_gate"]
    },
    {
      "case_id": "golden.trading.market_data_feature_store.p061_p090",
      "description": "P061-P090 market data and feature store validates manual/fixture ingestion, normalized OHLCV, sessions, quality gates, features, lineage, replay, and read-only dashboard/API without live vendor feeds or orders.",
      "input_ref": "examples/trading/market-data-feature-store.json",
      "expected_gate_results": ["classification_gate", "tool_permission_gate", "secrets_gate", "test_gate", "human_approval_gate"]
    },
    {
      "case_id": "golden.trading.signal_engine.p091_p125",
      "description": "P091-P125 signal engine validates strategy adapters, signal candidates, freshness, conflict detection, aggregation, review queue, attribution, and signal-only order-intent boundary.",
      "input_ref": "examples/trading/signal-engine.json",
      "expected_gate_results": ["classification_gate", "tool_permission_gate", "secrets_gate", "test_gate", "human_approval_gate"]
    },
    {
      "case_id": "golden.trading.model_improvement.p126_p165",
      "description": "P126-P165 model improvement layer validates model and dataset registries, leakage guards, scorecards, drift/degradation checks, promotion and rollback controls, and live-deployment blocking.",
      "input_ref": "examples/trading/model-improvement-layer.json",
      "expected_gate_results": ["classification_gate", "tool_permission_gate", "secrets_gate", "test_gate", "human_approval_gate"]
    },
    {
      "case_id": "golden.trading.backtest_validation.p166_p195",
      "description": "P166-P195 backtest validation layer validates deterministic backtest artifacts, cost models, bias checks, walk-forward validation, stress replay, and read-only dashboard/API without generating orders or promotion candidates.",
      "input_ref": "examples/trading/backtest-validation.json",
      "expected_gate_results": ["classification_gate", "tool_permission_gate", "secrets_gate", "test_gate", "human_approval_gate"]
