{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://amic.local/hermes/workflow-resume-cancel-contract.schema.json",
  "title": "Hermes Workflow Resume/Cancel Contract",
  "type": "object",
  "required": [
    "schema_version",
    "generated_at",
    "workflow_resume_cancel_contract_id",
    "output_dir",
    "inputs",
    "source_contracts",
    "workflow_resume_cancel_contract",
    "resume_cursor_records",
    "cancel_request_records",
    "resume_cancel_decision_records",
    "validation_items",
    "validation",
    "summary"
  ],
  "properties": {
    "schema_version": { "const": "workflow-resume-cancel-contract.v1" },
    "generated_at": { "type": "string", "format": "date-time" },
    "workflow_resume_cancel_contract_id": { "type": "string", "minLength": 1 },
    "output_dir": { "type": "string" },
    "inputs": { "type": "object" },
    "source_contracts": { "type": "object" },
    "workflow_resume_cancel_contract": {
      "type": "object",
      "required": [
        "schema_version",
        "resume_cancel_contract_id",
        "deterministic_control_semantics",
        "idempotency_required",
        "resume_policy",
        "cancel_policy",
        "protected_action_execution_allowed",
        "law_firm_safety_rule"
      ],
      "properties": {
        "schema_version": { "const": "workflow-resume-cancel-contract.v1" },
        "resume_cancel_contract_id": { "const": "workflow-resume-cancel-contract.v1" },
        "deterministic_control_semantics": { "const": true },
        "idempotency_required": { "const": true },
        "resume_policy": { "type": "object" },
        "cancel_policy": { "type": "object" },
        "protected_action_execution_allowed": { "const": false },
        "law_firm_safety_rule": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": true
    },
    "resume_cursor_records": {
      "type": "array",
      "items": { "$ref": "#/$defs/resume_cursor_record" }
    },
    "cancel_request_records": {
      "type": "array",
      "items": { "$ref": "#/$defs/cancel_request_record" }
    },
    "resume_cancel_decision_records": {
      "type": "array",
      "items": { "$ref": "#/$defs/resume_cancel_decision_record" }
    },
    "validation_items": {
      "type": "array",
      "items": { "$ref": "#/$defs/validation_item" }
    },
    "validation": {
      "type": "object",
      "required": ["valid", "errors"],
      "properties": {
        "valid": { "type": "boolean" },
        "errors": {
          "type": "array",
          "items": { "$ref": "#/$defs/validation_error" }
        }
      },
      "additionalProperties": true
    },
    "summary": {
      "type": "object",
      "required": [
        "workflow_resume_cancel_status",
        "resume_cancel_contract_id",
        "source_workflow_idempotency_status",
        "source_workflow_queue_retry_backoff_status",
        "source_workflow_state_machine_runner_status",
        "source_workflow_run_ledger_status",
        "source_idempotency_key_count",
        "source_workflow_queue_record_count",
        "source_runner_plan_count",
        "source_workflow_run_record_count",
        "resume_cursor_count",
        "cancel_request_count",
        "resume_cancel_decision_count",
        "long_running_workflow_count",
        "held_resume_count",
        "safe_cancel_request_count",
        "auto_resume_allowed_count",
        "auto_cancel_allowed_count",
        "protected_action_executed_count",
        "new_run_created_count",
        "validation_item_count",
        "validation_error_count"
      ],
      "properties": {
        "workflow_resume_cancel_status": { "enum": ["complete", "blocked"] },
        "resume_cancel_contract_id": { "const": "workflow-resume-cancel-contract.v1" },
        "source_workflow_idempotency_status": { "type": "string" },
        "source_workflow_queue_retry_backoff_status": { "type": "string" },
        "source_workflow_state_machine_runner_status": { "type": "string" },
        "source_workflow_run_ledger_status": { "type": "string" },
        "source_idempotency_key_count": { "type": "integer", "minimum": 0 },
        "source_workflow_queue_record_count": { "type": "integer", "minimum": 0 },
        "source_runner_plan_count": { "type": "integer", "minimum": 0 },
        "source_workflow_run_record_count": { "type": "integer", "minimum": 0 },
        "resume_cursor_count": { "type": "integer", "minimum": 0 },
        "cancel_request_count": { "type": "integer", "minimum": 0 },
        "resume_cancel_decision_count": { "type": "integer", "minimum": 0 },
        "resume_decision_count": { "type": "integer", "minimum": 0 },
        "cancel_decision_count": { "type": "integer", "minimum": 0 },
        "long_running_workflow_count": { "type": "integer", "minimum": 0 },
        "resume_required_count": { "type": "integer", "minimum": 0 },
        "resume_blocked_count": { "type": "integer", "minimum": 0 },
        "held_resume_count": { "type": "integer", "minimum": 0 },
        "human_gate_resume_count": { "type": "integer", "minimum": 0 },
        "law_firm_resume_cursor_count": { "type": "integer", "minimum": 0 },
        "law_firm_resume_held_count": { "type": "integer", "minimum": 0 },
        "safe_cancel_request_count": { "type": "integer", "minimum": 0 },
        "cancel_request_pending_human_count": { "type": "integer", "minimum": 0 },
        "cancel_event_append_required_count": { "type": "integer", "minimum": 0 },
        "law_firm_cancel_request_count": { "type": "integer", "minimum": 0 },
        "auto_resume_allowed_count": { "type": "integer", "minimum": 0 },
        "auto_cancel_allowed_count": { "type": "integer", "minimum": 0 },
        "destructive_cancel_mutation_count": { "type": "integer", "minimum": 0 },
        "protected_action_executed_count": { "type": "integer", "minimum": 0 },
        "new_run_created_count": { "type": "integer", "minimum": 0 },
        "validation_item_count": { "type": "integer", "minimum": 0 },
        "failed_validation_item_count": { "type": "integer", "minimum": 0 },
        "validation_error_count": { "type": "integer", "minimum": 0 },
        "by_resume_state": { "type": "object" },
        "by_cancel_state": { "type": "object" },
        "by_cancel_request_status": { "type": "object" },
        "by_decision_status": { "type": "object" },
        "by_domain_pack": { "type": "object" }
      },
      "additionalProperties": true
    }
  },
  "$defs": {
    "resume_cursor_record": {
      "type": "object",
      "required": [
        "schema_version",
        "resume_cursor_record_id",
        "idempotency_key_record_id",
        "idempotency_key",
        "source_workflow_queue_record_id",
        "workflow_run_id",
        "canonical_workflow_run_id",
        "queue_status",
        "resume_state",
        "resume_required",
        "resume_blocked",
        "resume_preconditions",
        "next_resume_action",
        "long_running_workflow",
        "auto_resume_allowed",
        "new_run_created_on_resume",
        "protected_action_execution_allowed",
        "resume_cursor_hash"
      ],
      "properties": {
        "schema_version": { "const": "workflow-resume-cursor-record.v1" },
        "resume_cursor_record_id": { "type": "string", "minLength": 1 },
        "idempotency_key_record_id": { "type": "string", "minLength": 1 },
        "idempotency_key": { "type": "string", "minLength": 1 },
        "source_workflow_queue_record_id": { "type": "string", "minLength": 1 },
        "workflow_run_id": { "type": "string", "minLength": 1 },
        "canonical_workflow_run_id": { "type": "string", "minLength": 1 },
        "run_ledger_id": { "type": ["string", "null"] },
        "workflow_id": { "type": ["string", "null"] },
        "capability_id": { "type": ["string", "null"] },
        "domain_pack": { "type": "string", "minLength": 1 },
        "matter_id": { "type": ["string", "null"] },
        "policy_snapshot_id": { "type": ["string", "null"] },
        "current_dsl_state": { "type": ["string", "null"] },
        "next_dsl_state": { "type": ["string", "null"] },
        "transition_guard_id": { "type": ["string", "null"] },
        "queue_status": { "type": "string" },
        "dequeue_policy": { "type": ["string", "null"] },
        "resume_state": { "enum": ["held_waiting_for_human_gate", "ready_for_manual_resume"] },
        "resume_required": { "const": true },
        "resume_blocked": { "type": "boolean" },
        "resume_owner": { "type": "string" },
        "resume_preconditions": { "type": "array", "items": { "type": "string" } },
        "next_resume_action": { "type": "string" },
        "resume_allowed_after_human_gate": { "const": true },
        "human_review_required": { "type": "boolean" },
        "law_firm_human_review_required": { "type": "boolean" },
        "long_running_workflow": { "const": true },
        "auto_resume_allowed": { "const": false },
        "new_run_created_on_resume": { "const": false },
        "protected_action_execution_allowed": { "const": false },
        "cursor_status": { "const": "materialized" },
        "recorded_at": { "type": "string", "format": "date-time" },
        "resume_cursor_hash": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": true
    },
    "cancel_request_record": {
      "type": "object",
      "required": [
        "schema_version",
        "cancel_request_record_id",
        "idempotency_key_record_id",
        "idempotency_key",
        "source_workflow_queue_record_id",
        "workflow_run_id",
        "canonical_workflow_run_id",
        "cancel_request_status",
        "cancel_state",
        "cancel_preconditions",
        "next_cancel_action",
        "cancel_event_append_required",
        "safe_cancel_request",
        "auto_cancel_allowed",
        "destructive_mutation_allowed",
        "new_run_created_on_cancel",
        "protected_action_execution_allowed",
        "cancel_request_hash"
      ],
      "properties": {
        "schema_version": { "const": "workflow-cancel-request-record.v1" },
        "cancel_request_record_id": { "type": "string", "minLength": 1 },
        "idempotency_key_record_id": { "type": "string", "minLength": 1 },
        "idempotency_key": { "type": "string", "minLength": 1 },
        "source_workflow_queue_record_id": { "type": "string", "minLength": 1 },
        "workflow_run_id": { "type": "string", "minLength": 1 },
        "canonical_workflow_run_id": { "type": "string", "minLength": 1 },
        "run_ledger_id": { "type": ["string", "null"] },
        "workflow_id": { "type": ["string", "null"] },
        "capability_id": { "type": ["string", "null"] },
        "domain_pack": { "type": "string", "minLength": 1 },
        "matter_id": { "type": ["string", "null"] },
        "policy_snapshot_id": { "type": ["string", "null"] },
        "queue_status": { "type": "string" },
        "cancel_request_status": { "enum": ["requested_pending_human_review", "requested_pending_operator_review"] },
        "cancel_state": { "const": "cancel_requested_safe_hold" },
        "cancel_owner": { "type": "string" },
        "cancel_preconditions": { "type": "array", "items": { "type": "string" } },
        "next_cancel_action": { "type": "string" },
        "cancel_event_append_required": { "const": true },
        "safe_cancel_request": { "const": true },
        "held_status_preserved": { "type": "boolean" },
        "human_review_required": { "type": "boolean" },
        "law_firm_human_review_required": { "type": "boolean" },
        "long_running_workflow": { "const": true },
        "auto_cancel_allowed": { "const": false },
        "destructive_mutation_allowed": { "const": false },
        "new_run_created_on_cancel": { "const": false },
        "protected_action_execution_allowed": { "const": false },
        "requested_at": { "type": "string", "format": "date-time" },
        "cancel_request_hash": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": true
    },
    "resume_cancel_decision_record": {
      "type": "object",
      "required": [
        "schema_version",
        "resume_cancel_decision_record_id",
        "request_kind",
        "control_decision",
        "decision_status",
        "resume_cursor_record_id",
        "idempotency_key_record_id",
        "idempotency_key",
        "workflow_run_id",
        "canonical_workflow_run_id",
        "idempotency_decision",
        "new_run_created",
        "auto_resume_scheduled",
        "auto_cancel_executed",
        "protected_action_executed",
        "decision_hash"
      ],
      "properties": {
        "schema_version": { "const": "workflow-resume-cancel-decision-record.v1" },
        "resume_cancel_decision_record_id": { "type": "string", "minLength": 1 },
        "request_kind": { "enum": ["resume_request", "cancel_request"] },
        "control_decision": { "enum": ["resume_held_pending_human_gate", "resume_ready_for_manual_operator_gate", "cancel_request_recorded_safe_hold"] },
        "decision_status": { "enum": ["held_for_human_gate", "manual_gate_required", "cancel_request_recorded"] },
        "resume_cursor_record_id": { "type": "string", "minLength": 1 },
        "cancel_request_record_id": { "type": ["string", "null"] },
        "idempotency_key_record_id": { "type": "string", "minLength": 1 },
        "idempotency_key": { "type": "string", "minLength": 1 },
        "workflow_run_id": { "type": "string", "minLength": 1 },
        "canonical_workflow_run_id": { "type": "string", "minLength": 1 },
        "run_ledger_id": { "type": ["string", "null"] },
        "domain_pack": { "type": "string", "minLength": 1 },
        "policy_snapshot_id": { "type": ["string", "null"] },
        "human_review_required": { "type": "boolean" },
        "law_firm_human_review_required": { "type": "boolean" },
        "idempotency_decision": { "const": "same_run" },
        "new_run_created": { "const": false },
        "auto_resume_scheduled": { "const": false },
        "auto_cancel_executed": { "const": false },
        "protected_action_executed": { "const": false },
        "decided_at": { "type": "string", "format": "date-time" },
        "decision_hash": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": true
    },
    "validation_item": {
      "type": "object",
      "required": ["check_id", "path", "status", "message"],
      "properties": {
        "check_id": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 },
        "status": { "enum": ["passed", "failed"] },
        "message": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": true
    },
    "validation_error": {
      "type": "object",
      "required": ["path", "message"],
      "properties": {
        "path": { "type": "string" },
        "message": { "type": "string" }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
