          "timeout_authority": { "const": "harness_control_plane" },
          "timeout_status": { "enum": ["within_timeout", "timed_out"] },
          "timeout_seconds": { "type": "integer", "minimum": 1 },
          "heartbeat_interval_seconds": { "type": "integer", "minimum": 1 },
          "elapsed_seconds": { "type": "integer", "minimum": 0 },
          "timeout_deadline_at": { "type": "string", "format": "date-time" },
          "timed_out": { "type": "boolean" },
          "active_timeout": { "type": "boolean" },
          "timeout_action_status": { "enum": ["not_required", "requires_human_gate"] },
          "protected_control_action_required": { "type": "boolean" },
          "human_gate_required_for_control_action": { "const": true },
          "runtime_self_report_trusted": { "const": false },
          "desktop_timeout_override_allowed": { "const": false },
          "desktop_cancel_allowed": { "const": false },
          "desktop_resume_allowed": { "const": false },
          "desktop_clock_edit_allowed": { "const": false }
        }
      }
    },
    "runtime_lifecycle_ledger_bindings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "runtime_lifecycle_ledger_binding_id",
          "binding_authority",
          "binding_status",
          "agent_run_id",
          "agent_run_record_id",
          "workflow_run_id",
          "runtime_heartbeat_record_id",
          "runtime_timeout_record_id",
          "runtime_log_id",
          "normalized_log_id",
          "observability_trace_id",
          "correlation_trace_id",
          "heartbeat_status",
          "timeout_status",
          "timed_out",
          "runtime_self_report_trusted",
          "desktop_read_only"
        ],
        "properties": {
          "binding_authority": { "const": "harness_control_plane" },
          "binding_status": { "const": "bound" },
          "heartbeat_status": { "enum": ["observed_terminal", "watching"] },
          "timeout_status": { "enum": ["within_timeout", "timed_out"] },
          "timed_out": { "type": "boolean" },
          "runtime_self_report_trusted": { "const": false },
          "desktop_read_only": { "const": true }
        }
      }
    },
    "runtime_heartbeat_desktop_boundary": {
      "type": "object",
      "required": [
        "boundary_id",
        "boundary_status",
        "desktop_surface_policy",
        "read_only",
        "mutation_allowed",
        "protected_mutation_execution_allowed",
        "desktop_source_of_truth",
        "heartbeat_write_allowed",
        "timeout_override_allowed",
        "cancel_allowed",
        "resume_allowed",
        "clock_edit_allowed",
        "runtime_start_allowed",
        "runtime_process_control_allowed"
      ],
      "properties": {
        "boundary_status": { "const": "locked" },
        "read_only": { "const": true },
        "mutation_allowed": { "const": false },
        "protected_mutation_execution_allowed": { "const": false },
        "desktop_source_of_truth": { "const": false },
        "heartbeat_write_allowed": { "const": false },
        "timeout_override_allowed": { "const": false },
        "cancel_allowed": { "const": false },
        "resume_allowed": { "const": false },
        "clock_edit_allowed": { "const": false },
        "runtime_start_allowed": { "const": false },
        "runtime_process_control_allowed": { "const": false }
      }
    },
