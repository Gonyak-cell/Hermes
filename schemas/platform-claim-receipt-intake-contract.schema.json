{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hermes.local/schemas/platform-claim-receipt-intake-contract.schema.json",
  "title": "Platform Claim Receipt Intake Contract",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "generated_at",
    "platform_claim_receipt_intake_contract_id",
    "capability_id",
    "claim_receipt_intake_anchor",
    "claim_receipt_intake_contract_rows",
    "claim_receipt_intake_gate_rows",
    "claim_receipt_intake_boundary",
    "validation_items",
    "validation",
    "summary"
  ],
  "properties": {
    "schema_version": { "const": "platform-claim-receipt-intake-contract.v1" },
    "platform_claim_receipt_intake_contract_id": {
      "type": "string",
      "pattern": "^platform-claim-receipt-intake-contract\\.[0-9]{8}$"
    },
    "capability_id": { "const": "platform.claim_receipt_intake_contract" },
    "claim_receipt_intake_anchor": {
      "type": "object",
      "required": ["phase_slot", "previous_phase_slot", "next_phase_slot", "source_operations_freeze_status", "source_claim_count", "source_blocked_claim_count", "source_human_receipt_required_count"],
      "properties": {
        "phase_slot": { "const": "P501" },
        "previous_phase_slot": { "const": "P500" },
        "next_phase_slot": { "const": "P502" },
        "source_operations_freeze_status": { "const": "ready_for_claim_freeze" },
        "source_claim_count": { "const": 140 },
        "source_blocked_claim_count": { "const": 40 },
        "source_human_receipt_required_count": { "const": 40 }
      }
    },
    "claim_receipt_intake_contract_rows": {
      "type": "array",
      "minItems": 40,
      "maxItems": 40,
      "items": {
        "type": "object",
        "required": [
          "phase_slot",
          "claim_id",
          "claim_type",
          "human_receipt_required",
          "human_receipt_ref",
          "current_verdict",
          "current_block_reason",
          "next_allowed_action",
          "target_verdict_after_valid_receipt",
          "receipt_contract_status",
          "required_receipt_fields",
          "allowed_receipt_decisions",
          "receipt_input_contract_declared",
          "receipt_payload_present",
          "human_receipt_pending",
          "ready_for_human_input",
          "ready_for_validation",
          "ready_for_pass_promotion",
          "pass_promoted_by_contract",
          "blocked_state_preserved",
          "operations_freeze_consumed_in_memory",
          "operations_freeze_artifact_read_performed_by_contract",
          "command_execution_performed_by_contract",
          "artifact_write_performed_by_contract",
          "protected_action_executed_by_contract",
          "trading_order_submission_allowed_by_contract",
          "desktop_mutation_allowed_by_contract",
          "secret_exposure_allowed_by_contract",
          "human_review_required",
          "human_signoff_required"
        ],
        "properties": {
          "phase_slot": { "const": "P501" },
          "human_receipt_required": { "const": true },
          "human_receipt_ref": { "type": "null" },
          "current_verdict": { "const": "blocked" },
          "current_block_reason": { "const": "missing_human_receipt" },
          "target_verdict_after_valid_receipt": { "const": "pass_candidate" },
          "receipt_contract_status": { "enum": ["ready_for_claim_receipt_intake_contract", "blocked"] },
          "required_receipt_fields": {
            "type": "array",
            "contains": { "const": "human_receipt_ref" }
          },
          "allowed_receipt_decisions": {
            "type": "array",
            "contains": { "const": "approve_claim_pass_candidate" }
          },
          "receipt_input_contract_declared": { "const": true },
          "receipt_payload_present": { "const": false },
          "human_receipt_pending": { "const": true },
          "ready_for_human_input": { "const": true },
          "ready_for_validation": { "const": false },
          "ready_for_pass_promotion": { "const": false },
          "pass_promoted_by_contract": { "const": false },
          "blocked_state_preserved": { "const": true },
          "operations_freeze_consumed_in_memory": { "const": true },
          "operations_freeze_artifact_read_performed_by_contract": { "const": false },
          "command_execution_performed_by_contract": { "const": false },
          "artifact_write_performed_by_contract": { "const": false },
          "protected_action_executed_by_contract": { "const": false },
          "trading_order_submission_allowed_by_contract": { "const": false },
          "desktop_mutation_allowed_by_contract": { "const": false },
          "secret_exposure_allowed_by_contract": { "const": false },
          "human_review_required": { "const": true },
          "human_signoff_required": { "const": true }
        }
      }
    },
    "claim_receipt_intake_gate_rows": {
      "type": "array",
      "minItems": 10,
      "items": {
        "type": "object",
        "required": ["phase_slot", "gate_status", "receipt_received_by_contract", "receipt_validated_by_contract", "pass_promoted_by_contract", "protected_action_executed_by_contract", "secret_exposure_allowed_by_contract", "human_review_required", "human_signoff_required"],
        "properties": {
          "phase_slot": { "const": "P501" },
          "gate_status": { "const": "ready" },
          "receipt_received_by_contract": { "const": false },
          "receipt_validated_by_contract": { "const": false },
          "pass_promoted_by_contract": { "const": false },
          "protected_action_executed_by_contract": { "const": false },
          "secret_exposure_allowed_by_contract": { "const": false },
          "human_review_required": { "const": true },
          "human_signoff_required": { "const": true }
        }
      }
    },
    "claim_receipt_intake_boundary": {
      "type": "object",
      "required": [
        "boundary_status",
        "phase_slot",
        "read_only",
        "report_only",
        "claim_adjudication_layer",
        "source_operations_freeze_status",
        "source_claim_freeze_consumed_in_memory",
        "source_claim_freeze_artifact_read_performed",
        "receipt_contract_row_count",
        "ready_receipt_contract_row_count",
        "receipt_input_contract_declared",
        "human_receipt_pending",
        "ready_for_human_input",
        "ready_for_validation",
        "ready_for_pass_promotion",
        "receipt_payload_present",
        "receipt_received",
        "receipt_validated",
        "approval_applied",
        "pass_promoted",
        "blocked_state_preserved",
        "command_execution_performed",
        "artifact_write_performed",
        "protected_action_executed",
        "trading_order_submission_allowed",
        "desktop_mutation_allowed",
        "secret_exposure_allowed",
        "human_review_required",
        "human_signoff_required"
      ],
      "properties": {
        "boundary_status": { "const": "enforced" },
        "phase_slot": { "const": "P501" },
        "read_only": { "const": true },
        "report_only": { "const": true },
        "claim_adjudication_layer": { "const": true },
        "source_operations_freeze_status": { "const": "ready_for_claim_freeze" },
        "source_claim_freeze_consumed_in_memory": { "const": true },
        "source_claim_freeze_artifact_read_performed": { "const": false },
        "receipt_contract_row_count": { "const": 40 },
        "ready_receipt_contract_row_count": { "const": 40 },
        "receipt_input_contract_declared": { "const": true },
        "human_receipt_pending": { "const": true },
        "ready_for_human_input": { "const": true },
        "ready_for_validation": { "const": false },
        "ready_for_pass_promotion": { "const": false },
        "receipt_payload_present": { "const": false },
        "receipt_received": { "const": false },
        "receipt_validated": { "const": false },
        "approval_applied": { "const": false },
        "pass_promoted": { "const": false },
        "blocked_state_preserved": { "const": true },
        "command_execution_performed": { "const": false },
        "artifact_write_performed": { "const": false },
        "protected_action_executed": { "const": false },
        "trading_order_submission_allowed": { "const": false },
        "desktop_mutation_allowed": { "const": false },
        "secret_exposure_allowed": { "const": false },
        "human_review_required": { "const": true },
        "human_signoff_required": { "const": true }
      }
    },
    "summary": {
      "type": "object",
      "required": [
        "platform_claim_receipt_intake_contract_status",
        "phase_slot",
        "previous_phase_slot",
        "next_phase_slot",
        "source_operations_freeze_status",
        "source_claim_count",
        "source_blocked_claim_count",
        "receipt_contract_row_count",
        "ready_receipt_contract_row_count",
        "contract_gate_count",
        "ready_contract_gate_count",
        "human_receipt_pending",
        "ready_for_human_input",
        "ready_for_validation",
        "ready_for_pass_promotion",
        "receipt_received",
        "receipt_validated",
        "approval_applied",
        "pass_promoted",
        "blocked_state_preserved",
        "validation_error_count"
      ],
      "properties": {
        "platform_claim_receipt_intake_contract_status": { "const": "ready_for_claim_receipt_intake_contract" },
        "phase_slot": { "const": "P501" },
        "previous_phase_slot": { "const": "P500" },
        "next_phase_slot": { "const": "P502" },
        "source_operations_freeze_status": { "const": "ready_for_claim_freeze" },
        "source_claim_count": { "const": 140 },
        "source_blocked_claim_count": { "const": 40 },
        "receipt_contract_row_count": { "const": 40 },
        "ready_receipt_contract_row_count": { "const": 40 },
        "contract_gate_count": { "const": 10 },
        "ready_contract_gate_count": { "const": 10 },
        "human_receipt_pending": { "const": true },
        "ready_for_human_input": { "const": true },
        "ready_for_validation": { "const": false },
        "ready_for_pass_promotion": { "const": false },
        "receipt_received": { "const": false },
        "receipt_validated": { "const": false },
        "approval_applied": { "const": false },
        "pass_promoted": { "const": false },
        "blocked_state_preserved": { "const": true },
        "validation_error_count": { "const": 0 }
      }
    }
  }
}
