{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://amic.local/hermes/approval-decision-result.schema.json",
  "title": "Hermes Approval Decision Result",
  "type": "object",
  "required": [
    "schema_version",
    "generated_at",
    "source_queue",
    "source_decisions",
    "summary",
    "applied_items",
    "unapplied_items",
    "audit_events",
    "decision_errors"
  ],
  "properties": {
    "schema_version": {
      "const": "approval-decision-result.v1"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "source_queue": {
      "type": "string"
    },
    "source_decisions": {
      "type": "string"
    },
    "summary": {
      "type": "object",
      "required": [
        "queue_item_count",
        "applied_count",
        "pending_count",
        "approved_count",
        "rejected_count",
        "changes_requested_count",
        "resolved_or_waived_count",
        "follow_up_count"
      ],
      "properties": {
        "queue_item_count": {
          "type": "integer",
          "minimum": 0
        },
        "applied_count": {
          "type": "integer",
          "minimum": 0
        },
        "pending_count": {
          "type": "integer",
          "minimum": 0
        },
        "approved_count": {
          "type": "integer",
          "minimum": 0
        },
        "rejected_count": {
          "type": "integer",
          "minimum": 0
        },
        "changes_requested_count": {
          "type": "integer",
          "minimum": 0
        },
        "resolved_or_waived_count": {
          "type": "integer",
          "minimum": 0
        },
        "follow_up_count": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "applied_items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "queue_item_id",
          "item_type",
          "subject_ref",
          "status_before",
          "status_after",
          "decision",
          "decided_at"
        ],
        "properties": {
          "queue_item_id": {
            "type": "string"
          },
          "item_type": {
            "type": "string"
          },
          "subject_ref": {
            "type": "object"
          },
          "status_before": {
            "type": "string"
          },
          "status_after": {
            "enum": ["decided", "cancelled"]
          },
          "decision": {
            "type": "string"
          },
          "decided_by": {
            "type": ["string", "null"]
          },
          "decided_at": {
            "type": "string",
            "format": "date-time"
          },
          "comment": {
            "type": "string"
          },
          "follow_up_action": {
            "type": "string"
          },
          "resource_patch": {
            "type": ["object", "null"]
          }
        }
      }
    },
    "unapplied_items": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "audit_events": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "patched_resource_evidence": {
      "type": ["object", "null"]
    },
    "decision_errors": {
      "type": "array",
      "items": {
        "type": "object"
      }
    }
  }
}
