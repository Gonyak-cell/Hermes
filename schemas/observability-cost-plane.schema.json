{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hermes.local/schemas/observability-cost-plane.schema.json",
  "title": "Hermes Observability And Cost Plane",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "capability_id",
    "program_range",
    "source_program_range",
    "observability_cost_contract",
    "observability_cost_phase_rows",
    "observability_source_binding_rows",
    "test_duration_signal_rows",
    "flaky_check_signal_rows",
    "review_latency_signal_rows",
    "token_cost_signal_rows",
    "evidence_freshness_signal_rows",
    "gate_failure_signal_rows",
    "validation_drift_signal_rows",
    "observability_projection_rows",
    "observability_authority_guard_rows",
    "p13800_freeze_rows",
    "observability_cost_boundary",
    "observability_cost_validation_items",
    "validation",
    "summary"
  ],
  "properties": {
    "schema_version": { "const": "observability-cost-plane.v1" },
    "capability_id": { "const": "platform.observability_cost_plane" },
    "program_range": { "const": "P13401-P13800" },
    "source_program_range": { "const": "P13001-P13400" },
    "observability_cost_phase_rows": { "type": "array", "minItems": 10, "items": { "$ref": "#/$defs/verdictRow" } },
    "observability_source_binding_rows": { "type": "array", "minItems": 8, "items": { "$ref": "#/$defs/verdictRow" } },
    "test_duration_signal_rows": { "type": "array", "minItems": 6, "items": { "$ref": "#/$defs/verdictRow" } },
    "flaky_check_signal_rows": { "type": "array", "minItems": 6, "items": { "$ref": "#/$defs/verdictRow" } },
    "review_latency_signal_rows": { "type": "array", "minItems": 6, "items": { "$ref": "#/$defs/verdictRow" } },
    "token_cost_signal_rows": { "type": "array", "minItems": 6, "items": { "$ref": "#/$defs/verdictRow" } },
    "evidence_freshness_signal_rows": { "type": "array", "minItems": 6, "items": { "$ref": "#/$defs/verdictRow" } },
    "gate_failure_signal_rows": { "type": "array", "minItems": 6, "items": { "$ref": "#/$defs/verdictRow" } },
    "validation_drift_signal_rows": { "type": "array", "minItems": 6, "items": { "$ref": "#/$defs/verdictRow" } },
    "observability_projection_rows": { "type": "array", "minItems": 6, "items": { "$ref": "#/$defs/verdictRow" } },
    "observability_authority_guard_rows": { "type": "array", "minItems": 8, "items": { "$ref": "#/$defs/verdictRow" } },
    "p13800_freeze_rows": { "type": "array", "minItems": 12, "items": { "$ref": "#/$defs/verdictRow" } },
    "observability_cost_boundary": {
      "type": "object",
      "required": [
        "source_enterprise_trust_hardening_available",
        "source_ready_for_p13401_handoff",
        "source_block_visible_now",
        "test_duration_signal_ready",
        "flaky_check_signal_ready",
        "review_latency_signal_ready",
        "token_cost_signal_ready",
        "evidence_freshness_signal_ready",
        "gate_failure_signal_ready",
        "validation_drift_signal_ready",
        "observability_projection_ready",
        "observability_authority_guard_ready",
        "p13800_observability_cost_freeze_ready",
        "ready_for_p13801_handoff",
        "metric_write_allowed_now",
        "telemetry_collector_start_allowed_now",
        "budget_mutation_allowed_now",
        "external_provider_call_allowed_now",
        "raw_source_exposure_allowed",
        "raw_transcript_exposure_allowed",
        "enterprise_trust_claim_allowed_now",
        "production_pass_enabled",
        "enterprise_pass_enabled",
        "protected_closeout_enabled",
        "deployment_allowed_now",
        "release_approval_allowed_now",
        "write_action_allowed_now",
        "protected_action_allowed_now",
        "connector_write_enabled",
        "runtime_execution_allowed_now",
        "final_approval_ui_enabled",
        "codex_final_approval_ui_enabled",
        "claude_final_approval_ui_enabled",
        "unsafe_flag_count"
      ],
      "properties": {
        "source_enterprise_trust_hardening_available": { "type": "boolean" },
        "source_ready_for_p13401_handoff": { "type": "boolean" },
        "source_block_visible_now": { "type": "boolean" },
        "test_duration_signal_ready": { "type": "boolean" },
        "flaky_check_signal_ready": { "type": "boolean" },
        "review_latency_signal_ready": { "type": "boolean" },
        "token_cost_signal_ready": { "type": "boolean" },
        "evidence_freshness_signal_ready": { "type": "boolean" },
        "gate_failure_signal_ready": { "type": "boolean" },
        "validation_drift_signal_ready": { "type": "boolean" },
        "observability_projection_ready": { "type": "boolean" },
        "observability_authority_guard_ready": { "type": "boolean" },
        "p13800_observability_cost_freeze_ready": { "type": "boolean" },
        "ready_for_p13801_handoff": { "type": "boolean" },
        "metric_write_allowed_now": { "const": false },
        "telemetry_collector_start_allowed_now": { "const": false },
        "budget_mutation_allowed_now": { "const": false },
        "external_provider_call_allowed_now": { "const": false },
        "raw_source_exposure_allowed": { "const": false },
        "raw_transcript_exposure_allowed": { "const": false },
        "enterprise_trust_claim_allowed_now": { "const": false },
        "production_pass_enabled": { "const": false },
        "enterprise_pass_enabled": { "const": false },
        "protected_closeout_enabled": { "const": false },
        "deployment_allowed_now": { "const": false },
        "release_approval_allowed_now": { "const": false },
        "write_action_allowed_now": { "const": false },
        "protected_action_allowed_now": { "const": false },
        "connector_write_enabled": { "const": false },
        "runtime_execution_allowed_now": { "const": false },
        "final_approval_ui_enabled": { "const": false },
        "codex_final_approval_ui_enabled": { "const": false },
        "claude_final_approval_ui_enabled": { "const": false },
        "unsafe_flag_count": { "const": 0 }
      }
    },
    "validation": {
      "type": "object",
      "required": ["valid", "error_count", "errors"],
      "properties": {
        "valid": { "type": "boolean" },
        "error_count": { "type": "integer", "minimum": 0 },
        "errors": { "type": "array" }
      }
    },
    "summary": {
      "type": "object",
      "required": [
        "observability_cost_plane_status",
        "program_range",
        "source_ready_for_p13401_handoff",
        "source_block_visible_now",
        "test_duration_signal_row_count",
        "flaky_check_signal_row_count",
        "review_latency_signal_row_count",
        "token_cost_signal_row_count",
        "evidence_freshness_signal_row_count",
        "gate_failure_signal_row_count",
        "validation_drift_signal_row_count",
        "observability_projection_row_count",
        "p13800_observability_cost_freeze_ready",
        "ready_for_p13801_handoff",
        "metric_write_allowed_now",
        "telemetry_collector_start_allowed_now",
        "budget_mutation_allowed_now",
        "enterprise_trust_claim_allowed_now",
        "production_pass_enabled",
        "deployment_allowed_now",
        "validation_error_count"
      ],
      "properties": {
        "observability_cost_plane_status": {
          "enum": [
            "ready_for_observability_cost_plane",
            "blocked_observability_cost_plane"
          ]
        },
        "program_range": { "const": "P13401-P13800" },
        "source_ready_for_p13401_handoff": { "type": "boolean" },
        "source_block_visible_now": { "type": "boolean" },
        "test_duration_signal_row_count": { "type": "integer", "minimum": 6 },
        "flaky_check_signal_row_count": { "type": "integer", "minimum": 6 },
        "review_latency_signal_row_count": { "type": "integer", "minimum": 6 },
        "token_cost_signal_row_count": { "type": "integer", "minimum": 6 },
        "evidence_freshness_signal_row_count": { "type": "integer", "minimum": 6 },
        "gate_failure_signal_row_count": { "type": "integer", "minimum": 6 },
        "validation_drift_signal_row_count": { "type": "integer", "minimum": 6 },
        "observability_projection_row_count": { "type": "integer", "minimum": 6 },
        "p13800_observability_cost_freeze_ready": { "type": "boolean" },
        "ready_for_p13801_handoff": { "type": "boolean" },
        "metric_write_allowed_now": { "const": false },
        "telemetry_collector_start_allowed_now": { "const": false },
        "budget_mutation_allowed_now": { "const": false },
        "enterprise_trust_claim_allowed_now": { "const": false },
        "production_pass_enabled": { "const": false },
        "deployment_allowed_now": { "const": false }
      }
    }
  },
  "$defs": {
    "verdictRow": {
      "type": "object",
      "required": [
        "row_id",
        "category",
        "label",
        "required",
        "observed",
        "evidence_ref",
        "current_verdict"
      ],
      "properties": {
        "row_id": { "type": "string", "minLength": 1 },
        "category": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "required": { "type": "boolean" },
        "observed": { "type": "boolean" },
        "evidence_ref": { "type": "string", "minLength": 1 },
        "current_verdict": { "enum": ["pass", "blocked"] },
        "block_reason": { "type": ["string", "null"] }
      }
    }
  }
}
