        "production_pass_ui_enabled": { "const": false },
        "enterprise_pass_ui_enabled": { "const": false },
        "p11800_design_system_freeze_ready": { "const": false }
      }
    },
    "global_ui_design_foundation_phase_rows": { "type": "array", "minItems": 10, "items": { "$ref": "#/$defs/verdictRow" } },
    "p11001_source_binding_rows": { "type": "array", "minItems": 6, "items": { "$ref": "#/$defs/verdictRow" } },
    "design_token_rows": { "type": "array", "minItems": 8, "items": { "$ref": "#/$defs/verdictRow" } },
    "table_list_primitive_rows": { "type": "array", "minItems": 8, "items": { "$ref": "#/$defs/verdictRow" } },
    "detail_inspector_primitive_rows": { "type": "array", "minItems": 9, "items": { "$ref": "#/$defs/verdictRow" } },
    "timeline_primitive_rows": { "type": "array", "minItems": 7, "items": { "$ref": "#/$defs/verdictRow" } },
    "boundary_notice_receipt_rows": { "type": "array", "minItems": 8, "items": { "$ref": "#/$defs/verdictRow" } },
    "readiness_rule_matrix_rows": { "type": "array", "minItems": 8, "items": { "$ref": "#/$defs/verdictRow" } },
