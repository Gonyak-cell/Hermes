{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hermes.local/schemas/platform-reproducibility-evidence-matrix.schema.json",
  "title": "Platform Reproducibility Evidence Matrix",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "generated_at",
    "platform_reproducibility_evidence_matrix_id",
    "capability_id",
    "reproducibility_evidence_anchor",
    "reproducibility_evidence_rows",
    "reproducibility_evidence_gate_rows",
    "reproducibility_evidence_boundary",
    "validation_items",
    "validation",
    "summary"
  ],
  "properties": {
    "schema_version": { "const": "platform-reproducibility-evidence-matrix.v1" },
    "platform_reproducibility_evidence_matrix_id": { "type": "string", "minLength": 1 },
    "capability_id": { "const": "platform.reproducibility_evidence_matrix" },
    "reproducibility_evidence_anchor": {
      "type": "object",
      "required": ["phase_slot", "previous_phase_slot", "next_phase_slot", "source_reproducibility_check_registry_status"],
      "properties": {
        "phase_slot": { "const": "P357" },
        "previous_phase_slot": { "const": "P356" },
        "next_phase_slot": { "const": "P358" },
        "source_reproducibility_check_registry_status": { "const": "ready" }
      }
    },
    "reproducibility_evidence_rows": {
      "type": "array",
      "minItems": 10,
      "items": {
        "type": "object",
        "required": [
          "phase_slot",
          "reproducibility_evidence_status",
          "source_phase_slots_ready",
          "supporting_package_scripts_registered",
          "evidence_collected_by_report",
          "command_execution_performed_by_report",
          "release_check_execution_performed_by_report",
          "artifact_regeneration_performed_by_report",
          "protected_action_executed_by_report",
          "human_review_required"
        ],
        "properties": {
          "phase_slot": { "const": "P357" },
          "reproducibility_evidence_status": { "const": "ready" },
          "source_phase_slots_ready": { "const": true },
          "supporting_package_scripts_registered": { "const": true },
          "evidence_collected_by_report": { "const": false },
          "command_execution_performed_by_report": { "const": false },
          "release_check_execution_performed_by_report": { "const": false },
          "artifact_regeneration_performed_by_report": { "const": false },
          "protected_action_executed_by_report": { "const": false },
          "human_review_required": { "const": true }
        }
      }
    },
    "reproducibility_evidence_gate_rows": {
      "type": "array",
      "minItems": 8,
      "items": {
        "type": "object",
        "required": [
          "phase_slot",
          "gate_status",
          "evidence_collected_by_report",
          "command_execution_performed_by_report",
          "release_check_execution_performed_by_report",
          "artifact_regeneration_performed_by_report",
          "git_operation_performed_by_report",
          "protected_action_executed_by_report",
          "trading_order_submission_performed_by_report",
          "human_review_required"
        ],
        "properties": {
          "phase_slot": { "const": "P357" },
          "gate_status": { "const": "ready" },
          "evidence_collected_by_report": { "const": false },
          "command_execution_performed_by_report": { "const": false },
          "release_check_execution_performed_by_report": { "const": false },
          "artifact_regeneration_performed_by_report": { "const": false },
          "git_operation_performed_by_report": { "const": false },
          "protected_action_executed_by_report": { "const": false },
          "trading_order_submission_performed_by_report": { "const": false },
          "human_review_required": { "const": true }
        }
      }
    },
    "reproducibility_evidence_boundary": {
      "type": "object",
      "required": [
        "boundary_status",
        "phase_slot",
        "read_only",
        "report_only",
        "evidence_collected",
        "command_execution_performed",
        "release_check_execution_performed",
        "dependency_install_performed",
        "package_mutation_performed",
        "lockfile_mutation_performed",
        "artifact_overwrite_performed",
        "artifact_regeneration_performed",
        "history_import_performed",
        "repository_checkout_changed",
        "git_operation_performed",
        "release_published",
        "recovery_execution_performed",
        "protected_action_executed",
        "approval_applied",
        "desktop_source_of_truth",
        "desktop_mutation_allowed",
        "trading_live_enabled",
        "trading_full_auto_enabled",
        "trading_order_submission_allowed",
        "broker_write_allowed",
        "human_review_required_for_reproducibility"
      ],
      "properties": {
        "boundary_status": { "const": "enforced" },
        "phase_slot": { "const": "P357" },
        "read_only": { "const": true },
        "report_only": { "const": true },
        "evidence_collected": { "const": false },
        "command_execution_performed": { "const": false },
        "release_check_execution_performed": { "const": false },
        "dependency_install_performed": { "const": false },
        "package_mutation_performed": { "const": false },
        "lockfile_mutation_performed": { "const": false },
        "artifact_overwrite_performed": { "const": false },
        "artifact_regeneration_performed": { "const": false },
        "history_import_performed": { "const": false },
        "repository_checkout_changed": { "const": false },
        "git_operation_performed": { "const": false },
        "release_published": { "const": false },
        "recovery_execution_performed": { "const": false },
        "protected_action_executed": { "const": false },
        "approval_applied": { "const": false },
        "desktop_source_of_truth": { "const": false },
        "desktop_mutation_allowed": { "const": false },
        "trading_live_enabled": { "const": false },
        "trading_full_auto_enabled": { "const": false },
        "trading_order_submission_allowed": { "const": false },
        "broker_write_allowed": { "const": false },
        "human_review_required_for_reproducibility": { "const": true }
      }
    },
    "summary": {
      "type": "object",
      "required": [
        "platform_reproducibility_evidence_matrix_status",
        "phase_slot",
        "previous_phase_slot",
        "next_phase_slot",
        "source_reproducibility_check_registry_status",
        "reproducibility_evidence_count",
        "ready_reproducibility_evidence_count",
        "reproducibility_evidence_gate_count",
        "ready_reproducibility_evidence_gate_count",
        "read_only",
        "report_only",
        "evidence_collected",
        "command_execution_performed",
        "release_check_execution_performed",
        "dependency_install_performed",
        "package_mutation_performed",
        "lockfile_mutation_performed",
        "artifact_overwrite_performed",
        "artifact_regeneration_performed",
        "history_import_performed",
        "repository_checkout_changed",
        "git_operation_performed",
        "release_published",
        "recovery_execution_performed",
        "protected_action_executed",
        "approval_applied",
        "desktop_source_of_truth",
        "desktop_mutation_allowed",
        "trading_live_enabled",
        "trading_full_auto_enabled",
        "trading_order_submission_allowed",
        "broker_write_allowed",
        "validation_error_count"
      ],
      "properties": {
        "platform_reproducibility_evidence_matrix_status": { "const": "ready" },
        "phase_slot": { "const": "P357" },
        "previous_phase_slot": { "const": "P356" },
        "next_phase_slot": { "const": "P358" },
        "source_reproducibility_check_registry_status": { "const": "ready" },
        "read_only": { "const": true },
        "report_only": { "const": true },
        "evidence_collected": { "const": false },
        "command_execution_performed": { "const": false },
        "release_check_execution_performed": { "const": false },
        "dependency_install_performed": { "const": false },
        "package_mutation_performed": { "const": false },
        "lockfile_mutation_performed": { "const": false },
        "artifact_overwrite_performed": { "const": false },
        "artifact_regeneration_performed": { "const": false },
        "history_import_performed": { "const": false },
        "repository_checkout_changed": { "const": false },
        "git_operation_performed": { "const": false },
        "release_published": { "const": false },
        "recovery_execution_performed": { "const": false },
        "protected_action_executed": { "const": false },
        "approval_applied": { "const": false },
        "desktop_source_of_truth": { "const": false },
        "desktop_mutation_allowed": { "const": false },
        "trading_live_enabled": { "const": false },
        "trading_full_auto_enabled": { "const": false },
        "trading_order_submission_allowed": { "const": false },
        "broker_write_allowed": { "const": false },
        "validation_error_count": { "const": 0 }
      }
    }
  }
