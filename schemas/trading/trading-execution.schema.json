{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://amic.local/hermes/trading/trading-execution.schema.json",
  "title": "Trading Execution",
  "type": "object",
  "required": ["schema_version", "execution_id", "order_intent_id", "execution_mode", "state", "adapter_id", "live_adapter_enabled", "secret_logged", "emergency_halt_available"],
  "properties": {
    "schema_version": {
      "const": "trading-execution.v1"
    },
    "execution_id": {
      "type": "string",
      "pattern": "^execution\\.[a-z0-9_\\.:-]+$"
    },
    "order_intent_id": {
      "type": "string"
    },
    "execution_mode": {
      "enum": ["simulated", "paper", "disabled_live"]
    },
    "state": {
      "enum": ["created", "risk_checked", "simulated", "cancelled", "halted", "blocked"]
    },
    "adapter_id": {
      "enum": ["sandbox", "simulated_broker", "live_disabled"]
    },
    "live_adapter_enabled": {
      "const": false
    },
    "secret_logged": {
      "const": false
    },
    "emergency_halt_available": {
      "const": true
    }
  }
}
