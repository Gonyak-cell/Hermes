{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hermes.local/schemas/trust-evidence-clean-checkpoint.schema.json",
  "title": "Hermes Trust Evidence Clean Checkpoint",
  "type": "object",
  "required": [
    "schema_version",
    "generated_at",
    "capability_id",
    "program_range",
    "source_program_range",
    "trust_evidence_checkpoint_phase_rows",
    "p19600_source_binding_rows",
    "trust_evidence_chain_index_rows",
    "verification_of_verification_rows",
    "operator_trust_checkpoint_rows",
    "remaining_authority_debt_rows",
    "regression_command_packet_rows",
    "authority_boundary_checkpoint_rows",
    "p20000_clean_checkpoint_rows",
    "trust_evidence_clean_checkpoint_boundary",
    "trust_evidence_clean_checkpoint_validation_items",
    "summary",
    "validation"
  ],
  "properties": {
    "schema_version": { "const": "trust-evidence-clean-checkpoint.v1" },
    "generated_at": { "type": "string", "format": "date-time" },
    "capability_id": { "const": "platform.trust_evidence_clean_checkpoint" },
    "program_range": { "const": "P19601-P20000" },
    "source_program_range": { "const": "P19201-P19600" },
    "trust_evidence_checkpoint_phase_rows": { "type": "array", "minItems": 7, "items": { "$ref": "#/$defs/verdictRow" } },
    "p19600_source_binding_rows": { "type": "array", "minItems": 7, "items": { "$ref": "#/$defs/verdictRow" } },
    "trust_evidence_chain_index_rows": { "type": "array", "minItems": 8, "items": { "$ref": "#/$defs/verdictRow" } },
    "verification_of_verification_rows": { "type": "array", "minItems": 7, "items": { "$ref": "#/$defs/verdictRow" } },
    "operator_trust_checkpoint_rows": { "type": "array", "minItems": 5, "items": { "$ref": "#/$defs/verdictRow" } },
    "remaining_authority_debt_rows": { "type": "array", "minItems": 7, "items": { "$ref": "#/$defs/verdictRow" } },
    "regression_command_packet_rows": { "type": "array", "minItems": 5, "items": { "$ref": "#/$defs/verdictRow" } },
    "authority_boundary_checkpoint_rows": { "type": "array", "minItems": 18, "items": { "$ref": "#/$defs/verdictRow" } },
    "p20000_clean_checkpoint_rows": { "type": "array", "minItems": 9, "items": { "$ref": "#/$defs/verdictRow" } },
    "trust_evidence_clean_checkpoint_validation_items": { "type": "array", "minItems": 12, "items": { "$ref": "#/$defs/validationItem" } },
    "summary": {
      "type": "object",
      "required": [
        "trust_evidence_checkpoint_status",
        "source_p19600_ready_for_p19601_handoff",
        "trust_evidence_chain_count",
        "verification_matrix_count",
        "operator_projection_visible_now",
        "regression_packet_visible_now",
        "ready_for_p20001_handoff",
        "production_pass_enabled"
      ],
      "properties": {
        "trust_evidence_checkpoint_status": {
          "enum": [
            "ready_for_trust_evidence_clean_checkpoint",
            "valid_block_checkpoint_pending",
            "blocked_trust_evidence_clean_checkpoint"
          ]
        },
        "source_p19600_ready_for_p19601_handoff": { "type": "boolean" },
        "trust_evidence_chain_count": { "type": "number" },
        "verification_matrix_count": { "type": "number" },
        "operator_projection_visible_now": { "type": "boolean" },
        "regression_packet_visible_now": { "type": "boolean" },
        "ready_for_p20001_handoff": { "type": "boolean" },
        "production_pass_enabled": { "const": false }
      }
    },
    "trust_evidence_clean_checkpoint_boundary": {
      "type": "object",
      "required": [
        "p20000_contract_ready",
        "ready_for_p20001_handoff",
        "source_p19600_ready_for_p19601_handoff",
        "source_validation_valid_now",
        "trust_evidence_chain_visible_now",
        "verification_matrix_passed_now",
        "operator_projection_visible_now",
        "regression_packet_visible_now",
        "remaining_authority_debt_count",
        "trust_evidence_chain_count",
        "verification_matrix_count",
        "deployment_allowed_now",
        "release_approval_allowed_now",
        "production_pass_enabled",
        "enterprise_pass_enabled",
        "enterprise_trust_claim_allowed_now",
        "protected_closeout_enabled",
        "human_gate_bypass_allowed_now",
        "independent_review_bypass_allowed_now",
        "single_owner_enterprise_trust_allowed_now",
        "runtime_execution_allowed_now",
        "write_action_allowed_now",
        "protected_action_allowed_now",
        "connector_write_enabled",
        "external_service_mutation_allowed_now",
        "raw_source_exposure_allowed",
        "secret_read_allowed_now",
        "reviewer_mutation_allowed_now",
        "final_automated_approval_allowed"
      ],
      "properties": {
        "p20000_contract_ready": { "type": "boolean" },
        "ready_for_p20001_handoff": { "type": "boolean" },
        "source_p19600_ready_for_p19601_handoff": { "type": "boolean" },
        "source_validation_valid_now": { "type": "boolean" },
        "trust_evidence_chain_visible_now": { "type": "boolean" },
        "verification_matrix_passed_now": { "type": "boolean" },
        "operator_projection_visible_now": { "type": "boolean" },
        "regression_packet_visible_now": { "type": "boolean" },
        "remaining_authority_debt_count": { "type": "number" },
        "trust_evidence_chain_count": { "type": "number" },
        "verification_matrix_count": { "type": "number" },
        "deployment_allowed_now": { "const": false },
        "release_approval_allowed_now": { "const": false },
        "production_pass_enabled": { "const": false },
        "enterprise_pass_enabled": { "const": false },
        "enterprise_trust_claim_allowed_now": { "const": false },
        "protected_closeout_enabled": { "const": false },
        "human_gate_bypass_allowed_now": { "const": false },
        "independent_review_bypass_allowed_now": { "const": false },
        "single_owner_enterprise_trust_allowed_now": { "const": false },
        "runtime_execution_allowed_now": { "const": false },
        "write_action_allowed_now": { "const": false },
        "protected_action_allowed_now": { "const": false },
        "connector_write_enabled": { "const": false },
        "external_service_mutation_allowed_now": { "const": false },
        "raw_source_exposure_allowed": { "const": false },
        "secret_read_allowed_now": { "const": false },
        "reviewer_mutation_allowed_now": { "const": false },
        "final_automated_approval_allowed": { "const": false }
      }
    },
    "validation": {
      "type": "object",
      "required": ["valid", "error_count", "errors"],
      "properties": {
        "valid": { "type": "boolean" },
        "error_count": { "type": "number" },
        "errors": { "type": "array" }
      }
    }
  },
  "$defs": {
    "verdictRow": {
      "type": "object",
      "required": [
        "row_id",
        "category",
        "label",
        "observed",
        "current_verdict",
        "block_reason",
        "evidence_ref",
        "generated_at"
      ],
      "properties": {
        "row_id": { "type": "string", "minLength": 1 },
        "category": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "observed": { "type": "boolean" },
        "current_verdict": { "enum": ["pass", "blocked"] },
        "block_reason": { "type": ["string", "null"] },
        "evidence_ref": { "type": "string", "minLength": 1 },
        "generated_at": { "type": "string", "format": "date-time" }
      }
    },
    "validationItem": {
      "type": "object",
      "required": ["item_id", "category", "passed", "message", "evidence_ref"],
      "properties": {
        "item_id": { "type": "string", "minLength": 1 },
        "category": { "type": "string", "minLength": 1 },
        "passed": { "type": "boolean" },
        "message": { "type": "string" },
        "evidence_ref": { "type": "string", "minLength": 1 }
      }
    }
  }
}
