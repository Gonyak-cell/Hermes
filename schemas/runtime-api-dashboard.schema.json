{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://amic.local/hermes/schemas/runtime-api-dashboard.schema.json",
  "title": "Hermes Runtime API Dashboard",
  "type": "object",
  "required": [
    "schema_version",
    "generated_at",
    "runtime_api_dashboard_id",
    "output_dir",
    "inputs",
    "source_contracts",
    "runtime_api_dashboard_contract",
    "runtime_api_route_groups",
    "runtime_dashboard_panels",
    "runtime_status_cards",
    "runtime_api_desktop_boundary",
    "summary",
    "validation_items",
    "validation"
  ],
  "properties": {
    "schema_version": { "const": "runtime-api-dashboard.v1" },
    "generated_at": { "type": "string", "format": "date-time" },
    "runtime_api_dashboard_id": { "type": "string" },
    "output_dir": { "type": "string" },
    "inputs": { "type": "object" },
    "source_contracts": { "type": "object" },
    "runtime_api_dashboard_contract": {
      "type": "object",
      "required": [
        "runtime_api_dashboard_contract_id",
        "contract_status",
        "route_authority",
        "dashboard_authority",
        "source_of_truth",
        "desktop_surface_policy",
        "read_only",
        "mutation_allowed",
        "protected_mutation_execution_allowed",
        "runtime_execution_allowed",
        "runtime_control_allowed",
        "test_execution_allowed",
        "secret_material_exposed",
        "desktop_source_of_truth"
      ],
      "properties": {
        "runtime_api_dashboard_contract_id": { "const": "runtime-api-dashboard.default" },
        "contract_status": { "const": "locked" },
        "route_authority": { "const": "harness_review_api" },
        "dashboard_authority": { "const": "harness_review_dashboard" },
        "source_of_truth": { "const": "runtime_contract_artifacts_and_review_api_dashboard" },
        "desktop_surface_policy": { "const": "read_only_runtime_operations_dashboard" },
        "read_only": { "const": true },
        "mutation_allowed": { "const": false },
        "protected_mutation_execution_allowed": { "const": false },
        "runtime_execution_allowed": { "const": false },
        "runtime_control_allowed": { "const": false },
        "test_execution_allowed": { "const": false },
        "secret_material_exposed": { "const": false },
        "desktop_source_of_truth": { "const": false }
      },
      "additionalProperties": true
    },
    "runtime_api_route_groups": {
      "type": "array",
      "minItems": 10,
      "items": { "$ref": "#/$defs/runtime_api_route_group" }
    },
    "runtime_dashboard_panels": {
      "type": "array",
      "minItems": 10,
      "items": { "$ref": "#/$defs/runtime_dashboard_panel" }
    },
    "runtime_status_cards": {
      "type": "array",
      "minItems": 16,
      "items": { "$ref": "#/$defs/runtime_status_card" }
    },
    "runtime_api_desktop_boundary": {
      "type": "object",
      "required": [
        "runtime_api_desktop_boundary_id",
        "boundary_status",
        "desktop_companion_role",
        "desktop_surface_policy",
        "read_only",
        "mutation_allowed",
        "protected_mutation_execution_allowed",
        "runtime_source_of_truth",
        "runtime_execution_allowed",
        "runtime_control_allowed",
        "test_execution_allowed",
        "secret_material_exposed",
        "provider_key_visible",
        "installer_or_gateway_control",
        "ssh_or_cron_control"
      ],
      "properties": {
        "boundary_status": { "const": "locked" },
        "desktop_companion_role": { "const": "operator_surface" },
        "desktop_surface_policy": { "const": "read_only_runtime_operations_dashboard" },
        "read_only": { "const": true },
        "mutation_allowed": { "const": false },
        "protected_mutation_execution_allowed": { "const": false },
        "runtime_source_of_truth": { "const": false },
        "runtime_execution_allowed": { "const": false },
        "runtime_control_allowed": { "const": false },
        "test_execution_allowed": { "const": false },
        "secret_material_exposed": { "const": false },
        "provider_key_visible": { "const": false },
        "installer_or_gateway_control": { "const": false },
        "ssh_or_cron_control": { "const": false }
      },
      "additionalProperties": true
    },
    "summary": {
      "type": "object",
      "required": [
        "runtime_api_dashboard_status",
        "runtime_api_dashboard_contract_id",
        "contract_status",
        "route_authority",
        "dashboard_authority",
        "source_of_truth",
        "desktop_surface_policy",
        "source_count",
        "complete_source_count",
        "source_validation_error_count",
        "runtime_api_route_group_count",
        "read_only_route_group_count",
        "runtime_api_route_count",
        "declared_route_count",
        "missing_route_count",
        "mutation_route_count",
        "protected_mutation_request_route_count",
        "runtime_dashboard_panel_count",
        "runtime_status_card_count",
        "runtime_execution_allowed_count",
        "runtime_control_allowed_count",
        "secret_material_exposed_count",
        "desktop_read_only",
        "desktop_mutation_allowed",
        "desktop_protected_mutation_execution_allowed",
        "desktop_runtime_source_of_truth",
        "desktop_runtime_execution_allowed",
        "desktop_runtime_control_allowed",
        "desktop_test_execution_allowed",
        "desktop_secret_material_exposed",
        "desktop_provider_key_visible",
        "desktop_installer_or_gateway_control",
        "desktop_ssh_or_cron_control",
        "validation_error_count"
      ],
      "properties": {
        "runtime_api_dashboard_status": { "enum": ["complete", "blocked"] },
        "runtime_api_dashboard_contract_id": { "const": "runtime-api-dashboard.default" },
        "contract_status": { "const": "locked" },
        "route_authority": { "const": "harness_review_api" },
        "dashboard_authority": { "const": "harness_review_dashboard" },
        "source_of_truth": { "const": "runtime_contract_artifacts_and_review_api_dashboard" },
        "desktop_surface_policy": { "const": "read_only_runtime_operations_dashboard" },
        "source_count": { "type": "integer", "minimum": 0 },
        "complete_source_count": { "type": "integer", "minimum": 0 },
        "source_validation_error_count": { "type": "integer", "minimum": 0 },
        "runtime_api_route_group_count": { "type": "integer", "minimum": 0 },
        "read_only_route_group_count": { "type": "integer", "minimum": 0 },
        "runtime_api_route_count": { "type": "integer", "minimum": 0 },
        "declared_route_count": { "type": "integer", "minimum": 0 },
        "missing_route_count": { "type": "integer", "minimum": 0 },
        "mutation_route_count": { "type": "integer", "minimum": 0 },
        "protected_mutation_request_route_count": { "type": "integer", "minimum": 0 },
        "runtime_dashboard_panel_count": { "type": "integer", "minimum": 0 },
        "runtime_status_card_count": { "type": "integer", "minimum": 0 },
        "runtime_execution_allowed_count": { "type": "integer", "minimum": 0 },
        "runtime_control_allowed_count": { "type": "integer", "minimum": 0 },
        "secret_material_exposed_count": { "type": "integer", "minimum": 0 },
        "desktop_read_only": { "const": true },
        "desktop_mutation_allowed": { "const": false },
        "desktop_protected_mutation_execution_allowed": { "const": false },
        "desktop_runtime_source_of_truth": { "const": false },
        "desktop_runtime_execution_allowed": { "const": false },
        "desktop_runtime_control_allowed": { "const": false },
        "desktop_test_execution_allowed": { "const": false },
        "desktop_secret_material_exposed": { "const": false },
        "desktop_provider_key_visible": { "const": false },
        "desktop_installer_or_gateway_control": { "const": false },
        "desktop_ssh_or_cron_control": { "const": false },
        "validation_error_count": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": true
    },
    "validation_items": {
      "type": "array",
      "items": { "$ref": "#/$defs/validation_item" }
    },
    "validation": {
      "type": "object",
      "required": ["valid", "errors"],
      "properties": {
        "valid": { "type": "boolean" },
        "errors": { "type": "array" }
      },
      "additionalProperties": true
    }
  },
  "$defs": {
    "runtime_api_route_group": {
      "type": "object",
      "required": [
        "schema_version",
        "runtime_api_route_group_id",
        "route_group_kind",
        "label",
        "source_artifact_ids",
        "route_method",
        "route_paths",
        "query_examples",
        "route_count",
        "declared_route_count",
        "missing_route_count",
        "route_group_status",
        "desktop_visibility",
        "read_only",
        "mutation_route_count",
        "protected_mutation_execution_allowed",
        "runtime_execution_allowed",
        "runtime_control_allowed",
        "test_execution_allowed",
        "secret_material_exposed",
        "route_hash"
      ],
      "properties": {
        "schema_version": { "const": "runtime-api-route-group.v1" },
        "route_group_kind": {
          "enum": ["adapters", "worktrees", "sandbox", "secrets", "artifacts", "logs", "lifecycle", "control", "gates", "tests", "desktop_index"]
        },
        "route_method": { "const": "GET" },
        "route_group_status": { "enum": ["ready", "attention"] },
        "desktop_visibility": { "const": "read_only" },
        "read_only": { "const": true },
        "mutation_route_count": { "const": 0 },
        "protected_mutation_execution_allowed": { "const": false },
        "runtime_execution_allowed": { "const": false },
        "runtime_control_allowed": { "const": false },
        "test_execution_allowed": { "const": false },
        "secret_material_exposed": { "const": false },
        "route_hash": { "type": "string", "pattern": "^sha256:" }
      },
      "additionalProperties": true
    },
    "runtime_dashboard_panel": {
      "type": "object",
      "required": [
        "schema_version",
        "runtime_dashboard_panel_id",
        "route_group_id",
        "panel_kind",
        "label",
        "panel_status",
        "source_artifact_ids",
        "route_count",
        "declared_route_count",
        "missing_route_count",
        "desktop_visibility",
        "read_only",
        "mutation_allowed",
        "runtime_execution_allowed",
        "runtime_control_allowed",
        "test_execution_allowed",
        "secret_material_exposed",
        "metrics",
        "api_routes",
        "query_examples",
        "panel_hash"
      ],
      "properties": {
        "schema_version": { "const": "runtime-dashboard-panel.v1" },
        "panel_status": { "enum": ["ready", "attention"] },
        "desktop_visibility": { "const": "read_only" },
        "read_only": { "const": true },
        "mutation_allowed": { "const": false },
        "runtime_execution_allowed": { "const": false },
        "runtime_control_allowed": { "const": false },
        "test_execution_allowed": { "const": false },
        "secret_material_exposed": { "const": false },
        "panel_hash": { "type": "string", "pattern": "^sha256:" }
      },
      "additionalProperties": true
    },
    "runtime_status_card": {
      "type": "object",
      "required": [
        "schema_version",
        "runtime_status_card_id",
        "source_artifact_id",
        "label",
        "card_kind",
        "source_status",
        "contract_status",
        "validation_error_count",
        "desktop_read_only",
        "desktop_mutation_allowed",
        "desktop_protected_mutation_execution_allowed",
        "desktop_runtime_source_of_truth",
        "source_of_truth",
        "read_only_route",
        "status_card_hash"
      ],
      "properties": {
        "schema_version": { "const": "runtime-status-card.v1" },
        "source_status": { "type": "string" },
        "desktop_read_only": { "const": true },
        "desktop_mutation_allowed": { "const": false },
        "desktop_protected_mutation_execution_allowed": { "const": false },
        "desktop_runtime_source_of_truth": { "const": false },
        "status_card_hash": { "type": "string", "pattern": "^sha256:" }
      },
      "additionalProperties": true
    },
    "validation_item": {
      "type": "object",
      "required": ["validation_item_id", "status", "message"],
      "properties": {
        "validation_item_id": { "type": "string" },
        "status": { "enum": ["passed", "failed"] },
        "message": { "type": "string" }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
