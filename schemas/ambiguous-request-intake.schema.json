{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hermes.local/schemas/ambiguous-request-intake.schema.json",
  "title": "Hermes Ambiguous Request Intake",
  "type": "object",
  "required": [
    "schema_version",
    "generated_at",
    "capability_id",
    "program_range",
    "source_program_range",
    "ambiguous_request_intake_phase_rows",
    "p31200_source_binding_rows",
    "ambiguous_request_intake_rows",
    "intent_parser_rows",
    "task_type_registry_rows",
    "spec_schema_selector_rows",
    "slot_clarity_scoring_rows",
    "ambiguity_threshold_policy_rows",
    "no_authority_boundary_rows",
    "p31600_clean_checkpoint_rows",
    "ambiguous_request_intake_boundary",
    "ambiguous_request_intake_validation_items",
    "summary",
    "validation"
  ],
  "properties": {
    "schema_version": { "const": "ambiguous-request-intake.v1" },
    "generated_at": { "type": "string", "format": "date-time" },
    "capability_id": { "const": "platform.ambiguous_request_intake" },
    "program_range": { "const": "P31201-P31600" },
    "source_program_range": { "const": "P30801-P31200" },
    "ambiguous_request_intake_phase_rows": { "type": "array", "minItems": 7, "items": { "$ref": "#/$defs/verdictRow" } },
    "p31200_source_binding_rows": { "type": "array", "minItems": 12, "items": { "$ref": "#/$defs/verdictRow" } },
    "ambiguous_request_intake_rows": { "type": "array", "minItems": 3, "items": { "$ref": "#/$defs/verdictRow" } },
    "intent_parser_rows": { "type": "array", "minItems": 3, "items": { "$ref": "#/$defs/verdictRow" } },
    "task_type_registry_rows": { "type": "array", "minItems": 8, "items": { "$ref": "#/$defs/verdictRow" } },
    "spec_schema_selector_rows": { "type": "array", "minItems": 3, "items": { "$ref": "#/$defs/verdictRow" } },
    "slot_clarity_scoring_rows": { "type": "array", "minItems": 45, "items": { "$ref": "#/$defs/verdictRow" } },
    "ambiguity_threshold_policy_rows": { "type": "array", "minItems": 3, "items": { "$ref": "#/$defs/verdictRow" } },
    "no_authority_boundary_rows": { "type": "array", "minItems": 300, "items": { "$ref": "#/$defs/verdictRow" } },
    "p31600_clean_checkpoint_rows": { "type": "array", "minItems": 10, "items": { "$ref": "#/$defs/verdictRow" } },
    "ambiguous_request_intake_validation_items": { "type": "array", "minItems": 15, "items": { "$ref": "#/$defs/validationItem" } },
    "summary": {
      "type": "object",
      "required": [
        "ambiguous_request_intake_status",
        "source_p31200_ready_for_p31201_handoff",
        "prompt_sample_count",
        "task_type_registry_count",
        "slot_clarity_scoring_count",
        "ambiguity_threshold_policy_count",
        "clarification_required_count",
        "ready_for_clarifying_question_engine",
        "ambiguous_request_intake_runtime_execution_allowed_now",
        "ambiguous_request_intake_write_action_allowed_now",
        "ambiguous_request_intake_protected_action_allowed_now",
        "ambiguous_request_intake_question_auto_send_allowed_now",
        "ambiguous_request_intake_answer_capture_allowed_now",
        "ambiguous_request_intake_seed_synthesis_allowed_now",
        "ambiguous_request_intake_final_approval_allowed_now",
        "ambiguous_request_intake_production_pass_allowed_now",
        "production_pass_enabled"
      ],
      "properties": {
        "ambiguous_request_intake_status": {
          "enum": [
            "ready_for_ambiguous_request_intake",
            "valid_block_ambiguous_request_intake_pending",
            "blocked_ambiguous_request_intake"
          ]
        },
        "source_p31200_ready_for_p31201_handoff": { "type": "boolean" },
        "prompt_sample_count": { "type": "number" },
        "task_type_registry_count": { "type": "number" },
        "slot_clarity_scoring_count": { "type": "number" },
        "ambiguity_threshold_policy_count": { "type": "number" },
        "clarification_required_count": { "type": "number" },
        "ready_for_clarifying_question_engine": { "type": "boolean" },
        "ambiguous_request_intake_runtime_execution_allowed_now": { "const": false },
        "ambiguous_request_intake_write_action_allowed_now": { "const": false },
        "ambiguous_request_intake_protected_action_allowed_now": { "const": false },
        "ambiguous_request_intake_question_auto_send_allowed_now": { "const": false },
        "ambiguous_request_intake_answer_capture_allowed_now": { "const": false },
        "ambiguous_request_intake_seed_synthesis_allowed_now": { "const": false },
        "ambiguous_request_intake_seed_auto_apply_allowed_now": { "const": false },
        "ambiguous_request_intake_final_approval_allowed_now": { "const": false },
        "ambiguous_request_intake_production_pass_allowed_now": { "const": false },
        "production_pass_enabled": { "const": false },
        "enterprise_trust_claim_allowed_now": { "const": false },
        "validation_error_count": { "type": "number" }
      }
    },
    "ambiguous_request_intake_boundary": {
      "type": "object",
      "required": [
        "p31600_contract_ready",
        "ready_for_clarifying_question_engine",
        "source_p31200_ready_for_p31201_handoff",
        "ambiguous_request_intake_visible_now",
        "intent_parser_visible_now",
        "task_type_registry_visible_now",
        "spec_schema_selector_visible_now",
        "slot_clarity_scoring_visible_now",
        "ambiguity_threshold_policy_visible_now",
        "no_authority_boundary_closed_now",
        "clarification_required_count",
        "ambiguous_request_intake_runtime_execution_allowed_now",
        "ambiguous_request_intake_write_action_allowed_now",
        "ambiguous_request_intake_protected_action_allowed_now",
        "ambiguous_request_intake_question_auto_send_allowed_now",
        "ambiguous_request_intake_answer_capture_allowed_now",
        "ambiguous_request_intake_seed_synthesis_allowed_now",
        "ambiguous_request_intake_final_approval_allowed_now",
        "ambiguous_request_intake_production_pass_allowed_now",
        "deployment_allowed_now",
        "production_pass_enabled",
        "enterprise_trust_claim_allowed_now",
        "final_automated_approval_allowed"
      ],
      "properties": {
        "p31600_contract_ready": { "type": "boolean" },
        "ready_for_clarifying_question_engine": { "type": "boolean" },
        "source_p31200_ready_for_p31201_handoff": { "type": "boolean" },
        "source_validation_valid_now": { "type": "boolean" },
        "ambiguous_request_intake_visible_now": { "type": "boolean" },
        "intent_parser_visible_now": { "type": "boolean" },
        "task_type_registry_visible_now": { "type": "boolean" },
        "spec_schema_selector_visible_now": { "type": "boolean" },
        "slot_clarity_scoring_visible_now": { "type": "boolean" },
        "ambiguity_threshold_policy_visible_now": { "type": "boolean" },
        "no_authority_boundary_closed_now": { "type": "boolean" },
        "clarification_required_count": { "type": "number" },
        "direct_execution_candidate_count": { "type": "number" },
        "ambiguous_request_intake_runtime_execution_allowed_now": { "const": false },
        "ambiguous_request_intake_write_action_allowed_now": { "const": false },
        "ambiguous_request_intake_protected_action_allowed_now": { "const": false },
        "ambiguous_request_intake_question_auto_send_allowed_now": { "const": false },
        "ambiguous_request_intake_answer_capture_allowed_now": { "const": false },
        "ambiguous_request_intake_seed_synthesis_allowed_now": { "const": false },
        "ambiguous_request_intake_seed_auto_apply_allowed_now": { "const": false },
        "ambiguous_request_intake_final_approval_allowed_now": { "const": false },
        "ambiguous_request_intake_production_pass_allowed_now": { "const": false },
        "deployment_allowed_now": { "const": false },
        "release_approval_allowed_now": { "const": false },
        "production_pass_enabled": { "const": false },
        "enterprise_pass_enabled": { "const": false },
        "enterprise_trust_claim_allowed_now": { "const": false },
        "protected_closeout_enabled": { "const": false },
        "human_gate_bypass_allowed_now": { "const": false },
        "independent_review_bypass_allowed_now": { "const": false },
        "single_owner_enterprise_trust_allowed_now": { "const": false },
        "runtime_execution_allowed_now": { "const": false },
        "write_action_allowed_now": { "const": false },
        "protected_action_allowed_now": { "const": false },
        "connector_write_enabled": { "const": false },
        "external_service_mutation_allowed_now": { "const": false },
        "raw_source_exposure_allowed": { "const": false },
        "secret_read_allowed_now": { "const": false },
        "reviewer_mutation_allowed_now": { "const": false },
        "final_automated_approval_allowed": { "const": false }
      }
    },
    "validation": {
      "type": "object",
      "required": ["valid", "error_count", "errors"],
      "properties": {
        "valid": { "type": "boolean" },
        "error_count": { "type": "number" },
        "errors": { "type": "array" }
      }
    }
  },
  "$defs": {
    "verdictRow": {
      "type": "object",
      "required": ["row_id", "category", "label", "observed", "current_verdict", "block_reason", "evidence_ref"],
      "properties": {
        "row_id": { "type": "string" },
        "category": { "type": "string" },
        "label": { "type": "string" },
        "observed": { "type": "boolean" },
        "current_verdict": { "enum": ["pass", "block"] },
        "block_reason": { "type": ["string", "null"] },
        "evidence_ref": { "type": ["string", "null"] },
        "generated_at": { "type": "string" }
      },
      "additionalProperties": true
    },
    "validationItem": {
      "allOf": [{ "$ref": "#/$defs/verdictRow" }]
    }
  }
}
