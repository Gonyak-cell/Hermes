{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://amic.local/hermes/schemas/token-usage-projection.schema.json",
  "title": "Hermes Token Usage Projection",
  "type": "object",
  "required": [
    "schema_version",
    "generated_at",
    "token_usage_projection_id",
    "output_dir",
    "inputs",
    "source_contracts",
    "token_usage_projection_contract",
    "token_usage_projection_catalog",
    "validation_items",
    "validation",
    "summary"
  ],
  "properties": {
    "schema_version": { "const": "token-usage-projection.v1" },
    "generated_at": { "type": "string", "format": "date-time" },
    "token_usage_projection_id": { "type": "string" },
    "output_dir": { "type": "string" },
    "inputs": { "type": "object" },
    "source_contracts": { "type": "object" },
    "token_usage_projection_contract": {
      "type": "object",
      "required": ["schema_version", "token_usage_projection_contract_id", "required_record_fields", "rollup_dimensions"],
      "properties": {
        "schema_version": { "const": "token-usage-projection-contract.v1" },
        "token_usage_projection_contract_id": { "const": "token-usage-projection.v1" },
        "required_record_fields": { "type": "array", "items": { "type": "string" } },
        "rollup_dimensions": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": true
    },
    "token_usage_projection_catalog": {
      "type": "object",
      "required": [
        "schema_version",
        "projected_token_usage_records",
        "capability_token_rollups",
        "runtime_token_rollups",
        "capability_runtime_token_rollups",
        "domain_pack_token_rollups",
        "matter_token_rollups",
        "tracking_status_token_rollups"
      ],
      "properties": {
        "schema_version": { "const": "token-usage-projection-catalog.v1" },
        "projected_token_usage_records": {
          "type": "array",
          "items": { "$ref": "#/$defs/projected_token_usage_record" }
        },
        "capability_token_rollups": {
          "type": "array",
          "items": { "$ref": "#/$defs/token_rollup" }
        },
        "runtime_token_rollups": {
          "type": "array",
          "items": { "$ref": "#/$defs/token_rollup" }
        },
        "capability_runtime_token_rollups": {
          "type": "array",
          "items": { "$ref": "#/$defs/token_rollup" }
        },
        "domain_pack_token_rollups": {
          "type": "array",
          "items": { "$ref": "#/$defs/token_rollup" }
        },
        "matter_token_rollups": {
          "type": "array",
          "items": { "$ref": "#/$defs/token_rollup" }
        },
        "tracking_status_token_rollups": {
          "type": "array",
          "items": { "$ref": "#/$defs/token_rollup" }
        }
      },
      "additionalProperties": true
    },
    "validation_items": {
      "type": "array",
      "items": { "$ref": "#/$defs/validation_item" }
    },
    "validation": {
      "type": "object",
      "required": ["valid", "errors"],
      "properties": {
        "valid": { "type": "boolean" },
        "errors": { "type": "array" }
      },
      "additionalProperties": true
    },
    "summary": {
      "type": "object",
      "required": [
        "token_usage_projection_status",
        "token_usage_projection_contract_id",
        "projected_token_usage_record_count",
        "source_token_usage_record_count",
        "provider_cost_record_count",
        "provider_cost_bound_record_count",
        "missing_provider_cost_record_count",
        "capability_token_rollup_count",
        "runtime_token_rollup_count",
        "capability_runtime_token_rollup_count",
        "total_input_token_count",
        "total_output_token_count",
        "total_cache_token_count",
        "total_token_count",
        "validation_error_count"
      ],
      "properties": {
        "token_usage_projection_status": { "enum": ["complete", "blocked"] },
        "token_usage_projection_contract_id": { "const": "token-usage-projection.v1" },
        "projected_token_usage_record_count": { "type": "integer", "minimum": 0 },
        "source_token_usage_record_count": { "type": "integer", "minimum": 0 },
        "provider_cost_record_count": { "type": "integer", "minimum": 0 },
        "provider_cost_bound_record_count": { "type": "integer", "minimum": 0 },
        "missing_provider_cost_record_count": { "type": "integer", "minimum": 0 },
        "capability_token_rollup_count": { "type": "integer", "minimum": 0 },
        "runtime_token_rollup_count": { "type": "integer", "minimum": 0 },
        "capability_runtime_token_rollup_count": { "type": "integer", "minimum": 0 },
        "total_input_token_count": { "type": "integer", "minimum": 0 },
        "total_output_token_count": { "type": "integer", "minimum": 0 },
        "total_cache_token_count": { "type": "integer", "minimum": 0 },
        "total_token_count": { "type": "integer", "minimum": 0 },
        "validation_error_count": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": true
    }
  },
  "$defs": {
    "projected_token_usage_record": {
      "type": "object",
      "required": [
        "schema_version",
        "projected_token_usage_record_id",
        "token_usage_id",
        "workflow_run_id",
        "agent_run_id",
        "runtime_id",
        "capability_id",
        "domain_pack",
        "tenant_id",
        "matter_id",
        "tracking_status",
        "input_token_count",
        "output_token_count",
        "cache_token_count",
        "total_token_count",
        "provider_cost_binding_status",
        "audit_required",
        "token_usage_hash"
      ],
      "properties": {
        "schema_version": { "const": "projected-token-usage-record.v1" },
        "projected_token_usage_record_id": { "type": "string" },
        "token_usage_id": { "type": "string" },
        "workflow_run_id": { "type": "string" },
        "agent_run_id": { "type": "string" },
        "runtime_id": { "type": "string" },
        "capability_id": { "type": "string" },
        "domain_pack": { "type": "string" },
        "tenant_id": { "type": "string" },
        "matter_id": { "type": "string" },
        "tracking_status": { "type": "string" },
        "input_token_count": { "type": "integer", "minimum": 0 },
        "output_token_count": { "type": "integer", "minimum": 0 },
        "cache_token_count": { "type": "integer", "minimum": 0 },
        "total_token_count": { "type": "integer", "minimum": 0 },
        "provider_cost_binding_status": { "type": "string" },
        "audit_required": { "type": "boolean" },
        "token_usage_hash": { "type": "string" }
      },
      "additionalProperties": true
    },
    "token_rollup": {
      "type": "object",
      "required": [
        "schema_version",
        "token_rollup_id",
        "rollup_type",
        "rollup_key",
        "projected_token_usage_record_count",
        "input_token_count",
        "output_token_count",
        "cache_token_count",
        "total_token_count"
      ],
      "properties": {
        "schema_version": { "const": "token-usage-rollup.v1" },
        "token_rollup_id": { "type": "string" },
        "rollup_type": { "type": "string" },
        "rollup_key": { "type": "string" },
        "projected_token_usage_record_count": { "type": "integer", "minimum": 0 },
        "input_token_count": { "type": "integer", "minimum": 0 },
        "output_token_count": { "type": "integer", "minimum": 0 },
        "cache_token_count": { "type": "integer", "minimum": 0 },
        "total_token_count": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": true
    },
    "validation_item": {
      "type": "object",
      "required": ["path", "check_id", "status", "message"],
      "properties": {
        "path": { "type": "string" },
        "check_id": { "type": "string" },
        "status": { "enum": ["passed", "failed"] },
        "message": { "type": "string" }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
