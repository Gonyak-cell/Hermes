{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://amic.local/hermes/workflow-state-machine-runner.schema.json",
  "title": "Hermes Workflow State Machine Runner",
  "type": "object",
  "required": [
    "schema_version",
    "generated_at",
    "workflow_state_machine_runner_id",
    "output_dir",
    "inputs",
    "source_contracts",
    "workflow_state_machine_runner",
    "runner_contract",
    "transition_guard_records",
    "runner_audit_event_candidates",
    "workflow_runner_plans",
    "validation_items",
    "validation",
    "summary"
  ],
  "properties": {
    "schema_version": { "const": "workflow-state-machine-runner.v1" },
    "generated_at": { "type": "string", "format": "date-time" },
    "workflow_state_machine_runner_id": { "type": "string", "minLength": 1 },
    "output_dir": { "type": "string" },
    "inputs": { "type": "object" },
    "source_contracts": { "type": "object" },
    "workflow_state_machine_runner": {
      "type": "object",
      "required": [
        "schema_version",
        "runner_contract",
        "transition_guard_records",
        "runner_audit_event_candidates",
        "workflow_runner_plans"
      ],
      "properties": {
        "schema_version": { "const": "workflow-state-machine-runner.v1" },
        "runner_contract": { "$ref": "#/$defs/runner_contract" },
        "transition_guard_records": { "type": "array", "items": { "$ref": "#/$defs/transition_guard_record" } },
        "runner_audit_event_candidates": { "type": "array", "items": { "$ref": "#/$defs/runner_audit_event_candidate" } },
        "workflow_runner_plans": { "type": "array", "items": { "$ref": "#/$defs/workflow_runner_plan" } }
      },
      "additionalProperties": true
    },
    "runner_contract": { "$ref": "#/$defs/runner_contract" },
    "transition_guard_records": {
      "type": "array",
      "items": { "$ref": "#/$defs/transition_guard_record" }
    },
    "runner_audit_event_candidates": {
      "type": "array",
      "items": { "$ref": "#/$defs/runner_audit_event_candidate" }
    },
    "workflow_runner_plans": {
      "type": "array",
      "items": { "$ref": "#/$defs/workflow_runner_plan" }
    },
    "validation_items": {
      "type": "array",
      "items": { "$ref": "#/$defs/validation_item" }
    },
    "validation": {
      "type": "object",
      "required": ["valid", "errors"],
      "properties": {
        "valid": { "type": "boolean" },
        "errors": {
          "type": "array",
          "items": { "$ref": "#/$defs/validation_error" }
        }
      },
      "additionalProperties": true
    },
    "summary": {
      "type": "object",
      "required": [
        "workflow_state_machine_runner_status",
        "runner_contract_id",
        "source_workflow_dsl_state_model_status",
        "workflow_run_projection_count",
        "runner_plan_count",
        "transition_guard_count",
        "audit_event_candidate_count",
        "guard_audit_binding_count",
        "transition_guard_without_audit_count",
        "transition_guard_without_rule_count",
        "human_review_guard_count",
        "law_firm_human_review_guard_count",
        "protected_action_executed_count",
        "validation_item_count",
        "validation_error_count"
      ],
      "properties": {
        "workflow_state_machine_runner_status": { "enum": ["complete", "blocked"] },
        "runner_contract_id": { "const": "workflow-state-machine-runner.v1" },
        "source_workflow_dsl_state_model_status": { "type": "string" },
        "source_state_model_version": { "type": ["string", "null"] },
        "workflow_run_projection_count": { "type": "integer", "minimum": 0 },
        "runner_plan_count": { "type": "integer", "minimum": 0 },
        "transition_guard_count": { "type": "integer", "minimum": 0 },
        "guarded_transition_count": { "type": "integer", "minimum": 0 },
        "audit_event_candidate_count": { "type": "integer", "minimum": 0 },
        "guard_audit_binding_count": { "type": "integer", "minimum": 0 },
        "transition_guard_without_audit_count": { "type": "integer", "minimum": 0 },
        "transition_guard_without_rule_count": { "type": "integer", "minimum": 0 },
        "allowed_guard_count": { "type": "integer", "minimum": 0 },
        "waiting_guard_count": { "type": "integer", "minimum": 0 },
        "blocked_guard_count": { "type": "integer", "minimum": 0 },
        "terminal_guard_count": { "type": "integer", "minimum": 0 },
        "human_review_guard_count": { "type": "integer", "minimum": 0 },
        "law_firm_human_review_guard_count": { "type": "integer", "minimum": 0 },
        "auto_transition_count": { "type": "integer", "minimum": 0 },
        "protected_action_executed_count": { "type": "integer", "minimum": 0 },
        "validation_item_count": { "type": "integer", "minimum": 0 },
        "failed_validation_item_count": { "type": "integer", "minimum": 0 },
        "validation_error_count": { "type": "integer", "minimum": 0 },
        "by_guard_status": { "type": "object" },
        "by_runner_plan_status": { "type": "object" }
      },
      "additionalProperties": true
    }
  },
  "$defs": {
    "runner_contract": {
      "type": "object",
      "required": [
        "schema_version",
        "runner_contract_id",
        "source_state_model_version",
        "deterministic_runner",
        "protected_action_execution_allowed",
        "transition_guard_policy",
        "audit_event_policy"
      ],
      "properties": {
        "schema_version": { "const": "workflow-state-machine-runner-contract.v1" },
        "runner_contract_id": { "const": "workflow-state-machine-runner.v1" },
        "source_state_model_version": { "type": "string", "minLength": 1 },
        "deterministic_runner": { "const": true },
        "protected_action_execution_allowed": { "const": false },
        "transition_guard_policy": { "type": "object" },
        "audit_event_policy": { "type": "object" }
      },
      "additionalProperties": true
    },
    "transition_guard_record": {
      "type": "object",
      "required": [
        "schema_version",
        "transition_guard_id",
        "workflow_run_id",
        "workflow_id",
        "capability_id",
        "domain_pack",
        "from_dsl_state",
        "to_dsl_state",
        "transition_rule_found",
        "transition_guard_status",
        "guard_decision",
        "guard_reason",
        "transition_allowed",
        "requires_human_review",
        "law_firm_human_review_required",
        "auto_transition_allowed",
        "protected_action_executed",
        "audit_event_required",
        "audit_event_candidate_id"
      ],
      "properties": {
        "schema_version": { "const": "workflow-transition-guard.v1" },
        "transition_guard_id": { "type": "string", "minLength": 1 },
        "workflow_run_id": { "type": "string", "minLength": 1 },
        "workflow_id": { "type": ["string", "null"] },
        "capability_id": { "type": ["string", "null"] },
        "domain_pack": { "type": "string", "minLength": 1 },
        "from_dsl_state": { "enum": ["started", "waiting", "gated", "approved", "failed", "completed", "unknown"] },
        "to_dsl_state": { "type": ["string", "null"] },
        "transition_rule_id": { "type": ["string", "null"] },
        "transition_rule_found": { "type": "boolean" },
        "transition_guard_status": { "enum": ["allowed", "waiting", "blocked", "terminal"] },
        "guard_decision": { "enum": ["allow", "hold", "reject", "terminal"] },
        "guard_reason": { "type": "string", "minLength": 1 },
        "transition_allowed": { "type": "boolean" },
        "requires_human_review": { "type": "boolean" },
        "law_firm_human_review_required": { "type": "boolean" },
        "auto_transition_allowed": { "type": "boolean" },
        "protected_action_executed": { "const": false },
        "audit_event_required": { "const": true },
        "audit_event_candidate_id": { "type": "string", "minLength": 1 },
        "source_projection_status": { "type": "string" },
        "source_run_status": { "type": "string" },
        "source_terminal_state": { "type": "string" },
        "policy_snapshot_id": { "type": ["string", "null"] },
        "event_envelope_ids": { "type": "array", "items": { "type": "string" } },
        "generated_at": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": true
    },
    "runner_audit_event_candidate": {
      "type": "object",
      "required": [
        "schema_version",
        "audit_event_candidate_id",
        "transition_guard_id",
        "workflow_run_id",
        "audit_domain",
        "audit_type",
        "audit_status",
        "audit_severity",
        "actor_ref",
        "event_time",
        "guard_decision",
        "transition_guard_status",
        "requires_human_review",
        "auto_transition_allowed",
        "protected_action_executed",
        "event_store_binding_status"
      ],
      "properties": {
        "schema_version": { "const": "workflow-runner-audit-event-candidate.v1" },
        "audit_event_candidate_id": { "type": "string", "minLength": 1 },
        "transition_guard_id": { "type": "string", "minLength": 1 },
        "workflow_run_id": { "type": "string", "minLength": 1 },
        "workflow_id": { "type": ["string", "null"] },
        "capability_id": { "type": ["string", "null"] },
        "domain_pack": { "type": "string", "minLength": 1 },
        "audit_domain": { "const": "workflow" },
        "audit_type": { "const": "workflow.transition_guard.evaluated" },
        "audit_status": { "enum": ["ready", "blocked"] },
        "audit_severity": { "enum": ["info", "warning"] },
        "actor_ref": { "type": "object" },
        "event_time": { "type": "string", "format": "date-time" },
        "from_dsl_state": { "type": "string" },
        "to_dsl_state": { "type": ["string", "null"] },
        "guard_decision": { "enum": ["allow", "hold", "reject", "terminal"] },
        "transition_guard_status": { "enum": ["allowed", "waiting", "blocked", "terminal"] },
        "guard_reason": { "type": "string" },
        "requires_human_review": { "type": "boolean" },
        "law_firm_human_review_required": { "type": "boolean" },
        "auto_transition_allowed": { "type": "boolean" },
        "protected_action_executed": { "const": false },
        "event_store_binding_status": { "const": "candidate_not_appended" },
        "source_audit_event_ledger_status": { "type": "string" },
        "audit_payload": { "type": "object" }
      },
      "additionalProperties": true
    },
    "workflow_runner_plan": {
      "type": "object",
      "required": [
        "schema_version",
        "workflow_runner_plan_id",
        "workflow_run_id",
        "current_dsl_state",
        "next_dsl_state",
        "transition_guard_id",
        "audit_event_candidate_id",
        "runner_plan_status",
        "next_action",
        "protected_action_execution_allowed"
      ],
      "properties": {
        "schema_version": { "const": "workflow-runner-plan.v1" },
        "workflow_runner_plan_id": { "type": "string", "minLength": 1 },
        "workflow_run_id": { "type": "string", "minLength": 1 },
        "workflow_id": { "type": ["string", "null"] },
        "capability_id": { "type": ["string", "null"] },
        "domain_pack": { "type": "string" },
        "current_dsl_state": { "type": "string" },
        "next_dsl_state": { "type": ["string", "null"] },
        "transition_guard_id": { "type": "string" },
        "audit_event_candidate_id": { "type": ["string", "null"] },
        "runner_plan_status": { "enum": ["ready", "waiting", "blocked", "terminal"] },
        "next_action": { "enum": ["emit_audit_and_transition", "await_human_review", "inspect_transition_blocker", "no_op_terminal"] },
        "protected_action_execution_allowed": { "const": false },
        "generated_at": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": true
    },
    "validation_item": {
      "type": "object",
      "required": ["check_id", "path", "status", "message"],
      "properties": {
        "check_id": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 },
        "status": { "enum": ["passed", "failed"] },
        "message": { "type": "string" }
      },
      "additionalProperties": true
    },
    "validation_error": {
      "type": "object",
      "required": ["path", "message"],
      "properties": {
        "path": { "type": "string" },
        "message": { "type": "string" }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
