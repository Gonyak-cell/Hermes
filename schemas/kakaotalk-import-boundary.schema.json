{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "kakaotalk-import-boundary.schema.json",
  "title": "KakaoTalk Import Boundary",
  "type": "object",
  "required": [
    "schema_version",
    "generated_at",
    "kakaotalk_import_boundary_id",
    "connector_id",
    "connector_status",
    "connector_contract_binding",
    "source_binding",
    "auth_boundary",
    "kakaotalk_message_records",
    "kakaotalk_attachment_records",
    "kakaotalk_conversation_records",
    "cursor_state",
    "kakaotalk_import_boundary",
    "validation_items",
    "validation",
    "summary"
  ],
  "properties": {
    "schema_version": { "const": "kakaotalk-import-boundary.v1" },
    "generated_at": { "type": "string" },
    "kakaotalk_import_boundary_id": { "type": "string" },
    "connector_id": { "const": "connector.kakaotalk_export.v2" },
    "connector_status": { "enum": ["complete", "attention"] },
    "connector_contract_binding": {
      "type": "object",
      "required": ["binding_status", "connector_id", "source_id", "source_system", "connector_family", "phase_slot"],
      "properties": {
        "binding_status": { "const": "bound" },
        "connector_id": { "const": "connector.kakaotalk_export.v2" },
        "source_id": { "type": "string" },
        "source_system": { "const": "kakaotalk" },
        "connector_family": { "const": "kakaotalk_export" },
        "phase_slot": { "const": "P271" }
      }
    },
    "source_binding": {
      "type": "object",
      "required": [
        "source_binding_status",
        "source_id",
        "source_system",
        "source_kind",
        "tenant_id_required",
        "matter_id_required",
        "classification_required",
        "policy_snapshot_required"
      ],
      "properties": {
        "source_binding_status": { "const": "bound" },
        "source_id": { "type": "string" },
        "source_system": { "const": "kakaotalk" },
        "source_kind": { "const": "export_file" },
        "tenant_id_required": { "const": true },
        "matter_id_required": { "const": true },
        "classification_required": { "const": true },
        "policy_snapshot_required": { "const": true }
      }
    },
    "auth_boundary": {
      "type": "object",
      "required": [
        "auth_boundary_status",
        "auth_mode",
        "credential_ref_required",
        "credential_reference_only",
        "credential_material_read",
        "raw_secret_material_allowed",
        "external_network_access_required_for_runtime",
        "external_network_access_performed",
        "kakaotalk_app_execution_performed",
        "connector_execution_performed",
        "local_export_read_performed",
        "read_operations_allowed",
        "write_operations_allowed",
        "source_mutation_performed"
      ],
      "properties": {
        "auth_boundary_status": { "const": "enforced" },
        "auth_mode": { "const": "operator_provided_export" },
        "credential_ref_required": { "const": false },
        "credential_reference_only": { "const": true },
        "credential_material_read": { "const": false },
        "raw_secret_material_allowed": { "const": false },
        "external_network_access_required_for_runtime": { "const": false },
        "external_network_access_performed": { "const": false },
        "kakaotalk_app_execution_performed": { "const": false },
        "connector_execution_performed": { "const": true },
        "local_export_read_performed": { "const": true },
        "read_operations_allowed": { "const": true },
        "write_operations_allowed": { "const": false },
        "source_mutation_performed": { "const": false }
      }
    },
    "kakaotalk_message_records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "message_record_id",
          "connector_id",
          "source_id",
          "matter_id",
          "external_id",
          "external_version_id",
          "resource_id",
          "resource_version_id",
          "resource_type",
          "message_status",
          "chat_room_id",
          "source_line_number",
          "line_offset",
          "author",
          "message_date",
          "text_hash_sha256",
          "metadata_complete",
          "human_review_required"
        ],
        "properties": {
          "message_record_id": { "type": "string" },
          "connector_id": { "const": "connector.kakaotalk_export.v2" },
          "source_id": { "type": "string" },
          "matter_id": { "type": "string" },
          "external_id": { "type": "string" },
          "external_version_id": { "type": "string" },
          "resource_id": { "type": "string" },
          "resource_version_id": { "type": "string" },
          "resource_type": { "const": "chat_message" },
          "message_status": { "const": "resource_candidate_ready" },
          "chat_resource_status": { "const": "ready" },
          "resource_projection_status": { "const": "ready" },
          "review_status": { "const": "needs_review" },
          "chat_room_id": { "type": "string" },
          "source_line_number": { "type": "integer", "minimum": 1 },
          "line_offset": { "type": "integer", "minimum": 1 },
          "author": { "type": "string" },
          "message_date": { "type": "string" },
          "text_hash_sha256": { "type": "string" },
          "metadata_complete": { "const": true },
          "human_review_required": { "const": true },
          "source_mutation_performed": { "const": false },
          "resource_mutation_performed": { "const": false },
          "client_facing_output_generated": { "const": false }
        }
      }
    },
    "kakaotalk_attachment_records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "attachment_record_id",
          "message_record_id",
          "connector_id",
          "source_id",
          "matter_id",
          "parent_message_resource_id",
          "parent_message_line",
          "attachment_name",
          "external_id",
          "external_version_id",
          "resource_id",
          "resource_version_id",
          "resource_type",
          "attachment_status",
          "content_materialization_status",
          "attachment_content_read_performed",
          "human_review_required"
        ],
        "properties": {
          "attachment_record_id": { "type": "string" },
          "message_record_id": { "type": "string" },
          "connector_id": { "const": "connector.kakaotalk_export.v2" },
          "source_id": { "type": "string" },
          "matter_id": { "type": "string" },
          "parent_message_resource_id": { "type": "string" },
          "parent_message_line": { "type": "integer", "minimum": 1 },
          "attachment_name": { "type": "string" },
          "external_id": { "type": "string" },
          "external_version_id": { "type": "string" },
          "resource_id": { "type": "string" },
          "resource_version_id": { "type": "string" },
          "resource_type": { "const": "chat_attachment" },
          "attachment_status": { "const": "resource_candidate_ready" },
          "chat_resource_status": { "const": "ready" },
          "resource_projection_status": { "const": "ready" },
          "content_materialization_status": { "const": "operator_export_metadata_only_pending_human_review" },
          "attachment_content_read_performed": { "const": false },
          "review_status": { "const": "needs_review" },
          "human_review_required": { "const": true },
          "source_mutation_performed": { "const": false },
          "resource_mutation_performed": { "const": false }
        }
      }
    },
    "kakaotalk_conversation_records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "conversation_record_id",
          "connector_id",
          "source_id",
          "matter_id",
          "chat_room_id",
          "conversation_status",
          "message_count",
          "message_record_ids",
          "resource_projection_status",
          "human_review_required"
        ],
        "properties": {
          "conversation_record_id": { "type": "string" },
          "connector_id": { "const": "connector.kakaotalk_export.v2" },
          "source_id": { "type": "string" },
          "matter_id": { "type": "string" },
          "chat_room_id": { "type": "string" },
          "conversation_status": { "const": "complete" },
          "message_count": { "type": "integer", "minimum": 1 },
          "attachment_count": { "type": "integer", "minimum": 0 },
          "message_record_ids": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string" }
          },
          "resource_projection_status": { "const": "ready" },
          "review_status": { "const": "needs_review" },
          "human_review_required": { "const": true },
          "source_mutation_performed": { "const": false },
          "resource_mutation_performed": { "const": false }
        }
      }
    },
    "cursor_state": {
      "type": "object",
      "required": [
        "cursor_status",
        "cursor_kind",
        "resume_supported",
        "cursor_storage_mode",
        "resume_token_hash",
        "raw_export_cursor_material_allowed",
        "cross_matter_cursor_reuse_allowed",
        "reset_requires_human_review"
      ],
      "properties": {
        "cursor_status": { "const": "complete" },
        "cursor_kind": { "const": "export_line_offset_cursor" },
        "resume_supported": { "const": true },
        "cursor_storage_mode": { "const": "line_offset_hash_only" },
        "resume_token_hash": { "type": "string" },
        "raw_export_cursor_material_allowed": { "const": false },
        "cross_matter_cursor_reuse_allowed": { "const": false },
        "reset_requires_human_review": { "const": true }
      }
    },
    "kakaotalk_import_boundary": {
      "type": "object",
      "required": [
        "boundary_status",
        "operator_export_only",
        "import_boundary_only",
        "kakaotalk_app_execution_performed",
        "live_chat_api_execution_performed",
        "local_export_read_performed",
        "connector_execution_performed",
        "source_read_performed",
        "source_mutation_performed",
        "external_network_access_performed",
        "credential_material_read",
        "resource_mutation_performed",
        "output_delivery_performed",
        "protected_action_executed",
        "legal_advice_generated",
        "client_facing_output_generated",
        "human_review_required"
      ],
      "properties": {
        "boundary_status": { "const": "enforced" },
        "operator_export_only": { "const": true },
        "import_boundary_only": { "const": true },
        "kakaotalk_app_execution_performed": { "const": false },
        "live_chat_api_execution_performed": { "const": false },
        "local_export_read_performed": { "const": true },
        "connector_execution_performed": { "const": true },
        "source_read_performed": { "const": true },
        "source_mutation_performed": { "const": false },
        "external_network_access_performed": { "const": false },
        "credential_material_read": { "const": false },
        "raw_secret_material_allowed": { "const": false },
        "resource_mutation_performed": { "const": false },
        "output_delivery_performed": { "const": false },
        "protected_action_executed": { "const": false },
        "legal_advice_generated": { "const": false },
        "client_facing_output_generated": { "const": false },
        "human_review_required": { "const": true }
      }
    },
    "validation_items": {
      "type": "array",
      "items": { "type": "object" }
    },
    "validation": { "type": "object" },
    "summary": {
      "type": "object",
      "required": [
        "kakaotalk_import_boundary_status",
        "connector_id",
        "source_id",
        "phase_slot",
        "source_outlook_email_connector_status",
        "message_count",
        "attachment_count",
        "conversation_count",
        "resource_candidate_count",
        "metadata_complete_message_count",
        "line_offset_count",
        "attachment_parent_link_count",
        "conversation_message_link_count",
        "cursor_status",
        "cursor_resume_supported",
        "raw_export_cursor_material_allowed",
        "credential_ref_required",
        "credential_reference_only",
        "raw_secret_material_allowed",
        "operator_export_only",
        "import_boundary_only",
        "kakaotalk_app_execution_performed",
        "live_chat_api_execution_performed",
        "external_network_access_performed",
        "source_mutation_performed",
        "resource_mutation_performed",
        "output_delivery_performed",
        "protected_action_executed",
        "legal_advice_generated",
        "client_facing_output_generated",
        "validation_error_count"
      ],
      "properties": {
        "kakaotalk_import_boundary_status": { "const": "complete" },
        "connector_id": { "const": "connector.kakaotalk_export.v2" },
        "source_id": { "type": "string" },
        "phase_slot": { "const": "P271" },
        "source_outlook_email_connector_status": { "const": "complete" },
        "message_count": { "type": "integer", "minimum": 1 },
        "attachment_count": { "type": "integer", "minimum": 1 },
        "conversation_count": { "type": "integer", "minimum": 1 },
        "resource_candidate_count": { "type": "integer", "minimum": 2 },
        "metadata_complete_message_count": { "type": "integer", "minimum": 1 },
        "line_offset_count": { "type": "integer", "minimum": 1 },
        "attachment_parent_link_count": { "type": "integer", "minimum": 1 },
        "conversation_message_link_count": { "type": "integer", "minimum": 1 },
        "cursor_status": { "const": "complete" },
        "cursor_resume_supported": { "const": true },
        "raw_export_cursor_material_allowed": { "const": false },
        "credential_ref_required": { "const": false },
        "credential_reference_only": { "const": true },
        "raw_secret_material_allowed": { "const": false },
        "operator_export_only": { "const": true },
        "import_boundary_only": { "const": true },
        "kakaotalk_app_execution_performed": { "const": false },
        "live_chat_api_execution_performed": { "const": false },
        "external_network_access_performed": { "const": false },
        "source_mutation_performed": { "const": false },
        "resource_mutation_performed": { "const": false },
        "output_delivery_performed": { "const": false },
        "protected_action_executed": { "const": false },
        "legal_advice_generated": { "const": false },
        "client_facing_output_generated": { "const": false },
        "validation_error_count": { "const": 0 }
      }
    }
  }
}
