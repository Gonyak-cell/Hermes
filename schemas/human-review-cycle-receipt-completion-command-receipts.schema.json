{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://amic.local/hermes/human-review-cycle-receipt-completion-command-receipts.schema.json",
  "title": "Hermes Human Review Cycle Receipt Completion Command Receipts",
  "type": "object",
  "required": [
    "schema_version",
    "generated_at",
    "command_receipt_draft_id",
    "output_dir",
    "receipt_status",
    "safe_handling",
    "sources",
    "summary",
    "receipt_requirements",
    "receipt_input_draft",
    "held_command_references",
    "validation"
  ],
  "properties": {
    "schema_version": { "const": "human-review-cycle-receipt-completion-command-receipts.v1" },
    "generated_at": { "type": "string", "format": "date-time" },
    "command_receipt_draft_id": { "type": "string" },
    "output_dir": { "type": "string" },
    "receipt_status": { "enum": ["clear", "pending_command_receipts", "blocked_missing_command_queue"] },
    "safe_handling": { "$ref": "#/$defs/safe_handling" },
    "sources": { "type": "array", "items": { "$ref": "#/$defs/source" } },
    "summary": {
      "type": "object",
      "required": [
        "receipt_status",
        "command_queue_available",
        "source_command_queue_id",
        "source_ready_command_count",
        "source_held_command_count",
        "receipt_requirement_count",
        "receipt_draft_count",
        "pending_receipt_count",
        "command_receipt_count",
        "held_command_reference_count",
        "protected_held_command_count",
        "required_field_count",
        "validation_error_count",
        "by_command_kind",
        "by_hold_status"
      ],
      "properties": {
        "receipt_status": { "enum": ["clear", "pending_command_receipts", "blocked_missing_command_queue"] },
        "command_queue_available": { "type": "boolean" },
        "source_command_queue_id": { "type": ["string", "null"] },
        "source_ready_command_count": { "type": "integer", "minimum": 0 },
        "source_held_command_count": { "type": "integer", "minimum": 0 },
        "receipt_requirement_count": { "type": "integer", "minimum": 0 },
        "receipt_draft_count": { "type": "integer", "minimum": 0 },
        "pending_receipt_count": { "type": "integer", "minimum": 0 },
        "command_receipt_count": { "type": "integer", "minimum": 0 },
        "held_command_reference_count": { "type": "integer", "minimum": 0 },
        "protected_held_command_count": { "type": "integer", "minimum": 0 },
        "required_field_count": { "type": "integer", "minimum": 0 },
        "validation_error_count": { "type": "integer", "minimum": 0 },
        "by_command_kind": { "type": "object" },
        "by_hold_status": { "type": "object" }
      }
    },
    "receipt_requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "receipt_requirement_id",
          "queue_item_id",
          "command_gate_id",
          "runbook_step_id",
          "step_key",
          "command_kind",
          "command",
          "queue_status",
          "required_receipt_fields",
          "acceptance_criteria",
          "receipt_form_draft"
        ],
        "properties": {
          "receipt_requirement_id": { "type": "string" },
          "queue_item_id": { "type": "string" },
          "command_gate_id": { "type": "string" },
          "runbook_step_id": { "type": "string" },
          "step_key": { "type": "string" },
          "command_kind": { "type": "string" },
          "command": { "type": "string" },
          "queue_status": { "const": "ready_to_run_manually" },
          "required_receipt_fields": { "type": "array", "items": { "type": "string" } },
          "acceptance_criteria": { "type": "array", "items": { "type": "string" } },
          "receipt_form_draft": { "$ref": "#/$defs/receipt" }
        }
      }
    },
    "receipt_input_draft": {
      "type": "object",
      "required": ["schema_version", "generated_at", "command_queue_id", "instructions", "receipts"],
      "properties": {
        "schema_version": { "const": "human-review-cycle-receipt-completion-command-receipts-input.v1" },
        "generated_at": { "type": "string", "format": "date-time" },
        "command_queue_id": { "type": "string" },
        "instructions": { "type": "string" },
        "receipts": { "type": "array", "items": { "$ref": "#/$defs/receipt" } }
      }
    },
    "held_command_references": { "type": "array", "items": { "$ref": "#/$defs/held_command_reference" } },
    "validation": { "$ref": "#/$defs/validation" }
  },
  "$defs": {
    "receipt": {
      "type": "object",
      "required": [
        "receipt_id",
        "queue_item_id",
        "command_gate_id",
        "runbook_step_id",
        "step_key",
        "command_kind",
        "command",
        "receipt_status",
        "command_result",
        "executed_by",
        "executed_at",
        "output_reference",
        "notes",
        "commands_run",
        "required_receipt_fields",
        "generated_at"
      ],
      "properties": {
        "receipt_id": { "type": "string" },
        "queue_item_id": { "type": "string" },
        "command_gate_id": { "type": "string" },
        "runbook_step_id": { "type": "string" },
        "step_key": { "type": "string" },
        "command_kind": { "type": "string" },
        "command": { "type": "string" },
        "receipt_status": { "type": "string" },
        "command_result": { "type": "string" },
        "executed_by": { "type": "string" },
        "executed_at": { "type": "string" },
        "output_reference": { "type": "string" },
        "notes": { "type": "string" },
        "commands_run": { "type": "array", "items": { "type": "string" } },
        "required_receipt_fields": { "type": "array", "items": { "type": "string" } },
        "generated_at": { "type": "string", "format": "date-time" }
      }
    },
    "held_command_reference": {
      "type": "object",
      "required": [
        "held_command_ref_id",
        "held_command_id",
        "command_gate_id",
        "step_key",
        "command_kind",
        "command",
        "command_status",
        "hold_status",
        "hold_reason",
        "requires_explicit_human_approval"
      ],
      "properties": {
        "held_command_ref_id": { "type": "string" },
        "held_command_id": { "type": "string" },
        "command_gate_id": { "type": "string" },
        "step_key": { "type": "string" },
        "command_kind": { "type": "string" },
        "command": { "type": "string" },
        "command_status": { "type": "string" },
        "hold_status": { "type": "string" },
        "hold_reason": { "type": "string" },
        "requires_explicit_human_approval": { "type": "boolean" }
      }
    },
    "source": {
      "type": "object",
      "required": ["source_id", "label", "path", "available", "schema_version", "generated_at", "summary", "error"],
      "properties": {
        "source_id": { "type": "string" },
        "label": { "type": "string" },
        "path": { "type": "string" },
        "available": { "type": "boolean" },
        "schema_version": { "type": ["string", "null"] },
        "generated_at": { "type": ["string", "null"], "format": "date-time" },
        "summary": { "type": ["object", "null"] },
        "error": { "type": ["string", "null"] }
      }
    },
    "safe_handling": {
      "type": "object",
      "required": ["auto_execute_allowed", "command_receipts_only", "protected_actions_executed", "receipt_edits_must_be_manual"],
      "properties": {
        "auto_execute_allowed": { "const": false },
        "command_receipts_only": { "const": true },
        "protected_actions_executed": { "const": false },
        "receipt_edits_must_be_manual": { "const": true }
      }
    },
    "validation": {
      "type": "object",
      "required": ["valid", "errors"],
      "properties": {
        "valid": { "type": "boolean" },
        "errors": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["path", "message"],
            "properties": {
              "path": { "type": "string" },
              "message": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
