{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://amic.local/hermes/human-review-cycle-receipt-completion-command-receipt-feedback.schema.json",
  "title": "Hermes Human Review Cycle Receipt Completion Command Receipt Feedback",
  "type": "object",
  "required": [
    "schema_version",
    "generated_at",
    "feedback_id",
    "output_dir",
    "feedback_status",
    "safe_handling",
    "sources",
    "summary",
    "actor_feedback",
    "feedback_items",
    "validation"
  ],
  "properties": {
    "schema_version": { "const": "human-review-cycle-receipt-completion-command-receipt-feedback.v1" },
    "generated_at": { "type": "string", "format": "date-time" },
    "feedback_id": { "type": "string" },
    "output_dir": { "type": "string" },
    "feedback_status": { "enum": ["clear", "pending_human_review", "ready_for_confirmation", "attention", "blocked"] },
    "safe_handling": { "$ref": "#/$defs/safe_handling" },
    "sources": { "type": "array", "items": { "$ref": "#/$defs/source" } },
    "summary": {
      "type": "object",
      "required": [
        "actor_feedback_count",
        "feedback_item_count",
        "pending_receipt_count",
        "ready_for_confirmation_count",
        "needs_correction_count",
        "invalid_receipt_count",
        "missing_receipt_count",
        "unknown_receipt_count",
        "validation_error_count",
        "by_required_actor",
        "by_command_kind",
        "by_validation_status",
        "by_feedback_status"
      ],
      "properties": {
        "actor_feedback_count": { "type": "integer", "minimum": 0 },
        "feedback_item_count": { "type": "integer", "minimum": 0 },
        "pending_receipt_count": { "type": "integer", "minimum": 0 },
        "ready_for_confirmation_count": { "type": "integer", "minimum": 0 },
        "needs_correction_count": { "type": "integer", "minimum": 0 },
        "invalid_receipt_count": { "type": "integer", "minimum": 0 },
        "missing_receipt_count": { "type": "integer", "minimum": 0 },
        "unknown_receipt_count": { "type": "integer", "minimum": 0 },
        "validation_error_count": { "type": "integer", "minimum": 0 },
        "by_required_actor": { "type": "object" },
        "by_command_kind": { "type": "object" },
        "by_validation_status": { "type": "object" },
        "by_feedback_status": { "type": "object" }
      }
    },
    "actor_feedback": {
      "type": "array",
      "items": { "$ref": "#/$defs/actor_feedback" }
    },
    "feedback_items": {
      "type": "array",
      "items": { "$ref": "#/$defs/feedback_item" }
    },
    "validation": { "$ref": "#/$defs/validation" }
  },
  "$defs": {
    "source": {
      "type": "object",
      "required": ["source_id", "label", "path", "available", "schema_version", "generated_at", "summary", "error"],
      "properties": {
        "source_id": { "type": "string" },
        "label": { "type": "string" },
        "path": { "type": "string" },
        "available": { "type": "boolean" },
        "schema_version": { "type": ["string", "null"] },
        "generated_at": { "type": ["string", "null"], "format": "date-time" },
        "summary": { "type": ["object", "null"] },
        "error": { "type": ["string", "null"] }
      }
    },
    "actor_feedback": {
      "type": "object",
      "required": [
        "actor_feedback_id",
        "actor_command_queue_id",
        "required_actor",
        "feedback_status",
        "priority",
        "feedback_item_count",
        "pending_receipt_count",
        "ready_for_confirmation_count",
        "needs_correction_count",
        "feedback_item_ids",
        "feedback_json_path",
        "feedback_markdown_path",
        "safe_handling"
      ],
      "properties": {
        "actor_feedback_id": { "type": "string" },
        "actor_command_queue_id": { "type": ["string", "null"] },
        "required_actor": { "type": "string" },
        "feedback_status": { "enum": ["clear", "pending_human_review", "ready_for_confirmation", "attention"] },
        "priority": { "enum": ["critical", "high", "medium", "low"] },
        "feedback_item_count": { "type": "integer", "minimum": 0 },
        "pending_receipt_count": { "type": "integer", "minimum": 0 },
        "ready_for_confirmation_count": { "type": "integer", "minimum": 0 },
        "needs_correction_count": { "type": "integer", "minimum": 0 },
        "feedback_item_ids": { "type": "array", "items": { "type": "string" } },
        "feedback_json_path": { "type": "string" },
        "feedback_markdown_path": { "type": "string" },
        "safe_handling": { "$ref": "#/$defs/safe_handling" }
      }
    },
    "feedback_item": {
      "type": "object",
      "required": [
        "feedback_item_id",
        "validation_item_id",
        "receipt_requirement_id",
        "receipt_id",
        "queue_item_id",
        "command_gate_id",
        "runbook_step_id",
        "step_key",
        "command_kind",
        "command",
        "required_actor",
        "priority",
        "validation_status",
        "feedback_status",
        "receipt_status",
        "command_result",
        "ready_to_confirm",
        "error_count",
        "errors",
        "required_receipt_fields",
        "acceptance_criteria",
        "next_actions",
        "receipt_input_path",
        "receipt",
        "safe_handling"
      ],
      "properties": {
        "feedback_item_id": { "type": "string" },
        "validation_item_id": { "type": "string" },
        "receipt_requirement_id": { "type": ["string", "null"] },
        "receipt_id": { "type": ["string", "null"] },
        "queue_item_id": { "type": "string" },
        "command_gate_id": { "type": "string" },
        "runbook_step_id": { "type": "string" },
        "step_key": { "type": "string" },
        "command_kind": { "type": "string" },
        "command": { "type": "string" },
        "required_actor": { "type": "string" },
        "priority": { "enum": ["critical", "high", "medium", "low"] },
        "validation_status": { "enum": ["pending_receipt", "ready_to_confirm", "invalid_receipt", "missing_receipt", "unknown_command_receipt"] },
        "feedback_status": { "enum": ["needs_command_receipt", "ready_for_confirmation", "needs_correction", "attention"] },
        "receipt_status": { "type": "string" },
        "command_result": { "type": "string" },
        "ready_to_confirm": { "type": "boolean" },
        "error_count": { "type": "integer", "minimum": 0 },
        "errors": { "type": "array", "items": { "$ref": "#/$defs/receipt_error" } },
        "required_receipt_fields": { "type": "array", "items": { "type": "string" } },
        "acceptance_criteria": { "type": "array", "items": { "type": "string" } },
        "next_actions": { "type": "array", "items": { "type": "string" } },
        "receipt_input_path": { "type": "string" },
        "receipt": { "type": ["object", "null"] },
        "safe_handling": {
          "type": "object",
          "required": ["auto_execute_allowed", "feedback_only", "protected_actions_executed"],
          "properties": {
            "auto_execute_allowed": { "const": false },
            "feedback_only": { "const": true },
            "protected_actions_executed": { "const": false }
          }
        }
      }
    },
    "safe_handling": {
      "type": "object",
      "required": ["auto_execute_allowed", "draft_only", "feedback_only", "protected_actions_executed"],
      "properties": {
        "auto_execute_allowed": { "const": false },
        "draft_only": { "const": true },
        "feedback_only": { "const": true },
        "protected_actions_executed": { "const": false }
      }
    },
    "validation": {
      "type": "object",
      "required": ["valid", "errors"],
      "properties": {
        "valid": { "type": "boolean" },
        "errors": { "type": "array", "items": { "$ref": "#/$defs/validation_error" } }
      }
    },
    "receipt_error": {
      "type": "object",
      "required": ["queue_item_id", "field", "message"],
      "properties": {
        "queue_item_id": { "type": "string" },
        "field": { "type": "string" },
        "message": { "type": "string" }
      }
    },
    "validation_error": {
      "type": "object",
      "required": ["path", "message"],
      "properties": {
        "path": { "type": "string" },
        "message": { "type": "string" }
      }
    }
  }
}
