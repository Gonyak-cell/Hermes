{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hermes.local/schemas/workflow-run-dashboard.schema.json",
  "title": "Workflow Run Dashboard",
  "type": "object",
  "required": [
    "schema_version",
    "generated_at",
    "workflow_run_dashboard_id",
    "inputs",
    "source_contracts",
    "workflow_run_dashboard_contract",
    "workflow_run_dashboard_catalog",
    "workflow_run_dashboard_panels",
    "workflow_run_state_cards",
    "workflow_run_queue_cards",
    "workflow_run_gate_cards",
    "workflow_run_output_cards",
    "workflow_run_dashboard_route_records",
    "validation_items",
    "validation",
    "summary"
  ],
  "properties": {
    "schema_version": { "const": "workflow-run-dashboard.v1" },
    "generated_at": { "type": "string" },
    "workflow_run_dashboard_id": { "type": "string" },
    "inputs": { "type": "object" },
    "source_contracts": { "type": "object" },
    "workflow_run_dashboard_contract": {
      "type": "object",
      "required": [
        "workflow_run_dashboard_contract_id",
        "desktop_companion_role",
        "source_of_truth",
        "surface_policy",
        "mutation_policy",
        "protected_action_policy",
        "secret_policy",
        "installer_gateway_policy"
      ],
      "properties": {
        "workflow_run_dashboard_contract_id": { "const": "workflow-run-dashboard.v1" },
        "desktop_companion_role": { "const": "operator_companion" },
        "source_of_truth": { "const": "harness_control_plane" },
        "surface_policy": { "const": "read_only_status_summary" },
        "mutation_policy": { "const": "not_allowed_in_v1" },
        "protected_action_policy": { "const": "display_only_no_execution" },
        "secret_policy": { "const": "no_secret_material_exposed" },
        "installer_gateway_policy": { "const": "not_owned_by_core" }
      },
      "additionalProperties": true
    },
    "workflow_run_dashboard_catalog": {
      "type": "object",
      "required": [
        "workflow_run_dashboard_panels",
        "workflow_run_state_cards",
        "workflow_run_queue_cards",
        "workflow_run_gate_cards",
        "workflow_run_output_cards",
        "workflow_run_dashboard_route_records"
      ],
      "additionalProperties": true
    },
    "workflow_run_dashboard_panels": {
      "type": "array",
      "items": { "$ref": "#/$defs/panel" }
    },
    "workflow_run_state_cards": {
      "type": "array",
      "items": { "$ref": "#/$defs/read_only_card" }
    },
    "workflow_run_queue_cards": {
      "type": "array",
      "items": { "$ref": "#/$defs/read_only_card" }
    },
    "workflow_run_gate_cards": {
      "type": "array",
      "items": { "$ref": "#/$defs/read_only_card" }
    },
    "workflow_run_output_cards": {
      "type": "array",
      "items": { "$ref": "#/$defs/read_only_card" }
    },
    "workflow_run_dashboard_route_records": {
      "type": "array",
      "items": { "$ref": "#/$defs/route_record" }
    },
    "validation_items": {
      "type": "array",
      "items": { "$ref": "#/$defs/validation_item" }
    },
    "validation": {
      "type": "object",
      "required": ["valid", "errors"],
      "properties": {
        "valid": { "type": "boolean" },
        "errors": { "type": "array" }
      },
      "additionalProperties": true
    },
    "summary": {
      "type": "object",
      "required": [
        "workflow_run_dashboard_status",
        "workflow_run_dashboard_contract_id",
        "desktop_companion_readiness_status",
        "source_workflow_run_ledger_status",
        "source_workflow_dsl_state_model_status",
        "source_workflow_state_machine_runner_status",
        "source_workflow_queue_retry_backoff_status",
        "source_workflow_idempotency_status",
        "source_workflow_resume_cancel_status",
        "source_gate_result_aggregator_status",
        "source_capability_registry_api_status",
        "source_workflow_run_record_count",
        "workflow_run_dashboard_panel_count",
        "workflow_run_state_card_count",
        "workflow_run_queue_card_count",
        "workflow_run_gate_card_count",
        "workflow_run_output_card_count",
        "workflow_run_dashboard_route_count",
        "read_only_route_count",
        "mutation_route_count",
        "protected_mutation_request_route_count",
        "secret_material_route_count",
        "installer_or_gateway_route_count",
        "auto_dequeue_allowed_count",
        "auto_retry_scheduled_count",
        "auto_resume_allowed_count",
        "auto_cancel_allowed_count",
        "protected_action_executed_count",
        "final_action_executed_count",
        "validation_error_count"
      ],
      "properties": {
        "workflow_run_dashboard_status": { "enum": ["complete", "blocked"] },
        "workflow_run_dashboard_contract_id": { "const": "workflow-run-dashboard.v1" },
        "desktop_companion_readiness_status": { "enum": ["read_only_ready", "blocked"] },
        "mutation_route_count": { "const": 0 },
        "protected_mutation_request_route_count": { "const": 0 },
        "secret_material_route_count": { "const": 0 },
        "installer_or_gateway_route_count": { "const": 0 },
        "auto_dequeue_allowed_count": { "const": 0 },
        "auto_retry_scheduled_count": { "const": 0 },
        "auto_resume_allowed_count": { "const": 0 },
        "auto_cancel_allowed_count": { "const": 0 },
        "protected_action_executed_count": { "const": 0 },
        "final_action_executed_count": { "const": 0 }
      },
      "additionalProperties": true
    }
  },
  "$defs": {
    "panel": {
      "type": "object",
      "required": [
        "schema_version",
        "workflow_run_dashboard_panel_id",
        "workflow_run_id",
        "desktop_surface",
        "desktop_card_status",
        "read_only",
        "mutation_allowed",
        "protected_mutation_request_allowed",
        "secret_material_exposed",
        "installer_or_gateway_control",
        "source_of_truth",
        "route_paths",
        "query_examples",
        "human_review_note",
        "generated_at"
      ],
      "properties": {
        "schema_version": { "const": "workflow-run-dashboard-panel.v1" },
        "desktop_surface": { "const": "workflow_runs" },
        "desktop_card_status": { "enum": ["human_review_required", "ready", "blocked", "attention"] },
        "read_only": { "const": true },
        "mutation_allowed": { "const": false },
        "protected_mutation_request_allowed": { "const": false },
        "secret_material_exposed": { "const": false },
        "installer_or_gateway_control": { "const": false },
        "source_of_truth": { "const": "harness_control_plane" },
        "route_paths": {
          "type": "array",
          "items": { "type": "string" }
        },
        "query_examples": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": true
    },
    "read_only_card": {
      "type": "object",
      "required": [
        "schema_version",
        "workflow_run_id",
        "read_only",
        "mutation_allowed",
        "generated_at"
      ],
      "properties": {
        "schema_version": { "type": "string" },
        "read_only": { "const": true },
        "mutation_allowed": { "const": false }
      },
      "additionalProperties": true
    },
    "route_record": {
      "type": "object",
      "required": [
        "schema_version",
        "route_id",
        "route_method",
        "route_path",
        "collection",
        "read_only",
        "mutation_allowed",
        "protected_mutation_request_allowed",
        "secret_material_exposed",
        "installer_or_gateway_control",
        "source_of_truth"
      ],
      "properties": {
        "schema_version": { "const": "workflow-run-dashboard-route-record.v1" },
        "route_method": { "const": "GET" },
        "read_only": { "const": true },
        "mutation_allowed": { "const": false },
        "protected_mutation_request_allowed": { "const": false },
        "secret_material_exposed": { "const": false },
        "installer_or_gateway_control": { "const": false },
        "source_of_truth": { "const": "harness_control_plane" }
      },
      "additionalProperties": true
    },
    "validation_item": {
      "type": "object",
      "required": ["path", "check_id", "status", "message"],
      "properties": {
        "path": { "type": "string" },
        "check_id": { "type": "string" },
        "status": { "enum": ["passed", "failed"] },
        "message": { "type": "string" }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
