{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.hermes.local/secrets-scan-gate.schema.json",
  "title": "Secrets Scan Gate",
  "type": "object",
  "required": [
    "schema_version",
    "generated_at",
    "secrets_scan_gate_id",
    "capability_id",
    "source_statuses",
    "secrets_scan_rule_results",
    "secrets_scan_gate_results",
    "desktop_config_leakage_checks",
    "secrets_scan_boundary",
    "validation_items",
    "validation",
    "summary"
  ],
  "properties": {
    "schema_version": { "const": "secrets-scan-gate.v1" },
    "generated_at": { "type": "string" },
    "secrets_scan_gate_id": { "type": "string" },
    "capability_id": { "const": "security.secrets_scan_gate" },
    "output_dir": { "type": "string" },
    "inputs": { "type": "object" },
    "source_statuses": {
      "type": "array",
      "minItems": 9,
      "items": { "$ref": "#/$defs/source_status" }
    },
    "secrets_scan_rule_results": {
      "type": "array",
      "minItems": 10,
      "items": { "$ref": "#/$defs/rule_result" }
    },
    "secrets_scan_gate_results": {
      "type": "array",
      "minItems": 8,
      "items": { "$ref": "#/$defs/gate_result" }
    },
    "desktop_config_leakage_checks": {
      "type": "array",
      "minItems": 4,
      "items": { "$ref": "#/$defs/desktop_check" }
    },
    "secrets_scan_boundary": { "$ref": "#/$defs/boundary" },
    "validation_items": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/validation_item" }
    },
    "validation": {
      "type": "object",
      "required": ["valid", "errors"],
      "properties": {
        "valid": { "type": "boolean" },
        "errors": { "type": "array" }
      },
      "additionalProperties": true
    },
    "summary": { "$ref": "#/$defs/summary" }
  },
  "additionalProperties": true,
  "$defs": {
    "source_status": {
      "type": "object",
      "required": ["source_id", "observed_status", "source_status", "validation_error_count"],
      "properties": {
        "source_id": { "type": "string" },
        "observed_status": { "type": "string" },
        "source_status": { "const": "passed" },
        "validation_error_count": { "const": 0 }
      },
      "additionalProperties": true
    },
    "rule_result": {
      "type": "object",
      "required": ["rule_id", "source_id", "rule_status", "gate_fail_on_leakage", "leakage_allowed"],
      "properties": {
        "rule_id": { "type": "string" },
        "source_id": { "type": "string" },
        "rule_status": { "const": "passed" },
        "gate_fail_on_leakage": { "const": true },
        "leakage_allowed": { "const": false },
        "observed": { "type": "object" }
      },
      "additionalProperties": true
    },
    "gate_result": {
      "type": "object",
      "required": [
        "leakage_kind",
        "observed_leakage_count",
        "leakage_detected",
        "gate_decision",
        "gate_fail_on_leakage",
        "leakage_allowed",
        "gate_status"
      ],
      "properties": {
        "leakage_kind": { "type": "string" },
        "observed_leakage_count": { "const": 0 },
        "leakage_detected": { "const": false },
        "gate_decision": { "const": "fail_on_leakage" },
        "gate_fail_on_leakage": { "const": true },
        "leakage_allowed": { "const": false },
        "gate_status": { "const": "passed" },
        "human_review_required": { "const": true },
        "client_facing_ready": { "const": false }
      },
      "additionalProperties": true
    },
    "desktop_check": {
      "type": "object",
      "required": ["check_id", "leakage_detected", "gate_fail_on_leakage", "check_status"],
      "properties": {
        "check_id": { "type": "string" },
        "leakage_detected": { "const": false },
        "gate_fail_on_leakage": { "const": true },
        "check_status": { "const": "passed" }
      },
      "additionalProperties": true
    },
    "boundary": {
      "type": "object",
      "required": [
        "boundary_status",
        "read_only",
        "scan_report_only",
        "source_artifact_read_performed",
        "source_content_read_performed",
        "source_ingest_performed",
        "filesystem_secret_scan_performed",
        "secret_material_read",
        "secret_material_materialized",
        "env_file_read",
        "desktop_config_read",
        "desktop_setting_mutation_allowed",
        "provider_key_materialized",
        "network_access_performed",
        "route_execution_performed",
        "server_started",
        "legal_advice_generated",
        "client_facing_output_generated",
        "human_review_required",
        "client_facing_ready",
        "windows_baseline_stability_preserved",
        "mac_windows_completion_instability_guard"
      ],
      "properties": {
        "boundary_status": { "const": "enforced" },
        "read_only": { "const": true },
        "scan_report_only": { "const": true },
        "source_artifact_read_performed": { "const": true },
        "source_content_read_performed": { "const": false },
        "source_ingest_performed": { "const": false },
        "filesystem_secret_scan_performed": { "const": false },
        "secret_material_read": { "const": false },
        "secret_material_materialized": { "const": false },
        "env_file_read": { "const": false },
        "desktop_config_read": { "const": false },
        "desktop_setting_mutation_allowed": { "const": false },
        "provider_key_materialized": { "const": false },
        "network_access_performed": { "const": false },
        "route_execution_performed": { "const": false },
        "server_started": { "const": false },
        "legal_advice_generated": { "const": false },
        "client_facing_output_generated": { "const": false },
        "human_review_required": { "const": true },
        "client_facing_ready": { "const": false },
        "windows_baseline_stability_preserved": { "const": true },
        "mac_windows_completion_instability_guard": { "const": true }
      },
      "additionalProperties": true
    },
    "validation_item": {
      "type": "object",
      "required": ["path", "check_id", "status", "message"],
      "properties": {
        "path": { "type": "string" },
        "check_id": { "type": "string" },
        "status": { "enum": ["passed", "failed"] },
        "message": { "type": "string" }
      },
      "additionalProperties": true
    },
    "summary": {
      "type": "object",
      "required": [
        "secrets_scan_gate_status",
        "phase_slot",
        "previous_phase_slot",
        "next_phase_slot",
        "rule_result_count",
        "gate_result_count",
        "desktop_config_leakage_check_count",
        "leakage_allowed_count",
        "credential_leakage_detected_count",
        "token_leakage_detected_count",
        "env_leakage_detected_count",
        "desktop_config_leakage_detected_count",
        "provider_key_leakage_detected_count",
        "raw_secret_material_allowed_count",
        "raw_secret_material_exposed_count",
        "provider_key_direct_access_allowed_count",
        "desktop_provider_key_visible_count",
        "secret_material_read_count",
        "secret_material_materialized_count",
        "env_file_read_count",
        "desktop_config_read_count",
        "read_only",
        "scan_report_only",
        "source_content_read_performed",
        "source_ingest_performed",
        "filesystem_secret_scan_performed",
        "secret_material_read",
        "secret_material_materialized",
        "env_file_read",
        "desktop_config_read",
        "provider_key_materialized",
        "route_execution_performed",
        "server_started",
        "legal_advice_generated",
        "client_facing_output_generated",
        "human_review_required",
        "client_facing_ready",
        "windows_baseline_stability_preserved",
        "mac_windows_completion_instability_guard",
        "validation_error_count"
      ],
      "properties": {
        "secrets_scan_gate_status": { "const": "complete" },
        "phase_slot": { "const": "P300" },
        "previous_phase_slot": { "const": "P299" },
        "next_phase_slot": { "const": "P301" },
        "rule_result_count": { "type": "integer", "minimum": 10 },
        "gate_result_count": { "type": "integer", "minimum": 8 },
        "desktop_config_leakage_check_count": { "type": "integer", "minimum": 4 },
        "leakage_allowed_count": { "const": 0 },
        "credential_leakage_detected_count": { "const": 0 },
        "token_leakage_detected_count": { "const": 0 },
        "env_leakage_detected_count": { "const": 0 },
        "desktop_config_leakage_detected_count": { "const": 0 },
        "provider_key_leakage_detected_count": { "const": 0 },
        "raw_secret_material_allowed_count": { "const": 0 },
        "raw_secret_material_exposed_count": { "const": 0 },
        "provider_key_direct_access_allowed_count": { "const": 0 },
        "desktop_provider_key_visible_count": { "const": 0 },
        "secret_material_read_count": { "const": 0 },
        "secret_material_materialized_count": { "const": 0 },
        "env_file_read_count": { "const": 0 },
        "desktop_config_read_count": { "const": 0 },
        "read_only": { "const": true },
        "scan_report_only": { "const": true },
        "source_content_read_performed": { "const": false },
        "source_ingest_performed": { "const": false },
        "filesystem_secret_scan_performed": { "const": false },
        "secret_material_read": { "const": false },
        "secret_material_materialized": { "const": false },
        "env_file_read": { "const": false },
        "desktop_config_read": { "const": false },
        "provider_key_materialized": { "const": false },
        "route_execution_performed": { "const": false },
        "server_started": { "const": false },
        "legal_advice_generated": { "const": false },
        "client_facing_output_generated": { "const": false },
        "human_review_required": { "const": true },
        "client_facing_ready": { "const": false },
        "windows_baseline_stability_preserved": { "const": true },
        "mac_windows_completion_instability_guard": { "const": true },
        "validation_error_count": { "const": 0 }
      },
      "additionalProperties": true
    }
  }
}
