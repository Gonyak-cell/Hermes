{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://amic.local/hermes/observability-catalog.schema.json",
  "title": "Hermes Observability Catalog",
  "type": "object",
  "required": [
    "schema_version",
    "generated_at",
    "summary",
    "sources",
    "run_records",
    "event_records",
    "cost_records"
  ],
  "properties": {
    "schema_version": {
      "const": "observability-catalog.v1"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "summary": {
      "type": "object",
      "required": [
        "source_count",
        "available_source_count",
        "missing_source_count",
        "workflow_run_count",
        "run_ledger_count",
        "agent_run_count",
        "event_count",
        "gate_passed_count",
        "gate_failed_count",
        "failed_gate_count",
        "blocking_gate_count",
        "approval_requested_count",
        "pending_approval_count",
        "output_rendered_count",
        "cost_record_count",
        "total_runtime_seconds",
        "error_record_count",
        "blocked_run_count",
        "completed_run_count",
        "by_event_type",
        "by_runtime_id",
        "by_run_status",
        "by_capability_id",
        "by_source"
      ],
      "properties": {
        "source_count": { "type": "integer", "minimum": 0 },
        "available_source_count": { "type": "integer", "minimum": 0 },
        "missing_source_count": { "type": "integer", "minimum": 0 },
        "workflow_run_count": { "type": "integer", "minimum": 0 },
        "run_ledger_count": { "type": "integer", "minimum": 0 },
        "agent_run_count": { "type": "integer", "minimum": 0 },
        "event_count": { "type": "integer", "minimum": 0 },
        "gate_passed_count": { "type": "integer", "minimum": 0 },
        "gate_failed_count": { "type": "integer", "minimum": 0 },
        "failed_gate_count": { "type": "integer", "minimum": 0 },
        "blocking_gate_count": { "type": "integer", "minimum": 0 },
        "approval_requested_count": { "type": "integer", "minimum": 0 },
        "pending_approval_count": { "type": "integer", "minimum": 0 },
        "output_rendered_count": { "type": "integer", "minimum": 0 },
        "cost_record_count": { "type": "integer", "minimum": 0 },
        "total_runtime_seconds": { "type": "number", "minimum": 0 },
        "error_record_count": { "type": "integer", "minimum": 0 },
        "blocked_run_count": { "type": "integer", "minimum": 0 },
        "completed_run_count": { "type": "integer", "minimum": 0 },
        "by_event_type": { "type": "object" },
        "by_runtime_id": { "type": "object" },
        "by_run_status": { "type": "object" },
        "by_capability_id": { "type": "object" },
        "by_source": { "type": "object" }
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "source_id",
          "label",
          "slice_path",
          "event_ledger_path",
          "available",
          "schema_version",
          "generated_at",
          "event_ledger_generated_at",
          "workflow_run_count",
          "agent_run_count",
          "event_count",
          "run_ledger_count",
          "error"
        ],
        "properties": {
          "source_id": { "type": "string" },
          "label": { "type": "string" },
          "slice_path": { "type": "string" },
          "event_ledger_path": { "type": "string" },
          "available": { "type": "boolean" },
          "schema_version": { "type": ["string", "null"] },
          "generated_at": { "type": ["string", "null"], "format": "date-time" },
          "event_ledger_generated_at": { "type": ["string", "null"], "format": "date-time" },
          "workflow_run_count": { "type": "integer", "minimum": 0 },
          "agent_run_count": { "type": "integer", "minimum": 0 },
          "event_count": { "type": "integer", "minimum": 0 },
          "run_ledger_count": { "type": "integer", "minimum": 0 },
          "error": { "type": ["string", "null"] }
        }
      }
    },
    "run_records": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "run_id",
          "source_id",
          "source_label",
          "workflow_run_id",
          "capability_id",
          "domain_pack",
          "tenant_id",
          "matter_id",
          "status",
          "blocked_reason",
          "policy_snapshot_id",
          "runtime_ids",
          "agent_run_count",
          "event_count",
          "gate_count",
          "failed_gate_count",
          "blocking_gate_count",
          "pending_approval_count",
          "output_artifact_count",
          "cost_record_count",
          "runtime_seconds",
          "error_count",
          "started_at",
          "updated_at",
          "metadata"
        ],
        "properties": {
          "run_id": { "type": "string" },
          "source_id": { "type": "string" },
          "source_label": { "type": "string" },
          "workflow_run_id": { "type": "string" },
          "capability_id": { "type": "string" },
          "domain_pack": { "type": "string" },
          "tenant_id": { "type": "string" },
          "matter_id": { "type": "string" },
          "status": { "type": "string" },
          "blocked_reason": { "type": ["string", "null"] },
          "policy_snapshot_id": { "type": "string" },
          "runtime_ids": { "type": "array", "items": { "type": "string" } },
          "agent_run_count": { "type": "integer", "minimum": 0 },
          "event_count": { "type": "integer", "minimum": 0 },
          "gate_count": { "type": "integer", "minimum": 0 },
          "failed_gate_count": { "type": "integer", "minimum": 0 },
          "blocking_gate_count": { "type": "integer", "minimum": 0 },
          "pending_approval_count": { "type": "integer", "minimum": 0 },
          "output_artifact_count": { "type": "integer", "minimum": 0 },
          "cost_record_count": { "type": "integer", "minimum": 0 },
          "runtime_seconds": { "type": "number", "minimum": 0 },
          "error_count": { "type": "integer", "minimum": 0 },
          "started_at": { "type": "string", "format": "date-time" },
          "updated_at": { "type": "string", "format": "date-time" },
          "metadata": { "type": "object" }
        }
      }
    },
    "event_records": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "event_id",
          "source_id",
          "source_label",
          "event_type",
          "time",
          "tenant_id",
          "workflow_run_id",
          "causation_id",
          "actor_type",
          "actor_id",
          "subject_type",
          "subject_id",
          "policy_snapshot_id",
          "data"
        ],
        "properties": {
          "event_id": { "type": "string" },
          "source_id": { "type": "string" },
          "source_label": { "type": "string" },
          "event_type": { "type": "string" },
          "time": { "type": "string", "format": "date-time" },
          "tenant_id": { "type": "string" },
          "workflow_run_id": { "type": "string" },
          "causation_id": { "type": ["string", "null"] },
          "actor_type": { "type": "string" },
          "actor_id": { "type": "string" },
          "subject_type": { "type": "string" },
          "subject_id": { "type": "string" },
          "policy_snapshot_id": { "type": ["string", "null"] },
          "data": { "type": "object" }
        }
      }
    },
    "cost_records": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "cost_record_id",
          "source_id",
          "source_label",
          "workflow_run_id",
          "capability_id",
          "cost_type",
          "amount",
          "unit",
          "created_at",
          "metadata"
        ],
        "properties": {
          "cost_record_id": { "type": "string" },
          "source_id": { "type": "string" },
          "source_label": { "type": "string" },
          "workflow_run_id": { "type": "string" },
          "capability_id": { "type": "string" },
          "cost_type": { "type": "string" },
          "amount": { "type": "number", "minimum": 0 },
          "unit": { "type": "string" },
          "created_at": { "type": "string", "format": "date-time" },
          "metadata": { "type": "object" }
        }
      }
    }
  }
}
