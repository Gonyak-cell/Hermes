{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/ldd-document-classification.schema.json",
  "title": "Hermes LDD Document Classification",
  "type": "object",
  "required": [
    "schema_version",
    "generated_at",
    "ldd_document_classification_id",
    "ldd_document_classification_status",
    "safe_handling",
    "inputs",
    "source_contracts",
    "ldd_document_classification_contract",
    "ldd_document_classification_rules",
    "ldd_document_classification_records",
    "ldd_document_class_summaries",
    "ldd_document_matter_class_summaries",
    "ldd_document_classification_desktop_boundary",
    "ldd_document_classification_checkpoints",
    "validation_items",
    "validation",
    "summary"
  ],
  "properties": {
    "schema_version": { "const": "ldd-document-classification.v1" },
    "generated_at": { "type": "string", "minLength": 1 },
    "ldd_document_classification_id": { "type": "string", "minLength": 1 },
    "output_dir": { "type": "string" },
    "ldd_document_classification_status": { "enum": ["complete", "blocked"] },
    "safe_handling": { "$ref": "#/$defs/safe_handling" },
    "inputs": { "type": "object" },
    "source_contracts": { "type": "object" },
    "ldd_document_classification_contract": { "$ref": "#/$defs/contract" },
    "ldd_document_classification_rules": { "type": "array", "items": { "$ref": "#/$defs/rule" } },
    "ldd_document_classification_records": { "type": "array", "items": { "$ref": "#/$defs/classification_record" } },
    "ldd_document_class_summaries": { "type": "array", "items": { "$ref": "#/$defs/class_summary" } },
    "ldd_document_matter_class_summaries": { "type": "array", "items": { "$ref": "#/$defs/matter_summary" } },
    "ldd_document_classification_desktop_boundary": { "$ref": "#/$defs/desktop_boundary" },
    "ldd_document_classification_checkpoints": { "type": "array", "items": { "$ref": "#/$defs/checkpoint" } },
    "validation_items": { "type": "array", "items": { "$ref": "#/$defs/validation_item" } },
    "validation": { "$ref": "#/$defs/validation" },
    "summary": { "$ref": "#/$defs/summary" }
  },
  "$defs": {
    "safe_handling": {
      "type": "object",
      "required": [
        "report_only",
        "legal_advice_provided",
        "client_facing_output_generated",
        "attorney_review_required",
        "human_review_required",
        "final_legal_classification_asserted",
        "matter_data_write_allowed",
        "task_state_write_allowed",
        "workflow_transition_allowed",
        "runtime_execution_performed",
        "delivery_execution_performed",
        "desktop_mutation_allowed",
        "desktop_source_of_truth",
        "protected_mutation_executed",
        "secret_material_exposed",
        "provider_key_visible"
      ],
      "properties": {
        "report_only": { "const": true },
        "legal_advice_provided": { "const": false },
        "client_facing_output_generated": { "const": false },
        "attorney_review_required": { "const": true },
        "human_review_required": { "const": true },
        "final_legal_classification_asserted": { "const": false },
        "matter_data_write_allowed": { "const": false },
        "task_state_write_allowed": { "const": false },
        "workflow_transition_allowed": { "const": false },
        "runtime_execution_performed": { "const": false },
        "delivery_execution_performed": { "const": false },
        "desktop_mutation_allowed": { "const": false },
        "desktop_source_of_truth": { "const": false },
        "protected_mutation_executed": { "const": false },
        "secret_material_exposed": { "const": false },
        "provider_key_visible": { "const": false }
      }
    },
    "contract": {
      "type": "object",
      "required": [
        "schema_version",
        "contract_id",
        "source_of_truth",
        "classification_rule",
        "supported_class_rule",
        "no_legal_conclusion_rule",
        "missing_data_rule",
        "attorney_review_rule",
        "desktop_companion_rule",
        "mutation_policy",
        "created_at"
      ],
      "properties": {
        "schema_version": { "const": "ldd-document-classification-contract.v1" },
        "contract_id": { "const": "ldd-document-classification.v1" },
        "source_of_truth": { "const": "ldd_vdr_inventory_and_matter_document_index" },
        "classification_rule": { "type": "string" },
        "supported_class_rule": { "type": "string" },
        "no_legal_conclusion_rule": { "type": "string" },
        "missing_data_rule": { "type": "string" },
        "attorney_review_rule": { "type": "string" },
        "desktop_companion_rule": { "type": "string" },
        "mutation_policy": { "type": "string" },
        "created_at": { "type": "string" }
      }
    },
    "rule": {
      "type": "object",
      "required": [
        "schema_version",
        "ldd_document_classification_rule_id",
        "document_class",
        "class_label",
        "keywords",
        "rule_status",
        "attorney_review_required",
        "human_review_required"
      ],
      "properties": {
        "schema_version": { "const": "ldd-document-classification-rule.v1" },
        "ldd_document_classification_rule_id": { "type": "string", "minLength": 1 },
        "document_class": { "$ref": "#/$defs/document_class" },
        "class_label": { "type": "string", "minLength": 1 },
        "keywords": { "type": "array" },
        "rule_status": { "const": "active" },
        "attorney_review_required": { "const": true },
        "human_review_required": { "const": true }
      }
    },
    "classification_record": {
      "type": "object",
      "required": [
        "schema_version",
        "ldd_document_classification_record_id",
        "matter_id",
        "ldd_vdr_batch_id",
        "source_document_id",
        "source_row_kind",
        "source_record_id",
        "source_collection",
        "document_title",
        "document_type",
        "document_status",
        "primary_document_class",
        "secondary_document_classes",
        "classification_status",
        "classification_confidence",
        "classification_basis",
        "classification_rule_ids",
        "attorney_review_required",
        "human_review_required",
        "client_facing_ready",
        "legal_advice_provided",
        "client_facing_output_generated",
        "matter_data_write_allowed",
        "task_state_write_allowed",
        "workflow_transition_allowed",
        "runtime_execution_allowed",
        "delivery_execution_allowed",
        "protected_action_allowed",
        "sequence_number"
      ],
      "properties": {
        "schema_version": { "const": "ldd-document-classification-record.v1" },
        "ldd_document_classification_record_id": { "type": "string", "minLength": 1 },
        "matter_id": { "type": "string", "minLength": 1 },
        "ldd_vdr_batch_id": { "type": "string", "minLength": 1 },
        "source_document_id": { "type": "string", "minLength": 1 },
        "source_row_kind": { "enum": ["vdr_file", "missing_data"] },
        "source_record_id": { "type": "string", "minLength": 1 },
        "source_collection": { "type": "string", "minLength": 1 },
        "document_title": { "type": "string", "minLength": 1 },
        "document_type": { "type": "string", "minLength": 1 },
        "document_status": { "type": "string", "minLength": 1 },
        "primary_document_class": { "$ref": "#/$defs/document_class" },
        "secondary_document_classes": { "type": "array", "items": { "$ref": "#/$defs/document_class" } },
        "classification_status": { "const": "classified_pending_attorney_review" },
        "classification_confidence": { "enum": ["rule_match", "fallback_review_required"] },
        "classification_basis": { "type": "string", "minLength": 1 },
        "classification_rule_ids": { "type": "array", "minItems": 1 },
        "attorney_review_required": { "const": true },
        "human_review_required": { "const": true },
        "client_facing_ready": { "const": false },
        "legal_advice_provided": { "const": false },
        "client_facing_output_generated": { "const": false },
        "matter_data_write_allowed": { "const": false },
        "task_state_write_allowed": { "const": false },
        "workflow_transition_allowed": { "const": false },
        "runtime_execution_allowed": { "const": false },
        "delivery_execution_allowed": { "const": false },
        "protected_action_allowed": { "const": false },
        "sequence_number": { "type": "integer", "minimum": 1 }
      }
    },
    "class_summary": {
      "type": "object",
      "required": [
        "schema_version",
        "ldd_document_class_summary_id",
        "document_class",
        "class_label",
        "classification_record_count",
        "file_classification_count",
        "missing_data_classification_count",
        "client_facing_ready_count"
      ],
      "properties": {
        "schema_version": { "const": "ldd-document-class-summary.v1" },
        "ldd_document_class_summary_id": { "type": "string", "minLength": 1 },
        "document_class": { "$ref": "#/$defs/document_class" },
        "class_label": { "type": "string", "minLength": 1 },
        "classification_record_count": { "type": "integer", "minimum": 0 },
        "file_classification_count": { "type": "integer", "minimum": 0 },
        "missing_data_classification_count": { "type": "integer", "minimum": 0 },
        "client_facing_ready_count": { "const": 0 }
      }
    },
    "matter_summary": {
      "type": "object",
      "required": [
        "schema_version",
        "ldd_document_matter_class_summary_id",
        "matter_id",
        "ldd_document_matter_classification_status",
        "classification_record_count",
        "distinct_document_class_count",
        "attorney_review_required",
        "human_review_required",
        "client_facing_ready"
      ],
      "properties": {
        "schema_version": { "const": "ldd-document-matter-class-summary.v1" },
        "ldd_document_matter_class_summary_id": { "type": "string", "minLength": 1 },
        "matter_id": { "type": "string", "minLength": 1 },
        "ldd_document_matter_classification_status": { "const": "classified_pending_attorney_review" },
        "classification_record_count": { "type": "integer", "minimum": 1 },
        "distinct_document_class_count": { "type": "integer", "minimum": 1 },
        "class_counts": { "type": "object" },
        "attorney_review_required": { "const": true },
        "human_review_required": { "const": true },
        "client_facing_ready": { "const": false }
      }
    },
    "desktop_boundary": {
      "type": "object",
      "required": [
        "schema_version",
        "boundary_status",
        "read_only",
        "desktop_mutation_allowed",
        "desktop_source_of_truth",
        "matter_data_write_allowed",
        "task_state_write_allowed",
        "workflow_transition_allowed",
        "runtime_execution_allowed",
        "delivery_execution_allowed",
        "protected_action_allowed",
        "client_facing_output_allowed_without_attorney_review"
      ],
      "properties": {
        "schema_version": { "const": "ldd-document-classification-desktop-boundary.v1" },
        "boundary_status": { "const": "enforced" },
        "read_only": { "const": true },
        "desktop_mutation_allowed": { "const": false },
        "desktop_source_of_truth": { "const": false },
        "matter_data_write_allowed": { "const": false },
        "task_state_write_allowed": { "const": false },
        "workflow_transition_allowed": { "const": false },
        "runtime_execution_allowed": { "const": false },
        "delivery_execution_allowed": { "const": false },
        "protected_action_allowed": { "const": false },
        "client_facing_output_allowed_without_attorney_review": { "const": false }
      }
    },
    "checkpoint": {
      "type": "object",
      "required": ["checkpoint_id", "status", "message"],
      "properties": {
        "checkpoint_id": { "type": "string", "minLength": 1 },
        "status": { "enum": ["passed", "failed"] },
        "message": { "type": "string" }
      }
    },
    "validation_item": {
      "type": "object",
      "required": ["path", "check_id", "status", "message"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "check_id": { "type": "string", "minLength": 1 },
        "status": { "enum": ["passed", "failed"] },
        "message": { "type": "string" }
      }
    },
    "validation": {
      "type": "object",
      "required": ["valid", "items", "errors"],
      "properties": {
        "valid": { "type": "boolean" },
        "items": { "type": "array" },
        "errors": { "type": "array" }
      }
    },
    "summary": {
      "type": "object",
      "required": [
        "ldd_document_classification_status",
        "ldd_document_classification_contract_id",
        "source_of_truth",
        "source_ldd_vdr_inventory_status",
        "source_document_count",
        "classification_rule_count",
        "classification_record_count",
        "classified_document_count",
        "class_summary_count",
        "matter_count",
        "file_classification_count",
        "missing_data_classification_count",
        "contract_classification_count",
        "tax_classification_count",
        "closing_deliverable_classification_count",
        "client_facing_ready_count",
        "legal_advice_provided",
        "client_facing_output_generated",
        "desktop_boundary_status",
        "desktop_read_only",
        "desktop_mutation_allowed",
        "matter_data_write_allowed",
        "task_state_write_allowed",
        "workflow_transition_allowed",
        "runtime_execution_allowed",
        "delivery_execution_allowed",
        "protected_action_allowed",
        "failed_checkpoint_count",
        "validation_error_count"
      ],
      "properties": {
        "ldd_document_classification_status": { "enum": ["complete", "blocked"] },
        "ldd_document_classification_contract_id": { "const": "ldd-document-classification.v1" },
        "source_of_truth": { "const": "ldd_vdr_inventory_and_matter_document_index" },
        "source_ldd_vdr_inventory_status": { "const": "complete" },
        "source_document_count": { "type": "integer", "minimum": 1 },
        "classification_rule_count": { "type": "integer", "minimum": 8 },
        "classification_record_count": { "type": "integer", "minimum": 1 },
        "classified_document_count": { "type": "integer", "minimum": 1 },
        "class_summary_count": { "type": "integer", "minimum": 1 },
        "matter_count": { "type": "integer", "minimum": 1 },
        "file_classification_count": { "type": "integer", "minimum": 1 },
        "missing_data_classification_count": { "type": "integer", "minimum": 1 },
        "contract_classification_count": { "type": "integer", "minimum": 1 },
        "tax_classification_count": { "type": "integer", "minimum": 1 },
        "closing_deliverable_classification_count": { "type": "integer", "minimum": 1 },
        "client_facing_ready_count": { "const": 0 },
        "legal_advice_provided": { "const": false },
        "client_facing_output_generated": { "const": false },
        "desktop_boundary_status": { "const": "enforced" },
        "desktop_read_only": { "const": true },
        "desktop_mutation_allowed": { "const": false },
        "matter_data_write_allowed": { "const": false },
        "task_state_write_allowed": { "const": false },
        "workflow_transition_allowed": { "const": false },
        "runtime_execution_allowed": { "const": false },
        "delivery_execution_allowed": { "const": false },
        "protected_action_allowed": { "const": false },
        "failed_checkpoint_count": { "const": 0 },
        "validation_error_count": { "const": 0 }
      }
    },
    "document_class": {
      "enum": [
        "contract",
        "registry",
        "license_permit",
        "litigation",
        "labor_employment",
        "tax",
        "corporate_governance",
        "closing_deliverable",
        "other"
      ]
    }
  }
}
