{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hermes.local/schemas/product-ops-automation.schema.json",
  "title": "Hermes Product Ops Automation",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "capability_id",
    "program_range",
    "source_program_range",
    "product_ops_contract",
    "product_ops_phase_rows",
    "product_ops_source_binding_rows",
    "roadmap_signal_rows",
    "sprint_signal_rows",
    "issue_signal_rows",
    "changelog_signal_rows",
    "support_feedback_signal_rows",
    "customer_request_signal_rows",
    "harness_state_link_rows",
    "product_ops_projection_rows",
    "product_ops_authority_guard_rows",
    "p14200_freeze_rows",
    "product_ops_boundary",
    "product_ops_validation_items",
    "validation",
    "summary"
  ],
  "properties": {
    "schema_version": { "const": "product-ops-automation.v1" },
    "capability_id": { "const": "platform.product_ops_automation" },
    "program_range": { "const": "P13801-P14200" },
    "source_program_range": { "const": "P13401-P13800" },
    "product_ops_phase_rows": { "type": "array", "minItems": 10, "items": { "$ref": "#/$defs/verdictRow" } },
    "product_ops_source_binding_rows": { "type": "array", "minItems": 8, "items": { "$ref": "#/$defs/verdictRow" } },
    "roadmap_signal_rows": { "type": "array", "minItems": 6, "items": { "$ref": "#/$defs/verdictRow" } },
    "sprint_signal_rows": { "type": "array", "minItems": 6, "items": { "$ref": "#/$defs/verdictRow" } },
    "issue_signal_rows": { "type": "array", "minItems": 6, "items": { "$ref": "#/$defs/verdictRow" } },
    "changelog_signal_rows": { "type": "array", "minItems": 6, "items": { "$ref": "#/$defs/verdictRow" } },
    "support_feedback_signal_rows": { "type": "array", "minItems": 6, "items": { "$ref": "#/$defs/verdictRow" } },
    "customer_request_signal_rows": { "type": "array", "minItems": 6, "items": { "$ref": "#/$defs/verdictRow" } },
    "harness_state_link_rows": { "type": "array", "minItems": 6, "items": { "$ref": "#/$defs/verdictRow" } },
    "product_ops_projection_rows": { "type": "array", "minItems": 6, "items": { "$ref": "#/$defs/verdictRow" } },
    "product_ops_authority_guard_rows": { "type": "array", "minItems": 10, "items": { "$ref": "#/$defs/verdictRow" } },
    "p14200_freeze_rows": { "type": "array", "minItems": 12, "items": { "$ref": "#/$defs/verdictRow" } },
    "product_ops_boundary": {
      "type": "object",
      "required": [
        "source_observability_cost_available",
        "source_ready_for_p13801_handoff",
        "source_block_visible_now",
        "roadmap_signal_ready",
        "sprint_signal_ready",
        "issue_signal_ready",
        "changelog_signal_ready",
        "support_feedback_signal_ready",
        "customer_request_signal_ready",
        "harness_state_link_ready",
        "product_ops_projection_ready",
        "product_ops_authority_guard_ready",
        "p14200_product_ops_freeze_ready",
        "ready_for_p14201_handoff",
        "roadmap_write_allowed_now",
        "sprint_mutation_allowed_now",
        "issue_write_allowed_now",
        "changelog_publish_allowed_now",
        "support_reply_allowed_now",
        "customer_contact_allowed_now",
        "external_project_write_allowed_now",
        "raw_contact_exposure_allowed",
        "raw_source_exposure_allowed",
        "enterprise_trust_claim_allowed_now",
        "production_pass_enabled",
        "enterprise_pass_enabled",
        "protected_closeout_enabled",
        "deployment_allowed_now",
        "release_approval_allowed_now",
        "write_action_allowed_now",
        "protected_action_allowed_now",
        "connector_write_enabled",
        "runtime_execution_allowed_now",
        "final_approval_ui_enabled",
        "codex_final_approval_ui_enabled",
        "claude_final_approval_ui_enabled",
        "unsafe_flag_count"
      ],
      "properties": {
        "source_observability_cost_available": { "type": "boolean" },
        "source_ready_for_p13801_handoff": { "type": "boolean" },
        "source_block_visible_now": { "type": "boolean" },
        "roadmap_signal_ready": { "type": "boolean" },
        "sprint_signal_ready": { "type": "boolean" },
        "issue_signal_ready": { "type": "boolean" },
        "changelog_signal_ready": { "type": "boolean" },
        "support_feedback_signal_ready": { "type": "boolean" },
        "customer_request_signal_ready": { "type": "boolean" },
        "harness_state_link_ready": { "type": "boolean" },
        "product_ops_projection_ready": { "type": "boolean" },
        "product_ops_authority_guard_ready": { "type": "boolean" },
        "p14200_product_ops_freeze_ready": { "type": "boolean" },
        "ready_for_p14201_handoff": { "type": "boolean" },
        "roadmap_write_allowed_now": { "const": false },
        "sprint_mutation_allowed_now": { "const": false },
        "issue_write_allowed_now": { "const": false },
        "changelog_publish_allowed_now": { "const": false },
        "support_reply_allowed_now": { "const": false },
        "customer_contact_allowed_now": { "const": false },
        "external_project_write_allowed_now": { "const": false },
        "raw_contact_exposure_allowed": { "const": false },
        "raw_source_exposure_allowed": { "const": false },
        "enterprise_trust_claim_allowed_now": { "const": false },
        "production_pass_enabled": { "const": false },
        "enterprise_pass_enabled": { "const": false },
        "protected_closeout_enabled": { "const": false },
        "deployment_allowed_now": { "const": false },
        "release_approval_allowed_now": { "const": false },
        "write_action_allowed_now": { "const": false },
        "protected_action_allowed_now": { "const": false },
        "connector_write_enabled": { "const": false },
        "runtime_execution_allowed_now": { "const": false },
        "final_approval_ui_enabled": { "const": false },
        "codex_final_approval_ui_enabled": { "const": false },
        "claude_final_approval_ui_enabled": { "const": false },
        "unsafe_flag_count": { "const": 0 }
      }
    },
    "validation": {
      "type": "object",
      "required": ["valid", "error_count", "errors"],
      "properties": {
        "valid": { "type": "boolean" },
        "error_count": { "type": "integer", "minimum": 0 },
        "errors": { "type": "array" }
      }
    },
    "summary": {
      "type": "object",
      "required": [
        "product_ops_automation_status",
        "program_range",
        "source_ready_for_p13801_handoff",
        "source_block_visible_now",
        "roadmap_signal_row_count",
        "sprint_signal_row_count",
        "issue_signal_row_count",
        "changelog_signal_row_count",
        "support_feedback_signal_row_count",
        "customer_request_signal_row_count",
        "harness_state_link_row_count",
        "product_ops_projection_row_count",
        "p14200_product_ops_freeze_ready",
        "ready_for_p14201_handoff",
        "roadmap_write_allowed_now",
        "issue_write_allowed_now",
        "support_reply_allowed_now",
        "customer_contact_allowed_now",
        "external_project_write_allowed_now",
        "production_pass_enabled",
        "enterprise_trust_claim_allowed_now",
        "validation_error_count"
      ],
      "properties": {
        "product_ops_automation_status": {
          "enum": [
            "ready_for_product_ops_automation",
            "blocked_product_ops_automation"
          ]
        },
        "program_range": { "const": "P13801-P14200" },
        "source_ready_for_p13801_handoff": { "type": "boolean" },
        "source_block_visible_now": { "type": "boolean" },
        "roadmap_signal_row_count": { "type": "integer", "minimum": 6 },
        "sprint_signal_row_count": { "type": "integer", "minimum": 6 },
        "issue_signal_row_count": { "type": "integer", "minimum": 6 },
        "changelog_signal_row_count": { "type": "integer", "minimum": 6 },
        "support_feedback_signal_row_count": { "type": "integer", "minimum": 6 },
        "customer_request_signal_row_count": { "type": "integer", "minimum": 6 },
        "harness_state_link_row_count": { "type": "integer", "minimum": 6 },
        "product_ops_projection_row_count": { "type": "integer", "minimum": 6 },
        "p14200_product_ops_freeze_ready": { "type": "boolean" },
        "ready_for_p14201_handoff": { "type": "boolean" },
        "roadmap_write_allowed_now": { "const": false },
        "issue_write_allowed_now": { "const": false },
        "support_reply_allowed_now": { "const": false },
        "customer_contact_allowed_now": { "const": false },
        "external_project_write_allowed_now": { "const": false },
        "production_pass_enabled": { "const": false },
        "enterprise_trust_claim_allowed_now": { "const": false }
      }
    }
  },
  "$defs": {
    "verdictRow": {
      "type": "object",
      "required": [
        "row_id",
        "category",
        "label",
        "required",
        "observed",
        "evidence_ref",
        "current_verdict"
      ],
      "properties": {
        "row_id": { "type": "string", "minLength": 1 },
        "category": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "required": { "type": "boolean" },
        "observed": { "type": "boolean" },
        "evidence_ref": { "type": "string", "minLength": 1 },
        "current_verdict": { "enum": ["pass", "blocked"] },
        "block_reason": { "type": ["string", "null"] }
      }
    }
  }
}
