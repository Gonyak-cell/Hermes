{
  "schema_version": "domain-pack-manifest.v1",
  "pack_id": "creative-document",
  "pack_version": "0.1.0",
  "display_name": "Creative Document Pack",
  "description": "PPTX report design systems, document rendering, content production, and review workflows for personal creative projects.",
  "enabled": true,
  "core_compatibility": {
    "min_core_version": "0.1.0"
  },
  "capabilities": [
    {
      "capability_id": "creative_document.pptx.design_system",
      "version": "0.1.0",
      "path": "capabilities/pptx-design-system.json"
    }
  ],
  "policies": [
    {
      "policy_id": "creative_document.policy.format_validation",
      "description": "Generated presentations remain draft artifacts until format validation and human approval pass."
    }
  ],
  "schemas": [
    "schemas/core/resource-evidence.schema.json",
    "schemas/core/governance-output.schema.json"
  ],
  "workflows": [
    "workflow.creative_document.pptx.design_system.v1",
    "workflow.creative_document.content_script.v1"
  ],
  "gates": [
    "classification_gate",
    "tool_permission_gate",
    "format_validation_gate",
    "human_approval_gate"
  ],
  "templates": [
    "templates/creative-document/report-outline.md",
    "templates/creative-document/pptx-style-profile.json"
  ],
  "extractors": [
    "extractor.creative_document.style_profile.v1"
  ],
  "renderers": [
    "renderer.creative_document.pptx.v1"
  ],
  "migrations": [],
  "golden_cases": [
    "golden.creative_document.pptx.design_system.simple"
  ],
  "dependencies": [
    {
      "pack_id": "common",
      "version": "0.1.0"
    }
  ],
  "permissions": {
    "max_classification": "P1_INTERNAL",
    "external_model_policy": "allowed_with_audit",
    "allowed_runtimes": ["harness", "local_script", "document_renderer", "manual"],
    "default_output_status": "draft"
  },
  "metadata": {
    "layout_validation_required": true
  }
}
