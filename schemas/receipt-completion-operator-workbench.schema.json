{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hermes.local/schemas/receipt-completion-operator-workbench.schema.json",
  "title": "Hermes Receipt Completion Operator Workbench",
  "type": "object",
  "required": [
    "schema_version",
    "generated_at",
    "capability_id",
    "program_range",
    "source_program_range",
    "receipt_completion_operator_workbench_phase_rows",
    "p22400_source_binding_rows",
    "operator_workbench_task_rows",
    "remediation_plan_draft_rows",
    "evidence_request_packet_rows",
    "review_escalation_router_rows",
    "no_apply_boundary_rows",
    "p22800_clean_checkpoint_rows",
    "receipt_completion_operator_workbench_boundary",
    "receipt_completion_operator_workbench_validation_items",
    "summary",
    "validation"
  ],
  "properties": {
    "schema_version": { "const": "receipt-completion-operator-workbench.v1" },
    "generated_at": { "type": "string", "format": "date-time" },
    "capability_id": { "const": "platform.receipt_completion_operator_workbench" },
    "program_range": { "const": "P22401-P22800" },
    "source_program_range": { "const": "P22001-P22400" },
    "receipt_completion_operator_workbench_phase_rows": { "type": "array", "minItems": 7, "items": { "$ref": "#/$defs/verdictRow" } },
    "p22400_source_binding_rows": { "type": "array", "minItems": 12, "items": { "$ref": "#/$defs/verdictRow" } },
    "operator_workbench_task_rows": { "type": "array", "minItems": 7, "items": { "$ref": "#/$defs/verdictRow" } },
    "remediation_plan_draft_rows": { "type": "array", "minItems": 7, "items": { "$ref": "#/$defs/verdictRow" } },
    "evidence_request_packet_rows": { "type": "array", "minItems": 7, "items": { "$ref": "#/$defs/verdictRow" } },
    "review_escalation_router_rows": { "type": "array", "minItems": 7, "items": { "$ref": "#/$defs/verdictRow" } },
    "no_apply_boundary_rows": { "type": "array", "minItems": 31, "items": { "$ref": "#/$defs/verdictRow" } },
    "p22800_clean_checkpoint_rows": { "type": "array", "minItems": 8, "items": { "$ref": "#/$defs/verdictRow" } },
    "receipt_completion_operator_workbench_validation_items": { "type": "array", "minItems": 12, "items": { "$ref": "#/$defs/validationItem" } },
    "summary": {
      "type": "object",
      "required": [
        "receipt_completion_operator_workbench_status",
        "source_p22400_ready_for_p22401_handoff",
        "workbench_task_count",
        "open_read_only_task_count",
        "remediation_plan_count",
        "evidence_request_count",
        "ready_for_p22801_handoff",
        "remediation_apply_allowed_now",
        "production_pass_enabled"
      ],
      "properties": {
        "receipt_completion_operator_workbench_status": {
          "enum": [
            "ready_for_receipt_completion_operator_workbench",
            "valid_block_receipt_completion_operator_workbench_pending",
            "blocked_receipt_completion_operator_workbench"
          ]
        },
        "source_p22400_ready_for_p22401_handoff": { "type": "boolean" },
        "workbench_task_count": { "type": "number" },
        "open_read_only_task_count": { "type": "number" },
        "remediation_plan_count": { "type": "number" },
        "evidence_request_count": { "type": "number" },
        "ready_for_p22801_handoff": { "type": "boolean" },
        "remediation_apply_allowed_now": { "const": false },
        "production_pass_enabled": { "const": false },
        "enterprise_trust_claim_allowed_now": { "const": false },
        "validation_error_count": { "type": "number" }
      }
    },
    "receipt_completion_operator_workbench_boundary": {
      "type": "object",
      "required": [
        "p22800_contract_ready",
        "ready_for_p22801_handoff",
        "source_p22400_ready_for_p22401_handoff",
        "source_validation_valid_now",
        "operator_workbench_task_queue_visible_now",
        "remediation_plan_drafts_visible_now",
        "evidence_request_packets_visible_now",
        "review_escalation_router_visible_now",
        "no_apply_boundary_closed_now",
        "workbench_task_count",
        "open_read_only_task_count",
        "remediation_plan_count",
        "evidence_request_count",
        "review_router_count",
        "command_execution_allowed_now",
        "artifact_write_allowed_now",
        "remediation_apply_allowed_now",
        "operator_task_auto_close_allowed_now",
        "receipt_completion_claim_allowed_now",
        "receipt_completion_accepted_now",
        "completion_reconciliation_final_now",
        "operator_completion_apply_allowed_now",
        "verifier_finality_allowed_now",
        "operator_merge_allowed_now",
        "raw_stdout_capture_allowed_now",
        "raw_stderr_capture_allowed_now",
        "raw_secret_material_allowed_now",
        "deployment_allowed_now",
        "release_approval_allowed_now",
        "production_pass_enabled",
        "enterprise_pass_enabled",
        "enterprise_trust_claim_allowed_now",
        "protected_closeout_enabled",
        "human_gate_bypass_allowed_now",
        "independent_review_bypass_allowed_now",
        "single_owner_enterprise_trust_allowed_now",
        "runtime_execution_allowed_now",
        "write_action_allowed_now",
        "protected_action_allowed_now",
        "connector_write_enabled",
        "external_service_mutation_allowed_now",
        "raw_source_exposure_allowed",
        "secret_read_allowed_now",
        "reviewer_mutation_allowed_now",
        "final_automated_approval_allowed"
      ],
      "properties": {
        "p22800_contract_ready": { "type": "boolean" },
        "ready_for_p22801_handoff": { "type": "boolean" },
        "source_p22400_ready_for_p22401_handoff": { "type": "boolean" },
        "source_validation_valid_now": { "type": "boolean" },
        "operator_workbench_task_queue_visible_now": { "type": "boolean" },
        "remediation_plan_drafts_visible_now": { "type": "boolean" },
        "evidence_request_packets_visible_now": { "type": "boolean" },
        "review_escalation_router_visible_now": { "type": "boolean" },
        "no_apply_boundary_closed_now": { "type": "boolean" },
        "workbench_task_count": { "type": "number" },
        "open_read_only_task_count": { "type": "number" },
        "remediation_plan_count": { "type": "number" },
        "evidence_request_count": { "type": "number" },
        "review_router_count": { "type": "number" },
        "command_execution_allowed_now": { "const": false },
        "artifact_write_allowed_now": { "const": false },
        "remediation_apply_allowed_now": { "const": false },
        "operator_task_auto_close_allowed_now": { "const": false },
        "receipt_completion_claim_allowed_now": { "const": false },
        "receipt_completion_accepted_now": { "const": false },
        "completion_reconciliation_final_now": { "const": false },
        "operator_completion_apply_allowed_now": { "const": false },
        "verifier_finality_allowed_now": { "const": false },
        "operator_merge_allowed_now": { "const": false },
        "raw_stdout_capture_allowed_now": { "const": false },
        "raw_stderr_capture_allowed_now": { "const": false },
        "raw_secret_material_allowed_now": { "const": false },
        "deployment_allowed_now": { "const": false },
        "release_approval_allowed_now": { "const": false },
        "production_pass_enabled": { "const": false },
        "enterprise_pass_enabled": { "const": false },
        "enterprise_trust_claim_allowed_now": { "const": false },
        "protected_closeout_enabled": { "const": false },
        "human_gate_bypass_allowed_now": { "const": false },
        "independent_review_bypass_allowed_now": { "const": false },
        "single_owner_enterprise_trust_allowed_now": { "const": false },
        "runtime_execution_allowed_now": { "const": false },
        "write_action_allowed_now": { "const": false },
        "protected_action_allowed_now": { "const": false },
        "connector_write_enabled": { "const": false },
        "external_service_mutation_allowed_now": { "const": false },
        "raw_source_exposure_allowed": { "const": false },
        "secret_read_allowed_now": { "const": false },
        "reviewer_mutation_allowed_now": { "const": false },
        "final_automated_approval_allowed": { "const": false }
      }
    },
    "validation": {
      "type": "object",
      "required": ["valid", "error_count", "errors"],
      "properties": {
        "valid": { "type": "boolean" },
        "error_count": { "type": "number" },
        "errors": { "type": "array" }
      }
    }
  },
  "$defs": {
    "verdictRow": {
      "type": "object",
      "required": [
        "row_id",
        "category",
        "label",
        "observed",
        "current_verdict",
        "block_reason",
        "evidence_ref",
        "generated_at"
      ],
      "properties": {
        "row_id": { "type": "string", "minLength": 1 },
        "category": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "observed": { "type": "boolean" },
        "current_verdict": { "enum": ["pass", "blocked"] },
        "block_reason": { "type": ["string", "null"] },
        "evidence_ref": { "type": "string", "minLength": 1 },
        "generated_at": { "type": "string", "format": "date-time" }
      }
    },
    "validationItem": {
      "type": "object",
      "required": ["item_id", "category", "passed", "message", "evidence_ref"],
      "properties": {
        "item_id": { "type": "string", "minLength": 1 },
        "category": { "type": "string", "minLength": 1 },
        "passed": { "type": "boolean" },
        "message": { "type": "string" },
        "evidence_ref": { "type": "string", "minLength": 1 }
      }
    }
  }
}
