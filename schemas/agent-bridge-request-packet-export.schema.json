      "type": "array",
      "minItems": 4,
      "items": { "$ref": "#/$defs/packetRow" }
    },
    "agent_request_packet_markdown_rows": {
      "type": "array",
      "minItems": 4,
      "items": { "$ref": "#/$defs/verdictRow" }
    },
    "blocked_export_fixture_rows": {
      "type": "array",
      "minItems": 10,
      "items": { "$ref": "#/$defs/verdictRow" }
    },
    "agent_request_packet_export_gate_rows": {
      "type": "array",
      "minItems": 9,
      "items": { "$ref": "#/$defs/verdictRow" }
