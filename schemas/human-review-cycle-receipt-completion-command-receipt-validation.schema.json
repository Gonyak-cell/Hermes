{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://amic.local/hermes/human-review-cycle-receipt-completion-command-receipt-validation.schema.json",
  "title": "Hermes Human Review Cycle Receipt Completion Command Receipt Validation",
  "type": "object",
  "required": [
    "schema_version",
    "generated_at",
    "validation_id",
    "output_dir",
    "validation_status",
    "safe_handling",
    "sources",
    "summary",
    "validation_items",
    "receipt_errors",
    "validated_command_receipts"
  ],
  "properties": {
    "schema_version": { "const": "human-review-cycle-receipt-completion-command-receipt-validation.v1" },
    "generated_at": { "type": "string", "format": "date-time" },
    "validation_id": { "type": "string" },
    "output_dir": { "type": "string" },
    "validation_status": { "enum": ["clear", "pending_receipts", "ready_to_confirm", "blocked_missing_source", "blocked_invalid_receipts"] },
    "safe_handling": { "$ref": "#/$defs/safe_handling" },
    "sources": { "type": "array", "items": { "$ref": "#/$defs/source" } },
    "summary": {
      "type": "object",
      "required": [
        "validation_status",
        "command_receipts_available",
        "receipt_input_available",
        "receipt_requirement_count",
        "receipt_count",
        "validation_item_count",
        "ready_to_confirm_count",
        "pending_receipt_count",
        "missing_receipt_count",
        "invalid_receipt_count",
        "unknown_receipt_count",
        "error_count",
        "command_success_count",
        "command_failed_count",
        "skipped_count",
        "deferred_count",
        "by_validation_status",
        "by_receipt_status",
        "by_command_kind"
      ],
      "properties": {
        "validation_status": { "enum": ["clear", "pending_receipts", "ready_to_confirm", "blocked_missing_source", "blocked_invalid_receipts"] },
        "command_receipts_available": { "type": "boolean" },
        "receipt_input_available": { "type": "boolean" },
        "receipt_requirement_count": { "type": "integer", "minimum": 0 },
        "receipt_count": { "type": "integer", "minimum": 0 },
        "validation_item_count": { "type": "integer", "minimum": 0 },
        "ready_to_confirm_count": { "type": "integer", "minimum": 0 },
        "pending_receipt_count": { "type": "integer", "minimum": 0 },
        "missing_receipt_count": { "type": "integer", "minimum": 0 },
        "invalid_receipt_count": { "type": "integer", "minimum": 0 },
        "unknown_receipt_count": { "type": "integer", "minimum": 0 },
        "error_count": { "type": "integer", "minimum": 0 },
        "command_success_count": { "type": "integer", "minimum": 0 },
        "command_failed_count": { "type": "integer", "minimum": 0 },
        "skipped_count": { "type": "integer", "minimum": 0 },
        "deferred_count": { "type": "integer", "minimum": 0 },
        "by_validation_status": { "type": "object" },
        "by_receipt_status": { "type": "object" },
        "by_command_kind": { "type": "object" }
      }
    },
    "validation_items": {
      "type": "array",
      "items": { "$ref": "#/$defs/validation_item" }
    },
    "receipt_errors": {
      "type": "array",
      "items": { "$ref": "#/$defs/error" }
    },
    "validated_command_receipts": {
      "type": "object",
      "required": ["schema_version", "generated_at", "command_queue_id", "instructions", "receipts"],
      "properties": {
        "schema_version": { "const": "human-review-cycle-receipt-completion-command-receipts-input.v1" },
        "generated_at": { "type": "string", "format": "date-time" },
        "command_queue_id": { "type": "string" },
        "instructions": { "type": "string" },
        "receipts": { "type": "array", "items": { "type": "object" } }
      }
    }
  },
  "$defs": {
    "validation_item": {
      "type": "object",
      "required": [
        "validation_item_id",
        "receipt_requirement_id",
        "queue_item_id",
        "command_gate_id",
        "runbook_step_id",
        "step_key",
        "command_kind",
        "command",
        "validation_status",
        "receipt_status",
        "command_result",
        "ready_to_confirm",
        "error_count",
        "required_receipt_fields",
        "errors",
        "receipt"
      ],
      "properties": {
        "validation_item_id": { "type": "string" },
        "receipt_requirement_id": { "type": ["string", "null"] },
        "queue_item_id": { "type": "string" },
        "command_gate_id": { "type": "string" },
        "runbook_step_id": { "type": "string" },
        "step_key": { "type": "string" },
        "command_kind": { "type": "string" },
        "command": { "type": "string" },
        "validation_status": { "enum": ["pending_receipt", "ready_to_confirm", "invalid_receipt", "missing_receipt", "unknown_command_receipt"] },
        "receipt_status": { "type": "string" },
        "command_result": { "type": "string" },
        "ready_to_confirm": { "type": "boolean" },
        "error_count": { "type": "integer", "minimum": 0 },
        "required_receipt_fields": { "type": "array", "items": { "type": "string" } },
        "errors": { "type": "array", "items": { "$ref": "#/$defs/error" } },
        "receipt": { "type": ["object", "null"] }
      }
    },
    "source": {
      "type": "object",
      "required": ["source_id", "label", "path", "available", "schema_version", "generated_at", "summary", "error"],
      "properties": {
        "source_id": { "type": "string" },
        "label": { "type": "string" },
        "path": { "type": "string" },
        "available": { "type": "boolean" },
        "schema_version": { "type": ["string", "null"] },
        "generated_at": { "type": ["string", "null"], "format": "date-time" },
        "summary": { "type": ["object", "null"] },
        "error": { "type": ["string", "null"] }
      }
    },
    "safe_handling": {
      "type": "object",
      "required": ["auto_execute_allowed", "command_receipt_validation_only", "protected_actions_executed", "receipt_edits_must_be_manual"],
      "properties": {
        "auto_execute_allowed": { "const": false },
        "command_receipt_validation_only": { "const": true },
        "protected_actions_executed": { "const": false },
        "receipt_edits_must_be_manual": { "const": true }
      }
    },
    "error": {
      "type": "object",
      "required": ["queue_item_id", "field", "message"],
      "properties": {
        "queue_item_id": { "type": "string" },
        "field": { "type": "string" },
        "message": { "type": "string" }
      }
    }
  }
}
