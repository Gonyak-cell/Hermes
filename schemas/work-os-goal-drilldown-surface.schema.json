              "project_id",
              "domain_pack_scope",
              "domain_pack_is_whole_product",
              "hermes_product_identity",
              "read_only",
              "protected_action_enabled",
              "runtime_execution_enabled",
              "write_action_enabled"
            ],
            "properties": {
              "domain_pack_scope": { "const": "project_workflow_context" },
              "domain_pack_is_whole_product": { "const": false },
              "hermes_product_identity": { "const": "general_project_workflow_control_plane" },
              "read_only": { "const": true },
              "protected_action_enabled": { "const": false },
              "runtime_execution_enabled": { "const": false },
              "write_action_enabled": { "const": false }
            },
            "additionalProperties": true
          }
        ]
      }
    },
    "goal_detail_rows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "allOf": [
          { "$ref": "#/$defs/goalRow" },
