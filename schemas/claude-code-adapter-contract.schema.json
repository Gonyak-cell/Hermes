{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://amic.local/hermes/claude-code-adapter-contract.schema.json",
  "title": "Hermes Claude Code Adapter Contract",
  "type": "object",
  "required": [
    "schema_version",
    "generated_at",
    "adapter_projection_id",
    "output_dir",
    "inputs",
    "source_contracts",
    "claude_code_adapter_contract",
    "claude_code_diff_gate_contracts",
    "claude_code_agent_run_ledger_bindings",
    "claude_code_desktop_boundary",
    "summary",
    "validation_items",
    "validation"
  ],
  "properties": {
    "schema_version": { "const": "claude-code-adapter-contract.v1" },
    "generated_at": { "type": "string", "format": "date-time" },
    "adapter_projection_id": { "type": "string" },
    "output_dir": { "type": "string" },
    "inputs": {
      "type": "object",
      "required": [
        "runtime_adapter_interface_v2_path",
        "runtime_agentrun_contract_freeze_path",
        "runtime_command_bindings_path",
        "agent_run_ledger_path",
        "workflow_gate_freeze_path",
        "desktop_companion_integration_path"
      ],
      "properties": {
        "runtime_adapter_interface_v2_path": { "type": "string" },
        "runtime_agentrun_contract_freeze_path": { "type": "string" },
        "runtime_command_bindings_path": { "type": "string" },
        "agent_run_ledger_path": { "type": "string" },
        "workflow_gate_freeze_path": { "type": "string" },
        "desktop_companion_integration_path": { "type": "string" }
      }
    },
    "source_contracts": {
      "type": "object",
      "required": [
        "runtime_adapter_interface_v2",
        "runtime_agentrun_contract_freeze",
        "runtime_command_bindings",
        "agent_run_ledger",
        "workflow_gate_freeze",
        "desktop_companion_integration"
      ],
      "properties": {
        "runtime_adapter_interface_v2": {
          "type": "object",
          "required": ["runtime_adapter_interface_status", "claude_code_interface_status", "claude_code_operator_surface_policy_status"],
          "properties": {
            "schema_version": { "type": ["string", "null"] },
            "runtime_adapter_interface_status": { "const": "complete" },
            "claude_code_interface_status": { "const": "locked" },
            "claude_code_operator_surface_policy_status": { "const": "locked" }
          }
        },
        "runtime_agentrun_contract_freeze": {
          "type": "object",
          "required": ["freeze_status", "claude_code_runtime_adapter_found", "claude_code_runtime_execution_contract_found"],
          "properties": {
            "schema_version": { "type": ["string", "null"] },
            "freeze_status": { "const": "complete" },
            "claude_code_runtime_adapter_found": { "const": true },
            "claude_code_runtime_execution_contract_found": { "const": true },
            "current_claude_code_agent_run_contract_count": { "type": "integer", "minimum": 0 }
          }
        },
        "runtime_command_bindings": {
          "type": "object",
          "required": [
            "schema_version",
            "claude_code_command_binding_found",
            "claude_code_prompt_delivery",
            "claude_code_execute_requires_git_worktree",
            "claude_code_candidate_command_count"
          ],
          "properties": {
            "schema_version": { "const": "runtime-command-bindings.v1" },
            "binding_registry_id": { "type": ["string", "null"] },
            "claude_code_command_binding_found": { "const": true },
            "claude_code_prompt_delivery": { "const": "stdin" },
            "claude_code_execute_requires_git_worktree": { "const": true },
            "claude_code_candidate_command_count": { "type": "integer", "minimum": 1 }
          }
        },
        "agent_run_ledger": {
          "type": "object",
          "required": ["agent_run_ledger_status", "agent_run_record_count", "current_claude_code_agent_run_record_count"],
          "properties": {
            "schema_version": { "type": ["string", "null"] },
            "agent_run_ledger_id": { "type": ["string", "null"] },
            "agent_run_ledger_status": { "const": "complete" },
            "agent_run_record_count": { "type": "integer", "minimum": 0 },
            "current_claude_code_agent_run_record_count": { "type": "integer", "minimum": 0 }
          }
        },
        "workflow_gate_freeze": {
          "type": "object",
          "required": ["workflow_gate_freeze_status"],
          "properties": {
            "schema_version": { "type": ["string", "null"] },
            "workflow_gate_freeze_status": { "const": "complete" },
            "workflow_gate_vertical_slice_count": { "type": "integer", "minimum": 0 }
          }
        },
        "desktop_companion_integration": {
          "type": "object",
          "required": ["declares_read_only", "declares_not_runtime_source_of_truth"],
          "properties": {
            "document_path": { "type": "string" },
            "declares_read_only": { "const": true },
            "declares_not_runtime_source_of_truth": { "const": true }
          }
        }
      }
    },
    "claude_code_adapter_contract": { "$ref": "#/$defs/claude_code_adapter_contract" },
    "claude_code_diff_gate_contracts": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/claude_code_diff_gate_contract" }
    },
    "claude_code_agent_run_ledger_bindings": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/claude_code_agent_run_ledger_binding" }
    },
    "claude_code_desktop_boundary": { "$ref": "#/$defs/claude_code_desktop_boundary" },
    "summary": {
      "type": "object",
      "required": [
        "claude_code_adapter_contract_status",
        "runtime_id",
        "adapter_id",
        "adapter_status",
        "claude_code_interface_bound",
        "claude_code_runtime_execution_contract_bound",
        "claude_code_command_binding_declared",
        "agent_run_ledger_bound",
        "diff_gate_contract_count",
        "diff_gate_binding_status",
        "direct_apply_allowed",
        "direct_merge_allowed",
        "protected_path_write_allowed",
        "patch_materialized_as_untrusted_artifact",
        "output_trust",
        "patch_trust",
        "verification_required",
        "execute_requires_git_worktree",
        "execute_requires_human_gate",
        "external_runtime_call_allowed_without_gate",
        "protected_file_gate_required",
        "diff_review_gate_required",
        "test_gate_required",
        "human_review_required",
        "unreviewed_auto_apply_count",
        "output_capture_ready",
        "log_capture_ready",
        "artifact_capture_ready",
        "verification_capture_ready",
        "diff_review_capture_ready",
        "desktop_read_only",
        "desktop_mutation_allowed",
        "desktop_protected_mutation_request_allowed",
        "desktop_protected_mutation_execution_allowed",
        "desktop_secret_material_exposed",
        "desktop_installer_or_gateway_control",
        "desktop_runtime_source_of_truth",
        "validation_error_count"
      ],
      "properties": {
        "claude_code_adapter_contract_status": { "const": "complete" },
        "runtime_id": { "const": "claude_code" },
        "adapter_id": { "const": "runtime.claude_code.default" },
        "adapter_status": { "const": "locked" },
        "claude_code_interface_bound": { "const": true },
        "claude_code_runtime_execution_contract_bound": { "const": true },
        "claude_code_command_binding_declared": { "const": true },
        "command_binding_id": { "const": "binding.claude_code.cli.default" },
        "agent_run_ledger_bound": { "const": true },
        "agent_run_ledger_status": { "const": "complete" },
        "current_agent_run_record_count": { "type": "integer", "minimum": 0 },
        "current_claude_code_agent_run_record_count": { "type": "integer", "minimum": 0 },
        "diff_gate_contract_count": { "type": "integer", "minimum": 1 },
        "diff_gate_binding_status": { "const": "ready" },
        "direct_apply_allowed": { "const": false },
        "direct_merge_allowed": { "const": false },
        "protected_path_write_allowed": { "const": false },
        "patch_materialized_as_untrusted_artifact": { "const": true },
        "output_trust": { "const": "untrusted_until_verified" },
        "patch_trust": { "const": "untrusted_until_reviewed" },
        "verification_required": { "const": true },
        "execute_requires_git_worktree": { "const": true },
        "execute_requires_human_gate": { "const": true },
        "external_runtime_call_allowed_without_gate": { "const": false },
        "protected_file_gate_required": { "const": true },
        "diff_review_gate_required": { "const": true },
        "test_gate_required": { "const": true },
        "human_review_required": { "const": true },
        "unreviewed_auto_apply_count": { "const": 0 },
        "output_capture_ready": { "const": true },
        "log_capture_ready": { "const": true },
        "artifact_capture_ready": { "const": true },
        "verification_capture_ready": { "const": true },
        "diff_review_capture_ready": { "const": true },
        "desktop_surface_policy": { "const": "read_only_runtime_status" },
        "desktop_read_only": { "const": true },
        "desktop_mutation_allowed": { "const": false },
        "desktop_protected_mutation_request_allowed": { "const": false },
        "desktop_protected_mutation_execution_allowed": { "const": false },
        "desktop_secret_material_exposed": { "const": false },
        "desktop_installer_or_gateway_control": { "const": false },
        "desktop_runtime_source_of_truth": { "const": false },
        "validation_item_count": { "type": "integer", "minimum": 1 },
        "failed_validation_item_count": { "const": 0 },
        "validation_error_count": { "const": 0 }
      }
    },
    "validation_items": { "type": "array", "items": { "$ref": "#/$defs/validation_item" } },
    "validation": {
      "type": "object",
      "required": ["valid", "errors"],
      "properties": {
        "valid": { "const": true },
        "errors": { "type": "array", "maxItems": 0 }
      }
    }
  },
  "$defs": {
    "claude_code_adapter_contract": {
      "type": "object",
      "required": [
        "schema_version",
        "contract_id",
        "runtime_id",
        "adapter_id",
        "adapter_interface_id",
        "runtime_execution_contract_id",
        "command_binding_id",
        "adapter_status",
        "execution_authority",
        "source_of_truth",
        "output_trust",
        "patch_trust",
        "verification_required",
        "lane_policy",
        "diff_gate_policy",
        "collection_policy"
      ],
      "properties": {
        "schema_version": { "const": "claude-code-adapter-contract.v1" },
        "generated_at": { "type": "string", "format": "date-time" },
        "contract_id": { "type": "string" },
        "runtime_id": { "const": "claude_code" },
        "adapter_id": { "const": "runtime.claude_code.default" },
        "adapter_interface_id": { "type": "string" },
        "runtime_execution_contract_id": { "type": "string" },
        "command_binding_id": { "const": "binding.claude_code.cli.default" },
        "adapter_status": { "const": "locked" },
        "execution_authority": { "const": "harness_control_plane" },
        "source_of_truth": { "const": "agent_run_ledger" },
        "output_trust": { "const": "untrusted_until_verified" },
        "patch_trust": { "const": "untrusted_until_reviewed" },
        "verification_required": { "const": true },
        "required_gates": { "type": "array", "minItems": 4, "items": { "type": "string" } },
        "lane_policy": {
          "type": "object",
          "required": [
            "output_mode",
            "direct_apply_allowed",
            "direct_merge_allowed",
            "protected_path_write_allowed",
            "execute_requires_git_worktree",
            "execute_requires_human_gate",
            "execute_requires_policy_snapshot",
            "execute_requires_agent_run_ledger_sink",
            "external_runtime_call_allowed_without_gate",
            "patch_materialized_as_untrusted_artifact",
            "runtime_self_report_trusted",
            "prompt_delivery"
          ],
          "properties": {
            "schema_version": { "const": "claude-code-lane-policy.v1" },
            "output_mode": { "const": "diff_or_pr_draft_only" },
            "direct_apply_allowed": { "const": false },
            "direct_merge_allowed": { "const": false },
            "protected_path_write_allowed": { "const": false },
            "execute_requires_git_worktree": { "const": true },
            "execute_requires_human_gate": { "const": true },
            "execute_requires_policy_snapshot": { "const": true },
            "execute_requires_agent_run_ledger_sink": { "const": true },
            "external_runtime_call_allowed_without_gate": { "const": false },
            "patch_materialized_as_untrusted_artifact": { "const": true },
            "runtime_self_report_trusted": { "const": false },
            "prompt_delivery": { "const": "stdin" },
            "command_resolution_required": { "const": true },
            "timeout_seconds": { "type": "integer", "minimum": 1 }
          }
        },
        "diff_gate_policy": { "$ref": "#/$defs/diff_gate_policy" },
        "collection_policy": {
          "type": "object",
          "required": [
            "sink_ledger",
            "collect_output_hash",
            "collect_logs_ref",
            "collect_artifact_refs",
            "collect_runtime_verification",
            "collect_diff_review_status",
            "ledger_write_owner",
            "runtime_self_report_trusted",
            "collection_status"
          ],
          "properties": {
            "schema_version": { "const": "claude-code-agent-run-collection-policy.v1" },
            "sink_ledger": { "const": "agent_run_ledger" },
            "sink_ledger_contract_id": { "const": "agent-run-ledger.v1" },
            "collect_runtime_invocation_id": { "const": true },
            "collect_workflow_run_id": { "const": true },
            "collect_input_ref": { "const": true },
            "collect_output_ref": { "const": true },
            "collect_output_hash": { "const": true },
            "collect_logs_ref": { "const": true },
            "collect_artifact_refs": { "const": true },
            "collect_runtime_verification": { "const": true },
            "collect_diff_review_status": { "const": true },
            "ledger_write_owner": { "const": "harness_control_plane" },
            "runtime_self_report_trusted": { "const": false },
            "collection_status": { "const": "ready" }
          }
        },
        "desktop_boundary_ref": { "type": "string" }
      }
    },
    "diff_gate_policy": {
      "type": "object",
      "required": [
        "change_target",
        "mutation_route",
        "merge_authority",
        "required_gates",
        "protected_file_gate_required",
        "diff_review_gate_required",
        "test_gate_required",
        "human_approval_gate_required",
        "bypass_allowed",
        "gate_binding_status"
      ],
      "properties": {
        "schema_version": { "const": "claude-code-diff-gate-policy.v1" },
        "change_target": { "const": "review_diff" },
        "mutation_route": { "const": "protected_action_request_only" },
        "merge_authority": { "const": "human_gate" },
        "acceptance_authority": { "const": "gate_engine" },
        "required_gates": { "type": "array", "minItems": 4, "items": { "type": "string" } },
        "protected_file_gate_required": { "const": true },
        "diff_review_gate_required": { "const": true },
        "test_gate_required": { "const": true },
        "human_approval_gate_required": { "const": true },
        "bypass_allowed": { "const": false },
        "gate_binding_status": { "const": "ready" }
      }
    },
    "claude_code_diff_gate_contract": {
      "type": "object",
      "required": [
        "schema_version",
        "diff_gate_contract_id",
        "runtime_id",
        "adapter_id",
        "change_target",
        "patch_output_trust",
        "direct_apply_allowed",
        "direct_merge_allowed",
        "protected_path_write_allowed",
        "human_review_required",
        "protected_file_gate_required",
        "diff_review_gate_required",
        "test_gate_required",
        "human_approval_gate_required",
        "required_gates",
        "gate_binding_status",
        "unreviewed_auto_apply_count",
        "contract_status"
      ],
      "properties": {
        "schema_version": { "const": "claude-code-diff-gate-contract.v1" },
        "generated_at": { "type": "string", "format": "date-time" },
        "diff_gate_contract_id": { "type": "string" },
        "runtime_id": { "const": "claude_code" },
        "adapter_id": { "const": "runtime.claude_code.default" },
        "change_target": { "const": "review_diff" },
        "patch_output_trust": { "const": "untrusted_until_verified" },
        "direct_apply_allowed": { "const": false },
        "direct_merge_allowed": { "const": false },
        "protected_path_write_allowed": { "const": false },
        "human_review_required": { "const": true },
        "protected_file_gate_required": { "const": true },
        "diff_review_gate_required": { "const": true },
        "test_gate_required": { "const": true },
        "human_approval_gate_required": { "const": true },
        "required_gates": { "type": "array", "minItems": 4, "items": { "type": "string" } },
        "gate_binding_status": { "const": "ready" },
        "workflow_gate_vertical_slice_refs": { "type": "array", "items": { "type": "string" } },
        "current_claude_code_agent_run_count": { "type": "integer", "minimum": 0 },
        "unreviewed_auto_apply_count": { "const": 0 },
        "contract_status": { "const": "locked" }
      }
    },
    "claude_code_agent_run_ledger_binding": {
      "type": "object",
      "required": [
        "schema_version",
        "binding_id",
        "runtime_id",
        "adapter_id",
        "source_diff_gate_contract_id",
        "sink_ledger_contract_id",
        "sink_ledger_status",
        "collection_status",
        "output_capture_status",
        "log_capture_status",
        "artifact_capture_status",
        "verification_capture_status",
        "diff_review_capture_status",
        "ledger_write_owner",
        "runtime_self_report_trusted",
        "binding_status"
      ],
      "properties": {
        "schema_version": { "const": "claude-code-agent-run-ledger-binding.v1" },
        "generated_at": { "type": "string", "format": "date-time" },
        "binding_id": { "type": "string" },
        "runtime_id": { "const": "claude_code" },
        "adapter_id": { "const": "runtime.claude_code.default" },
        "command_binding_id": { "const": "binding.claude_code.cli.default" },
        "source_diff_gate_contract_id": { "type": "string" },
        "sink_ledger_id": { "type": ["string", "null"] },
        "sink_ledger_contract_id": { "const": "agent-run-ledger.v1" },
        "sink_ledger_status": { "const": "complete" },
        "current_agent_run_record_count": { "type": "integer", "minimum": 0 },
        "current_claude_code_agent_run_record_count": { "type": "integer", "minimum": 0 },
        "collection_status": { "const": "ready" },
        "output_capture_status": { "const": "ready" },
        "log_capture_status": { "const": "ready" },
        "artifact_capture_status": { "const": "ready" },
        "verification_capture_status": { "const": "ready" },
        "diff_review_capture_status": { "const": "ready" },
        "ledger_write_owner": { "const": "harness_control_plane" },
        "runtime_self_report_trusted": { "const": false },
        "binding_status": { "const": "locked" }
      }
    },
    "claude_code_desktop_boundary": {
      "type": "object",
      "required": [
        "schema_version",
        "desktop_boundary_id",
        "runtime_id",
        "desktop_surface_policy",
        "source_of_truth",
        "runtime_source_of_truth",
        "desktop_source_of_truth",
        "read_only",
        "mutation_allowed",
        "protected_mutation_request_allowed",
        "protected_mutation_execution_allowed",
        "secret_material_exposed",
        "installer_or_gateway_control",
        "human_gate_required_for_execution",
        "boundary_status"
      ],
      "properties": {
        "schema_version": { "const": "claude-code-desktop-boundary.v1" },
        "generated_at": { "type": "string", "format": "date-time" },
        "desktop_boundary_id": { "type": "string" },
        "runtime_id": { "const": "claude_code" },
        "desktop_surface_policy": { "const": "read_only_runtime_status" },
        "source_of_truth": { "const": "harness_control_plane" },
        "runtime_source_of_truth": { "const": false },
        "desktop_source_of_truth": { "const": false },
        "read_only": { "const": true },
        "mutation_allowed": { "const": false },
        "protected_mutation_request_allowed": { "const": false },
        "protected_mutation_execution_allowed": { "const": false },
        "secret_material_exposed": { "const": false },
        "provider_key_visible": { "const": false },
        "installer_or_gateway_control": { "const": false },
        "ssh_or_cron_control": { "const": false },
        "auto_update_control": { "const": false },
        "skill_install_control": { "const": false },
        "allowed_operator_actions": { "type": "array", "items": { "type": "string" } },
        "denied_operator_actions": { "type": "array", "items": { "type": "string" } },
        "human_gate_required_for_execution": { "const": true },
        "protected_mutation_route": { "const": "receipt_draft_or_human_gate_only" },
        "integration_doc_declares_read_only": { "const": true },
        "boundary_status": { "const": "locked" }
      }
    },
    "validation_item": {
      "type": "object",
      "required": ["path", "check", "status", "message"],
      "properties": {
        "path": { "type": "string" },
        "check": { "type": "string" },
        "status": { "enum": ["passed", "failed"] },
        "message": { "type": "string" }
      }
    }
  }
}
