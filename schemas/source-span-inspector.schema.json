{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://amic.local/hermes/source-span-inspector.schema.json",
  "title": "Hermes Source Span Inspector",
  "type": "object",
  "required": [
    "schema_version",
    "generated_at",
    "source_span_inspector_id",
    "source_span_inspector_status",
    "capability_id",
    "phase_slot",
    "previous_phase_slot",
    "next_phase_slot",
    "output_dir",
    "inputs",
    "source_contracts",
    "source_span_inspector_contract",
    "source_span_inspector_panels",
    "source_span_inspector_rows",
    "source_span_location_comparisons",
    "normalized_text_comparisons",
    "extracted_fact_comparisons",
    "source_span_inspector_boundary",
    "source_span_inspector_checks",
    "validation_items",
    "validation",
    "summary"
  ],
  "properties": {
    "schema_version": { "const": "source-span-inspector.v1" },
    "generated_at": { "type": "string", "format": "date-time" },
    "source_span_inspector_id": { "type": "string" },
    "source_span_inspector_status": { "enum": ["complete", "attention"] },
    "capability_id": { "const": "dashboard.source_span_inspector" },
    "phase_slot": { "const": "P291" },
    "previous_phase_slot": { "const": "P290" },
    "next_phase_slot": { "const": "P292" },
    "output_dir": { "type": "string" },
    "inputs": {
      "type": "object",
      "required": [
        "package_path",
        "roadmap_path",
        "implementation_roadmap_path",
        "review_dashboard_path",
        "review_api_path",
        "review_api_doc_path",
        "source_span_store_path",
        "normalized_text_contract_path",
        "fact_claim_store_path",
        "evidence_viewer_ui_path"
      ],
      "properties": {
        "package_path": { "type": "string" },
        "roadmap_path": { "type": "string" },
        "implementation_roadmap_path": { "type": "string" },
        "review_dashboard_path": { "type": "string" },
        "review_api_path": { "type": "string" },
        "review_api_doc_path": { "type": "string" },
        "source_span_store_path": { "type": "string" },
        "normalized_text_contract_path": { "type": "string" },
        "fact_claim_store_path": { "type": "string" },
        "evidence_viewer_ui_path": { "type": "string" }
      }
    },
    "source_contracts": { "type": "array", "items": { "$ref": "#/$defs/source_contract" }, "minItems": 4 },
    "source_span_inspector_contract": { "$ref": "#/$defs/contract" },
    "source_span_inspector_panels": { "type": "array", "items": { "$ref": "#/$defs/panel" }, "minItems": 4 },
    "source_span_inspector_rows": { "type": "array", "items": { "$ref": "#/$defs/row" }, "minItems": 1 },
    "source_span_location_comparisons": { "type": "array", "items": { "$ref": "#/$defs/location_comparison" }, "minItems": 1 },
    "normalized_text_comparisons": { "type": "array", "items": { "$ref": "#/$defs/normalized_text_comparison" }, "minItems": 1 },
    "extracted_fact_comparisons": { "type": "array", "items": { "$ref": "#/$defs/extracted_fact_comparison" }, "minItems": 1 },
    "source_span_inspector_boundary": { "$ref": "#/$defs/boundary" },
    "source_span_inspector_checks": { "type": "array", "items": { "$ref": "#/$defs/check" } },
    "validation_items": { "type": "array", "items": { "$ref": "#/$defs/check" } },
    "validation": { "$ref": "#/$defs/validation" },
    "summary": { "$ref": "#/$defs/summary" },
    "summary_markdown": { "type": "string" }
  },
  "$defs": {
    "source_contract": {
      "type": "object",
      "required": ["schema_version", "source_id", "source_status", "validation_error_count"],
      "properties": {
        "schema_version": { "const": "source-span-inspector-source-contract.v1" },
        "source_id": { "enum": ["source_span_store", "normalized_text_contract", "fact_claim_store", "evidence_viewer_ui"] },
        "source_schema_version": { "type": ["string", "null"] },
        "source_generated_at": { "type": ["string", "null"], "format": "date-time" },
        "source_status": { "type": "string" },
        "validation_error_count": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": true
    },
    "contract": {
      "type": "object",
      "required": ["schema_version", "source_span_inspector_contract_id", "phase_slot", "source_inputs", "comparison_targets", "offset_unit"],
      "properties": {
        "schema_version": { "const": "source-span-inspector-contract.v1" },
        "source_span_inspector_contract_id": { "const": "source-span-inspector.v1" },
        "generated_at": { "type": "string", "format": "date-time" },
        "phase_slot": { "const": "P291" },
        "source_inputs": { "type": "array", "items": { "type": "string" } },
        "comparison_targets": { "type": "array", "items": { "type": "string" } },
        "offset_unit": { "const": "utf16_code_unit" },
        "boundary_rule": { "type": "string" },
        "human_review_rule": { "type": "string" }
      },
      "additionalProperties": true
    },
    "panel": {
      "type": "object",
      "required": ["schema_version", "panel_key", "panel_status", "row_count", "read_only", "preview_only", "human_review_required", "client_facing_ready"],
      "properties": {
        "schema_version": { "const": "source-span-inspector-panel.v1" },
        "panel_key": { "enum": ["source_locations", "normalized_text", "extracted_facts", "inspection_status"] },
        "panel_label": { "type": "string" },
        "panel_order": { "type": "integer", "minimum": 1 },
        "panel_status": { "const": "ready" },
        "description": { "type": "string" },
        "row_count": { "type": "integer", "minimum": 0 },
        "read_only": { "const": true },
        "preview_only": { "const": true },
        "source_file_content_read_allowed": { "const": false },
        "normalized_text_object_read_allowed": { "const": false },
        "source_ingest_allowed": { "const": false },
        "fact_mutation_allowed": { "const": false },
        "output_delivery_allowed": { "const": false },
        "legal_advice_generated": { "const": false },
        "client_facing_ready": { "const": false },
        "human_review_required": { "const": true },
        "generated_at": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": true
    },
    "row": {
      "type": "object",
      "required": [
        "schema_version",
        "source_span_inspector_row_id",
        "inspection_status",
        "comparison_status",
        "source_span_id",
        "normalized_text_id",
        "location_type",
        "locator",
        "location_comparison_status",
        "normalized_text_comparison_status",
        "extracted_fact_comparison_status",
        "read_only",
        "preview_only",
        "human_review_required",
        "client_facing_ready"
      ],
      "properties": {
        "schema_version": { "const": "source-span-inspector-row.v1" },
        "source_span_inspector_row_id": { "type": "string" },
        "generated_at": { "type": "string", "format": "date-time" },
        "inspection_status": { "enum": ["ready", "attention"] },
        "comparison_status": { "enum": ["matched", "attention"] },
        "source_span_id": { "type": "string" },
        "normalized_text_id": { "type": "string" },
        "location_type": { "type": "string" },
        "locator": { "type": "object" },
        "location_comparison_status": { "enum": ["matched", "attention"] },
        "normalized_text_comparison_status": { "enum": ["matched", "attention"] },
        "extracted_fact_comparison_status": { "enum": ["matched", "attention"] },
        "read_only": { "const": true },
        "preview_only": { "const": true },
        "source_file_content_read_performed": { "const": false },
        "normalized_text_object_read_performed": { "const": false },
        "source_ingest_performed": { "const": false },
        "fact_mutation_performed": { "const": false },
        "legal_advice_generated": { "const": false },
        "client_facing_output_generated": { "const": false },
        "human_review_required": { "const": true },
        "client_facing_ready": { "const": false }
      },
      "additionalProperties": true
    },
    "location_comparison": {
      "type": "object",
      "required": ["schema_version", "location_comparison_id", "source_span_id", "comparison_status", "read_only", "preview_only", "source_file_content_read_performed"],
      "properties": {
        "schema_version": { "const": "source-span-location-comparison.v1" },
        "location_comparison_id": { "type": "string" },
        "source_span_id": { "type": "string" },
        "comparison_status": { "enum": ["matched", "attention"] },
        "read_only": { "const": true },
        "preview_only": { "const": true },
        "source_file_content_read_performed": { "const": false }
      },
      "additionalProperties": true
    },
    "normalized_text_comparison": {
      "type": "object",
      "required": ["schema_version", "normalized_text_comparison_id", "source_span_id", "normalized_text_id", "comparison_status", "read_only", "preview_only", "normalized_text_object_read_performed"],
      "properties": {
        "schema_version": { "const": "normalized-text-comparison.v1" },
        "normalized_text_comparison_id": { "type": "string" },
        "source_span_id": { "type": "string" },
        "normalized_text_id": { "type": "string" },
        "comparison_status": { "enum": ["matched", "attention"] },
        "read_only": { "const": true },
        "preview_only": { "const": true },
        "normalized_text_object_read_performed": { "const": false }
      },
      "additionalProperties": true
    },
    "extracted_fact_comparison": {
      "type": "object",
      "required": ["schema_version", "extracted_fact_comparison_id", "source_span_id", "comparison_status", "human_review_required", "client_facing_ready", "read_only", "preview_only", "fact_mutation_performed"],
      "properties": {
        "schema_version": { "const": "extracted-fact-comparison.v1" },
        "extracted_fact_comparison_id": { "type": "string" },
        "source_span_id": { "type": "string" },
        "comparison_status": { "enum": ["matched", "attention"] },
        "human_review_required": { "const": true },
        "client_facing_ready": { "const": false },
        "read_only": { "const": true },
        "preview_only": { "const": true },
        "fact_mutation_performed": { "const": false }
      },
      "additionalProperties": true
    },
    "boundary": {
      "type": "object",
      "required": ["schema_version", "boundary_status", "read_only", "preview_only", "inspector_projection_only", "source_file_content_read_performed", "normalized_text_object_read_performed", "source_ingest_performed", "fact_mutation_performed", "output_delivery_performed", "route_execution_performed", "server_started", "mutation_allowed", "protected_action_executed", "legal_advice_generated", "client_facing_output_generated", "human_review_required", "client_facing_ready", "windows_baseline_stability_preserved", "mac_windows_completion_instability_guard"],
      "properties": {
        "schema_version": { "const": "source-span-inspector-boundary.v1" },
        "boundary_status": { "const": "enforced" },
        "read_only": { "const": true },
        "preview_only": { "const": true },
        "inspector_projection_only": { "const": true },
        "source_file_content_read_performed": { "const": false },
        "normalized_text_object_read_performed": { "const": false },
        "source_ingest_performed": { "const": false },
        "fact_mutation_performed": { "const": false },
        "output_delivery_performed": { "const": false },
        "route_execution_performed": { "const": false },
        "server_started": { "const": false },
        "mutation_allowed": { "const": false },
        "protected_action_executed": { "const": false },
        "legal_advice_generated": { "const": false },
        "client_facing_output_generated": { "const": false },
        "human_review_required": { "const": true },
        "client_facing_ready": { "const": false },
        "windows_baseline_stability_preserved": { "const": true },
        "mac_windows_completion_instability_guard": { "const": true }
      },
      "additionalProperties": true
    },
    "check": {
      "type": "object",
      "required": ["schema_version", "validation_id", "subject_id", "check_id", "status", "message"],
      "properties": {
        "schema_version": { "const": "source-span-inspector-check.v1" },
        "validation_id": { "type": "string" },
        "subject_id": { "type": "string" },
        "check_id": { "type": "string" },
        "status": { "enum": ["passed", "failed"] },
        "message": { "type": "string" }
      },
      "additionalProperties": true
    },
    "validation": {
      "type": "object",
      "required": ["valid", "errors"],
      "properties": {
        "valid": { "type": "boolean" },
        "errors": { "type": "array", "items": { "type": "object" } }
      }
    },
    "summary": {
      "type": "object",
      "required": [
        "source_span_inspector_status",
        "source_span_inspector_id",
        "phase_slot",
        "previous_phase_slot",
        "next_phase_slot",
        "source_span_inspector_panel_count",
        "inspected_source_span_count",
        "location_comparison_count",
        "normalized_text_comparison_count",
        "extracted_fact_comparison_count",
        "fully_matched_row_count",
        "validation_error_count"
      ],
      "properties": {
        "source_span_inspector_status": { "const": "complete" },
        "source_span_inspector_id": { "type": "string" },
        "phase_slot": { "const": "P291" },
        "previous_phase_slot": { "const": "P290" },
        "next_phase_slot": { "const": "P292" },
        "source_source_span_store_status": { "const": "complete" },
        "source_normalized_text_contract_status": { "const": "complete" },
        "source_fact_claim_store_status": { "const": "complete" },
        "source_evidence_viewer_ui_status": { "const": "complete" },
        "source_evidence_viewer_ui_phase_slot": { "const": "P290" },
        "source_evidence_viewer_ui_next_phase_slot": { "const": "P291" },
        "source_span_inspector_panel_count": { "const": 4 },
        "required_panel_count": { "const": 4 },
        "ready_panel_count": { "const": 4 },
        "inspected_source_span_count": { "minimum": 1 },
        "location_comparison_count": { "minimum": 1 },
        "normalized_text_comparison_count": { "minimum": 1 },
        "extracted_fact_comparison_count": { "minimum": 1 },
        "attention_row_count": { "const": 0 },
        "client_facing_ready_row_count": { "const": 0 },
        "read_only": { "const": true },
        "preview_only": { "const": true },
        "inspector_projection_only": { "const": true },
        "source_file_content_read_performed": { "const": false },
        "normalized_text_object_read_performed": { "const": false },
        "source_ingest_performed": { "const": false },
        "fact_mutation_performed": { "const": false },
        "output_delivery_performed": { "const": false },
        "route_execution_performed": { "const": false },
        "server_started": { "const": false },
        "mutation_allowed": { "const": false },
        "protected_action_executed": { "const": false },
        "legal_advice_generated": { "const": false },
        "client_facing_output_generated": { "const": false },
        "human_review_required": { "const": true },
        "client_facing_ready": { "const": false },
        "windows_baseline_stability_preserved": { "const": true },
        "mac_windows_completion_instability_guard": { "const": true },
        "validation_error_count": { "const": 0 },
        "failed_checkpoint_count": { "const": 0 }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
