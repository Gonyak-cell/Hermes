{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://amic.local/hermes/review-dashboard.schema.json",
  "title": "Hermes Review Dashboard",
  "type": "object",
  "required": [
    "schema_version",
    "generated_at",
    "summary",
    "sources",
    "stage_statuses",
    "action_items"
  ],
  "properties": {
    "schema_version": {
      "const": "review-dashboard.v1"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "summary": {
      "type": "object",
      "required": [
        "overall_status",
        "stage_count",
        "missing_stage_count",
        "blocked_stage_count",
        "pending_stage_count",
        "resource_count",
        "evidence_count",
        "evidence_needs_review_count",
        "evidence_approved_count",
        "evidence_rejected_count",
        "blocking_gate_count",
        "blocked_resource_count",
        "approval_queue_item_count",
        "approval_applied_count",
        "pending_approval_count",
        "audit_event_count",
        "follow_up_count",
        "decision_error_count",
        "action_item_count"
      ],
      "properties": {
        "overall_status": {
          "enum": ["ready", "pending_review", "blocked", "attention", "incomplete"]
        },
        "stage_count": {
          "type": "integer",
          "minimum": 0
        },
        "missing_stage_count": {
          "type": "integer",
          "minimum": 0
        },
        "blocked_stage_count": {
          "type": "integer",
          "minimum": 0
        },
        "pending_stage_count": {
          "type": "integer",
          "minimum": 0
        },
        "resource_count": {
          "type": "integer",
          "minimum": 0
        },
        "evidence_count": {
          "type": "integer",
          "minimum": 0
        },
        "evidence_needs_review_count": {
          "type": "integer",
          "minimum": 0
        },
        "evidence_approved_count": {
          "type": "integer",
          "minimum": 0
        },
        "evidence_rejected_count": {
          "type": "integer",
          "minimum": 0
        },
        "blocking_gate_count": {
          "type": "integer",
          "minimum": 0
        },
        "blocked_resource_count": {
          "type": "integer",
          "minimum": 0
        },
        "approval_queue_item_count": {
          "type": "integer",
          "minimum": 0
        },
        "approval_applied_count": {
          "type": "integer",
          "minimum": 0
        },
        "pending_approval_count": {
          "type": "integer",
          "minimum": 0
        },
        "audit_event_count": {
          "type": "integer",
          "minimum": 0
        },
        "follow_up_count": {
          "type": "integer",
          "minimum": 0
        },
        "decision_error_count": {
          "type": "integer",
          "minimum": 0
        },
        "action_item_count": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "source_id",
          "label",
          "path",
          "available",
          "schema_version",
          "generated_at",
          "summary",
          "error"
        ],
        "properties": {
          "source_id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "path": {
            "type": ["string", "null"]
          },
          "available": {
            "type": "boolean"
          },
          "schema_version": {
            "type": ["string", "null"]
          },
          "generated_at": {
            "type": ["string", "null"],
            "format": "date-time"
          },
          "summary": {
            "type": ["object", "null"]
          },
          "error": {
            "type": ["string", "null"]
          }
        }
      }
    },
    "stage_statuses": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["stage_id", "label", "status", "message", "source_path", "metrics"],
        "properties": {
          "stage_id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "status": {
            "enum": ["missing", "blocked", "attention", "pending", "ready", "passed"]
          },
          "message": {
            "type": "string"
          },
          "source_path": {
            "type": ["string", "null"]
          },
          "metrics": {
            "type": "object"
          }
        }
      }
    },
    "action_items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "action_item_id",
          "source_stage",
          "priority",
          "status",
          "title",
          "subject_ref",
          "reason",
          "recommended_actions",
          "source_ref"
        ],
        "properties": {
          "action_item_id": {
            "type": "string"
          },
          "source_stage": {
            "type": "string"
          },
          "priority": {
            "enum": ["critical", "high", "medium", "low"]
          },
          "status": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "subject_ref": {
            "type": "object",
            "required": ["subject_type", "subject_id"],
            "properties": {
              "subject_type": {
                "type": "string"
              },
              "subject_id": {
                "type": "string"
              }
            }
          },
          "reason": {
            "type": "string"
          },
          "recommended_actions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "source_ref": {
            "type": ["string", "null"]
          }
        }
      }
    }
  }
}
