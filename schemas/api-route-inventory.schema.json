{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://amic.local/hermes/api-route-inventory.schema.json",
  "title": "Hermes API Route Inventory",
  "type": "object",
  "required": [
    "schema_version",
    "generated_at",
    "api_route_inventory_id",
    "api_route_inventory_status",
    "phase_slot",
    "previous_phase_slot",
    "next_phase_slot",
    "summary",
    "api_route_group_rows",
    "api_route_rows",
    "api_route_inventory_boundary",
    "api_route_inventory_checks",
    "validation_items",
    "validation"
  ],
  "properties": {
    "schema_version": { "const": "api-route-inventory.v1" },
    "generated_at": { "type": "string", "format": "date-time" },
    "api_route_inventory_id": { "type": "string" },
    "api_route_inventory_status": { "enum": ["complete", "attention"] },
    "phase_slot": { "const": "P287" },
    "previous_phase_slot": { "const": "P286" },
    "next_phase_slot": { "const": "P288" },
    "summary": {
      "type": "object",
      "required": [
        "api_route_inventory_status",
        "phase_slot",
        "previous_phase_slot",
        "next_phase_slot",
        "required_group_count",
        "listed_required_group_count",
        "api_route_group_count",
        "api_route_count",
        "read_only_route_count",
        "mutation_route_count",
        "protected_action_execution_route_count",
        "legal_advice_route_count",
        "client_facing_output_route_count",
        "core_route_count",
        "review_route_count",
        "evidence_route_count",
        "policy_route_count",
        "runtime_route_count",
        "desktop_companion_route_count",
        "route_partition_count",
        "inventory_route_count",
        "read_only",
        "inventory_only",
        "route_execution_performed",
        "server_started",
        "mutation_allowed",
        "protected_action_executed",
        "legal_advice_generated",
        "client_facing_output_generated",
        "windows_baseline_stability_preserved",
        "mac_windows_completion_instability_guard",
        "validation_error_count"
      ],
      "properties": {
        "api_route_inventory_status": { "const": "complete" },
        "phase_slot": { "const": "P287" },
        "previous_phase_slot": { "const": "P286" },
        "next_phase_slot": { "const": "P288" },
        "required_group_count": { "const": 6 },
        "listed_required_group_count": { "const": 6 },
        "api_route_group_count": { "minimum": 6 },
        "api_route_count": { "minimum": 1 },
        "read_only_route_count": { "minimum": 1 },
        "mutation_route_count": { "const": 0 },
        "protected_action_execution_route_count": { "const": 0 },
        "legal_advice_route_count": { "const": 0 },
        "client_facing_output_route_count": { "const": 0 },
        "core_route_count": { "minimum": 1 },
        "review_route_count": { "minimum": 1 },
        "evidence_route_count": { "minimum": 1 },
        "policy_route_count": { "minimum": 1 },
        "runtime_route_count": { "minimum": 1 },
        "desktop_companion_route_count": { "minimum": 1 },
        "route_partition_count": { "minimum": 1 },
        "inventory_route_count": { "minimum": 6 },
        "read_only": { "const": true },
        "inventory_only": { "const": true },
        "route_execution_performed": { "const": false },
        "server_started": { "const": false },
        "mutation_allowed": { "const": false },
        "protected_action_executed": { "const": false },
        "legal_advice_generated": { "const": false },
        "client_facing_output_generated": { "const": false },
        "windows_baseline_stability_preserved": { "const": true },
        "mac_windows_completion_instability_guard": { "const": true },
        "validation_error_count": { "const": 0 }
      },
      "additionalProperties": true
    },
    "api_route_group_rows": {
      "type": "array",
      "minItems": 6,
      "items": { "$ref": "#/$defs/api_route_group_row" }
    },
    "api_route_rows": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/api_route_row" }
    },
    "api_route_inventory_boundary": { "$ref": "#/$defs/boundary" },
    "api_route_inventory_checks": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/check" }
    },
    "validation_items": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/check" }
    },
    "validation": {
      "type": "object",
      "required": ["valid", "item_count", "error_count", "errors"],
      "properties": {
        "valid": { "const": true },
        "item_count": { "minimum": 1 },
        "error_count": { "const": 0 },
        "errors": { "type": "array", "maxItems": 0 }
      },
      "additionalProperties": true
    }
  },
  "$defs": {
    "api_route_group_row": {
      "type": "object",
      "required": [
        "route_group_key",
        "route_group_status",
        "route_count",
        "read_only_route_count",
        "mutation_route_count",
        "protected_action_execution_route_count",
        "legal_advice_route_count",
        "client_facing_output_route_count",
        "human_review_required",
        "client_facing_ready"
      ],
      "properties": {
        "route_group_key": {
          "enum": ["core", "review", "evidence", "policy", "runtime", "desktop_companion"]
        },
        "route_group_status": { "const": "listed" },
        "route_count": { "minimum": 1 },
        "read_only_route_count": { "minimum": 1 },
        "mutation_route_count": { "const": 0 },
        "protected_action_execution_route_count": { "const": 0 },
        "legal_advice_route_count": { "const": 0 },
        "client_facing_output_route_count": { "const": 0 },
        "human_review_required": { "const": true },
        "client_facing_ready": { "const": false }
      },
      "additionalProperties": true
    },
    "api_route_row": {
      "type": "object",
      "required": [
        "method",
        "path",
        "route_group_key",
        "route_status",
        "read_only",
        "mutation_allowed",
        "protected_action_execution_allowed",
        "legal_advice_generated",
        "client_facing_output_generated",
        "human_review_required",
        "client_facing_ready"
      ],
      "properties": {
        "method": { "const": "GET" },
        "path": { "type": "string" },
        "route_group_key": {
          "enum": ["core", "review", "evidence", "policy", "runtime", "desktop_companion"]
        },
        "route_status": { "const": "listed" },
        "read_only": { "const": true },
        "mutation_allowed": { "const": false },
        "protected_action_execution_allowed": { "const": false },
        "legal_advice_generated": { "const": false },
        "client_facing_output_generated": { "const": false },
        "human_review_required": { "const": true },
        "client_facing_ready": { "const": false }
      },
      "additionalProperties": true
    },
    "boundary": {
      "type": "object",
      "required": [
        "boundary_status",
        "read_only",
        "inventory_only",
        "route_execution_performed",
        "server_started",
        "mutation_allowed",
        "protected_action_executed",
        "legal_advice_generated",
        "client_facing_output_generated",
        "windows_baseline_stability_preserved",
        "mac_windows_completion_instability_guard"
      ],
      "properties": {
        "boundary_status": { "const": "enforced" },
        "read_only": { "const": true },
        "inventory_only": { "const": true },
        "route_execution_performed": { "const": false },
        "server_started": { "const": false },
        "mutation_allowed": { "const": false },
        "protected_action_executed": { "const": false },
        "legal_advice_generated": { "const": false },
        "client_facing_output_generated": { "const": false },
        "windows_baseline_stability_preserved": { "const": true },
        "mac_windows_completion_instability_guard": { "const": true }
      },
      "additionalProperties": true
    },
    "check": {
      "type": "object",
      "required": ["path", "status", "message", "human_review_required", "client_facing_ready"],
      "properties": {
        "path": { "type": "string" },
        "status": { "const": "passed" },
        "message": { "type": "string" },
        "human_review_required": { "const": true },
        "client_facing_ready": { "const": false }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
