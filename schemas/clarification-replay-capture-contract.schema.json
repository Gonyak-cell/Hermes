{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hermes.local/schemas/clarification-replay-capture-contract.schema.json",
  "title": "Hermes Clarification Replay Capture Contract",
  "type": "object",
  "required": [
    "schema_version",
    "generated_at",
    "capability_id",
    "program_range",
    "source_program_range",
    "clarification_replay_capture_phase_rows",
    "p33600_source_binding_rows",
    "redacted_answer_receipt_intake_rows",
    "question_replay_trace_binding_rows",
    "replay_ledger_completion_candidate_rows",
    "seed_recheck_candidate_rows",
    "no_execution_no_raw_boundary_rows",
    "p34000_clean_checkpoint_rows",
    "clarification_replay_capture_boundary",
    "clarification_replay_capture_validation_items",
    "summary",
    "validation"
  ],
  "properties": {
    "schema_version": { "const": "clarification-replay-capture-contract.v1" },
    "generated_at": { "type": "string", "format": "date-time" },
    "capability_id": { "const": "platform.clarification_replay_capture_contract" },
    "program_range": { "const": "P33601-P34000" },
    "source_program_range": { "const": "P33201-P33600" },
    "clarification_replay_capture_phase_rows": { "type": "array", "minItems": 7, "items": { "$ref": "#/$defs/verdictRow" } },
    "p33600_source_binding_rows": { "type": "array", "minItems": 12, "items": { "$ref": "#/$defs/verdictRow" } },
    "redacted_answer_receipt_intake_rows": { "type": "array", "minItems": 3, "items": { "$ref": "#/$defs/verdictRow" } },
    "question_replay_trace_binding_rows": { "type": "array", "minItems": 3, "items": { "$ref": "#/$defs/verdictRow" } },
    "replay_ledger_completion_candidate_rows": { "type": "array", "minItems": 3, "items": { "$ref": "#/$defs/verdictRow" } },
    "seed_recheck_candidate_rows": { "type": "array", "minItems": 3, "items": { "$ref": "#/$defs/verdictRow" } },
    "no_execution_no_raw_boundary_rows": { "type": "array", "minItems": 340, "items": { "$ref": "#/$defs/verdictRow" } },
    "p34000_clean_checkpoint_rows": { "type": "array", "minItems": 9, "items": { "$ref": "#/$defs/verdictRow" } },
    "clarification_replay_capture_validation_items": { "type": "array", "minItems": 15, "items": { "$ref": "#/$defs/validationItem" } },
    "summary": {
      "type": "object",
      "required": [
        "clarification_replay_capture_status",
        "source_p33600_ready_for_clarification_replay_capture",
        "redacted_answer_receipt_intake_count",
        "question_replay_trace_binding_count",
        "replay_ledger_completion_candidate_count",
        "seed_recheck_candidate_count",
        "missing_evidence_blocker_count",
        "answer_capture_allowed_count",
        "replay_completion_allowed_count",
        "seed_recheck_execution_allowed_count",
        "ready_for_seed_recheck_validation_handoff",
        "clarification_replay_answer_capture_allowed_now",
        "clarification_replay_raw_answer_persist_allowed_now",
        "clarification_replay_raw_answer_exposure_allowed_now",
        "clarification_replay_redacted_answer_receipt_auto_accept_allowed_now",
        "clarification_replay_question_trace_auto_accept_allowed_now",
        "clarification_replay_completion_allowed_now",
        "clarification_replay_verification_pass_allowed_now",
        "clarification_replay_seed_recheck_execution_allowed_now",
        "clarification_replay_seed_recheck_pass_allowed_now",
        "clarification_replay_seed_unblock_allowed_now",
        "clarification_replay_final_seed_allowed_now",
        "clarification_replay_runtime_execution_allowed_now",
        "clarification_replay_write_action_allowed_now",
        "clarification_replay_protected_action_allowed_now",
        "clarification_replay_final_approval_allowed_now",
        "clarification_replay_production_pass_allowed_now",
        "production_pass_enabled"
      ],
      "properties": {
        "clarification_replay_capture_status": {
          "enum": [
            "ready_for_clarification_replay_capture_contract",
            "valid_block_clarification_replay_capture_contract_pending",
            "blocked_clarification_replay_capture_contract"
          ]
        },
        "source_p33600_ready_for_clarification_replay_capture": { "type": "boolean" },
        "redacted_answer_receipt_intake_count": { "type": "number" },
        "question_replay_trace_binding_count": { "type": "number" },
        "replay_ledger_completion_candidate_count": { "type": "number" },
        "seed_recheck_candidate_count": { "type": "number" },
        "missing_evidence_blocker_count": { "type": "number" },
        "answer_capture_allowed_count": { "const": 0 },
        "replay_completion_allowed_count": { "const": 0 },
        "seed_recheck_execution_allowed_count": { "const": 0 },
        "ready_for_seed_recheck_validation_handoff": { "type": "boolean" },
        "clarification_replay_answer_capture_allowed_now": { "const": false },
        "clarification_replay_raw_answer_persist_allowed_now": { "const": false },
        "clarification_replay_raw_answer_exposure_allowed_now": { "const": false },
        "clarification_replay_redacted_answer_receipt_auto_accept_allowed_now": { "const": false },
        "clarification_replay_question_trace_auto_accept_allowed_now": { "const": false },
        "clarification_replay_completion_allowed_now": { "const": false },
        "clarification_replay_verification_pass_allowed_now": { "const": false },
        "clarification_replay_seed_recheck_execution_allowed_now": { "const": false },
        "clarification_replay_seed_recheck_pass_allowed_now": { "const": false },
        "clarification_replay_seed_unblock_allowed_now": { "const": false },
        "clarification_replay_final_seed_allowed_now": { "const": false },
        "clarification_replay_runtime_execution_allowed_now": { "const": false },
        "clarification_replay_write_action_allowed_now": { "const": false },
        "clarification_replay_protected_action_allowed_now": { "const": false },
        "clarification_replay_final_approval_allowed_now": { "const": false },
        "clarification_replay_production_pass_allowed_now": { "const": false },
        "production_pass_enabled": { "const": false },
        "enterprise_trust_claim_allowed_now": { "const": false },
        "validation_error_count": { "type": "number" }
      }
    },
    "clarification_replay_capture_boundary": {
      "type": "object",
      "required": [
        "p34000_contract_ready",
        "ready_for_seed_recheck_validation_handoff",
        "source_p33600_ready_for_clarification_replay_capture",
        "redacted_answer_receipt_intake_visible_now",
        "question_replay_trace_binding_visible_now",
        "replay_ledger_completion_candidate_visible_now",
        "seed_recheck_candidate_visible_now",
        "no_execution_no_raw_boundary_closed_now",
        "answer_capture_allowed_count",
        "replay_completion_allowed_count",
        "seed_recheck_execution_allowed_count",
        "clarification_replay_answer_capture_allowed_now",
        "clarification_replay_raw_answer_persist_allowed_now",
        "clarification_replay_raw_answer_exposure_allowed_now",
        "clarification_replay_redacted_answer_receipt_auto_accept_allowed_now",
        "clarification_replay_question_trace_auto_accept_allowed_now",
        "clarification_replay_completion_allowed_now",
        "clarification_replay_verification_pass_allowed_now",
        "clarification_replay_seed_recheck_execution_allowed_now",
        "clarification_replay_seed_recheck_pass_allowed_now",
        "clarification_replay_seed_unblock_allowed_now",
        "clarification_replay_final_seed_allowed_now",
        "clarification_replay_runtime_execution_allowed_now",
        "clarification_replay_write_action_allowed_now",
        "clarification_replay_protected_action_allowed_now",
        "clarification_replay_final_approval_allowed_now",
        "clarification_replay_production_pass_allowed_now"
      ],
      "properties": {
        "p34000_contract_ready": { "type": "boolean" },
        "ready_for_seed_recheck_validation_handoff": { "type": "boolean" },
        "source_p33600_ready_for_clarification_replay_capture": { "type": "boolean" },
        "source_validation_valid_now": { "type": "boolean" },
        "redacted_answer_receipt_intake_visible_now": { "type": "boolean" },
        "question_replay_trace_binding_visible_now": { "type": "boolean" },
        "replay_ledger_completion_candidate_visible_now": { "type": "boolean" },
        "seed_recheck_candidate_visible_now": { "type": "boolean" },
        "no_execution_no_raw_boundary_closed_now": { "type": "boolean" },
        "redacted_answer_receipt_intake_count": { "type": "number" },
        "question_replay_trace_binding_count": { "type": "number" },
        "replay_ledger_completion_candidate_count": { "type": "number" },
        "seed_recheck_candidate_count": { "type": "number" },
        "missing_evidence_blocker_count": { "type": "number" },
        "answer_capture_allowed_count": { "const": 0 },
        "replay_completion_allowed_count": { "const": 0 },
        "seed_recheck_execution_allowed_count": { "const": 0 },
        "clarification_replay_answer_capture_allowed_now": { "const": false },
        "clarification_replay_raw_answer_persist_allowed_now": { "const": false },
        "clarification_replay_raw_answer_exposure_allowed_now": { "const": false },
        "clarification_replay_redacted_answer_receipt_auto_accept_allowed_now": { "const": false },
        "clarification_replay_question_trace_auto_accept_allowed_now": { "const": false },
        "clarification_replay_completion_allowed_now": { "const": false },
        "clarification_replay_verification_pass_allowed_now": { "const": false },
        "clarification_replay_seed_recheck_execution_allowed_now": { "const": false },
        "clarification_replay_seed_recheck_pass_allowed_now": { "const": false },
        "clarification_replay_seed_unblock_allowed_now": { "const": false },
        "clarification_replay_final_seed_allowed_now": { "const": false },
        "clarification_replay_runtime_execution_allowed_now": { "const": false },
        "clarification_replay_write_action_allowed_now": { "const": false },
        "clarification_replay_protected_action_allowed_now": { "const": false },
        "clarification_replay_connector_write_allowed_now": { "const": false },
        "clarification_replay_deployment_allowed_now": { "const": false },
        "clarification_replay_review_completion_allowed_now": { "const": false },
        "clarification_replay_final_approval_allowed_now": { "const": false },
        "clarification_replay_production_pass_allowed_now": { "const": false },
        "clarification_replay_enterprise_trust_claim_allowed_now": { "const": false },
        "clarification_replay_secret_read_allowed_now": { "const": false },
        "clarification_replay_human_gate_bypass_allowed_now": { "const": false },
        "clarification_replay_independent_review_bypass_allowed_now": { "const": false },
        "clarification_replay_final_automated_approval_allowed_now": { "const": false },
        "production_pass_enabled": { "const": false },
        "enterprise_trust_claim_allowed_now": { "const": false }
      }
    },
    "validation": {
      "type": "object",
      "required": ["valid", "error_count", "errors"],
      "properties": {
        "valid": { "type": "boolean" },
        "error_count": { "type": "number" },
        "errors": { "type": "array" }
      }
    }
  },
  "$defs": {
    "verdictRow": {
      "type": "object",
      "required": ["row_id", "category", "label", "observed", "current_verdict", "block_reason", "evidence_ref"],
      "properties": {
        "row_id": { "type": "string" },
        "category": { "type": "string" },
        "label": { "type": "string" },
        "observed": { "type": "boolean" },
        "current_verdict": { "enum": ["pass", "block"] },
        "block_reason": { "type": ["string", "null"] },
        "evidence_ref": { "type": ["string", "null"] },
        "generated_at": { "type": "string" }
      },
      "additionalProperties": true
    },
    "validationItem": {
      "allOf": [{ "$ref": "#/$defs/verdictRow" }]
    }
  }
}
