{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hermes.local/schemas/security-compliance-maturity.schema.json",
  "title": "Hermes Security And Compliance Maturity",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "capability_id",
    "program_range",
    "source_program_range",
    "security_compliance_contract",
    "security_compliance_phase_rows",
    "security_source_binding_rows",
    "soc2_control_signal_rows",
    "access_review_signal_rows",
    "secret_scanning_signal_rows",
    "prompt_injection_guard_rows",
    "data_retention_policy_rows",
    "incident_workflow_signal_rows",
    "compliance_evidence_link_rows",
    "claude_security_compliance_review_rows",
    "security_authority_guard_rows",
    "p14600_freeze_rows",
    "security_compliance_boundary",
    "security_compliance_validation_items",
    "validation",
    "summary"
  ],
  "properties": {
    "schema_version": { "const": "security-compliance-maturity.v1" },
    "capability_id": { "const": "platform.security_compliance_maturity" },
    "program_range": { "const": "P14201-P14600" },
    "source_program_range": { "const": "P13801-P14200" },
    "security_compliance_phase_rows": { "type": "array", "minItems": 10, "items": { "$ref": "#/$defs/verdictRow" } },
    "security_source_binding_rows": { "type": "array", "minItems": 8, "items": { "$ref": "#/$defs/verdictRow" } },
    "soc2_control_signal_rows": { "type": "array", "minItems": 6, "items": { "$ref": "#/$defs/verdictRow" } },
    "access_review_signal_rows": { "type": "array", "minItems": 6, "items": { "$ref": "#/$defs/verdictRow" } },
    "secret_scanning_signal_rows": { "type": "array", "minItems": 6, "items": { "$ref": "#/$defs/verdictRow" } },
    "prompt_injection_guard_rows": { "type": "array", "minItems": 6, "items": { "$ref": "#/$defs/verdictRow" } },
    "data_retention_policy_rows": { "type": "array", "minItems": 6, "items": { "$ref": "#/$defs/verdictRow" } },
    "incident_workflow_signal_rows": { "type": "array", "minItems": 6, "items": { "$ref": "#/$defs/verdictRow" } },
    "compliance_evidence_link_rows": { "type": "array", "minItems": 6, "items": { "$ref": "#/$defs/verdictRow" } },
    "claude_security_compliance_review_rows": { "type": "array", "minItems": 5, "items": { "$ref": "#/$defs/verdictRow" } },
    "security_authority_guard_rows": { "type": "array", "minItems": 10, "items": { "$ref": "#/$defs/verdictRow" } },
    "p14600_freeze_rows": { "type": "array", "minItems": 12, "items": { "$ref": "#/$defs/verdictRow" } },
    "security_compliance_boundary": {
      "type": "object",
      "required": [
        "source_product_ops_available",
        "source_ready_for_p14201_handoff",
        "source_block_visible_now",
        "soc2_control_signal_ready",
        "access_review_signal_ready",
        "secret_scanning_signal_ready",
        "prompt_injection_guard_ready",
        "data_retention_policy_ready",
        "incident_workflow_signal_ready",
        "compliance_evidence_link_ready",
        "claude_security_compliance_review_receipt_present_now",
        "claude_security_compliance_review_block_visible_now",
        "security_authority_guard_ready",
        "p14600_security_compliance_freeze_ready",
        "ready_for_p14601_handoff",
        "access_mutation_allowed_now",
        "secret_read_allowed_now",
        "raw_secret_exposure_allowed",
        "destructive_delete_allowed_now",
        "incident_auto_close_allowed_now",
        "compliance_pass_enabled",
        "raw_contact_exposure_allowed",
        "raw_source_exposure_allowed",
        "enterprise_trust_claim_allowed_now",
        "production_pass_enabled",
        "enterprise_pass_enabled",
        "protected_closeout_enabled",
        "deployment_allowed_now",
        "release_approval_allowed_now",
        "write_action_allowed_now",
        "protected_action_allowed_now",
        "connector_write_enabled",
        "runtime_execution_allowed_now",
        "final_approval_ui_enabled",
        "codex_final_approval_ui_enabled",
        "claude_final_approval_ui_enabled",
        "unsafe_flag_count"
      ],
      "properties": {
        "source_product_ops_available": { "type": "boolean" },
        "source_ready_for_p14201_handoff": { "type": "boolean" },
        "source_block_visible_now": { "type": "boolean" },
        "soc2_control_signal_ready": { "type": "boolean" },
        "access_review_signal_ready": { "type": "boolean" },
        "secret_scanning_signal_ready": { "type": "boolean" },
        "prompt_injection_guard_ready": { "type": "boolean" },
        "data_retention_policy_ready": { "type": "boolean" },
        "incident_workflow_signal_ready": { "type": "boolean" },
        "compliance_evidence_link_ready": { "type": "boolean" },
        "claude_security_compliance_review_receipt_present_now": { "type": "boolean" },
        "claude_security_compliance_review_block_visible_now": { "type": "boolean" },
        "security_authority_guard_ready": { "type": "boolean" },
        "p14600_security_compliance_freeze_ready": { "type": "boolean" },
        "ready_for_p14601_handoff": { "type": "boolean" },
        "access_mutation_allowed_now": { "const": false },
        "secret_read_allowed_now": { "const": false },
        "raw_secret_exposure_allowed": { "const": false },
        "destructive_delete_allowed_now": { "const": false },
        "incident_auto_close_allowed_now": { "const": false },
        "compliance_pass_enabled": { "const": false },
        "raw_contact_exposure_allowed": { "const": false },
        "raw_source_exposure_allowed": { "const": false },
        "enterprise_trust_claim_allowed_now": { "const": false },
        "production_pass_enabled": { "const": false },
        "enterprise_pass_enabled": { "const": false },
        "protected_closeout_enabled": { "const": false },
        "deployment_allowed_now": { "const": false },
        "release_approval_allowed_now": { "const": false },
        "write_action_allowed_now": { "const": false },
        "protected_action_allowed_now": { "const": false },
        "connector_write_enabled": { "const": false },
        "runtime_execution_allowed_now": { "const": false },
        "final_approval_ui_enabled": { "const": false },
        "codex_final_approval_ui_enabled": { "const": false },
        "claude_final_approval_ui_enabled": { "const": false },
        "unsafe_flag_count": { "const": 0 }
      }
    },
    "validation": {
      "type": "object",
      "required": ["valid", "error_count", "errors"],
      "properties": {
        "valid": { "type": "boolean" },
        "error_count": { "type": "integer", "minimum": 0 },
        "errors": { "type": "array" }
      }
    },
    "summary": {
      "type": "object",
      "required": [
        "security_compliance_maturity_status",
        "program_range",
        "source_ready_for_p14201_handoff",
        "source_block_visible_now",
        "soc2_control_signal_row_count",
        "access_review_signal_row_count",
        "secret_scanning_signal_row_count",
        "prompt_injection_guard_row_count",
        "data_retention_policy_row_count",
        "incident_workflow_signal_row_count",
        "compliance_evidence_link_row_count",
        "claude_security_compliance_review_receipt_present_now",
        "claude_security_compliance_review_block_visible_now",
        "p14600_security_compliance_freeze_ready",
        "ready_for_p14601_handoff",
        "access_mutation_allowed_now",
        "secret_read_allowed_now",
        "raw_secret_exposure_allowed",
        "destructive_delete_allowed_now",
        "incident_auto_close_allowed_now",
        "compliance_pass_enabled",
        "production_pass_enabled",
        "enterprise_trust_claim_allowed_now",
        "validation_error_count"
      ],
      "properties": {
        "security_compliance_maturity_status": {
          "enum": [
            "ready_for_security_compliance_maturity",
            "blocked_security_compliance_maturity"
          ]
        },
        "program_range": { "const": "P14201-P14600" },
        "source_ready_for_p14201_handoff": { "type": "boolean" },
        "source_block_visible_now": { "type": "boolean" },
        "soc2_control_signal_row_count": { "type": "integer", "minimum": 6 },
        "access_review_signal_row_count": { "type": "integer", "minimum": 6 },
        "secret_scanning_signal_row_count": { "type": "integer", "minimum": 6 },
        "prompt_injection_guard_row_count": { "type": "integer", "minimum": 6 },
        "data_retention_policy_row_count": { "type": "integer", "minimum": 6 },
        "incident_workflow_signal_row_count": { "type": "integer", "minimum": 6 },
        "compliance_evidence_link_row_count": { "type": "integer", "minimum": 6 },
        "claude_security_compliance_review_receipt_present_now": { "type": "boolean" },
        "claude_security_compliance_review_block_visible_now": { "type": "boolean" },
        "p14600_security_compliance_freeze_ready": { "type": "boolean" },
        "ready_for_p14601_handoff": { "type": "boolean" },
        "access_mutation_allowed_now": { "const": false },
        "secret_read_allowed_now": { "const": false },
        "raw_secret_exposure_allowed": { "const": false },
        "destructive_delete_allowed_now": { "const": false },
        "incident_auto_close_allowed_now": { "const": false },
        "compliance_pass_enabled": { "const": false },
        "production_pass_enabled": { "const": false },
        "enterprise_trust_claim_allowed_now": { "const": false }
      }
    }
  },
  "$defs": {
    "verdictRow": {
      "type": "object",
      "required": [
        "row_id",
        "category",
        "label",
        "required",
        "observed",
        "evidence_ref",
        "current_verdict"
      ],
      "properties": {
        "row_id": { "type": "string", "minLength": 1 },
        "category": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "required": { "type": "boolean" },
        "observed": { "type": "boolean" },
        "evidence_ref": { "type": "string", "minLength": 1 },
        "current_verdict": { "enum": ["pass", "blocked"] },
        "block_reason": { "type": ["string", "null"] }
      }
    }
  }
}
