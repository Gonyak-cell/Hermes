{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "creative-document-freeze.schema.json",
  "title": "Creative Document Freeze",
  "type": "object",
  "required": [
    "schema_version",
    "creative_document_freeze_status",
    "creative_document_freeze_sources",
    "creative_document_freeze_paths",
    "creative_document_freeze_gates",
    "creative_document_freeze_boundary",
    "creative_document_freeze_checkpoints",
    "validation_items",
    "validation",
    "summary"
  ],
  "properties": {
    "schema_version": { "const": "creative-document-freeze.v1" },
    "creative_document_freeze_status": { "const": "complete" },
    "creative_document_freeze_sources": {
      "type": "array",
      "minItems": 13,
      "items": {
        "type": "object",
        "required": ["source_id", "phase_slot", "source_status", "validation_error_count", "client_facing_ready", "source_contract_hash"],
        "properties": {
          "source_id": { "type": "string" },
          "phase_slot": { "type": "string" },
          "source_status": { "const": "complete" },
          "validation_error_count": { "const": 0 },
          "client_facing_ready": { "const": false },
          "source_contract_hash": { "type": "string", "pattern": "^sha256:" }
        }
      }
    },
    "creative_document_freeze_paths": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": ["path_id", "path_status", "render_gate_passed", "layout_gate_passed", "content_gate_passed", "approval_gate_passed", "human_review_required", "client_facing_ready"],
        "properties": {
          "path_id": { "type": "string" },
          "path_status": { "const": "passed" },
          "render_gate_passed": { "const": true },
          "layout_gate_passed": { "const": true },
          "content_gate_passed": { "const": true },
          "approval_gate_passed": { "const": true },
          "human_review_required": { "const": true },
          "client_facing_ready": { "const": false }
        }
      }
    },
    "creative_document_freeze_gates": {
      "type": "array",
      "minItems": 6,
      "items": {
        "type": "object",
        "required": ["gate_id", "gate_status", "human_review_required", "client_facing_ready"],
        "properties": {
          "gate_id": { "type": "string" },
          "gate_status": { "const": "passed" },
          "human_review_required": { "const": true },
          "client_facing_ready": { "const": false }
        }
      }
    },
    "creative_document_freeze_boundary": {
      "type": "object",
      "required": [
        "boundary_status",
        "read_only",
        "freeze_report_only",
        "source_artifact_mutation_allowed",
        "delivery_execution_performed",
        "protected_action_executed",
        "legal_advice_generated",
        "client_facing_output_generated",
        "client_facing_ready_count"
      ],
      "properties": {
        "boundary_status": { "const": "enforced" },
        "read_only": { "const": true },
        "freeze_report_only": { "const": true },
        "source_artifact_mutation_allowed": { "const": false },
        "delivery_execution_performed": { "const": false },
        "protected_action_executed": { "const": false },
        "legal_advice_generated": { "const": false },
        "client_facing_output_generated": { "const": false },
        "client_facing_ready_count": { "const": 0 }
      }
    },
    "creative_document_freeze_checkpoints": {
      "type": "array",
      "minItems": 10,
      "items": {
        "type": "object",
        "required": ["checkpoint_id", "status"],
        "properties": {
          "checkpoint_id": { "type": "string" },
          "status": { "const": "passed" }
        }
      }
    },
    "validation_items": {
      "type": "array",
      "minItems": 10,
      "items": {
        "type": "object",
        "required": ["status"],
        "properties": {
          "status": { "const": "passed" }
        }
      }
    },
    "validation": {
      "type": "object",
      "required": ["valid", "failed_count"],
      "properties": {
        "valid": { "const": true },
        "failed_count": { "const": 0 }
      }
    },
    "summary": {
      "type": "object",
      "required": [
        "creative_document_freeze_status",
        "source_count",
        "passed_source_count",
        "path_count",
        "passed_path_count",
        "gate_count",
        "passed_gate_count",
        "failed_checkpoint_count",
        "validation_error_count",
        "legal_advice_generated",
        "client_facing_output_generated",
        "client_facing_ready_count"
      ],
      "properties": {
        "creative_document_freeze_status": { "const": "complete" },
        "source_count": { "const": 13 },
        "passed_source_count": { "const": 13 },
        "path_count": { "const": 3 },
        "passed_path_count": { "const": 3 },
        "gate_count": { "type": "integer", "minimum": 6 },
        "passed_gate_count": { "type": "integer", "minimum": 6 },
        "failed_checkpoint_count": { "const": 0 },
        "validation_error_count": { "const": 0 },
        "legal_advice_generated": { "const": false },
        "client_facing_output_generated": { "const": false },
        "client_facing_ready_count": { "const": 0 }
      }
    }
  }
}
