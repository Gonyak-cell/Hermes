        "ready_for_p11401_handoff",
        "ready_for_p11801_handoff",
        "unsafe_flag_count"
      ],
      "properties": {
        "source_global_ui_contract_ready": { "const": true },
        "source_ready_for_p11201_handoff": { "const": true },
        "global_ui_design_foundation_ready": { "const": true },
        "design_tokens_ready": { "const": true },
        "table_list_primitives_ready": { "const": true },
        "detail_inspector_primitives_ready": { "const": true },
        "timeline_primitives_ready": { "const": true },
        "boundary_notice_receipt_ready": { "const": true },
        "readiness_rule_matrix_ready": { "const": true },
        "review_evidence_trace_ready": { "const": true },
        "component_state_matrix_ready": { "const": true },
        "ui_smoke_fixture_plan_ready": { "const": true },
        "raw_body_exposure_allowed": { "const": false },
        "secret_key_exposure_allowed": { "const": false },
        "write_control_enabled": { "const": false },
        "protected_action_enabled": { "const": false },
        "final_approval_ui_enabled": { "const": false },
        "codex_final_approval_ui_enabled": { "const": false },
        "claude_final_approval_ui_enabled": { "const": false },
        "production_pass_ui_enabled": { "const": false },
        "enterprise_pass_ui_enabled": { "const": false },
        "domain_pack_product_identity_enabled": { "const": false },
        "scorecard_kpi_enabled": { "const": false },
        "review_trace_final_approval_enabled": { "const": false },
        "p11401_operator_queue_ui_handoff_ready": { "const": true },
        "p11800_design_system_freeze_ready": { "const": false },
        "ready_for_p11401_handoff": { "const": true },
        "ready_for_p11801_handoff": { "const": false },
        "unsafe_flag_count": { "const": 0 }
      }
    },
    "validation": {
      "type": "object",
      "required": ["valid", "error_count", "errors"],
      "properties": {
        "valid": { "type": "boolean" },
        "error_count": { "type": "integer", "minimum": 0 },
        "errors": { "type": "array" }
      }
    },
    "summary": {
      "type": "object",
      "required": [
        "global_ui_design_foundation_status",
        "program_range",
        "source_program_range",
        "design_system_range",
        "source_ready_for_p11201_handoff",
        "phase_count",
        "token_count",
        "component_state_count",
        "ready_for_p11401_handoff",
        "ready_for_p11801_handoff",
        "p11800_design_system_freeze_ready",
        "raw_body_exposure_allowed",
        "secret_key_exposure_allowed",
        "write_control_enabled",
        "protected_action_enabled",
        "final_approval_ui_enabled",
        "codex_final_approval_ui_enabled",
        "claude_final_approval_ui_enabled",
        "production_pass_ui_enabled",
        "enterprise_pass_ui_enabled",
        "validation_error_count"
      ],
      "properties": {
        "global_ui_design_foundation_status": {
          "enum": [
            "ready_for_global_ui_design_foundation",
            "blocked_global_ui_design_foundation"
          ]
        },
        "program_range": { "const": "P11201-P11400" },
        "source_program_range": { "const": "P11001-P11200" },
        "design_system_range": { "const": "P10801-P11800" },
        "source_ready_for_p11201_handoff": { "const": true },
        "phase_count": { "const": 10 },
        "token_count": { "const": 8 },
        "component_state_count": { "const": 10 },
        "ready_for_p11401_handoff": { "const": true },
        "ready_for_p11801_handoff": { "const": false },
        "p11800_design_system_freeze_ready": { "const": false },
        "raw_body_exposure_allowed": { "const": false },
        "secret_key_exposure_allowed": { "const": false },
        "write_control_enabled": { "const": false },
        "protected_action_enabled": { "const": false },
        "final_approval_ui_enabled": { "const": false },
        "codex_final_approval_ui_enabled": { "const": false },
        "claude_final_approval_ui_enabled": { "const": false },
        "production_pass_ui_enabled": { "const": false },
        "enterprise_pass_ui_enabled": { "const": false }
      }
    }
