{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hermes.local/schemas/agent-bridge-manifest.schema.json",
  "title": "Hermes Agent Bridge Manifest",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "capability_id",
    "program_range",
    "source_status",
    "agent_bridge_contract",
    "capability_state_lattice_rows",
    "authority_namespace_rows",
    "provenance_source_rows",
    "runtime_identity_rows",
    "capability_inventory_rows",
    "permission_matrix_rows",
    "protected_action_classifier_rows",
    "command_canonicalization_fixture_rows",
    "redaction_policy_rows",
    "malicious_manifest_fixture_rows",
    "adapter_package_provenance_rows",
    "agent_bridge_boundary",
    "validation_items",
    "validation",
    "summary"
  ],
  "properties": {
    "schema_version": { "const": "agent-bridge-manifest.v1" },
    "capability_id": { "const": "platform.agent_bridge_manifest" },
    "program_range": { "const": "AGENT-BRIDGE-L0-L4-SLICE-A" },
    "source_status": {
      "type": "object",
      "required": [
        "schema_source",
        "package_json_source",
        "plan_doc_source",
        "review_receipt_source",
        "package_script_registered"
      ],
      "properties": {
        "package_script_registered": { "type": "boolean" }
      }
    },
    "agent_bridge_contract": {
      "type": "object",
      "required": [
        "contract_id",
        "local_only",
        "read_only",
        "source_of_truth",
        "request_queue_enabled_now",
        "receipt_intake_enabled_now",
        "controlled_execution_candidate_enabled_now",
        "desktop_mutation_allowed",
        "agent_runtime_execution_allowed_now",
        "command_execution_allowed_now",
        "shell_execution_allowed_now",
        "git_write_allowed_now",
        "deploy_allowed_now",
        "approval_application_allowed_now",
        "receipt_application_allowed_now",
        "connector_write_allowed_now",
        "secret_read_allowed_now",
        "raw_source_exposure_allowed",
        "production_pass_enabled",
        "enterprise_pass_enabled",
        "protected_closeout_enabled",
        "agent_final_pass_allowed_now",
        "model_label_is_proof",
