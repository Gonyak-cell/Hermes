{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hermes.local/schemas/answer-capture-spec-state-machine.schema.json",
  "title": "Hermes Answer Capture Spec State Machine",
  "type": "object",
  "required": [
    "schema_version",
    "generated_at",
    "capability_id",
    "program_range",
    "source_program_range",
    "answer_capture_spec_state_machine_phase_rows",
    "p32000_source_binding_rows",
    "answer_capture_contract_rows",
    "spec_state_machine_rows",
    "answer_redaction_boundary_rows",
    "state_transition_validator_rows",
    "no_seed_synthesis_boundary_rows",
    "p32400_clean_checkpoint_rows",
    "answer_capture_spec_state_machine_boundary",
    "answer_capture_spec_state_machine_validation_items",
    "summary",
    "validation"
  ],
  "properties": {
    "schema_version": { "const": "answer-capture-spec-state-machine.v1" },
    "generated_at": { "type": "string", "format": "date-time" },
    "capability_id": { "const": "platform.answer_capture_spec_state_machine" },
    "program_range": { "const": "P32001-P32400" },
    "source_program_range": { "const": "P31601-P32000" },
    "answer_capture_spec_state_machine_phase_rows": { "type": "array", "minItems": 7, "items": { "$ref": "#/$defs/verdictRow" } },
    "p32000_source_binding_rows": { "type": "array", "minItems": 12, "items": { "$ref": "#/$defs/verdictRow" } },
    "answer_capture_contract_rows": { "type": "array", "minItems": 3, "items": { "$ref": "#/$defs/verdictRow" } },
    "spec_state_machine_rows": { "type": "array", "minItems": 12, "items": { "$ref": "#/$defs/verdictRow" } },
    "answer_redaction_boundary_rows": { "type": "array", "minItems": 3, "items": { "$ref": "#/$defs/verdictRow" } },
    "state_transition_validator_rows": { "type": "array", "minItems": 12, "items": { "$ref": "#/$defs/verdictRow" } },
    "no_seed_synthesis_boundary_rows": { "type": "array", "minItems": 300, "items": { "$ref": "#/$defs/verdictRow" } },
    "p32400_clean_checkpoint_rows": { "type": "array", "minItems": 8, "items": { "$ref": "#/$defs/verdictRow" } },
    "answer_capture_spec_state_machine_validation_items": { "type": "array", "minItems": 15, "items": { "$ref": "#/$defs/validationItem" } },
    "summary": {
      "type": "object",
      "required": [
        "answer_capture_spec_state_machine_status",
        "source_p32000_ready_for_answer_capture",
        "answer_capture_contract_count",
        "spec_state_machine_count",
        "answer_redaction_boundary_count",
        "state_transition_validator_count",
        "answer_receipt_present_count",
        "seed_synthesis_candidate_count",
        "ready_for_seed_readiness_gate",
        "answer_capture_live_answer_capture_allowed_now",
        "answer_capture_raw_answer_persist_allowed_now",
        "answer_capture_raw_answer_exposure_allowed_now",
        "answer_capture_seed_synthesis_allowed_now",
        "answer_capture_runtime_execution_allowed_now",
        "answer_capture_write_action_allowed_now",
        "answer_capture_protected_action_allowed_now",
        "answer_capture_final_approval_allowed_now",
        "answer_capture_production_pass_allowed_now",
        "production_pass_enabled"
      ],
      "properties": {
        "answer_capture_spec_state_machine_status": {
          "enum": [
            "ready_for_answer_capture_spec_state_machine",
            "valid_block_answer_capture_spec_state_machine_pending",
            "blocked_answer_capture_spec_state_machine"
          ]
        },
        "source_p32000_ready_for_answer_capture": { "type": "boolean" },
        "answer_capture_contract_count": { "type": "number" },
        "spec_state_machine_count": { "type": "number" },
        "answer_redaction_boundary_count": { "type": "number" },
        "state_transition_validator_count": { "type": "number" },
        "answer_receipt_present_count": { "const": 0 },
        "seed_synthesis_candidate_count": { "const": 0 },
        "ready_for_seed_readiness_gate": { "type": "boolean" },
        "answer_capture_live_answer_capture_allowed_now": { "const": false },
        "answer_capture_raw_answer_persist_allowed_now": { "const": false },
        "answer_capture_raw_answer_exposure_allowed_now": { "const": false },
        "answer_capture_seed_synthesis_allowed_now": { "const": false },
        "answer_capture_runtime_execution_allowed_now": { "const": false },
        "answer_capture_write_action_allowed_now": { "const": false },
        "answer_capture_protected_action_allowed_now": { "const": false },
        "answer_capture_final_approval_allowed_now": { "const": false },
        "answer_capture_production_pass_allowed_now": { "const": false },
        "production_pass_enabled": { "const": false },
        "enterprise_trust_claim_allowed_now": { "const": false },
        "validation_error_count": { "type": "number" }
      }
    },
    "answer_capture_spec_state_machine_boundary": {
      "type": "object",
      "required": [
        "p32400_contract_ready",
        "ready_for_seed_readiness_gate",
        "source_p32000_ready_for_answer_capture",
        "answer_capture_contract_visible_now",
        "spec_state_machine_visible_now",
        "answer_redaction_boundary_visible_now",
        "state_transition_validator_visible_now",
        "no_seed_synthesis_boundary_closed_now",
        "answer_capture_contract_count",
        "answer_receipt_present_count",
        "seed_synthesis_candidate_count",
        "answer_capture_live_answer_capture_allowed_now",
        "answer_capture_raw_answer_persist_allowed_now",
        "answer_capture_raw_answer_exposure_allowed_now",
        "answer_capture_seed_synthesis_allowed_now",
        "answer_capture_runtime_execution_allowed_now",
        "answer_capture_write_action_allowed_now",
        "answer_capture_protected_action_allowed_now",
        "answer_capture_final_approval_allowed_now",
        "answer_capture_production_pass_allowed_now"
      ],
      "properties": {
        "p32400_contract_ready": { "type": "boolean" },
        "ready_for_seed_readiness_gate": { "type": "boolean" },
        "source_p32000_ready_for_answer_capture": { "type": "boolean" },
        "source_validation_valid_now": { "type": "boolean" },
        "answer_capture_contract_visible_now": { "type": "boolean" },
        "spec_state_machine_visible_now": { "type": "boolean" },
        "answer_redaction_boundary_visible_now": { "type": "boolean" },
        "state_transition_validator_visible_now": { "type": "boolean" },
        "no_seed_synthesis_boundary_closed_now": { "type": "boolean" },
        "answer_capture_contract_count": { "type": "number" },
        "spec_state_machine_count": { "type": "number" },
        "answer_redaction_boundary_count": { "type": "number" },
        "state_transition_validator_count": { "type": "number" },
        "answer_receipt_present_count": { "const": 0 },
        "seed_synthesis_candidate_count": { "const": 0 },
        "answer_capture_live_answer_capture_allowed_now": { "const": false },
        "answer_capture_raw_answer_persist_allowed_now": { "const": false },
        "answer_capture_raw_answer_exposure_allowed_now": { "const": false },
        "answer_capture_seed_synthesis_allowed_now": { "const": false },
        "answer_capture_seed_auto_apply_allowed_now": { "const": false },
        "answer_capture_runtime_execution_allowed_now": { "const": false },
        "answer_capture_write_action_allowed_now": { "const": false },
        "answer_capture_protected_action_allowed_now": { "const": false },
        "answer_capture_connector_write_allowed_now": { "const": false },
        "answer_capture_deployment_allowed_now": { "const": false },
        "answer_capture_review_completion_allowed_now": { "const": false },
        "answer_capture_final_approval_allowed_now": { "const": false },
        "answer_capture_production_pass_allowed_now": { "const": false },
        "answer_capture_enterprise_trust_claim_allowed_now": { "const": false },
        "answer_capture_secret_read_allowed_now": { "const": false },
        "answer_capture_human_gate_bypass_allowed_now": { "const": false },
        "answer_capture_independent_review_bypass_allowed_now": { "const": false },
        "answer_capture_final_automated_approval_allowed_now": { "const": false },
        "production_pass_enabled": { "const": false },
        "enterprise_trust_claim_allowed_now": { "const": false }
      }
    },
    "validation": {
      "type": "object",
      "required": ["valid", "error_count", "errors"],
      "properties": {
        "valid": { "type": "boolean" },
        "error_count": { "type": "number" },
        "errors": { "type": "array" }
      }
    }
  },
  "$defs": {
    "verdictRow": {
      "type": "object",
      "required": ["row_id", "category", "label", "observed", "current_verdict", "block_reason", "evidence_ref"],
      "properties": {
        "row_id": { "type": "string" },
        "category": { "type": "string" },
        "label": { "type": "string" },
        "observed": { "type": "boolean" },
        "current_verdict": { "enum": ["pass", "block"] },
        "block_reason": { "type": ["string", "null"] },
        "evidence_ref": { "type": ["string", "null"] },
        "generated_at": { "type": "string" }
      },
      "additionalProperties": true
    },
    "validationItem": {
      "allOf": [{ "$ref": "#/$defs/verdictRow" }]
    }
  }
}
