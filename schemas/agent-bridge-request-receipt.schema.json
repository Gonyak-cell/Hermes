        "secret_read_allowed_now",
        "raw_source_exposure_allowed",
        "production_pass_enabled",
        "enterprise_pass_enabled",
        "protected_closeout_enabled",
        "agent_final_pass_allowed_now"
      ],
      "properties": {
        "contract_id": { "const": "contract.hermes.agent_bridge_request_receipt.local_only" },
        "local_only": { "const": true },
        "read_only": { "const": true },
        "source_of_truth": { "const": false },
        "request_queue_enabled_now": { "const": true },
        "request_packet_generation_allowed_now": { "const": true },
        "receipt_intake_enabled_now": { "const": true },
        "receipt_normalization_allowed_now": { "const": true },
        "execution_allowed_now": { "const": false },
        "receipt_application_allowed_now": { "const": false },
        "request_transport_submission_allowed_now": { "const": false },
        "raw_prompt_storage_allowed": { "const": false },
        "raw_receipt_storage_allowed": { "const": false },
        "provider_output_authoritative": { "const": false },
        "desktop_mutation_allowed": { "const": false },
        "agent_runtime_execution_allowed_now": { "const": false },
        "command_execution_allowed_now": { "const": false },
        "shell_execution_allowed_now": { "const": false },
        "git_write_allowed_now": { "const": false },
        "deploy_allowed_now": { "const": false },
        "approval_application_allowed_now": { "const": false },
        "receipt_application_allowed_now": { "const": false },
        "connector_write_allowed_now": { "const": false },
        "secret_read_allowed_now": { "const": false },
        "raw_source_exposure_allowed": { "const": false },
        "production_pass_enabled": { "const": false },
        "enterprise_pass_enabled": { "const": false },
        "protected_closeout_enabled": { "const": false },
        "agent_final_pass_allowed_now": { "const": false }
      }
    },
    "agent_task_request_queue_rows": {
      "type": "array",
      "minItems": 4,
      "items": { "$ref": "#/$defs/requestRow" }
    },
    "agent_request_lifecycle_rows": {
      "type": "array",
      "minItems": 6,
      "items": { "$ref": "#/$defs/verdictRow" }
    },
    "agent_receipt_intake_rows": {
      "type": "array",
      "minItems": 4,
      "items": { "$ref": "#/$defs/receiptRow" }
    },
    "agent_evidence_binding_rows": {
      "type": "array",
      "minItems": 4,
      "items": { "$ref": "#/$defs/verdictRow" }
    },
    "malicious_request_fixture_rows": {
      "type": "array",
      "minItems": 8,
      "items": { "$ref": "#/$defs/verdictRow" }
    },
    "malicious_receipt_fixture_rows": {
      "type": "array",
      "minItems": 9,
      "items": { "$ref": "#/$defs/verdictRow" }
    },
    "agent_request_receipt_gate_rows": {
      "type": "array",
      "minItems": 11,
      "items": { "$ref": "#/$defs/verdictRow" }
    },
    "agent_request_receipt_boundary": {
      "type": "object",
      "required": [
        "ready_for_desktop_agents_projection",
        "local_only",
        "read_only",
        "source_of_truth",
        "request_queue_enabled_now",
        "receipt_intake_enabled_now",
        "request_transport_submission_allowed_now",
        "execution_allowed_now",
        "command_executed_now",
        "mutation_performed",
        "receipt_application_allowed_now",
        "approval_application_allowed_now",
        "raw_prompt_storage_allowed",
        "raw_receipt_storage_allowed",
        "provider_output_authoritative",
        "desktop_mutation_allowed",
        "agent_runtime_execution_allowed_now",
        "command_execution_allowed_now",
        "shell_execution_allowed_now",
        "git_write_allowed_now",
        "deploy_allowed_now",
        "connector_write_allowed_now",
        "secret_read_allowed_now",
        "raw_source_exposure_allowed",
        "production_pass_enabled",
        "enterprise_pass_enabled",
        "protected_closeout_enabled",
        "agent_final_pass_allowed_now",
        "unsafe_flag_count"
      ],
      "properties": {
        "ready_for_desktop_agents_projection": { "type": "boolean" },
        "local_only": { "const": true },
        "read_only": { "const": true },
        "source_of_truth": { "const": false },
        "request_queue_enabled_now": { "const": true },
        "receipt_intake_enabled_now": { "const": true },
        "request_transport_submission_allowed_now": { "const": false },
        "execution_allowed_now": { "const": false },
        "command_executed_now": { "const": false },
        "mutation_performed": { "const": false },
        "receipt_application_allowed_now": { "const": false },
        "approval_application_allowed_now": { "const": false },
        "raw_prompt_storage_allowed": { "const": false },
        "raw_receipt_storage_allowed": { "const": false },
        "provider_output_authoritative": { "const": false },
        "desktop_mutation_allowed": { "const": false },
        "agent_runtime_execution_allowed_now": { "const": false },
        "command_execution_allowed_now": { "const": false },
        "shell_execution_allowed_now": { "const": false },
        "git_write_allowed_now": { "const": false },
        "deploy_allowed_now": { "const": false },
        "connector_write_allowed_now": { "const": false },
        "secret_read_allowed_now": { "const": false },
        "raw_source_exposure_allowed": { "const": false },
        "production_pass_enabled": { "const": false },
        "enterprise_pass_enabled": { "const": false },
        "protected_closeout_enabled": { "const": false },
        "agent_final_pass_allowed_now": { "const": false },
        "unsafe_flag_count": { "const": 0 }
      }
    },
    "validation": {
      "type": "object",
      "required": ["valid", "item_count", "error_count", "errors"],
      "properties": {
        "valid": { "type": "boolean" },
        "item_count": { "type": "integer", "minimum": 0 },
        "error_count": { "type": "integer", "minimum": 0 },
        "errors": { "type": "array" }
      }
    },
    "summary": {
      "type": "object",
      "required": [
        "agent_bridge_request_receipt_status",
        "request_count",
        "receipt_count",
        "evidence_binding_count",
        "request_queue_enabled_now",
        "receipt_intake_enabled_now",
        "request_transport_submission_allowed_now",
        "execution_allowed_now",
        "command_executed_now",
        "mutation_performed",
        "receipt_application_allowed_now",
        "approval_application_allowed_now",
        "raw_prompt_storage_allowed",
        "raw_receipt_storage_allowed",
        "provider_output_authoritative",
        "local_only",
        "read_only",
        "source_of_truth",
        "desktop_mutation_allowed",
        "agent_runtime_execution_allowed_now",
        "command_execution_allowed_now",
        "shell_execution_allowed_now",
        "git_write_allowed_now",
        "deploy_allowed_now",
        "connector_write_allowed_now",
        "secret_read_allowed_now",
