{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/ldd-vdr-inventory.schema.json",
  "title": "Hermes LDD VDR Inventory",
  "type": "object",
  "required": [
    "schema_version",
    "generated_at",
    "ldd_vdr_inventory_id",
    "ldd_vdr_inventory_status",
    "safe_handling",
    "inputs",
    "source_contracts",
    "ldd_vdr_inventory_contract",
    "ldd_vdr_batches",
    "ldd_vdr_folder_records",
    "ldd_vdr_file_records",
    "ldd_vdr_version_records",
    "ldd_vdr_missing_data_records",
    "ldd_vdr_matter_summaries",
    "ldd_vdr_inventory_desktop_boundary",
    "ldd_vdr_inventory_checkpoints",
    "validation_items",
    "validation",
    "summary"
  ],
  "properties": {
    "schema_version": { "const": "ldd-vdr-inventory.v1" },
    "generated_at": { "type": "string", "minLength": 1 },
    "ldd_vdr_inventory_id": { "type": "string", "minLength": 1 },
    "output_dir": { "type": "string" },
    "ldd_vdr_inventory_status": { "enum": ["complete", "blocked"] },
    "safe_handling": { "$ref": "#/$defs/safe_handling" },
    "inputs": { "type": "object" },
    "source_contracts": { "type": "object" },
    "ldd_vdr_inventory_contract": { "$ref": "#/$defs/contract" },
    "ldd_vdr_batches": { "type": "array", "items": { "$ref": "#/$defs/batch" } },
    "ldd_vdr_folder_records": { "type": "array", "items": { "$ref": "#/$defs/folder" } },
    "ldd_vdr_file_records": { "type": "array", "items": { "$ref": "#/$defs/file" } },
    "ldd_vdr_version_records": { "type": "array", "items": { "$ref": "#/$defs/version" } },
    "ldd_vdr_missing_data_records": { "type": "array", "items": { "$ref": "#/$defs/missing_data" } },
    "ldd_vdr_matter_summaries": { "type": "array", "items": { "$ref": "#/$defs/matter_summary" } },
    "ldd_vdr_inventory_desktop_boundary": { "$ref": "#/$defs/desktop_boundary" },
    "ldd_vdr_inventory_checkpoints": { "type": "array", "items": { "$ref": "#/$defs/checkpoint" } },
    "validation_items": { "type": "array", "items": { "$ref": "#/$defs/validation_item" } },
    "validation": { "$ref": "#/$defs/validation" },
    "summary": { "$ref": "#/$defs/summary" }
  },
  "$defs": {
    "safe_handling": {
      "type": "object",
      "required": [
        "report_only",
        "legal_advice_provided",
        "client_facing_output_generated",
        "attorney_review_required",
        "human_review_required",
        "external_vdr_access_performed",
        "matter_data_write_allowed",
        "task_state_write_allowed",
        "workflow_transition_allowed",
        "runtime_execution_performed",
        "delivery_execution_performed",
        "desktop_mutation_allowed",
        "desktop_source_of_truth",
        "protected_mutation_executed",
        "secret_material_exposed",
        "provider_key_visible"
      ],
      "properties": {
        "report_only": { "const": true },
        "legal_advice_provided": { "const": false },
        "client_facing_output_generated": { "const": false },
        "attorney_review_required": { "const": true },
        "human_review_required": { "const": true },
        "external_vdr_access_performed": { "const": false },
        "matter_data_write_allowed": { "const": false },
        "task_state_write_allowed": { "const": false },
        "workflow_transition_allowed": { "const": false },
        "runtime_execution_performed": { "const": false },
        "delivery_execution_performed": { "const": false },
        "desktop_mutation_allowed": { "const": false },
        "desktop_source_of_truth": { "const": false },
        "protected_mutation_executed": { "const": false },
        "secret_material_exposed": { "const": false },
        "provider_key_visible": { "const": false }
      }
    },
    "contract": {
      "type": "object",
      "required": [
        "schema_version",
        "contract_id",
        "source_of_truth",
        "batch_rule",
        "folder_rule",
        "file_rule",
        "version_rule",
        "missing_data_rule",
        "attorney_review_rule",
        "desktop_companion_rule",
        "mutation_policy",
        "created_at"
      ],
      "properties": {
        "schema_version": { "const": "ldd-vdr-inventory-contract.v1" },
        "contract_id": { "const": "ldd-vdr-inventory.v1" },
        "source_of_truth": { "const": "matter_source_register_vdr_requests_documents_and_resource_version_ledger" },
        "batch_rule": { "type": "string" },
        "folder_rule": { "type": "string" },
        "file_rule": { "type": "string" },
        "version_rule": { "type": "string" },
        "missing_data_rule": { "type": "string" },
        "attorney_review_rule": { "type": "string" },
        "desktop_companion_rule": { "type": "string" },
        "mutation_policy": { "type": "string" },
        "created_at": { "type": "string" }
      }
    },
    "batch": {
      "type": "object",
      "required": [
        "schema_version",
        "ldd_vdr_batch_id",
        "matter_id",
        "source_register_id",
        "source_system",
        "classification",
        "batch_status",
        "attorney_review_required",
        "human_review_required",
        "client_facing_ready"
      ],
      "properties": {
        "schema_version": { "const": "ldd-vdr-batch.v1" },
        "ldd_vdr_batch_id": { "type": "string", "minLength": 1 },
        "matter_id": { "type": "string", "minLength": 1 },
        "source_register_id": { "type": "string", "minLength": 1 },
        "source_system": { "const": "vdr" },
        "classification": { "type": "string", "minLength": 1 },
        "batch_status": { "enum": ["inventory_attention_required", "inventory_ready_for_review"] },
        "attorney_review_required": { "const": true },
        "human_review_required": { "const": true },
        "client_facing_ready": { "const": false }
      }
    },
    "folder": {
      "type": "object",
      "required": [
        "schema_version",
        "ldd_vdr_folder_record_id",
        "ldd_vdr_batch_id",
        "matter_id",
        "folder_key",
        "folder_path",
        "folder_status",
        "document_count",
        "received_file_count",
        "missing_data_count"
      ],
      "properties": {
        "schema_version": { "const": "ldd-vdr-folder-record.v1" },
        "ldd_vdr_folder_record_id": { "type": "string", "minLength": 1 },
        "ldd_vdr_batch_id": { "type": "string", "minLength": 1 },
        "matter_id": { "type": "string", "minLength": 1 },
        "folder_key": { "type": "string", "minLength": 1 },
        "folder_path": { "type": "string", "minLength": 1 },
        "folder_status": { "enum": ["attention_required", "ready_for_review"] },
        "document_count": { "type": "integer", "minimum": 0 },
        "received_file_count": { "type": "integer", "minimum": 0 },
        "missing_data_count": { "type": "integer", "minimum": 0 }
      }
    },
    "file": {
      "type": "object",
      "required": [
        "schema_version",
        "ldd_vdr_file_record_id",
        "ldd_vdr_batch_id",
        "matter_id",
        "folder_key",
        "source_record_id",
        "source_collection",
        "file_title",
        "document_status",
        "inventory_file_status",
        "version_count",
        "content_hash",
        "attorney_review_required",
        "human_review_required",
        "client_facing_ready"
      ],
      "properties": {
        "schema_version": { "const": "ldd-vdr-file-record.v1" },
        "ldd_vdr_file_record_id": { "type": "string", "minLength": 1 },
        "ldd_vdr_batch_id": { "type": "string", "minLength": 1 },
        "matter_id": { "type": "string", "minLength": 1 },
        "folder_key": { "type": "string", "minLength": 1 },
        "source_record_id": { "type": "string", "minLength": 1 },
        "source_collection": { "type": "string", "minLength": 1 },
        "file_title": { "type": "string", "minLength": 1 },
        "document_status": { "type": "string", "minLength": 1 },
        "inventory_file_status": { "const": "ready_for_attorney_review" },
        "version_count": { "type": "integer", "minimum": 1 },
        "content_hash": { "type": "string", "pattern": "^sha256:" },
        "attorney_review_required": { "const": true },
        "human_review_required": { "const": true },
        "client_facing_ready": { "const": false }
      }
    },
    "version": {
      "type": "object",
      "required": [
        "schema_version",
        "ldd_vdr_version_record_id",
        "ldd_vdr_file_record_id",
        "ldd_vdr_batch_id",
        "matter_id",
        "version_label",
        "version_status",
        "content_hash",
        "resource_version_ledger_bound",
        "attorney_review_required",
        "human_review_required"
      ],
      "properties": {
        "schema_version": { "const": "ldd-vdr-version-record.v1" },
        "ldd_vdr_version_record_id": { "type": "string", "minLength": 1 },
        "ldd_vdr_file_record_id": { "type": "string", "minLength": 1 },
        "ldd_vdr_batch_id": { "type": "string", "minLength": 1 },
        "matter_id": { "type": "string", "minLength": 1 },
        "version_label": { "type": "string", "minLength": 1 },
        "version_status": { "const": "current" },
        "content_hash": { "type": "string", "pattern": "^sha256:" },
        "resource_version_ledger_bound": { "type": "boolean" },
        "attorney_review_required": { "const": true },
        "human_review_required": { "const": true }
      }
    },
    "missing_data": {
      "type": "object",
      "required": [
        "schema_version",
        "ldd_vdr_missing_data_record_id",
        "ldd_vdr_batch_id",
        "matter_id",
        "source_record_id",
        "source_collection",
        "missing_title",
        "missing_status",
        "missing_data_status",
        "absence_not_factual_nonexistence",
        "rfi_candidate",
        "attorney_review_required",
        "human_review_required",
        "client_facing_ready"
      ],
      "properties": {
        "schema_version": { "const": "ldd-vdr-missing-data-record.v1" },
        "ldd_vdr_missing_data_record_id": { "type": "string", "minLength": 1 },
        "ldd_vdr_batch_id": { "type": "string", "minLength": 1 },
        "matter_id": { "type": "string", "minLength": 1 },
        "source_record_id": { "type": "string", "minLength": 1 },
        "source_collection": { "type": "string", "minLength": 1 },
        "missing_title": { "type": "string", "minLength": 1 },
        "missing_status": { "enum": ["missing", "requested"] },
        "missing_data_status": { "const": "follow_up_required" },
        "absence_not_factual_nonexistence": { "const": true },
        "rfi_candidate": { "const": true },
        "attorney_review_required": { "const": true },
        "human_review_required": { "const": true },
        "client_facing_ready": { "const": false }
      }
    },
    "matter_summary": {
      "type": "object",
      "required": [
        "schema_version",
        "ldd_vdr_matter_summary_id",
        "matter_id",
        "ldd_vdr_matter_status",
        "batch_count",
        "folder_record_count",
        "file_record_count",
        "version_record_count",
        "missing_data_record_count",
        "attorney_review_required",
        "human_review_required",
        "client_facing_ready"
      ],
      "properties": {
        "schema_version": { "const": "ldd-vdr-matter-summary.v1" },
        "ldd_vdr_matter_summary_id": { "type": "string", "minLength": 1 },
        "matter_id": { "type": "string", "minLength": 1 },
        "ldd_vdr_matter_status": { "enum": ["attention_required", "ready_for_review"] },
        "batch_count": { "type": "integer", "minimum": 0 },
        "folder_record_count": { "type": "integer", "minimum": 0 },
        "file_record_count": { "type": "integer", "minimum": 0 },
        "version_record_count": { "type": "integer", "minimum": 0 },
        "missing_data_record_count": { "type": "integer", "minimum": 0 },
        "attorney_review_required": { "const": true },
        "human_review_required": { "const": true },
        "client_facing_ready": { "const": false }
      }
    },
    "desktop_boundary": {
      "type": "object",
      "required": [
        "schema_version",
        "boundary_status",
        "read_only",
        "desktop_mutation_allowed",
        "desktop_source_of_truth",
        "matter_data_write_allowed",
        "task_state_write_allowed",
        "workflow_transition_allowed",
        "runtime_execution_allowed",
        "delivery_execution_allowed",
        "protected_action_allowed",
        "client_facing_output_allowed_without_attorney_review"
      ],
      "properties": {
        "schema_version": { "const": "ldd-vdr-inventory-desktop-boundary.v1" },
        "boundary_status": { "const": "enforced" },
        "read_only": { "const": true },
        "desktop_mutation_allowed": { "const": false },
        "desktop_source_of_truth": { "const": false },
        "matter_data_write_allowed": { "const": false },
        "task_state_write_allowed": { "const": false },
        "workflow_transition_allowed": { "const": false },
        "runtime_execution_allowed": { "const": false },
        "delivery_execution_allowed": { "const": false },
        "protected_action_allowed": { "const": false },
        "client_facing_output_allowed_without_attorney_review": { "const": false }
      }
    },
    "checkpoint": {
      "type": "object",
      "required": ["checkpoint_id", "status", "message"],
      "properties": {
        "checkpoint_id": { "type": "string", "minLength": 1 },
        "status": { "enum": ["passed", "failed"] },
        "message": { "type": "string" }
      }
    },
    "validation_item": {
      "type": "object",
      "required": ["path", "check_id", "status", "message"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "check_id": { "type": "string", "minLength": 1 },
        "status": { "enum": ["passed", "failed"] },
        "message": { "type": "string" }
      }
    },
    "validation": {
      "type": "object",
      "required": ["valid", "items", "errors"],
      "properties": {
        "valid": { "type": "boolean" },
        "items": { "type": "array" },
        "errors": { "type": "array" }
      }
    },
    "summary": {
      "type": "object",
      "required": [
        "ldd_vdr_inventory_status",
        "ldd_vdr_inventory_contract_id",
        "source_of_truth",
        "batch_count",
        "folder_record_count",
        "file_record_count",
        "version_record_count",
        "missing_data_record_count",
        "rfi_candidate_count",
        "legal_advice_provided",
        "client_facing_output_generated",
        "desktop_boundary_status",
        "desktop_read_only",
        "desktop_mutation_allowed",
        "matter_data_write_allowed",
        "task_state_write_allowed",
        "workflow_transition_allowed",
        "runtime_execution_allowed",
        "delivery_execution_allowed",
        "protected_action_allowed",
        "failed_checkpoint_count",
        "validation_error_count"
      ],
      "properties": {
        "ldd_vdr_inventory_status": { "enum": ["complete", "blocked"] },
        "ldd_vdr_inventory_contract_id": { "const": "ldd-vdr-inventory.v1" },
        "source_of_truth": { "const": "matter_source_register_vdr_requests_documents_and_resource_version_ledger" },
        "batch_count": { "type": "integer", "minimum": 1 },
        "folder_record_count": { "type": "integer", "minimum": 1 },
        "file_record_count": { "type": "integer", "minimum": 1 },
        "version_record_count": { "type": "integer", "minimum": 1 },
        "missing_data_record_count": { "type": "integer", "minimum": 1 },
        "rfi_candidate_count": { "type": "integer", "minimum": 1 },
        "legal_advice_provided": { "const": false },
        "client_facing_output_generated": { "const": false },
        "desktop_boundary_status": { "const": "enforced" },
        "desktop_read_only": { "const": true },
        "desktop_mutation_allowed": { "const": false },
        "matter_data_write_allowed": { "const": false },
        "task_state_write_allowed": { "const": false },
        "workflow_transition_allowed": { "const": false },
        "runtime_execution_allowed": { "const": false },
        "delivery_execution_allowed": { "const": false },
        "protected_action_allowed": { "const": false },
        "failed_checkpoint_count": { "const": 0 },
        "validation_error_count": { "const": 0 }
      }
    }
  }
}
