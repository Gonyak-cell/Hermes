        "zendd_safe_patch_lane_status": { "const": "ready_for_zendd_safe_patch_lane" },
        "source_work_order_intake_status": { "const": "ready_for_zendd_work_order_intake" },
        "source_integration_setup_status": { "const": "ready_for_project_zendd_boundary" },
        "selected_integration_mode": { "const": "external_project_adapter" },
        "safe_patch_lane_ready": { "const": true },
        "patch_candidate_review_allowed": { "const": true },
        "file_write_executed_now": { "const": false },
        "automatic_patch_allowed_now": { "const": false },
        "command_execution_allowed_now": { "const": false },
        "raw_material_copy_allowed_now": { "const": false },
        "secret_read_allowed_now": { "const": false },
        "protected_action_execution_allowed": { "const": false },
        "validation_error_count": { "type": "integer", "minimum": 0 }
