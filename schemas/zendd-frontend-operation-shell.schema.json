{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hermes.local/schemas/zendd-frontend-operation-shell.schema.json",
  "title": "Zendd Frontend Operation Shell",
  "type": "object",
  "required": [
    "schema_version",
    "generated_at",
    "zendd_frontend_operation_shell_id",
    "capability_id",
    "output_dir",
    "inputs",
    "frontend_operation_anchor",
    "physical_integration_summary",
    "phase_plan_rows",
    "design_token_rows",
    "operation_contract_rows",
    "frontend_shell_rows",
    "route_surface_rows",
    "protected_mutation_block_rows",
    "frontend_operation_closeout_rows",
    "frontend_operation_gate_rows",
    "validation_items",
    "validation",
    "summary"
  ],
  "properties": {
    "schema_version": { "const": "zendd-frontend-operation-shell.v1" },
    "generated_at": { "type": "string", "format": "date-time" },
    "zendd_frontend_operation_shell_id": { "type": "string", "minLength": 1 },
    "capability_id": { "const": "project.zendd.frontend_operation_shell" },
    "output_dir": { "type": "string" },
    "inputs": {
      "type": "object",
      "required": ["schema_path", "package_path", "integration_phase_ledger_path", "development_phase_ledger_path", "design_tokens_path", "zendd_project_root"],
      "additionalProperties": true
    },
    "frontend_operation_anchor": {
      "type": "object",
      "required": ["schema_version", "phase_range", "phase_slot", "previous_phase_slot", "next_phase_slot", "command_name", "source_physical_integration_status"],
      "properties": {
        "schema_version": { "const": "zendd-frontend-operation-anchor.v1" },
        "phase_range": { "const": "P761-P780" },
        "phase_slot": { "const": "P761" },
        "previous_phase_slot": { "const": "P760" },
        "next_phase_slot": { "const": "P781" },
        "command_name": { "const": "project:zendd-frontend-operation-shell" },
        "source_physical_integration_status": { "const": "external_adapter_selected_for_safe_operation" }
      },
      "additionalProperties": true
    },
    "phase_plan_rows": {
      "type": "array",
      "minItems": 12,
      "items": {
        "type": "object",
        "required": ["schema_version", "phase_range", "phase_title", "phase_status", "operator_surface_ref", "safety_boundary", "next_allowed_action"],
        "properties": {
          "schema_version": { "const": "zendd-development-phase-plan-row.v1" },
          "phase_range": { "type": "string", "pattern": "^P[0-9]{3,4}-P[0-9]{3,4}$" },
          "operator_surface_ref": { "type": "string", "minLength": 1 },
          "next_allowed_action": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": true
      }
    },
    "design_token_rows": {
      "type": "array",
      "minItems": 20,
      "items": {
        "type": "object",
        "required": ["schema_version", "token_id", "token_group", "theme", "token_name", "token_value", "source_design_ref", "normalized", "ui_safe"],
        "properties": {
          "schema_version": { "const": "hermes-operator-design-token-row.v1" },
          "token_id": { "type": "string", "minLength": 1 },
          "token_group": { "enum": ["color", "spacing", "radius", "typography"] },
          "theme": { "type": "string", "minLength": 1 },
          "token_name": { "type": "string", "minLength": 1 },
          "token_value": { "type": "string", "minLength": 1 },
          "normalized": { "type": "boolean" },
          "ui_safe": { "const": true }
        },
        "additionalProperties": true
      }
    },
    "operation_contract_rows": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "required": ["schema_version", "row_id", "phase_slot", "project_id", "operation_surface", "surface_status", "read_only", "evidence_ref", "reviewer_ref", "current_verdict", "responsible_owner", "next_allowed_action"],
        "properties": {
          "schema_version": { "const": "zendd-operation-contract-row.v1" },
          "project_id": { "const": "project.zendd" },
          "read_only": { "const": true },
          "current_verdict": { "enum": ["pass", "blocked"] },
          "next_allowed_action": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": true
      }
    },
    "frontend_shell_rows": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "required": ["schema_version", "row_id", "phase_slot", "shell_surface", "shell_status", "artifact_ref", "read_only", "mutation_allowed", "next_allowed_action"],
        "properties": {
          "schema_version": { "const": "zendd-frontend-shell-row.v1" },
          "read_only": { "const": true },
          "mutation_allowed": { "const": false }
        },
        "additionalProperties": true
      }
    },
    "route_surface_rows": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "required": ["schema_version", "row_id", "phase_slot", "route_path", "route_type", "read_only", "server_started", "protected_action_execution_allowed", "next_allowed_action"],
        "properties": {
          "schema_version": { "const": "zendd-route-surface-row.v1" },
          "read_only": { "const": true },
          "server_started": { "const": false },
          "protected_action_execution_allowed": { "const": false }
        },
        "additionalProperties": true
      }
    },
    "protected_mutation_block_rows": {
      "type": "array",
      "minItems": 7,
      "items": {
        "type": "object",
        "required": ["schema_version", "row_id", "phase_slot", "protected_action", "current_verdict", "block_reason", "responsible_owner", "rollback_target_ref", "human_receipt_required", "next_allowed_action"],
        "properties": {
          "schema_version": { "const": "zendd-protected-mutation-block-row.v1" },
          "current_verdict": { "const": "blocked" },
          "human_receipt_required": { "type": "boolean" }
        },
        "additionalProperties": true
      }
    },
    "frontend_operation_closeout_rows": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "type": "object",
        "required": ["schema_version", "phase_slot", "closeout_status", "static_shell_ready", "external_adapter_active", "physical_code_move_allowed_now", "zendd_mutation_allowed_now", "raw_material_copy_allowed_now", "protected_action_execution_allowed", "next_integration_phase_slot", "next_allowed_action"],
        "properties": {
          "schema_version": { "const": "zendd-frontend-operation-closeout-row.v1" },
          "phase_slot": { "const": "P780" },
          "closeout_status": { "const": "ready_for_zendd_frontend_operation_shell" },
          "static_shell_ready": { "const": true },
          "external_adapter_active": { "const": true },
          "physical_code_move_allowed_now": { "const": false },
          "zendd_mutation_allowed_now": { "const": false },
          "raw_material_copy_allowed_now": { "const": false },
          "protected_action_execution_allowed": { "const": false },
          "next_integration_phase_slot": { "const": "P781" }
        },
        "additionalProperties": true
      }
    },
    "frontend_operation_gate_rows": {
      "type": "array",
      "minItems": 10,
      "items": {
        "type": "object",
        "required": ["schema_version", "gate_id", "phase_slot", "gate_status", "message", "next_allowed_action"],
        "properties": {
          "schema_version": { "const": "zendd-frontend-operation-gate-row.v1" },
          "gate_status": { "enum": ["pass", "blocked"] }
        },
        "additionalProperties": true
      }
    },
    "validation_items": { "type": "array" },
    "validation": {
      "type": "object",
      "required": ["valid", "errors"],
      "properties": {
        "valid": { "type": "boolean" },
        "errors": { "type": "array" }
      },
      "additionalProperties": true
    },
    "summary": {
      "type": "object",
      "required": ["phase_range", "phase_slot", "next_phase_slot", "command_name", "zendd_frontend_operation_shell_status", "selected_integration_mode", "design_token_row_count", "phase_plan_row_count", "route_surface_row_count", "protected_mutation_block_count", "static_shell_ready", "physical_code_move_allowed_now", "zendd_mutation_allowed_now", "raw_material_copy_allowed_now", "protected_action_execution_allowed", "validation_error_count"],
      "properties": {
        "phase_range": { "const": "P761-P780" },
        "phase_slot": { "const": "P761" },
        "next_phase_slot": { "const": "P781" },
        "command_name": { "const": "project:zendd-frontend-operation-shell" },
        "zendd_frontend_operation_shell_status": { "const": "ready_for_zendd_frontend_operation_shell" },
        "selected_integration_mode": { "const": "external_project_adapter" },
        "static_shell_ready": { "const": true },
        "physical_code_move_allowed_now": { "const": false },
        "zendd_mutation_allowed_now": { "const": false },
        "raw_material_copy_allowed_now": { "const": false },
        "protected_action_execution_allowed": { "const": false },
        "validation_error_count": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
