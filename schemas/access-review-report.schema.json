{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/hermes-law-firm-harness/access-review-report.schema.json",
  "title": "Access Review Report",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "generated_at",
    "access_review_report_id",
    "capability_id",
    "source_statuses",
    "access_review_contract",
    "access_review_subjects",
    "access_review_matter_rows",
    "access_review_resource_rows",
    "access_review_findings",
    "access_review_gate_results",
    "access_review_boundary",
    "validation_items",
    "validation",
    "summary"
  ],
  "properties": {
    "schema_version": { "const": "access-review-report.v1" },
    "generated_at": { "type": "string" },
    "access_review_report_id": { "type": "string", "minLength": 1 },
    "capability_id": { "const": "compliance.access_review_report" },
    "source_statuses": {
      "type": "array",
      "minItems": 6,
      "items": { "$ref": "#/$defs/source_status" }
    },
    "access_review_contract": { "$ref": "#/$defs/access_review_contract" },
    "access_review_subjects": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/access_review_subject" }
    },
    "access_review_matter_rows": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/access_review_matter_row" }
    },
    "access_review_resource_rows": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/access_review_resource_row" }
    },
    "access_review_findings": {
      "type": "array",
      "minItems": 8,
      "items": { "$ref": "#/$defs/access_review_finding" }
    },
    "access_review_gate_results": {
      "type": "array",
      "minItems": 10,
      "items": { "$ref": "#/$defs/access_review_gate_result" }
    },
    "access_review_boundary": { "$ref": "#/$defs/access_review_boundary" },
    "validation_items": {
      "type": "array",
      "items": { "$ref": "#/$defs/validation_item" }
    },
    "validation": {
      "type": "object",
      "required": ["valid", "errors"],
      "properties": {
        "valid": { "const": true },
        "errors": { "type": "array", "maxItems": 0 }
      }
    },
    "summary": { "$ref": "#/$defs/summary" }
  },
  "$defs": {
    "source_status": {
      "type": "object",
      "additionalProperties": true,
      "required": ["source_id", "source_available", "expected_status", "actual_status", "source_status"],
      "properties": {
        "source_id": { "type": "string" },
        "source_available": { "const": true },
        "expected_status": { "type": "string" },
        "actual_status": { "type": "string" },
        "source_status": { "const": "passed" }
      }
    },
    "access_review_contract": {
      "type": "object",
      "additionalProperties": true,
      "required": ["contract_status", "capability_id", "phase_slot", "previous_phase_slot", "next_phase_slot", "review_dimensions", "mutation_allowed", "human_review_required", "client_facing_ready"],
      "properties": {
        "contract_status": { "const": "active" },
        "capability_id": { "const": "compliance.access_review_report" },
        "phase_slot": { "const": "P302" },
        "previous_phase_slot": { "const": "P301" },
        "next_phase_slot": { "const": "P303" },
        "review_dimensions": {
          "type": "array",
          "contains": { "const": "tenant_id" }
        },
        "mutation_allowed": { "const": false },
        "human_review_required": { "const": true },
        "client_facing_ready": { "const": false }
      }
    },
    "access_review_subject": {
      "type": "object",
      "additionalProperties": true,
      "required": ["tenant_id", "matter_id", "user_id", "runtime_id", "access_review_status", "human_review_required", "client_facing_ready"],
      "properties": {
        "tenant_id": { "type": "string", "minLength": 1 },
        "matter_id": { "type": "string", "minLength": 1 },
        "user_id": { "type": "string", "minLength": 1 },
        "runtime_id": { "type": "string", "minLength": 1 },
        "access_review_status": { "const": "review_ready" },
        "human_review_required": { "type": "boolean" },
        "client_facing_ready": { "const": false }
      }
    },
    "access_review_matter_row": {
      "type": "object",
      "additionalProperties": true,
      "required": ["tenant_id", "matter_id", "user_id", "runtime_id", "access_decision", "view_status", "can_retrieve", "requires_human_review", "client_facing_ready"],
      "properties": {
        "tenant_id": { "type": "string", "minLength": 1 },
        "matter_id": { "type": "string", "minLength": 1 },
        "user_id": { "type": "string", "minLength": 1 },
        "runtime_id": { "type": "string", "minLength": 1 },
        "access_decision": { "enum": ["allow", "review", "deny"] },
        "view_status": { "enum": ["view_allowed", "view_requires_human_confirmation", "view_denied"] },
        "can_retrieve": { "type": "boolean" },
        "requires_human_review": { "type": "boolean" },
        "client_facing_ready": { "const": false }
      }
    },
    "access_review_resource_row": {
      "type": "object",
      "additionalProperties": true,
      "required": ["tenant_id", "matter_id", "resource_id", "access_review_status", "can_retrieve_count", "human_review_required", "client_facing_ready"],
      "properties": {
        "tenant_id": { "type": "string", "minLength": 1 },
        "matter_id": { "type": "string", "minLength": 1 },
        "resource_id": { "type": "string", "minLength": 1 },
        "access_review_status": { "const": "review_ready" },
        "can_retrieve_count": { "type": "integer", "minimum": 0 },
        "human_review_required": { "type": "boolean" },
        "client_facing_ready": { "const": false }
      }
    },
    "access_review_finding": {
      "type": "object",
      "additionalProperties": true,
      "required": ["finding_id", "observed_count", "violation_count", "finding_status", "human_review_required", "client_facing_ready"],
      "properties": {
        "finding_id": { "type": "string", "minLength": 1 },
        "observed_count": { "type": "integer", "minimum": 0 },
        "violation_count": { "const": 0 },
        "finding_status": { "const": "passed" },
        "human_review_required": { "const": true },
        "client_facing_ready": { "const": false }
      }
    },
    "access_review_gate_result": {
      "type": "object",
      "additionalProperties": true,
      "required": ["gate_id", "violation_count", "gate_decision", "gate_fail_on_violation", "access_mutation_allowed", "permission_change_allowed", "human_review_required", "client_facing_ready", "gate_status"],
      "properties": {
        "gate_id": { "type": "string", "minLength": 1 },
        "violation_count": { "const": 0 },
        "gate_decision": { "const": "hold_for_access_review" },
        "gate_fail_on_violation": { "const": true },
        "access_mutation_allowed": { "const": false },
        "permission_change_allowed": { "const": false },
        "human_review_required": { "const": true },
        "client_facing_ready": { "const": false },
        "gate_status": { "const": "passed" }
      }
    },
    "access_review_boundary": {
      "type": "object",
      "additionalProperties": true,
      "required": ["boundary_status", "read_only", "access_review_report_only", "source_content_read_performed", "source_ingest_performed", "permission_mutation_performed", "access_grant_performed", "access_revoke_performed", "source_mutation_performed", "external_transfer_performed", "network_access_performed", "route_execution_performed", "server_started", "protected_action_executed", "legal_advice_generated", "client_facing_output_generated", "human_review_required", "client_facing_ready", "windows_baseline_stability_preserved", "mac_windows_completion_instability_guard"],
      "properties": {
        "boundary_status": { "const": "enforced" },
        "read_only": { "const": true },
        "access_review_report_only": { "const": true },
        "source_content_read_performed": { "const": false },
        "source_ingest_performed": { "const": false },
        "permission_mutation_performed": { "const": false },
        "access_grant_performed": { "const": false },
        "access_revoke_performed": { "const": false },
        "source_mutation_performed": { "const": false },
        "external_transfer_performed": { "const": false },
        "network_access_performed": { "const": false },
        "route_execution_performed": { "const": false },
        "server_started": { "const": false },
        "protected_action_executed": { "const": false },
        "legal_advice_generated": { "const": false },
        "client_facing_output_generated": { "const": false },
        "human_review_required": { "const": true },
        "client_facing_ready": { "const": false },
        "windows_baseline_stability_preserved": { "const": true },
        "mac_windows_completion_instability_guard": { "const": true }
      }
    },
    "validation_item": {
      "type": "object",
      "additionalProperties": true,
      "required": ["path", "check_id", "status", "message"],
      "properties": {
        "path": { "type": "string" },
        "check_id": { "type": "string" },
        "status": { "const": "passed" },
        "message": { "type": "string" }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": true,
      "required": ["access_review_report_status", "capability_id", "phase_slot", "previous_phase_slot", "next_phase_slot", "subject_review_count", "matter_access_row_count", "resource_access_row_count", "tenant_count", "matter_count", "user_count", "review_without_human_gate_count", "denied_retrievable_count", "external_runtime_retrievable_count", "missing_retrieval_filter_count", "read_only", "access_review_report_only", "permission_mutation_performed", "access_grant_performed", "access_revoke_performed", "source_mutation_performed", "external_transfer_performed", "network_access_performed", "route_execution_performed", "server_started", "protected_action_executed", "legal_advice_generated", "client_facing_output_generated", "human_review_required", "client_facing_ready", "windows_baseline_stability_preserved", "mac_windows_completion_instability_guard", "validation_error_count"],
      "properties": {
        "access_review_report_status": { "const": "complete" },
        "capability_id": { "const": "compliance.access_review_report" },
        "phase_slot": { "const": "P302" },
        "previous_phase_slot": { "const": "P301" },
        "next_phase_slot": { "const": "P303" },
        "subject_review_count": { "type": "integer", "minimum": 1 },
        "matter_access_row_count": { "type": "integer", "minimum": 1 },
        "resource_access_row_count": { "type": "integer", "minimum": 1 },
        "tenant_count": { "type": "integer", "minimum": 1 },
        "matter_count": { "type": "integer", "minimum": 1 },
        "user_count": { "type": "integer", "minimum": 1 },
        "review_without_human_gate_count": { "const": 0 },
        "denied_retrievable_count": { "const": 0 },
        "external_runtime_retrievable_count": { "const": 0 },
        "missing_retrieval_filter_count": { "const": 0 },
        "read_only": { "const": true },
        "access_review_report_only": { "const": true },
        "permission_mutation_performed": { "const": false },
        "access_grant_performed": { "const": false },
        "access_revoke_performed": { "const": false },
        "source_mutation_performed": { "const": false },
        "external_transfer_performed": { "const": false },
        "network_access_performed": { "const": false },
        "route_execution_performed": { "const": false },
        "server_started": { "const": false },
        "protected_action_executed": { "const": false },
        "legal_advice_generated": { "const": false },
        "client_facing_output_generated": { "const": false },
        "human_review_required": { "const": true },
        "client_facing_ready": { "const": false },
        "windows_baseline_stability_preserved": { "const": true },
        "mac_windows_completion_instability_guard": { "const": true },
        "validation_error_count": { "const": 0 }
      }
    }
  }
}
