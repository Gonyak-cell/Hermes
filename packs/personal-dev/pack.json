{
  "schema_version": "domain-pack-manifest.v1",
  "pack_id": "personal-dev",
  "pack_version": "0.1.0",
  "display_name": "Personal Development Pack",
  "description": "Project management, Claude Code/Codex planning, worktree isolation, testing, diff review, and merge approval workflows.",
  "enabled": true,
  "core_compatibility": {
    "min_core_version": "0.1.0"
  },
  "capabilities": [
    {
      "capability_id": "personal_dev.codex.worktree_patch",
      "version": "0.1.0",
      "path": "../../examples/core/capabilities/personal-dev-codex-worktree.json"
    }
  ],
  "policies": [
    {
      "policy_id": "personal_dev.policy.worktree_isolation",
      "description": "Claude Code and Codex runs must use isolated worktrees and produce untrusted diffs until gates pass."
    }
  ],
  "schemas": [
    "schemas/core/workflow-runtime.schema.json",
    "schemas/core/governance-output.schema.json",
    "schemas/dev-projects.schema.json"
  ],
  "workflows": [
    "workflow.personal_dev.codex.worktree_patch.v1",
    "workflow.personal_dev.plan_reconcile.v1"
  ],
  "gates": [
    "classification_gate",
    "tool_permission_gate",
    "protected_file_gate",
    "diff_review_gate",
    "test_gate",
    "human_approval_gate"
  ],
  "templates": [
    "templates/personal-dev/pr-draft.md",
    "templates/personal-dev/review-summary.md"
  ],
  "extractors": [
    "extractor.personal_dev.repo_profile.v1"
  ],
  "renderers": [
    "renderer.personal_dev.pr_draft.v1"
  ],
  "migrations": [],
  "golden_cases": [
    "golden.personal_dev.codex.patch.simple"
  ],
  "dependencies": [
    {
      "pack_id": "common",
      "version": "0.1.0"
    }
  ],
  "permissions": {
    "max_classification": "P1_INTERNAL",
    "external_model_policy": "allowed_with_audit",
    "allowed_runtimes": ["harness", "codex", "claude_code", "local_script", "manual"],
    "default_output_status": "draft"
  },
  "metadata": {
    "agent_outputs_trusted": false,
    "merge_requires_gate": true
  }
}
