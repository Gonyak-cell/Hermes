{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hermes.local/schemas/test_artifact.schema.json",
  "title": "test_artifact",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "test_artifact_id",
    "execution_request_id",
    "test_policy_id",
    "started_at",
    "status",
    "test_command_allowed",
    "network_allowed"
  ],
  "properties": {
    "schema_version": {
      "const": "test_artifact.v1"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "payload_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "test_artifact_id": {
      "type": "string",
      "pattern": "^ta_[A-Za-z0-9_-]+$"
    },
    "execution_request_id": {
      "type": "string"
    },
    "test_policy_id": {
      "type": "string"
    },
    "test_command_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "test_output_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "ended_at": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "type": "string",
      "enum": [
        "passed",
        "failed",
        "blocked",
        "skipped"
      ]
    },
    "commands": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "failures": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "test_command_allowed": {
      "type": "boolean"
    },
    "network_allowed": {
      "type": "boolean",
      "const": false
    }
  },
  "x-forbidden-fields": [
    "install_command",
    "deploy_command",
    "secret_output"
  ],
  "x-validation-invariants": [
    "only allowlisted tests",
    "test failure cannot be silently ignored",
    "skipped tests require reason"
  ]
}
