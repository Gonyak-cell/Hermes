{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hermes.local/schemas/zendd-physical-integration-decision.schema.json",
  "title": "Zendd Physical Integration Decision",
  "type": "object",
  "required": [
    "schema_version",
    "generated_at",
    "zendd_physical_integration_decision_id",
    "capability_id",
    "output_dir",
    "inputs",
    "physical_integration_decision_anchor",
    "protected_action_rollback_summary",
    "physical_integration_policy",
    "integration_option_rows",
    "evidence_comparison_rows",
    "physical_movement_block_rows",
    "operating_mode_rows",
    "next_action_rows",
    "physical_integration_closeout_rows",
    "physical_integration_gate_rows",
    "validation_items",
    "validation",
    "summary"
  ],
  "properties": {
    "schema_version": { "const": "zendd-physical-integration-decision.v1" },
    "generated_at": { "type": "string", "format": "date-time" },
    "zendd_physical_integration_decision_id": { "type": "string", "minLength": 1 },
    "capability_id": { "const": "project.zendd.physical_integration_decision" },
    "output_dir": { "type": "string" },
    "inputs": {
      "type": "object",
      "required": ["schema_path", "phase_ledger_path", "package_path", "zendd_project_root"],
      "additionalProperties": true
    },
    "physical_integration_decision_anchor": {
      "type": "object",
      "required": ["schema_version", "phase_range", "phase_slot", "previous_phase_slot", "next_phase_slot", "command_name", "protected_action_rollback_command_name", "source_protected_action_rollback_status"],
      "properties": {
        "schema_version": { "const": "zendd-physical-integration-decision-anchor.v1" },
        "phase_range": { "const": "P741-P760" },
        "phase_slot": { "const": "P741" },
        "previous_phase_slot": { "const": "P740" },
        "next_phase_slot": { "const": "P761" },
        "command_name": { "const": "project:zendd-physical-integration-decision" },
        "protected_action_rollback_command_name": { "const": "project:zendd-protected-action-rollback" },
        "source_protected_action_rollback_status": { "const": "ready_for_physical_integration_decision" }
      },
      "additionalProperties": true
    },
    "physical_integration_policy": {
      "type": "object",
      "required": ["schema_version", "phase_slot", "selected_integration_mode", "physical_code_move_allowed_now", "subtree_allowed_now", "submodule_allowed_now", "workspace_move_allowed_now", "monorepo_directory_move_allowed_now", "raw_project_copy_allowed_now", "external_adapter_write_allowed_now", "selected_mode_requires", "rejected_modes_require", "next_allowed_action"],
      "properties": {
        "schema_version": { "const": "zendd-physical-integration-policy.v1" },
        "phase_slot": { "const": "P741" },
        "selected_integration_mode": { "const": "external_project_adapter" },
        "physical_code_move_allowed_now": { "const": false },
        "subtree_allowed_now": { "const": false },
        "submodule_allowed_now": { "const": false },
        "workspace_move_allowed_now": { "const": false },
        "monorepo_directory_move_allowed_now": { "const": false },
        "raw_project_copy_allowed_now": { "const": false },
        "external_adapter_write_allowed_now": { "const": false },
        "selected_mode_requires": { "type": "array", "minItems": 5 },
        "rejected_modes_require": { "type": "array", "minItems": 3 },
        "next_allowed_action": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": true
    },
    "integration_option_rows": {
      "type": "array",
      "minItems": 7,
      "items": {
        "type": "object",
        "required": ["schema_version", "phase_slot", "row_id", "project_id", "integration_mode", "selected", "decision_verdict", "protected_action_rollback_ref", "boundary_evidence_ref", "rollback_target_ref", "hard_gate_ref", "reviewer_ref", "physical_code_move_required", "physical_code_move_allowed_now", "current_verdict", "responsible_owner", "next_allowed_action"],
        "properties": {
          "schema_version": { "const": "zendd-integration-option-row.v1" },
          "project_id": { "const": "project.zendd" },
          "decision_verdict": { "enum": ["pass", "blocked"] },
          "physical_code_move_allowed_now": { "const": false },
          "next_allowed_action": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": true
      }
    },
    "evidence_comparison_rows": {
      "type": "array",
      "minItems": 6,
      "items": {
        "type": "object",
        "required": ["schema_version", "phase_slot", "row_id", "project_id", "comparison_factor", "selected_integration_mode", "selected_mode_evidence_ref", "protected_action_rollback_ref", "comparison_status", "message", "next_allowed_action"],
        "properties": {
          "schema_version": { "const": "zendd-evidence-comparison-row.v1" },
          "comparison_status": { "const": "pass" }
        },
        "additionalProperties": true
      }
    },
    "physical_movement_block_rows": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "required": ["schema_version", "phase_slot", "row_id", "project_id", "integration_mode", "option_ref", "movement_or_mutation_allowed_now", "physical_code_move_allowed_now", "raw_project_copy_allowed_now", "receipt_required", "rollback_target_ref", "current_verdict", "block_reason", "responsible_owner", "next_allowed_action"],
        "properties": {
          "schema_version": { "const": "zendd-physical-movement-block-row.v1" },
          "movement_or_mutation_allowed_now": { "const": false },
          "physical_code_move_allowed_now": { "const": false },
          "raw_project_copy_allowed_now": { "const": false },
          "receipt_required": { "const": true },
          "current_verdict": { "const": "blocked" }
        },
        "additionalProperties": true
      }
    },
    "operating_mode_rows": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "type": "object",
        "required": ["schema_version", "phase_slot", "row_id", "project_id", "selected_integration_mode", "operating_mode_status", "protected_action_rollback_ref", "external_adapter_active", "hermes_controls_zendd_by_reference", "zendd_code_directory_moved", "raw_project_copy_allowed_now", "protected_work_orders_required_for_mutation", "operator_next_action_ref", "next_allowed_action"],
        "properties": {
          "schema_version": { "const": "zendd-operating-mode-row.v1" },
          "selected_integration_mode": { "const": "external_project_adapter" },
          "external_adapter_active": { "const": true },
          "hermes_controls_zendd_by_reference": { "const": true },
          "zendd_code_directory_moved": { "const": false },
          "raw_project_copy_allowed_now": { "const": false },
          "protected_work_orders_required_for_mutation": { "const": true }
        },
        "additionalProperties": true
      }
    },
    "next_action_rows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["schema_version", "phase_slot", "row_id", "project_id", "source_type", "source_ref", "queue_status", "responsible_owner", "next_allowed_action", "physical_code_move_allowed_now"],
        "properties": {
          "schema_version": { "const": "zendd-physical-integration-next-action-row.v1" },
          "physical_code_move_allowed_now": { "const": false }
        },
        "additionalProperties": true
      }
    },
    "physical_integration_closeout_rows": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "type": "object",
        "required": ["schema_version", "phase_slot", "row_id", "project_id", "closeout_status", "selected_integration_mode", "integration_option_row_count", "blocked_movement_option_count", "evidence_comparison_row_count", "operating_mode_row_count", "next_action_row_count", "physical_code_move_allowed_now", "subtree_allowed_now", "submodule_allowed_now", "workspace_move_allowed_now", "monorepo_directory_move_allowed_now", "raw_project_copy_allowed_now", "external_adapter_selected", "pass_promoted_for_physical_move", "next_integration_phase_slot", "next_allowed_action", "read_only"],
        "properties": {
          "schema_version": { "const": "zendd-physical-integration-closeout-row.v1" },
          "phase_slot": { "const": "P760" },
          "closeout_status": { "const": "ready_for_external_adapter_operation" },
          "selected_integration_mode": { "const": "external_project_adapter" },
          "physical_code_move_allowed_now": { "const": false },
          "subtree_allowed_now": { "const": false },
          "submodule_allowed_now": { "const": false },
          "workspace_move_allowed_now": { "const": false },
          "monorepo_directory_move_allowed_now": { "const": false },
          "raw_project_copy_allowed_now": { "const": false },
          "external_adapter_selected": { "const": true },
          "pass_promoted_for_physical_move": { "const": false },
          "next_integration_phase_slot": { "const": "P761" },
          "read_only": { "const": true }
        },
        "additionalProperties": true
      }
    },
    "physical_integration_gate_rows": {
      "type": "array",
      "minItems": 10,
      "items": {
        "type": "object",
        "required": ["schema_version", "gate_id", "phase_slot", "gate_status", "message", "next_allowed_action"],
        "properties": {
          "schema_version": { "const": "zendd-physical-integration-gate-row.v1" },
          "gate_status": { "enum": ["pass", "blocked"] }
        },
        "additionalProperties": true
      }
    },
    "validation_items": { "type": "array" },
    "validation": {
      "type": "object",
      "required": ["valid", "errors"],
      "properties": {
        "valid": { "type": "boolean" },
        "errors": { "type": "array" }
      },
      "additionalProperties": true
    },
    "summary": {
      "type": "object",
      "required": ["phase_range", "phase_slot", "previous_phase_slot", "next_phase_slot", "command_name", "zendd_physical_integration_decision_status", "selected_integration_mode", "integration_option_row_count", "evidence_comparison_row_count", "blocked_movement_option_count", "operating_mode_row_count", "next_action_row_count", "physical_code_move_allowed_now", "subtree_allowed_now", "submodule_allowed_now", "workspace_move_allowed_now", "monorepo_directory_move_allowed_now", "raw_project_copy_allowed_now", "external_adapter_selected", "pass_promoted_for_physical_move", "validation_error_count"],
      "properties": {
        "phase_range": { "const": "P741-P760" },
        "phase_slot": { "const": "P741" },
        "previous_phase_slot": { "const": "P740" },
        "next_phase_slot": { "const": "P761" },
        "command_name": { "const": "project:zendd-physical-integration-decision" },
        "zendd_physical_integration_decision_status": { "const": "external_adapter_selected_for_safe_operation" },
        "selected_integration_mode": { "const": "external_project_adapter" },
        "physical_code_move_allowed_now": { "const": false },
        "subtree_allowed_now": { "const": false },
        "submodule_allowed_now": { "const": false },
        "workspace_move_allowed_now": { "const": false },
        "monorepo_directory_move_allowed_now": { "const": false },
        "raw_project_copy_allowed_now": { "const": false },
        "external_adapter_selected": { "const": true },
        "pass_promoted_for_physical_move": { "const": false },
        "validation_error_count": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
