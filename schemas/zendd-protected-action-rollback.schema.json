        "phase_slot",
        "protected_action_execution_allowed_now",
        "release_command_execution_allowed_now",
        "database_migration_allowed_now",
        "client_export_allowed_now",
        "rollback_rehearsal_execution_allowed_now",
        "rollback_execution_allowed_now",
        "receipt_application_allowed_now",
        "physical_code_move_allowed_now",
        "pass_requires",
        "block_requires",
        "next_allowed_action"
