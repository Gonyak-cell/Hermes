        "ui_projection_production_pass_allowed_now": { "const": false },
        "ui_projection_enterprise_trust_claim_allowed_now": { "const": false },
        "ui_projection_secret_read_allowed_now": { "const": false },
        "ui_projection_human_gate_bypass_allowed_now": { "const": false },
        "ui_projection_independent_review_bypass_allowed_now": { "const": false },
        "ui_projection_final_automated_approval_allowed_now": { "const": false },
        "production_pass_enabled": { "const": false },
        "enterprise_trust_claim_allowed_now": { "const": false }
      }
