{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/hermes/resource-expansion-freeze.schema.json",
  "title": "Hermes Resource Expansion Freeze",
  "type": "object",
  "required": [
    "schema_version",
    "generated_at",
    "resource_expansion_freeze_id",
    "resource_expansion_freeze_status",
    "summary",
    "expansion_freeze_source_rows",
    "expansion_freeze_dry_run_rows",
    "expansion_freeze_resume_probes",
    "expansion_freeze_idempotency_probes",
    "expansion_freeze_scale_checks",
    "expansion_freeze_boundary"
  ],
  "properties": {
    "schema_version": {
      "const": "resource-expansion-freeze.v1"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "resource_expansion_freeze_id": {
      "type": "string",
      "minLength": 1
    },
    "resource_expansion_freeze_status": {
      "enum": ["complete", "attention"]
    },
    "summary": {
      "type": "object",
      "required": [
        "resource_expansion_freeze_status",
        "phase_slot",
        "previous_phase_slot",
        "next_phase_slot",
        "dry_run_scale_target_count",
        "projected_batch_count",
        "projected_item_count",
        "resumable_backfill_dry_run_verified",
        "idempotent_backfill_dry_run_verified",
        "validation_error_count"
      ],
      "properties": {
        "resource_expansion_freeze_status": {
          "enum": ["complete", "attention"]
        },
        "phase_slot": {
          "const": "P286"
        },
        "previous_phase_slot": {
          "const": "P285"
        },
        "next_phase_slot": {
          "const": "P287"
        },
        "dry_run_scale_target_count": {
          "type": "integer",
          "minimum": 2713
        },
        "projected_batch_count": {
          "type": "integer",
          "minimum": 1
        },
        "projected_item_count": {
          "type": "integer",
          "minimum": 2713
        },
        "resumable_backfill_dry_run_verified": {
          "const": true
        },
        "idempotent_backfill_dry_run_verified": {
          "const": true
        },
        "validation_error_count": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "expansion_freeze_source_rows": {
      "type": "array",
      "minItems": 10,
      "items": {
        "$ref": "#/$defs/source_row"
      }
    },
    "expansion_freeze_dry_run_rows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/dry_run_row"
      }
    },
    "expansion_freeze_resume_probes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/resume_probe"
      }
    },
    "expansion_freeze_idempotency_probes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/idempotency_probe"
      }
    },
    "expansion_freeze_scale_checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/scale_check"
      }
    },
    "expansion_freeze_boundary": {
      "type": "object",
      "required": [
        "boundary_status",
        "read_only",
        "report_only",
        "scale_projection_only",
        "backfill_dry_run_execution_performed",
        "source_ingest_performed",
        "file_content_read_performed",
        "resource_mutation_performed",
        "state_mutation_performed",
        "legal_advice_generated",
        "client_facing_output_generated"
      ],
      "properties": {
        "boundary_status": {
          "const": "enforced"
        },
        "read_only": {
          "const": true
        },
        "report_only": {
          "const": true
        },
        "scale_projection_only": {
          "const": true
        },
        "backfill_dry_run_execution_performed": {
          "const": false
        },
        "source_ingest_performed": {
          "const": false
        },
        "file_content_read_performed": {
          "const": false
        },
        "resource_mutation_performed": {
          "const": false
        },
        "state_mutation_performed": {
          "const": false
        },
        "legal_advice_generated": {
          "const": false
        },
        "client_facing_output_generated": {
          "const": false
        }
      }
    }
  },
  "$defs": {
    "source_row": {
      "type": "object",
      "required": ["source_id", "source_status", "human_review_required", "client_facing_ready"],
      "properties": {
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "source_status": {
          "enum": ["complete", "attention"]
        },
        "human_review_required": {
          "const": true
        },
        "client_facing_ready": {
          "const": false
        }
      }
    },
    "dry_run_row": {
      "type": "object",
      "required": [
        "dry_run_status",
        "projected_batch_index",
        "projected_item_count",
        "target_scale_item_count",
        "resumable",
        "idempotent",
        "backfill_execution_performed",
        "source_ingest_performed",
        "file_content_read_performed"
      ],
      "properties": {
        "dry_run_status": {
          "const": "passed"
        },
        "projected_batch_index": {
          "type": "integer",
          "minimum": 1
        },
        "projected_item_count": {
          "type": "integer",
          "minimum": 1
        },
        "target_scale_item_count": {
          "type": "integer",
          "minimum": 2713
        },
        "resumable": {
          "const": true
        },
        "idempotent": {
          "const": true
        },
        "backfill_execution_performed": {
          "const": false
        },
        "source_ingest_performed": {
          "const": false
        },
        "file_content_read_performed": {
          "const": false
        }
      }
    },
    "resume_probe": {
      "type": "object",
      "required": ["probe_key", "resume_probe_status", "human_review_required", "client_facing_ready"],
      "properties": {
        "probe_key": {
          "type": "string",
          "minLength": 1
        },
        "resume_probe_status": {
          "const": "passed"
        },
        "human_review_required": {
          "const": true
        },
        "client_facing_ready": {
          "const": false
        }
      }
    },
    "idempotency_probe": {
      "type": "object",
      "required": ["probe_key", "idempotency_probe_status", "human_review_required", "client_facing_ready"],
      "properties": {
        "probe_key": {
          "type": "string",
          "minLength": 1
        },
        "idempotency_probe_status": {
          "const": "passed"
        },
        "human_review_required": {
          "const": true
        },
        "client_facing_ready": {
          "const": false
        }
      }
    },
    "scale_check": {
      "type": "object",
      "required": ["check_key", "scale_check_status", "human_review_required", "client_facing_ready"],
      "properties": {
        "check_key": {
          "type": "string",
          "minLength": 1
        },
        "scale_check_status": {
          "const": "passed"
        },
        "human_review_required": {
          "const": true
        },
        "client_facing_ready": {
          "const": false
        }
      }
    }
  }
}
