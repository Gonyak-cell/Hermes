{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hermes.local/schemas/multi-project-saas-control-plane.schema.json",
  "title": "Hermes Multi-Project SaaS Control Plane",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "generated_at",
    "capability_id",
    "program_range",
    "source_program_range",
    "multi_project_saas_contract",
    "multi_project_saas_phase_rows",
    "p9400_source_binding_rows",
    "multi_project_api_route_rows",
    "saas_project_registry_rows",
    "saas_repo_inventory_rows",
    "current_goal_risk_rows",
    "validation_review_aggregation_rows",
    "blocker_next_action_rows",
    "domain_boundary_guard_rows",
    "operator_control_summary_rows",
    "multi_project_api_smoke_rows",
    "multi_project_browser_smoke_rows",
    "multi_project_negative_fixture_rows",
    "p9600_freeze_rows",
    "multi_project_gate_rows",
    "multi_project_saas_boundary",
    "validation_items",
    "validation",
    "summary"
  ],
  "properties": {
    "schema_version": { "const": "multi-project-saas-control-plane.v1" },
    "capability_id": { "const": "platform.multi_project_saas_control_plane" },
    "program_range": { "const": "P9401-P9600" },
    "source_program_range": { "const": "P9201-P9400" },
    "generated_at": { "type": "string" },
    "multi_project_saas_contract": {
      "type": "object",
      "required": [
        "harness_product_identity",
        "claude_review_required_now",
        "claude_review_decision",
        "codex_final_approval_allowed",
        "claude_final_approval_allowed",
        "production_pass_enabled",
        "enterprise_pass_enabled",
        "repo_git_write_enabled",
        "external_connector_write_enabled",
        "domain_pack_as_product_allowed",
        "cross_project_data_mixing_allowed"
      ],
      "properties": {
        "harness_product_identity": { "const": "general_project_workflow_control_plane" },
        "claude_review_required_now": { "const": false },
        "claude_review_decision": { "const": "skipped_no_authority_expansion" },
        "codex_final_approval_allowed": { "const": false },
        "claude_final_approval_allowed": { "const": false },
        "production_pass_enabled": { "const": false },
        "enterprise_pass_enabled": { "const": false },
        "repo_git_write_enabled": { "const": false },
        "external_connector_write_enabled": { "const": false },
        "domain_pack_as_product_allowed": { "const": false },
        "cross_project_data_mixing_allowed": { "const": false }
      }
    },
    "multi_project_saas_phase_rows": {
      "type": "array",
      "minItems": 10,
      "items": { "$ref": "#/$defs/verdictRow" }
    },
    "p9400_source_binding_rows": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/verdictRow" }
    },
    "multi_project_api_route_rows": {
      "type": "array",
      "minItems": 8,
      "items": {
        "allOf": [
          { "$ref": "#/$defs/verdictRow" },
          {
            "type": "object",
            "required": ["method_allowlist", "write_methods_enabled", "mutates_state"],
            "properties": {
              "method_allowlist": {
                "type": "array",
                "contains": { "const": "GET" }
              },
              "write_methods_enabled": { "const": false },
              "mutates_state": { "const": false }
            }
          }
        ]
      }
    },
    "saas_project_registry_rows": {
      "type": "array",
      "minItems": 2,
      "items": {
        "allOf": [
          { "$ref": "#/$defs/verdictRow" },
          {
            "type": "object",
            "required": ["project_id", "domain_pack_scope", "domain_pack_is_whole_product", "hermes_product_identity", "cross_project_data_mixed"],
            "properties": {
              "domain_pack_scope": { "const": "project_workflow_context" },
              "domain_pack_is_whole_product": { "const": false },
              "hermes_product_identity": { "const": "general_project_workflow_control_plane" },
              "cross_project_data_mixed": { "const": false }
            }
          }
        ]
      }
    },
    "saas_repo_inventory_rows": {
      "type": "array",
      "minItems": 2,
      "items": {
        "allOf": [
          { "$ref": "#/$defs/verdictRow" },
          {
            "type": "object",
            "required": ["repo_write_enabled", "git_stage_enabled", "git_commit_enabled", "git_push_enabled", "merge_enabled", "patch_apply_enabled", "external_connector_write_enabled"],
            "properties": {
              "repo_write_enabled": { "const": false },
              "git_stage_enabled": { "const": false },
              "git_commit_enabled": { "const": false },
              "git_push_enabled": { "const": false },
              "merge_enabled": { "const": false },
              "patch_apply_enabled": { "const": false },
              "external_connector_write_enabled": { "const": false }
            }
          }
        ]
      }
    },
    "current_goal_risk_rows": {
      "type": "array",
      "minItems": 2,
      "items": {
        "allOf": [
          { "$ref": "#/$defs/verdictRow" },
          {
            "type": "object",
            "required": ["risk_level", "validation_required", "protected_action_enabled", "production_pass_enabled", "enterprise_pass_enabled"],
            "properties": {
              "risk_level": { "enum": ["low", "medium", "high"] },
              "validation_required": { "const": true },
              "protected_action_enabled": { "const": false },
              "production_pass_enabled": { "const": false },
              "enterprise_pass_enabled": { "const": false }
            }
          }
        ]
      }
    },
    "validation_review_aggregation_rows": {
      "type": "array",
      "minItems": 2,
      "items": {
        "allOf": [
          { "$ref": "#/$defs/verdictRow" },
          {
            "type": "object",
            "required": ["validation_ready", "review_boundary_ready", "codex_final_approval_allowed", "claude_final_approval_allowed", "reviewer_mutation_allowed"],
            "properties": {
              "validation_ready": { "const": true },
              "review_boundary_ready": { "const": true },
              "codex_final_approval_allowed": { "const": false },
              "claude_final_approval_allowed": { "const": false },
              "reviewer_mutation_allowed": { "const": false }
            }
          }
        ]
      }
    },
    "blocker_next_action_rows": {
      "type": "array",
      "minItems": 2,
      "items": {
        "allOf": [
          { "$ref": "#/$defs/verdictRow" },
          {
            "type": "object",
            "required": ["blocker_count", "executes_action", "mutates_state"],
            "properties": {
              "blocker_count": { "const": 0 },
              "executes_action": { "const": false },
              "mutates_state": { "const": false }
            }
          }
        ]
      }
    },
    "domain_boundary_guard_rows": {
      "type": "array",
      "minItems": 2,
      "items": {
        "allOf": [
          { "$ref": "#/$defs/verdictRow" },
          {
            "type": "object",
            "required": ["domain_pack_is_whole_product", "cross_project_data_mixed", "protected_output_generated", "production_release_allowed"],
            "properties": {
              "domain_pack_is_whole_product": { "const": false },
              "cross_project_data_mixed": { "const": false },
              "protected_output_generated": { "const": false },
              "production_release_allowed": { "const": false }
            }
          }
        ]
      }
    },
    "operator_control_summary_rows": {
      "type": "array",
      "minItems": 2,
      "items": {
        "allOf": [
          { "$ref": "#/$defs/verdictRow" },
          {
            "type": "object",
            "required": ["read_only", "claude_review_required_now"],
            "properties": {
              "read_only": { "const": true },
              "claude_review_required_now": { "const": false }
            }
          }
        ]
      }
    },
    "multi_project_api_smoke_rows": {
      "type": "array",
      "minItems": 9,
      "items": { "$ref": "#/$defs/verdictRow" }
    },
    "multi_project_browser_smoke_rows": {
      "type": "array",
      "minItems": 6,
      "items": { "$ref": "#/$defs/verdictRow" }
    },
    "multi_project_negative_fixture_rows": {
      "type": "array",
      "minItems": 10,
      "items": {
        "allOf": [
          { "$ref": "#/$defs/verdictRow" },
          {
            "type": "object",
            "required": ["unsafe_claim_allowed", "fixture_status"],
            "properties": {
              "unsafe_claim_allowed": { "const": false },
              "fixture_status": { "const": "PASS_BLOCKED_AS_EXPECTED" }
            }
          }
        ]
      }
    },
    "p9600_freeze_rows": {
      "type": "array",
      "minItems": 16,
      "items": { "$ref": "#/$defs/verdictRow" }
    },
    "multi_project_gate_rows": {
      "type": "array",
      "minItems": 22,
      "items": { "$ref": "#/$defs/verdictRow" }
    },
    "multi_project_saas_boundary": {
      "type": "object",
      "required": [
        "ready_for_p9601_handoff",
        "api_write_methods_enabled",
        "repo_git_write_enabled",
        "raw_transcript_body_visible",
        "secret_keys_returned",
        "domain_pack_as_product_allowed",
        "cross_project_data_mixing_allowed",
        "codex_final_approval_allowed",
        "claude_final_approval_allowed",
        "production_pass_enabled",
        "enterprise_pass_enabled",
        "unsafe_flag_count"
      ],
      "properties": {
        "ready_for_p9601_handoff": { "const": true },
        "api_write_methods_enabled": { "const": false },
        "repo_git_write_enabled": { "const": false },
        "raw_transcript_body_visible": { "const": false },
        "secret_keys_returned": { "const": false },
        "domain_pack_as_product_allowed": { "const": false },
        "cross_project_data_mixing_allowed": { "const": false },
        "codex_final_approval_allowed": { "const": false },
        "claude_final_approval_allowed": { "const": false },
        "production_pass_enabled": { "const": false },
        "enterprise_pass_enabled": { "const": false },
        "unsafe_flag_count": { "const": 0 }
      }
    },
    "validation_items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["status"],
        "properties": {
          "status": { "const": "pass" }
        }
      }
    },
    "validation": {
      "type": "object",
      "required": ["valid", "error_count"],
      "properties": {
        "valid": { "const": true },
        "error_count": { "const": 0 }
      }
    },
    "summary": {
      "type": "object",
      "required": [
        "multi_project_saas_control_plane_status",
        "source_p9400_ready",
        "ready_for_p9601_handoff",
        "claude_review_required_now",
        "claude_review_decision",
        "validation_error_count"
      ],
      "properties": {
        "multi_project_saas_control_plane_status": { "const": "ready_for_multi_project_saas_control_plane" },
        "source_p9400_ready": { "const": true },
        "ready_for_p9601_handoff": { "const": true },
        "claude_review_required_now": { "const": false },
        "claude_review_decision": { "const": "skipped_no_authority_expansion" },
        "validation_error_count": { "const": 0 }
      }
    }
  },
  "$defs": {
    "verdictRow": {
      "type": "object",
      "required": ["current_verdict", "unsafe_flags_false", "verdict_authority"],
      "properties": {
        "current_verdict": { "const": "pass" },
        "unsafe_flags_false": { "const": true },
        "verdict_authority": { "const": "harness_deterministic_validator" }
      },
      "additionalProperties": true
    }
  }
}
