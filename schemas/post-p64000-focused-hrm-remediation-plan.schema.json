{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hermes.local/schemas/post-p64000-focused-hrm-remediation-plan.schema.json",
  "title": "Post-P64000 Focused HRM Remediation Plan",
  "type": "object",
  "required": [
    "schema_version",
    "capability_id",
    "program_range",
    "source_program_range",
    "next_program_range",
    "post_p64000_focused_hrm_remediation_plan_contract",
    "p68000_receipt_source_rows",
    "focused_hrm_plan_rows",
    "verification_packet_rows",
    "finding_state_preservation_rows",
    "authority_boundary_rows",
    "negative_fixture_contract_rows",
    "validation_command_rows",
    "p68400_wiring_rows",
    "p68400_closeout_rows",
    "p68401_handoff_rows",
    "post_p64000_focused_hrm_remediation_plan_boundary",
    "summary",
    "validation"
  ],
  "properties": {
    "schema_version": { "const": "post-p64000-focused-hrm-remediation-plan.v1" },
    "capability_id": { "const": "platform.post_p64000_focused_hrm_remediation_plan" },
    "program_range": { "const": "P68001-P68400" },
    "source_program_range": { "const": "P67601-P68000" },
    "next_program_range": { "const": "P68401-P68800" },
    "post_p64000_focused_hrm_remediation_plan_contract": {
      "type": "object",
      "required": [
        "focused_plan_only",
        "verification_packet_only",
        "finding_resolution_allowed",
        "source_mutation_allowed",
        "patch_apply_allowed",
        "clean_checkpoint_allowed",
        "protected_closeout_allowed",
        "production_pass_allowed",
        "enterprise_pass_allowed"
      ],
      "properties": {
        "focused_plan_only": { "const": true },
        "verification_packet_only": { "const": true },
        "finding_resolution_allowed": { "const": false },
        "source_mutation_allowed": { "const": false },
        "patch_apply_allowed": { "const": false },
        "clean_checkpoint_allowed": { "const": false },
        "protected_closeout_allowed": { "const": false },
        "production_pass_allowed": { "const": false },
        "enterprise_pass_allowed": { "const": false }
      },
      "additionalProperties": true
    },
    "p68000_receipt_source_rows": { "type": "array", "minItems": 9, "items": { "$ref": "#/$defs/verdictRow" } },
    "focused_hrm_plan_rows": {
      "type": "array",
      "minItems": 3,
      "contains": { "type": "object", "properties": { "finding_id": { "const": "HRM-04" } }, "required": ["finding_id"] },
      "items": { "$ref": "#/$defs/verdictRow" }
    },
    "verification_packet_rows": {
      "type": "array",
      "minItems": 3,
      "contains": { "type": "object", "properties": { "finding_id": { "const": "HRM-03" } }, "required": ["finding_id"] },
      "items": { "$ref": "#/$defs/verdictRow" }
    },
    "finding_state_preservation_rows": { "type": "array", "minItems": 5, "items": { "$ref": "#/$defs/verdictRow" } },
    "authority_boundary_rows": { "type": "array", "minItems": 30, "items": { "$ref": "#/$defs/verdictRow" } },
    "negative_fixture_contract_rows": { "type": "array", "minItems": 20, "items": { "$ref": "#/$defs/verdictRow" } },
    "validation_command_rows": { "type": "array", "minItems": 9, "items": { "$ref": "#/$defs/verdictRow" } },
    "p68400_wiring_rows": { "type": "array", "minItems": 3, "items": { "$ref": "#/$defs/verdictRow" } },
    "p68400_closeout_rows": { "type": "array", "minItems": 8, "items": { "$ref": "#/$defs/verdictRow" } },
    "p68401_handoff_rows": { "type": "array", "minItems": 3, "items": { "$ref": "#/$defs/verdictRow" } },
    "post_p64000_focused_hrm_remediation_plan_boundary": {
      "type": "object",
      "required": [
        "post_p64000_focused_hrm_remediation_plan_ready",
        "p68000_receipt_ready_now",
        "focused_hrm_plans_ready_now",
        "verification_packets_ready_now",
        "blocking_findings_preserved_now",
        "ready_for_p68401_handoff",
        "clean_checkpoint_allowed_now",
        "finding_resolution_allowed_now",
        "focused_plan_fixed_claim_allowed_now",
        "focused_plan_verified_claim_allowed_now",
        "runtime_execution_allowed_now",
        "command_execution_allowed_now",
        "write_action_allowed_now",
        "direct_file_write_allowed_now",
        "generated_patch_apply_allowed_now",
        "connector_write_allowed_now",
        "protected_action_allowed_now",
        "protected_closeout_allowed_now",
        "deployment_allowed_now",
        "production_pass_allowed_now",
        "enterprise_pass_allowed_now",
        "codex_final_approval_allowed",
        "claude_final_approval_allowed",
        "final_automated_approval_allowed_now",
        "reviewer_mutation_allowed_now",
        "source_mutation_from_review_allowed_now",
        "patch_apply_allowed_now",
        "clean_checkpoint_claim_allowed_now",
        "post_p68400_production_pass_claim_allowed_now",
        "post_p68400_enterprise_pass_claim_allowed_now",
        "production_pass_enabled",
        "enterprise_pass_enabled",
        "final_approval_enabled"
      ],
      "properties": {
        "post_p64000_focused_hrm_remediation_plan_ready": { "type": "boolean" },
        "p68000_receipt_ready_now": { "type": "boolean" },
        "focused_hrm_plans_ready_now": { "type": "boolean" },
        "verification_packets_ready_now": { "type": "boolean" },
        "blocking_findings_preserved_now": { "type": "boolean" },
        "ready_for_p68401_handoff": { "type": "boolean" },
        "clean_checkpoint_allowed_now": { "const": false },
        "finding_resolution_allowed_now": { "const": false },
        "focused_plan_fixed_claim_allowed_now": { "const": false },
        "focused_plan_verified_claim_allowed_now": { "const": false },
        "runtime_execution_allowed_now": { "const": false },
        "command_execution_allowed_now": { "const": false },
        "write_action_allowed_now": { "const": false },
        "direct_file_write_allowed_now": { "const": false },
        "generated_patch_apply_allowed_now": { "const": false },
        "connector_write_allowed_now": { "const": false },
        "protected_action_allowed_now": { "const": false },
        "protected_closeout_allowed_now": { "const": false },
        "deployment_allowed_now": { "const": false },
        "production_pass_allowed_now": { "const": false },
        "enterprise_pass_allowed_now": { "const": false },
        "codex_final_approval_allowed": { "const": false },
        "claude_final_approval_allowed": { "const": false },
        "final_automated_approval_allowed_now": { "const": false },
        "reviewer_mutation_allowed_now": { "const": false },
        "source_mutation_from_review_allowed_now": { "const": false },
        "patch_apply_allowed_now": { "const": false },
        "clean_checkpoint_claim_allowed_now": { "const": false },
        "post_p68400_production_pass_claim_allowed_now": { "const": false },
        "post_p68400_enterprise_pass_claim_allowed_now": { "const": false },
        "production_pass_enabled": { "const": false },
        "enterprise_pass_enabled": { "const": false },
        "final_approval_enabled": { "const": false }
      },
      "additionalProperties": true
    },
    "summary": {
      "type": "object",
      "required": [
        "post_p64000_focused_hrm_remediation_plan_status",
        "program_range",
        "source_program_range",
        "next_program_range",
        "p68000_receipt_ready_now",
        "focused_hrm_plans_ready_now",
        "verification_packets_ready_now",
        "blocking_findings_preserved_now",
        "ready_for_p68401_handoff",
        "clean_checkpoint_allowed_now",
        "finding_resolution_allowed_now",
        "focused_plan_fixed_claim_allowed_now",
        "focused_plan_verified_claim_allowed_now",
        "production_pass_enabled",
        "enterprise_pass_enabled",
        "final_approval_enabled"
      ],
      "properties": {
        "program_range": { "const": "P68001-P68400" },
        "source_program_range": { "const": "P67601-P68000" },
        "next_program_range": { "const": "P68401-P68800" },
        "clean_checkpoint_allowed_now": { "const": false },
        "finding_resolution_allowed_now": { "const": false },
        "focused_plan_fixed_claim_allowed_now": { "const": false },
        "focused_plan_verified_claim_allowed_now": { "const": false },
        "production_pass_enabled": { "const": false },
        "enterprise_pass_enabled": { "const": false },
        "final_approval_enabled": { "const": false }
      },
      "additionalProperties": true
    },
    "validation": {
      "type": "object",
      "required": ["valid", "error_count", "errors"],
      "properties": {
        "valid": { "type": "boolean" },
        "error_count": { "type": "number" },
        "errors": { "type": "array" }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true,
  "$defs": {
    "verdictRow": {
      "type": "object",
      "required": [
        "row_id",
        "category",
        "label",
        "observed",
        "current_verdict",
        "evidence_ref",
        "block_reason",
        "next_allowed_action",
        "generated_at"
      ],
      "properties": {
        "row_id": { "type": "string", "minLength": 1 },
        "category": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "observed": { "type": "boolean" },
        "current_verdict": { "enum": ["pass", "block"] },
        "evidence_ref": { "type": "string", "minLength": 1 },
        "block_reason": { "type": ["string", "null"] },
        "next_allowed_action": { "type": "string", "minLength": 1 },
        "generated_at": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": true
    }
  }
}
