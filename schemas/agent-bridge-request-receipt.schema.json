        "enterprise_pass_enabled",
        "protected_closeout_enabled",
        "agent_final_pass_allowed_now",
        "unsafe_flag_count",
        "validation_error_count"
      ],
      "properties": {
        "agent_bridge_request_receipt_status": {
          "enum": ["ready_for_agent_bridge_request_receipt", "blocked_agent_bridge_request_receipt"]
        },
        "request_count": { "type": "integer", "minimum": 4 },
        "receipt_count": { "type": "integer", "minimum": 4 },
        "evidence_binding_count": { "type": "integer", "minimum": 4 },
        "request_queue_enabled_now": { "const": true },
        "receipt_intake_enabled_now": { "const": true },
        "request_transport_submission_allowed_now": { "const": false },
        "execution_allowed_now": { "const": false },
        "command_executed_now": { "const": false },
        "mutation_performed": { "const": false },
        "receipt_application_allowed_now": { "const": false },
        "approval_application_allowed_now": { "const": false },
        "raw_prompt_storage_allowed": { "const": false },
        "raw_receipt_storage_allowed": { "const": false },
        "provider_output_authoritative": { "const": false },
        "local_only": { "const": true },
        "read_only": { "const": true },
        "source_of_truth": { "const": false },
        "desktop_mutation_allowed": { "const": false },
        "agent_runtime_execution_allowed_now": { "const": false },
        "command_execution_allowed_now": { "const": false },
        "shell_execution_allowed_now": { "const": false },
        "git_write_allowed_now": { "const": false },
        "deploy_allowed_now": { "const": false },
        "connector_write_allowed_now": { "const": false },
        "secret_read_allowed_now": { "const": false },
        "raw_source_exposure_allowed": { "const": false },
        "production_pass_enabled": { "const": false },
        "enterprise_pass_enabled": { "const": false },
        "protected_closeout_enabled": { "const": false },
        "agent_final_pass_allowed_now": { "const": false },
        "unsafe_flag_count": { "const": 0 },
        "validation_error_count": { "type": "integer", "minimum": 0 }
      }
    }
  },
  "$defs": {
    "verdictRow": {
      "type": "object",
      "required": ["current_verdict", "unsafe_flags_false", "verdict_authority"],
      "properties": {
        "current_verdict": { "enum": ["pass", "blocked"] },
        "unsafe_flags_false": { "type": "boolean" },
        "verdict_authority": { "const": "harness_deterministic_validator" }
      }
    },
    "requestRow": {
      "type": "object",
      "required": [
        "request_id",
        "request_type",
        "request_status",
        "requestable",
        "request_packet_generated",
        "request_transport_submission_allowed_now",
        "transport_submitted_now",
        "execution_allowed_now",
        "command_executed_now",
        "mutation_performed",
        "receipt_applied",
        "raw_prompt_included",
        "data_minimization_passed",
        "current_verdict",
        "verdict_authority"
      ],
      "properties": {
        "request_id": { "type": "string", "minLength": 1 },
        "request_type": {
          "enum": ["plan_review", "code_review", "implementation_proposal", "command_suggestion"]
        },
        "request_status": {
          "enum": ["draft", "requested", "observed", "imported", "blocked"]
        },
        "requestable": { "const": true },
        "request_packet_generated": { "const": true },
        "request_transport_submission_allowed_now": { "const": false },
        "transport_submitted_now": { "const": false },
        "execution_allowed_now": { "const": false },
        "command_executed_now": { "const": false },
        "mutation_performed": { "const": false },
        "receipt_applied": { "const": false },
        "raw_prompt_included": { "const": false },
        "data_minimization_passed": { "const": true },
        "current_verdict": { "const": "pass" },
        "verdict_authority": { "const": "harness_deterministic_validator" }
      }
    },
    "receiptRow": {
      "type": "object",
      "required": [
        "receipt_id",
        "request_id",
        "request_type",
        "normalized_summary_only",
        "raw_output_included",
        "receipt_applied",
        "approval_application_allowed_now",
        "receipt_application_allowed_now",
        "execution_allowed_now",
        "opens_authority",
        "current_verdict",
        "verdict_authority"
      ],
      "properties": {
        "receipt_id": { "type": "string", "minLength": 1 },
        "request_id": { "type": "string", "minLength": 1 },
        "request_type": {
          "enum": ["plan_review", "code_review", "implementation_proposal", "command_suggestion"]
        },
        "normalized_summary_only": { "const": true },
        "raw_output_included": { "const": false },
        "receipt_applied": { "const": false },
        "approval_application_allowed_now": { "const": false },
        "receipt_application_allowed_now": { "const": false },
        "execution_allowed_now": { "const": false },
        "opens_authority": { "const": false },
        "current_verdict": { "const": "pass" },
        "verdict_authority": { "const": "harness_deterministic_validator" }
      }
    }
  }
}
