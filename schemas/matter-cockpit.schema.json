{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://amic.local/hermes/matter-cockpit.schema.json",
  "title": "Hermes Matter Cockpit",
  "type": "object",
  "required": ["schema_version", "generated_at", "summary", "sources", "matters"],
  "properties": {
    "schema_version": { "const": "matter-cockpit.v1" },
    "generated_at": { "type": "string", "format": "date-time" },
    "summary": {
      "type": "object",
      "required": [
        "source_count",
        "available_source_count",
        "missing_source_count",
        "matter_count",
        "blocked_matter_count",
        "pending_review_matter_count",
        "ready_matter_count",
        "resource_count",
        "evidence_count",
        "output_artifact_count",
        "workflow_run_count",
        "delivery_action_count",
        "pending_approval_count",
        "blocked_delivery_count",
        "blocking_gate_count",
        "runtime_seconds",
        "by_status",
        "by_tenant_id",
        "by_primary_domain_pack"
      ],
      "properties": {
        "source_count": { "type": "integer", "minimum": 0 },
        "available_source_count": { "type": "integer", "minimum": 0 },
        "missing_source_count": { "type": "integer", "minimum": 0 },
        "matter_count": { "type": "integer", "minimum": 0 },
        "blocked_matter_count": { "type": "integer", "minimum": 0 },
        "pending_review_matter_count": { "type": "integer", "minimum": 0 },
        "ready_matter_count": { "type": "integer", "minimum": 0 },
        "resource_count": { "type": "integer", "minimum": 0 },
        "evidence_count": { "type": "integer", "minimum": 0 },
        "output_artifact_count": { "type": "integer", "minimum": 0 },
        "workflow_run_count": { "type": "integer", "minimum": 0 },
        "delivery_action_count": { "type": "integer", "minimum": 0 },
        "pending_approval_count": { "type": "integer", "minimum": 0 },
        "blocked_delivery_count": { "type": "integer", "minimum": 0 },
        "blocking_gate_count": { "type": "integer", "minimum": 0 },
        "runtime_seconds": { "type": "number", "minimum": 0 },
        "by_status": { "type": "object" },
        "by_tenant_id": { "type": "object" },
        "by_primary_domain_pack": { "type": "object" }
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source_id", "label", "path", "available", "schema_version", "generated_at", "summary", "error"],
        "properties": {
          "source_id": { "type": "string" },
          "label": { "type": "string" },
          "path": { "type": ["string", "null"] },
          "available": { "type": "boolean" },
          "schema_version": { "type": ["string", "null"] },
          "generated_at": { "type": ["string", "null"], "format": "date-time" },
          "summary": { "type": ["object", "null"] },
          "error": { "type": ["string", "null"] }
        }
      }
    },
    "matters": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "matter_key",
          "tenant_id",
          "matter_id",
          "matter_label",
          "status",
          "domain_packs",
          "classifications",
          "resource_count",
          "evidence_count",
          "evidence_needs_review_count",
          "output_artifact_count",
          "workflow_run_count",
          "delivery_action_count",
          "pending_approval_count",
          "blocked_delivery_count",
          "ready_delivery_count",
          "blocking_gate_count",
          "high_priority_action_count",
          "runtime_seconds",
          "error_count",
          "runtime_ids",
          "delivery_channels",
          "latest_activity_at",
          "resource_ids",
          "evidence_ids",
          "output_artifact_ids",
          "workflow_run_ids",
          "delivery_action_ids"
        ],
        "properties": {
          "matter_key": { "type": "string" },
          "tenant_id": { "type": "string" },
          "matter_id": { "type": "string" },
          "matter_label": { "type": "string" },
          "status": { "enum": ["active", "blocked", "pending_review", "ready"] },
          "domain_packs": { "type": "array", "items": { "type": "string" } },
          "classifications": { "type": "array", "items": { "type": "string" } },
          "resource_count": { "type": "integer", "minimum": 0 },
          "evidence_count": { "type": "integer", "minimum": 0 },
          "evidence_needs_review_count": { "type": "integer", "minimum": 0 },
          "output_artifact_count": { "type": "integer", "minimum": 0 },
          "workflow_run_count": { "type": "integer", "minimum": 0 },
          "delivery_action_count": { "type": "integer", "minimum": 0 },
          "pending_approval_count": { "type": "integer", "minimum": 0 },
          "blocked_delivery_count": { "type": "integer", "minimum": 0 },
          "ready_delivery_count": { "type": "integer", "minimum": 0 },
          "blocking_gate_count": { "type": "integer", "minimum": 0 },
          "high_priority_action_count": { "type": "integer", "minimum": 0 },
          "runtime_seconds": { "type": "number", "minimum": 0 },
          "error_count": { "type": "integer", "minimum": 0 },
          "runtime_ids": { "type": "array", "items": { "type": "string" } },
          "delivery_channels": { "type": "array", "items": { "type": "string" } },
          "latest_activity_at": { "type": ["string", "null"], "format": "date-time" },
          "resource_ids": { "type": "array", "items": { "type": "string" } },
          "evidence_ids": { "type": "array", "items": { "type": "string" } },
          "output_artifact_ids": { "type": "array", "items": { "type": "string" } },
          "workflow_run_ids": { "type": "array", "items": { "type": "string" } },
          "delivery_action_ids": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  }
}
