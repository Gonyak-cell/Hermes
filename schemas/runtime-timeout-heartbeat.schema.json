          "runtime_self_report_trusted": { "const": false },
          "desktop_read_only": { "const": true }
        }
      }
    },
    "runtime_timeout_records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "runtime_timeout_record_id",
          "timeout_authority",
          "timeout_status",
          "agent_run_id",
          "workflow_run_id",
          "runtime_id",
          "heartbeat_record_id",
          "timeout_seconds",
          "heartbeat_interval_seconds",
          "elapsed_seconds",
          "timeout_deadline_at",
          "timed_out",
          "active_timeout",
          "timeout_action_status",
          "timeout_action",
          "protected_control_action_required",
          "human_gate_required_for_control_action",
          "runtime_self_report_trusted",
