{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hermes.local/schemas/validation-runbook-readiness.schema.json",
  "title": "Hermes Validation Runbook Readiness",
  "type": "object",
  "required": [
    "schema_version",
    "generated_at",
    "capability_id",
    "program_range",
    "source_program_range",
    "validation_runbook_readiness_phase_rows",
    "p20800_source_binding_rows",
    "launch_evidence_queue_rows",
    "command_evidence_plan_rows",
    "review_escalation_rule_rows",
    "no_action_boundary_runbook_rows",
    "runbook_operator_projection_rows",
    "p21200_clean_checkpoint_rows",
    "validation_runbook_readiness_boundary",
    "validation_runbook_readiness_validation_items",
    "summary",
    "validation"
  ],
  "properties": {
    "schema_version": { "const": "validation-runbook-readiness.v1" },
    "generated_at": { "type": "string", "format": "date-time" },
    "capability_id": { "const": "platform.validation_runbook_readiness" },
    "program_range": { "const": "P20801-P21200" },
    "source_program_range": { "const": "P20401-P20800" },
    "validation_runbook_readiness_phase_rows": { "type": "array", "minItems": 7, "items": { "$ref": "#/$defs/verdictRow" } },
    "p20800_source_binding_rows": { "type": "array", "minItems": 9, "items": { "$ref": "#/$defs/verdictRow" } },
    "launch_evidence_queue_rows": { "type": "array", "minItems": 11, "items": { "$ref": "#/$defs/verdictRow" } },
    "command_evidence_plan_rows": { "type": "array", "minItems": 6, "items": { "$ref": "#/$defs/verdictRow" } },
    "review_escalation_rule_rows": { "type": "array", "minItems": 6, "items": { "$ref": "#/$defs/verdictRow" } },
    "no_action_boundary_runbook_rows": { "type": "array", "minItems": 7, "items": { "$ref": "#/$defs/verdictRow" } },
    "runbook_operator_projection_rows": { "type": "array", "minItems": 6, "items": { "$ref": "#/$defs/verdictRow" } },
    "p21200_clean_checkpoint_rows": { "type": "array", "minItems": 8, "items": { "$ref": "#/$defs/verdictRow" } },
    "validation_runbook_readiness_validation_items": { "type": "array", "minItems": 12, "items": { "$ref": "#/$defs/validationItem" } },
    "summary": {
      "type": "object",
      "required": [
        "validation_runbook_readiness_status",
        "source_p20800_ready_for_p20801_handoff",
        "launch_evidence_queue_count",
        "command_evidence_plan_count",
        "review_escalation_rule_count",
        "no_action_boundary_count",
        "ready_for_p21201_handoff",
        "production_pass_enabled"
      ],
      "properties": {
        "validation_runbook_readiness_status": {
          "enum": [
            "ready_for_validation_runbook_readiness",
            "valid_block_runbook_readiness_pending",
            "blocked_validation_runbook_readiness"
          ]
        },
        "source_p20800_ready_for_p20801_handoff": { "type": "boolean" },
        "launch_evidence_queue_count": { "type": "number" },
        "command_evidence_plan_count": { "type": "number" },
        "review_escalation_rule_count": { "type": "number" },
        "no_action_boundary_count": { "type": "number" },
        "ready_for_p21201_handoff": { "type": "boolean" },
        "production_pass_enabled": { "const": false }
      }
    },
    "validation_runbook_readiness_boundary": {
      "type": "object",
      "required": [
        "p21200_contract_ready",
        "ready_for_p21201_handoff",
        "source_p20800_ready_for_p20801_handoff",
        "source_validation_valid_now",
        "launch_evidence_queue_visible_now",
        "command_evidence_plan_visible_now",
        "review_escalation_rules_visible_now",
        "no_action_boundary_closed_now",
        "runbook_operator_projection_visible_now",
        "launch_evidence_queue_count",
        "command_evidence_plan_count",
        "review_escalation_rule_count",
        "no_action_boundary_count",
        "runbook_operator_projection_count",
        "deployment_allowed_now",
        "release_approval_allowed_now",
        "production_pass_enabled",
        "enterprise_pass_enabled",
        "enterprise_trust_claim_allowed_now",
        "protected_closeout_enabled",
        "human_gate_bypass_allowed_now",
        "independent_review_bypass_allowed_now",
        "single_owner_enterprise_trust_allowed_now",
        "runtime_execution_allowed_now",
        "write_action_allowed_now",
        "protected_action_allowed_now",
        "connector_write_enabled",
        "external_service_mutation_allowed_now",
        "raw_source_exposure_allowed",
        "secret_read_allowed_now",
        "reviewer_mutation_allowed_now",
        "final_automated_approval_allowed"
      ],
      "properties": {
        "p21200_contract_ready": { "type": "boolean" },
        "ready_for_p21201_handoff": { "type": "boolean" },
        "source_p20800_ready_for_p20801_handoff": { "type": "boolean" },
        "source_validation_valid_now": { "type": "boolean" },
        "launch_evidence_queue_visible_now": { "type": "boolean" },
        "command_evidence_plan_visible_now": { "type": "boolean" },
        "review_escalation_rules_visible_now": { "type": "boolean" },
        "no_action_boundary_closed_now": { "type": "boolean" },
        "runbook_operator_projection_visible_now": { "type": "boolean" },
        "launch_evidence_queue_count": { "type": "number" },
        "command_evidence_plan_count": { "type": "number" },
        "review_escalation_rule_count": { "type": "number" },
        "no_action_boundary_count": { "type": "number" },
        "runbook_operator_projection_count": { "type": "number" },
        "deployment_allowed_now": { "const": false },
        "release_approval_allowed_now": { "const": false },
        "production_pass_enabled": { "const": false },
        "enterprise_pass_enabled": { "const": false },
        "enterprise_trust_claim_allowed_now": { "const": false },
        "protected_closeout_enabled": { "const": false },
        "human_gate_bypass_allowed_now": { "const": false },
        "independent_review_bypass_allowed_now": { "const": false },
        "single_owner_enterprise_trust_allowed_now": { "const": false },
        "runtime_execution_allowed_now": { "const": false },
        "write_action_allowed_now": { "const": false },
        "protected_action_allowed_now": { "const": false },
        "connector_write_enabled": { "const": false },
        "external_service_mutation_allowed_now": { "const": false },
        "raw_source_exposure_allowed": { "const": false },
        "secret_read_allowed_now": { "const": false },
        "reviewer_mutation_allowed_now": { "const": false },
        "final_automated_approval_allowed": { "const": false }
      }
    },
    "validation": {
      "type": "object",
      "required": ["valid", "error_count", "errors"],
      "properties": {
        "valid": { "type": "boolean" },
        "error_count": { "type": "number" },
        "errors": { "type": "array" }
      }
    }
  },
  "$defs": {
    "verdictRow": {
      "type": "object",
      "required": [
        "row_id",
        "category",
        "label",
        "observed",
        "current_verdict",
        "block_reason",
        "evidence_ref",
        "generated_at"
      ],
      "properties": {
        "row_id": { "type": "string", "minLength": 1 },
        "category": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "observed": { "type": "boolean" },
        "current_verdict": { "enum": ["pass", "blocked"] },
        "block_reason": { "type": ["string", "null"] },
        "evidence_ref": { "type": "string", "minLength": 1 },
        "generated_at": { "type": "string", "format": "date-time" }
      }
    },
    "validationItem": {
      "type": "object",
      "required": ["item_id", "category", "passed", "message", "evidence_ref"],
      "properties": {
        "item_id": { "type": "string", "minLength": 1 },
        "category": { "type": "string", "minLength": 1 },
        "passed": { "type": "boolean" },
        "message": { "type": "string" },
        "evidence_ref": { "type": "string", "minLength": 1 }
      }
    }
  }
}
