        "answer_receipt_raw_answer_persist_allowed_now": { "const": false },
        "answer_receipt_raw_answer_exposure_allowed_now": { "const": false },
        "answer_receipt_redacted_receipt_accept_allowed_now": { "const": false },
        "answer_receipt_queue_completion_allowed_now": { "const": false },
