        "focused_verification_evidence_ready_now": { "type": "boolean" },
        "candidate_digests_match_now": { "type": "boolean" },
        "verification_event_boundary_ready_now": { "type": "boolean" },
        "findings_remain_open_now": { "type": "boolean" },
        "ready_for_p68801_handoff": { "type": "boolean" },
