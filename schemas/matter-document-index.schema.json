{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hermes.local/schemas/matter-document-index.schema.json",
  "title": "Hermes Matter Document Index",
  "type": "object",
  "required": [
    "schema_version",
    "generated_at",
    "matter_document_index_id",
    "output_dir",
    "matter_document_index_status",
    "safe_handling",
    "inputs",
    "source_contracts",
    "matter_document_index_contract",
    "document_records",
    "document_families",
    "latest_documents",
    "matter_document_index_desktop_boundary",
    "matter_document_index_checkpoints",
    "validation_items",
    "validation",
    "summary"
  ],
  "properties": {
    "schema_version": { "const": "matter-document-index.v1" },
    "generated_at": { "type": "string", "format": "date-time" },
    "matter_document_index_id": { "type": "string", "minLength": 1 },
    "output_dir": { "type": "string", "minLength": 1 },
    "matter_document_index_status": { "enum": ["complete", "blocked"] },
    "safe_handling": { "$ref": "#/$defs/safe_handling" },
    "inputs": { "$ref": "#/$defs/inputs" },
    "source_contracts": { "type": "object" },
    "matter_document_index_contract": { "$ref": "#/$defs/contract" },
    "document_records": { "type": "array", "items": { "$ref": "#/$defs/document_record" } },
    "document_families": { "type": "array", "items": { "$ref": "#/$defs/document_family" } },
    "latest_documents": { "type": "array", "items": { "$ref": "#/$defs/document_record" } },
    "matter_document_index_desktop_boundary": { "$ref": "#/$defs/desktop_boundary" },
    "matter_document_index_checkpoints": { "type": "array", "items": { "$ref": "#/$defs/checkpoint" } },
    "validation_items": { "type": "array", "items": { "$ref": "#/$defs/validation_item" } },
    "validation": { "$ref": "#/$defs/validation" },
    "summary": { "$ref": "#/$defs/summary" }
  },
  "$defs": {
    "inputs": {
      "type": "object",
      "required": [
        "matter_timeline_path",
        "matter_files",
        "output_catalog_path",
        "delivery_queue_path",
        "package_path",
        "roadmap_path"
      ],
      "properties": {
        "matter_timeline_path": { "type": "string" },
        "matter_files": { "type": "array", "items": { "type": "string" } },
        "output_catalog_path": { "type": "string" },
        "delivery_queue_path": { "type": "string" },
        "package_path": { "type": "string" },
        "roadmap_path": { "type": "string" }
      }
    },
    "safe_handling": {
      "type": "object",
      "required": [
        "report_only",
        "legal_advice_provided",
        "client_facing_output_generated",
        "attorney_review_required",
        "human_review_required",
        "matter_data_write_allowed",
        "runtime_execution_performed",
        "delivery_execution_performed",
        "desktop_mutation_allowed",
        "desktop_source_of_truth",
        "protected_mutation_executed",
        "secret_material_exposed",
        "provider_key_visible"
      ],
      "properties": {
        "report_only": { "const": true },
        "legal_advice_provided": { "const": false },
        "client_facing_output_generated": { "const": false },
        "attorney_review_required": { "const": true },
        "human_review_required": { "const": true },
        "matter_data_write_allowed": { "const": false },
        "runtime_execution_performed": { "const": false },
        "delivery_execution_performed": { "const": false },
        "desktop_mutation_allowed": { "const": false },
        "desktop_source_of_truth": { "const": false },
        "protected_mutation_executed": { "const": false },
        "secret_material_exposed": { "const": false },
        "provider_key_visible": { "const": false }
      }
    },
    "contract": {
      "type": "object",
      "required": [
        "schema_version",
        "contract_id",
        "source_of_truth",
        "document_role_rule",
        "latest_document_rule",
        "matter_boundary_rule",
        "attorney_review_rule",
        "desktop_companion_rule",
        "mutation_policy",
        "created_at"
      ],
      "properties": {
        "schema_version": { "const": "matter-document-index-contract.v1" },
        "contract_id": { "const": "matter-document-index.v1" },
        "source_of_truth": { "const": "matter_files_timeline_and_output_artifacts" },
        "document_role_rule": { "type": "string" },
        "latest_document_rule": { "type": "string" },
        "matter_boundary_rule": { "type": "string" },
        "attorney_review_rule": { "type": "string" },
        "desktop_companion_rule": { "type": "string" },
        "mutation_policy": { "type": "string" },
        "created_at": { "type": "string", "format": "date-time" }
      }
    },
    "document_record": {
      "type": "object",
      "required": [
        "schema_version",
        "document_id",
        "matter_id",
        "document_family_id",
        "document_role",
        "document_title",
        "document_type",
        "document_status",
        "document_date",
        "document_at",
        "is_latest",
        "source_kind",
        "source_id",
        "review_status",
        "attorney_review_required",
        "human_review_required",
        "default_output_status",
        "legal_advice_provided",
        "client_facing_output_generated",
        "desktop_read_only",
        "desktop_mutation_allowed",
        "matter_data_write_allowed",
        "runtime_execution_allowed",
        "delivery_execution_allowed",
        "confidence",
        "created_at",
        "metadata"
      ],
      "properties": {
        "schema_version": { "const": "matter-document-record.v1" },
        "document_id": { "type": "string" },
        "matter_id": { "type": "string", "minLength": 1 },
        "document_family_id": { "type": "string", "minLength": 1 },
        "document_role": { "enum": ["original", "draft", "submitted", "counterparty_proposal"] },
        "document_title": { "type": "string", "minLength": 1 },
        "document_type": { "type": "string" },
        "version_label": { "type": ["string", "null"] },
        "version_number": { "type": "integer", "minimum": 0 },
        "document_status": { "type": "string" },
        "document_date": { "type": "string" },
        "document_at": { "type": "string", "format": "date-time" },
        "is_latest": { "type": "boolean" },
        "source_kind": { "enum": ["matter_file", "output_catalog", "matter_timeline"] },
        "source_id": { "type": "string" },
        "source_path": { "type": ["string", "null"] },
        "source_uri": { "type": ["string", "null"] },
        "source_record_id": { "type": ["string", "null"] },
        "owner": { "type": ["string", "null"] },
        "issue": { "type": ["string", "null"] },
        "review_status": { "type": "string" },
        "attorney_review_required": { "const": true },
        "human_review_required": { "const": true },
        "default_output_status": { "const": "pending_review" },
        "legal_advice_provided": { "const": false },
        "client_facing_output_generated": { "const": false },
        "desktop_read_only": { "const": true },
        "desktop_mutation_allowed": { "const": false },
        "matter_data_write_allowed": { "const": false },
        "runtime_execution_allowed": { "const": false },
        "delivery_execution_allowed": { "const": false },
        "confidence": { "type": "string" },
        "created_at": { "type": "string", "format": "date-time" },
        "metadata": { "type": "object" }
      }
    },
    "document_family": {
      "type": "object",
      "required": [
        "schema_version",
        "document_family_id",
        "matter_id",
        "canonical_title",
        "document_type",
        "record_count",
        "document_roles",
        "has_original",
        "has_draft",
        "has_submitted",
        "has_counterparty_proposal",
        "latest_document_id",
        "latest_document_role",
        "latest_document_status",
        "family_status",
        "attorney_review_required",
        "human_review_required",
        "legal_advice_provided",
        "client_facing_output_generated",
        "desktop_read_only",
        "desktop_mutation_allowed",
        "created_at"
      ],
      "properties": {
        "schema_version": { "const": "matter-document-family.v1" },
        "document_family_id": { "type": "string" },
        "matter_id": { "type": "string" },
        "canonical_title": { "type": "string" },
        "document_type": { "type": "string" },
        "record_count": { "type": "integer", "minimum": 0 },
        "document_roles": { "type": "array", "items": { "enum": ["original", "draft", "submitted", "counterparty_proposal"] } },
        "has_original": { "type": "boolean" },
        "has_draft": { "type": "boolean" },
        "has_submitted": { "type": "boolean" },
        "has_counterparty_proposal": { "type": "boolean" },
        "latest_document_id": { "type": ["string", "null"] },
        "latest_document_role": { "type": ["string", "null"] },
        "latest_document_status": { "type": ["string", "null"] },
        "latest_document_at": { "type": ["string", "null"] },
        "family_status": { "enum": ["indexed", "blocked"] },
        "attorney_review_required": { "const": true },
        "human_review_required": { "const": true },
        "legal_advice_provided": { "const": false },
        "client_facing_output_generated": { "const": false },
        "desktop_read_only": { "const": true },
        "desktop_mutation_allowed": { "const": false },
        "created_at": { "type": "string", "format": "date-time" }
      }
    },
    "desktop_boundary": {
      "type": "object",
      "required": [
        "schema_version",
        "boundary_id",
        "boundary_status",
        "read_only",
        "mutation_allowed",
        "source_of_truth",
        "matter_data_write_allowed",
        "runtime_execution_allowed",
        "delivery_execution_allowed",
        "legal_advice_allowed",
        "client_facing_output_allowed_without_attorney_review",
        "attorney_review_required",
        "human_review_required",
        "default_output_status",
        "supported_document_roles",
        "created_at"
      ],
      "properties": {
        "schema_version": { "const": "matter-document-index-desktop-boundary.v1" },
        "boundary_id": { "type": "string" },
        "boundary_status": { "const": "enforced" },
        "read_only": { "const": true },
        "mutation_allowed": { "const": false },
        "source_of_truth": { "const": false },
        "matter_data_write_allowed": { "const": false },
        "runtime_execution_allowed": { "const": false },
        "delivery_execution_allowed": { "const": false },
        "legal_advice_allowed": { "const": false },
        "client_facing_output_allowed_without_attorney_review": { "const": false },
        "attorney_review_required": { "const": true },
        "human_review_required": { "const": true },
        "default_output_status": { "const": "pending_review" },
        "supported_document_roles": { "type": "array", "items": { "enum": ["original", "draft", "submitted", "counterparty_proposal"] } },
        "created_at": { "type": "string", "format": "date-time" }
      }
    },
    "checkpoint": {
      "type": "object",
      "required": ["schema_version", "checkpoint_id", "checkpoint_status", "status", "message"],
      "properties": {
        "schema_version": { "const": "matter-document-index-checkpoint.v1" },
        "checkpoint_id": { "type": "string" },
        "checkpoint_status": { "enum": ["passed", "failed"] },
        "status": { "enum": ["passed", "failed"] },
        "message": { "type": "string" },
        "passed_count": { "type": "integer", "minimum": 0 },
        "expected_count": { "type": "integer", "minimum": 0 }
      }
    },
    "validation_item": {
      "type": "object",
      "required": ["path", "check_id", "status", "message"],
      "properties": {
        "path": { "type": "string" },
        "check_id": { "type": "string" },
        "status": { "enum": ["passed", "failed"] },
        "message": { "type": "string" },
        "schema_version": { "type": "string" },
        "checkpoint_status": { "enum": ["passed", "failed"] },
        "checkpoint_id": { "type": "string" },
        "passed_count": { "type": "integer", "minimum": 0 },
        "expected_count": { "type": "integer", "minimum": 0 }
      }
    },
    "validation": {
      "type": "object",
      "required": ["valid", "errors"],
      "properties": {
        "valid": { "type": "boolean" },
        "errors": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["path", "message", "status"],
            "properties": {
              "path": { "type": "string" },
              "message": { "type": "string" },
              "status": { "type": "string" }
            }
          }
        }
      }
    },
    "summary": {
      "type": "object",
      "required": [
        "matter_document_index_status",
        "matter_document_index_contract_id",
        "source_of_truth",
        "source_matter_timeline_status",
        "source_output_catalog_status",
        "source_delivery_queue_status",
        "matter_file_count",
        "available_matter_file_count",
        "matter_file_with_matter_id_count",
        "document_record_count",
        "document_family_count",
        "original_document_count",
        "draft_document_count",
        "submitted_document_count",
        "counterparty_proposal_count",
        "latest_document_count",
        "family_with_latest_document_count",
        "matter_id_scoped_document_count",
        "attorney_review_required_document_count",
        "human_review_required_document_count",
        "pending_review_document_count",
        "blocked_delivery_submitted_document_count",
        "legal_advice_provided",
        "client_facing_output_generated",
        "desktop_boundary_status",
        "desktop_read_only",
        "desktop_mutation_allowed",
        "desktop_source_of_truth",
        "matter_data_write_allowed",
        "runtime_execution_allowed",
        "delivery_execution_allowed",
        "client_facing_output_allowed_without_attorney_review",
        "failed_checkpoint_count",
        "validation_item_count",
        "validation_error_count"
      ],
      "properties": {
        "matter_document_index_status": { "enum": ["complete", "blocked"] },
        "matter_document_index_contract_id": { "const": "matter-document-index.v1" },
        "source_of_truth": { "const": "matter_files_timeline_and_output_artifacts" },
        "source_matter_timeline_status": { "type": "string" },
        "source_output_catalog_status": { "type": "string" },
        "source_delivery_queue_status": { "type": "string" },
        "matter_file_count": { "type": "integer", "minimum": 0 },
        "available_matter_file_count": { "type": "integer", "minimum": 0 },
        "matter_file_with_matter_id_count": { "type": "integer", "minimum": 0 },
        "document_record_count": { "type": "integer", "minimum": 0 },
        "document_family_count": { "type": "integer", "minimum": 0 },
        "original_document_count": { "type": "integer", "minimum": 0 },
        "draft_document_count": { "type": "integer", "minimum": 0 },
        "submitted_document_count": { "type": "integer", "minimum": 0 },
        "counterparty_proposal_count": { "type": "integer", "minimum": 0 },
        "latest_document_count": { "type": "integer", "minimum": 0 },
        "family_with_latest_document_count": { "type": "integer", "minimum": 0 },
        "matter_id_scoped_document_count": { "type": "integer", "minimum": 0 },
        "attorney_review_required_document_count": { "type": "integer", "minimum": 0 },
        "human_review_required_document_count": { "type": "integer", "minimum": 0 },
        "pending_review_document_count": { "type": "integer", "minimum": 0 },
        "blocked_delivery_submitted_document_count": { "type": "integer", "minimum": 0 },
        "legal_advice_provided": { "const": false },
        "client_facing_output_generated": { "const": false },
        "desktop_boundary_status": { "type": "string" },
        "desktop_read_only": { "const": true },
        "desktop_mutation_allowed": { "const": false },
        "desktop_source_of_truth": { "const": false },
        "matter_data_write_allowed": { "const": false },
        "runtime_execution_allowed": { "const": false },
        "delivery_execution_allowed": { "const": false },
        "client_facing_output_allowed_without_attorney_review": { "const": false },
        "failed_checkpoint_count": { "type": "integer", "minimum": 0 },
        "validation_item_count": { "type": "integer", "minimum": 0 },
        "validation_error_count": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
