    "capability_id": { "const": "platform.ui_projection_replay_ledger" },
    "program_range": { "const": "P33201-P33600" },
    "source_program_range": { "const": "P32801-P33200" },
    "ui_projection_replay_ledger_phase_rows": { "type": "array", "minItems": 7, "items": { "$ref": "#/$defs/verdictRow" } },
