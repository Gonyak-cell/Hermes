    "global_ui_design_foundation_gate_rows": { "type": "array", "minItems": 16, "items": { "$ref": "#/$defs/verdictRow" } },
    "global_ui_design_foundation_boundary": {
      "type": "object",
      "required": [
        "source_global_ui_contract_ready",
        "source_ready_for_p11201_handoff",
        "global_ui_design_foundation_ready",
        "design_tokens_ready",
        "table_list_primitives_ready",
        "detail_inspector_primitives_ready",
        "timeline_primitives_ready",
        "boundary_notice_receipt_ready",
        "readiness_rule_matrix_ready",
        "review_evidence_trace_ready",
        "component_state_matrix_ready",
        "ui_smoke_fixture_plan_ready",
