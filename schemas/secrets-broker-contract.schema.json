{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://amic.local/hermes/secrets-broker-contract.schema.json",
  "title": "Hermes Secrets Broker Contract",
  "type": "object",
  "required": [
    "schema_version",
    "generated_at",
    "secrets_broker_contract_id",
    "output_dir",
    "inputs",
    "source_contracts",
    "secrets_broker_contract",
    "secret_handle_policies",
    "runtime_secret_access_bindings",
    "secret_audit_bindings",
    "secrets_desktop_boundary",
    "summary",
    "validation_items",
    "validation"
  ],
  "properties": {
    "schema_version": { "const": "secrets-broker-contract.v1" },
    "generated_at": { "type": "string", "format": "date-time" },
    "secrets_broker_contract_id": { "type": "string" },
    "output_dir": { "type": "string" },
    "inputs": {
      "type": "object",
      "required": [
        "runtime_adapter_interface_v2_path",
        "sandbox_policy_model_path",
        "docker_local_backend_selector_path",
        "tool_runtime_policy_enforcement_path",
        "policy_matrix_path",
        "desktop_companion_integration_path"
      ]
    },
    "source_contracts": {
      "type": "object",
      "required": [
        "runtime_adapter_interface_v2",
        "sandbox_policy_model",
        "docker_local_backend_selector",
        "tool_runtime_policy_enforcement",
        "policy_matrix",
        "desktop_companion_integration"
      ],
      "properties": {
        "runtime_adapter_interface_v2": {
          "type": "object",
          "required": [
            "runtime_adapter_interface_status",
            "runtime_adapter_interface_count",
            "operator_surface_policy_count",
            "secret_material_exposed_count",
            "runtime_source_of_truth_count"
          ],
          "properties": {
            "runtime_adapter_interface_status": { "const": "complete" },
            "runtime_adapter_interface_count": { "type": "integer", "minimum": 1 },
            "operator_surface_policy_count": { "type": "integer", "minimum": 1 },
            "secret_material_exposed_count": { "const": 0 },
            "runtime_source_of_truth_count": { "const": 0 }
          }
        },
        "sandbox_policy_model": {
          "type": "object",
          "required": [
            "sandbox_policy_model_status",
            "contract_status",
            "runtime_sandbox_binding_count",
            "network_access_allowed_count",
            "external_transfer_allowed_count",
            "secret_material_allowed_count"
          ],
          "properties": {
            "sandbox_policy_model_status": { "const": "complete" },
            "contract_status": { "const": "locked" },
            "runtime_sandbox_binding_count": { "type": "integer", "minimum": 1 },
            "network_access_allowed_count": { "const": 0 },
            "external_transfer_allowed_count": { "const": 0 },
            "secret_material_allowed_count": { "const": 0 }
          }
        },
        "docker_local_backend_selector": {
          "type": "object",
          "required": [
            "docker_local_backend_selector_status",
            "contract_status",
            "runtime_backend_selection_count",
            "selected_runtime_backend_count",
            "secret_material_allowed_count",
            "desktop_secret_material_exposed"
          ],
          "properties": {
            "docker_local_backend_selector_status": { "const": "complete" },
            "contract_status": { "const": "locked" },
            "runtime_backend_selection_count": { "type": "integer", "minimum": 1 },
            "selected_runtime_backend_count": { "type": "integer", "minimum": 1 },
            "secret_material_allowed_count": { "const": 0 },
            "desktop_secret_material_exposed": { "const": false }
          }
        },
        "tool_runtime_policy_enforcement": {
          "type": "object",
          "required": [
            "tool_runtime_policy_enforcement_status",
            "runtime_policy_gate_count",
            "tool_permission_gate_count",
            "protected_action_tool_gate_count"
          ],
          "properties": {
            "tool_runtime_policy_enforcement_status": { "const": "complete" },
            "runtime_policy_gate_count": { "type": "integer", "minimum": 1 },
            "tool_permission_gate_count": { "type": "integer", "minimum": 1 },
            "protected_action_tool_gate_count": { "type": "integer", "minimum": 1 }
          }
        },
        "policy_matrix": {
          "type": "object",
          "required": ["classification_level_count", "p5_secret_present"],
          "properties": {
            "classification_level_count": { "type": "integer", "minimum": 6 },
            "p5_secret_present": { "const": true }
          }
        },
        "desktop_companion_integration": {
          "type": "object",
          "required": [
            "declares_read_only",
            "declares_not_runtime_source_of_truth",
            "declares_human_gate_for_mutation",
            "blocks_secret_or_provider_key_control",
            "blocks_installer_gateway_or_ssh_control"
          ],
          "properties": {
            "declares_read_only": { "const": true },
            "declares_not_runtime_source_of_truth": { "const": true },
            "declares_human_gate_for_mutation": { "const": true },
            "blocks_secret_or_provider_key_control": { "const": true },
            "blocks_installer_gateway_or_ssh_control": { "const": true }
          }
        }
      }
    },
    "secrets_broker_contract": {
      "type": "object",
      "required": [
        "broker_contract_id",
        "contract_status",
        "broker_status",
        "source_of_truth",
        "secret_material_source_of_truth",
        "secret_handle_required",
        "audit_required",
        "policy_snapshot_required",
        "raw_secret_material_persisted",
        "raw_secret_material_exposed_to_runtime",
        "raw_secret_material_exposed_to_desktop",
        "raw_secret_material_logged",
        "provider_key_direct_access_allowed",
        "provider_key_visible_to_desktop",
        "protected_mutation_route",
        "human_gate_required_for_secret_exception",
        "desktop_read_only",
        "desktop_mutation_allowed",
        "desktop_source_of_truth"
      ],
      "properties": {
        "broker_contract_id": { "const": "secrets-broker.default" },
        "contract_status": { "const": "locked" },
        "broker_status": { "const": "locked" },
        "source_of_truth": { "const": "harness_control_plane" },
        "secret_material_source_of_truth": { "const": "external_secret_store_handle_registry" },
        "secret_handle_required": { "const": true },
        "audit_required": { "const": true },
        "policy_snapshot_required": { "const": true },
        "raw_secret_material_persisted": { "const": false },
        "raw_secret_material_exposed_to_runtime": { "const": false },
        "raw_secret_material_exposed_to_desktop": { "const": false },
        "raw_secret_material_logged": { "const": false },
        "provider_key_direct_access_allowed": { "const": false },
        "provider_key_visible_to_desktop": { "const": false },
        "runtime_self_report_trusted_for_secret_access": { "const": false },
        "protected_mutation_route": { "const": "protected_action_request_only" },
        "human_gate_required_for_secret_exception": { "const": true },
        "desktop_read_only": { "const": true },
        "desktop_mutation_allowed": { "const": false },
        "desktop_protected_mutation_execution_allowed": { "const": false },
        "desktop_source_of_truth": { "const": false }
      }
    },
    "secret_handle_policies": {
      "type": "array",
      "minItems": 8,
      "items": {
        "type": "object",
        "required": [
          "secret_handle_policy_id",
          "secret_kind",
          "policy_status",
          "access_mode",
          "secret_handle_required",
          "raw_secret_material_persisted",
          "raw_secret_material_exposed",
          "raw_secret_material_logged",
          "provider_key_direct_access_allowed",
          "desktop_secret_material_exposed",
          "desktop_provider_key_visible",
          "audit_required",
          "policy_snapshot_required",
          "protected_mutation_route",
          "source_of_truth"
        ],
        "properties": {
          "policy_status": { "const": "locked" },
          "access_mode": { "const": "handle_ref_only" },
          "secret_handle_required": { "const": true },
          "raw_secret_material_persisted": { "const": false },
          "raw_secret_material_exposed": { "const": false },
          "raw_secret_material_logged": { "const": false },
          "provider_key_direct_access_allowed": { "const": false },
          "desktop_secret_material_exposed": { "const": false },
          "desktop_provider_key_visible": { "const": false },
          "audit_required": { "const": true },
          "policy_snapshot_required": { "const": true },
          "protected_mutation_route": { "const": "protected_action_request_only" },
          "source_of_truth": { "const": "harness_control_plane" }
        }
      }
    },
    "runtime_secret_access_bindings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "runtime_secret_access_binding_id",
          "runtime_id",
          "backend_selection_status",
          "secret_access_status",
          "secret_handle_required_for_secret_use",
          "raw_secret_material_allowed",
          "raw_secret_material_exposed_to_runtime",
          "raw_secret_material_exposed_to_desktop",
          "provider_key_direct_access_allowed",
          "provider_key_visible_to_desktop",
          "policy_snapshot_required",
          "audit_required",
          "audit_binding_id",
          "p5_secret_access_status",
          "protected_mutation_route",
          "desktop_read_only",
          "desktop_mutation_allowed",
          "desktop_secret_material_exposed",
          "desktop_provider_key_visible",
          "source_of_truth",
          "runtime_source_of_truth"
        ],
        "properties": {
          "secret_access_status": {
            "enum": [
              "brokered_handle_only",
              "handle_optional",
              "metadata_only",
              "receipt_reference_only",
              "blocked",
              "not_applicable"
            ]
          },
          "secret_handle_required_for_secret_use": { "const": true },
          "raw_secret_material_allowed": { "const": false },
          "raw_secret_material_exposed_to_runtime": { "const": false },
          "raw_secret_material_exposed_to_desktop": { "const": false },
          "provider_key_direct_access_allowed": { "const": false },
          "provider_key_visible_to_desktop": { "const": false },
          "policy_snapshot_required": { "const": true },
          "audit_required": { "const": true },
          "p5_secret_access_status": { "const": "blocked_raw_secret_handle_only" },
          "protected_mutation_route": { "const": "protected_action_request_only" },
          "desktop_read_only": { "const": true },
          "desktop_mutation_allowed": { "const": false },
          "desktop_secret_material_exposed": { "const": false },
          "desktop_provider_key_visible": { "const": false },
          "source_of_truth": { "const": "harness_control_plane" },
          "runtime_source_of_truth": { "const": false }
        }
      }
    },
    "secret_audit_bindings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "secret_audit_binding_id",
          "runtime_id",
          "audit_sink",
          "audit_event_type",
          "audit_binding_status",
          "actor_binding_required",
          "correlation_id_required",
          "policy_snapshot_required",
          "secret_handle_ref_recorded",
          "raw_secret_material_logged",
          "provider_key_logged",
          "desktop_secret_material_exposed",
          "protected_mutation_route",
          "source_of_truth"
        ],
        "properties": {
          "audit_sink": { "const": "audit_event_ledger" },
          "audit_binding_status": { "const": "locked" },
          "actor_binding_required": { "const": true },
          "correlation_id_required": { "const": true },
          "policy_snapshot_required": { "const": true },
          "secret_handle_ref_recorded": { "const": true },
          "raw_secret_material_logged": { "const": false },
          "provider_key_logged": { "const": false },
          "desktop_secret_material_exposed": { "const": false },
          "protected_mutation_route": { "const": "protected_action_request_only" },
          "source_of_truth": { "const": "harness_control_plane" }
        }
      }
    },
    "secrets_desktop_boundary": {
      "type": "object",
      "required": [
        "boundary_id",
        "boundary_status",
        "desktop_surface",
        "desktop_surface_policy",
        "source_of_truth",
        "desktop_source_of_truth",
        "read_only",
        "mutation_allowed",
        "protected_mutation_request_allowed",
        "protected_mutation_execution_allowed",
        "secret_material_exposed",
        "provider_key_visible",
        "credential_export_allowed",
        "local_secret_store_write_allowed",
        "installer_or_gateway_control",
        "ssh_or_cron_control",
        "protected_mutation_route",
        "human_gate_required_for_exception"
      ],
      "properties": {
        "boundary_id": { "const": "secrets-broker.desktop-boundary" },
        "boundary_status": { "const": "locked" },
        "desktop_surface": { "const": "secrets_broker" },
        "desktop_surface_policy": { "const": "read_only_secret_handle_status" },
        "source_of_truth": { "const": "harness_control_plane" },
        "desktop_source_of_truth": { "const": false },
        "read_only": { "const": true },
        "mutation_allowed": { "const": false },
        "protected_mutation_request_allowed": { "const": false },
        "protected_mutation_execution_allowed": { "const": false },
        "secret_material_exposed": { "const": false },
        "provider_key_visible": { "const": false },
        "credential_export_allowed": { "const": false },
        "local_secret_store_write_allowed": { "const": false },
        "installer_or_gateway_control": { "const": false },
        "ssh_or_cron_control": { "const": false },
        "protected_mutation_route": { "const": "protected_action_request_only" },
        "human_gate_required_for_exception": { "const": true }
      }
    },
    "summary": {
      "type": "object",
      "required": [
        "secrets_broker_contract_status",
        "broker_contract_id",
        "contract_status",
        "broker_status",
        "secret_handle_required",
        "audit_required",
        "policy_snapshot_required",
        "raw_secret_material_persisted",
        "raw_secret_material_exposed_to_runtime",
        "raw_secret_material_exposed_to_desktop",
        "raw_secret_material_logged",
        "provider_key_direct_access_allowed",
        "provider_key_visible_to_desktop",
        "secret_handle_policy_count",
        "runtime_secret_access_binding_count",
        "secret_audit_binding_count",
        "raw_secret_material_allowed_count",
        "runtime_raw_secret_exposed_count",
        "desktop_secret_material_exposed_count",
        "provider_key_direct_access_allowed_count",
        "provider_key_visible_to_desktop_count",
        "raw_secret_material_logged_count",
        "provider_key_logged_count",
        "protected_mutation_route",
        "human_gate_required_for_secret_exception",
        "desktop_read_only",
        "desktop_mutation_allowed",
        "desktop_secret_material_exposed",
        "desktop_provider_key_visible",
        "desktop_source_of_truth",
        "validation_error_count"
      ],
      "properties": {
        "secrets_broker_contract_status": { "const": "complete" },
        "broker_contract_id": { "const": "secrets-broker.default" },
        "contract_status": { "const": "locked" },
        "broker_status": { "const": "locked" },
        "secret_handle_required": { "const": true },
        "audit_required": { "const": true },
        "policy_snapshot_required": { "const": true },
        "raw_secret_material_persisted": { "const": false },
        "raw_secret_material_exposed_to_runtime": { "const": false },
        "raw_secret_material_exposed_to_desktop": { "const": false },
        "raw_secret_material_logged": { "const": false },
        "provider_key_direct_access_allowed": { "const": false },
        "provider_key_visible_to_desktop": { "const": false },
        "secret_handle_policy_count": { "type": "integer", "minimum": 8 },
        "runtime_secret_access_binding_count": { "type": "integer", "minimum": 1 },
        "secret_audit_binding_count": { "type": "integer", "minimum": 1 },
        "raw_secret_material_allowed_count": { "const": 0 },
        "runtime_raw_secret_exposed_count": { "const": 0 },
        "desktop_secret_material_exposed_count": { "const": 0 },
        "provider_key_direct_access_allowed_count": { "const": 0 },
        "provider_key_visible_to_desktop_count": { "const": 0 },
        "raw_secret_material_logged_count": { "const": 0 },
        "provider_key_logged_count": { "const": 0 },
        "protected_mutation_route": { "const": "protected_action_request_only" },
        "human_gate_required_for_secret_exception": { "const": true },
        "desktop_read_only": { "const": true },
        "desktop_mutation_allowed": { "const": false },
        "desktop_protected_mutation_execution_allowed": { "const": false },
        "desktop_secret_material_exposed": { "const": false },
        "desktop_provider_key_visible": { "const": false },
        "desktop_source_of_truth": { "const": false },
        "validation_error_count": { "const": 0 }
      }
    },
    "validation_items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["scope", "check_id", "status", "message"],
        "properties": {
          "status": { "enum": ["passed", "failed"] }
        }
      }
    },
    "validation": {
      "type": "object",
      "required": ["valid", "error_count", "errors"],
      "properties": {
        "valid": { "const": true },
        "error_count": { "const": 0 },
        "errors": {
          "type": "array",
          "maxItems": 0
        }
      }
    }
  }
}
