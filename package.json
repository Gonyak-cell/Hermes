    "delivery:closeout:validate": "node scripts/delivery-closeout-receipt-validation.mjs",
    "delivery:execution:draft": "node scripts/delivery-execution-draft.mjs",
    "delivery:queue": "node scripts/protected-delivery-queue.mjs",
    "delivery:reconcile": "node scripts/post-delivery-reconciliation.mjs",
    "delivery:receipts": "node scripts/delivery-receipts.mjs",
    "deal": "node scripts/deal-control.mjs examples/project-alpha-matter.json",
    "dev:brief": "node scripts/dev-project-brief.mjs examples/dev-projects.json",
    "dev:validate": "node scripts/validate-dev-projects.mjs examples/dev-projects.json",
    "evidence:viewer": "node scripts/evidence-viewer.mjs",
