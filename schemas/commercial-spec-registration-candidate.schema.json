{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hermes.local/schemas/commercial-spec-registration-candidate.schema.json",
  "title": "Hermes Commercial Spec Registration Candidate",
  "type": "object",
  "required": [
    "schema_version",
    "generated_at",
    "capability_id",
    "program_range",
    "source_program_range",
    "commercial_spec_registration_phase_rows",
    "p34800_source_binding_rows",
    "commercial_spec_readiness_projection_rows",
    "requirement_traceability_binding_candidate_rows",
    "project_plan_registration_candidate_rows",
    "spec_conflict_freshness_blocker_rows",
    "operator_commercial_spec_projection_rows",
    "no_registration_authority_boundary_rows",
    "commercial_spec_registration_wiring_rows",
    "p35200_clean_checkpoint_rows",
    "commercial_spec_registration_boundary",
    "commercial_spec_registration_validation_items",
    "summary",
    "validation"
  ],
  "properties": {
    "schema_version": { "const": "commercial-spec-registration-candidate.v1" },
    "generated_at": { "type": "string", "format": "date-time" },
    "capability_id": { "const": "platform.commercial_spec_registration_candidate" },
    "program_range": { "const": "P34801-P35200" },
    "source_program_range": { "const": "P34401-P34800" },
    "commercial_spec_registration_phase_rows": { "type": "array", "minItems": 8, "items": { "$ref": "#/$defs/verdictRow" } },
    "p34800_source_binding_rows": { "type": "array", "minItems": 12, "items": { "$ref": "#/$defs/verdictRow" } },
    "commercial_spec_readiness_projection_rows": { "type": "array", "minItems": 3, "items": { "$ref": "#/$defs/verdictRow" } },
    "requirement_traceability_binding_candidate_rows": { "type": "array", "minItems": 3, "items": { "$ref": "#/$defs/verdictRow" } },
    "project_plan_registration_candidate_rows": { "type": "array", "minItems": 3, "items": { "$ref": "#/$defs/verdictRow" } },
    "spec_conflict_freshness_blocker_rows": { "type": "array", "minItems": 9, "items": { "$ref": "#/$defs/verdictRow" } },
    "operator_commercial_spec_projection_rows": { "type": "array", "minItems": 3, "items": { "$ref": "#/$defs/verdictRow" } },
    "no_registration_authority_boundary_rows": { "type": "array", "minItems": 340, "items": { "$ref": "#/$defs/verdictRow" } },
    "commercial_spec_registration_wiring_rows": { "type": "array", "minItems": 5, "items": { "$ref": "#/$defs/verdictRow" } },
    "p35200_clean_checkpoint_rows": { "type": "array", "minItems": 10, "items": { "$ref": "#/$defs/verdictRow" } },
    "commercial_spec_registration_validation_items": { "type": "array", "minItems": 15, "items": { "$ref": "#/$defs/validationItem" } },
    "summary": {
      "type": "object",
      "required": [
        "commercial_spec_registration_status",
        "source_p34800_ready_for_commercial_spec_registration",
        "commercial_spec_readiness_projection_count",
        "requirement_traceability_binding_candidate_count",
        "project_plan_registration_candidate_count",
        "blocker_count",
        "operator_projection_count",
        "actual_registration_allowed_count",
        "plan_registration_allowed_count",
        "spec_readiness_pass_allowed_count",
        "ready_for_plan_registry_control_plane_handoff",
        "commercial_spec_actual_registration_allowed_now",
        "commercial_spec_readiness_pass_allowed_now",
        "commercial_spec_requirement_traceability_pass_allowed_now",
        "commercial_spec_plan_registration_allowed_now",
        "commercial_spec_runtime_execution_allowed_now",
        "commercial_spec_write_action_allowed_now",
        "commercial_spec_protected_action_allowed_now",
        "commercial_spec_final_approval_allowed_now",
        "commercial_spec_production_pass_allowed_now",
        "production_pass_enabled"
      ],
      "properties": {
        "commercial_spec_registration_status": {
          "enum": [
            "ready_for_commercial_spec_registration_candidate",
            "valid_block_commercial_spec_registration_candidate_pending",
            "blocked_commercial_spec_registration_candidate"
          ]
        },
        "source_p34800_ready_for_commercial_spec_registration": { "type": "boolean" },
        "commercial_spec_readiness_projection_count": { "type": "number" },
        "requirement_traceability_binding_candidate_count": { "type": "number" },
        "project_plan_registration_candidate_count": { "type": "number" },
        "blocker_count": { "type": "number" },
        "operator_projection_count": { "type": "number" },
        "actual_registration_allowed_count": { "const": 0 },
        "plan_registration_allowed_count": { "const": 0 },
        "spec_readiness_pass_allowed_count": { "const": 0 },
        "ready_for_plan_registry_control_plane_handoff": { "type": "boolean" },
        "commercial_spec_actual_registration_allowed_now": { "const": false },
        "commercial_spec_readiness_pass_allowed_now": { "const": false },
        "commercial_spec_requirement_traceability_pass_allowed_now": { "const": false },
        "commercial_spec_plan_registration_allowed_now": { "const": false },
        "commercial_spec_runtime_execution_allowed_now": { "const": false },
        "commercial_spec_write_action_allowed_now": { "const": false },
        "commercial_spec_protected_action_allowed_now": { "const": false },
        "commercial_spec_final_approval_allowed_now": { "const": false },
        "commercial_spec_production_pass_allowed_now": { "const": false },
        "production_pass_enabled": { "const": false },
        "enterprise_trust_claim_allowed_now": { "const": false },
        "validation_error_count": { "type": "number" }
      }
    },
    "commercial_spec_registration_boundary": {
      "type": "object",
      "required": [
        "p35200_contract_ready",
        "ready_for_plan_registry_control_plane_handoff",
        "source_p34800_ready_for_commercial_spec_registration",
        "commercial_spec_readiness_projection_visible_now",
        "requirement_traceability_binding_candidate_visible_now",
        "project_plan_registration_candidate_visible_now",
        "spec_conflict_freshness_blockers_visible_now",
        "operator_commercial_spec_projection_visible_now",
        "no_registration_authority_boundary_closed_now",
        "commercial_spec_registration_wiring_complete_now",
        "actual_registration_allowed_count",
        "plan_registration_allowed_count",
        "spec_readiness_pass_allowed_count",
        "commercial_spec_actual_registration_allowed_now",
        "commercial_spec_readiness_pass_allowed_now",
        "commercial_spec_plan_registration_allowed_now",
        "commercial_spec_final_approval_allowed_now",
        "commercial_spec_production_pass_allowed_now"
      ],
      "properties": {
        "p35200_contract_ready": { "type": "boolean" },
        "ready_for_plan_registry_control_plane_handoff": { "type": "boolean" },
        "source_p34800_ready_for_commercial_spec_registration": { "type": "boolean" },
        "source_validation_valid_now": { "type": "boolean" },
        "commercial_spec_readiness_projection_visible_now": { "type": "boolean" },
        "requirement_traceability_binding_candidate_visible_now": { "type": "boolean" },
        "project_plan_registration_candidate_visible_now": { "type": "boolean" },
        "spec_conflict_freshness_blockers_visible_now": { "type": "boolean" },
        "operator_commercial_spec_projection_visible_now": { "type": "boolean" },
        "no_registration_authority_boundary_closed_now": { "type": "boolean" },
        "commercial_spec_registration_wiring_complete_now": { "type": "boolean" },
        "commercial_spec_readiness_projection_count": { "type": "number" },
        "requirement_traceability_binding_candidate_count": { "type": "number" },
        "project_plan_registration_candidate_count": { "type": "number" },
        "blocker_count": { "type": "number" },
        "operator_projection_count": { "type": "number" },
        "actual_registration_allowed_count": { "const": 0 },
        "plan_registration_allowed_count": { "const": 0 },
        "spec_readiness_pass_allowed_count": { "const": 0 },
        "commercial_spec_actual_registration_allowed_now": { "const": false },
        "commercial_spec_readiness_pass_allowed_now": { "const": false },
        "commercial_spec_requirement_traceability_pass_allowed_now": { "const": false },
        "commercial_spec_plan_registration_allowed_now": { "const": false },
        "commercial_spec_conflict_bypass_allowed_now": { "const": false },
        "commercial_spec_freshness_bypass_allowed_now": { "const": false },
        "commercial_spec_operator_register_button_allowed_now": { "const": false },
        "commercial_spec_runtime_execution_allowed_now": { "const": false },
        "commercial_spec_write_action_allowed_now": { "const": false },
        "commercial_spec_protected_action_allowed_now": { "const": false },
        "commercial_spec_connector_write_allowed_now": { "const": false },
        "commercial_spec_deployment_allowed_now": { "const": false },
        "commercial_spec_review_completion_allowed_now": { "const": false },
        "commercial_spec_final_approval_allowed_now": { "const": false },
        "commercial_spec_production_pass_allowed_now": { "const": false },
        "commercial_spec_enterprise_trust_claim_allowed_now": { "const": false },
        "commercial_spec_secret_read_allowed_now": { "const": false },
        "commercial_spec_human_gate_bypass_allowed_now": { "const": false },
        "commercial_spec_independent_review_bypass_allowed_now": { "const": false },
        "commercial_spec_final_automated_approval_allowed_now": { "const": false },
        "production_pass_enabled": { "const": false },
        "enterprise_trust_claim_allowed_now": { "const": false }
      }
    },
    "validation": {
      "type": "object",
      "required": ["valid", "error_count", "errors"],
      "properties": {
        "valid": { "type": "boolean" },
        "error_count": { "type": "number" },
        "errors": { "type": "array" }
      }
    }
  },
  "$defs": {
    "verdictRow": {
      "type": "object",
      "required": ["row_id", "category", "label", "observed", "current_verdict", "block_reason", "evidence_ref"],
      "properties": {
        "row_id": { "type": "string" },
        "category": { "type": "string" },
        "label": { "type": "string" },
        "observed": { "type": "boolean" },
        "current_verdict": { "enum": ["pass", "block"] },
        "block_reason": { "type": ["string", "null"] },
        "evidence_ref": { "type": ["string", "null"] },
        "generated_at": { "type": "string" }
      },
      "additionalProperties": true
    },
    "validationItem": {
      "allOf": [{ "$ref": "#/$defs/verdictRow" }]
    }
  }
}
