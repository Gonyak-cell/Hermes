{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://amic.local/hermes/human-review-agenda-receipt-intake.schema.json",
  "title": "Hermes Human Review Agenda Receipt Intake",
  "type": "object",
  "required": [
    "schema_version",
    "generated_at",
    "intake_id",
    "output_dir",
    "intake_status",
    "safe_handling",
    "sources",
    "summary",
    "intake_items",
    "receipt_input",
    "validation"
  ],
  "properties": {
    "schema_version": { "const": "human-review-agenda-receipt-intake.v1" },
    "generated_at": { "type": "string", "format": "date-time" },
    "intake_id": { "type": "string" },
    "output_dir": { "type": "string" },
    "intake_status": { "enum": ["clear", "pending_receipts", "ready_for_validation", "blocked"] },
    "safe_handling": {
      "type": "object",
      "required": ["auto_execute_allowed", "draft_only", "validates_only", "protected_actions_executed"],
      "properties": {
        "auto_execute_allowed": { "const": false },
        "draft_only": { "type": "boolean" },
        "validates_only": { "type": "boolean" },
        "protected_actions_executed": { "const": false }
      }
    },
    "sources": {
      "type": "array",
      "items": { "$ref": "#/$defs/source" }
    },
    "summary": {
      "type": "object",
      "required": [
        "intake_item_count",
        "receipt_row_count",
        "pending_receipt_count",
        "ready_for_validation_count",
        "invalid_template_row_count",
        "missing_template_row_count",
        "unknown_requirement_count",
        "protected_action_count",
        "human_required_count",
        "evidence_decision_count",
        "validation_error_count",
        "by_intake_status",
        "by_receipt_status",
        "by_gate_type",
        "by_required_actor"
      ],
      "properties": {
        "intake_item_count": { "type": "integer", "minimum": 0 },
        "receipt_row_count": { "type": "integer", "minimum": 0 },
        "pending_receipt_count": { "type": "integer", "minimum": 0 },
        "ready_for_validation_count": { "type": "integer", "minimum": 0 },
        "invalid_template_row_count": { "type": "integer", "minimum": 0 },
        "missing_template_row_count": { "type": "integer", "minimum": 0 },
        "unknown_requirement_count": { "type": "integer", "minimum": 0 },
        "protected_action_count": { "type": "integer", "minimum": 0 },
        "human_required_count": { "type": "integer", "minimum": 0 },
        "evidence_decision_count": { "type": "integer", "minimum": 0 },
        "validation_error_count": { "type": "integer", "minimum": 0 },
        "by_intake_status": { "type": "object" },
        "by_receipt_status": { "type": "object" },
        "by_gate_type": { "type": "object" },
        "by_required_actor": { "type": "object" }
      }
    },
    "intake_items": {
      "type": "array",
      "items": { "$ref": "#/$defs/intake_item" }
    },
    "receipt_input": { "$ref": "#/$defs/receipt_input" },
    "validation": { "$ref": "#/$defs/validation" }
  },
  "$defs": {
    "source": {
      "type": "object",
      "required": ["source_id", "label", "path", "available", "schema_version", "generated_at", "summary", "error"],
      "properties": {
        "source_id": { "type": "string" },
        "label": { "type": "string" },
        "path": { "type": "string" },
        "available": { "type": "boolean" },
        "schema_version": { "type": ["string", "null"] },
        "generated_at": { "type": ["string", "null"], "format": "date-time" },
        "summary": { "type": ["object", "null"] },
        "error": { "type": ["string", "null"] }
      }
    },
    "intake_item": {
      "type": "object",
      "required": [
        "intake_item_id",
        "receipt_requirement_id",
        "gate_item_id",
        "source_plan_item_id",
        "source_stage",
        "gate_type",
        "priority",
        "required_actor",
        "requires_human",
        "protected_action",
        "receipt_id",
        "receipt_status",
        "outcome",
        "intake_status",
        "ready_for_validation",
        "template_row_present",
        "error_count",
        "errors",
        "receipt",
        "safe_handling"
      ],
      "properties": {
        "intake_item_id": { "type": "string" },
        "receipt_requirement_id": { "type": ["string", "null"] },
        "gate_item_id": { "type": "string" },
        "source_plan_item_id": { "type": "string" },
        "source_stage": { "type": "string" },
        "gate_type": { "type": "string" },
        "priority": { "enum": ["critical", "high", "medium", "low"] },
        "required_actor": { "type": "string" },
        "requires_human": { "type": "boolean" },
        "protected_action": { "type": "boolean" },
        "receipt_id": { "type": ["string", "null"] },
        "receipt_status": { "type": "string" },
        "outcome": { "type": "string" },
        "intake_status": { "enum": ["pending_receipt", "ready_for_validation", "invalid_template_row", "missing_template_row", "unknown_requirement"] },
        "ready_for_validation": { "type": "boolean" },
        "template_row_present": { "type": "boolean" },
        "error_count": { "type": "integer", "minimum": 0 },
        "errors": {
          "type": "array",
          "items": { "$ref": "#/$defs/error" }
        },
        "receipt": { "$ref": "#/$defs/receipt" },
        "safe_handling": {
          "type": "object",
          "required": ["auto_execute_allowed", "protected_actions_executed"],
          "properties": {
            "auto_execute_allowed": { "const": false },
            "protected_actions_executed": { "const": false }
          }
        }
      }
    },
    "receipt_input": {
      "type": "object",
      "required": ["schema_version", "generated_at", "human_gate_id", "instructions", "receipts"],
      "properties": {
        "schema_version": { "const": "control-plane-human-gate-receipts-input.v1" },
        "generated_at": { "type": "string", "format": "date-time" },
        "human_gate_id": { "type": "string" },
        "instructions": { "type": "string" },
        "receipts": {
          "type": "array",
          "items": { "$ref": "#/$defs/receipt" }
        }
      }
    },
    "receipt": {
      "type": "object",
      "required": [
        "receipt_id",
        "gate_item_id",
        "source_plan_item_id",
        "gate_type",
        "receipt_status",
        "outcome",
        "decided_by",
        "decided_at",
        "reviewer",
        "decision_reference",
        "decision_notes",
        "protected_action_reference",
        "command_result",
        "commands_run",
        "completed_action_refs",
        "required_receipt_fields",
        "generated_at"
      ],
      "properties": {
        "receipt_id": { "type": ["string", "null"] },
        "gate_item_id": { "type": ["string", "null"] },
        "source_plan_item_id": { "type": ["string", "null"] },
        "gate_type": { "type": ["string", "null"] },
        "receipt_status": { "type": "string" },
        "outcome": { "type": "string" },
        "decided_by": { "type": "string" },
        "decided_at": { "type": "string" },
        "reviewer": { "type": ["string", "null"] },
        "decision_reference": { "type": "string" },
        "decision_notes": { "type": "string" },
        "protected_action_reference": { "type": ["string", "null"] },
        "command_result": { "type": ["string", "null"] },
        "commands_run": { "type": "array", "items": { "type": "string" } },
        "completed_action_refs": { "type": "array", "items": { "type": "string" } },
        "required_receipt_fields": { "type": "array", "items": { "type": "string" } },
        "generated_at": { "type": "string", "format": "date-time" }
      }
    },
    "validation": {
      "type": "object",
      "required": ["valid", "errors"],
      "properties": {
        "valid": { "type": "boolean" },
        "errors": {
          "type": "array",
          "items": { "$ref": "#/$defs/error" }
        }
      }
    },
    "error": {
      "type": "object",
      "required": ["path", "message"],
      "properties": {
        "path": { "type": "string" },
        "message": { "type": "string" }
      }
    }
  }
}
