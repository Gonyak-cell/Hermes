{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://amic.local/hermes/matter-profile-team-ledger.schema.json",
  "title": "Hermes Matter Profile Team Ledger",
  "type": "object",
  "required": [
    "schema_version",
    "generated_at",
    "ledger_id",
    "output_dir",
    "inputs",
    "source_matter_contract",
    "source_identity_model",
    "source_client_counterparty_registry",
    "matter_team_contract",
    "validation_items",
    "validation",
    "summary"
  ],
  "properties": {
    "schema_version": { "const": "matter-profile-team-ledger.v1" },
    "generated_at": { "type": "string", "format": "date-time" },
    "ledger_id": { "type": "string" },
    "output_dir": { "type": "string" },
    "inputs": {
      "type": "object",
      "required": ["matter_contract_freeze_path", "identity_model_path", "client_counterparty_registry_path"],
      "properties": {
        "matter_contract_freeze_path": { "type": "string" },
        "identity_model_path": { "type": "string" },
        "client_counterparty_registry_path": { "type": "string" }
      }
    },
    "source_matter_contract": { "$ref": "#/$defs/source_matter_contract" },
    "source_identity_model": { "$ref": "#/$defs/source_identity_model" },
    "source_client_counterparty_registry": { "$ref": "#/$defs/source_client_counterparty_registry" },
    "matter_team_contract": {
      "type": "object",
      "required": [
        "schema_version",
        "generated_at",
        "matter_profiles",
        "matter_team_rosters",
        "matter_team_memberships",
        "matter_access_subjects"
      ],
      "properties": {
        "schema_version": { "const": "matter-profile-team-contract.v1" },
        "generated_at": { "type": "string", "format": "date-time" },
        "matter_profiles": { "type": "array", "items": { "$ref": "#/$defs/matter_profile" } },
        "matter_team_rosters": { "type": "array", "items": { "$ref": "#/$defs/matter_team_roster" } },
        "matter_team_memberships": { "type": "array", "items": { "$ref": "#/$defs/matter_team_membership" } },
        "matter_access_subjects": { "type": "array", "items": { "$ref": "#/$defs/matter_access_subject" } }
      }
    },
    "validation_items": { "type": "array", "items": { "$ref": "#/$defs/validation_item" } },
    "validation": { "$ref": "#/$defs/validation" },
    "summary": { "$ref": "#/$defs/summary" }
  },
  "$defs": {
    "source_matter_contract": {
      "type": "object",
      "required": ["schema_version", "freeze_id", "freeze_status", "matter_count", "matter_team_count", "matter_boundary_count"],
      "properties": {
        "schema_version": { "type": ["string", "null"] },
        "freeze_id": { "type": ["string", "null"] },
        "freeze_status": { "type": "string" },
        "matter_count": { "type": "integer", "minimum": 0 },
        "matter_team_count": { "type": "integer", "minimum": 0 },
        "matter_boundary_count": { "type": "integer", "minimum": 0 }
      }
    },
    "source_identity_model": {
      "type": "object",
      "required": ["schema_version", "identity_model_id", "identity_model_status", "user_count", "role_assignment_count"],
      "properties": {
        "schema_version": { "type": ["string", "null"] },
        "identity_model_id": { "type": ["string", "null"] },
        "identity_model_status": { "type": "string" },
        "user_count": { "type": "integer", "minimum": 0 },
        "role_assignment_count": { "type": "integer", "minimum": 0 }
      }
    },
    "source_client_counterparty_registry": {
      "type": "object",
      "required": ["schema_version", "registry_id", "registry_status", "client_count", "matter_party_link_count", "conflict_reference_count"],
      "properties": {
        "schema_version": { "type": ["string", "null"] },
        "registry_id": { "type": ["string", "null"] },
        "registry_status": { "type": "string" },
        "client_count": { "type": "integer", "minimum": 0 },
        "matter_party_link_count": { "type": "integer", "minimum": 0 },
        "conflict_reference_count": { "type": "integer", "minimum": 0 }
      }
    },
    "matter_profile": {
      "type": "object",
      "required": [
        "schema_version",
        "matter_profile_id",
        "matter_id",
        "tenant_id",
        "client_id",
        "client_registry_id",
        "stable_client_party_id",
        "matter_name",
        "practice_area",
        "matter_status",
        "classification",
        "classification_floor",
        "default_policy_snapshot_id",
        "matter_team_id",
        "matter_team_roster_id",
        "matter_boundary_id",
        "access_scope",
        "wall_ids",
        "party_ids",
        "counterparty_party_ids",
        "conflict_ref_ids",
        "team_member_user_ids",
        "responsible_partner_user_ids",
        "reviewer_user_ids",
        "profile_status",
        "created_at",
        "source_schema_version",
        "metadata"
      ],
      "properties": {
        "schema_version": { "const": "matter-profile.v1" },
        "matter_profile_id": { "type": "string" },
        "matter_id": { "type": "string" },
        "tenant_id": { "type": "string" },
        "client_id": { "type": "string" },
        "client_registry_id": { "type": ["string", "null"] },
        "stable_client_party_id": { "type": ["string", "null"] },
        "matter_name": { "type": "string" },
        "practice_area": { "type": "string" },
        "matter_status": { "type": "string" },
        "classification": { "type": "string" },
        "classification_floor": { "type": "string" },
        "default_policy_snapshot_id": { "type": ["string", "null"] },
        "matter_team_id": { "type": ["string", "null"] },
        "matter_team_roster_id": { "type": ["string", "null"] },
        "matter_boundary_id": { "type": ["string", "null"] },
        "access_scope": { "type": "string" },
        "wall_ids": { "type": "array", "items": { "type": "string" } },
        "party_ids": { "type": "array", "items": { "type": "string" } },
        "counterparty_party_ids": { "type": "array", "items": { "type": "string" } },
        "conflict_ref_ids": { "type": "array", "items": { "type": "string" } },
        "team_member_user_ids": { "type": "array", "items": { "type": "string" } },
        "responsible_partner_user_ids": { "type": "array", "items": { "type": "string" } },
        "reviewer_user_ids": { "type": "array", "items": { "type": "string" } },
        "profile_status": { "enum": ["active", "archived"] },
        "created_at": { "type": "string", "format": "date-time" },
        "source_schema_version": { "type": ["string", "null"] },
        "metadata": { "type": "object" }
      }
    },
    "matter_team_roster": {
      "type": "object",
      "required": [
        "schema_version",
        "team_roster_id",
        "matter_team_id",
        "matter_id",
        "tenant_id",
        "client_id",
        "team_status",
        "access_scope",
        "member_count",
        "active_member_count",
        "membership_ids",
        "member_user_ids",
        "responsible_partner_user_ids",
        "reviewer_user_ids",
        "wall_ids",
        "created_at",
        "source_schema_version",
        "metadata"
      ],
      "properties": {
        "schema_version": { "const": "matter-team-roster.v1" },
        "team_roster_id": { "type": "string" },
        "matter_team_id": { "type": "string" },
        "matter_id": { "type": "string" },
        "tenant_id": { "type": "string" },
        "client_id": { "type": "string" },
        "team_status": { "type": "string" },
        "access_scope": { "type": "string" },
        "member_count": { "type": "integer", "minimum": 0 },
        "active_member_count": { "type": "integer", "minimum": 0 },
        "membership_ids": { "type": "array", "items": { "type": "string" } },
        "member_user_ids": { "type": "array", "items": { "type": "string" } },
        "responsible_partner_user_ids": { "type": "array", "items": { "type": "string" } },
        "reviewer_user_ids": { "type": "array", "items": { "type": "string" } },
        "wall_ids": { "type": "array", "items": { "type": "string" } },
        "created_at": { "type": "string", "format": "date-time" },
        "source_schema_version": { "type": ["string", "null"] },
        "metadata": { "type": "object" }
      }
    },
    "matter_team_membership": {
      "type": "object",
      "required": [
        "schema_version",
        "membership_id",
        "matter_id",
        "matter_team_id",
        "tenant_id",
        "client_id",
        "user_id",
        "display_name",
        "human_actor_principal_id",
        "matter_role",
        "role_assignment_ids",
        "membership_status",
        "access_basis",
        "access_decision",
        "access_scope",
        "can_read",
        "can_write",
        "can_approve",
        "wall_ids",
        "classification_floor",
        "created_at",
        "source_schema_version",
        "metadata"
      ],
      "properties": {
        "schema_version": { "const": "matter-team-membership.v1" },
        "membership_id": { "type": "string" },
        "matter_id": { "type": "string" },
        "matter_team_id": { "type": "string" },
        "tenant_id": { "type": "string" },
        "client_id": { "type": "string" },
        "user_id": { "type": "string" },
        "display_name": { "type": "string" },
        "human_actor_principal_id": { "type": ["string", "null"] },
        "matter_role": { "type": "string" },
        "role_assignment_ids": { "type": "array", "items": { "type": "string" } },
        "membership_status": { "enum": ["active", "inactive", "superseded"] },
        "access_basis": { "enum": ["team_membership"] },
        "access_decision": { "enum": ["allow"] },
        "access_scope": { "type": "string" },
        "can_read": { "type": "boolean" },
        "can_write": { "type": "boolean" },
        "can_approve": { "type": "boolean" },
        "wall_ids": { "type": "array", "items": { "type": "string" } },
        "classification_floor": { "type": ["string", "null"] },
        "created_at": { "type": "string", "format": "date-time" },
        "source_schema_version": { "type": ["string", "null"] },
        "metadata": { "type": "object" }
      }
    },
    "matter_access_subject": {
      "type": "object",
      "required": [
        "schema_version",
        "access_subject_id",
        "matter_id",
        "tenant_id",
        "client_id",
        "subject_type",
        "user_id",
        "human_actor_principal_id",
        "membership_id",
        "matter_role_ids",
        "matter_roles",
        "tenant_role_ids",
        "access_basis",
        "access_decision",
        "access_scope",
        "can_read",
        "can_write",
        "can_approve",
        "wall_ids",
        "classification_floor",
        "policy_snapshot_id",
        "created_at",
        "metadata"
      ],
      "properties": {
        "schema_version": { "const": "matter-access-subject.v1" },
        "access_subject_id": { "type": "string" },
        "matter_id": { "type": "string" },
        "tenant_id": { "type": "string" },
        "client_id": { "type": "string" },
        "subject_type": { "enum": ["human_user"] },
        "user_id": { "type": "string" },
        "human_actor_principal_id": { "type": "string" },
        "membership_id": { "type": ["string", "null"] },
        "matter_role_ids": { "type": "array", "items": { "type": "string" } },
        "matter_roles": { "type": "array", "items": { "type": "string" } },
        "tenant_role_ids": { "type": "array", "items": { "type": "string" } },
        "access_basis": { "enum": ["team_membership", "no_team_membership"] },
        "access_decision": { "enum": ["allow", "deny", "review"] },
        "access_scope": { "type": "string" },
        "can_read": { "type": "boolean" },
        "can_write": { "type": "boolean" },
        "can_approve": { "type": "boolean" },
        "wall_ids": { "type": "array", "items": { "type": "string" } },
        "classification_floor": { "type": ["string", "null"] },
        "policy_snapshot_id": { "type": ["string", "null"] },
        "created_at": { "type": "string", "format": "date-time" },
        "metadata": { "type": "object" }
      }
    },
    "summary": {
      "type": "object",
      "required": [
        "ledger_status",
        "source_matter_contract_status",
        "source_identity_model_status",
        "source_client_counterparty_registry_status",
        "matter_profile_count",
        "matter_team_roster_count",
        "team_membership_count",
        "active_team_membership_count",
        "matter_access_subject_count",
        "allowed_access_subject_count",
        "denied_access_subject_count",
        "matter_with_team_count",
        "matter_with_responsible_partner_count",
        "team_member_user_count",
        "validation_item_count",
        "failed_validation_item_count",
        "validation_error_count",
        "by_matter_status",
        "by_practice_area",
        "by_matter_role",
        "by_access_decision",
        "by_tenant_id"
      ],
      "properties": {
        "ledger_status": { "enum": ["complete", "blocked"] },
        "source_matter_contract_status": { "type": "string" },
        "source_identity_model_status": { "type": "string" },
        "source_client_counterparty_registry_status": { "type": "string" },
        "matter_profile_count": { "type": "integer", "minimum": 0 },
        "matter_team_roster_count": { "type": "integer", "minimum": 0 },
        "team_membership_count": { "type": "integer", "minimum": 0 },
        "active_team_membership_count": { "type": "integer", "minimum": 0 },
        "matter_access_subject_count": { "type": "integer", "minimum": 0 },
        "allowed_access_subject_count": { "type": "integer", "minimum": 0 },
        "denied_access_subject_count": { "type": "integer", "minimum": 0 },
        "matter_with_team_count": { "type": "integer", "minimum": 0 },
        "matter_with_responsible_partner_count": { "type": "integer", "minimum": 0 },
        "team_member_user_count": { "type": "integer", "minimum": 0 },
        "validation_item_count": { "type": "integer", "minimum": 0 },
        "failed_validation_item_count": { "type": "integer", "minimum": 0 },
        "validation_error_count": { "type": "integer", "minimum": 0 },
        "by_matter_status": { "type": "object" },
        "by_practice_area": { "type": "object" },
        "by_matter_role": { "type": "object" },
        "by_access_decision": { "type": "object" },
        "by_tenant_id": { "type": "object" }
      }
    },
    "validation_item": {
      "type": "object",
      "required": ["validation_id", "subject_type", "subject_id", "check_id", "status", "severity", "message"],
      "properties": {
        "validation_id": { "type": "string" },
        "subject_type": { "type": "string" },
        "subject_id": { "type": "string" },
        "check_id": { "type": "string" },
        "status": { "enum": ["passed", "failed"] },
        "severity": { "enum": ["info", "warning", "error"] },
        "message": { "type": "string" }
      }
    },
    "validation": {
      "type": "object",
      "required": ["valid", "errors"],
      "properties": {
        "valid": { "type": "boolean" },
        "errors": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["path", "message"],
            "properties": {
              "path": { "type": "string" },
              "message": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
