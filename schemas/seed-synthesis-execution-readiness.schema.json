{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hermes.local/schemas/seed-synthesis-execution-readiness.schema.json",
  "title": "Hermes Seed Synthesis Execution Readiness",
  "type": "object",
  "required": [
    "schema_version",
    "generated_at",
    "capability_id",
    "program_range",
    "source_program_range",
    "seed_synthesis_execution_readiness_phase_rows",
    "p32400_source_binding_rows",
    "seed_synthesis_candidate_rows",
    "execution_readiness_gate_rows",
    "seed_review_packet_candidate_rows",
    "seed_blocker_ledger_rows",
    "no_execution_boundary_rows",
    "p32800_clean_checkpoint_rows",
    "seed_synthesis_execution_readiness_boundary",
    "seed_synthesis_execution_readiness_validation_items",
    "summary",
    "validation"
  ],
  "properties": {
    "schema_version": { "const": "seed-synthesis-execution-readiness.v1" },
    "generated_at": { "type": "string", "format": "date-time" },
    "capability_id": { "const": "platform.seed_synthesis_execution_readiness" },
    "program_range": { "const": "P32401-P32800" },
    "source_program_range": { "const": "P32001-P32400" },
    "seed_synthesis_execution_readiness_phase_rows": { "type": "array", "minItems": 7, "items": { "$ref": "#/$defs/verdictRow" } },
    "p32400_source_binding_rows": { "type": "array", "minItems": 12, "items": { "$ref": "#/$defs/verdictRow" } },
    "seed_synthesis_candidate_rows": { "type": "array", "minItems": 3, "items": { "$ref": "#/$defs/verdictRow" } },
    "execution_readiness_gate_rows": { "type": "array", "minItems": 3, "items": { "$ref": "#/$defs/verdictRow" } },
    "seed_review_packet_candidate_rows": { "type": "array", "minItems": 3, "items": { "$ref": "#/$defs/verdictRow" } },
    "seed_blocker_ledger_rows": { "type": "array", "minItems": 3, "items": { "$ref": "#/$defs/verdictRow" } },
    "no_execution_boundary_rows": { "type": "array", "minItems": 300, "items": { "$ref": "#/$defs/verdictRow" } },
    "p32800_clean_checkpoint_rows": { "type": "array", "minItems": 8, "items": { "$ref": "#/$defs/verdictRow" } },
    "seed_synthesis_execution_readiness_validation_items": { "type": "array", "minItems": 15, "items": { "$ref": "#/$defs/validationItem" } },
    "summary": {
      "type": "object",
      "required": [
        "seed_synthesis_execution_readiness_status",
        "source_p32400_ready_for_seed_synthesis_candidate",
        "seed_synthesis_candidate_count",
        "execution_readiness_gate_count",
        "seed_review_packet_candidate_count",
        "seed_blocker_ledger_count",
        "final_seed_complete_count",
        "execution_ready_count",
        "readiness_blocker_count",
        "ready_for_defaults_no_fake_clarity_guard",
        "seed_synthesis_final_seed_allowed_now",
        "seed_synthesis_seed_auto_apply_allowed_now",
        "seed_synthesis_execution_ready_allowed_now",
        "seed_synthesis_runtime_execution_allowed_now",
        "seed_synthesis_write_action_allowed_now",
        "seed_synthesis_protected_action_allowed_now",
        "seed_synthesis_review_completion_allowed_now",
        "seed_synthesis_final_approval_allowed_now",
        "seed_synthesis_production_pass_allowed_now",
        "production_pass_enabled"
      ],
      "properties": {
        "seed_synthesis_execution_readiness_status": {
          "enum": [
            "ready_for_seed_synthesis_execution_readiness",
            "valid_block_seed_synthesis_execution_readiness_pending",
            "blocked_seed_synthesis_execution_readiness"
          ]
        },
        "source_p32400_ready_for_seed_synthesis_candidate": { "type": "boolean" },
        "seed_synthesis_candidate_count": { "type": "number" },
        "execution_readiness_gate_count": { "type": "number" },
        "seed_review_packet_candidate_count": { "type": "number" },
        "seed_blocker_ledger_count": { "type": "number" },
        "final_seed_complete_count": { "const": 0 },
        "execution_ready_count": { "const": 0 },
        "readiness_blocker_count": { "type": "number" },
        "ready_for_defaults_no_fake_clarity_guard": { "type": "boolean" },
        "seed_synthesis_final_seed_allowed_now": { "const": false },
        "seed_synthesis_seed_auto_apply_allowed_now": { "const": false },
        "seed_synthesis_execution_ready_allowed_now": { "const": false },
        "seed_synthesis_runtime_execution_allowed_now": { "const": false },
        "seed_synthesis_write_action_allowed_now": { "const": false },
        "seed_synthesis_protected_action_allowed_now": { "const": false },
        "seed_synthesis_review_completion_allowed_now": { "const": false },
        "seed_synthesis_final_approval_allowed_now": { "const": false },
        "seed_synthesis_production_pass_allowed_now": { "const": false },
        "production_pass_enabled": { "const": false },
        "enterprise_trust_claim_allowed_now": { "const": false },
        "validation_error_count": { "type": "number" }
      }
    },
    "seed_synthesis_execution_readiness_boundary": {
      "type": "object",
      "required": [
        "p32800_contract_ready",
        "ready_for_defaults_no_fake_clarity_guard",
        "source_p32400_ready_for_seed_synthesis_candidate",
        "seed_synthesis_candidate_visible_now",
        "execution_readiness_gate_visible_now",
        "seed_review_packet_candidate_visible_now",
        "seed_blocker_ledger_visible_now",
        "no_execution_boundary_closed_now",
        "final_seed_complete_count",
        "execution_ready_count",
        "seed_synthesis_final_seed_allowed_now",
        "seed_synthesis_seed_auto_apply_allowed_now",
        "seed_synthesis_execution_ready_allowed_now",
        "seed_synthesis_runtime_execution_allowed_now",
        "seed_synthesis_write_action_allowed_now",
        "seed_synthesis_protected_action_allowed_now",
        "seed_synthesis_final_approval_allowed_now",
        "seed_synthesis_production_pass_allowed_now"
      ],
      "properties": {
        "p32800_contract_ready": { "type": "boolean" },
        "ready_for_defaults_no_fake_clarity_guard": { "type": "boolean" },
        "source_p32400_ready_for_seed_synthesis_candidate": { "type": "boolean" },
        "source_validation_valid_now": { "type": "boolean" },
        "seed_synthesis_candidate_visible_now": { "type": "boolean" },
        "execution_readiness_gate_visible_now": { "type": "boolean" },
        "seed_review_packet_candidate_visible_now": { "type": "boolean" },
        "seed_blocker_ledger_visible_now": { "type": "boolean" },
        "no_execution_boundary_closed_now": { "type": "boolean" },
        "seed_synthesis_candidate_count": { "type": "number" },
        "execution_readiness_gate_count": { "type": "number" },
        "seed_review_packet_candidate_count": { "type": "number" },
        "seed_blocker_ledger_count": { "type": "number" },
        "final_seed_complete_count": { "const": 0 },
        "execution_ready_count": { "const": 0 },
        "readiness_blocker_count": { "type": "number" },
        "seed_synthesis_final_seed_allowed_now": { "const": false },
        "seed_synthesis_seed_auto_apply_allowed_now": { "const": false },
        "seed_synthesis_execution_ready_allowed_now": { "const": false },
        "seed_synthesis_runtime_execution_allowed_now": { "const": false },
        "seed_synthesis_write_action_allowed_now": { "const": false },
        "seed_synthesis_protected_action_allowed_now": { "const": false },
        "seed_synthesis_connector_write_allowed_now": { "const": false },
        "seed_synthesis_deployment_allowed_now": { "const": false },
        "seed_synthesis_review_completion_allowed_now": { "const": false },
        "seed_synthesis_final_approval_allowed_now": { "const": false },
        "seed_synthesis_production_pass_allowed_now": { "const": false },
        "seed_synthesis_enterprise_trust_claim_allowed_now": { "const": false },
        "seed_synthesis_raw_answer_exposure_allowed_now": { "const": false },
        "seed_synthesis_secret_read_allowed_now": { "const": false },
        "seed_synthesis_human_gate_bypass_allowed_now": { "const": false },
        "seed_synthesis_independent_review_bypass_allowed_now": { "const": false },
        "seed_synthesis_final_automated_approval_allowed_now": { "const": false },
        "production_pass_enabled": { "const": false },
        "enterprise_trust_claim_allowed_now": { "const": false }
      }
    },
    "validation": {
      "type": "object",
      "required": ["valid", "error_count", "errors"],
      "properties": {
        "valid": { "type": "boolean" },
        "error_count": { "type": "number" },
        "errors": { "type": "array" }
      }
    }
  },
  "$defs": {
    "verdictRow": {
      "type": "object",
      "required": ["row_id", "category", "label", "observed", "current_verdict", "block_reason", "evidence_ref"],
      "properties": {
        "row_id": { "type": "string" },
        "category": { "type": "string" },
        "label": { "type": "string" },
        "observed": { "type": "boolean" },
        "current_verdict": { "enum": ["pass", "block"] },
        "block_reason": { "type": ["string", "null"] },
        "evidence_ref": { "type": ["string", "null"] },
        "generated_at": { "type": "string" }
      },
      "additionalProperties": true
    },
    "validationItem": {
      "allOf": [{ "$ref": "#/$defs/verdictRow" }]
    }
  }
}
