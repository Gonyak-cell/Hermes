{
  "schema_version": "domain-pack-manifest.v1",
  "pack_id": "trading",
  "pack_version": "0.1.0",
  "display_name": "Trading Pack",
  "description": "Research, backtest, and paper trading control-plane workflows with live trading and real execution blocked by default.",
  "enabled": true,
  "core_compatibility": {
    "min_core_version": "0.1.0"
  },
  "capabilities": [
    {
      "capability_id": "trading.research_backtest_paper",
      "version": "0.1.0",
      "path": "capabilities/research-backtest-paper.json"
    }
  ],
  "policies": [
    {
      "policy_id": "trading.policy.no_return_guarantee",
      "description": "Outputs must not promise returns or present research as investment advice."
    },
    {
      "policy_id": "trading.policy.no_live_without_promotion",
      "description": "shadow_live, limited_live, and full_auto remain blocked until explicit human-approved promotion gates exist."
    },
    {
      "policy_id": "trading.policy.no_plaintext_secrets",
      "description": "Broker and exchange API keys must never be stored in plaintext or inserted into model context."
    },
    {
      "policy_id": "trading.policy.rollback_to_paper",
      "description": "Every incident, drift, data outage, or risk halt rolls back to paper mode by default."
    }
  ],
