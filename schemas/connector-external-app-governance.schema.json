{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hermes.local/schemas/connector-external-app-governance.schema.json",
  "title": "Hermes Connector And External App Governance",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "capability_id",
    "program_range",
    "source_program_range",
    "connector_governance_contract",
    "connector_governance_phase_rows",
    "connector_governance_source_binding_rows",
    "external_app_registry_rows",
    "connector_capability_matrix_rows",
    "consent_auth_receipt_rows",
    "ingestion_quarantine_rows",
    "external_app_evidence_mapping_rows",
    "cross_app_boundary_guard_rows",
    "claude_connector_governance_review_rows",
    "connector_read_only_projection_rows",
    "connector_authority_guard_rows",
    "p15800_freeze_rows",
    "connector_governance_boundary",
    "connector_governance_validation_items",
    "validation",
    "summary"
  ],
  "properties": {
    "schema_version": { "const": "connector-external-app-governance.v1" },
    "capability_id": { "const": "platform.connector_external_app_governance" },
    "program_range": { "const": "P15401-P15800" },
    "source_program_range": { "const": "P15001-P15400" },
    "connector_governance_phase_rows": { "type": "array", "minItems": 10, "items": { "$ref": "#/$defs/verdictRow" } },
    "connector_governance_source_binding_rows": { "type": "array", "minItems": 9, "items": { "$ref": "#/$defs/verdictRow" } },
    "external_app_registry_rows": { "type": "array", "minItems": 6, "items": { "$ref": "#/$defs/verdictRow" } },
    "connector_capability_matrix_rows": { "type": "array", "minItems": 6, "items": { "$ref": "#/$defs/verdictRow" } },
    "consent_auth_receipt_rows": { "type": "array", "minItems": 6, "items": { "$ref": "#/$defs/verdictRow" } },
    "ingestion_quarantine_rows": { "type": "array", "minItems": 6, "items": { "$ref": "#/$defs/verdictRow" } },
    "external_app_evidence_mapping_rows": { "type": "array", "minItems": 6, "items": { "$ref": "#/$defs/verdictRow" } },
    "cross_app_boundary_guard_rows": { "type": "array", "minItems": 6, "items": { "$ref": "#/$defs/verdictRow" } },
    "claude_connector_governance_review_rows": { "type": "array", "minItems": 5, "items": { "$ref": "#/$defs/verdictRow" } },
    "connector_read_only_projection_rows": { "type": "array", "minItems": 6, "items": { "$ref": "#/$defs/verdictRow" } },
    "connector_authority_guard_rows": { "type": "array", "minItems": 8, "items": { "$ref": "#/$defs/verdictRow" } },
    "p15800_freeze_rows": { "type": "array", "minItems": 12, "items": { "$ref": "#/$defs/verdictRow" } },
    "connector_governance_boundary": {
      "type": "object",
      "required": [
        "source_saas_factory_available",
        "source_ready_for_p15401_handoff",
        "source_block_visible_now",
        "external_app_registry_ready",
        "connector_capability_matrix_ready",
        "consent_auth_receipt_ready",
        "ingestion_quarantine_ready",
        "external_app_evidence_mapping_ready",
        "cross_app_boundary_guard_ready",
        "claude_connector_governance_review_receipt_present_now",
        "claude_connector_governance_review_block_visible_now",
        "connector_read_only_projection_ready",
        "connector_authority_guard_ready",
        "p15800_connector_governance_freeze_ready",
        "ready_for_p15801_handoff",
        "external_app_connection_allowed_now",
        "credential_lookup_allowed_now",
        "secret_read_allowed_now",
        "raw_export_allowed_now",
        "raw_source_exposure_allowed",
        "ingestion_start_allowed_now",
        "connector_provisioning_allowed_now",
        "connector_write_enabled",
        "external_service_mutation_allowed_now",
        "cross_app_data_join_allowed_now",
        "deployment_allowed_now",
        "production_pass_enabled",
        "enterprise_pass_enabled",
        "enterprise_trust_claim_allowed_now",
        "protected_closeout_enabled",
        "release_approval_allowed_now",
        "write_action_allowed_now",
        "protected_action_allowed_now",
        "runtime_execution_allowed_now",
        "final_approval_ui_enabled",
        "codex_final_approval_ui_enabled",
        "claude_final_approval_ui_enabled",
        "unsafe_flag_count"
      ],
      "properties": {
        "source_saas_factory_available": { "type": "boolean" },
        "source_ready_for_p15401_handoff": { "type": "boolean" },
        "source_block_visible_now": { "type": "boolean" },
        "external_app_registry_ready": { "type": "boolean" },
        "connector_capability_matrix_ready": { "type": "boolean" },
        "consent_auth_receipt_ready": { "type": "boolean" },
        "ingestion_quarantine_ready": { "type": "boolean" },
        "external_app_evidence_mapping_ready": { "type": "boolean" },
        "cross_app_boundary_guard_ready": { "type": "boolean" },
        "claude_connector_governance_review_receipt_present_now": { "type": "boolean" },
        "claude_connector_governance_review_block_visible_now": { "type": "boolean" },
        "connector_read_only_projection_ready": { "type": "boolean" },
        "connector_authority_guard_ready": { "type": "boolean" },
        "p15800_connector_governance_freeze_ready": { "type": "boolean" },
        "ready_for_p15801_handoff": { "type": "boolean" },
        "external_app_connection_allowed_now": { "const": false },
        "credential_lookup_allowed_now": { "const": false },
        "secret_read_allowed_now": { "const": false },
        "raw_export_allowed_now": { "const": false },
        "raw_source_exposure_allowed": { "const": false },
        "ingestion_start_allowed_now": { "const": false },
        "connector_provisioning_allowed_now": { "const": false },
        "connector_write_enabled": { "const": false },
        "external_service_mutation_allowed_now": { "const": false },
        "cross_app_data_join_allowed_now": { "const": false },
        "deployment_allowed_now": { "const": false },
        "production_pass_enabled": { "const": false },
        "enterprise_pass_enabled": { "const": false },
        "enterprise_trust_claim_allowed_now": { "const": false },
        "protected_closeout_enabled": { "const": false },
        "release_approval_allowed_now": { "const": false },
        "write_action_allowed_now": { "const": false },
        "protected_action_allowed_now": { "const": false },
        "runtime_execution_allowed_now": { "const": false },
        "final_approval_ui_enabled": { "const": false },
        "codex_final_approval_ui_enabled": { "const": false },
        "claude_final_approval_ui_enabled": { "const": false },
        "unsafe_flag_count": { "const": 0 }
      }
    },
    "validation": {
      "type": "object",
      "required": ["valid", "error_count", "errors"],
      "properties": {
        "valid": { "type": "boolean" },
        "error_count": { "type": "integer", "minimum": 0 },
        "errors": { "type": "array" }
      }
    },
    "summary": {
      "type": "object",
      "required": [
        "connector_external_app_governance_status",
        "program_range",
        "source_ready_for_p15401_handoff",
        "source_block_visible_now",
        "external_app_registry_row_count",
        "connector_capability_matrix_row_count",
        "consent_auth_receipt_row_count",
        "ingestion_quarantine_row_count",
        "external_app_evidence_mapping_row_count",
        "cross_app_boundary_guard_row_count",
        "claude_connector_governance_review_receipt_present_now",
        "claude_connector_governance_review_block_visible_now",
        "connector_read_only_projection_row_count",
        "p15800_connector_governance_freeze_ready",
        "ready_for_p15801_handoff",
        "external_app_connection_allowed_now",
        "credential_lookup_allowed_now",
        "secret_read_allowed_now",
        "raw_export_allowed_now",
        "ingestion_start_allowed_now",
        "connector_write_enabled",
        "production_pass_enabled",
        "enterprise_trust_claim_allowed_now",
        "validation_error_count"
      ],
      "properties": {
        "connector_external_app_governance_status": {
          "enum": ["ready_for_connector_external_app_governance", "blocked_connector_external_app_governance"]
        },
        "program_range": { "const": "P15401-P15800" },
        "external_app_registry_row_count": { "type": "integer", "minimum": 6 },
        "connector_capability_matrix_row_count": { "type": "integer", "minimum": 6 },
        "consent_auth_receipt_row_count": { "type": "integer", "minimum": 6 },
        "ingestion_quarantine_row_count": { "type": "integer", "minimum": 6 },
        "external_app_evidence_mapping_row_count": { "type": "integer", "minimum": 6 },
        "cross_app_boundary_guard_row_count": { "type": "integer", "minimum": 6 },
        "connector_read_only_projection_row_count": { "type": "integer", "minimum": 6 },
        "external_app_connection_allowed_now": { "const": false },
        "credential_lookup_allowed_now": { "const": false },
        "secret_read_allowed_now": { "const": false },
        "raw_export_allowed_now": { "const": false },
        "ingestion_start_allowed_now": { "const": false },
        "connector_write_enabled": { "const": false },
        "production_pass_enabled": { "const": false },
        "enterprise_trust_claim_allowed_now": { "const": false }
      }
    }
  },
  "$defs": {
    "verdictRow": {
      "type": "object",
      "required": ["row_id", "category", "label", "required", "observed", "evidence_ref", "current_verdict"],
      "properties": {
        "row_id": { "type": "string", "minLength": 1 },
        "category": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "required": { "type": "boolean" },
        "observed": { "type": "boolean" },
        "evidence_ref": { "type": "string", "minLength": 1 },
        "current_verdict": { "enum": ["pass", "blocked"] },
        "block_reason": { "type": ["string", "null"] }
      }
    }
  }
}
