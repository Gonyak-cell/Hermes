  "$defs": {
    "verdictRow": {
      "type": "object",
      "required": ["row_id", "current_verdict", "unsafe_flags_false", "verdict_authority", "opens_authority"],
      "properties": {
        "row_id": { "type": "string", "minLength": 1 },
        "current_verdict": { "enum": ["pass", "blocked"] },
        "unsafe_flags_false": { "type": "boolean" },
        "verdict_authority": { "const": "harness_deterministic_validator" },
        "opens_authority": { "const": false }
      },
      "additionalProperties": true
    },
    "packetRow": {
      "allOf": [
        { "$ref": "#/$defs/verdictRow" },
        {
          "type": "object",
          "required": [
            "packet_id",
            "request_id",
            "packet_file_name",
            "packet_markdown_hash",
            "copy_allowed_now",
            "file_export_allowed_now",
            "request_transport_submission_allowed_now",
            "provider_automation_allowed_now",
            "raw_prompt_included",
            "raw_source_included",
            "secret_reference_included",
            "execution_allowed_now",
            "receipt_application_allowed_now",
            "approval_application_allowed_now"
          ],
          "properties": {
            "packet_id": { "type": "string", "minLength": 1 },
            "request_id": { "type": "string", "minLength": 1 },
            "packet_file_name": { "type": "string", "pattern": "\\.md$" },
            "packet_markdown_hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
            "copy_allowed_now": { "const": true },
            "file_export_allowed_now": { "const": true },
            "request_transport_submission_allowed_now": { "const": false },
            "provider_automation_allowed_now": { "const": false },
            "raw_prompt_included": { "const": false },
            "raw_source_included": { "const": false },
            "secret_reference_included": { "const": false },
            "execution_allowed_now": { "const": false },
            "receipt_application_allowed_now": { "const": false },
            "approval_application_allowed_now": { "const": false }
          }
        }
      ]
    }
