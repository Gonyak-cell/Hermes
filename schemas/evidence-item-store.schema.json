{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://amic.local/hermes/evidence-item-store.schema.json",
  "title": "Hermes Evidence Item Store",
  "type": "object",
  "required": [
    "schema_version",
    "generated_at",
    "evidence_item_store_id",
    "output_dir",
    "inputs",
    "source_source_span_store",
    "evidence_item_store_contract",
    "evidence_item_catalog",
    "validation_items",
    "validation",
    "summary"
  ],
  "properties": {
    "schema_version": { "const": "evidence-item-store.v1" },
    "generated_at": { "type": "string", "format": "date-time" },
    "evidence_item_store_id": { "type": "string" },
    "output_dir": { "type": "string" },
    "inputs": {
      "type": "object",
      "required": ["source_span_store_path", "package_path", "roadmap_path"],
      "properties": {
        "source_span_store_path": { "type": "string" },
        "package_path": { "type": "string" },
        "roadmap_path": { "type": "string" }
      }
    },
    "source_source_span_store": { "$ref": "#/$defs/source_summary" },
    "evidence_item_store_contract": { "$ref": "#/$defs/store_contract" },
    "evidence_item_catalog": {
      "type": "object",
      "required": ["schema_version", "generated_at", "evidence_items", "source_span_bindings", "review_queue_items", "evidence_item_indexes"],
      "properties": {
        "schema_version": { "const": "evidence-item-catalog.v1" },
        "generated_at": { "type": "string", "format": "date-time" },
        "evidence_items": { "type": "array", "items": { "$ref": "#/$defs/evidence_item" } },
        "source_span_bindings": { "type": "array", "items": { "$ref": "#/$defs/source_span_binding" } },
        "review_queue_items": { "type": "array", "items": { "$ref": "#/$defs/review_queue_item" } },
        "evidence_item_indexes": { "$ref": "#/$defs/indexes" }
      }
    },
    "validation_items": { "type": "array", "items": { "$ref": "#/$defs/validation_item" } },
    "validation": {
      "type": "object",
      "required": ["valid", "errors"],
      "properties": {
        "valid": { "type": "boolean" },
        "errors": { "type": "array", "items": { "$ref": "#/$defs/validation_error" } }
      }
    },
    "summary": { "$ref": "#/$defs/summary" }
  },
  "$defs": {
    "source_summary": {
      "type": "object",
      "required": ["source_id", "schema_version", "generated_at", "summary"],
      "properties": {
        "source_id": { "type": "string" },
        "schema_version": { "type": ["string", "null"] },
        "generated_at": { "type": ["string", "null"] },
        "summary": { "type": ["object", "null"] }
      }
    },
    "store_contract": {
      "type": "object",
      "required": [
        "schema_version",
        "evidence_item_store_contract_id",
        "generated_at",
        "source_span_schema_version",
        "evidence_item_schema_version",
        "source_inputs",
        "required_identity_fields",
        "required_lineage_links",
        "review_rule",
        "classification_rule",
        "matter_boundary_rule"
      ],
      "properties": {
        "schema_version": { "const": "evidence-item-store-contract.v1" },
        "evidence_item_store_contract_id": { "const": "evidence-item-store.v1" },
        "generated_at": { "type": "string", "format": "date-time" },
        "source_span_schema_version": { "const": "source-span.v2" },
        "evidence_item_schema_version": { "const": "evidence-item.v2" },
        "source_inputs": { "type": "array", "items": { "type": "string" } },
        "required_identity_fields": { "type": "array", "items": { "type": "string" } },
        "required_lineage_links": { "type": "array", "items": { "type": "string" } },
        "review_rule": { "type": "string" },
        "classification_rule": { "type": "string" },
        "matter_boundary_rule": { "type": "string" }
      }
    },
    "evidence_item": {
      "type": "object",
      "required": [
        "schema_version",
        "evidence_id",
        "evidence_store_record_id",
        "tenant_id",
        "matter_id",
        "classification",
        "policy_snapshot_id",
        "evidence_type",
        "source_span_ids",
        "source_span_count",
        "primary_source_span_id",
        "resource_id",
        "resource_version_id",
        "normalized_text_id",
        "location_type",
        "locator",
        "summary",
        "reliability",
        "review_status",
        "verification_state",
        "privilege_flag",
        "redaction_state",
        "lineage_id",
        "created_at",
        "metadata"
      ],
      "properties": {
        "schema_version": { "const": "evidence-item.v2" },
        "evidence_id": { "type": "string" },
        "evidence_store_record_id": { "type": "string" },
        "tenant_id": { "type": ["string", "null"] },
        "matter_id": { "type": ["string", "null"] },
        "classification": { "type": ["string", "null"] },
        "policy_snapshot_id": { "type": ["string", "null"] },
        "evidence_type": { "type": "string" },
        "source_span_ids": { "type": "array", "items": { "type": "string" } },
        "source_span_count": { "type": "integer", "minimum": 0 },
        "primary_source_span_id": { "type": "string" },
        "resource_id": { "type": ["string", "null"] },
        "resource_version_id": { "type": ["string", "null"] },
        "normalized_text_id": { "type": ["string", "null"] },
        "location_type": { "type": ["string", "null"] },
        "locator": { "type": "object" },
        "summary": { "type": "string" },
        "reliability": { "type": "string" },
        "review_status": { "type": "string" },
        "verification_state": { "type": "string" },
        "privilege_flag": { "type": "boolean" },
        "redaction_state": { "type": "string" },
        "lineage_id": { "type": "string" },
        "created_at": { "type": "string", "format": "date-time" },
        "metadata": { "type": "object" }
      }
    },
    "source_span_binding": {
      "type": "object",
      "required": [
        "schema_version",
        "evidence_source_span_binding_id",
        "evidence_id",
        "source_span_id",
        "binding_status",
        "tenant_id",
        "matter_id",
        "classification",
        "matter_preserved",
        "classification_preserved",
        "policy_snapshot_preserved",
        "created_at"
      ],
      "properties": {
        "schema_version": { "const": "evidence-source-span-binding.v1" },
        "evidence_source_span_binding_id": { "type": "string" },
        "evidence_id": { "type": "string" },
        "source_span_id": { "type": "string" },
        "binding_status": { "enum": ["bound", "broken"] },
        "tenant_id": { "type": ["string", "null"] },
        "matter_id": { "type": ["string", "null"] },
        "classification": { "type": ["string", "null"] },
        "matter_preserved": { "type": "boolean" },
        "classification_preserved": { "type": "boolean" },
        "policy_snapshot_preserved": { "type": "boolean" },
        "created_at": { "type": "string", "format": "date-time" }
      }
    },
    "review_queue_item": {
      "type": "object",
      "required": [
        "schema_version",
        "review_queue_item_id",
        "evidence_id",
        "subject_type",
        "subject_id",
        "matter_id",
        "classification",
        "review_status",
        "review_required",
        "approval_required_before_output",
        "queue_reason",
        "assigned_role",
        "created_at"
      ],
      "properties": {
        "schema_version": { "const": "evidence-review-queue-item.v1" },
        "review_queue_item_id": { "type": "string" },
        "evidence_id": { "type": "string" },
        "subject_type": { "const": "evidence_item" },
        "subject_id": { "type": "string" },
        "matter_id": { "type": ["string", "null"] },
        "classification": { "type": ["string", "null"] },
        "review_status": { "type": "string" },
        "review_required": { "type": "boolean" },
        "approval_required_before_output": { "type": "boolean" },
        "queue_reason": { "type": "string" },
        "assigned_role": { "type": "string" },
        "created_at": { "type": "string", "format": "date-time" }
      }
    },
    "indexes": {
      "type": "object",
      "required": ["schema_version", "generated_at", "by_matter_id", "by_classification", "by_review_status", "by_evidence_type", "by_location_type", "by_binding_status"],
      "properties": {
        "schema_version": { "const": "evidence-item-indexes.v1" },
        "generated_at": { "type": "string", "format": "date-time" },
        "by_matter_id": { "type": "object" },
        "by_classification": { "type": "object" },
        "by_review_status": { "type": "object" },
        "by_evidence_type": { "type": "object" },
        "by_location_type": { "type": "object" },
        "by_binding_status": { "type": "object" }
      }
    },
    "summary": {
      "type": "object",
      "required": [
        "evidence_item_store_status",
        "evidence_item_store_contract_id",
        "evidence_item_schema_version",
        "source_span_store_status",
        "source_span_count",
        "evidence_item_count",
        "evidence_source_span_binding_count",
        "review_queue_item_count",
        "source_span_linked_evidence_count",
        "matter_preserved_evidence_count",
        "classification_preserved_evidence_count",
        "policy_snapshot_preserved_evidence_count",
        "machine_extracted_evidence_count",
        "needs_review_count",
        "approved_count",
        "privilege_flag_count",
        "redaction_raw_count",
        "validation_item_count",
        "failed_validation_item_count",
        "validation_error_count",
        "by_matter_id",
        "by_classification",
        "by_review_status",
        "by_evidence_type",
        "by_location_type"
      ],
      "properties": {
        "evidence_item_store_status": { "enum": ["complete", "blocked"] },
        "evidence_item_store_contract_id": { "const": "evidence-item-store.v1" },
        "evidence_item_schema_version": { "const": "evidence-item.v2" },
        "source_span_store_status": { "enum": ["complete", "blocked", "unknown"] },
        "source_span_count": { "type": "integer", "minimum": 0 },
        "evidence_item_count": { "type": "integer", "minimum": 0 },
        "evidence_source_span_binding_count": { "type": "integer", "minimum": 0 },
        "review_queue_item_count": { "type": "integer", "minimum": 0 },
        "source_span_linked_evidence_count": { "type": "integer", "minimum": 0 },
        "matter_preserved_evidence_count": { "type": "integer", "minimum": 0 },
        "classification_preserved_evidence_count": { "type": "integer", "minimum": 0 },
        "policy_snapshot_preserved_evidence_count": { "type": "integer", "minimum": 0 },
        "machine_extracted_evidence_count": { "type": "integer", "minimum": 0 },
        "needs_review_count": { "type": "integer", "minimum": 0 },
        "approved_count": { "type": "integer", "minimum": 0 },
        "privilege_flag_count": { "type": "integer", "minimum": 0 },
        "redaction_raw_count": { "type": "integer", "minimum": 0 },
        "validation_item_count": { "type": "integer", "minimum": 0 },
        "failed_validation_item_count": { "type": "integer", "minimum": 0 },
        "validation_error_count": { "type": "integer", "minimum": 0 },
        "by_matter_id": { "type": "object" },
        "by_classification": { "type": "object" },
        "by_review_status": { "type": "object" },
        "by_evidence_type": { "type": "object" },
        "by_location_type": { "type": "object" }
      }
    },
    "validation_item": {
      "type": "object",
      "required": ["validation_id", "path", "check_id", "status", "severity", "message"],
      "properties": {
        "validation_id": { "type": "string" },
        "path": { "type": "string" },
        "check_id": { "type": "string" },
        "status": { "enum": ["passed", "failed"] },
        "severity": { "enum": ["info", "error"] },
        "message": { "type": "string" }
      }
    },
    "validation_error": {
      "type": "object",
      "required": ["path", "message"],
      "properties": {
        "path": { "type": "string" },
        "message": { "type": "string" }
      }
    }
  }
}
