{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hermes.local/schemas/hermes-loop-run-ledger-projection.schema.json",
  "title": "Hermes Loop System v1.1 Run Ledger Projection",
  "type": "object",
  "required": [
    "schema_version",
    "capability_id",
    "program_range",
    "source_program_range",
    "next_program_range",
    "p61200_agent_control_source_rows",
    "source_event_to_loop_run_projection_rows",
    "workflow_state_transition_binding_rows",
    "gate_result_binding_rows",
    "blocker_next_action_projection_rows",
    "agent_ref_projection_rows",
    "authority_boundary_carryover_rows",
    "negative_fixture_contract_rows",
    "validation_command_rows",
    "p61600_closeout_rows",
    "p61601_next_phase_handoff_rows",
    "hermes_loop_run_ledger_boundary",
    "summary",
    "validation"
  ],
  "properties": {
    "schema_version": { "const": "hermes-loop-run-ledger-projection.v1" },
    "capability_id": { "const": "platform.hermes_loop_system_v1_1_run_ledger_projection" },
    "program_range": { "const": "P61201-P61600" },
    "source_program_range": { "const": "P60801-P61200" },
    "next_program_range": { "const": "P61601-P62000" },
    "p61200_agent_control_source_rows": { "type": "array", "minItems": 5, "items": { "$ref": "#/$defs/verdictRow" } },
    "source_event_to_loop_run_projection_rows": { "type": "array", "minItems": 12, "items": { "$ref": "#/$defs/verdictRow" } },
    "workflow_state_transition_binding_rows": { "type": "array", "minItems": 13, "items": { "$ref": "#/$defs/verdictRow" } },
    "gate_result_binding_rows": { "type": "array", "minItems": 13, "items": { "$ref": "#/$defs/verdictRow" } },
    "blocker_next_action_projection_rows": { "type": "array", "minItems": 10, "items": { "$ref": "#/$defs/verdictRow" } },
    "agent_ref_projection_rows": { "type": "array", "minItems": 8, "items": { "$ref": "#/$defs/verdictRow" } },
    "authority_boundary_carryover_rows": { "type": "array", "minItems": 21, "items": { "$ref": "#/$defs/verdictRow" } },
    "negative_fixture_contract_rows": { "type": "array", "minItems": 12, "items": { "$ref": "#/$defs/verdictRow" } },
    "validation_command_rows": { "type": "array", "minItems": 6, "items": { "$ref": "#/$defs/verdictRow" } },
    "p61600_closeout_rows": { "type": "array", "minItems": 10, "items": { "$ref": "#/$defs/verdictRow" } },
    "p61601_next_phase_handoff_rows": { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/verdictRow" } },
    "hermes_loop_run_ledger_boundary": {
      "type": "object",
      "required": [
        "p61600_contract_ready",
        "p61200_source_ready_now",
        "source_event_to_loop_run_projection_ready_now",
        "workflow_state_transition_binding_ready_now",
        "gate_result_binding_ready_now",
        "blocker_next_action_projection_ready_now",
        "ready_for_p61601_handoff",
        "runtime_execution_allowed_now",
        "write_action_allowed_now",
        "connector_write_allowed_now",
        "protected_action_allowed_now",
        "production_pass_allowed_now",
        "enterprise_pass_allowed_now",
        "codex_final_approval_allowed",
        "claude_final_approval_allowed",
        "production_pass_enabled",
        "enterprise_pass_enabled",
        "final_approval_enabled"
      ],
      "properties": {
        "p61600_contract_ready": { "type": "boolean" },
        "p61200_source_ready_now": { "type": "boolean" },
        "source_event_to_loop_run_projection_ready_now": { "type": "boolean" },
        "workflow_state_transition_binding_ready_now": { "type": "boolean" },
        "gate_result_binding_ready_now": { "type": "boolean" },
        "blocker_next_action_projection_ready_now": { "type": "boolean" },
        "ready_for_p61601_handoff": { "type": "boolean" },
        "runtime_execution_allowed_now": { "const": false },
        "write_action_allowed_now": { "const": false },
        "connector_write_allowed_now": { "const": false },
        "protected_action_allowed_now": { "const": false },
        "production_pass_allowed_now": { "const": false },
        "enterprise_pass_allowed_now": { "const": false },
        "codex_final_approval_allowed": { "const": false },
        "claude_final_approval_allowed": { "const": false },
        "production_pass_enabled": { "const": false },
        "enterprise_pass_enabled": { "const": false },
        "final_approval_enabled": { "const": false }
      },
      "additionalProperties": true
    },
    "summary": {
      "type": "object",
      "required": [
        "hermes_loop_run_ledger_status",
        "program_range",
        "source_program_range",
        "next_program_range",
        "p61200_source_ready_now",
        "p61600_contract_ready",
        "ready_for_p61601_handoff",
        "production_pass_enabled",
        "enterprise_pass_enabled",
        "final_approval_enabled"
      ],
      "properties": {
        "hermes_loop_run_ledger_status": {
          "enum": [
            "ready_for_p61601_handoff",
            "valid_block_p61601_handoff_pending",
            "blocked_hermes_loop_run_ledger_projection"
          ]
        },
        "program_range": { "const": "P61201-P61600" },
        "source_program_range": { "const": "P60801-P61200" },
        "next_program_range": { "const": "P61601-P62000" },
        "production_pass_enabled": { "const": false },
        "enterprise_pass_enabled": { "const": false },
        "final_approval_enabled": { "const": false }
      },
      "additionalProperties": true
    },
    "validation": {
      "type": "object",
      "required": ["valid", "error_count", "errors"],
      "properties": {
        "valid": { "type": "boolean" },
        "error_count": { "type": "number" },
        "errors": { "type": "array" }
      },
      "additionalProperties": true
    }
  },
  "$defs": {
    "verdictRow": {
      "type": "object",
      "required": [
        "row_id",
        "category",
        "label",
        "observed",
        "current_verdict",
        "evidence_ref",
        "block_reason",
        "next_allowed_action",
        "generated_at"
      ],
      "properties": {
        "row_id": { "type": "string" },
        "category": { "type": "string" },
        "label": { "type": "string" },
        "observed": { "type": "boolean" },
        "current_verdict": { "enum": ["pass", "block"] },
        "evidence_ref": { "type": ["string", "null"] },
        "block_reason": { "type": ["string", "null"] },
        "next_allowed_action": { "type": "string" },
        "generated_at": { "type": "string" }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
