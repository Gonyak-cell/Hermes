{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hermes.local/schemas/zendd-command-evidence.schema.json",
  "title": "Zendd Command Evidence",
  "type": "object",
  "required": [
    "schema_version",
    "generated_at",
    "zendd_command_evidence_id",
    "capability_id",
    "output_dir",
    "inputs",
    "command_evidence_anchor",
    "source_boundary_summary",
    "source_dev_harness_summary",
    "command_evidence_policy",
    "command_evidence_rows",
    "log_redaction_policy",
    "command_review_binding_rows",
    "command_pass_block_policy",
    "protected_command_rows",
    "command_capture_plan",
    "command_evidence_freeze_rows",
    "command_evidence_gate_rows",
    "validation_items",
    "validation",
    "summary"
  ],
  "properties": {
    "schema_version": { "const": "zendd-command-evidence.v1" },
    "generated_at": { "type": "string", "format": "date-time" },
    "zendd_command_evidence_id": { "type": "string", "minLength": 1 },
    "capability_id": { "const": "project.zendd.command_evidence" },
    "output_dir": { "type": "string" },
    "inputs": {
      "type": "object",
      "required": ["schema_path", "phase_ledger_path", "package_path", "zendd_project_root"],
      "additionalProperties": true
    },
    "command_evidence_anchor": {
      "type": "object",
      "required": ["schema_version", "phase_range", "phase_slot", "previous_phase_slot", "next_phase_slot", "command_name", "dev_harness_command_name"],
      "properties": {
        "schema_version": { "const": "zendd-command-evidence-anchor.v1" },
        "phase_range": { "const": "P561-P580" },
        "phase_slot": { "const": "P561" },
        "previous_phase_slot": { "const": "P560" },
        "next_phase_slot": { "const": "P581" },
        "command_name": { "const": "project:zendd-command-evidence" },
        "dev_harness_command_name": { "const": "project:zendd-dev-harness" }
      },
      "additionalProperties": true
    },
    "command_evidence_policy": {
      "type": "object",
      "required": ["schema_version", "phase_slot", "command_execution_allowed_now", "command_pass_requires", "protected_command_pass_requires", "evidence_capture_required_fields", "forbidden_capture_fields", "next_allowed_action"],
      "properties": {
        "schema_version": { "const": "zendd-command-evidence-policy.v1" },
        "phase_slot": { "const": "P561" },
        "command_execution_allowed_now": { "const": false },
        "command_pass_requires": { "type": "array", "minItems": 4 },
        "protected_command_pass_requires": { "type": "array", "minItems": 2 },
        "evidence_capture_required_fields": { "type": "array", "minItems": 9 },
        "forbidden_capture_fields": { "type": "array", "minItems": 3 },
        "next_allowed_action": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": true
    },
    "command_evidence_rows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["schema_version", "phase_slot", "row_id", "project_id", "claim_id", "script_name", "command_evidence_ref", "expected_artifact_ref", "reviewer_ref", "hard_gate_ref", "human_receipt_ref_required", "execution_allowed_now", "evidence_capture_status", "verdict", "block_reason", "responsible_owner", "next_allowed_action"],
        "properties": {
          "schema_version": { "const": "zendd-command-evidence-row.v1" },
          "project_id": { "const": "project.zendd" },
          "execution_allowed_now": { "const": false },
          "evidence_capture_status": { "const": "pending_capture" },
          "command_evidence_ref": { "type": "string", "minLength": 1 },
          "expected_artifact_ref": { "type": "string", "minLength": 1 },
          "responsible_owner": { "type": "string", "minLength": 1 },
          "next_allowed_action": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": true
      }
    },
    "log_redaction_policy": {
      "type": "object",
      "required": ["schema_version", "phase_slot", "raw_log_storage_allowed", "secret_value_storage_allowed", "raw_vdr_log_storage_allowed", "required_redactions", "required_outputs", "next_allowed_action"],
      "properties": {
        "schema_version": { "const": "zendd-log-redaction-policy.v1" },
        "phase_slot": { "const": "P564" },
        "raw_log_storage_allowed": { "const": false },
        "secret_value_storage_allowed": { "const": false },
        "raw_vdr_log_storage_allowed": { "const": false },
        "required_redactions": { "type": "array", "minItems": 4 },
        "required_outputs": { "type": "array", "minItems": 4 },
        "next_allowed_action": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": true
    },
    "command_review_binding_rows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["schema_version", "phase_slot", "row_id", "claim_id", "command_evidence_ref", "reviewer_ref", "hard_gate_ref", "reviewer_required_for_pass", "human_receipt_ref_required", "pass_without_review_allowed", "current_verdict", "block_reason", "next_allowed_action"],
        "properties": {
          "schema_version": { "const": "zendd-command-review-binding-row.v1" },
          "phase_slot": { "const": "P565" },
          "reviewer_required_for_pass": { "const": true },
          "pass_without_review_allowed": { "const": false },
          "next_allowed_action": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": true
      }
    },
    "command_pass_block_policy": {
      "type": "object",
      "required": ["schema_version", "phase_slot", "pass_allowed_without_evidence", "pass_allowed_without_review", "protected_pass_allowed_without_receipt", "blocked_status_requires", "next_allowed_action"],
      "properties": {
        "schema_version": { "const": "zendd-command-pass-block-policy.v1" },
        "phase_slot": { "const": "P566" },
        "pass_allowed_without_evidence": { "const": false },
        "pass_allowed_without_review": { "const": false },
        "protected_pass_allowed_without_receipt": { "const": false },
        "blocked_status_requires": { "type": "array", "minItems": 3 },
        "next_allowed_action": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": true
    },
    "protected_command_rows": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["schema_version", "phase_slot", "row_id", "claim_id", "command_evidence_ref", "human_receipt_ref_required", "execution_allowed_now", "current_verdict", "block_reason", "responsible_owner", "next_allowed_action"],
        "properties": {
          "schema_version": { "const": "zendd-protected-command-row.v1" },
          "phase_slot": { "const": "P567" },
          "human_receipt_ref_required": { "const": true },
          "execution_allowed_now": { "const": false },
          "block_reason": { "type": "string", "minLength": 1 },
          "responsible_owner": { "type": "string", "minLength": 1 },
          "next_allowed_action": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": true
      }
    },
    "command_capture_plan": {
      "type": "object",
      "required": ["schema_version", "phase_slot", "command_count", "capture_execution_allowed_now", "capture_runner", "timeout_policy", "cwd_policy", "evidence_rows_have_refs", "next_allowed_action"],
      "properties": {
        "schema_version": { "const": "zendd-command-capture-plan.v1" },
        "phase_slot": { "const": "P568" },
        "capture_execution_allowed_now": { "const": false },
        "evidence_rows_have_refs": { "const": true },
        "next_allowed_action": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": true
    },
    "command_evidence_freeze_rows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["schema_version", "phase_slot", "row_id", "claim_id", "command_evidence_ref", "current_verdict", "block_reason", "responsible_owner", "next_allowed_action"],
        "properties": {
          "schema_version": { "const": "zendd-command-evidence-freeze-row.v1" },
          "phase_slot": { "const": "P569-P580" },
          "current_verdict": { "const": "blocked" },
          "block_reason": { "type": "string", "minLength": 1 },
          "responsible_owner": { "type": "string", "minLength": 1 },
          "next_allowed_action": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": true
      }
    },
    "command_evidence_gate_rows": {
      "type": "array",
      "minItems": 11,
      "items": {
        "type": "object",
        "required": ["schema_version", "gate_id", "phase_slot", "gate_status", "message", "next_allowed_action"],
        "properties": {
          "schema_version": { "const": "zendd-command-evidence-gate-row.v1" },
          "gate_status": { "enum": ["pass", "blocked"] }
        },
        "additionalProperties": true
      }
    },
    "validation_items": { "type": "array" },
    "validation": {
      "type": "object",
      "required": ["valid", "errors"],
      "properties": {
        "valid": { "type": "boolean" },
        "errors": { "type": "array" }
      },
      "additionalProperties": true
    },
    "summary": {
      "type": "object",
      "required": [
        "phase_range",
        "phase_slot",
        "previous_phase_slot",
        "next_phase_slot",
        "command_name",
        "zendd_command_evidence_status",
        "command_evidence_row_count",
        "protected_command_count",
        "command_execution_allowed",
        "protected_pass_allowed_without_receipt",
        "validation_error_count"
      ],
      "properties": {
        "phase_range": { "const": "P561-P580" },
        "phase_slot": { "const": "P561" },
        "previous_phase_slot": { "const": "P560" },
        "next_phase_slot": { "const": "P581" },
        "command_name": { "const": "project:zendd-command-evidence" },
        "command_execution_allowed": { "const": false },
        "protected_pass_allowed_without_receipt": { "const": false },
        "validation_error_count": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
