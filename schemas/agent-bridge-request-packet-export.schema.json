{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hermes.local/schemas/agent-bridge-request-packet-export.schema.json",
  "title": "Hermes Agent Bridge Request Packet Export",
  "type": "object",
