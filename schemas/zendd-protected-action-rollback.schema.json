{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hermes.local/schemas/zendd-protected-action-rollback.schema.json",
  "title": "Zendd Protected Action Rollback",
  "type": "object",
  "required": [
