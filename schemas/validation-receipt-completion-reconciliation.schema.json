{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hermes.local/schemas/validation-receipt-completion-reconciliation.schema.json",
  "title": "Hermes Validation Receipt Completion Reconciliation",
  "type": "object",
  "required": [
    "schema_version",
    "generated_at",
    "capability_id",
    "program_range",
    "source_program_range",
    "validation_receipt_completion_reconciliation_phase_rows",
    "p22000_source_binding_rows",
    "receipt_completion_gap_ledger_rows",
    "digest_integrity_guard_rows",
    "acceptance_reconciliation_rows",
    "operator_completion_index_rows",
    "no_completion_finality_boundary_rows",
    "p22400_clean_checkpoint_rows",
    "validation_receipt_completion_reconciliation_boundary",
    "validation_receipt_completion_reconciliation_validation_items",
    "summary",
    "validation"
  ],
  "properties": {
    "schema_version": { "const": "validation-receipt-completion-reconciliation.v1" },
    "generated_at": { "type": "string", "format": "date-time" },
    "capability_id": { "const": "platform.validation_receipt_completion_reconciliation" },
    "program_range": { "const": "P22001-P22400" },
    "source_program_range": { "const": "P21601-P22000" },
    "validation_receipt_completion_reconciliation_phase_rows": { "type": "array", "minItems": 7, "items": { "$ref": "#/$defs/verdictRow" } },
    "p22000_source_binding_rows": { "type": "array", "minItems": 12, "items": { "$ref": "#/$defs/verdictRow" } },
    "receipt_completion_gap_ledger_rows": { "type": "array", "minItems": 7, "items": { "$ref": "#/$defs/verdictRow" } },
    "digest_integrity_guard_rows": { "type": "array", "minItems": 7, "items": { "$ref": "#/$defs/verdictRow" } },
    "acceptance_reconciliation_rows": { "type": "array", "minItems": 7, "items": { "$ref": "#/$defs/verdictRow" } },
    "operator_completion_index_rows": { "type": "array", "minItems": 8, "items": { "$ref": "#/$defs/verdictRow" } },
    "no_completion_finality_boundary_rows": { "type": "array", "minItems": 28, "items": { "$ref": "#/$defs/verdictRow" } },
    "p22400_clean_checkpoint_rows": { "type": "array", "minItems": 8, "items": { "$ref": "#/$defs/verdictRow" } },
    "validation_receipt_completion_reconciliation_validation_items": { "type": "array", "minItems": 12, "items": { "$ref": "#/$defs/validationItem" } },
    "summary": {
      "type": "object",
      "required": [
        "validation_receipt_completion_reconciliation_status",
        "source_p22000_ready_for_p22001_handoff",
        "completion_item_count",
        "completion_gap_count",
        "completion_claimed_count",
        "completion_accepted_count",
        "ready_for_p22401_handoff",
        "receipt_completion_claim_allowed_now",
        "production_pass_enabled"
      ],
      "properties": {
        "validation_receipt_completion_reconciliation_status": {
          "enum": [
            "ready_for_validation_receipt_completion_reconciliation",
            "valid_block_validation_receipt_completion_reconciliation_pending",
            "blocked_validation_receipt_completion_reconciliation"
          ]
        },
        "source_p22000_ready_for_p22001_handoff": { "type": "boolean" },
        "completion_item_count": { "type": "number" },
        "completion_gap_count": { "type": "number" },
        "completion_claimed_count": { "type": "number" },
        "completion_accepted_count": { "type": "number" },
        "ready_for_p22401_handoff": { "type": "boolean" },
        "receipt_completion_claim_allowed_now": { "const": false },
        "production_pass_enabled": { "const": false },
        "enterprise_trust_claim_allowed_now": { "const": false },
        "validation_error_count": { "type": "number" }
      }
    },
    "validation_receipt_completion_reconciliation_boundary": {
      "type": "object",
      "required": [
        "p22400_contract_ready",
        "ready_for_p22401_handoff",
        "source_p22000_ready_for_p22001_handoff",
        "source_validation_valid_now",
        "completion_gap_ledger_visible_now",
        "digest_integrity_guard_visible_now",
        "acceptance_reconciliation_visible_now",
        "operator_completion_index_visible_now",
        "no_completion_finality_boundary_closed_now",
        "completion_item_count",
        "completion_gap_count",
        "completion_claimed_count",
        "completion_accepted_count",
        "digest_guard_count",
        "acceptance_reconciliation_count",
        "operator_completion_index_count",
        "command_execution_allowed_now",
        "raw_stdout_capture_allowed_now",
        "raw_stderr_capture_allowed_now",
        "raw_secret_material_allowed_now",
        "receipt_completion_claim_allowed_now",
        "receipt_completion_accepted_now",
        "completion_reconciliation_final_now",
        "operator_completion_apply_allowed_now",
        "verifier_finality_allowed_now",
        "operator_merge_allowed_now",
        "deployment_allowed_now",
        "release_approval_allowed_now",
        "production_pass_enabled",
        "enterprise_pass_enabled",
        "enterprise_trust_claim_allowed_now",
        "protected_closeout_enabled",
        "human_gate_bypass_allowed_now",
        "independent_review_bypass_allowed_now",
        "single_owner_enterprise_trust_allowed_now",
        "runtime_execution_allowed_now",
        "write_action_allowed_now",
        "protected_action_allowed_now",
        "connector_write_enabled",
        "external_service_mutation_allowed_now",
        "raw_source_exposure_allowed",
        "secret_read_allowed_now",
        "reviewer_mutation_allowed_now",
        "final_automated_approval_allowed"
      ],
      "properties": {
        "p22400_contract_ready": { "type": "boolean" },
        "ready_for_p22401_handoff": { "type": "boolean" },
        "source_p22000_ready_for_p22001_handoff": { "type": "boolean" },
        "source_validation_valid_now": { "type": "boolean" },
        "completion_gap_ledger_visible_now": { "type": "boolean" },
        "digest_integrity_guard_visible_now": { "type": "boolean" },
        "acceptance_reconciliation_visible_now": { "type": "boolean" },
        "operator_completion_index_visible_now": { "type": "boolean" },
        "no_completion_finality_boundary_closed_now": { "type": "boolean" },
        "completion_item_count": { "type": "number" },
        "completion_gap_count": { "type": "number" },
        "completion_claimed_count": { "type": "number" },
        "completion_accepted_count": { "type": "number" },
        "digest_guard_count": { "type": "number" },
        "acceptance_reconciliation_count": { "type": "number" },
        "operator_completion_index_count": { "type": "number" },
        "command_execution_allowed_now": { "const": false },
        "raw_stdout_capture_allowed_now": { "const": false },
        "raw_stderr_capture_allowed_now": { "const": false },
        "raw_secret_material_allowed_now": { "const": false },
        "receipt_completion_claim_allowed_now": { "const": false },
        "receipt_completion_accepted_now": { "const": false },
        "completion_reconciliation_final_now": { "const": false },
        "operator_completion_apply_allowed_now": { "const": false },
        "verifier_finality_allowed_now": { "const": false },
        "operator_merge_allowed_now": { "const": false },
        "deployment_allowed_now": { "const": false },
        "release_approval_allowed_now": { "const": false },
        "production_pass_enabled": { "const": false },
        "enterprise_pass_enabled": { "const": false },
        "enterprise_trust_claim_allowed_now": { "const": false },
        "protected_closeout_enabled": { "const": false },
        "human_gate_bypass_allowed_now": { "const": false },
        "independent_review_bypass_allowed_now": { "const": false },
        "single_owner_enterprise_trust_allowed_now": { "const": false },
        "runtime_execution_allowed_now": { "const": false },
        "write_action_allowed_now": { "const": false },
        "protected_action_allowed_now": { "const": false },
        "connector_write_enabled": { "const": false },
        "external_service_mutation_allowed_now": { "const": false },
        "raw_source_exposure_allowed": { "const": false },
        "secret_read_allowed_now": { "const": false },
        "reviewer_mutation_allowed_now": { "const": false },
        "final_automated_approval_allowed": { "const": false }
      }
    },
    "validation": {
      "type": "object",
      "required": ["valid", "error_count", "errors"],
      "properties": {
        "valid": { "type": "boolean" },
        "error_count": { "type": "number" },
        "errors": { "type": "array" }
      }
    }
  },
  "$defs": {
    "verdictRow": {
      "type": "object",
      "required": [
        "row_id",
        "category",
        "label",
        "observed",
        "current_verdict",
        "block_reason",
        "evidence_ref",
        "generated_at"
      ],
      "properties": {
        "row_id": { "type": "string", "minLength": 1 },
        "category": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "observed": { "type": "boolean" },
        "current_verdict": { "enum": ["pass", "blocked"] },
        "block_reason": { "type": ["string", "null"] },
        "evidence_ref": { "type": "string", "minLength": 1 },
        "generated_at": { "type": "string", "format": "date-time" }
      }
    },
    "validationItem": {
      "type": "object",
      "required": ["item_id", "category", "passed", "message", "evidence_ref"],
      "properties": {
        "item_id": { "type": "string", "minLength": 1 },
        "category": { "type": "string", "minLength": 1 },
        "passed": { "type": "boolean" },
        "message": { "type": "string" },
        "evidence_ref": { "type": "string", "minLength": 1 }
      }
    }
  }
}
