{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://amic.local/hermes/fact-claim-store.schema.json",
  "title": "Hermes Fact Claim Store",
  "type": "object",
  "required": [
    "schema_version",
    "generated_at",
    "fact_claim_store_id",
    "output_dir",
    "inputs",
    "source_evidence_item_store",
    "fact_claim_store_contract",
    "fact_claim_catalog",
    "validation_items",
    "validation",
    "summary"
  ],
  "properties": {
    "schema_version": { "const": "fact-claim-store.v1" },
    "generated_at": { "type": "string", "format": "date-time" },
    "fact_claim_store_id": { "type": "string" },
    "output_dir": { "type": "string" },
    "inputs": {
      "type": "object",
      "required": ["evidence_item_store_path", "package_path", "roadmap_path"],
      "properties": {
        "evidence_item_store_path": { "type": "string" },
        "package_path": { "type": "string" },
        "roadmap_path": { "type": "string" }
      }
    },
    "source_evidence_item_store": { "$ref": "#/$defs/source_summary" },
    "fact_claim_store_contract": { "$ref": "#/$defs/store_contract" },
    "fact_claim_catalog": {
      "type": "object",
      "required": ["schema_version", "generated_at", "fact_claims", "evidence_bindings", "review_queue_items", "fact_claim_indexes"],
      "properties": {
        "schema_version": { "const": "fact-claim-catalog.v1" },
        "generated_at": { "type": "string", "format": "date-time" },
        "fact_claims": { "type": "array", "items": { "$ref": "#/$defs/fact_claim" } },
        "evidence_bindings": { "type": "array", "items": { "$ref": "#/$defs/evidence_binding" } },
        "review_queue_items": { "type": "array", "items": { "$ref": "#/$defs/review_queue_item" } },
        "fact_claim_indexes": { "$ref": "#/$defs/indexes" }
      }
    },
    "validation_items": { "type": "array", "items": { "$ref": "#/$defs/validation_item" } },
    "validation": {
      "type": "object",
      "required": ["valid", "errors"],
      "properties": {
        "valid": { "type": "boolean" },
        "errors": { "type": "array", "items": { "$ref": "#/$defs/validation_error" } }
      }
    },
    "summary": { "$ref": "#/$defs/summary" }
  },
  "$defs": {
    "source_summary": {
      "type": "object",
      "required": ["source_id", "schema_version", "generated_at", "summary"],
      "properties": {
        "source_id": { "type": "string" },
        "schema_version": { "type": ["string", "null"] },
        "generated_at": { "type": ["string", "null"] },
        "summary": { "type": ["object", "null"] }
      }
    },
    "store_contract": {
      "type": "object",
      "required": [
        "schema_version",
        "fact_claim_store_contract_id",
        "generated_at",
        "evidence_item_schema_version",
        "fact_claim_schema_version",
        "source_inputs",
        "required_identity_fields",
        "required_lineage_links",
        "reliability_rule",
        "review_rule",
        "classification_rule",
        "matter_boundary_rule"
      ],
      "properties": {
        "schema_version": { "const": "fact-claim-store-contract.v1" },
        "fact_claim_store_contract_id": { "const": "fact-claim-store.v1" },
        "generated_at": { "type": "string", "format": "date-time" },
        "evidence_item_schema_version": { "const": "evidence-item.v2" },
        "fact_claim_schema_version": { "const": "fact-claim.v2" },
        "source_inputs": { "type": "array", "items": { "type": "string" } },
        "required_identity_fields": { "type": "array", "items": { "type": "string" } },
        "required_lineage_links": { "type": "array", "items": { "type": "string" } },
        "reliability_rule": { "type": "string" },
        "review_rule": { "type": "string" },
        "classification_rule": { "type": "string" },
        "matter_boundary_rule": { "type": "string" }
      }
    },
    "fact_claim": {
      "type": "object",
      "required": [
        "schema_version",
        "fact_id",
        "fact_store_record_id",
        "tenant_id",
        "matter_id",
        "classification",
        "policy_snapshot_id",
        "evidence_item_ids",
        "evidence_item_count",
        "primary_evidence_item_id",
        "source_span_ids",
        "source_span_count",
        "statement",
        "fact_type",
        "confidence",
        "reliability",
        "evidence_reliability",
        "review_status",
        "verification_state",
        "lineage_id",
        "created_at",
        "metadata"
      ],
      "properties": {
        "schema_version": { "const": "fact-claim.v2" },
        "fact_id": { "type": "string" },
        "fact_store_record_id": { "type": "string" },
        "tenant_id": { "type": ["string", "null"] },
        "matter_id": { "type": ["string", "null"] },
        "classification": { "type": ["string", "null"] },
        "policy_snapshot_id": { "type": ["string", "null"] },
        "evidence_item_ids": { "type": "array", "items": { "type": "string" } },
        "evidence_item_count": { "type": "integer", "minimum": 0 },
        "primary_evidence_item_id": { "type": "string" },
        "source_span_ids": { "type": "array", "items": { "type": "string" } },
        "source_span_count": { "type": "integer", "minimum": 0 },
        "statement": { "type": "string" },
        "fact_type": { "type": "string" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "reliability": { "type": "string" },
        "evidence_reliability": { "type": "string" },
        "review_status": { "type": "string" },
        "verification_state": { "type": "string" },
        "lineage_id": { "type": "string" },
        "created_at": { "type": "string", "format": "date-time" },
        "metadata": { "type": "object" }
      }
    },
    "evidence_binding": {
      "type": "object",
      "required": [
        "schema_version",
        "fact_evidence_binding_id",
        "fact_id",
        "evidence_id",
        "binding_status",
        "tenant_id",
        "matter_id",
        "classification",
        "reliability",
        "reliability_preserved",
        "matter_preserved",
        "classification_preserved",
        "policy_snapshot_preserved",
        "created_at"
      ],
      "properties": {
        "schema_version": { "const": "fact-evidence-binding.v1" },
        "fact_evidence_binding_id": { "type": "string" },
        "fact_id": { "type": "string" },
        "evidence_id": { "type": "string" },
        "binding_status": { "enum": ["bound", "broken"] },
        "tenant_id": { "type": ["string", "null"] },
        "matter_id": { "type": ["string", "null"] },
        "classification": { "type": ["string", "null"] },
        "reliability": { "type": "string" },
        "reliability_preserved": { "type": "boolean" },
        "matter_preserved": { "type": "boolean" },
        "classification_preserved": { "type": "boolean" },
        "policy_snapshot_preserved": { "type": "boolean" },
        "created_at": { "type": "string", "format": "date-time" }
      }
    },
    "review_queue_item": {
      "type": "object",
      "required": [
        "schema_version",
        "review_queue_item_id",
        "fact_id",
        "subject_type",
        "subject_id",
        "matter_id",
        "classification",
        "review_status",
        "review_required",
        "approval_required_before_output",
        "queue_reason",
        "assigned_role",
        "created_at"
      ],
      "properties": {
        "schema_version": { "const": "fact-review-queue-item.v1" },
        "review_queue_item_id": { "type": "string" },
        "fact_id": { "type": "string" },
        "subject_type": { "const": "fact_claim" },
        "subject_id": { "type": "string" },
        "matter_id": { "type": ["string", "null"] },
        "classification": { "type": ["string", "null"] },
        "review_status": { "type": "string" },
        "review_required": { "type": "boolean" },
        "approval_required_before_output": { "type": "boolean" },
        "queue_reason": { "type": "string" },
        "assigned_role": { "type": "string" },
        "created_at": { "type": "string", "format": "date-time" }
      }
    },
    "indexes": {
      "type": "object",
      "required": [
        "schema_version",
        "generated_at",
        "by_matter_id",
        "by_classification",
        "by_review_status",
        "by_fact_type",
        "by_reliability",
        "by_binding_status"
      ],
      "properties": {
        "schema_version": { "const": "fact-claim-indexes.v1" },
        "generated_at": { "type": "string", "format": "date-time" },
        "by_matter_id": { "type": "object" },
        "by_classification": { "type": "object" },
        "by_review_status": { "type": "object" },
        "by_fact_type": { "type": "object" },
        "by_reliability": { "type": "object" },
        "by_binding_status": { "type": "object" }
      }
    },
    "validation_item": {
      "type": "object",
      "required": ["validation_id", "path", "check_id", "status", "severity", "message"],
      "properties": {
        "validation_id": { "type": "string" },
        "path": { "type": "string" },
        "check_id": { "type": "string" },
        "status": { "enum": ["passed", "failed"] },
        "severity": { "enum": ["info", "error"] },
        "message": { "type": "string" }
      }
    },
    "validation_error": {
      "type": "object",
      "required": ["path", "message"],
      "properties": {
        "path": { "type": "string" },
        "message": { "type": "string" }
      }
    },
    "summary": {
      "type": "object",
      "required": [
        "fact_claim_store_status",
        "fact_claim_store_contract_id",
        "fact_claim_schema_version",
        "evidence_item_store_status",
        "evidence_item_count",
        "fact_claim_count",
        "fact_evidence_binding_count",
        "review_queue_item_count",
        "evidence_linked_fact_count",
        "reliability_preserved_fact_count",
        "matter_preserved_fact_count",
        "classification_preserved_fact_count",
        "policy_snapshot_preserved_fact_count",
        "machine_extracted_fact_count",
        "needs_review_count",
        "approved_count",
        "average_confidence",
        "validation_item_count",
        "failed_validation_item_count",
        "validation_error_count",
        "by_matter_id",
        "by_classification",
        "by_review_status",
        "by_fact_type",
        "by_reliability"
      ],
      "properties": {
        "fact_claim_store_status": { "enum": ["complete", "blocked"] },
        "fact_claim_store_contract_id": { "const": "fact-claim-store.v1" },
        "fact_claim_schema_version": { "const": "fact-claim.v2" },
        "evidence_item_store_status": { "type": "string" },
        "evidence_item_count": { "type": "integer", "minimum": 0 },
        "fact_claim_count": { "type": "integer", "minimum": 0 },
        "fact_evidence_binding_count": { "type": "integer", "minimum": 0 },
        "review_queue_item_count": { "type": "integer", "minimum": 0 },
        "evidence_linked_fact_count": { "type": "integer", "minimum": 0 },
        "reliability_preserved_fact_count": { "type": "integer", "minimum": 0 },
        "matter_preserved_fact_count": { "type": "integer", "minimum": 0 },
        "classification_preserved_fact_count": { "type": "integer", "minimum": 0 },
        "policy_snapshot_preserved_fact_count": { "type": "integer", "minimum": 0 },
        "machine_extracted_fact_count": { "type": "integer", "minimum": 0 },
        "needs_review_count": { "type": "integer", "minimum": 0 },
        "approved_count": { "type": "integer", "minimum": 0 },
        "average_confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "validation_item_count": { "type": "integer", "minimum": 0 },
        "failed_validation_item_count": { "type": "integer", "minimum": 0 },
        "validation_error_count": { "type": "integer", "minimum": 0 },
        "by_matter_id": { "type": "object" },
        "by_classification": { "type": "object" },
        "by_review_status": { "type": "object" },
        "by_fact_type": { "type": "object" },
        "by_reliability": { "type": "object" }
      }
    }
  }
}
