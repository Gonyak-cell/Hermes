{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://amic.local/hermes/approval-queue-ui.schema.json",
  "title": "Hermes Approval Queue UI",
  "type": "object",
  "required": [
    "schema_version",
    "generated_at",
    "approval_queue_ui_id",
    "approval_queue_ui_status",
    "phase_slot",
    "previous_phase_slot",
    "next_phase_slot",
    "summary",
    "approval_queue_ui_panels",
    "approval_queue_ui_items",
    "approval_queue_target_artifacts",
    "approval_queue_receipt_previews",
    "approval_queue_protected_request_previews",
    "approval_queue_ui_boundary",
    "approval_queue_ui_checks",
    "validation_items",
    "validation"
  ],
  "properties": {
    "schema_version": { "const": "approval-queue-ui.v1" },
    "generated_at": { "type": "string", "format": "date-time" },
    "approval_queue_ui_id": { "type": "string" },
    "approval_queue_ui_status": { "enum": ["complete", "attention"] },
    "phase_slot": { "const": "P289" },
    "previous_phase_slot": { "const": "P288" },
    "next_phase_slot": { "const": "P290" },
    "summary": {
      "type": "object",
      "required": [
        "approval_queue_ui_status",
        "phase_slot",
        "previous_phase_slot",
        "next_phase_slot",
        "source_dashboard_information_architecture_status",
        "source_dashboard_information_architecture_phase_slot",
        "source_dashboard_information_architecture_next_phase_slot",
        "source_pending_approval_count",
        "approval_queue_ui_panel_count",
        "required_panel_count",
        "ready_panel_count",
        "approval_queue_ui_item_count",
        "pending_approval_item_count",
        "missing_required_actor_count",
        "target_artifact_count",
        "linked_target_artifact_count",
        "receipt_preview_count",
        "receipt_preview_available_count",
        "protected_request_preview_count",
        "actual_protected_request_preview_count",
        "read_only",
        "ui_projection_only",
        "receipt_preview_only",
        "protected_request_preview_only",
        "approval_application_performed",
        "receipt_application_performed",
        "protected_action_executed",
        "route_execution_performed",
        "server_started",
        "mutation_allowed",
        "legal_advice_generated",
        "client_facing_output_generated",
        "windows_baseline_stability_preserved",
        "mac_windows_completion_instability_guard",
        "validation_error_count"
      ],
      "properties": {
        "approval_queue_ui_status": { "const": "complete" },
        "phase_slot": { "const": "P289" },
        "previous_phase_slot": { "const": "P288" },
        "next_phase_slot": { "const": "P290" },
        "source_dashboard_information_architecture_status": { "const": "complete" },
        "source_dashboard_information_architecture_phase_slot": { "const": "P288" },
        "source_dashboard_information_architecture_next_phase_slot": { "const": "P289" },
        "source_pending_approval_count": { "minimum": 1 },
        "approval_queue_ui_panel_count": { "const": 5 },
        "required_panel_count": { "const": 5 },
        "ready_panel_count": { "const": 5 },
        "approval_queue_ui_item_count": { "minimum": 1 },
        "pending_approval_item_count": { "minimum": 1 },
        "missing_required_actor_count": { "const": 0 },
        "target_artifact_count": { "minimum": 1 },
        "linked_target_artifact_count": { "minimum": 1 },
        "receipt_preview_count": { "minimum": 1 },
        "receipt_preview_available_count": { "minimum": 1 },
        "protected_request_preview_count": { "minimum": 1 },
        "actual_protected_request_preview_count": { "minimum": 1 },
        "read_only": { "const": true },
        "ui_projection_only": { "const": true },
        "receipt_preview_only": { "const": true },
        "protected_request_preview_only": { "const": true },
        "approval_application_performed": { "const": false },
        "receipt_application_performed": { "const": false },
        "protected_action_executed": { "const": false },
        "route_execution_performed": { "const": false },
        "server_started": { "const": false },
        "mutation_allowed": { "const": false },
        "legal_advice_generated": { "const": false },
        "client_facing_output_generated": { "const": false },
        "windows_baseline_stability_preserved": { "const": true },
        "mac_windows_completion_instability_guard": { "const": true },
        "validation_error_count": { "const": 0 }
      },
      "additionalProperties": true
    },
    "approval_queue_ui_panels": {
      "type": "array",
      "minItems": 5,
      "items": { "$ref": "#/$defs/panel" }
    },
    "approval_queue_ui_items": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/item" }
    },
    "approval_queue_target_artifacts": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/target_artifact" }
    },
    "approval_queue_receipt_previews": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/receipt_preview" }
    },
    "approval_queue_protected_request_previews": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/protected_request_preview" }
    },
    "approval_queue_ui_boundary": { "$ref": "#/$defs/boundary" },
    "approval_queue_ui_checks": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/check" }
    },
    "validation_items": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/check" }
    },
    "validation": {
      "type": "object",
      "required": ["valid", "item_count", "error_count", "errors"],
      "properties": {
        "valid": { "const": true },
        "item_count": { "minimum": 1 },
        "error_count": { "const": 0 },
        "errors": { "type": "array", "maxItems": 0 }
      },
      "additionalProperties": true
    }
  },
  "$defs": {
    "panel": {
      "type": "object",
      "required": [
        "panel_key",
        "panel_label",
        "panel_order",
        "panel_status",
        "read_only",
        "preview_only",
        "mutation_allowed",
        "approval_application_allowed",
        "receipt_application_allowed",
        "protected_action_execution_allowed",
        "human_review_required",
        "client_facing_ready"
      ],
      "properties": {
        "panel_key": {
          "enum": ["pending_approvals", "required_actors", "target_artifacts", "receipt_drafts", "protected_requests"]
        },
        "panel_status": { "const": "ready" },
        "read_only": { "const": true },
        "preview_only": { "const": true },
        "mutation_allowed": { "const": false },
        "approval_application_allowed": { "const": false },
        "receipt_application_allowed": { "const": false },
        "protected_action_execution_allowed": { "const": false },
        "human_review_required": { "const": true },
        "client_facing_ready": { "const": false }
      },
      "additionalProperties": true
    },
    "item": {
      "type": "object",
      "required": [
        "approval_queue_ui_item_id",
        "source_stage",
        "source_item_id",
        "item_status",
        "display_status",
        "priority",
        "required_actor",
        "target_artifact_ref",
        "target_artifact_lookup_id",
        "receipt_draft_preview_id",
        "protected_request_preview_id",
        "pending_approval",
        "read_only",
        "preview_only",
        "approval_application_allowed",
        "receipt_application_allowed",
        "protected_action_execution_allowed",
        "human_review_required",
        "client_facing_ready"
      ],
      "properties": {
        "source_stage": {
          "enum": ["approval_queue", "approval_inbox", "protected_approval_request_pack"]
        },
        "display_status": {
          "enum": ["pending_human_decision", "pending_explicit_approval"]
        },
        "priority": { "enum": ["critical", "high", "medium", "low"] },
        "required_actor": { "type": "string", "minLength": 1 },
        "target_artifact_ref": { "type": "object" },
        "pending_approval": { "const": true },
        "read_only": { "const": true },
        "preview_only": { "const": true },
        "approval_application_allowed": { "const": false },
        "receipt_application_allowed": { "const": false },
        "protected_action_execution_allowed": { "const": false },
        "human_review_required": { "const": true },
        "client_facing_ready": { "const": false }
      },
      "additionalProperties": true
    },
    "target_artifact": {
      "type": "object",
      "required": [
        "target_artifact_lookup_id",
        "approval_queue_ui_item_id",
        "source_stage",
        "source_item_id",
        "target_artifact_lookup_status",
        "target_artifact_ref",
        "read_only",
        "lookup_only",
        "mutation_allowed",
        "protected_action_execution_allowed",
        "human_review_required",
        "client_facing_ready"
      ],
      "properties": {
        "target_artifact_lookup_status": { "const": "linked" },
        "target_artifact_ref": { "type": "object" },
        "read_only": { "const": true },
        "lookup_only": { "const": true },
        "mutation_allowed": { "const": false },
        "protected_action_execution_allowed": { "const": false },
        "human_review_required": { "const": true },
        "client_facing_ready": { "const": false }
      },
      "additionalProperties": true
    },
    "receipt_preview": {
      "type": "object",
      "required": [
        "receipt_draft_preview_id",
        "approval_queue_ui_item_id",
        "source_stage",
        "source_item_id",
        "receipt_preview_status",
        "required_actor",
        "receipt_form_draft",
        "read_only",
        "preview_only",
        "receipt_application_allowed",
        "protected_action_execution_allowed",
        "human_review_required",
        "client_facing_ready"
      ],
      "properties": {
        "receipt_preview_status": {
          "enum": ["draft_available", "protected_approval_receipt_available", "fallback_draft"]
        },
        "required_actor": { "type": "string", "minLength": 1 },
        "receipt_form_draft": { "type": "object" },
        "read_only": { "const": true },
        "preview_only": { "const": true },
        "receipt_application_allowed": { "const": false },
        "protected_action_execution_allowed": { "const": false },
        "human_review_required": { "const": true },
        "client_facing_ready": { "const": false }
      },
      "additionalProperties": true
    },
    "protected_request_preview": {
      "type": "object",
      "required": [
        "protected_request_preview_id",
        "approval_queue_ui_item_id",
        "source_stage",
        "source_item_id",
        "protected_request_preview_status",
        "protected_action",
        "requires_explicit_human_approval",
        "read_only",
        "preview_only",
        "approval_application_allowed",
        "protected_action_execution_allowed",
        "client_facing_ready"
      ],
      "properties": {
        "protected_request_preview_status": {
          "enum": ["pending_explicit_approval", "not_required"]
        },
        "protected_action": { "type": "boolean" },
        "requires_explicit_human_approval": { "type": "boolean" },
        "read_only": { "const": true },
        "preview_only": { "const": true },
        "approval_application_allowed": { "const": false },
        "protected_action_execution_allowed": { "const": false },
        "client_facing_ready": { "const": false }
      },
      "additionalProperties": true
    },
    "boundary": {
      "type": "object",
      "required": [
        "boundary_status",
        "read_only",
        "ui_projection_only",
        "receipt_preview_only",
        "protected_request_preview_only",
        "approval_application_performed",
        "receipt_application_performed",
        "protected_action_executed",
        "route_execution_performed",
        "server_started",
        "mutation_allowed",
        "legal_advice_generated",
        "client_facing_output_generated",
        "windows_baseline_stability_preserved",
        "mac_windows_completion_instability_guard"
      ],
      "properties": {
        "boundary_status": { "const": "enforced" },
        "read_only": { "const": true },
        "ui_projection_only": { "const": true },
        "receipt_preview_only": { "const": true },
        "protected_request_preview_only": { "const": true },
        "approval_application_performed": { "const": false },
        "receipt_application_performed": { "const": false },
        "protected_action_executed": { "const": false },
        "route_execution_performed": { "const": false },
        "server_started": { "const": false },
        "mutation_allowed": { "const": false },
        "legal_advice_generated": { "const": false },
        "client_facing_output_generated": { "const": false },
        "windows_baseline_stability_preserved": { "const": true },
        "mac_windows_completion_instability_guard": { "const": true }
      },
      "additionalProperties": true
    },
    "check": {
      "type": "object",
      "required": ["path", "checkpoint_id", "check_id", "status", "message", "human_review_required", "client_facing_ready"],
      "properties": {
        "status": { "const": "passed" },
        "human_review_required": { "const": true },
        "client_facing_ready": { "const": false }
      },
      "additionalProperties": true
    }
  }
}
