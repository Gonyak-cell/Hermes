{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hermes.local/schemas/issue-intake-adapter.schema.json",
  "title": "Issue Intake Adapter",
  "type": "object",
  "required": [
    "schema_version",
    "generated_at",
    "issue_intake_adapter_id",
    "output_dir",
    "issue_intake_status",
    "safe_handling",
    "inputs",
    "source_contracts",
    "issue_intake_contract",
    "issue_intake_sources",
    "issue_intake_records",
    "normalized_task_contracts",
    "issue_task_bindings",
    "issue_intake_desktop_boundary",
    "issue_intake_checkpoints",
    "validation_items",
    "validation",
    "summary"
  ],
  "properties": {
    "schema_version": { "const": "issue-intake-adapter.v1" },
    "generated_at": { "type": "string", "format": "date-time" },
    "issue_intake_adapter_id": { "type": "string", "minLength": 1 },
    "output_dir": { "type": "string" },
    "issue_intake_status": { "enum": ["complete", "blocked"] },
    "safe_handling": {
      "type": "object",
      "required": [
        "report_only",
        "external_fetch_allowed",
        "external_fetch_performed",
        "issue_mutation_allowed",
        "issue_mutation_performed",
        "task_state_mutation_allowed",
        "task_state_mutation_performed",
        "runtime_execution_performed",
        "protected_mutation_executed",
        "desktop_mutation_allowed",
        "desktop_issue_write_allowed",
        "desktop_task_state_write_allowed",
        "desktop_runtime_execution_allowed",
        "desktop_source_of_truth",
        "secret_material_exposed",
        "provider_key_visible",
        "installer_or_gateway_control",
        "ssh_or_cron_control"
      ],
      "properties": {
        "report_only": { "const": true },
        "external_fetch_allowed": { "const": false },
        "external_fetch_performed": { "const": false },
        "issue_mutation_allowed": { "const": false },
        "issue_mutation_performed": { "const": false },
        "task_state_mutation_allowed": { "const": false },
        "task_state_mutation_performed": { "const": false },
        "runtime_execution_performed": { "const": false },
        "protected_mutation_executed": { "const": false },
        "desktop_mutation_allowed": { "const": false },
        "desktop_issue_write_allowed": { "const": false },
        "desktop_task_state_write_allowed": { "const": false },
        "desktop_runtime_execution_allowed": { "const": false },
        "desktop_source_of_truth": { "const": false },
        "secret_material_exposed": { "const": false },
        "provider_key_visible": { "const": false },
        "installer_or_gateway_control": { "const": false },
        "ssh_or_cron_control": { "const": false }
      },
      "additionalProperties": true
    },
    "inputs": { "type": "object" },
    "source_contracts": { "type": "object" },
    "issue_intake_contract": {
      "type": "object",
      "required": [
        "schema_version",
        "contract_id",
        "pack_id",
        "capability_id",
        "source_of_truth",
        "intake_rule",
        "source_rule",
        "task_rule",
        "desktop_companion_rule",
        "mutation_policy"
      ],
      "properties": {
        "schema_version": { "const": "issue-intake-contract.v1" },
        "contract_id": { "const": "issue-intake-adapter.v1" },
        "pack_id": { "const": "personal-dev" },
        "capability_id": { "const": "personal_dev.codex.worktree_patch" },
        "source_of_truth": { "const": "issue_tracker_payloads_normalized_to_task_contract" }
      },
      "additionalProperties": true
    },
    "issue_intake_sources": {
      "type": "array",
      "minItems": 3,
      "items": { "$ref": "#/$defs/issue_source" }
    },
    "issue_intake_records": {
      "type": "array",
      "minItems": 3,
      "items": { "$ref": "#/$defs/issue_record" }
    },
    "normalized_task_contracts": {
      "type": "array",
      "minItems": 3,
      "items": { "$ref": "#/$defs/normalized_task_contract" }
    },
    "issue_task_bindings": {
      "type": "array",
      "minItems": 3,
      "items": { "$ref": "#/$defs/issue_task_binding" }
    },
    "issue_intake_desktop_boundary": {
      "type": "object",
      "required": [
        "schema_version",
        "boundary_id",
        "pack_id",
        "desktop_read_only",
        "desktop_mutation_allowed",
        "desktop_issue_write_allowed",
        "desktop_task_state_write_allowed",
        "desktop_runtime_execution_allowed",
        "desktop_source_of_truth",
        "protected_mutations_require_human_gate",
        "issue_mutations_require_human_gate",
        "external_fetch_allowed",
        "external_fetch_performed_count",
        "issue_mutation_allowed",
        "issue_mutation_performed_count",
        "raw_secret_material_exposed",
        "provider_key_exposed",
        "installer_or_gateway_control",
        "ssh_or_cron_control",
        "boundary_status"
      ],
      "properties": {
        "schema_version": { "const": "issue-intake-desktop-boundary.v1" },
        "pack_id": { "const": "personal-dev" },
        "desktop_read_only": { "const": true },
        "desktop_mutation_allowed": { "const": false },
        "desktop_issue_write_allowed": { "const": false },
        "desktop_task_state_write_allowed": { "const": false },
        "desktop_runtime_execution_allowed": { "const": false },
        "desktop_source_of_truth": { "const": false },
        "protected_mutations_require_human_gate": { "const": true },
        "issue_mutations_require_human_gate": { "const": true },
        "external_fetch_allowed": { "const": false },
        "external_fetch_performed_count": { "const": 0 },
        "issue_mutation_allowed": { "const": false },
        "issue_mutation_performed_count": { "const": 0 },
        "raw_secret_material_exposed": { "const": false },
        "provider_key_exposed": { "const": false },
        "installer_or_gateway_control": { "const": false },
        "ssh_or_cron_control": { "const": false },
        "boundary_status": { "const": "enforced" }
      },
      "additionalProperties": true
    },
    "issue_intake_checkpoints": {
      "type": "array",
      "minItems": 10,
      "items": { "$ref": "#/$defs/checkpoint" }
    },
    "validation_items": {
      "type": "array",
      "items": { "$ref": "#/$defs/checkpoint" }
    },
    "validation": {
      "type": "object",
      "required": ["valid", "errors"],
      "properties": {
        "valid": { "type": "boolean" },
        "errors": { "type": "array" }
      },
      "additionalProperties": true
    },
    "summary": {
      "type": "object",
      "required": [
        "issue_intake_status",
        "issue_intake_contract_id",
        "pack_id",
        "capability_id",
        "source_of_truth",
        "repo_profile_detector_status",
        "agent_instruction_registry_status",
        "issue_source_count",
        "github_issue_source_count",
        "plane_issue_source_count",
        "local_issue_source_count",
        "issue_record_count",
        "normalized_issue_record_count",
        "normalized_task_count",
        "ready_normalized_task_count",
        "issue_task_binding_count",
        "bound_issue_task_binding_count",
        "unbound_issue_task_binding_count",
        "unresolved_issue_count",
        "duplicate_task_id_count",
        "external_fetch_performed_count",
        "issue_mutation_performed_count",
        "command_execution_performed_count",
        "desktop_read_only",
        "desktop_mutation_allowed",
        "desktop_issue_write_allowed",
        "desktop_task_state_write_allowed",
        "desktop_runtime_execution_allowed",
        "desktop_source_of_truth",
        "protected_mutations_require_human_gate",
        "issue_mutations_require_human_gate",
        "external_fetch_allowed",
        "raw_secret_material_exposed",
        "provider_key_exposed",
        "installer_or_gateway_control",
        "ssh_or_cron_control",
        "validation_error_count"
      ],
      "properties": {
        "issue_intake_status": { "enum": ["complete", "blocked"] },
        "issue_intake_contract_id": { "const": "issue-intake-adapter.v1" },
        "pack_id": { "const": "personal-dev" },
        "capability_id": { "const": "personal_dev.codex.worktree_patch" },
        "source_of_truth": { "const": "issue_tracker_payloads_normalized_to_task_contract" },
        "repo_profile_detector_status": { "const": "complete" },
        "agent_instruction_registry_status": { "const": "complete" },
        "issue_source_count": { "const": 3 },
        "github_issue_source_count": { "const": 1 },
        "plane_issue_source_count": { "const": 1 },
        "local_issue_source_count": { "const": 1 },
        "issue_record_count": { "const": 3 },
        "normalized_issue_record_count": { "const": 3 },
        "normalized_task_count": { "const": 3 },
        "ready_normalized_task_count": { "const": 3 },
        "issue_task_binding_count": { "const": 3 },
        "bound_issue_task_binding_count": { "const": 3 },
        "unbound_issue_task_binding_count": { "const": 0 },
        "unresolved_issue_count": { "const": 0 },
        "duplicate_task_id_count": { "const": 0 },
        "external_fetch_performed_count": { "const": 0 },
        "issue_mutation_performed_count": { "const": 0 },
        "command_execution_performed_count": { "const": 0 },
        "desktop_read_only": { "const": true },
        "desktop_mutation_allowed": { "const": false },
        "desktop_issue_write_allowed": { "const": false },
        "desktop_task_state_write_allowed": { "const": false },
        "desktop_runtime_execution_allowed": { "const": false },
        "desktop_source_of_truth": { "const": false },
        "protected_mutations_require_human_gate": { "const": true },
        "issue_mutations_require_human_gate": { "const": true },
        "external_fetch_allowed": { "const": false },
        "raw_secret_material_exposed": { "const": false },
        "provider_key_exposed": { "const": false },
        "installer_or_gateway_control": { "const": false },
        "ssh_or_cron_control": { "const": false },
        "validation_error_count": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": true
    }
  },
  "$defs": {
    "issue_source": {
      "type": "object",
      "required": [
        "schema_version",
        "issue_source_id",
        "source_system",
        "source_status",
        "external_fetch_performed",
        "issue_mutation_performed",
        "desktop_read_only",
        "desktop_mutation_allowed"
      ],
      "properties": {
        "schema_version": { "const": "issue-intake-source.v1" },
        "source_system": { "enum": ["github", "plane", "local"] },
        "source_status": { "const": "ready" },
        "external_fetch_performed": { "const": false },
        "issue_mutation_performed": { "const": false },
        "desktop_read_only": { "const": true },
        "desktop_mutation_allowed": { "const": false }
      },
      "additionalProperties": true
    },
    "issue_record": {
      "type": "object",
      "required": [
        "schema_version",
        "issue_record_id",
        "issue_source_id",
        "source_system",
        "source_issue_id",
        "issue_title",
        "issue_status",
        "normalized_task_status",
        "priority",
        "source_payload_hash",
        "external_fetch_performed",
        "issue_mutation_performed",
        "issue_record_status"
      ],
      "properties": {
        "schema_version": { "const": "issue-intake-record.v1" },
        "source_system": { "enum": ["github", "plane", "local"] },
        "normalized_task_status": { "enum": ["next", "in-progress", "blocked", "review", "done"] },
        "priority": { "enum": ["p0", "p1", "p2", "p3"] },
        "external_fetch_performed": { "const": false },
        "issue_mutation_performed": { "const": false },
        "issue_record_status": { "const": "normalized" }
      },
      "additionalProperties": true
    },
    "normalized_task_contract": {
      "type": "object",
      "required": [
        "schema_version",
        "task_contract_id",
        "task_id",
        "task_title",
        "task_status",
        "task_priority",
        "pack_id",
        "capability_id",
        "source_system",
        "source_issue_id",
        "issue_record_id",
        "external_fetch_performed",
        "issue_mutation_performed",
        "command_execution_performed",
        "desktop_read_only",
        "desktop_mutation_allowed",
        "desktop_source_of_truth",
        "protected_mutations_require_human_gate",
        "human_gate_required_for_execution",
        "normalized_task_status"
      ],
      "properties": {
        "schema_version": { "const": "normalized-task-contract.v1" },
        "task_status": { "enum": ["next", "in-progress", "blocked", "review", "done"] },
        "task_priority": { "enum": ["p0", "p1", "p2", "p3"] },
        "pack_id": { "const": "personal-dev" },
        "capability_id": { "const": "personal_dev.codex.worktree_patch" },
        "source_system": { "enum": ["github", "plane", "local"] },
        "external_fetch_performed": { "const": false },
        "issue_mutation_performed": { "const": false },
        "command_execution_performed": { "const": false },
        "desktop_read_only": { "const": true },
        "desktop_mutation_allowed": { "const": false },
        "desktop_source_of_truth": { "const": false },
        "protected_mutations_require_human_gate": { "const": true },
        "human_gate_required_for_execution": { "const": true },
        "normalized_task_status": { "const": "ready_for_workflow" }
      },
      "additionalProperties": true
    },
    "issue_task_binding": {
      "type": "object",
      "required": [
        "schema_version",
        "issue_task_binding_id",
        "issue_record_id",
        "issue_source_id",
        "source_system",
        "source_issue_id",
        "task_contract_id",
        "task_id",
        "binding_status",
        "desktop_read_only",
        "desktop_mutation_allowed"
      ],
      "properties": {
        "schema_version": { "const": "issue-task-binding.v1" },
        "source_system": { "enum": ["github", "plane", "local"] },
        "binding_status": { "const": "bound" },
        "desktop_read_only": { "const": true },
        "desktop_mutation_allowed": { "const": false }
      },
      "additionalProperties": true
    },
    "checkpoint": {
      "type": "object",
      "required": ["schema_version", "checkpoint_id", "status", "message"],
      "properties": {
        "schema_version": { "const": "issue-intake-checkpoint.v1" },
        "status": { "enum": ["passed", "failed"] }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
