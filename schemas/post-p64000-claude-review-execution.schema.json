{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hermes.local/schemas/post-p64000-claude-review-execution.schema.json",
  "title": "Post-P64000 Claude Review Execution",
  "type": "object",
  "required": [
    "schema_version",
    "capability_id",
    "program_range",
    "source_program_range",
    "next_program_range",
    "post_p64000_claude_review_execution_contract",
    "p64400_baseline_source_rows",
    "claude_review_execution_rows",
    "raw_review_output_shape_rows",
    "authority_boundary_rows",
    "negative_fixture_contract_rows",
    "validation_command_rows",
    "p64800_wiring_rows",
    "p64800_closeout_rows",
    "p64801_handoff_rows",
    "extracted_review_payload",
    "post_p64000_claude_review_execution_boundary",
    "summary",
    "validation"
  ],
  "properties": {
    "schema_version": { "const": "post-p64000-claude-review-execution.v1" },
    "capability_id": { "const": "platform.post_p64000_claude_review_execution" },
    "program_range": { "const": "P64401-P64800" },
    "source_program_range": { "const": "P64001-P64400" },
    "next_program_range": { "const": "P64801-P65200" },
    "post_p64000_claude_review_execution_contract": {
      "type": "object",
      "required": [
        "raw_capture_is_evidence_only",
        "blocking_findings_go_to_finding_loop",
        "claude_source_mutation_allowed",
        "claude_final_approval_allowed",
        "production_pass_allowed",
        "enterprise_pass_allowed"
      ],
      "properties": {
        "raw_capture_is_evidence_only": { "const": true },
        "blocking_findings_go_to_finding_loop": { "const": true },
        "claude_source_mutation_allowed": { "const": false },
        "claude_final_approval_allowed": { "const": false },
        "production_pass_allowed": { "const": false },
        "enterprise_pass_allowed": { "const": false }
      },
      "additionalProperties": true
    },
    "p64400_baseline_source_rows": { "type": "array", "minItems": 5, "items": { "$ref": "#/$defs/verdictRow" } },
    "claude_review_execution_rows": { "type": "array", "minItems": 6, "items": { "$ref": "#/$defs/verdictRow" } },
    "raw_review_output_shape_rows": { "type": "array", "minItems": 6, "items": { "$ref": "#/$defs/verdictRow" } },
    "authority_boundary_rows": { "type": "array", "minItems": 28, "items": { "$ref": "#/$defs/verdictRow" } },
    "negative_fixture_contract_rows": { "type": "array", "minItems": 12, "items": { "$ref": "#/$defs/verdictRow" } },
    "validation_command_rows": { "type": "array", "minItems": 9, "items": { "$ref": "#/$defs/verdictRow" } },
    "p64800_wiring_rows": { "type": "array", "minItems": 3, "items": { "$ref": "#/$defs/verdictRow" } },
    "p64800_closeout_rows": { "type": "array", "minItems": 7, "items": { "$ref": "#/$defs/verdictRow" } },
    "p64801_handoff_rows": { "type": "array", "minItems": 3, "items": { "$ref": "#/$defs/verdictRow" } },
    "extracted_review_payload": {
      "type": ["object", "null"],
      "required": ["overall_verdict", "blocks_clean_checkpoint", "open_blocking_finding_count", "findings"],
      "properties": {
        "overall_verdict": { "type": "string" },
        "blocks_clean_checkpoint": { "type": "boolean" },
        "open_blocking_finding_count": { "type": "number" },
        "findings": { "type": "array" }
      },
      "additionalProperties": true
    },
    "post_p64000_claude_review_execution_boundary": {
      "type": "object",
      "required": [
        "post_p64000_claude_review_execution_ready",
        "p64400_baseline_ready_now",
        "raw_review_capture_valid_now",
        "raw_review_output_shape_ready_now",
        "ready_for_p64801_handoff",
        "review_verdict",
        "blocks_clean_checkpoint",
        "open_blocking_finding_count",
        "runtime_execution_allowed_now",
        "write_action_allowed_now",
        "connector_write_allowed_now",
        "protected_action_allowed_now",
        "claude_source_mutation_allowed_now",
        "claude_final_approval_claim_allowed_now",
        "claude_receipt_normalization_allowed_now",
        "finding_resolution_allowed_now",
        "protected_closeout_from_review_allowed_now",
        "post_p64800_production_pass_claim_allowed_now",
        "post_p64800_enterprise_pass_claim_allowed_now",
        "production_pass_allowed_now",
        "enterprise_pass_allowed_now",
        "codex_final_approval_allowed",
        "claude_final_approval_allowed",
        "production_pass_enabled",
        "enterprise_pass_enabled",
        "final_approval_enabled"
      ],
      "properties": {
        "post_p64000_claude_review_execution_ready": { "type": "boolean" },
        "p64400_baseline_ready_now": { "type": "boolean" },
        "raw_review_capture_valid_now": { "type": "boolean" },
        "raw_review_output_shape_ready_now": { "type": "boolean" },
        "ready_for_p64801_handoff": { "type": "boolean" },
        "review_verdict": { "type": "string" },
        "blocks_clean_checkpoint": { "type": "boolean" },
        "open_blocking_finding_count": { "type": "number" },
        "runtime_execution_allowed_now": { "const": false },
        "write_action_allowed_now": { "const": false },
        "connector_write_allowed_now": { "const": false },
        "protected_action_allowed_now": { "const": false },
        "claude_source_mutation_allowed_now": { "const": false },
        "claude_final_approval_claim_allowed_now": { "const": false },
        "claude_receipt_normalization_allowed_now": { "const": false },
        "finding_resolution_allowed_now": { "const": false },
        "protected_closeout_from_review_allowed_now": { "const": false },
        "post_p64800_production_pass_claim_allowed_now": { "const": false },
        "post_p64800_enterprise_pass_claim_allowed_now": { "const": false },
        "production_pass_allowed_now": { "const": false },
        "enterprise_pass_allowed_now": { "const": false },
        "codex_final_approval_allowed": { "const": false },
        "claude_final_approval_allowed": { "const": false },
        "production_pass_enabled": { "const": false },
        "enterprise_pass_enabled": { "const": false },
        "final_approval_enabled": { "const": false }
      },
      "additionalProperties": true
    },
    "summary": {
      "type": "object",
      "required": [
        "post_p64000_claude_review_execution_status",
        "program_range",
        "source_program_range",
        "next_program_range",
        "p64400_baseline_ready_now",
        "raw_review_capture_valid_now",
        "review_verdict",
        "open_blocking_finding_count",
        "ready_for_p64801_handoff",
        "claude_source_mutation_allowed_now",
        "production_pass_enabled",
        "enterprise_pass_enabled",
        "final_approval_enabled"
      ],
      "properties": {
        "post_p64000_claude_review_execution_status": {
          "enum": [
            "review_captured_blocked_findings_ready_for_p64801",
            "review_captured_clean_ready_for_p64801",
            "valid_block_p64801_handoff_pending",
            "blocked_post_p64000_claude_review_execution"
          ]
        },
        "program_range": { "const": "P64401-P64800" },
        "source_program_range": { "const": "P64001-P64400" },
        "next_program_range": { "const": "P64801-P65200" },
        "claude_source_mutation_allowed_now": { "const": false },
        "production_pass_enabled": { "const": false },
        "enterprise_pass_enabled": { "const": false },
        "final_approval_enabled": { "const": false }
      },
      "additionalProperties": true
    },
    "validation": {
      "type": "object",
      "required": ["valid", "error_count", "errors"],
      "properties": {
        "valid": { "type": "boolean" },
        "error_count": { "type": "number" },
        "errors": { "type": "array" }
      },
      "additionalProperties": true
    }
  },
  "$defs": {
    "verdictRow": {
      "type": "object",
      "required": [
        "row_id",
        "category",
        "label",
        "observed",
        "current_verdict",
        "evidence_ref",
        "block_reason",
        "next_allowed_action",
        "generated_at"
      ],
      "properties": {
        "row_id": { "type": "string" },
        "category": { "type": "string" },
        "label": { "type": "string" },
        "observed": { "type": "boolean" },
        "current_verdict": { "enum": ["pass", "block"] },
        "evidence_ref": { "type": ["string", "null"] },
        "block_reason": { "type": ["string", "null"] },
        "next_allowed_action": { "type": "string" },
        "generated_at": { "type": "string" }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
