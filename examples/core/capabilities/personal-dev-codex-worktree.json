{
  "schema_version": "capability-manifest.v1",
  "capability_id": "personal_dev.codex.worktree_patch",
  "version": "0.1.0",
  "domain_pack": "personal-dev",
  "display_name": "Codex Worktree Patch",
  "description": "Run Codex in an isolated worktree for a bounded development task, then return a diff for review and canonical testing.",
  "input_contract": "workflow-runtime.v1",
  "output_contract": "governance-output.v1",
  "required_resources": [
    {
      "resource_role": "repo",
      "required": true,
      "description": "Repository profile with test command, protected files, and branch policy."
    },
    {
      "resource_role": "worktree",
      "required": true,
      "description": "Isolated worktree owned by this agent run."
    },
    {
      "resource_role": "test_result",
      "required": false,
      "description": "Existing failing test baseline if available."
    }
  ],
  "allowed_runtimes": ["harness", "codex", "local_script", "manual"],
  "required_tools": ["filesystem.read", "filesystem.write", "terminal.exec", "github.merge"],
  "required_gates": {
    "pre_run": ["classification_gate", "tool_permission_gate", "protected_file_gate", "cost_budget_gate"],
    "in_run": [],
    "post_run": ["protected_file_gate", "diff_review_gate", "test_gate", "human_approval_gate"]
  },
  "data_policy": {
    "max_input_classification": "P1_INTERNAL",
    "external_model_policy": "allowed_with_audit",
    "redaction_required": false,
    "allowed_context_types": ["resource_metadata", "diff", "test_result", "output_artifact"],
    "retrieval_filters_required": ["tenant_id", "classification"]
  },
  "approval_policy": {
    "required": true,
    "approval_type": "human_review",
    "default_output_status": "draft"
  },
  "idempotency_policy": {
    "key_fields": ["tenant_id", "repo_id", "issue_id", "branch_name", "capability_id", "version"]
  },
  "retry_policy": {
    "max_attempts": 1,
    "retryable_failures": ["transient_test_environment_failure"]
  },
  "timeout_policy": {
    "max_seconds": 3600
  },
  "cost_policy": {
    "max_usd": 10,
    "track_tokens": true
  },
  "observability_policy": {
    "record_trace": true,
    "record_prompt_hash": true,
    "record_output_hash": true,
    "record_cost": true
  },
  "output_artifacts": [
    {
      "artifact_type": "pr_draft",
      "default_status": "draft",
      "delivery_policy": "test_gate_required"
    },
    {
      "artifact_type": "markdown",
      "default_status": "draft",
      "delivery_policy": "internal_only"
    }
  ],
  "entrypoints": [
    {
      "entrypoint_type": "workflow",
      "name": "workflow.personal_dev.codex.worktree_patch.v1"
    },
    {
      "entrypoint_type": "runtime_adapter",
      "name": "codex"
    }
  ],
  "dependencies": ["common.workflow.worktree_manager", "common.dev.diff_review", "common.dev.test_gate"],
  "golden_cases": [
    {
      "case_id": "golden.personal_dev.codex.patch.simple",
      "description": "A small issue produces a bounded diff, test result, and PR draft artifact.",
      "input_ref": "examples/dev-projects.json",
      "expected_gate_results": ["protected_file_gate", "diff_review_gate", "test_gate"]
    }
  ],
  "metadata": {
    "codex_output_trust": "untrusted_until_gate_pass"
  }
}
