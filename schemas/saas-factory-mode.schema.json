{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hermes.local/schemas/saas-factory-mode.schema.json",
  "title": "Hermes SaaS Factory Mode",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "capability_id",
    "program_range",
    "source_program_range",
    "saas_factory_contract",
    "saas_factory_phase_rows",
    "saas_factory_source_binding_rows",
    "fcore_corrective_baseline_waiver_rows",
    "project_template_contract_rows",
    "requirement_matrix_contract_rows",
    "validation_plan_contract_rows",
    "review_lane_contract_rows",
    "domain_pack_composition_rows",
    "release_gate_blueprint_rows",
    "bootstrap_projection_rows",
    "factory_authority_guard_rows",
    "p15400_freeze_rows",
    "saas_factory_boundary",
    "saas_factory_validation_items",
    "validation",
    "summary"
  ],
  "properties": {
    "schema_version": { "const": "saas-factory-mode.v1" },
    "capability_id": { "const": "platform.saas_factory_mode" },
    "program_range": { "const": "P15001-P15400" },
    "source_program_range": { "const": "P14601-P15000" },
    "saas_factory_phase_rows": { "type": "array", "minItems": 10, "items": { "$ref": "#/$defs/verdictRow" } },
    "saas_factory_source_binding_rows": { "type": "array", "minItems": 9, "items": { "$ref": "#/$defs/verdictRow" } },
    "fcore_corrective_baseline_waiver_rows": { "type": "array", "minItems": 6, "items": { "$ref": "#/$defs/verdictRow" } },
    "project_template_contract_rows": { "type": "array", "minItems": 6, "items": { "$ref": "#/$defs/verdictRow" } },
    "requirement_matrix_contract_rows": { "type": "array", "minItems": 6, "items": { "$ref": "#/$defs/verdictRow" } },
    "validation_plan_contract_rows": { "type": "array", "minItems": 6, "items": { "$ref": "#/$defs/verdictRow" } },
    "review_lane_contract_rows": { "type": "array", "minItems": 6, "items": { "$ref": "#/$defs/verdictRow" } },
    "domain_pack_composition_rows": { "type": "array", "minItems": 6, "items": { "$ref": "#/$defs/verdictRow" } },
    "release_gate_blueprint_rows": { "type": "array", "minItems": 6, "items": { "$ref": "#/$defs/verdictRow" } },
    "bootstrap_projection_rows": { "type": "array", "minItems": 6, "items": { "$ref": "#/$defs/verdictRow" } },
    "factory_authority_guard_rows": { "type": "array", "minItems": 8, "items": { "$ref": "#/$defs/verdictRow" } },
    "p15400_freeze_rows": { "type": "array", "minItems": 12, "items": { "$ref": "#/$defs/verdictRow" } },
    "saas_factory_boundary": {
      "type": "object",
      "required": [
        "source_multi_engine_available",
        "source_ready_for_p15001_handoff",
        "source_block_visible_now",
        "fcore_corrective_baseline_waiver_visible_now",
        "source_blocker_waived_for_fcore_corrective_baseline_now",
        "f0_2_source_handoff_or_visible_waiver_now",
        "fcore_corrective_baseline_waiver_opens_authority_now",
        "project_template_contract_ready",
        "requirement_matrix_contract_ready",
        "validation_plan_contract_ready",
        "review_lane_contract_ready",
        "domain_pack_composition_ready",
        "release_gate_blueprint_ready",
        "bootstrap_projection_ready",
        "factory_authority_guard_ready",
        "p15400_saas_factory_freeze_ready",
        "ready_for_p15401_handoff",
        "project_creation_allowed_now",
        "repo_write_allowed_now",
        "secret_generation_allowed_now",
        "connector_provisioning_allowed_now",
        "deployment_allowed_now",
        "production_pass_enabled",
        "enterprise_pass_enabled",
        "enterprise_trust_claim_allowed_now",
        "protected_closeout_enabled",
        "release_approval_allowed_now",
        "write_action_allowed_now",
        "protected_action_allowed_now",
        "connector_write_enabled",
        "runtime_execution_allowed_now",
        "raw_source_exposure_allowed",
        "final_approval_ui_enabled",
        "codex_final_approval_ui_enabled",
        "claude_final_approval_ui_enabled",
        "unsafe_flag_count"
      ],
      "properties": {
        "source_multi_engine_available": { "type": "boolean" },
        "source_ready_for_p15001_handoff": { "type": "boolean" },
        "source_block_visible_now": { "type": "boolean" },
        "fcore_corrective_baseline_waiver_visible_now": { "type": "boolean" },
        "source_blocker_waived_for_fcore_corrective_baseline_now": { "type": "boolean" },
        "f0_2_source_handoff_or_visible_waiver_now": { "type": "boolean" },
        "fcore_corrective_baseline_waiver_opens_authority_now": { "const": false },
        "project_template_contract_ready": { "type": "boolean" },
        "requirement_matrix_contract_ready": { "type": "boolean" },
        "validation_plan_contract_ready": { "type": "boolean" },
        "review_lane_contract_ready": { "type": "boolean" },
        "domain_pack_composition_ready": { "type": "boolean" },
        "release_gate_blueprint_ready": { "type": "boolean" },
        "bootstrap_projection_ready": { "type": "boolean" },
        "factory_authority_guard_ready": { "type": "boolean" },
        "p15400_saas_factory_freeze_ready": { "type": "boolean" },
        "ready_for_p15401_handoff": { "type": "boolean" },
        "project_creation_allowed_now": { "const": false },
        "repo_write_allowed_now": { "const": false },
        "secret_generation_allowed_now": { "const": false },
        "connector_provisioning_allowed_now": { "const": false },
        "deployment_allowed_now": { "const": false },
        "production_pass_enabled": { "const": false },
        "enterprise_pass_enabled": { "const": false },
        "enterprise_trust_claim_allowed_now": { "const": false },
        "protected_closeout_enabled": { "const": false },
        "release_approval_allowed_now": { "const": false },
        "write_action_allowed_now": { "const": false },
        "protected_action_allowed_now": { "const": false },
        "connector_write_enabled": { "const": false },
        "runtime_execution_allowed_now": { "const": false },
        "raw_source_exposure_allowed": { "const": false },
        "final_approval_ui_enabled": { "const": false },
        "codex_final_approval_ui_enabled": { "const": false },
        "claude_final_approval_ui_enabled": { "const": false },
        "unsafe_flag_count": { "const": 0 }
      }
    },
    "validation": {
      "type": "object",
      "required": ["valid", "error_count", "errors"],
      "properties": {
        "valid": { "type": "boolean" },
        "error_count": { "type": "integer", "minimum": 0 },
        "errors": { "type": "array" }
      }
    },
    "summary": {
      "type": "object",
      "required": [
        "saas_factory_mode_status",
        "program_range",
        "source_ready_for_p15001_handoff",
        "source_block_visible_now",
        "fcore_corrective_baseline_waiver_visible_now",
        "source_blocker_waived_for_fcore_corrective_baseline_now",
        "f0_2_source_handoff_or_visible_waiver_now",
        "fcore_corrective_baseline_waiver_opens_authority_now",
        "project_template_contract_row_count",
        "requirement_matrix_contract_row_count",
        "validation_plan_contract_row_count",
        "review_lane_contract_row_count",
        "domain_pack_composition_row_count",
        "release_gate_blueprint_row_count",
        "bootstrap_projection_row_count",
        "p15400_saas_factory_freeze_ready",
        "ready_for_p15401_handoff",
        "project_creation_allowed_now",
        "repo_write_allowed_now",
        "secret_generation_allowed_now",
        "connector_provisioning_allowed_now",
        "deployment_allowed_now",
        "production_pass_enabled",
        "enterprise_trust_claim_allowed_now",
        "validation_error_count"
      ],
      "properties": {
        "saas_factory_mode_status": {
          "enum": ["ready_for_saas_factory_mode", "blocked_saas_factory_mode"]
        },
        "program_range": { "const": "P15001-P15400" },
        "source_ready_for_p15001_handoff": { "type": "boolean" },
        "source_block_visible_now": { "type": "boolean" },
        "fcore_corrective_baseline_waiver_visible_now": { "type": "boolean" },
        "source_blocker_waived_for_fcore_corrective_baseline_now": { "type": "boolean" },
        "f0_2_source_handoff_or_visible_waiver_now": { "type": "boolean" },
        "fcore_corrective_baseline_waiver_opens_authority_now": { "const": false },
        "project_template_contract_row_count": { "type": "integer", "minimum": 6 },
        "requirement_matrix_contract_row_count": { "type": "integer", "minimum": 6 },
        "validation_plan_contract_row_count": { "type": "integer", "minimum": 6 },
        "review_lane_contract_row_count": { "type": "integer", "minimum": 6 },
        "domain_pack_composition_row_count": { "type": "integer", "minimum": 6 },
        "release_gate_blueprint_row_count": { "type": "integer", "minimum": 6 },
        "bootstrap_projection_row_count": { "type": "integer", "minimum": 6 },
        "p15400_saas_factory_freeze_ready": { "type": "boolean" },
        "ready_for_p15401_handoff": { "type": "boolean" },
        "project_creation_allowed_now": { "const": false },
        "repo_write_allowed_now": { "const": false },
        "secret_generation_allowed_now": { "const": false },
        "connector_provisioning_allowed_now": { "const": false },
        "deployment_allowed_now": { "const": false },
        "production_pass_enabled": { "const": false },
        "enterprise_trust_claim_allowed_now": { "const": false }
      }
    }
  },
  "$defs": {
    "verdictRow": {
      "type": "object",
      "required": ["row_id", "category", "label", "required", "observed", "evidence_ref", "current_verdict"],
      "properties": {
        "row_id": { "type": "string", "minLength": 1 },
        "category": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "required": { "type": "boolean" },
        "observed": { "type": "boolean" },
        "evidence_ref": { "type": "string", "minLength": 1 },
        "current_verdict": { "enum": ["pass", "blocked"] },
        "block_reason": { "type": ["string", "null"] }
      }
    }
  }
}
