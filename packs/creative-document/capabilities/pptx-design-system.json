{
  "schema_version": "capability-manifest.v1",
  "capability_id": "creative_document.pptx.design_system",
  "version": "0.1.0",
  "domain_pack": "creative-document",
  "display_name": "PPTX Design System",
  "description": "Generate draft presentation reports from structured content, templates, and style profiles with layout validation before review.",
  "input_contract": "resource-evidence.v1",
  "output_contract": "governance-output.v1",
  "required_resources": [
    {
      "resource_role": "resource",
      "required": true,
      "description": "Structured source content, brand/style profile, or template resource."
    },
    {
      "resource_role": "normalized_text",
      "required": false,
      "description": "Normalized source text for slide narrative and captions."
    }
  ],
  "allowed_runtimes": ["harness", "local_script", "document_renderer", "manual"],
  "required_tools": ["filesystem.read", "filesystem.write", "terminal.exec"],
  "required_gates": {
    "pre_run": ["classification_gate", "tool_permission_gate", "cost_budget_gate"],
    "in_run": [],
    "post_run": ["format_validation_gate", "human_approval_gate"]
  },
  "data_policy": {
    "max_input_classification": "P1_INTERNAL",
    "external_model_policy": "allowed_with_audit",
    "redaction_required": false,
    "allowed_context_types": ["resource_metadata", "normalized_text", "output_artifact"],
    "retrieval_filters_required": ["tenant_id", "classification"]
  },
  "approval_policy": {
    "required": true,
    "approval_type": "human_review",
    "default_output_status": "draft"
  },
  "idempotency_policy": {
    "key_fields": ["tenant_id", "source_uri", "content_hash", "capability_id", "version"]
  },
  "retry_policy": {
    "max_attempts": 2,
    "retryable_failures": ["temporary_io_error", "renderer_timeout"]
  },
  "timeout_policy": {
    "max_seconds": 1200
  },
  "cost_policy": {
    "max_usd": 3,
    "track_tokens": true
  },
  "observability_policy": {
    "record_trace": true,
    "record_prompt_hash": true,
    "record_output_hash": true,
    "record_cost": true
  },
  "output_artifacts": [
    {
      "artifact_type": "pptx",
      "default_status": "draft",
      "delivery_policy": "approval_required"
    },
    {
      "artifact_type": "markdown",
      "default_status": "draft",
      "delivery_policy": "internal_only"
    }
  ],
  "entrypoints": [
    {
      "entrypoint_type": "workflow",
      "name": "workflow.creative_document.pptx.design_system.v1"
    },
    {
      "entrypoint_type": "runtime_adapter",
      "name": "document_renderer"
    }
  ],
  "dependencies": ["common.document.rendering", "common.workflow.approval"],
  "golden_cases": [
    {
      "case_id": "golden.creative_document.pptx.design_system.simple",
      "description": "A short structured report produces a draft PPTX artifact and a format validation gate result.",
      "input_ref": "examples/core/vertical-slice-example.json",
      "expected_gate_results": ["classification_gate", "format_validation_gate", "human_approval_gate"]
    }
  ],
  "metadata": {
    "layout_validation_required": true,
    "draft_only_by_default": true
  }
}
