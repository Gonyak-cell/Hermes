        "release_command_execution_allowed_now": { "const": false },
        "database_migration_allowed_now": { "const": false },
        "client_export_allowed_now": { "const": false },
        "rollback_rehearsal_execution_allowed_now": { "const": false },
        "rollback_execution_allowed_now": { "const": false },
        "receipt_application_allowed_now": { "const": false },
        "physical_code_move_allowed_now": { "const": false },
