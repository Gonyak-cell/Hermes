{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hermes.local/schemas/human-owner-adjudication-option.schema.json",
  "title": "Hermes Human Owner Adjudication Option",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "capability_id",
    "program_range",
    "source_program_range",
    "human_owner_adjudication_contract",
    "human_owner_phase_rows",
    "adjudication_source_binding_rows",
    "owner_adjudication_receipt_rows",
    "protected_closeout_mapping_rows",
    "independent_review_separation_rows",
    "single_owner_trust_downgrade_rows",
    "adjudication_queue_rows",
    "finding_disposition_rows",
    "adjudication_operator_projection_rows",
    "adjudication_authority_guard_rows",
    "p12800_freeze_rows",
    "human_owner_adjudication_boundary",
    "human_owner_adjudication_validation_items",
    "validation",
    "summary"
  ],
  "properties": {
    "schema_version": { "const": "human-owner-adjudication-option.v1" },
    "capability_id": { "const": "platform.human_owner_adjudication_option" },
    "program_range": { "const": "P12601-P12800" },
    "source_program_range": { "const": "P12401-P12600" },
    "human_owner_phase_rows": { "type": "array", "minItems": 10, "items": { "$ref": "#/$defs/verdictRow" } },
    "adjudication_source_binding_rows": { "type": "array", "minItems": 8, "items": { "$ref": "#/$defs/verdictRow" } },
    "owner_adjudication_receipt_rows": { "type": "array", "minItems": 7, "items": { "$ref": "#/$defs/verdictRow" } },
    "protected_closeout_mapping_rows": { "type": "array", "minItems": 6, "items": { "$ref": "#/$defs/verdictRow" } },
    "independent_review_separation_rows": { "type": "array", "minItems": 6, "items": { "$ref": "#/$defs/verdictRow" } },
    "single_owner_trust_downgrade_rows": { "type": "array", "minItems": 5, "items": { "$ref": "#/$defs/verdictRow" } },
    "adjudication_queue_rows": { "type": "array", "minItems": 6, "items": { "$ref": "#/$defs/verdictRow" } },
    "finding_disposition_rows": { "type": "array", "minItems": 6, "items": { "$ref": "#/$defs/verdictRow" } },
    "adjudication_operator_projection_rows": { "type": "array", "minItems": 6, "items": { "$ref": "#/$defs/verdictRow" } },
    "adjudication_authority_guard_rows": { "type": "array", "minItems": 6, "items": { "$ref": "#/$defs/verdictRow" } },
    "p12800_freeze_rows": { "type": "array", "minItems": 12, "items": { "$ref": "#/$defs/verdictRow" } },
    "human_owner_adjudication_boundary": {
      "type": "object",
      "required": [
        "source_patch_candidate_lane_available",
        "source_ready_for_p12601_handoff",
        "source_block_visible_now",
        "owner_adjudication_receipt_present_now",
        "owner_adjudication_block_visible_now",
        "owner_adjudication_contract_ready",
        "protected_closeout_mapping_ready",
        "independent_review_separation_ready",
        "single_owner_trust_downgrade_ready",
        "p12800_human_owner_adjudication_freeze_ready",
        "ready_for_p12801_handoff",
        "owner_adjudication_as_enterprise_review_allowed",
        "owner_receipt_creates_github_approval",
        "owner_receipt_auto_final_approval_enabled",
        "single_owner_lower_trust_mode",
        "single_owner_enterprise_trust_allowed",
        "independent_github_review_completed_now",
        "enterprise_trust_claim_allowed_now",
        "patch_generated_now",
        "patch_applied_now",
        "direct_apply_allowed_now",
        "write_action_allowed_now",
        "protected_action_allowed_now",
        "connector_write_enabled",
        "runtime_execution_allowed_now",
        "raw_body_exposure_allowed",
        "secret_read_allowed_now",
        "final_approval_ui_enabled",
        "codex_final_approval_ui_enabled",
        "claude_final_approval_ui_enabled",
        "production_pass_enabled",
        "enterprise_pass_enabled",
        "unsafe_flag_count"
      ],
      "properties": {
        "source_patch_candidate_lane_available": { "type": "boolean" },
        "source_ready_for_p12601_handoff": { "type": "boolean" },
        "source_block_visible_now": { "type": "boolean" },
        "owner_adjudication_receipt_present_now": { "type": "boolean" },
        "owner_adjudication_block_visible_now": { "type": "boolean" },
        "owner_adjudication_contract_ready": { "type": "boolean" },
        "protected_closeout_mapping_ready": { "type": "boolean" },
        "independent_review_separation_ready": { "type": "boolean" },
        "single_owner_trust_downgrade_ready": { "type": "boolean" },
        "p12800_human_owner_adjudication_freeze_ready": { "type": "boolean" },
        "ready_for_p12801_handoff": { "type": "boolean" },
        "owner_adjudication_as_enterprise_review_allowed": { "const": false },
        "owner_receipt_creates_github_approval": { "const": false },
        "owner_receipt_auto_final_approval_enabled": { "const": false },
        "single_owner_lower_trust_mode": { "const": true },
        "single_owner_enterprise_trust_allowed": { "const": false },
        "independent_github_review_completed_now": { "const": false },
        "enterprise_trust_claim_allowed_now": { "const": false },
        "patch_generated_now": { "const": false },
        "patch_applied_now": { "const": false },
        "direct_apply_allowed_now": { "const": false },
        "write_action_allowed_now": { "const": false },
        "protected_action_allowed_now": { "const": false },
        "connector_write_enabled": { "const": false },
        "runtime_execution_allowed_now": { "const": false },
        "raw_body_exposure_allowed": { "const": false },
        "secret_read_allowed_now": { "const": false },
        "final_approval_ui_enabled": { "const": false },
        "codex_final_approval_ui_enabled": { "const": false },
        "claude_final_approval_ui_enabled": { "const": false },
        "production_pass_enabled": { "const": false },
        "enterprise_pass_enabled": { "const": false },
        "unsafe_flag_count": { "const": 0 }
      }
    },
    "validation": {
      "type": "object",
      "required": ["valid", "error_count", "errors"],
      "properties": {
        "valid": { "type": "boolean" },
        "error_count": { "type": "integer", "minimum": 0 },
        "errors": { "type": "array" }
      }
    },
    "summary": {
      "type": "object",
      "required": [
        "human_owner_adjudication_option_status",
        "program_range",
        "source_ready_for_p12601_handoff",
        "source_block_visible_now",
        "owner_adjudication_receipt_present_now",
        "owner_adjudication_block_visible_now",
        "owner_adjudication_receipt_row_count",
        "independent_review_separation_row_count",
        "p12800_human_owner_adjudication_freeze_ready",
        "ready_for_p12801_handoff",
        "single_owner_lower_trust_mode",
        "enterprise_trust_claim_allowed_now",
        "owner_receipt_auto_final_approval_enabled",
        "production_pass_enabled",
        "enterprise_pass_enabled",
        "validation_error_count"
      ],
      "properties": {
        "human_owner_adjudication_option_status": {
          "enum": [
            "ready_for_human_owner_adjudication_option",
            "blocked_human_owner_adjudication_option"
          ]
        },
        "program_range": { "const": "P12601-P12800" },
        "source_ready_for_p12601_handoff": { "type": "boolean" },
        "source_block_visible_now": { "type": "boolean" },
        "owner_adjudication_receipt_present_now": { "type": "boolean" },
        "owner_adjudication_block_visible_now": { "type": "boolean" },
        "owner_adjudication_receipt_row_count": { "type": "integer", "minimum": 7 },
        "independent_review_separation_row_count": { "type": "integer", "minimum": 6 },
        "p12800_human_owner_adjudication_freeze_ready": { "type": "boolean" },
        "ready_for_p12801_handoff": { "type": "boolean" },
        "single_owner_lower_trust_mode": { "const": true },
        "enterprise_trust_claim_allowed_now": { "const": false },
        "owner_receipt_auto_final_approval_enabled": { "const": false },
        "production_pass_enabled": { "const": false },
        "enterprise_pass_enabled": { "const": false }
      }
    }
  },
  "$defs": {
    "verdictRow": {
      "type": "object",
      "required": [
        "row_id",
        "category",
        "label",
        "required",
        "observed",
        "evidence_ref",
        "current_verdict"
      ],
      "properties": {
        "row_id": { "type": "string", "minLength": 1 },
        "category": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "required": { "type": "boolean" },
        "observed": { "type": "boolean" },
        "evidence_ref": { "type": "string", "minLength": 1 },
        "current_verdict": { "enum": ["pass", "blocked"] },
        "block_reason": { "type": ["string", "null"] }
      }
    }
  }
}
