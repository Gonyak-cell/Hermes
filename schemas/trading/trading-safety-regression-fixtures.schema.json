{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hermes.local/schemas/trading/trading-safety-regression-fixtures.schema.json",
  "title": "Trading Safety Regression Fixtures",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "generated_at",
    "trading_safety_regression_fixtures_id",
    "capability_id",
    "safety_regression_anchor",
    "safety_regression_fixture_rows",
    "safety_regression_gate_rows",
    "safety_regression_boundary",
    "validation_items",
    "validation",
    "summary"
  ],
  "properties": {
    "schema_version": { "const": "trading-safety-regression-fixtures.v1" },
    "trading_safety_regression_fixtures_id": {
      "type": "string",
      "pattern": "^trading-safety-regression-fixtures\\.[0-9]{8}$"
    },
    "capability_id": { "const": "trading.safety_regression_fixtures" },
    "safety_regression_anchor": {
      "type": "object",
      "required": ["phase_slot", "previous_phase_slot", "next_phase_slot", "source_release_check_receipt_closeout_status", "required_flag_count"],
      "properties": {
        "phase_slot": { "const": "P381" },
        "previous_phase_slot": { "const": "P380" },
        "next_phase_slot": { "const": "P382" },
        "source_release_check_receipt_closeout_status": { "const": "ready_for_release_check_receipt_chain_closeout" },
        "required_flag_count": { "const": 4 }
      }
    },
    "safety_regression_fixture_rows": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "required": [
          "phase_slot",
          "flag_name",
          "expected_safe_value",
          "unsafe_value",
          "fixture_should_fail_when_true",
          "observed_values",
          "all_sources_present",
          "unsafe_value_detected",
          "fixture_status",
          "blocks_live_trading",
          "blocks_full_auto",
          "blocks_order_submission",
          "broker_write_allowed_by_fixture",
          "exchange_write_allowed_by_fixture",
          "command_execution_performed_by_fixture",
          "artifact_write_performed_by_fixture",
          "protected_action_executed_by_fixture",
          "human_review_required"
        ],
        "properties": {
          "phase_slot": { "const": "P381" },
          "flag_name": {
            "enum": [
              "limited_live_enabled",
              "full_auto_enabled",
              "automatic_order_submission_allowed",
              "live_order_submission_allowed"
            ]
          },
          "expected_safe_value": { "const": false },
          "unsafe_value": { "const": true },
          "fixture_should_fail_when_true": { "const": true },
          "observed_values": { "type": "array", "minItems": 1 },
          "all_sources_present": { "const": true },
          "unsafe_value_detected": { "const": false },
          "fixture_status": { "const": "passed" },
          "blocks_live_trading": { "const": true },
          "blocks_full_auto": { "const": true },
          "blocks_order_submission": { "const": true },
          "broker_write_allowed_by_fixture": { "const": false },
          "exchange_write_allowed_by_fixture": { "const": false },
          "command_execution_performed_by_fixture": { "const": false },
          "artifact_write_performed_by_fixture": { "const": false },
          "protected_action_executed_by_fixture": { "const": false },
          "human_review_required": { "const": true }
        }
      }
    },
    "safety_regression_gate_rows": {
      "type": "array",
      "minItems": 8,
      "items": {
        "type": "object",
        "required": [
          "phase_slot",
          "gate_status",
          "trading_live_enabled_by_gate",
          "full_auto_enabled_by_gate",
          "automatic_order_submission_allowed_by_gate",
          "live_order_submission_allowed_by_gate",
          "broker_write_allowed_by_gate",
          "exchange_write_allowed_by_gate",
          "protected_action_executed_by_gate",
          "human_review_required"
        ],
        "properties": {
          "phase_slot": { "const": "P381" },
          "gate_status": { "const": "ready" },
          "trading_live_enabled_by_gate": { "const": false },
          "full_auto_enabled_by_gate": { "const": false },
          "automatic_order_submission_allowed_by_gate": { "const": false },
          "live_order_submission_allowed_by_gate": { "const": false },
          "broker_write_allowed_by_gate": { "const": false },
          "exchange_write_allowed_by_gate": { "const": false },
          "protected_action_executed_by_gate": { "const": false },
          "human_review_required": { "const": true }
        }
      }
    },
    "safety_regression_boundary": {
      "type": "object",
      "required": [
        "boundary_status",
        "phase_slot",
        "read_only",
        "report_only",
        "regression_fixtures_declared",
        "regression_fixture_execution_performed",
        "unsafe_flag_detected_count",
        "limited_live_enabled",
        "full_auto_enabled",
        "automatic_order_submission_allowed",
        "live_order_submission_allowed",
        "trading_live_enabled",
        "trading_full_auto_enabled",
        "trading_order_submission_allowed",
        "broker_write_allowed",
        "exchange_write_allowed",
        "command_execution_performed",
        "package_command_execution_performed",
        "release_check_execution_performed",
        "artifact_write_performed",
        "release_published",
        "git_operation_performed",
        "protected_action_executed",
        "human_review_required"
      ],
      "properties": {
        "boundary_status": { "const": "enforced" },
        "phase_slot": { "const": "P381" },
        "read_only": { "const": true },
        "report_only": { "const": true },
        "regression_fixtures_declared": { "const": true },
        "regression_fixture_execution_performed": { "const": false },
        "unsafe_flag_detected_count": { "const": 0 },
        "limited_live_enabled": { "const": false },
        "full_auto_enabled": { "const": false },
        "automatic_order_submission_allowed": { "const": false },
        "live_order_submission_allowed": { "const": false },
        "trading_live_enabled": { "const": false },
        "trading_full_auto_enabled": { "const": false },
        "trading_order_submission_allowed": { "const": false },
        "broker_write_allowed": { "const": false },
        "exchange_write_allowed": { "const": false },
        "command_execution_performed": { "const": false },
        "package_command_execution_performed": { "const": false },
        "release_check_execution_performed": { "const": false },
        "artifact_write_performed": { "const": false },
        "release_published": { "const": false },
        "git_operation_performed": { "const": false },
        "protected_action_executed": { "const": false },
        "human_review_required": { "const": true }
      }
    },
    "summary": {
      "type": "object",
      "required": [
        "trading_safety_regression_fixtures_status",
        "phase_slot",
        "previous_phase_slot",
        "next_phase_slot",
        "source_release_check_receipt_closeout_status",
        "fixture_count",
        "passed_fixture_count",
        "failed_fixture_count",
        "gate_count",
        "ready_gate_count",
        "unsafe_flag_detected_count",
        "limited_live_enabled",
        "full_auto_enabled",
        "automatic_order_submission_allowed",
        "live_order_submission_allowed",
        "trading_live_enabled",
        "trading_full_auto_enabled",
        "trading_order_submission_allowed",
        "broker_write_allowed",
        "exchange_write_allowed",
        "command_execution_performed",
        "release_check_execution_performed",
        "artifact_write_performed",
        "release_published",
        "git_operation_performed",
        "protected_action_executed",
        "human_review_required",
        "validation_error_count"
      ],
      "properties": {
        "trading_safety_regression_fixtures_status": { "const": "ready_for_trading_safety_regression" },
        "phase_slot": { "const": "P381" },
        "previous_phase_slot": { "const": "P380" },
        "next_phase_slot": { "const": "P382" },
        "source_release_check_receipt_closeout_status": { "const": "ready_for_release_check_receipt_chain_closeout" },
        "fixture_count": { "const": 4 },
        "passed_fixture_count": { "const": 4 },
        "failed_fixture_count": { "const": 0 },
        "gate_count": { "minimum": 8 },
        "ready_gate_count": { "minimum": 8 },
        "unsafe_flag_detected_count": { "const": 0 },
        "limited_live_enabled": { "const": false },
        "full_auto_enabled": { "const": false },
        "automatic_order_submission_allowed": { "const": false },
        "live_order_submission_allowed": { "const": false },
        "trading_live_enabled": { "const": false },
        "trading_full_auto_enabled": { "const": false },
        "trading_order_submission_allowed": { "const": false },
        "broker_write_allowed": { "const": false },
        "exchange_write_allowed": { "const": false },
        "command_execution_performed": { "const": false },
        "release_check_execution_performed": { "const": false },
        "artifact_write_performed": { "const": false },
        "release_published": { "const": false },
        "git_operation_performed": { "const": false },
        "protected_action_executed": { "const": false },
        "human_review_required": { "const": true },
        "validation_error_count": { "const": 0 }
      }
    }
  }
}
