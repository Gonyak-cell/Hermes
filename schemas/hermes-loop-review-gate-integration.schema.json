{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hermes.local/schemas/hermes-loop-review-gate-integration.schema.json",
  "title": "Hermes Loop System v1.1 Review Gate Integration",
  "type": "object",
  "required": [
    "schema_version",
    "capability_id",
    "program_range",
    "source_program_range",
    "next_program_range",
    "p63200_runtime_tool_source_rows",
    "review_packet_contract_rows",
    "review_receipt_contract_rows",
    "normalized_finding_loop_rows",
    "human_gate_candidate_rows",
    "protected_output_guard_rows",
    "authority_boundary_carryover_rows",
    "negative_fixture_contract_rows",
    "validation_command_rows",
    "p63600_closeout_rows",
    "p63601_next_phase_handoff_rows",
    "hermes_loop_review_gate_boundary",
    "summary",
    "validation"
  ],
  "properties": {
    "schema_version": { "const": "hermes-loop-review-gate-integration.v1" },
    "capability_id": { "const": "platform.hermes_loop_system_v1_1_review_gate_integration" },
    "program_range": { "const": "P63201-P63600" },
    "source_program_range": { "const": "P62801-P63200" },
    "next_program_range": { "const": "P63601-P64000" },
    "p63200_runtime_tool_source_rows": { "type": "array", "minItems": 5, "items": { "$ref": "#/$defs/verdictRow" } },
    "review_packet_contract_rows": { "type": "array", "minItems": 14, "items": { "$ref": "#/$defs/verdictRow" } },
    "review_receipt_contract_rows": { "type": "array", "minItems": 12, "items": { "$ref": "#/$defs/verdictRow" } },
    "normalized_finding_loop_rows": { "type": "array", "minItems": 9, "items": { "$ref": "#/$defs/verdictRow" } },
    "human_gate_candidate_rows": { "type": "array", "minItems": 12, "items": { "$ref": "#/$defs/verdictRow" } },
    "protected_output_guard_rows": { "type": "array", "minItems": 10, "items": { "$ref": "#/$defs/verdictRow" } },
    "authority_boundary_carryover_rows": { "type": "array", "minItems": 27, "items": { "$ref": "#/$defs/verdictRow" } },
    "negative_fixture_contract_rows": { "type": "array", "minItems": 12, "items": { "$ref": "#/$defs/verdictRow" } },
    "validation_command_rows": { "type": "array", "minItems": 6, "items": { "$ref": "#/$defs/verdictRow" } },
    "p63600_closeout_rows": { "type": "array", "minItems": 10, "items": { "$ref": "#/$defs/verdictRow" } },
    "p63601_next_phase_handoff_rows": { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/verdictRow" } },
    "hermes_loop_review_gate_boundary": {
      "type": "object",
      "required": [
        "p63600_contract_ready",
        "p63200_source_ready_now",
        "review_packet_contract_ready_now",
        "review_receipt_contract_ready_now",
        "normalized_finding_loop_ready_now",
        "human_gate_candidate_ready_now",
        "protected_output_guard_ready_now",
        "ready_for_p63601_handoff",
        "runtime_execution_allowed_now",
        "write_action_allowed_now",
        "connector_write_allowed_now",
        "protected_action_allowed_now",
        "review_final_approval_allowed_now",
        "human_receipt_enterprise_trust_allowed_now",
        "protected_closeout_allowed_now",
        "protected_action_execution_allowed_now",
        "reviewer_source_mutation_allowed_now",
        "codex_self_approval_allowed_now",
        "production_pass_allowed_now",
        "enterprise_pass_allowed_now",
        "codex_final_approval_allowed",
        "claude_final_approval_allowed",
        "production_pass_enabled",
        "enterprise_pass_enabled",
        "final_approval_enabled"
      ],
      "properties": {
        "p63600_contract_ready": { "type": "boolean" },
        "p63200_source_ready_now": { "type": "boolean" },
        "review_packet_contract_ready_now": { "type": "boolean" },
        "review_receipt_contract_ready_now": { "type": "boolean" },
        "normalized_finding_loop_ready_now": { "type": "boolean" },
        "human_gate_candidate_ready_now": { "type": "boolean" },
        "protected_output_guard_ready_now": { "type": "boolean" },
        "ready_for_p63601_handoff": { "type": "boolean" },
        "runtime_execution_allowed_now": { "const": false },
        "write_action_allowed_now": { "const": false },
        "connector_write_allowed_now": { "const": false },
        "protected_action_allowed_now": { "const": false },
        "review_final_approval_allowed_now": { "const": false },
        "human_receipt_enterprise_trust_allowed_now": { "const": false },
        "protected_closeout_allowed_now": { "const": false },
        "protected_action_execution_allowed_now": { "const": false },
        "reviewer_source_mutation_allowed_now": { "const": false },
        "codex_self_approval_allowed_now": { "const": false },
        "production_pass_allowed_now": { "const": false },
        "enterprise_pass_allowed_now": { "const": false },
        "codex_final_approval_allowed": { "const": false },
        "claude_final_approval_allowed": { "const": false },
        "production_pass_enabled": { "const": false },
        "enterprise_pass_enabled": { "const": false },
        "final_approval_enabled": { "const": false }
      },
      "additionalProperties": true
    },
    "summary": {
      "type": "object",
      "required": [
        "hermes_loop_review_gate_status",
        "program_range",
        "source_program_range",
        "next_program_range",
        "p63200_source_ready_now",
        "p63600_contract_ready",
        "ready_for_p63601_handoff",
        "review_final_approval_allowed_now",
        "human_receipt_enterprise_trust_allowed_now",
        "protected_closeout_allowed_now",
        "production_pass_enabled",
        "enterprise_pass_enabled",
        "final_approval_enabled"
      ],
      "properties": {
        "hermes_loop_review_gate_status": {
          "enum": [
            "ready_for_p63601_handoff",
            "valid_block_p63601_handoff_pending",
            "blocked_hermes_loop_review_gate_integration"
          ]
        },
        "program_range": { "const": "P63201-P63600" },
        "source_program_range": { "const": "P62801-P63200" },
        "next_program_range": { "const": "P63601-P64000" },
        "review_final_approval_allowed_now": { "const": false },
        "human_receipt_enterprise_trust_allowed_now": { "const": false },
        "protected_closeout_allowed_now": { "const": false },
        "production_pass_enabled": { "const": false },
        "enterprise_pass_enabled": { "const": false },
        "final_approval_enabled": { "const": false }
      },
      "additionalProperties": true
    },
    "validation": {
      "type": "object",
      "required": ["valid", "error_count", "errors"],
      "properties": {
        "valid": { "type": "boolean" },
        "error_count": { "type": "number" },
        "errors": { "type": "array" }
      },
      "additionalProperties": true
    }
  },
  "$defs": {
    "verdictRow": {
      "type": "object",
      "required": [
        "row_id",
        "category",
        "label",
        "observed",
        "current_verdict",
        "evidence_ref",
        "block_reason",
        "next_allowed_action",
        "generated_at"
      ],
      "properties": {
        "row_id": { "type": "string" },
        "category": { "type": "string" },
        "label": { "type": "string" },
        "observed": { "type": "boolean" },
        "current_verdict": { "enum": ["pass", "block"] },
        "evidence_ref": { "type": ["string", "null"] },
        "block_reason": { "type": ["string", "null"] },
        "next_allowed_action": { "type": "string" },
        "generated_at": { "type": "string" }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
