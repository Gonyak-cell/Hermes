{
  "schema_version": "capability-manifest.v1",
  "capability_id": "trading.research_backtest_paper",
  "version": "0.1.0",
  "domain_pack": "trading",
  "display_name": "Trading Research Backtest Paper",
  "description": "Validate trading research, deterministic backtests, and paper-trade artifacts while blocking live execution paths.",
  "input_contract": "trading-research-input.v1",
  "output_contract": "trading-validation-output.v1",
  "required_resources": [
    {
      "resource_role": "resource",
      "required": true,
      "description": "Market data fixtures, CSV imports, strategy notes, or paper-trade ledgers."
    },
    {
      "resource_role": "test_result",
      "required": true,
      "description": "Deterministic validation, backtest, safety, and fixture results."
    }
  ],
  "allowed_runtimes": ["harness", "local_script", "manual"],
  "required_tools": ["filesystem.read", "filesystem.write", "terminal.exec"],
  "required_gates": {
    "pre_run": ["classification_gate", "tool_permission_gate", "secrets_gate", "cost_budget_gate"],
    "in_run": ["test_gate"],
    "post_run": ["human_approval_gate"]
  },
  "data_policy": {
    "max_input_classification": "P1_INTERNAL",
    "external_model_policy": "forbidden",
    "redaction_required": false,
    "allowed_context_types": ["resource_metadata", "normalized_text", "fact", "output_artifact", "test_result"],
    "retrieval_filters_required": ["tenant_id", "classification", "resource_type"]
  },
  "approval_policy": {
    "required": true,
    "approval_type": "human_review",
    "default_output_status": "pending_review"
  },
  "idempotency_policy": {
    "key_fields": ["tenant_id", "portfolio_id", "strategy_id", "dataset_id", "capability_id", "version"]
  },
  "retry_policy": {
    "max_attempts": 1,
    "retryable_failures": ["temporary_io_error"]
  },
  "timeout_policy": {
    "max_seconds": 900
  },
  "cost_policy": {
    "max_usd": 0,
    "track_tokens": true
  },
  "observability_policy": {
    "record_trace": true,
    "record_prompt_hash": true,
    "record_output_hash": true,
    "record_cost": true
  },
  "output_artifacts": [
    {
      "artifact_type": "json",
      "default_status": "draft",
      "delivery_policy": "internal_only"
    },
    {
      "artifact_type": "markdown",
      "default_status": "pending_review",
      "delivery_policy": "internal_only"
    }
  ],
