{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://amic.local/hermes/runtime-timeout-heartbeat.schema.json",
  "title": "Hermes Runtime Timeout/Heartbeat",
  "type": "object",
  "required": [
    "schema_version",
    "generated_at",
    "runtime_timeout_heartbeat_id",
    "output_dir",
    "inputs",
    "source_contracts",
    "runtime_timeout_heartbeat_contract",
    "runtime_heartbeat_records",
    "runtime_timeout_records",
    "runtime_lifecycle_ledger_bindings",
    "runtime_heartbeat_desktop_boundary",
    "summary",
    "validation_items",
    "validation"
  ],
  "properties": {
    "schema_version": { "const": "runtime-timeout-heartbeat.v1" },
    "generated_at": { "type": "string", "format": "date-time" },
    "runtime_timeout_heartbeat_id": { "type": "string" },
    "output_dir": { "type": "string" },
    "inputs": {
      "type": "object",
      "required": [
        "runtime_agentrun_contract_freeze_path",
        "agent_run_ledger_path",
        "workflow_run_ledger_path",
        "runtime_log_normalization_path",
        "workflow_in_run_gate_framework_path",
        "desktop_companion_integration_path"
      ]
    },
    "source_contracts": {
      "type": "object",
      "required": [
        "runtime_agentrun_contract_freeze",
        "agent_run_ledger",
        "workflow_run_ledger",
