{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://amic.local/hermes/runtime-control-commands.schema.json",
  "title": "Hermes Runtime Control Commands",
  "type": "object",
  "required": [
    "schema_version",
    "generated_at",
    "runtime_control_commands_id",
    "output_dir",
    "inputs",
    "source_contracts",
    "runtime_control_command_contract",
    "runtime_control_command_requests",
    "runtime_control_command_results",
    "runtime_control_audit_bindings",
    "runtime_control_desktop_boundary",
    "summary",
    "validation_items",
    "validation"
  ],
  "properties": {
    "schema_version": { "const": "runtime-control-commands.v1" },
    "generated_at": { "type": "string", "format": "date-time" },
    "runtime_control_commands_id": { "type": "string" },
    "output_dir": { "type": "string" },
    "inputs": {
      "type": "object",
      "required": [
        "runtime_timeout_heartbeat_path",
        "agent_run_ledger_path",
        "audit_event_ledger_path",
        "workflow_resume_cancel_contract_path",
        "gate_approval_contract_freeze_path",
        "desktop_companion_integration_path"
      ]
    },
    "source_contracts": {
      "type": "object",
      "required": [
        "runtime_timeout_heartbeat",
        "agent_run_ledger",
        "audit_event_ledger",
        "workflow_resume_cancel_contract",
        "gate_approval_contract_freeze",
        "desktop_companion_integration"
      ]
    },
    "runtime_control_command_contract": {
      "type": "object",
      "required": [
        "control_command_contract_id",
        "contract_status",
        "control_command_authority",
        "source_of_truth",
        "cancel_request_required",
        "resume_request_required",
        "command_result_required",
        "audit_binding_required",
        "run_ledger_append_required",
        "terminal_state_guard_required",
        "protected_control_request_required",
        "human_gate_required",
        "runtime_self_report_trusted",
        "desktop_read_only",
        "desktop_mutation_allowed",
        "desktop_protected_mutation_execution_allowed",
        "desktop_source_of_truth",
        "cancel_allowed",
        "resume_allowed",
        "runtime_process_control_allowed",
        "command_execution_allowed"
      ],
      "properties": {
        "control_command_contract_id": { "const": "runtime-control-commands.default" },
        "contract_status": { "const": "locked" },
        "control_command_authority": { "const": "harness_control_plane" },
        "source_of_truth": { "const": "runtime_timeout_heartbeat_agent_run_ledger_and_audit_event_ledger" },
        "cancel_request_required": { "const": true },
        "resume_request_required": { "const": true },
        "command_result_required": { "const": true },
        "audit_binding_required": { "const": true },
        "run_ledger_append_required": { "const": true },
        "terminal_state_guard_required": { "const": true },
        "protected_control_request_required": { "const": true },
        "human_gate_required": { "const": true },
        "runtime_self_report_trusted": { "const": false },
        "desktop_read_only": { "const": true },
        "desktop_mutation_allowed": { "const": false },
        "desktop_protected_mutation_execution_allowed": { "const": false },
        "desktop_source_of_truth": { "const": false },
        "cancel_allowed": { "const": false },
        "resume_allowed": { "const": false },
        "runtime_process_control_allowed": { "const": false },
        "command_execution_allowed": { "const": false }
      }
    },
    "runtime_control_command_requests": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "runtime_control_command_request_id",
          "control_command_authority",
          "control_command_kind",
          "request_status",
          "source_of_truth",
          "agent_run_id",
          "workflow_run_id",
          "run_ledger_id",
          "runtime_id",
          "adapter_id",
          "current_agent_run_status",
          "terminal_state_guard",
          "protected_control_request",
          "human_gate_required",
          "audit_event_append_required",
          "run_ledger_append_required",
          "command_execution_allowed",
          "runtime_process_control_allowed",
          "auto_control_allowed",
          "protected_action_execution_allowed",
          "desktop_request_mode",
          "desktop_origin_allowed"
        ],
        "properties": {
          "control_command_authority": { "const": "harness_control_plane" },
          "control_command_kind": { "enum": ["cancel", "resume"] },
          "request_status": { "const": "recorded_pending_human_gate" },
          "source_of_truth": { "const": "runtime_timeout_heartbeat_agent_run_ledger_and_audit_event_ledger" },
          "terminal_state_guard": { "type": "boolean" },
          "protected_control_request": { "const": true },
          "human_gate_required": { "const": true },
          "audit_event_append_required": { "const": true },
          "run_ledger_append_required": { "const": true },
          "command_execution_allowed": { "const": false },
          "runtime_process_control_allowed": { "const": false },
          "auto_control_allowed": { "const": false },
          "protected_action_execution_allowed": { "const": false },
          "desktop_request_mode": { "const": "receipt_draft_only" },
          "desktop_origin_allowed": { "const": "protected_action_request_only" }
        }
      }
    },
    "runtime_control_command_results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "runtime_control_command_result_id",
          "runtime_control_command_request_id",
          "control_command_authority",
          "control_command_kind",
          "result_status",
          "agent_run_id",
          "workflow_run_id",
          "run_ledger_id",
          "command_execution_allowed",
          "execution_performed",
          "runtime_process_control_allowed",
          "protected_action_executed",
          "auto_control_allowed",
          "new_run_created",
          "run_ledger_append_required",
          "audit_event_append_required",
          "audit_recorded",
          "human_review_required",
          "desktop_mutation_execution_allowed",
          "desktop_source_of_truth"
        ],
        "properties": {
          "control_command_authority": { "const": "harness_control_plane" },
          "control_command_kind": { "enum": ["cancel", "resume"] },
          "result_status": { "enum": ["held_for_human_gate", "not_executed_terminal_state"] },
          "command_execution_allowed": { "const": false },
          "execution_performed": { "const": false },
          "runtime_process_control_allowed": { "const": false },
          "protected_action_executed": { "const": false },
          "auto_control_allowed": { "const": false },
          "new_run_created": { "const": false },
          "run_ledger_append_required": { "const": true },
          "audit_event_append_required": { "const": true },
          "audit_recorded": { "const": true },
          "human_review_required": { "const": true },
          "desktop_mutation_execution_allowed": { "const": false },
          "desktop_source_of_truth": { "const": false }
        }
      }
    },
    "runtime_control_audit_bindings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "runtime_control_audit_binding_id",
          "audit_binding_status",
          "audit_record_status",
          "audit_record_kind",
          "audit_domain",
          "audit_type",
          "source_of_truth",
          "runtime_control_command_request_id",
          "runtime_control_command_result_id",
          "agent_run_id",
          "workflow_run_id",
          "run_ledger_id",
          "protected_action_event",
          "protected_action_executed",
          "requires_human_review",
          "command_execution_allowed",
          "execution_performed",
          "audit_event_append_required",
          "separation_status",
          "desktop_source_of_truth"
        ],
        "properties": {
          "audit_binding_status": { "const": "recorded" },
          "audit_record_status": { "const": "recorded_in_runtime_control_audit_binding" },
          "audit_record_kind": { "const": "runtime_control_command_result" },
          "audit_domain": { "const": "runtime" },
          "source_of_truth": { "const": "runtime_timeout_heartbeat_agent_run_ledger_and_audit_event_ledger" },
          "protected_action_event": { "const": true },
          "protected_action_executed": { "const": false },
          "requires_human_review": { "const": true },
          "command_execution_allowed": { "const": false },
          "execution_performed": { "const": false },
          "audit_event_append_required": { "const": true },
          "separation_status": { "const": "separate_from_observability" },
          "desktop_source_of_truth": { "const": false }
        }
      }
    },
    "runtime_control_desktop_boundary": {
      "type": "object",
      "required": [
        "boundary_status",
        "desktop_surface_policy",
        "desktop_source_of_truth",
        "read_only",
        "mutation_allowed",
        "protected_mutation_request_allowed",
        "protected_mutation_execution_allowed",
        "command_execution_allowed",
        "cancel_allowed",
        "resume_allowed",
        "runtime_process_control_allowed",
        "runtime_start_allowed",
        "process_signal_allowed"
      ],
      "properties": {
        "boundary_status": { "const": "locked" },
        "desktop_surface_policy": { "const": "read_only_status_with_protected_request_drafts" },
        "desktop_source_of_truth": { "const": false },
        "read_only": { "const": true },
        "mutation_allowed": { "const": false },
        "protected_mutation_request_allowed": { "const": true },
        "protected_mutation_execution_allowed": { "const": false },
        "command_execution_allowed": { "const": false },
        "cancel_allowed": { "const": false },
        "resume_allowed": { "const": false },
        "runtime_process_control_allowed": { "const": false },
        "runtime_start_allowed": { "const": false },
        "process_signal_allowed": { "const": false }
      }
    },
    "summary": {
      "type": "object",
      "required": [
        "runtime_control_command_status",
        "control_command_contract_id",
        "contract_status",
        "control_command_authority",
        "source_of_truth",
        "agent_run_count",
        "control_command_request_count",
        "cancel_request_count",
        "resume_request_count",
        "protected_control_request_count",
        "human_gate_required_request_count",
        "command_result_count",
        "audit_recorded_count",
        "execution_performed_count",
        "protected_action_executed_count",
        "new_run_created_count",
        "audit_binding_count",
        "recorded_audit_binding_count",
        "desktop_read_only",
        "desktop_mutation_allowed",
        "desktop_protected_mutation_execution_allowed",
        "desktop_source_of_truth",
        "cancel_allowed",
        "resume_allowed",
        "runtime_process_control_allowed",
        "command_execution_allowed",
        "validation_error_count"
      ],
      "properties": {
        "runtime_control_command_status": { "enum": ["complete", "blocked"] },
        "control_command_contract_id": { "const": "runtime-control-commands.default" },
        "contract_status": { "const": "locked" },
        "control_command_authority": { "const": "harness_control_plane" },
        "source_of_truth": { "const": "runtime_timeout_heartbeat_agent_run_ledger_and_audit_event_ledger" },
        "execution_performed_count": { "const": 0 },
        "protected_action_executed_count": { "const": 0 },
        "new_run_created_count": { "const": 0 },
        "desktop_read_only": { "const": true },
        "desktop_mutation_allowed": { "const": false },
        "desktop_protected_mutation_execution_allowed": { "const": false },
        "desktop_source_of_truth": { "const": false },
        "cancel_allowed": { "const": false },
        "resume_allowed": { "const": false },
        "runtime_process_control_allowed": { "const": false },
        "command_execution_allowed": { "const": false }
      }
    },
    "validation_items": { "type": "array" },
    "validation": {
      "type": "object",
      "required": ["valid", "errors"],
      "properties": {
        "valid": { "type": "boolean" },
        "errors": { "type": "array" }
      }
    }
  }
}
