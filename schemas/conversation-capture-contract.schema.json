{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hermes.local/schemas/conversation-capture-contract.schema.json",
  "title": "Conversation Capture Contract",
  "type": "object",
  "required": [
    "schema_version",
    "generated_at",
    "conversation_capture_contract_id",
    "capability_id",
    "program_range",
    "source_program_range",
    "inputs",
    "source_p8000_closeout_summary",
    "conversation_capture_contract",
    "conversation_capture_phase_rows",
    "engine_session_rows",
    "transcript_reference_rows",
    "raw_full_redacted_boundary_rows",
    "plan_extraction_contract_rows",
    "conversation_capture_validator_rows",
    "conversation_capture_negative_fixture_rows",
    "conversation_capture_gate_rows",
    "conversation_capture_boundary",
    "validation_items",
    "validation",
    "summary"
  ],
  "properties": {
    "schema_version": { "const": "conversation-capture-contract.v1" },
    "capability_id": { "const": "platform.conversation_capture_contract" },
    "program_range": { "const": "P8081-P8160" },
    "source_program_range": { "const": "P8001-P8080" },
    "conversation_capture_contract": {
      "type": "object",
      "required": [
        "schema_version",
        "program_range",
        "source_program_range",
        "required_source_fields",
        "required_extraction_types",
        "codex_is_development_engine",
        "claude_is_independent_review_engine",
        "harness_is_status_evidence_control_plane",
        "raw_transcript_body_default_visible",
        "full_transcript_body_default_visible",
        "redacted_summary_ui_visible",
        "raw_secret_material_allowed_in_ui",
        "raw_client_material_allowed_in_ui",
        "human_gate_in_scope",
        "codex_final_approval_allowed",
        "claude_final_approval_allowed",
        "enterprise_pass_enabled",
        "production_pass_enabled",
        "runtime_execution_enabled",
        "write_action_enabled"
      ],
      "properties": {
        "schema_version": { "const": "conversation-capture-contract-policy.v1" },
        "program_range": { "const": "P8081-P8160" },
        "source_program_range": { "const": "P8001-P8080" },
        "required_source_fields": { "type": "array", "minItems": 8 },
        "required_extraction_types": { "type": "array", "minItems": 5 },
        "codex_is_development_engine": { "const": true },
        "claude_is_independent_review_engine": { "const": true },
        "harness_is_status_evidence_control_plane": { "const": true },
        "raw_transcript_body_default_visible": { "const": false },
        "full_transcript_body_default_visible": { "const": false },
        "redacted_summary_ui_visible": { "const": true },
        "raw_secret_material_allowed_in_ui": { "const": false },
        "raw_client_material_allowed_in_ui": { "const": false },
        "human_gate_in_scope": { "const": false },
        "codex_final_approval_allowed": { "const": false },
        "claude_final_approval_allowed": { "const": false },
        "enterprise_pass_enabled": { "const": false },
        "production_pass_enabled": { "const": false },
        "runtime_execution_enabled": { "const": false },
        "write_action_enabled": { "const": false }
      },
      "additionalProperties": true
    },
    "conversation_capture_phase_rows": { "type": "array", "minItems": 4, "items": { "$ref": "#/$defs/row" } },
    "engine_session_rows": { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/row" } },
    "transcript_reference_rows": { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/row" } },
    "raw_full_redacted_boundary_rows": { "type": "array", "minItems": 3, "items": { "$ref": "#/$defs/row" } },
    "plan_extraction_contract_rows": { "type": "array", "minItems": 5, "items": { "$ref": "#/$defs/row" } },
    "conversation_capture_validator_rows": { "type": "array", "minItems": 5, "items": { "$ref": "#/$defs/row" } },
    "conversation_capture_negative_fixture_rows": { "type": "array", "minItems": 8, "items": { "$ref": "#/$defs/row" } },
    "conversation_capture_gate_rows": { "type": "array", "minItems": 16, "items": { "$ref": "#/$defs/row" } },
    "conversation_capture_boundary": {
      "type": "object",
      "required": [
        "schema_version",
        "program_range",
        "source_program_range",
        "source_p8000_closeout_ready",
        "conversation_capture_contract_ready",
        "engine_sessions_ready",
        "transcript_refs_ready",
        "raw_transcript_ui_visible",
        "full_transcript_ui_visible",
        "redacted_summary_ui_visible",
        "plan_extraction_contract_ready",
        "capture_validator_ready",
        "duplicate_detection_enabled",
        "uncited_memory_blocked",
        "authority_contamination_blocked",
        "human_gate_in_scope",
        "codex_final_approval_allowed",
        "claude_final_approval_allowed",
        "production_pass_enabled",
        "enterprise_pass_enabled",
        "runtime_execution_enabled",
        "write_action_enabled",
        "unsafe_flag_count"
      ],
      "properties": {
        "schema_version": { "const": "conversation-capture-boundary.v1" },
        "program_range": { "const": "P8081-P8160" },
        "source_program_range": { "const": "P8001-P8080" },
        "source_p8000_closeout_ready": { "type": "boolean" },
        "conversation_capture_contract_ready": { "type": "boolean" },
        "engine_sessions_ready": { "type": "boolean" },
        "transcript_refs_ready": { "type": "boolean" },
        "raw_transcript_ui_visible": { "const": false },
        "full_transcript_ui_visible": { "const": false },
        "redacted_summary_ui_visible": { "const": true },
        "plan_extraction_contract_ready": { "type": "boolean" },
        "capture_validator_ready": { "type": "boolean" },
        "duplicate_detection_enabled": { "const": true },
        "uncited_memory_blocked": { "const": true },
        "authority_contamination_blocked": { "const": true },
        "human_gate_in_scope": { "const": false },
        "codex_final_approval_allowed": { "const": false },
        "claude_final_approval_allowed": { "const": false },
        "production_pass_enabled": { "const": false },
        "enterprise_pass_enabled": { "const": false },
        "runtime_execution_enabled": { "const": false },
        "write_action_enabled": { "const": false },
        "unsafe_flag_count": { "type": "number", "minimum": 0 }
      },
      "additionalProperties": true
    },
    "summary": {
      "type": "object",
      "required": [
        "schema_version",
        "conversation_capture_contract_status",
        "program_range",
        "source_program_range",
        "source_p8000_closeout_ready",
        "engine_session_count",
        "transcript_reference_count",
        "plan_extraction_count",
        "raw_transcript_ui_visible",
        "full_transcript_ui_visible",
        "redacted_summary_ui_visible",
        "human_gate_in_scope",
        "codex_final_approval_allowed",
        "claude_final_approval_allowed",
        "production_pass_enabled",
        "enterprise_pass_enabled",
        "unsafe_flag_count",
        "validation_error_count"
      ],
      "properties": {
        "schema_version": { "const": "conversation-capture-contract-summary.v1" },
        "conversation_capture_contract_status": {
          "enum": ["ready_for_conversation_capture_contract", "blocked"]
        },
        "program_range": { "const": "P8081-P8160" },
        "source_program_range": { "const": "P8001-P8080" },
        "source_p8000_closeout_ready": { "type": "boolean" },
        "engine_session_count": { "type": "number", "minimum": 2 },
        "transcript_reference_count": { "type": "number", "minimum": 2 },
        "plan_extraction_count": { "type": "number", "minimum": 5 },
        "raw_transcript_ui_visible": { "const": false },
        "full_transcript_ui_visible": { "const": false },
        "redacted_summary_ui_visible": { "const": true },
        "human_gate_in_scope": { "const": false },
        "codex_final_approval_allowed": { "const": false },
        "claude_final_approval_allowed": { "const": false },
        "production_pass_enabled": { "const": false },
        "enterprise_pass_enabled": { "const": false },
        "unsafe_flag_count": { "type": "number", "minimum": 0 },
        "validation_error_count": { "type": "number", "minimum": 0 }
      },
      "additionalProperties": true
    },
    "validation": {
      "type": "object",
      "required": ["valid", "item_count", "error_count", "errors"],
      "properties": {
        "valid": { "type": "boolean" },
        "item_count": { "type": "number", "minimum": 1 },
        "error_count": { "type": "number", "minimum": 0 },
        "errors": { "type": "array" }
      },
      "additionalProperties": true
    }
  },
  "$defs": {
    "row": {
      "type": "object",
      "required": ["schema_version", "row_id"],
      "properties": {
        "schema_version": { "type": "string", "minLength": 1 },
        "row_id": { "type": "string", "minLength": 1 },
        "current_verdict": { "enum": ["pass", "blocked"] },
        "unsafe_flags_false": { "type": "boolean" },
        "verdict_authority": { "type": "string" }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
