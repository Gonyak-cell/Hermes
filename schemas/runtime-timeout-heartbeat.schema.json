        "workflow_in_run_gate_framework",
        "desktop_companion_integration"
      ]
    },
    "runtime_timeout_heartbeat_contract": {
      "type": "object",
      "required": [
        "lifecycle_contract_id",
        "contract_status",
        "lifecycle_status",
        "heartbeat_authority",
        "timeout_authority",
        "source_of_truth",
        "heartbeat_ledger_required",
        "timeout_ledger_required",
        "run_ledger_binding_required",
        "normalized_log_binding_required",
        "trace_binding_required",
        "runtime_self_report_trusted",
        "desktop_read_only",
        "desktop_mutation_allowed",
        "desktop_protected_mutation_execution_allowed",
        "desktop_source_of_truth",
        "heartbeat_write_allowed",
        "timeout_override_allowed",
        "cancel_allowed",
        "resume_allowed",
        "clock_edit_allowed"
      ],
      "properties": {
        "lifecycle_contract_id": { "const": "runtime-timeout-heartbeat.default" },
        "contract_status": { "const": "locked" },
        "lifecycle_status": { "const": "locked" },
        "heartbeat_authority": { "const": "harness_control_plane" },
        "timeout_authority": { "const": "harness_control_plane" },
        "source_of_truth": { "const": "runtime_agentrun_contract_agent_run_ledger_and_runtime_logs" },
        "heartbeat_ledger_required": { "const": true },
        "timeout_ledger_required": { "const": true },
        "run_ledger_binding_required": { "const": true },
        "normalized_log_binding_required": { "const": true },
        "trace_binding_required": { "const": true },
        "runtime_self_report_trusted": { "const": false },
        "desktop_read_only": { "const": true },
        "desktop_mutation_allowed": { "const": false },
        "desktop_protected_mutation_execution_allowed": { "const": false },
        "desktop_source_of_truth": { "const": false },
        "heartbeat_write_allowed": { "const": false },
        "timeout_override_allowed": { "const": false },
        "cancel_allowed": { "const": false },
        "resume_allowed": { "const": false },
        "clock_edit_allowed": { "const": false }
      }
    },
    "runtime_heartbeat_records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "runtime_heartbeat_record_id",
          "heartbeat_authority",
          "heartbeat_status",
          "agent_run_id",
          "workflow_run_id",
          "runtime_id",
          "runtime_log_id",
          "normalized_log_id",
          "observability_trace_id",
          "correlation_trace_id",
          "heartbeat_interval_seconds",
          "timeout_seconds",
          "recorded_heartbeat_count",
          "heartbeat_missed",
          "long_running_watch_required",
          "long_running_state",
          "runtime_self_report_trusted",
          "desktop_read_only"
        ],
        "properties": {
          "heartbeat_authority": { "const": "harness_control_plane" },
          "heartbeat_status": { "enum": ["observed_terminal", "watching"] },
          "heartbeat_interval_seconds": { "type": "integer", "minimum": 1 },
          "timeout_seconds": { "type": "integer", "minimum": 1 },
