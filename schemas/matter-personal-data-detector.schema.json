{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/matter-personal-data-detector.schema.json",
  "title": "Hermes Matter Personal Data Detector",
  "type": "object",
  "required": [
    "schema_version",
    "generated_at",
    "matter_personal_data_detector_id",
    "matter_personal_data_detector_status",
    "safe_handling",
    "inputs",
    "source_contracts",
    "matter_personal_data_detector_contract",
    "personal_data_detection_records",
    "personal_data_policy_links",
    "personal_data_quarantine_links",
    "matter_personal_data_summaries",
    "matter_personal_data_detector_desktop_boundary",
    "matter_personal_data_detector_checkpoints",
    "validation_items",
    "validation",
    "summary"
  ],
  "properties": {
    "schema_version": { "const": "matter-personal-data-detector.v1" },
    "generated_at": { "type": "string", "minLength": 1 },
    "matter_personal_data_detector_id": { "type": "string", "minLength": 1 },
    "output_dir": { "type": "string" },
    "matter_personal_data_detector_status": { "enum": ["complete", "blocked"] },
    "safe_handling": { "$ref": "#/$defs/safe_handling" },
    "inputs": { "type": "object" },
    "source_contracts": { "type": "object" },
    "matter_personal_data_detector_contract": { "$ref": "#/$defs/contract" },
    "personal_data_detection_records": { "type": "array", "items": { "$ref": "#/$defs/detection_record" } },
    "personal_data_policy_links": { "type": "array", "items": { "$ref": "#/$defs/policy_link" } },
    "personal_data_quarantine_links": { "type": "array", "items": { "$ref": "#/$defs/quarantine_link" } },
    "matter_personal_data_summaries": { "type": "array", "items": { "$ref": "#/$defs/matter_summary" } },
    "matter_personal_data_detector_desktop_boundary": { "$ref": "#/$defs/desktop_boundary" },
    "matter_personal_data_detector_checkpoints": { "type": "array", "items": { "$ref": "#/$defs/checkpoint" } },
    "validation_items": { "type": "array", "items": { "$ref": "#/$defs/validation_item" } },
    "validation": { "$ref": "#/$defs/validation" },
    "summary": { "$ref": "#/$defs/summary" }
  },
  "$defs": {
    "safe_handling": {
      "type": "object",
      "required": [
        "report_only",
        "legal_advice_provided",
        "client_facing_output_generated",
        "attorney_review_required",
        "human_review_required",
        "policy_enforcement_mutation_performed",
        "quarantine_execution_performed",
        "matter_data_write_allowed",
        "task_state_write_allowed",
        "workflow_transition_allowed",
        "runtime_execution_performed",
        "delivery_execution_performed",
        "desktop_mutation_allowed",
        "desktop_source_of_truth",
        "protected_mutation_executed",
        "secret_material_exposed",
        "provider_key_visible"
      ],
      "properties": {
        "report_only": { "const": true },
        "legal_advice_provided": { "const": false },
        "client_facing_output_generated": { "const": false },
        "attorney_review_required": { "const": true },
        "human_review_required": { "const": true },
        "policy_enforcement_mutation_performed": { "const": false },
        "quarantine_execution_performed": { "const": false },
        "matter_data_write_allowed": { "const": false },
        "task_state_write_allowed": { "const": false },
        "workflow_transition_allowed": { "const": false },
        "runtime_execution_performed": { "const": false },
        "delivery_execution_performed": { "const": false },
        "desktop_mutation_allowed": { "const": false },
        "desktop_source_of_truth": { "const": false },
        "protected_mutation_executed": { "const": false },
        "secret_material_exposed": { "const": false },
        "provider_key_visible": { "const": false }
      }
    },
    "contract": {
      "type": "object",
      "required": [
        "schema_version",
        "contract_id",
        "source_of_truth",
        "detector_rule",
        "policy_binding_rule",
        "quarantine_binding_rule",
        "matter_boundary_rule",
        "attorney_review_rule",
        "desktop_companion_rule",
        "mutation_policy",
        "created_at"
      ],
      "properties": {
        "schema_version": { "const": "matter-personal-data-detector-contract.v1" },
        "contract_id": { "const": "matter-personal-data-detector.v1" },
        "source_of_truth": { "const": "matter_knowledge_graph_document_index_privilege_classifier_policy_quarantine_and_matter_files" },
        "detector_rule": { "type": "string" },
        "policy_binding_rule": { "type": "string" },
        "quarantine_binding_rule": { "type": "string" },
        "matter_boundary_rule": { "type": "string" },
        "attorney_review_rule": { "type": "string" },
        "desktop_companion_rule": { "type": "string" },
        "mutation_policy": { "type": "string" },
        "created_at": { "type": "string" }
      }
    },
    "detection_record": {
      "type": "object",
      "required": [
        "schema_version",
        "personal_data_detection_record_id",
        "matter_id",
        "evidence_node_id",
        "evidence_label",
        "source_record_id",
        "detected_personal_data_categories",
        "primary_personal_data_category",
        "personal_data_flag",
        "sensitive_personal_data",
        "personal_data_detection_status",
        "review_status",
        "attorney_review_required",
        "human_review_required",
        "policy_classification",
        "policy_binding_status",
        "quarantine_binding_status",
        "quarantine_action",
        "quarantine_applied",
        "legal_advice_provided",
        "client_facing_output_generated",
        "matter_data_write_allowed",
        "task_state_write_allowed",
        "workflow_transition_allowed",
        "runtime_execution_allowed",
        "delivery_execution_allowed",
        "protected_action_allowed",
        "policy_enforcement_mutation_performed",
        "quarantine_execution_performed",
        "detection_signals",
        "created_at",
        "sequence_number",
        "metadata"
      ],
      "properties": {
        "schema_version": { "const": "matter-personal-data-detection-record.v1" },
        "personal_data_detection_record_id": { "type": "string", "minLength": 1 },
        "matter_id": { "type": "string", "minLength": 1 },
        "evidence_node_id": { "type": "string", "minLength": 1 },
        "evidence_label": { "type": "string", "minLength": 1 },
        "source_record_id": { "type": "string", "minLength": 1 },
        "detected_personal_data_categories": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "primary_personal_data_category": { "type": "string", "minLength": 1 },
        "personal_data_flag": { "enum": ["personal_data_review_required", "sensitive_personal_data_review_required"] },
        "sensitive_personal_data": { "type": "boolean" },
        "personal_data_detection_status": { "const": "candidate_review_required" },
        "review_status": { "const": "attorney_review_required" },
        "attorney_review_required": { "const": true },
        "human_review_required": { "const": true },
        "policy_classification": { "type": "string", "minLength": 1 },
        "policy_binding_status": { "const": "bound" },
        "quarantine_binding_status": { "const": "bound" },
        "quarantine_action": { "const": "quarantine_review_required_not_applied" },
        "quarantine_applied": { "const": false },
        "legal_advice_provided": { "const": false },
        "client_facing_output_generated": { "const": false },
        "matter_data_write_allowed": { "const": false },
        "task_state_write_allowed": { "const": false },
        "workflow_transition_allowed": { "const": false },
        "runtime_execution_allowed": { "const": false },
        "delivery_execution_allowed": { "const": false },
        "protected_action_allowed": { "const": false },
        "policy_enforcement_mutation_performed": { "const": false },
        "quarantine_execution_performed": { "const": false },
        "detection_signals": { "type": "array", "minItems": 1 },
        "created_at": { "type": "string" },
        "sequence_number": { "type": "integer", "minimum": 1 },
        "metadata": { "type": "object" }
      }
    },
    "policy_link": {
      "type": "object",
      "required": [
        "schema_version",
        "personal_data_policy_link_id",
        "personal_data_detection_record_id",
        "matter_id",
        "policy_classification",
        "classification_rule_id",
        "required_gates",
        "policy_binding_status",
        "policy_mutation_performed",
        "attorney_review_required",
        "human_review_required",
        "created_at"
      ],
      "properties": {
        "schema_version": { "const": "personal-data-policy-link.v1" },
        "personal_data_policy_link_id": { "type": "string", "minLength": 1 },
        "personal_data_detection_record_id": { "type": "string", "minLength": 1 },
        "matter_id": { "type": "string", "minLength": 1 },
        "policy_classification": { "type": "string", "minLength": 1 },
        "classification_rule_id": { "type": "string", "minLength": 1 },
        "required_gates": { "type": "array", "contains": { "const": "personal_data_gate" } },
        "policy_binding_status": { "const": "bound" },
        "policy_mutation_performed": { "const": false },
        "attorney_review_required": { "const": true },
        "human_review_required": { "const": true },
        "created_at": { "type": "string" }
      }
    },
    "quarantine_link": {
      "type": "object",
      "required": [
        "schema_version",
        "personal_data_quarantine_link_id",
        "personal_data_detection_record_id",
        "matter_id",
        "quarantine_rule_id",
        "quarantine_category",
        "quarantine_binding_status",
        "quarantine_action",
        "quarantine_applied",
        "retrieval_allowed",
        "external_transfer_allowed",
        "output_delivery_allowed",
        "auto_release_allowed",
        "human_review_required",
        "attorney_review_required",
        "created_at"
      ],
      "properties": {
        "schema_version": { "const": "personal-data-quarantine-link.v1" },
        "personal_data_quarantine_link_id": { "type": "string", "minLength": 1 },
        "personal_data_detection_record_id": { "type": "string", "minLength": 1 },
        "matter_id": { "type": "string", "minLength": 1 },
        "quarantine_rule_id": { "type": "string", "minLength": 1 },
        "quarantine_category": { "const": "sensitive_data" },
        "quarantine_binding_status": { "const": "bound" },
        "quarantine_action": { "const": "quarantine_review_required_not_applied" },
        "quarantine_applied": { "const": false },
        "retrieval_allowed": { "const": false },
        "external_transfer_allowed": { "const": false },
        "output_delivery_allowed": { "const": false },
        "auto_release_allowed": { "const": false },
        "human_review_required": { "const": true },
        "attorney_review_required": { "const": true },
        "created_at": { "type": "string" }
      }
    },
    "matter_summary": {
      "type": "object",
      "required": [
        "schema_version",
        "matter_id",
        "matter_title",
        "matter_personal_data_status",
        "detection_record_count",
        "sensitive_personal_data_flagged_count",
        "policy_link_count",
        "quarantine_link_count",
        "policy_bound_detection_count",
        "quarantine_bound_detection_count",
        "quarantine_applied_count",
        "attorney_review_required_count",
        "human_review_required_count",
        "legal_advice_provided",
        "client_facing_output_generated",
        "created_at"
      ],
      "properties": {
        "schema_version": { "const": "matter-personal-data-summary.v1" },
        "matter_id": { "type": "string", "minLength": 1 },
        "matter_title": { "type": "string", "minLength": 1 },
        "matter_personal_data_status": { "const": "complete" },
        "detection_record_count": { "type": "integer", "minimum": 1 },
        "sensitive_personal_data_flagged_count": { "type": "integer", "minimum": 0 },
        "policy_link_count": { "type": "integer", "minimum": 1 },
        "quarantine_link_count": { "type": "integer", "minimum": 1 },
        "policy_bound_detection_count": { "type": "integer", "minimum": 1 },
        "quarantine_bound_detection_count": { "type": "integer", "minimum": 1 },
        "quarantine_applied_count": { "const": 0 },
        "attorney_review_required_count": { "type": "integer", "minimum": 1 },
        "human_review_required_count": { "type": "integer", "minimum": 1 },
        "legal_advice_provided": { "const": false },
        "client_facing_output_generated": { "const": false },
        "created_at": { "type": "string" }
      }
    },
    "desktop_boundary": {
      "type": "object",
      "required": [
        "schema_version",
        "boundary_status",
        "read_only",
        "mutation_allowed",
        "source_of_truth",
        "matter_data_write_allowed",
        "task_state_write_allowed",
        "workflow_transition_allowed",
        "runtime_execution_allowed",
        "delivery_execution_allowed",
        "protected_action_allowed",
        "quarantine_execution_allowed",
        "policy_enforcement_mutation_allowed",
        "legal_advice_allowed",
        "client_facing_output_allowed_without_attorney_review",
        "allowed_operations",
        "blocked_operations",
        "created_at"
      ],
      "properties": {
        "schema_version": { "const": "matter-personal-data-detector-desktop-boundary.v1" },
        "boundary_status": { "const": "enforced" },
        "read_only": { "const": true },
        "mutation_allowed": { "const": false },
        "source_of_truth": { "const": false },
        "matter_data_write_allowed": { "const": false },
        "task_state_write_allowed": { "const": false },
        "workflow_transition_allowed": { "const": false },
        "runtime_execution_allowed": { "const": false },
        "delivery_execution_allowed": { "const": false },
        "protected_action_allowed": { "const": false },
        "quarantine_execution_allowed": { "const": false },
        "policy_enforcement_mutation_allowed": { "const": false },
        "legal_advice_allowed": { "const": false },
        "client_facing_output_allowed_without_attorney_review": { "const": false },
        "allowed_operations": { "type": "array", "items": { "type": "string" } },
        "blocked_operations": { "type": "array", "items": { "type": "string" } },
        "created_at": { "type": "string" }
      }
    },
    "checkpoint": {
      "type": "object",
      "required": ["checkpoint_id", "checkpoint_status", "status", "message"],
      "properties": {
        "checkpoint_id": { "type": "string", "minLength": 1 },
        "checkpoint_status": { "enum": ["passed", "failed"] },
        "status": { "enum": ["passed", "failed"] },
        "message": { "type": "string" }
      }
    },
    "validation_item": {
      "type": "object",
      "required": ["path", "check_id", "status", "message"],
      "properties": {
        "path": { "type": "string" },
        "check_id": { "type": "string" },
        "status": { "enum": ["passed", "failed"] },
        "message": { "type": "string" }
      }
    },
    "validation": {
      "type": "object",
      "required": ["valid", "errors"],
      "properties": {
        "valid": { "type": "boolean" },
        "errors": { "type": "array" }
      }
    },
    "summary": {
      "type": "object",
      "required": [
        "matter_personal_data_detector_status",
        "matter_personal_data_detector_contract_id",
        "source_of_truth",
        "detection_record_count",
        "personal_data_flagged_count",
        "sensitive_personal_data_flagged_count",
        "policy_link_count",
        "quarantine_link_count",
        "policy_bound_detection_count",
        "quarantine_bound_detection_count",
        "quarantine_applied_count",
        "legal_advice_provided",
        "client_facing_output_generated",
        "policy_enforcement_mutation_performed",
        "quarantine_execution_performed",
        "desktop_boundary_status",
        "desktop_read_only",
        "desktop_mutation_allowed",
        "matter_data_write_allowed",
        "task_state_write_allowed",
        "workflow_transition_allowed",
        "runtime_execution_allowed",
        "delivery_execution_allowed",
        "protected_action_allowed",
        "validation_error_count"
      ],
      "properties": {
        "matter_personal_data_detector_status": { "enum": ["complete", "blocked"] },
        "matter_personal_data_detector_contract_id": { "const": "matter-personal-data-detector.v1" },
        "source_of_truth": { "const": "matter_knowledge_graph_document_index_privilege_classifier_policy_quarantine_and_matter_files" },
        "detection_record_count": { "type": "integer", "minimum": 0 },
        "personal_data_flagged_count": { "type": "integer", "minimum": 0 },
        "sensitive_personal_data_flagged_count": { "type": "integer", "minimum": 0 },
        "policy_link_count": { "type": "integer", "minimum": 0 },
        "quarantine_link_count": { "type": "integer", "minimum": 0 },
        "policy_bound_detection_count": { "type": "integer", "minimum": 0 },
        "quarantine_bound_detection_count": { "type": "integer", "minimum": 0 },
        "quarantine_applied_count": { "const": 0 },
        "legal_advice_provided": { "const": false },
        "client_facing_output_generated": { "const": false },
        "policy_enforcement_mutation_performed": { "const": false },
        "quarantine_execution_performed": { "const": false },
        "desktop_boundary_status": { "type": "string" },
        "desktop_read_only": { "type": "boolean" },
        "desktop_mutation_allowed": { "type": "boolean" },
        "matter_data_write_allowed": { "type": "boolean" },
        "task_state_write_allowed": { "type": "boolean" },
        "workflow_transition_allowed": { "type": "boolean" },
        "runtime_execution_allowed": { "type": "boolean" },
        "delivery_execution_allowed": { "type": "boolean" },
        "protected_action_allowed": { "type": "boolean" },
        "validation_error_count": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
