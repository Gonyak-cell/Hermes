{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hermes.local/schemas/validation-evidence-receipt-intake.schema.json",
  "title": "Hermes Validation Evidence Receipt Intake",
  "type": "object",
  "required": [
    "schema_version",
    "generated_at",
    "capability_id",
    "program_range",
    "source_program_range",
    "validation_evidence_receipt_intake_phase_rows",
    "p21200_source_binding_rows",
    "validation_evidence_receipt_schema_rows",
    "redacted_result_capture_rows",
    "freshness_completeness_guard_rows",
    "operator_evidence_inbox_rows",
    "no_execution_raw_boundary_rows",
    "p21600_clean_checkpoint_rows",
    "validation_evidence_receipt_intake_boundary",
    "validation_evidence_receipt_intake_validation_items",
    "summary",
    "validation"
  ],
  "properties": {
    "schema_version": { "const": "validation-evidence-receipt-intake.v1" },
    "generated_at": { "type": "string", "format": "date-time" },
    "capability_id": { "const": "platform.validation_evidence_receipt_intake" },
    "program_range": { "const": "P21201-P21600" },
    "source_program_range": { "const": "P20801-P21200" },
    "validation_evidence_receipt_intake_phase_rows": { "type": "array", "minItems": 7, "items": { "$ref": "#/$defs/verdictRow" } },
    "p21200_source_binding_rows": { "type": "array", "minItems": 9, "items": { "$ref": "#/$defs/verdictRow" } },
    "validation_evidence_receipt_schema_rows": { "type": "array", "minItems": 7, "items": { "$ref": "#/$defs/verdictRow" } },
    "redacted_result_capture_rows": { "type": "array", "minItems": 8, "items": { "$ref": "#/$defs/verdictRow" } },
    "freshness_completeness_guard_rows": { "type": "array", "minItems": 7, "items": { "$ref": "#/$defs/verdictRow" } },
    "operator_evidence_inbox_rows": { "type": "array", "minItems": 8, "items": { "$ref": "#/$defs/verdictRow" } },
    "no_execution_raw_boundary_rows": { "type": "array", "minItems": 22, "items": { "$ref": "#/$defs/verdictRow" } },
    "p21600_clean_checkpoint_rows": { "type": "array", "minItems": 8, "items": { "$ref": "#/$defs/verdictRow" } },
    "validation_evidence_receipt_intake_validation_items": { "type": "array", "minItems": 12, "items": { "$ref": "#/$defs/validationItem" } },
    "summary": {
      "type": "object",
      "required": [
        "validation_evidence_receipt_intake_status",
        "source_p21200_ready_for_p21201_handoff",
        "expected_receipt_count",
        "received_receipt_count",
        "missing_receipt_count",
        "ready_for_p21601_handoff",
        "raw_stdout_capture_allowed_now",
        "production_pass_enabled"
      ],
      "properties": {
        "validation_evidence_receipt_intake_status": {
          "enum": [
            "ready_for_validation_evidence_receipt_intake",
            "valid_block_receipt_intake_pending",
            "blocked_validation_evidence_receipt_intake"
          ]
        },
        "source_p21200_ready_for_p21201_handoff": { "type": "boolean" },
        "expected_receipt_count": { "type": "number" },
        "received_receipt_count": { "type": "number" },
        "missing_receipt_count": { "type": "number" },
        "ready_for_p21601_handoff": { "type": "boolean" },
        "raw_stdout_capture_allowed_now": { "const": false },
        "production_pass_enabled": { "const": false },
        "enterprise_trust_claim_allowed_now": { "const": false },
        "validation_error_count": { "type": "number" }
      }
    },
    "validation_evidence_receipt_intake_boundary": {
      "type": "object",
      "required": [
        "p21600_contract_ready",
        "ready_for_p21601_handoff",
        "source_p21200_ready_for_p21201_handoff",
        "source_validation_valid_now",
        "receipt_intake_contract_visible_now",
        "redacted_capture_contract_visible_now",
        "freshness_completeness_guard_visible_now",
        "operator_evidence_inbox_visible_now",
        "no_execution_raw_boundary_closed_now",
        "expected_receipt_count",
        "received_receipt_count",
        "missing_receipt_count",
        "redaction_rule_count",
        "freshness_guard_count",
        "operator_inbox_count",
        "command_execution_allowed_now",
        "raw_stdout_capture_allowed_now",
        "raw_stderr_capture_allowed_now",
        "raw_secret_material_allowed_now",
        "deployment_allowed_now",
        "release_approval_allowed_now",
        "production_pass_enabled",
        "enterprise_pass_enabled",
        "enterprise_trust_claim_allowed_now",
        "protected_closeout_enabled",
        "human_gate_bypass_allowed_now",
        "independent_review_bypass_allowed_now",
        "single_owner_enterprise_trust_allowed_now",
        "runtime_execution_allowed_now",
        "write_action_allowed_now",
        "protected_action_allowed_now",
        "connector_write_enabled",
        "external_service_mutation_allowed_now",
        "raw_source_exposure_allowed",
        "secret_read_allowed_now",
        "reviewer_mutation_allowed_now",
        "final_automated_approval_allowed"
      ],
      "properties": {
        "p21600_contract_ready": { "type": "boolean" },
        "ready_for_p21601_handoff": { "type": "boolean" },
        "source_p21200_ready_for_p21201_handoff": { "type": "boolean" },
        "source_validation_valid_now": { "type": "boolean" },
        "receipt_intake_contract_visible_now": { "type": "boolean" },
        "redacted_capture_contract_visible_now": { "type": "boolean" },
        "freshness_completeness_guard_visible_now": { "type": "boolean" },
        "operator_evidence_inbox_visible_now": { "type": "boolean" },
        "no_execution_raw_boundary_closed_now": { "type": "boolean" },
        "expected_receipt_count": { "type": "number" },
        "received_receipt_count": { "type": "number" },
        "missing_receipt_count": { "type": "number" },
        "redaction_rule_count": { "type": "number" },
        "freshness_guard_count": { "type": "number" },
        "operator_inbox_count": { "type": "number" },
        "command_execution_allowed_now": { "const": false },
        "raw_stdout_capture_allowed_now": { "const": false },
        "raw_stderr_capture_allowed_now": { "const": false },
        "raw_secret_material_allowed_now": { "const": false },
        "deployment_allowed_now": { "const": false },
        "release_approval_allowed_now": { "const": false },
        "production_pass_enabled": { "const": false },
        "enterprise_pass_enabled": { "const": false },
        "enterprise_trust_claim_allowed_now": { "const": false },
        "protected_closeout_enabled": { "const": false },
        "human_gate_bypass_allowed_now": { "const": false },
        "independent_review_bypass_allowed_now": { "const": false },
        "single_owner_enterprise_trust_allowed_now": { "const": false },
        "runtime_execution_allowed_now": { "const": false },
        "write_action_allowed_now": { "const": false },
        "protected_action_allowed_now": { "const": false },
        "connector_write_enabled": { "const": false },
        "external_service_mutation_allowed_now": { "const": false },
        "raw_source_exposure_allowed": { "const": false },
        "secret_read_allowed_now": { "const": false },
        "reviewer_mutation_allowed_now": { "const": false },
        "final_automated_approval_allowed": { "const": false }
      }
    },
    "validation": {
      "type": "object",
      "required": ["valid", "error_count", "errors"],
      "properties": {
        "valid": { "type": "boolean" },
        "error_count": { "type": "number" },
        "errors": { "type": "array" }
      }
    }
  },
  "$defs": {
    "verdictRow": {
      "type": "object",
      "required": [
        "row_id",
        "category",
        "label",
        "observed",
        "current_verdict",
        "block_reason",
        "evidence_ref",
        "generated_at"
      ],
      "properties": {
        "row_id": { "type": "string", "minLength": 1 },
        "category": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "observed": { "type": "boolean" },
        "current_verdict": { "enum": ["pass", "blocked"] },
        "block_reason": { "type": ["string", "null"] },
        "evidence_ref": { "type": "string", "minLength": 1 },
        "generated_at": { "type": "string", "format": "date-time" }
      }
    },
    "validationItem": {
      "type": "object",
      "required": ["item_id", "category", "passed", "message", "evidence_ref"],
      "properties": {
        "item_id": { "type": "string", "minLength": 1 },
        "category": { "type": "string", "minLength": 1 },
        "passed": { "type": "boolean" },
        "message": { "type": "string" },
        "evidence_ref": { "type": "string", "minLength": 1 }
      }
    }
  }
}
