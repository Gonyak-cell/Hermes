{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hermes.local/schemas/p16800-platform-freeze.schema.json",
  "title": "Hermes P16800 Platform Freeze",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "capability_id",
    "program_range",
    "source_program_range",
    "platform_freeze_contract",
    "platform_freeze_phase_rows",
    "platform_freeze_source_binding_rows",
    "roadmap_ledger_freeze_rows",
    "validation_matrix_freeze_rows",
    "review_cadence_freeze_rows",
    "authority_boundary_freeze_rows",
    "saas_factory_handoff_freeze_rows",
    "operator_evidence_projection_rows",
    "claude_platform_freeze_review_rows",
    "closeout_packet_projection_rows",
    "p16800_freeze_rows",
    "platform_freeze_boundary",
    "platform_freeze_validation_items",
    "validation",
    "summary"
  ],
  "properties": {
    "schema_version": { "const": "p16800-platform-freeze.v1" },
    "capability_id": { "const": "platform.p16800_platform_freeze" },
    "program_range": { "const": "P16601-P16800" },
    "source_program_range": { "const": "P16201-P16600" },
    "platform_freeze_phase_rows": { "type": "array", "minItems": 10, "items": { "$ref": "#/$defs/verdictRow" } },
    "platform_freeze_source_binding_rows": { "type": "array", "minItems": 9, "items": { "$ref": "#/$defs/verdictRow" } },
    "roadmap_ledger_freeze_rows": { "type": "array", "minItems": 6, "items": { "$ref": "#/$defs/verdictRow" } },
    "validation_matrix_freeze_rows": { "type": "array", "minItems": 6, "items": { "$ref": "#/$defs/verdictRow" } },
    "review_cadence_freeze_rows": { "type": "array", "minItems": 6, "items": { "$ref": "#/$defs/verdictRow" } },
    "authority_boundary_freeze_rows": { "type": "array", "minItems": 6, "items": { "$ref": "#/$defs/verdictRow" } },
    "saas_factory_handoff_freeze_rows": { "type": "array", "minItems": 6, "items": { "$ref": "#/$defs/verdictRow" } },
    "operator_evidence_projection_rows": { "type": "array", "minItems": 6, "items": { "$ref": "#/$defs/verdictRow" } },
    "claude_platform_freeze_review_rows": { "type": "array", "minItems": 5, "items": { "$ref": "#/$defs/verdictRow" } },
    "closeout_packet_projection_rows": { "type": "array", "minItems": 6, "items": { "$ref": "#/$defs/verdictRow" } },
    "p16800_freeze_rows": { "type": "array", "minItems": 12, "items": { "$ref": "#/$defs/verdictRow" } },
    "platform_freeze_boundary": {
      "type": "object",
      "required": [
        "source_production_governance_available",
        "source_ready_for_p16601_handoff",
        "source_block_visible_now",
        "roadmap_ledger_freeze_ready",
        "validation_matrix_freeze_ready",
        "review_cadence_freeze_ready",
        "authority_boundary_freeze_ready",
        "saas_factory_handoff_freeze_ready",
        "operator_evidence_projection_ready",
        "claude_platform_freeze_review_receipt_present_now",
        "claude_platform_freeze_review_block_visible_now",
        "closeout_packet_projection_ready",
        "p16800_platform_freeze_ready",
        "ready_for_post_p16800_handoff",
        "deployment_allowed_now",
        "release_approval_allowed_now",
        "production_pass_enabled",
        "enterprise_pass_enabled",
        "enterprise_trust_claim_allowed_now",
        "protected_closeout_enabled",
        "human_gate_bypass_allowed_now",
        "independent_review_bypass_allowed_now",
        "single_owner_enterprise_trust_allowed_now",
        "environment_config_write_allowed_now",
        "migration_execution_allowed_now",
        "rollback_execution_allowed_now",
        "runtime_execution_allowed_now",
        "write_action_allowed_now",
        "protected_action_allowed_now",
        "connector_write_enabled",
        "external_service_mutation_allowed_now",
        "secret_read_allowed_now",
        "raw_source_exposure_allowed",
        "reviewer_mutation_allowed_now",
        "final_approval_ui_enabled",
        "codex_final_approval_ui_enabled",
        "claude_final_approval_ui_enabled",
        "unsafe_flag_count"
      ],
      "properties": {
        "source_production_governance_available": { "type": "boolean" },
        "source_ready_for_p16601_handoff": { "type": "boolean" },
        "source_block_visible_now": { "type": "boolean" },
        "roadmap_ledger_freeze_ready": { "type": "boolean" },
        "validation_matrix_freeze_ready": { "type": "boolean" },
        "review_cadence_freeze_ready": { "type": "boolean" },
        "authority_boundary_freeze_ready": { "type": "boolean" },
        "saas_factory_handoff_freeze_ready": { "type": "boolean" },
        "operator_evidence_projection_ready": { "type": "boolean" },
        "claude_platform_freeze_review_receipt_present_now": { "type": "boolean" },
        "claude_platform_freeze_review_block_visible_now": { "type": "boolean" },
        "closeout_packet_projection_ready": { "type": "boolean" },
        "p16800_platform_freeze_ready": { "type": "boolean" },
        "ready_for_post_p16800_handoff": { "type": "boolean" },
        "deployment_allowed_now": { "const": false },
        "release_approval_allowed_now": { "const": false },
        "production_pass_enabled": { "const": false },
        "enterprise_pass_enabled": { "const": false },
        "enterprise_trust_claim_allowed_now": { "const": false },
        "protected_closeout_enabled": { "const": false },
        "human_gate_bypass_allowed_now": { "const": false },
        "independent_review_bypass_allowed_now": { "const": false },
        "single_owner_enterprise_trust_allowed_now": { "const": false },
        "environment_config_write_allowed_now": { "const": false },
        "migration_execution_allowed_now": { "const": false },
        "rollback_execution_allowed_now": { "const": false },
        "runtime_execution_allowed_now": { "const": false },
        "write_action_allowed_now": { "const": false },
        "protected_action_allowed_now": { "const": false },
        "connector_write_enabled": { "const": false },
        "external_service_mutation_allowed_now": { "const": false },
        "secret_read_allowed_now": { "const": false },
        "raw_source_exposure_allowed": { "const": false },
        "reviewer_mutation_allowed_now": { "const": false },
        "final_approval_ui_enabled": { "const": false },
        "codex_final_approval_ui_enabled": { "const": false },
        "claude_final_approval_ui_enabled": { "const": false },
        "unsafe_flag_count": { "const": 0 }
      }
    },
    "validation": {
      "type": "object",
      "required": ["valid", "error_count", "errors"],
      "properties": {
        "valid": { "type": "boolean" },
        "error_count": { "type": "integer", "minimum": 0 },
        "errors": { "type": "array" }
      }
    },
    "summary": {
      "type": "object",
      "required": [
        "platform_freeze_status",
        "program_range",
        "source_ready_for_p16601_handoff",
        "source_block_visible_now",
        "roadmap_ledger_freeze_row_count",
        "validation_matrix_freeze_row_count",
        "review_cadence_freeze_row_count",
        "authority_boundary_freeze_row_count",
        "saas_factory_handoff_freeze_row_count",
        "operator_evidence_projection_row_count",
        "claude_platform_freeze_review_receipt_present_now",
        "claude_platform_freeze_review_block_visible_now",
        "closeout_packet_projection_row_count",
        "p16800_platform_freeze_ready",
        "ready_for_post_p16800_handoff",
        "deployment_allowed_now",
        "release_approval_allowed_now",
        "production_pass_enabled",
        "enterprise_pass_enabled",
        "enterprise_trust_claim_allowed_now",
        "human_gate_bypass_allowed_now",
        "independent_review_bypass_allowed_now",
        "validation_error_count"
      ],
      "properties": {
        "platform_freeze_status": {
          "enum": ["ready_for_p16800_platform_freeze", "blocked_p16800_platform_freeze"]
        },
        "program_range": { "const": "P16601-P16800" },
        "roadmap_ledger_freeze_row_count": { "type": "integer", "minimum": 6 },
        "validation_matrix_freeze_row_count": { "type": "integer", "minimum": 6 },
        "review_cadence_freeze_row_count": { "type": "integer", "minimum": 6 },
        "authority_boundary_freeze_row_count": { "type": "integer", "minimum": 6 },
        "saas_factory_handoff_freeze_row_count": { "type": "integer", "minimum": 6 },
        "operator_evidence_projection_row_count": { "type": "integer", "minimum": 6 },
        "closeout_packet_projection_row_count": { "type": "integer", "minimum": 6 },
        "deployment_allowed_now": { "const": false },
        "release_approval_allowed_now": { "const": false },
        "production_pass_enabled": { "const": false },
        "enterprise_pass_enabled": { "const": false },
        "enterprise_trust_claim_allowed_now": { "const": false },
        "human_gate_bypass_allowed_now": { "const": false },
        "independent_review_bypass_allowed_now": { "const": false }
      }
    }
  },
  "$defs": {
    "verdictRow": {
      "type": "object",
      "required": ["row_id", "category", "label", "required", "observed", "evidence_ref", "current_verdict"],
      "properties": {
        "row_id": { "type": "string", "minLength": 1 },
        "category": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "required": { "type": "boolean" },
        "observed": { "type": "boolean" },
        "evidence_ref": { "type": "string", "minLength": 1 },
        "current_verdict": { "enum": ["pass", "blocked"] },
        "block_reason": { "type": ["string", "null"] }
      }
    }
  }
}
