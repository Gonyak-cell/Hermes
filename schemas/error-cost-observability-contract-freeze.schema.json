{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://amic.local/hermes/error-cost-observability-contract-freeze.schema.json",
  "title": "Hermes Error Cost Observability Contract Freeze",
  "type": "object",
  "required": [
    "schema_version",
    "generated_at",
    "freeze_id",
    "output_dir",
    "inputs",
    "source_contracts",
    "contract_versions",
    "field_requirements",
    "summary",
    "error_cost_observability_contract",
    "validation_items",
    "validation"
  ],
  "properties": {
    "schema_version": { "const": "error-cost-observability-contract-freeze.v1" },
    "generated_at": { "type": "string", "format": "date-time" },
    "freeze_id": { "type": "string" },
    "output_dir": { "type": "string" },
    "inputs": { "type": "object" },
    "source_contracts": { "type": "object" },
    "contract_versions": {
      "type": "object",
      "required": [
        "error_record_schema_version",
        "cost_observation_schema_version",
        "trace_projection_schema_version",
        "compatibility_floor"
      ],
      "properties": {
        "error_record_schema_version": { "const": "error-record.v2" },
        "cost_observation_schema_version": { "const": "cost-observation.v2" },
        "trace_projection_schema_version": { "const": "trace-projection.v2" },
        "compatibility_floor": { "const": "event-audit-run-contract.v2+observability-catalog.v1+cost-attribution-ledger.v1" }
      }
    },
    "field_requirements": { "type": "object" },
    "summary": {
      "type": "object",
      "required": [
        "freeze_status",
        "error_record_schema_version",
        "cost_observation_schema_version",
        "trace_projection_schema_version",
        "error_record_count",
        "cost_observation_count",
        "trace_projection_count",
        "token_usage_linked_count",
        "missing_token_usage_count",
        "latency_observed_count",
        "missing_latency_count",
        "retry_projection_count",
        "retry_count",
        "total_projected_usd",
        "total_token_count",
        "total_runtime_seconds",
        "validation_item_count",
        "failed_validation_item_count",
        "validation_error_count"
      ],
      "properties": {
        "freeze_status": { "enum": ["complete", "blocked"] },
        "error_record_schema_version": { "const": "error-record.v2" },
        "cost_observation_schema_version": { "const": "cost-observation.v2" },
        "trace_projection_schema_version": { "const": "trace-projection.v2" },
        "error_record_count": { "type": "integer", "minimum": 0 },
        "run_blocked_error_count": { "type": "integer", "minimum": 0 },
        "gate_failed_error_count": { "type": "integer", "minimum": 0 },
        "retryable_error_count": { "type": "integer", "minimum": 0 },
        "blocking_error_count": { "type": "integer", "minimum": 0 },
        "cost_observation_count": { "type": "integer", "minimum": 0 },
        "token_usage_linked_count": { "type": "integer", "minimum": 0 },
        "missing_token_usage_count": { "type": "integer", "minimum": 0 },
        "cost_attribution_linked_count": { "type": "integer", "minimum": 0 },
        "budget_alert_linked_count": { "type": "integer", "minimum": 0 },
        "over_budget_count": { "type": "integer", "minimum": 0 },
        "untracked_cost_count": { "type": "integer", "minimum": 0 },
        "total_projected_usd": { "type": "number" },
        "total_observed_usd": { "type": "number" },
        "total_estimated_token_usd": { "type": "number" },
        "total_token_count": { "type": "integer", "minimum": 0 },
        "trace_projection_count": { "type": "integer", "minimum": 0 },
        "trace_with_error_count": { "type": "integer", "minimum": 0 },
        "trace_with_cost_count": { "type": "integer", "minimum": 0 },
        "trace_with_policy_snapshot_count": { "type": "integer", "minimum": 0 },
        "latency_observed_count": { "type": "integer", "minimum": 0 },
        "missing_latency_count": { "type": "integer", "minimum": 0 },
        "total_runtime_seconds": { "type": "number", "minimum": 0 },
        "average_latency_seconds": { "type": "number", "minimum": 0 },
        "retry_projection_count": { "type": "integer", "minimum": 0 },
        "retry_count": { "type": "integer", "minimum": 0 },
        "trace_with_retry_count": { "type": "integer", "minimum": 0 },
        "validation_item_count": { "type": "integer", "minimum": 0 },
        "failed_validation_item_count": { "type": "integer", "minimum": 0 },
        "validation_error_count": { "type": "integer", "minimum": 0 },
        "by_error_kind": { "type": "object" },
        "by_error_severity": { "type": "object" },
        "by_cost_status": { "type": "object" },
        "by_trace_status": { "type": "object" },
        "by_retry_status": { "type": "object" },
        "by_runtime_id": { "type": "object" },
        "by_domain_pack": { "type": "object" }
      }
    },
    "error_cost_observability_contract": {
      "type": "object",
      "required": [
        "schema_version",
        "generated_at",
        "error_records",
        "cost_observations",
        "trace_projections"
      ],
      "properties": {
        "schema_version": { "const": "error-cost-observability-contract.v2" },
        "generated_at": { "type": "string", "format": "date-time" },
        "error_records": { "type": "array", "items": { "$ref": "#/$defs/error_record_v2" } },
        "cost_observations": { "type": "array", "items": { "$ref": "#/$defs/cost_observation_v2" } },
        "trace_projections": { "type": "array", "items": { "$ref": "#/$defs/trace_projection_v2" } }
      }
    },
    "validation_items": { "type": "array", "items": { "$ref": "#/$defs/validation_item" } },
    "validation": { "$ref": "#/$defs/validation" }
  },
  "$defs": {
    "error_record_v2": {
      "type": "object",
      "required": [
        "schema_version",
        "error_record_id",
        "error_kind",
        "error_type",
        "severity",
        "error_status",
        "workflow_run_id",
        "run_ledger_id",
        "correlation_id",
        "tenant_id",
        "matter_id",
        "capability_id",
        "policy_snapshot_id",
        "retryable",
        "retry_count",
        "retry_status",
        "blocking",
        "message",
        "first_seen_at",
        "last_seen_at"
      ],
      "properties": {
        "schema_version": { "const": "error-record.v2" },
        "error_record_id": { "type": "string" },
        "source_error_id": { "type": "string" },
        "error_kind": { "type": "string" },
        "error_type": { "type": "string" },
        "severity": { "type": "string" },
        "error_status": { "type": "string" },
        "workflow_run_id": { "type": "string" },
        "run_ledger_id": { "type": "string" },
        "correlation_id": { "type": "string" },
        "tenant_id": { "type": "string" },
        "matter_id": { "type": ["string", "null"] },
        "capability_id": { "type": ["string", "null"] },
        "policy_snapshot_id": { "type": "string" },
        "actor_type": { "type": "string" },
        "actor_id": { "type": "string" },
        "retryable": { "type": "boolean" },
        "retry_count": { "type": "integer", "minimum": 0 },
        "retry_status": { "type": "string" },
        "blocking": { "type": "boolean" },
        "message": { "type": "string" },
        "first_seen_at": { "type": "string", "format": "date-time" },
        "last_seen_at": { "type": "string", "format": "date-time" },
        "source_refs": { "type": "object" },
        "metadata": { "type": "object" }
      }
    },
    "cost_observation_v2": {
      "type": "object",
      "required": [
        "schema_version",
        "cost_observation_id",
        "attribution_id",
        "budget_decision_id",
        "workflow_run_id",
        "runtime_id",
        "capability_id",
        "domain_pack",
        "tenant_id",
        "matter_id",
        "classification",
        "cost_status",
        "budget_status",
        "token_tracking_status",
        "alert_status",
        "projected_usd",
        "total_token_count",
        "observed_runtime_seconds",
        "cost_record_count",
        "audit_required",
        "recorded_at",
        "cost_hash"
      ],
      "properties": {
        "schema_version": { "const": "cost-observation.v2" },
        "cost_observation_id": { "type": "string" },
        "attribution_id": { "type": "string" },
        "budget_decision_id": { "type": "string" },
        "token_usage_id": { "type": ["string", "null"] },
        "alert_record_id": { "type": ["string", "null"] },
        "workflow_run_id": { "type": "string" },
        "run_ledger_id": { "type": ["string", "null"] },
        "agent_run_id": { "type": "string" },
        "runtime_id": { "type": "string" },
        "capability_id": { "type": "string" },
        "domain_pack": { "type": "string" },
        "tenant_id": { "type": "string" },
        "matter_id": { "type": "string" },
        "classification": { "type": "string" },
        "policy_snapshot_id": { "type": ["string", "null"] },
        "cost_status": { "type": "string" },
        "budget_status": { "type": "string" },
        "token_tracking_status": { "type": "string" },
        "alert_status": { "type": "string" },
        "max_usd": { "type": ["number", "null"] },
        "observed_usd": { "type": "number" },
        "estimated_token_usd": { "type": "number" },
        "projected_usd": { "type": "number" },
        "budget_remaining_usd": { "type": ["number", "null"] },
        "over_budget": { "type": "boolean" },
        "untracked_cost": { "type": "boolean" },
        "input_token_count": { "type": "integer", "minimum": 0 },
        "output_token_count": { "type": "integer", "minimum": 0 },
        "total_token_count": { "type": "integer", "minimum": 0 },
        "observed_runtime_seconds": { "type": "number", "minimum": 0 },
        "cost_record_count": { "type": "integer", "minimum": 0 },
        "source_cost_record_ids": { "type": "array", "items": { "type": "string" } },
        "audit_required": { "type": "boolean" },
        "recorded_at": { "type": "string", "format": "date-time" },
        "cost_hash": { "type": "string" },
        "metadata": { "type": "object" }
      }
    },
    "trace_projection_v2": {
      "type": "object",
      "required": [
        "schema_version",
        "trace_projection_id",
        "run_ledger_id",
        "workflow_run_id",
        "correlation_id",
        "tenant_id",
        "policy_snapshot_id",
        "run_status",
        "trace_status",
        "latency_status",
        "retry_count",
        "retry_status",
        "event_record_ids",
        "agent_run_ids",
        "error_record_ids",
        "cost_observation_ids",
        "duration_seconds",
        "observed_runtime_seconds",
        "latency_seconds",
        "projected_usd",
        "total_token_count"
      ],
      "properties": {
        "schema_version": { "const": "trace-projection.v2" },
        "trace_projection_id": { "type": "string" },
        "run_ledger_id": { "type": "string" },
        "workflow_run_id": { "type": "string" },
        "correlation_id": { "type": "string" },
        "tenant_id": { "type": "string" },
        "matter_id": { "type": ["string", "null"] },
        "capability_id": { "type": ["string", "null"] },
        "domain_pack": { "type": ["string", "null"] },
        "policy_snapshot_id": { "type": "string" },
        "run_status": { "type": "string" },
        "trace_status": { "type": "string" },
        "started_at": { "type": "string", "format": "date-time" },
        "updated_at": { "type": "string", "format": "date-time" },
        "duration_seconds": { "type": "number", "minimum": 0 },
        "observed_runtime_seconds": { "type": "number", "minimum": 0 },
        "latency_seconds": { "type": "number", "minimum": 0 },
        "latency_status": { "type": "string" },
        "retry_count": { "type": "integer", "minimum": 0 },
        "retry_status": { "type": "string" },
        "retry_event_ids": { "type": "array", "items": { "type": "string" } },
        "event_record_ids": { "type": "array", "items": { "type": "string" } },
        "audit_event_ids": { "type": "array", "items": { "type": "string" } },
        "agent_run_ids": { "type": "array", "items": { "type": "string" } },
        "error_record_ids": { "type": "array", "items": { "type": "string" } },
        "cost_observation_ids": { "type": "array", "items": { "type": "string" } },
        "token_usage_ids": { "type": "array", "items": { "type": "string" } },
        "event_count": { "type": "integer", "minimum": 0 },
        "audit_event_count": { "type": "integer", "minimum": 0 },
        "agent_run_count": { "type": "integer", "minimum": 0 },
        "error_record_count": { "type": "integer", "minimum": 0 },
        "cost_observation_count": { "type": "integer", "minimum": 0 },
        "token_usage_count": { "type": "integer", "minimum": 0 },
        "projected_usd": { "type": "number" },
        "total_token_count": { "type": "integer", "minimum": 0 },
        "recorded_at": { "type": "string", "format": "date-time" },
        "metadata": { "type": "object" }
      }
    },
    "validation_item": {
      "type": "object",
      "required": ["path", "check_id", "status", "message"],
      "properties": {
        "path": { "type": "string" },
        "check_id": { "type": "string" },
        "status": { "enum": ["passed", "failed"] },
        "message": { "type": "string" },
        "metadata": { "type": "object" }
      }
    },
    "validation": {
      "type": "object",
      "required": ["valid", "errors"],
      "properties": {
        "valid": { "type": "boolean" },
        "errors": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["path", "check_id", "message"],
            "properties": {
              "path": { "type": "string" },
              "check_id": { "type": "string" },
              "message": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
