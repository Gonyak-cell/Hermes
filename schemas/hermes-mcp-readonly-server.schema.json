        "properties": {
          "invocation_mode": { "const": "read_only_or_check_only" },
          "adapter_allowlisted": { "const": true },
          "check_mode_required": { "const": true },
          "mutation_allowed_now": { "const": false },
          "connector_write_allowed_now": { "const": false },
          "deployment_allowed_now": { "const": false },
          "protected_action_allowed_now": { "const": false },
          "final_approval_allowed_now": { "const": false }
        }
      }
    },
    "authority_boundary": {
      "type": "object",
      "required": [
        "schema_version",
        "source_of_truth",
        "registry_status",
        "stdio_transport_enabled",
        "server_entrypoint_registered",
        "serve_script_registered",
        "server_started_during_check",
        "live_mcp_connection_opened_during_check",
        "stdout_jsonrpc_only",
        "resource_read_allowed_now",
        "tool_listing_allowed_now",
        "tool_call_returns_contract_only_now",
        "check_tool_adapter_enabled_now",
        "check_tool_subprocess_execution_allowed_now",
        "non_check_tool_subprocess_execution_allowed_now",
        "tool_subprocess_execution_allowed_now",
        "repo_write_allowed_now",
        "filesystem_write_allowed_now",
        "connector_write_allowed_now",
        "deployment_allowed_now",
        "protected_action_allowed_now",
        "receipt_application_allowed_now",
        "final_approval_allowed_now",
        "production_pass_allowed_now",
        "enterprise_trust_claim_allowed_now",
        "raw_secret_context_allowed",
        "raw_restricted_payload_allowed",
        "desktop_source_of_truth"
      ],
      "properties": {
        "schema_version": { "const": "hermes-mcp-readonly-server-authority-boundary.v1" },
        "source_of_truth": { "const": "repo_artifacts_schemas" },
        "registry_status": { "const": "ready_for_hermes_mcp_capability_registry" },
        "stdio_transport_enabled": { "const": true },
        "server_entrypoint_registered": { "const": true },
        "serve_script_registered": { "const": true },
        "server_started_during_check": { "const": false },
        "live_mcp_connection_opened_during_check": { "const": false },
        "stdout_jsonrpc_only": { "const": true },
        "resource_read_allowed_now": { "const": true },
        "tool_listing_allowed_now": { "const": true },
        "tool_call_returns_contract_only_now": { "const": false },
        "check_tool_adapter_enabled_now": { "const": true },
        "check_tool_subprocess_execution_allowed_now": { "const": true },
        "non_check_tool_subprocess_execution_allowed_now": { "const": false },
        "tool_subprocess_execution_allowed_now": { "const": false },
        "repo_write_allowed_now": { "const": false },
        "filesystem_write_allowed_now": { "const": false },
        "connector_write_allowed_now": { "const": false },
        "deployment_allowed_now": { "const": false },
        "protected_action_allowed_now": { "const": false },
        "receipt_application_allowed_now": { "const": false },
        "final_approval_allowed_now": { "const": false },
        "production_pass_allowed_now": { "const": false },
        "enterprise_trust_claim_allowed_now": { "const": false },
        "raw_secret_context_allowed": { "const": false },
        "raw_restricted_payload_allowed": { "const": false },
        "desktop_source_of_truth": { "const": false }
      }
    },
    "summary": {
      "type": "object",
      "required": [
        "hermes_mcp_readonly_server_status",
        "mcp_tranche",
        "mcp_mode",
        "protocol_version",
        "mcp_resource_count",
        "mcp_tool_count",
        "server_started_during_check",
        "check_tool_adapter_enabled_now",
        "check_tool_subprocess_execution_allowed_now",
        "non_check_tool_subprocess_execution_allowed_now",
        "tool_subprocess_execution_allowed_now",
        "repo_write_allowed_now",
        "filesystem_write_allowed_now",
        "connector_write_allowed_now",
        "deployment_allowed_now",
        "protected_action_allowed_now",
        "receipt_application_allowed_now",
        "final_approval_allowed_now",
        "production_pass_allowed_now",
        "enterprise_trust_claim_allowed_now",
        "raw_restricted_payload_allowed",
        "desktop_source_of_truth",
        "validation_error_count"
      ],
      "properties": {
        "hermes_mcp_readonly_server_status": { "const": "ready_for_hermes_mcp_check_tool_adapter" },
        "mcp_tranche": { "const": "H-MCP-03" },
        "mcp_mode": { "const": "stdio_check_only_tool_adapter" },
        "protocol_version": { "const": "2025-06-18" },
        "server_started_during_check": { "const": false },
        "check_tool_adapter_enabled_now": { "const": true },
        "check_tool_subprocess_execution_allowed_now": { "const": true },
        "non_check_tool_subprocess_execution_allowed_now": { "const": false },
        "tool_subprocess_execution_allowed_now": { "const": false },
        "repo_write_allowed_now": { "const": false },
        "filesystem_write_allowed_now": { "const": false },
        "connector_write_allowed_now": { "const": false },
        "deployment_allowed_now": { "const": false },
        "protected_action_allowed_now": { "const": false },
        "receipt_application_allowed_now": { "const": false },
        "final_approval_allowed_now": { "const": false },
        "production_pass_allowed_now": { "const": false },
        "enterprise_trust_claim_allowed_now": { "const": false },
        "raw_restricted_payload_allowed": { "const": false },
        "desktop_source_of_truth": { "const": false },
        "validation_error_count": { "const": 0 }
      }
    }
