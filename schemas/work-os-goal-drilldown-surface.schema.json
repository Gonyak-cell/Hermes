    "schema_version": { "const": "work-os-goal-drilldown-surface.v1" },
    "capability_id": { "const": "platform.work_os_goal_drilldown_surface" },
    "program_range": { "const": "P9201-P9400" },
    "source_program_range": { "const": "P9001-P9200" },
    "work_os_goal_drilldown_contract": {
      "type": "object",
      "required": [
        "program_range",
        "source_program_range",
        "source_ready_status_required",
        "api_get_head_only",
        "api_write_methods_enabled",
        "raw_transcript_body_visible",
        "secret_keys_returned",
        "domain_pack_as_product_allowed",
        "human_gate_completion_enabled",
        "codex_final_approval_allowed",
        "claude_final_approval_allowed",
        "reviewer_mutation_allowed",
        "single_owner_enterprise_trust_allowed",
        "protected_closeout_enabled",
        "production_pass_enabled",
        "enterprise_pass_enabled",
        "runtime_execution_enabled",
        "write_action_enabled",
        "external_connector_write_enabled",
        "ui_git_write_enabled"
      ],
      "properties": {
        "program_range": { "const": "P9201-P9400" },
        "source_program_range": { "const": "P9001-P9200" },
        "source_ready_status_required": { "const": "ready_for_work_os_goal_execution_view" },
        "api_get_head_only": { "const": true },
        "api_write_methods_enabled": { "const": false },
        "raw_transcript_body_visible": { "const": false },
        "secret_keys_returned": { "const": false },
        "domain_pack_as_product_allowed": { "const": false },
        "human_gate_completion_enabled": { "const": false },
        "codex_final_approval_allowed": { "const": false },
        "claude_final_approval_allowed": { "const": false },
        "reviewer_mutation_allowed": { "const": false },
        "single_owner_enterprise_trust_allowed": { "const": false },
        "protected_closeout_enabled": { "const": false },
        "production_pass_enabled": { "const": false },
        "enterprise_pass_enabled": { "const": false },
        "runtime_execution_enabled": { "const": false },
        "write_action_enabled": { "const": false },
        "external_connector_write_enabled": { "const": false },
        "ui_git_write_enabled": { "const": false }
      },
      "additionalProperties": true
    },
    "work_os_goal_drilldown_phase_rows": { "type": "array", "minItems": 10, "items": { "$ref": "#/$defs/row" } },
    "p9200_source_binding_rows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "allOf": [
          { "$ref": "#/$defs/row" },
          {
            "type": "object",
            "required": ["source_program_range", "source_ready_for_p9201", "read_only", "mutates_source"],
            "properties": {
              "source_program_range": { "const": "P9001-P9200" },
              "source_ready_for_p9201": { "const": true },
              "read_only": { "const": true },
              "mutates_source": { "const": false }
            },
            "additionalProperties": true
          }
        ]
      }
    },
    "drilldown_api_route_rows": {
      "type": "array",
      "minItems": 9,
      "items": {
        "allOf": [
          { "$ref": "#/$defs/row" },
          {
            "type": "object",
            "required": [
              "api_path",
              "method_allowlist",
              "read_only",
              "write_methods_enabled",
              "mutates_state",
              "protected_action_enabled",
              "raw_transcript_body_visible",
              "secret_keys_returned"
            ],
            "properties": {
              "method_allowlist": { "type": "array", "contains": { "const": "GET" } },
              "read_only": { "const": true },
              "write_methods_enabled": { "const": false },
              "mutates_state": { "const": false },
              "protected_action_enabled": { "const": false },
              "raw_transcript_body_visible": { "const": false },
              "secret_keys_returned": { "const": false }
            },
            "additionalProperties": true
          }
        ]
      }
    },
    "drilldown_ui_binding_rows": {
      "type": "array",
      "minItems": 7,
      "items": {
        "allOf": [
          { "$ref": "#/$defs/row" },
          {
            "type": "object",
            "required": [
              "surface_id",
              "consumes_api_path",
              "binding_mode",
              "read_only",
              "raw_transcript_body_visible",
              "secret_embedded",
              "protected_action_controls_enabled",
              "git_write_controls_enabled",
              "mutation_allowed"
