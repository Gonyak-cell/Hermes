{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/matter-task-board.schema.json",
  "title": "Hermes Matter Task Board",
  "type": "object",
  "required": [
    "schema_version",
    "generated_at",
    "matter_task_board_id",
    "matter_task_board_status",
    "safe_handling",
    "inputs",
    "source_contracts",
    "matter_task_board_contract",
    "task_records",
    "board_columns",
    "workflow_bindings",
    "matter_task_board_desktop_boundary",
    "matter_task_board_checkpoints",
    "validation_items",
    "validation",
    "summary"
  ],
  "properties": {
    "schema_version": { "const": "matter-task-board.v1" },
    "generated_at": { "type": "string", "minLength": 1 },
    "matter_task_board_id": { "type": "string", "minLength": 1 },
    "output_dir": { "type": "string" },
    "matter_task_board_status": { "enum": ["complete", "blocked"] },
    "safe_handling": { "$ref": "#/$defs/safe_handling" },
    "inputs": { "type": "object" },
    "source_contracts": { "type": "object" },
    "matter_task_board_contract": { "$ref": "#/$defs/contract" },
    "task_records": { "type": "array", "items": { "$ref": "#/$defs/task_record" } },
    "board_columns": { "type": "array", "items": { "$ref": "#/$defs/board_column" } },
    "workflow_bindings": { "type": "array", "items": { "$ref": "#/$defs/workflow_binding" } },
    "matter_task_board_desktop_boundary": { "$ref": "#/$defs/desktop_boundary" },
    "matter_task_board_checkpoints": { "type": "array", "items": { "$ref": "#/$defs/checkpoint" } },
    "validation_items": { "type": "array", "items": { "$ref": "#/$defs/validation_item" } },
    "validation": { "$ref": "#/$defs/validation" },
    "summary": { "$ref": "#/$defs/summary" }
  },
  "$defs": {
    "safe_handling": {
      "type": "object",
      "required": [
        "report_only",
        "legal_advice_provided",
        "client_facing_output_generated",
        "attorney_review_required",
        "human_review_required",
        "matter_data_write_allowed",
        "task_state_write_allowed",
        "workflow_transition_allowed",
        "runtime_execution_performed",
        "delivery_execution_performed",
        "desktop_mutation_allowed",
        "desktop_source_of_truth",
        "protected_mutation_executed",
        "secret_material_exposed",
        "provider_key_visible"
      ],
      "properties": {
        "report_only": { "const": true },
        "legal_advice_provided": { "const": false },
        "client_facing_output_generated": { "const": false },
        "attorney_review_required": { "const": true },
        "human_review_required": { "const": true },
        "matter_data_write_allowed": { "const": false },
        "task_state_write_allowed": { "const": false },
        "workflow_transition_allowed": { "const": false },
        "runtime_execution_performed": { "const": false },
        "delivery_execution_performed": { "const": false },
        "desktop_mutation_allowed": { "const": false },
        "desktop_source_of_truth": { "const": false },
        "protected_mutation_executed": { "const": false },
        "secret_material_exposed": { "const": false },
        "provider_key_visible": { "const": false }
      }
    },
    "contract": {
      "type": "object",
      "required": [
        "schema_version",
        "contract_id",
        "source_of_truth",
        "task_board_rule",
        "workflow_binding_rule",
        "matter_boundary_rule",
        "attorney_review_rule",
        "desktop_companion_rule",
        "mutation_policy",
        "created_at"
      ],
      "properties": {
        "schema_version": { "const": "matter-task-board-contract.v1" },
        "contract_id": { "const": "matter-task-board.v1" },
        "source_of_truth": { "const": "matter_files_timeline_document_index_and_workflow_artifacts" },
        "task_board_rule": { "type": "string" },
        "workflow_binding_rule": { "type": "string" },
        "matter_boundary_rule": { "type": "string" },
        "attorney_review_rule": { "type": "string" },
        "desktop_companion_rule": { "type": "string" },
        "mutation_policy": { "type": "string" },
        "created_at": { "type": "string" }
      }
    },
    "task_record": {
      "type": "object",
      "required": [
        "schema_version",
        "task_id",
        "matter_id",
        "task_category",
        "task_title",
        "task_owner",
        "due_date",
        "due_status",
        "task_status",
        "task_column_id",
        "source_kind",
        "source_id",
        "source_record_id",
        "workflow_binding_id",
        "workflow_binding_status",
        "review_status",
        "attorney_review_required",
        "human_review_required",
        "legal_advice_provided",
        "client_facing_output_generated",
        "default_output_status",
        "created_at",
        "sequence_number",
        "sort_key"
      ],
      "properties": {
        "schema_version": { "const": "matter-task-record.v1" },
        "task_id": { "type": "string", "minLength": 1 },
        "matter_id": { "type": "string", "minLength": 1 },
        "task_category": { "type": "string", "minLength": 1 },
        "task_title": { "type": "string", "minLength": 1 },
        "task_owner": { "type": "string", "minLength": 1 },
        "due_date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "due_status": { "enum": ["overdue", "due_today", "due_soon", "upcoming"] },
        "task_status": { "type": "string", "minLength": 1 },
        "task_column_id": { "enum": ["blocked", "open", "pending", "in_review", "monitoring", "complete"] },
        "source_kind": { "type": "string", "minLength": 1 },
        "source_id": { "type": "string", "minLength": 1 },
        "source_path": { "type": ["string", "null"] },
        "source_record_id": { "type": "string", "minLength": 1 },
        "source_label": { "type": ["string", "null"] },
        "timeline_event_id": { "type": ["string", "null"] },
        "document_record_id": { "type": ["string", "null"] },
        "workflow_binding_id": { "type": "string", "minLength": 1 },
        "workflow_binding_status": { "const": "bound" },
        "workflow_run_id": { "type": ["string", "null"] },
        "workflow_id": { "type": "string", "minLength": 1 },
        "capability_id": { "type": "string", "minLength": 1 },
        "review_status": { "type": "string", "minLength": 1 },
        "attorney_review_required": { "const": true },
        "human_review_required": { "const": true },
        "legal_advice_provided": { "const": false },
        "client_facing_output_generated": { "const": false },
        "default_output_status": { "const": "pending_review" },
        "created_at": { "type": "string" },
        "sequence_number": { "type": "integer", "minimum": 1 },
        "sort_key": { "type": "string", "minLength": 1 },
        "metadata": { "type": "object" }
      }
    },
    "board_column": {
      "type": "object",
      "required": [
        "schema_version",
        "task_column_id",
        "label",
        "sequence_number",
        "status_values",
        "task_count",
        "task_ids",
        "read_only",
        "mutation_allowed",
        "created_at"
      ],
      "properties": {
        "schema_version": { "const": "matter-task-board-column.v1" },
        "task_column_id": { "enum": ["blocked", "open", "pending", "in_review", "monitoring", "complete"] },
        "label": { "type": "string" },
        "sequence_number": { "type": "integer", "minimum": 1 },
        "status_values": { "type": "array", "items": { "type": "string" } },
        "task_count": { "type": "integer", "minimum": 0 },
        "task_ids": { "type": "array", "items": { "type": "string" } },
        "owner_count": { "type": "integer", "minimum": 0 },
        "overdue_task_count": { "type": "integer", "minimum": 0 },
        "read_only": { "const": true },
        "mutation_allowed": { "const": false },
        "created_at": { "type": "string" }
      }
    },
    "workflow_binding": {
      "type": "object",
      "required": [
        "schema_version",
        "workflow_binding_id",
        "task_id",
        "matter_id",
        "task_category",
        "task_owner",
        "workflow_binding_status",
        "workflow_anchor_type",
        "workflow_id",
        "capability_id",
        "domain_pack",
        "human_review_required",
        "attorney_review_required",
        "protected_action_allowed",
        "runtime_execution_allowed",
        "delivery_execution_allowed",
        "created_at"
      ],
      "properties": {
        "schema_version": { "const": "matter-task-workflow-binding.v1" },
        "workflow_binding_id": { "type": "string", "minLength": 1 },
        "task_id": { "type": "string", "minLength": 1 },
        "task_title": { "type": ["string", "null"] },
        "matter_id": { "type": "string", "minLength": 1 },
        "task_category": { "type": "string", "minLength": 1 },
        "task_owner": { "type": "string", "minLength": 1 },
        "workflow_binding_status": { "const": "bound" },
        "workflow_anchor_type": { "enum": ["workflow_run", "matter_review_workflow"] },
        "workflow_run_id": { "type": ["string", "null"] },
        "workflow_id": { "type": "string", "minLength": 1 },
        "capability_id": { "type": "string", "minLength": 1 },
        "domain_pack": { "type": "string", "minLength": 1 },
        "workflow_status": { "type": "string", "minLength": 1 },
        "queue_status": { "type": "string", "minLength": 1 },
        "gate_status": { "type": "string", "minLength": 1 },
        "human_review_required": { "const": true },
        "attorney_review_required": { "const": true },
        "protected_action_allowed": { "const": false },
        "runtime_execution_allowed": { "const": false },
        "delivery_execution_allowed": { "const": false },
        "created_at": { "type": "string" }
      }
    },
    "desktop_boundary": {
      "type": "object",
      "required": [
        "schema_version",
        "boundary_status",
        "read_only",
        "mutation_allowed",
        "source_of_truth",
        "matter_data_write_allowed",
        "runtime_execution_allowed",
        "delivery_execution_allowed",
        "client_facing_output_allowed_without_attorney_review",
        "task_state_write_allowed",
        "workflow_transition_allowed",
        "protected_action_allowed",
        "created_at"
      ],
      "properties": {
        "schema_version": { "const": "matter-task-board-desktop-boundary.v1" },
        "boundary_status": { "const": "enforced" },
        "read_only": { "const": true },
        "mutation_allowed": { "const": false },
        "source_of_truth": { "const": false },
        "matter_data_write_allowed": { "const": false },
        "runtime_execution_allowed": { "const": false },
        "delivery_execution_allowed": { "const": false },
        "client_facing_output_allowed_without_attorney_review": { "const": false },
        "task_state_write_allowed": { "const": false },
        "workflow_transition_allowed": { "const": false },
        "protected_action_allowed": { "const": false },
        "created_at": { "type": "string" }
      }
    },
    "checkpoint": {
      "type": "object",
      "required": ["checkpoint_id", "checkpoint_status", "status", "message"],
      "properties": {
        "checkpoint_id": { "type": "string" },
        "checkpoint_status": { "enum": ["passed", "failed"] },
        "status": { "enum": ["passed", "failed"] },
        "message": { "type": "string" },
        "passed_count": { "type": "integer" },
        "expected_count": { "type": "integer" }
      }
    },
    "validation_item": {
      "type": "object",
      "required": ["path", "check_id", "status", "message"],
      "properties": {
        "path": { "type": "string" },
        "check_id": { "type": "string" },
        "status": { "enum": ["passed", "failed"] },
        "message": { "type": "string" },
        "passed_count": { "type": "integer" },
        "expected_count": { "type": "integer" }
      }
    },
    "validation": {
      "type": "object",
      "required": ["valid", "errors"],
      "properties": {
        "valid": { "type": "boolean" },
        "errors": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["path", "message", "status"],
            "properties": {
              "path": { "type": "string" },
              "message": { "type": "string" },
              "status": { "type": "string" }
            }
          }
        }
      }
    },
    "summary": {
      "type": "object",
      "required": [
        "matter_task_board_status",
        "matter_task_board_contract_id",
        "source_of_truth",
        "source_matter_document_index_status",
        "source_matter_timeline_status",
        "source_matter_os_profile_status",
        "source_workflow_run_dashboard_status",
        "source_output_catalog_status",
        "source_delivery_queue_status",
        "matter_file_count",
        "available_matter_file_count",
        "task_record_count",
        "board_column_count",
        "workflow_binding_count",
        "task_with_owner_count",
        "task_with_due_date_count",
        "task_with_status_count",
        "workflow_bound_task_count",
        "actual_workflow_run_bound_task_count",
        "timeline_bound_task_count",
        "document_bound_task_count",
        "matter_id_scoped_task_count",
        "attorney_review_required_task_count",
        "human_review_required_task_count",
        "legal_advice_provided",
        "client_facing_output_generated",
        "desktop_boundary_status",
        "desktop_read_only",
        "desktop_mutation_allowed",
        "desktop_source_of_truth",
        "matter_data_write_allowed",
        "runtime_execution_allowed",
        "delivery_execution_allowed",
        "task_state_write_allowed",
        "workflow_transition_allowed",
        "protected_action_allowed",
        "client_facing_output_allowed_without_attorney_review",
        "failed_checkpoint_count",
        "validation_item_count",
        "validation_error_count"
      ],
      "properties": {
        "matter_task_board_status": { "enum": ["complete", "blocked"] },
        "matter_task_board_contract_id": { "const": "matter-task-board.v1" },
        "source_of_truth": { "const": "matter_files_timeline_document_index_and_workflow_artifacts" },
        "source_matter_document_index_status": { "type": "string" },
        "source_matter_timeline_status": { "type": "string" },
        "source_matter_os_profile_status": { "type": "string" },
        "source_workflow_run_dashboard_status": { "type": "string" },
        "source_output_catalog_status": { "type": "string" },
        "source_delivery_queue_status": { "type": "string" },
        "matter_file_count": { "type": "integer", "minimum": 0 },
        "available_matter_file_count": { "type": "integer", "minimum": 0 },
        "task_record_count": { "type": "integer", "minimum": 0 },
        "board_column_count": { "type": "integer", "minimum": 0 },
        "workflow_binding_count": { "type": "integer", "minimum": 0 },
        "matter_task_count": { "type": "integer", "minimum": 0 },
        "matter_deadline_task_count": { "type": "integer", "minimum": 0 },
        "vdr_request_task_count": { "type": "integer", "minimum": 0 },
        "qa_item_task_count": { "type": "integer", "minimum": 0 },
        "cp_checklist_task_count": { "type": "integer", "minimum": 0 },
        "negotiation_point_task_count": { "type": "integer", "minimum": 0 },
        "litigation_task_count": { "type": "integer", "minimum": 0 },
        "output_review_task_count": { "type": "integer", "minimum": 0 },
        "blocked_task_count": { "type": "integer", "minimum": 0 },
        "open_task_count": { "type": "integer", "minimum": 0 },
        "in_review_task_count": { "type": "integer", "minimum": 0 },
        "overdue_task_count": { "type": "integer", "minimum": 0 },
        "due_today_task_count": { "type": "integer", "minimum": 0 },
        "due_soon_task_count": { "type": "integer", "minimum": 0 },
        "task_with_owner_count": { "type": "integer", "minimum": 0 },
        "task_with_due_date_count": { "type": "integer", "minimum": 0 },
        "task_with_status_count": { "type": "integer", "minimum": 0 },
        "workflow_bound_task_count": { "type": "integer", "minimum": 0 },
        "actual_workflow_run_bound_task_count": { "type": "integer", "minimum": 0 },
        "timeline_bound_task_count": { "type": "integer", "minimum": 0 },
        "document_bound_task_count": { "type": "integer", "minimum": 0 },
        "matter_id_scoped_task_count": { "type": "integer", "minimum": 0 },
        "attorney_review_required_task_count": { "type": "integer", "minimum": 0 },
        "human_review_required_task_count": { "type": "integer", "minimum": 0 },
        "legal_advice_provided": { "const": false },
        "client_facing_output_generated": { "const": false },
        "desktop_boundary_status": { "const": "enforced" },
        "desktop_read_only": { "const": true },
        "desktop_mutation_allowed": { "const": false },
        "desktop_source_of_truth": { "const": false },
        "matter_data_write_allowed": { "const": false },
        "runtime_execution_allowed": { "const": false },
        "delivery_execution_allowed": { "const": false },
        "task_state_write_allowed": { "const": false },
        "workflow_transition_allowed": { "const": false },
        "protected_action_allowed": { "const": false },
        "client_facing_output_allowed_without_attorney_review": { "const": false },
        "failed_checkpoint_count": { "type": "integer", "minimum": 0 },
        "validation_item_count": { "type": "integer", "minimum": 0 },
        "validation_error_count": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
