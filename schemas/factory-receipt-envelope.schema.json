{
  "$id": "https://hermes.local/schemas/factory-receipt-envelope.schema.json",
  "type": "object",
  "required": [
    "schema_version",
    "receipt_id",
    "receipt_kind",
    "issuer",
    "subject",
    "payload_sha256",
    "prev_entry_hash",
    "authority_flags"
  ],
  "additionalProperties": true,
  "properties": {
    "schema_version": { "const": "factory-receipt-envelope.v1" },
    "receipt_id": { "type": "string", "pattern": "^rcpt-[a-z0-9][a-z0-9._-]+$" },
    "receipt_kind": { "type": "string", "minLength": 1 },
    "issued_at": { "type": "string", "format": "date-time" },
    "issuer": {
      "type": "object",
      "required": ["issuer_role", "issuer_id"],
      "additionalProperties": false,
      "properties": {
        "issuer_role": {
          "type": "string",
          "enum": ["human_owner", "independent_reviewer", "codex_implementer", "validator", "system"]
        },
        "issuer_id": { "type": "string", "minLength": 1 },
        "engine_resolved_model_id": { "type": ["string", "null"] }
      }
    },
    "subject": {
      "type": "object",
      "required": ["product_id", "artifact_id", "scope_id"],
      "additionalProperties": true,
      "properties": {
        "product_id": { "type": "string", "pattern": "^product\\.[a-z0-9][a-z0-9._-]+$" },
        "artifact_id": { "type": "string", "pattern": "^artifact\\.[a-z0-9][a-z0-9._-]+$" },
        "scope_id": { "type": "string", "minLength": 1 },
        "bound_transition_payload_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "bound_candidate_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "bound_review_docket_row_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "reviewed_commit_sha": { "type": ["string", "null"], "pattern": "^[a-f0-9]{7,64}$" }
      }
    },
    "payload_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "prev_entry_hash": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
    "entry_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "authority_flags": {
      "type": "object",
      "required": [
        "project_creation_allowed_now",
        "review_decision_allowed_now",
        "approval_allowed_now",
        "apply_allowed_now",
        "apply_engine_runtime_enabled_now",
        "rollback_executor_runtime_enabled_now",
        "source_file_write_allowed_now",
        "ledger_append_allowed_now",
        "persistent_ledger_append_allowed_now",
        "repo_write_allowed_now",
        "connector_write_allowed_now",
        "deployment_allowed_now",
        "protected_action_allowed_now",
        "production_pass_enabled",
        "enterprise_pass_enabled"
      ],
      "additionalProperties": false,
      "properties": {
        "project_creation_allowed_now": { "const": false },
        "review_decision_allowed_now": { "const": false },
        "approval_allowed_now": { "const": false },
        "apply_allowed_now": { "const": false },
        "apply_engine_runtime_enabled_now": { "const": false },
        "rollback_executor_runtime_enabled_now": { "const": false },
        "source_file_write_allowed_now": { "const": false },
        "ledger_append_allowed_now": { "const": false },
        "persistent_ledger_append_allowed_now": { "const": false },
        "repo_write_allowed_now": { "const": false },
        "connector_write_allowed_now": { "const": false },
        "deployment_allowed_now": { "const": false },
        "protected_action_allowed_now": { "const": false },
        "production_pass_enabled": { "const": false },
        "enterprise_pass_enabled": { "const": false }
      }
    },
    "fd_receipt_verify": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "bound_candidate_sha256_required": { "const": true },
        "owner_attestation_required": { "const": true },
        "replay_nonce_required": { "const": true },
        "apply_engine_runtime_enabled_now": { "const": false },
        "rollback_executor_runtime_enabled_now": { "const": false },
        "apply_attempted_now": { "const": false },
        "rollback_attempted_now": { "const": false }
      }
    }
  }
}
