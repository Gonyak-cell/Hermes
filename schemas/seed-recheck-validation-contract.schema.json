{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hermes.local/schemas/seed-recheck-validation-contract.schema.json",
  "title": "Hermes Seed Recheck Validation Contract",
  "type": "object",
  "required": [
    "schema_version",
    "generated_at",
    "capability_id",
    "program_range",
    "source_program_range",
    "seed_recheck_validation_phase_rows",
    "p34000_source_binding_rows",
    "clarification_sufficiency_evidence_rows",
    "missing_answer_blocker_rule_rows",
    "seed_recheck_validator_candidate_rows",
    "no_fake_execution_gate_rows",
    "operator_seed_recheck_projection_rows",
    "seed_recheck_contract_wiring_rows",
    "p34400_clean_checkpoint_rows",
    "seed_recheck_validation_boundary",
    "seed_recheck_validation_items",
    "summary",
    "validation"
  ],
  "properties": {
    "schema_version": { "const": "seed-recheck-validation-contract.v1" },
    "generated_at": { "type": "string", "format": "date-time" },
    "capability_id": { "const": "platform.seed_recheck_validation_contract" },
    "program_range": { "const": "P34001-P34400" },
    "source_program_range": { "const": "P33601-P34000" },
    "seed_recheck_validation_phase_rows": { "type": "array", "minItems": 8, "items": { "$ref": "#/$defs/verdictRow" } },
    "p34000_source_binding_rows": { "type": "array", "minItems": 12, "items": { "$ref": "#/$defs/verdictRow" } },
    "clarification_sufficiency_evidence_rows": { "type": "array", "minItems": 3, "items": { "$ref": "#/$defs/verdictRow" } },
    "missing_answer_blocker_rule_rows": { "type": "array", "minItems": 12, "items": { "$ref": "#/$defs/verdictRow" } },
    "seed_recheck_validator_candidate_rows": { "type": "array", "minItems": 3, "items": { "$ref": "#/$defs/verdictRow" } },
    "no_fake_execution_gate_rows": { "type": "array", "minItems": 340, "items": { "$ref": "#/$defs/verdictRow" } },
    "operator_seed_recheck_projection_rows": { "type": "array", "minItems": 3, "items": { "$ref": "#/$defs/verdictRow" } },
    "seed_recheck_contract_wiring_rows": { "type": "array", "minItems": 5, "items": { "$ref": "#/$defs/verdictRow" } },
    "p34400_clean_checkpoint_rows": { "type": "array", "minItems": 10, "items": { "$ref": "#/$defs/verdictRow" } },
    "seed_recheck_validation_items": { "type": "array", "minItems": 14, "items": { "$ref": "#/$defs/validationItem" } },
    "summary": {
      "type": "object",
      "required": [
        "seed_recheck_validation_status",
        "source_p34000_ready_for_seed_recheck_validation",
        "clarification_sufficiency_evidence_count",
        "missing_answer_blocker_rule_count",
        "seed_recheck_validator_candidate_count",
        "operator_projection_count",
        "sufficiency_auto_pass_allowed_count",
        "seed_recheck_execution_allowed_count",
        "seed_recheck_pass_allowed_count",
        "ready_for_commercial_spec_readiness_handoff",
        "seed_recheck_sufficiency_auto_pass_allowed_now",
        "seed_recheck_execution_allowed_now",
        "seed_recheck_verification_pass_allowed_now",
        "seed_recheck_seed_unblock_allowed_now",
        "seed_recheck_final_seed_allowed_now",
        "seed_recheck_runtime_execution_allowed_now",
        "seed_recheck_write_action_allowed_now",
        "seed_recheck_protected_action_allowed_now",
        "seed_recheck_final_approval_allowed_now",
        "seed_recheck_production_pass_allowed_now",
        "production_pass_enabled"
      ],
      "properties": {
        "seed_recheck_validation_status": {
          "enum": [
            "ready_for_seed_recheck_validation_contract",
            "valid_block_seed_recheck_validation_contract_pending",
            "blocked_seed_recheck_validation_contract"
          ]
        },
        "source_p34000_ready_for_seed_recheck_validation": { "type": "boolean" },
        "clarification_sufficiency_evidence_count": { "type": "number" },
        "missing_answer_blocker_rule_count": { "type": "number" },
        "seed_recheck_validator_candidate_count": { "type": "number" },
        "operator_projection_count": { "type": "number" },
        "sufficiency_auto_pass_allowed_count": { "const": 0 },
        "seed_recheck_execution_allowed_count": { "const": 0 },
        "seed_recheck_pass_allowed_count": { "const": 0 },
        "ready_for_commercial_spec_readiness_handoff": { "type": "boolean" },
        "seed_recheck_sufficiency_auto_pass_allowed_now": { "const": false },
        "seed_recheck_execution_allowed_now": { "const": false },
        "seed_recheck_verification_pass_allowed_now": { "const": false },
        "seed_recheck_seed_unblock_allowed_now": { "const": false },
        "seed_recheck_final_seed_allowed_now": { "const": false },
        "seed_recheck_runtime_execution_allowed_now": { "const": false },
        "seed_recheck_write_action_allowed_now": { "const": false },
        "seed_recheck_protected_action_allowed_now": { "const": false },
        "seed_recheck_final_approval_allowed_now": { "const": false },
        "seed_recheck_production_pass_allowed_now": { "const": false },
        "production_pass_enabled": { "const": false },
        "enterprise_trust_claim_allowed_now": { "const": false },
        "validation_error_count": { "type": "number" }
      }
    },
    "seed_recheck_validation_boundary": {
      "type": "object",
      "required": [
        "p34400_contract_ready",
        "ready_for_commercial_spec_readiness_handoff",
        "source_p34000_ready_for_seed_recheck_validation",
        "clarification_sufficiency_evidence_visible_now",
        "missing_answer_blocker_rules_visible_now",
        "seed_recheck_validator_candidate_visible_now",
        "no_fake_execution_gate_closed_now",
        "operator_seed_recheck_projection_visible_now",
        "seed_recheck_contract_wiring_complete_now",
        "sufficiency_auto_pass_allowed_count",
        "seed_recheck_execution_allowed_count",
        "seed_recheck_pass_allowed_count",
        "seed_recheck_sufficiency_auto_pass_allowed_now",
        "seed_recheck_execution_allowed_now",
        "seed_recheck_verification_pass_allowed_now",
        "seed_recheck_seed_unblock_allowed_now",
        "seed_recheck_final_seed_allowed_now",
        "seed_recheck_runtime_execution_allowed_now",
        "seed_recheck_write_action_allowed_now",
        "seed_recheck_protected_action_allowed_now",
        "seed_recheck_final_approval_allowed_now",
        "seed_recheck_production_pass_allowed_now"
      ],
      "properties": {
        "p34400_contract_ready": { "type": "boolean" },
        "ready_for_commercial_spec_readiness_handoff": { "type": "boolean" },
        "source_p34000_ready_for_seed_recheck_validation": { "type": "boolean" },
        "source_validation_valid_now": { "type": "boolean" },
        "clarification_sufficiency_evidence_visible_now": { "type": "boolean" },
        "missing_answer_blocker_rules_visible_now": { "type": "boolean" },
        "seed_recheck_validator_candidate_visible_now": { "type": "boolean" },
        "no_fake_execution_gate_closed_now": { "type": "boolean" },
        "operator_seed_recheck_projection_visible_now": { "type": "boolean" },
        "seed_recheck_contract_wiring_complete_now": { "type": "boolean" },
        "clarification_sufficiency_evidence_count": { "type": "number" },
        "missing_answer_blocker_rule_count": { "type": "number" },
        "seed_recheck_validator_candidate_count": { "type": "number" },
        "operator_projection_count": { "type": "number" },
        "sufficiency_auto_pass_allowed_count": { "const": 0 },
        "seed_recheck_execution_allowed_count": { "const": 0 },
        "seed_recheck_pass_allowed_count": { "const": 0 },
        "seed_recheck_sufficiency_auto_pass_allowed_now": { "const": false },
        "seed_recheck_execution_allowed_now": { "const": false },
        "seed_recheck_verification_pass_allowed_now": { "const": false },
        "seed_recheck_seed_unblock_allowed_now": { "const": false },
        "seed_recheck_final_seed_allowed_now": { "const": false },
        "seed_recheck_runtime_execution_allowed_now": { "const": false },
        "seed_recheck_write_action_allowed_now": { "const": false },
        "seed_recheck_protected_action_allowed_now": { "const": false },
        "seed_recheck_connector_write_allowed_now": { "const": false },
        "seed_recheck_deployment_allowed_now": { "const": false },
        "seed_recheck_review_completion_allowed_now": { "const": false },
        "seed_recheck_final_approval_allowed_now": { "const": false },
        "seed_recheck_production_pass_allowed_now": { "const": false },
        "seed_recheck_enterprise_trust_claim_allowed_now": { "const": false },
        "seed_recheck_secret_read_allowed_now": { "const": false },
        "seed_recheck_human_gate_bypass_allowed_now": { "const": false },
        "seed_recheck_independent_review_bypass_allowed_now": { "const": false },
        "seed_recheck_final_automated_approval_allowed_now": { "const": false },
        "production_pass_enabled": { "const": false },
        "enterprise_trust_claim_allowed_now": { "const": false }
      }
    },
    "validation": {
      "type": "object",
      "required": ["valid", "error_count", "errors"],
      "properties": {
        "valid": { "type": "boolean" },
        "error_count": { "type": "number" },
        "errors": { "type": "array" }
      }
    }
  },
  "$defs": {
    "verdictRow": {
      "type": "object",
      "required": ["row_id", "category", "label", "observed", "current_verdict", "block_reason", "evidence_ref"],
      "properties": {
        "row_id": { "type": "string" },
        "category": { "type": "string" },
        "label": { "type": "string" },
        "observed": { "type": "boolean" },
        "current_verdict": { "enum": ["pass", "block"] },
        "block_reason": { "type": ["string", "null"] },
        "evidence_ref": { "type": ["string", "null"] },
        "generated_at": { "type": "string" }
      },
      "additionalProperties": true
    },
    "validationItem": {
      "allOf": [{ "$ref": "#/$defs/verdictRow" }]
    }
  }
}
