{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hermes.local/schemas/execution-write-authority-maturity.schema.json",
  "title": "Hermes Execution Write Authority Maturity",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "capability_id",
    "program_range",
    "source_program_range",
    "execution_write_authority_contract",
    "execution_write_authority_phase_rows",
    "execution_authority_source_binding_rows",
    "action_class_registry_rows",
    "receipt_gated_candidate_lane_rows",
    "command_allowlist_policy_rows",
    "write_scope_policy_rows",
    "rollback_recovery_binding_rows",
    "post_action_validation_rows",
    "claude_execution_write_authority_review_rows",
    "authority_read_only_projection_rows",
    "execution_write_authority_guard_rows",
    "p16200_freeze_rows",
    "execution_write_authority_boundary",
    "execution_write_authority_validation_items",
    "validation",
    "summary"
  ],
  "properties": {
    "schema_version": { "const": "execution-write-authority-maturity.v1" },
    "capability_id": { "const": "platform.execution_write_authority_maturity" },
    "program_range": { "const": "P15801-P16200" },
    "source_program_range": { "const": "P15401-P15800" },
    "execution_write_authority_phase_rows": { "type": "array", "minItems": 10, "items": { "$ref": "#/$defs/verdictRow" } },
    "execution_authority_source_binding_rows": { "type": "array", "minItems": 9, "items": { "$ref": "#/$defs/verdictRow" } },
    "action_class_registry_rows": { "type": "array", "minItems": 6, "items": { "$ref": "#/$defs/verdictRow" } },
    "receipt_gated_candidate_lane_rows": { "type": "array", "minItems": 6, "items": { "$ref": "#/$defs/verdictRow" } },
    "command_allowlist_policy_rows": { "type": "array", "minItems": 6, "items": { "$ref": "#/$defs/verdictRow" } },
    "write_scope_policy_rows": { "type": "array", "minItems": 6, "items": { "$ref": "#/$defs/verdictRow" } },
    "rollback_recovery_binding_rows": { "type": "array", "minItems": 6, "items": { "$ref": "#/$defs/verdictRow" } },
    "post_action_validation_rows": { "type": "array", "minItems": 6, "items": { "$ref": "#/$defs/verdictRow" } },
    "claude_execution_write_authority_review_rows": { "type": "array", "minItems": 5, "items": { "$ref": "#/$defs/verdictRow" } },
    "authority_read_only_projection_rows": { "type": "array", "minItems": 6, "items": { "$ref": "#/$defs/verdictRow" } },
    "execution_write_authority_guard_rows": { "type": "array", "minItems": 8, "items": { "$ref": "#/$defs/verdictRow" } },
    "p16200_freeze_rows": { "type": "array", "minItems": 12, "items": { "$ref": "#/$defs/verdictRow" } },
    "execution_write_authority_boundary": {
      "type": "object",
      "required": [
        "source_connector_governance_available",
        "source_ready_for_p15801_handoff",
        "source_block_visible_now",
        "action_class_registry_ready",
        "receipt_gated_candidate_lane_ready",
        "command_allowlist_policy_ready",
        "write_scope_policy_ready",
        "rollback_recovery_binding_ready",
        "post_action_validation_ready",
        "claude_execution_write_authority_review_receipt_present_now",
        "claude_execution_write_authority_review_block_visible_now",
        "authority_read_only_projection_ready",
        "execution_write_authority_guard_ready",
        "p16200_execution_write_authority_freeze_ready",
        "ready_for_p16201_handoff",
        "receipt_application_allowed_now",
        "candidate_execution_allowed_now",
        "command_execution_allowed_now",
        "runtime_execution_allowed_now",
        "direct_file_write_allowed_now",
        "patch_apply_allowed_now",
        "protected_action_allowed_now",
        "connector_write_enabled",
        "external_service_mutation_allowed_now",
        "deployment_allowed_now",
        "secret_read_allowed_now",
        "raw_source_exposure_allowed",
        "production_pass_enabled",
        "enterprise_pass_enabled",
        "enterprise_trust_claim_allowed_now",
        "protected_closeout_enabled",
        "release_approval_allowed_now",
        "write_action_allowed_now",
        "final_approval_ui_enabled",
        "codex_final_approval_ui_enabled",
        "claude_final_approval_ui_enabled",
        "unsafe_flag_count"
      ],
      "properties": {
        "source_connector_governance_available": { "type": "boolean" },
        "source_ready_for_p15801_handoff": { "type": "boolean" },
        "source_block_visible_now": { "type": "boolean" },
        "action_class_registry_ready": { "type": "boolean" },
        "receipt_gated_candidate_lane_ready": { "type": "boolean" },
        "command_allowlist_policy_ready": { "type": "boolean" },
        "write_scope_policy_ready": { "type": "boolean" },
        "rollback_recovery_binding_ready": { "type": "boolean" },
        "post_action_validation_ready": { "type": "boolean" },
        "claude_execution_write_authority_review_receipt_present_now": { "type": "boolean" },
        "claude_execution_write_authority_review_block_visible_now": { "type": "boolean" },
        "authority_read_only_projection_ready": { "type": "boolean" },
        "execution_write_authority_guard_ready": { "type": "boolean" },
        "p16200_execution_write_authority_freeze_ready": { "type": "boolean" },
        "ready_for_p16201_handoff": { "type": "boolean" },
        "receipt_application_allowed_now": { "const": false },
        "candidate_execution_allowed_now": { "const": false },
        "command_execution_allowed_now": { "const": false },
        "runtime_execution_allowed_now": { "const": false },
        "direct_file_write_allowed_now": { "const": false },
        "patch_apply_allowed_now": { "const": false },
        "protected_action_allowed_now": { "const": false },
        "connector_write_enabled": { "const": false },
        "external_service_mutation_allowed_now": { "const": false },
        "deployment_allowed_now": { "const": false },
        "secret_read_allowed_now": { "const": false },
        "raw_source_exposure_allowed": { "const": false },
        "production_pass_enabled": { "const": false },
        "enterprise_pass_enabled": { "const": false },
        "enterprise_trust_claim_allowed_now": { "const": false },
        "protected_closeout_enabled": { "const": false },
        "release_approval_allowed_now": { "const": false },
        "write_action_allowed_now": { "const": false },
        "final_approval_ui_enabled": { "const": false },
        "codex_final_approval_ui_enabled": { "const": false },
        "claude_final_approval_ui_enabled": { "const": false },
        "unsafe_flag_count": { "const": 0 }
      }
    },
    "validation": {
      "type": "object",
      "required": ["valid", "error_count", "errors"],
      "properties": {
        "valid": { "type": "boolean" },
        "error_count": { "type": "integer", "minimum": 0 },
        "errors": { "type": "array" }
      }
    },
    "summary": {
      "type": "object",
      "required": [
        "execution_write_authority_maturity_status",
        "program_range",
        "source_ready_for_p15801_handoff",
        "source_block_visible_now",
        "action_class_registry_row_count",
        "receipt_gated_candidate_lane_row_count",
        "command_allowlist_policy_row_count",
        "write_scope_policy_row_count",
        "rollback_recovery_binding_row_count",
        "post_action_validation_row_count",
        "claude_execution_write_authority_review_receipt_present_now",
        "claude_execution_write_authority_review_block_visible_now",
        "authority_read_only_projection_row_count",
        "p16200_execution_write_authority_freeze_ready",
        "ready_for_p16201_handoff",
        "receipt_application_allowed_now",
        "candidate_execution_allowed_now",
        "command_execution_allowed_now",
        "runtime_execution_allowed_now",
        "direct_file_write_allowed_now",
        "patch_apply_allowed_now",
        "write_action_allowed_now",
        "production_pass_enabled",
        "enterprise_trust_claim_allowed_now",
        "validation_error_count"
      ],
      "properties": {
        "execution_write_authority_maturity_status": {
          "enum": ["ready_for_execution_write_authority_maturity", "blocked_execution_write_authority_maturity"]
        },
        "program_range": { "const": "P15801-P16200" },
        "action_class_registry_row_count": { "type": "integer", "minimum": 6 },
        "receipt_gated_candidate_lane_row_count": { "type": "integer", "minimum": 6 },
        "command_allowlist_policy_row_count": { "type": "integer", "minimum": 6 },
        "write_scope_policy_row_count": { "type": "integer", "minimum": 6 },
        "rollback_recovery_binding_row_count": { "type": "integer", "minimum": 6 },
        "post_action_validation_row_count": { "type": "integer", "minimum": 6 },
        "authority_read_only_projection_row_count": { "type": "integer", "minimum": 6 },
        "receipt_application_allowed_now": { "const": false },
        "candidate_execution_allowed_now": { "const": false },
        "command_execution_allowed_now": { "const": false },
        "runtime_execution_allowed_now": { "const": false },
        "direct_file_write_allowed_now": { "const": false },
        "patch_apply_allowed_now": { "const": false },
        "write_action_allowed_now": { "const": false },
        "production_pass_enabled": { "const": false },
        "enterprise_trust_claim_allowed_now": { "const": false }
      }
    }
  },
  "$defs": {
    "verdictRow": {
      "type": "object",
      "required": ["row_id", "category", "label", "required", "observed", "evidence_ref", "current_verdict"],
      "properties": {
        "row_id": { "type": "string", "minLength": 1 },
        "category": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "required": { "type": "boolean" },
        "observed": { "type": "boolean" },
        "evidence_ref": { "type": "string", "minLength": 1 },
        "current_verdict": { "enum": ["pass", "blocked"] },
        "block_reason": { "type": ["string", "null"] }
      }
    }
  }
}
