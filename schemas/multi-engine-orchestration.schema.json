{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hermes.local/schemas/multi-engine-orchestration.schema.json",
  "title": "Hermes Multi-Engine Orchestration",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "capability_id",
    "program_range",
    "source_program_range",
    "multi_engine_contract",
    "multi_engine_phase_rows",
    "multi_engine_source_binding_rows",
    "engine_registry_rows",
    "role_authority_matrix_rows",
    "routing_decision_contract_rows",
    "evidence_class_mapping_rows",
    "cross_engine_conflict_guard_rows",
    "claude_orchestration_review_rows",
    "multi_engine_projection_rows",
    "orchestration_authority_guard_rows",
    "p15000_freeze_rows",
    "multi_engine_boundary",
    "multi_engine_validation_items",
    "validation",
    "summary"
  ],
  "properties": {
    "schema_version": { "const": "multi-engine-orchestration.v1" },
    "capability_id": { "const": "platform.multi_engine_orchestration" },
    "program_range": { "const": "P14601-P15000" },
    "source_program_range": { "const": "P14201-P14600" },
    "multi_engine_phase_rows": { "type": "array", "minItems": 10, "items": { "$ref": "#/$defs/verdictRow" } },
    "multi_engine_source_binding_rows": { "type": "array", "minItems": 8, "items": { "$ref": "#/$defs/verdictRow" } },
    "engine_registry_rows": { "type": "array", "minItems": 6, "items": { "$ref": "#/$defs/verdictRow" } },
    "role_authority_matrix_rows": { "type": "array", "minItems": 6, "items": { "$ref": "#/$defs/verdictRow" } },
    "routing_decision_contract_rows": { "type": "array", "minItems": 6, "items": { "$ref": "#/$defs/verdictRow" } },
    "evidence_class_mapping_rows": { "type": "array", "minItems": 6, "items": { "$ref": "#/$defs/verdictRow" } },
    "cross_engine_conflict_guard_rows": { "type": "array", "minItems": 6, "items": { "$ref": "#/$defs/verdictRow" } },
    "claude_orchestration_review_rows": { "type": "array", "minItems": 5, "items": { "$ref": "#/$defs/verdictRow" } },
    "multi_engine_projection_rows": { "type": "array", "minItems": 6, "items": { "$ref": "#/$defs/verdictRow" } },
    "orchestration_authority_guard_rows": { "type": "array", "minItems": 10, "items": { "$ref": "#/$defs/verdictRow" } },
    "p15000_freeze_rows": { "type": "array", "minItems": 12, "items": { "$ref": "#/$defs/verdictRow" } },
    "multi_engine_boundary": {
      "type": "object",
      "required": [
        "source_security_compliance_available",
        "source_ready_for_p14601_handoff",
        "source_block_visible_now",
        "engine_registry_ready",
        "role_authority_matrix_ready",
        "routing_decision_contract_ready",
        "evidence_class_mapping_ready",
        "cross_engine_conflict_guard_ready",
        "claude_orchestration_review_receipt_present_now",
        "claude_orchestration_review_block_visible_now",
        "multi_engine_projection_ready",
        "orchestration_authority_guard_ready",
        "p15000_multi_engine_freeze_ready",
        "ready_for_p15001_handoff",
        "cross_engine_final_approval_allowed_now",
        "self_review_approval_allowed_now",
        "reviewer_mutation_allowed_now",
        "ci_authority_escalation_allowed_now",
        "local_advisory_final_approval_allowed_now",
        "protected_action_routing_allowed_now",
        "engine_execution_allowed_now",
        "raw_transcript_exposure_allowed",
        "raw_source_exposure_allowed",
        "enterprise_trust_claim_allowed_now",
        "production_pass_enabled",
        "enterprise_pass_enabled",
        "protected_closeout_enabled",
        "deployment_allowed_now",
        "release_approval_allowed_now",
        "write_action_allowed_now",
        "protected_action_allowed_now",
        "connector_write_enabled",
        "runtime_execution_allowed_now",
        "final_approval_ui_enabled",
        "codex_final_approval_ui_enabled",
        "claude_final_approval_ui_enabled",
        "unsafe_flag_count"
      ],
      "properties": {
        "source_security_compliance_available": { "type": "boolean" },
        "source_ready_for_p14601_handoff": { "type": "boolean" },
        "source_block_visible_now": { "type": "boolean" },
        "engine_registry_ready": { "type": "boolean" },
        "role_authority_matrix_ready": { "type": "boolean" },
        "routing_decision_contract_ready": { "type": "boolean" },
        "evidence_class_mapping_ready": { "type": "boolean" },
        "cross_engine_conflict_guard_ready": { "type": "boolean" },
        "claude_orchestration_review_receipt_present_now": { "type": "boolean" },
        "claude_orchestration_review_block_visible_now": { "type": "boolean" },
        "multi_engine_projection_ready": { "type": "boolean" },
        "orchestration_authority_guard_ready": { "type": "boolean" },
        "p15000_multi_engine_freeze_ready": { "type": "boolean" },
        "ready_for_p15001_handoff": { "type": "boolean" },
        "cross_engine_final_approval_allowed_now": { "const": false },
        "self_review_approval_allowed_now": { "const": false },
        "reviewer_mutation_allowed_now": { "const": false },
        "ci_authority_escalation_allowed_now": { "const": false },
        "local_advisory_final_approval_allowed_now": { "const": false },
        "protected_action_routing_allowed_now": { "const": false },
        "engine_execution_allowed_now": { "const": false },
        "raw_transcript_exposure_allowed": { "const": false },
        "raw_source_exposure_allowed": { "const": false },
        "enterprise_trust_claim_allowed_now": { "const": false },
        "production_pass_enabled": { "const": false },
        "enterprise_pass_enabled": { "const": false },
        "protected_closeout_enabled": { "const": false },
        "deployment_allowed_now": { "const": false },
        "release_approval_allowed_now": { "const": false },
        "write_action_allowed_now": { "const": false },
        "protected_action_allowed_now": { "const": false },
        "connector_write_enabled": { "const": false },
        "runtime_execution_allowed_now": { "const": false },
        "final_approval_ui_enabled": { "const": false },
        "codex_final_approval_ui_enabled": { "const": false },
        "claude_final_approval_ui_enabled": { "const": false },
        "unsafe_flag_count": { "const": 0 }
      }
    },
    "validation": {
      "type": "object",
      "required": ["valid", "error_count", "errors"],
      "properties": {
        "valid": { "type": "boolean" },
        "error_count": { "type": "integer", "minimum": 0 },
        "errors": { "type": "array" }
      }
    },
    "summary": {
      "type": "object",
      "required": [
        "multi_engine_orchestration_status",
        "program_range",
        "source_ready_for_p14601_handoff",
        "source_block_visible_now",
        "engine_registry_row_count",
        "role_authority_matrix_row_count",
        "routing_decision_contract_row_count",
        "evidence_class_mapping_row_count",
        "cross_engine_conflict_guard_row_count",
        "claude_orchestration_review_receipt_present_now",
        "claude_orchestration_review_block_visible_now",
        "p15000_multi_engine_freeze_ready",
        "ready_for_p15001_handoff",
        "cross_engine_final_approval_allowed_now",
        "self_review_approval_allowed_now",
        "reviewer_mutation_allowed_now",
        "ci_authority_escalation_allowed_now",
        "engine_execution_allowed_now",
        "production_pass_enabled",
        "enterprise_trust_claim_allowed_now",
        "validation_error_count"
      ],
      "properties": {
        "multi_engine_orchestration_status": {
          "enum": ["ready_for_multi_engine_orchestration", "blocked_multi_engine_orchestration"]
        },
        "program_range": { "const": "P14601-P15000" },
        "engine_registry_row_count": { "type": "integer", "minimum": 6 },
        "role_authority_matrix_row_count": { "type": "integer", "minimum": 6 },
        "routing_decision_contract_row_count": { "type": "integer", "minimum": 6 },
        "evidence_class_mapping_row_count": { "type": "integer", "minimum": 6 },
        "cross_engine_conflict_guard_row_count": { "type": "integer", "minimum": 6 },
        "cross_engine_final_approval_allowed_now": { "const": false },
        "self_review_approval_allowed_now": { "const": false },
        "reviewer_mutation_allowed_now": { "const": false },
        "ci_authority_escalation_allowed_now": { "const": false },
        "engine_execution_allowed_now": { "const": false },
        "production_pass_enabled": { "const": false },
        "enterprise_trust_claim_allowed_now": { "const": false }
      }
    }
  },
  "$defs": {
    "verdictRow": {
      "type": "object",
      "required": ["row_id", "category", "label", "required", "observed", "evidence_ref", "current_verdict"],
      "properties": {
        "row_id": { "type": "string", "minLength": 1 },
        "category": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "required": { "type": "boolean" },
        "observed": { "type": "boolean" },
        "evidence_ref": { "type": "string", "minLength": 1 },
        "current_verdict": { "enum": ["pass", "blocked"] },
        "block_reason": { "type": ["string", "null"] }
      }
    }
  }
}
