{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hermes.local/schemas/freeze-evidence-activation.schema.json",
  "title": "Hermes Freeze Evidence Activation",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "capability_id",
    "program_range",
    "source_program_range",
    "freeze_activation_contract",
    "freeze_activation_phase_rows",
    "freeze_activation_source_recheck_rows",
    "freeze_evidence_packet_rows",
    "claude_review_receipt_intake_rows",
    "finding_loop_rows",
    "evidence_gap_projection_rows",
    "post_p16800_handoff_recheck_rows",
    "activation_operator_projection_rows",
    "activation_authority_guard_rows",
    "activation_closeout_packet_rows",
    "p17200_freeze_rows",
    "freeze_activation_boundary",
    "freeze_activation_validation_items",
    "validation",
    "summary"
  ],
  "properties": {
    "schema_version": { "const": "freeze-evidence-activation.v1" },
    "capability_id": { "const": "platform.freeze_evidence_activation" },
    "program_range": { "const": "P16801-P17200" },
    "source_program_range": { "const": "P16601-P16800" },
    "freeze_activation_phase_rows": { "type": "array", "minItems": 10, "items": { "$ref": "#/$defs/verdictRow" } },
    "freeze_activation_source_recheck_rows": { "type": "array", "minItems": 8, "items": { "$ref": "#/$defs/verdictRow" } },
    "freeze_evidence_packet_rows": { "type": "array", "minItems": 6, "items": { "$ref": "#/$defs/verdictRow" } },
    "claude_review_receipt_intake_rows": { "type": "array", "minItems": 6, "items": { "$ref": "#/$defs/verdictRow" } },
    "finding_loop_rows": { "type": "array", "minItems": 6, "items": { "$ref": "#/$defs/verdictRow" } },
    "evidence_gap_projection_rows": { "type": "array", "minItems": 6, "items": { "$ref": "#/$defs/verdictRow" } },
    "post_p16800_handoff_recheck_rows": { "type": "array", "minItems": 6, "items": { "$ref": "#/$defs/verdictRow" } },
    "activation_operator_projection_rows": { "type": "array", "minItems": 6, "items": { "$ref": "#/$defs/verdictRow" } },
    "activation_authority_guard_rows": { "type": "array", "minItems": 6, "items": { "$ref": "#/$defs/verdictRow" } },
    "activation_closeout_packet_rows": { "type": "array", "minItems": 6, "items": { "$ref": "#/$defs/verdictRow" } },
    "p17200_freeze_rows": { "type": "array", "minItems": 12, "items": { "$ref": "#/$defs/verdictRow" } },
    "freeze_activation_boundary": {
      "type": "object",
      "required": [
        "source_p16800_available",
        "source_p16800_structural_freeze_ready",
        "source_ready_for_post_p16800_handoff",
        "source_block_visible_now",
        "freeze_evidence_packet_ready",
        "claude_review_receipt_present_now",
        "claude_review_receipt_block_visible_now",
        "finding_loop_ready",
        "unresolved_finding_count",
        "evidence_gap_projection_ready",
        "post_p16800_handoff_recheck_ready",
        "activation_operator_projection_ready",
        "activation_authority_guard_ready",
        "activation_closeout_packet_ready",
        "p17200_freeze_activation_ready",
        "ready_for_p17201_handoff",
        "deployment_allowed_now",
        "release_approval_allowed_now",
        "production_pass_enabled",
        "enterprise_pass_enabled",
        "enterprise_trust_claim_allowed_now",
        "protected_closeout_enabled",
        "human_gate_bypass_allowed_now",
        "independent_review_bypass_allowed_now",
        "single_owner_enterprise_trust_allowed_now",
        "environment_config_write_allowed_now",
        "migration_execution_allowed_now",
        "rollback_execution_allowed_now",
        "runtime_execution_allowed_now",
        "write_action_allowed_now",
        "protected_action_allowed_now",
        "connector_write_enabled",
        "external_service_mutation_allowed_now",
        "secret_read_allowed_now",
        "raw_source_exposure_allowed",
        "reviewer_mutation_allowed_now",
        "final_approval_ui_enabled",
        "codex_final_approval_ui_enabled",
        "claude_final_approval_ui_enabled",
        "unsafe_flag_count"
      ],
      "properties": {
        "source_p16800_available": { "type": "boolean" },
        "source_p16800_structural_freeze_ready": { "type": "boolean" },
        "source_ready_for_post_p16800_handoff": { "type": "boolean" },
        "source_block_visible_now": { "type": "boolean" },
        "freeze_evidence_packet_ready": { "type": "boolean" },
        "claude_review_receipt_present_now": { "type": "boolean" },
        "claude_review_receipt_block_visible_now": { "type": "boolean" },
        "finding_loop_ready": { "type": "boolean" },
        "unresolved_finding_count": { "type": "integer", "minimum": 0 },
        "evidence_gap_projection_ready": { "type": "boolean" },
        "post_p16800_handoff_recheck_ready": { "type": "boolean" },
        "activation_operator_projection_ready": { "type": "boolean" },
        "activation_authority_guard_ready": { "type": "boolean" },
        "activation_closeout_packet_ready": { "type": "boolean" },
        "p17200_freeze_activation_ready": { "type": "boolean" },
        "ready_for_p17201_handoff": { "type": "boolean" },
        "deployment_allowed_now": { "const": false },
        "release_approval_allowed_now": { "const": false },
        "production_pass_enabled": { "const": false },
        "enterprise_pass_enabled": { "const": false },
        "enterprise_trust_claim_allowed_now": { "const": false },
        "protected_closeout_enabled": { "const": false },
        "human_gate_bypass_allowed_now": { "const": false },
        "independent_review_bypass_allowed_now": { "const": false },
        "single_owner_enterprise_trust_allowed_now": { "const": false },
        "environment_config_write_allowed_now": { "const": false },
        "migration_execution_allowed_now": { "const": false },
        "rollback_execution_allowed_now": { "const": false },
        "runtime_execution_allowed_now": { "const": false },
        "write_action_allowed_now": { "const": false },
        "protected_action_allowed_now": { "const": false },
        "connector_write_enabled": { "const": false },
        "external_service_mutation_allowed_now": { "const": false },
        "secret_read_allowed_now": { "const": false },
        "raw_source_exposure_allowed": { "const": false },
        "reviewer_mutation_allowed_now": { "const": false },
        "final_approval_ui_enabled": { "const": false },
        "codex_final_approval_ui_enabled": { "const": false },
        "claude_final_approval_ui_enabled": { "const": false },
        "unsafe_flag_count": { "const": 0 }
      }
    },
    "validation": {
      "type": "object",
      "required": ["valid", "error_count", "errors"],
      "properties": {
        "valid": { "type": "boolean" },
        "error_count": { "type": "integer", "minimum": 0 },
        "errors": { "type": "array" }
      }
    },
    "summary": {
      "type": "object",
      "required": [
        "freeze_evidence_activation_status",
        "program_range",
        "source_p16800_structural_freeze_ready",
        "source_ready_for_post_p16800_handoff",
        "source_block_visible_now",
        "freeze_evidence_packet_row_count",
        "claude_review_receipt_intake_row_count",
        "claude_review_receipt_present_now",
        "claude_review_receipt_block_visible_now",
        "finding_loop_row_count",
        "unresolved_finding_count",
        "evidence_gap_projection_row_count",
        "post_p16800_handoff_recheck_row_count",
        "activation_operator_projection_row_count",
        "activation_authority_guard_row_count",
        "activation_closeout_packet_row_count",
        "p17200_freeze_activation_ready",
        "ready_for_p17201_handoff",
        "deployment_allowed_now",
        "release_approval_allowed_now",
        "production_pass_enabled",
        "enterprise_pass_enabled",
        "enterprise_trust_claim_allowed_now",
        "validation_error_count"
      ],
      "properties": {
        "freeze_evidence_activation_status": {
          "enum": ["ready_for_freeze_evidence_activation", "blocked_freeze_evidence_activation"]
        },
        "program_range": { "const": "P16801-P17200" },
        "freeze_evidence_packet_row_count": { "type": "integer", "minimum": 6 },
        "claude_review_receipt_intake_row_count": { "type": "integer", "minimum": 6 },
        "finding_loop_row_count": { "type": "integer", "minimum": 6 },
        "evidence_gap_projection_row_count": { "type": "integer", "minimum": 6 },
        "post_p16800_handoff_recheck_row_count": { "type": "integer", "minimum": 6 },
        "activation_operator_projection_row_count": { "type": "integer", "minimum": 6 },
        "activation_authority_guard_row_count": { "type": "integer", "minimum": 6 },
        "activation_closeout_packet_row_count": { "type": "integer", "minimum": 6 },
        "deployment_allowed_now": { "const": false },
        "release_approval_allowed_now": { "const": false },
        "production_pass_enabled": { "const": false },
        "enterprise_pass_enabled": { "const": false },
        "enterprise_trust_claim_allowed_now": { "const": false }
      }
    }
  },
  "$defs": {
    "verdictRow": {
      "type": "object",
      "required": ["row_id", "category", "label", "required", "observed", "evidence_ref", "current_verdict"],
      "properties": {
        "row_id": { "type": "string", "minLength": 1 },
        "category": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "required": { "type": "boolean" },
        "observed": { "type": "boolean" },
        "evidence_ref": { "type": "string", "minLength": 1 },
        "current_verdict": { "enum": ["pass", "blocked"] },
        "block_reason": { "type": ["string", "null"] }
      }
    }
  }
}
