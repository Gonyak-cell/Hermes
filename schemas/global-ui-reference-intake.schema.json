{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hermes.local/schemas/global-ui-reference-intake.schema.json",
  "title": "Hermes Global UI Reference Intake",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "generated_at",
    "capability_id",
    "program_range",
    "design_system_range",
    "source_program_range",
    "global_ui_reference_contract",
    "p10801_p11800_phase_rows",
    "reference_pack_source_rows",
    "sanitized_design_reference_rows",
    "reference_reclassification_rows",
    "comparative_pattern_rows",
    "ui_source_contract_rows",
    "trace_spine_rows",
    "navigation_contract_rows",
    "status_vocabulary_rows",
    "forbidden_language_rows",
    "design_token_rows",
    "component_contract_rows",
    "ui_surface_contract_rows",
    "ui_negative_fixture_rows",
    "design_system_handoff_rows",
    "global_ui_reference_gate_rows",
    "global_ui_reference_boundary",
    "validation_items",
    "validation",
    "summary"
  ],
  "properties": {
    "schema_version": { "const": "global-ui-reference-intake.v1" },
    "capability_id": { "const": "platform.global_ui_reference_intake" },
    "program_range": { "const": "P10801-P11000" },
    "design_system_range": { "const": "P10801-P11800" },
    "source_program_range": { "const": "P10601-P10800" },
    "global_ui_reference_contract": {
      "type": "object",
      "required": [
        "sanitized_reference_doc_required",
        "p9000_language_reclassification_required",
        "comparative_pattern_mapping_required",
        "trace_spine_required",
        "global_operator_queue_home_required",
        "object_inspector_panel_required",
        "negative_fixture_plan_required",
        "raw_body_exposure_allowed",
        "secret_key_exposure_allowed",
        "write_control_enabled",
        "final_approval_ui_enabled",
        "production_pass_ui_enabled",
        "enterprise_pass_ui_enabled",
        "domain_pack_product_identity_enabled",
        "p11800_freeze_claim_allowed_from_intake"
      ],
      "properties": {
        "sanitized_reference_doc_required": { "const": true },
        "p9000_language_reclassification_required": { "const": true },
        "comparative_pattern_mapping_required": { "const": true },
        "trace_spine_required": { "const": true },
        "global_operator_queue_home_required": { "const": true },
        "object_inspector_panel_required": { "const": true },
        "negative_fixture_plan_required": { "const": true },
        "raw_body_exposure_allowed": { "const": false },
        "secret_key_exposure_allowed": { "const": false },
        "write_control_enabled": { "const": false },
        "final_approval_ui_enabled": { "const": false },
        "production_pass_ui_enabled": { "const": false },
        "enterprise_pass_ui_enabled": { "const": false },
        "domain_pack_product_identity_enabled": { "const": false },
        "p11800_freeze_claim_allowed_from_intake": { "const": false }
      }
    },
    "p10801_p11800_phase_rows": { "type": "array", "minItems": 50, "items": { "$ref": "#/$defs/verdictRow" } },
    "reference_pack_source_rows": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/verdictRow" } },
    "sanitized_design_reference_rows": { "type": "array", "minItems": 5, "items": { "$ref": "#/$defs/verdictRow" } },
    "reference_reclassification_rows": { "type": "array", "minItems": 5, "items": { "$ref": "#/$defs/verdictRow" } },
    "comparative_pattern_rows": { "type": "array", "minItems": 8, "items": { "$ref": "#/$defs/verdictRow" } },
    "ui_source_contract_rows": { "type": "array", "minItems": 6, "items": { "$ref": "#/$defs/verdictRow" } },
    "trace_spine_rows": { "type": "array", "minItems": 8, "items": { "$ref": "#/$defs/verdictRow" } },
    "navigation_contract_rows": { "type": "array", "minItems": 11, "items": { "$ref": "#/$defs/verdictRow" } },
    "status_vocabulary_rows": { "type": "array", "minItems": 8, "items": { "$ref": "#/$defs/verdictRow" } },
    "forbidden_language_rows": { "type": "array", "minItems": 7, "items": { "$ref": "#/$defs/verdictRow" } },
    "design_token_rows": { "type": "array", "minItems": 8, "items": { "$ref": "#/$defs/verdictRow" } },
    "component_contract_rows": { "type": "array", "minItems": 17, "items": { "$ref": "#/$defs/verdictRow" } },
    "ui_surface_contract_rows": { "type": "array", "minItems": 8, "items": { "$ref": "#/$defs/verdictRow" } },
    "ui_negative_fixture_rows": { "type": "array", "minItems": 12, "items": { "$ref": "#/$defs/verdictRow" } },
    "design_system_handoff_rows": { "type": "array", "minItems": 5, "items": { "$ref": "#/$defs/verdictRow" } },
    "global_ui_reference_gate_rows": { "type": "array", "minItems": 19, "items": { "$ref": "#/$defs/verdictRow" } },
    "global_ui_reference_boundary": {
      "type": "object",
      "required": [
        "global_ui_reference_intake_ready",
        "design_system_range_planned",
        "sanitized_reference_doc_required",
        "source_body_embedded",
        "binary_body_embedded",
        "raw_body_exposure_allowed",
        "secret_key_exposure_allowed",
        "write_control_enabled",
        "protected_action_enabled",
        "final_approval_ui_enabled",
        "codex_final_approval_ui_enabled",
        "claude_final_approval_ui_enabled",
        "production_pass_ui_enabled",
        "enterprise_pass_ui_enabled",
        "domain_pack_product_identity_enabled",
        "p11800_design_system_freeze_ready",
        "p11800_freeze_requires_later_claude_review",
        "ready_for_p11001_handoff",
        "ready_for_p11801_handoff",
        "unsafe_flag_count"
      ],
      "properties": {
        "sanitized_reference_doc_required": { "const": true },
        "source_body_embedded": { "const": false },
        "binary_body_embedded": { "const": false },
        "raw_body_exposure_allowed": { "const": false },
        "secret_key_exposure_allowed": { "const": false },
        "write_control_enabled": { "const": false },
        "protected_action_enabled": { "const": false },
        "final_approval_ui_enabled": { "const": false },
        "codex_final_approval_ui_enabled": { "const": false },
        "claude_final_approval_ui_enabled": { "const": false },
        "production_pass_ui_enabled": { "const": false },
        "enterprise_pass_ui_enabled": { "const": false },
        "domain_pack_product_identity_enabled": { "const": false },
        "p11800_design_system_freeze_ready": { "const": false },
        "p11800_freeze_requires_later_claude_review": { "const": true },
        "ready_for_p11001_handoff": { "const": true },
        "ready_for_p11801_handoff": { "const": false },
        "unsafe_flag_count": { "const": 0 }
      }
    },
    "validation": {
      "type": "object",
      "required": ["valid", "error_count", "errors"],
      "properties": {
        "valid": { "type": "boolean" },
        "error_count": { "type": "integer", "minimum": 0 },
        "errors": { "type": "array" }
      }
    },
    "summary": {
      "type": "object",
      "required": [
        "global_ui_reference_intake_status",
        "program_range",
        "design_system_range",
        "source_program_range",
        "phase_count",
        "reference_source_count",
        "ready_for_p11001_handoff",
        "ready_for_p11801_handoff",
        "p11800_design_system_freeze_ready",
        "raw_body_exposure_allowed",
        "write_control_enabled",
        "final_approval_ui_enabled",
        "codex_final_approval_ui_enabled",
        "claude_final_approval_ui_enabled",
        "production_pass_ui_enabled",
        "enterprise_pass_ui_enabled",
        "validation_error_count"
      ],
      "properties": {
        "global_ui_reference_intake_status": {
          "enum": [
            "ready_for_global_ui_reference_intake",
            "blocked_global_ui_reference_intake"
          ]
        },
        "program_range": { "const": "P10801-P11000" },
        "design_system_range": { "const": "P10801-P11800" },
        "source_program_range": { "const": "P10601-P10800" },
        "phase_count": { "const": 50 },
        "ready_for_p11001_handoff": { "const": true },
        "ready_for_p11801_handoff": { "const": false },
        "p11800_design_system_freeze_ready": { "const": false },
        "raw_body_exposure_allowed": { "const": false },
        "write_control_enabled": { "const": false },
        "final_approval_ui_enabled": { "const": false },
        "codex_final_approval_ui_enabled": { "const": false },
        "claude_final_approval_ui_enabled": { "const": false },
        "production_pass_ui_enabled": { "const": false },
        "enterprise_pass_ui_enabled": { "const": false }
      }
    }
  },
  "$defs": {
    "verdictRow": {
      "type": "object",
      "required": ["row_id", "category", "label", "required", "observed", "current_verdict", "evidence_ref"],
      "properties": {
        "current_verdict": { "enum": ["pass", "blocked"] },
        "required": { "type": "boolean" },
        "observed": { "type": "boolean" },
        "evidence_ref": { "type": "string" }
      }
    }
  }
}
