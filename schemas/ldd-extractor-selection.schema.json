{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/ldd-extractor-selection.schema.json",
  "title": "Hermes LDD Extractor Selection",
  "type": "object",
  "required": [
    "schema_version",
    "generated_at",
    "ldd_extractor_selection_id",
    "ldd_extractor_selection_status",
    "safe_handling",
    "inputs",
    "source_contracts",
    "ldd_extractor_selection_contract",
    "ldd_extractor_registry",
    "ldd_extractor_selection_records",
    "ldd_extractor_selection_rationales",
    "ldd_extractor_matter_summaries",
    "ldd_extractor_selection_desktop_boundary",
    "ldd_extractor_selection_checkpoints",
    "validation_items",
    "validation",
    "summary"
  ],
  "properties": {
    "schema_version": { "const": "ldd-extractor-selection.v1" },
    "generated_at": { "type": "string", "minLength": 1 },
    "ldd_extractor_selection_id": { "type": "string", "minLength": 1 },
    "output_dir": { "type": "string" },
    "ldd_extractor_selection_status": { "enum": ["complete", "blocked"] },
    "safe_handling": { "$ref": "#/$defs/safe_handling" },
    "inputs": { "type": "object" },
    "source_contracts": { "type": "object" },
    "ldd_extractor_selection_contract": { "$ref": "#/$defs/contract" },
    "ldd_extractor_registry": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/registry_entry" } },
    "ldd_extractor_selection_records": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/selection_record" } },
    "ldd_extractor_selection_rationales": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/rationale" } },
    "ldd_extractor_matter_summaries": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/matter_summary" } },
    "ldd_extractor_selection_desktop_boundary": { "$ref": "#/$defs/desktop_boundary" },
    "ldd_extractor_selection_checkpoints": { "type": "array", "items": { "$ref": "#/$defs/checkpoint" } },
    "validation_items": { "type": "array", "items": { "$ref": "#/$defs/validation_item" } },
    "validation": { "$ref": "#/$defs/validation" },
    "summary": { "$ref": "#/$defs/summary" }
  },
  "$defs": {
    "safe_handling": {
      "type": "object",
      "required": [
        "report_only",
        "legal_advice_provided",
        "client_facing_output_generated",
        "attorney_review_required",
        "human_review_required",
        "final_legal_classification_asserted",
        "extractor_execution_performed",
        "extraction_result_generated",
        "matter_data_write_allowed",
        "task_state_write_allowed",
        "workflow_transition_allowed",
        "runtime_execution_performed",
        "delivery_execution_performed",
        "desktop_mutation_allowed",
        "desktop_source_of_truth",
        "protected_mutation_executed",
        "secret_material_exposed",
        "provider_key_visible"
      ],
      "properties": {
        "report_only": { "const": true },
        "legal_advice_provided": { "const": false },
        "client_facing_output_generated": { "const": false },
        "attorney_review_required": { "const": true },
        "human_review_required": { "const": true },
        "final_legal_classification_asserted": { "const": false },
        "extractor_execution_performed": { "const": false },
        "extraction_result_generated": { "const": false },
        "matter_data_write_allowed": { "const": false },
        "task_state_write_allowed": { "const": false },
        "workflow_transition_allowed": { "const": false },
        "runtime_execution_performed": { "const": false },
        "delivery_execution_performed": { "const": false },
        "desktop_mutation_allowed": { "const": false },
        "desktop_source_of_truth": { "const": false },
        "protected_mutation_executed": { "const": false },
        "secret_material_exposed": { "const": false },
        "provider_key_visible": { "const": false }
      }
    },
    "contract": {
      "type": "object",
      "required": [
        "schema_version",
        "contract_id",
        "source_of_truth",
        "selection_rule",
        "execution_rule",
        "missing_data_rule",
        "attorney_review_rule",
        "desktop_companion_rule",
        "mutation_policy",
        "created_at"
      ],
      "properties": {
        "schema_version": { "const": "ldd-extractor-selection-contract.v1" },
        "contract_id": { "const": "ldd-extractor-selection.v1" },
        "source_of_truth": { "const": "ldd_document_classification_and_extractor_adapter_contract" },
        "selection_rule": { "type": "string" },
        "execution_rule": { "type": "string" },
        "missing_data_rule": { "type": "string" },
        "attorney_review_rule": { "type": "string" },
        "desktop_companion_rule": { "type": "string" },
        "mutation_policy": { "type": "string" },
        "created_at": { "type": "string" }
      }
    },
    "registry_entry": {
      "type": "object",
      "required": [
        "schema_version",
        "ldd_extractor_registry_entry_id",
        "document_class",
        "selected_extractor_id",
        "selected_extractor_name",
        "extractor_kind",
        "local_only",
        "external_service_allowed",
        "network_access_allowed",
        "extractor_execution_performed",
        "extraction_result_generated",
        "attorney_review_required",
        "human_review_required"
      ],
      "properties": {
        "schema_version": { "const": "ldd-extractor-registry-entry.v1" },
        "ldd_extractor_registry_entry_id": { "type": "string", "minLength": 1 },
        "document_class": { "$ref": "#/$defs/document_class" },
        "selected_extractor_id": { "type": "string", "minLength": 1 },
        "selected_extractor_name": { "type": "string", "minLength": 1 },
        "extractor_kind": { "type": "string", "minLength": 1 },
        "binding_adapter_contract_extractor_id": { "type": "string", "minLength": 1 },
        "adapter_contract_binding_available": { "type": "boolean" },
        "local_only": { "const": true },
        "external_service_allowed": { "const": false },
        "network_access_allowed": { "const": false },
        "extractor_execution_performed": { "const": false },
        "extraction_result_generated": { "const": false },
        "attorney_review_required": { "const": true },
        "human_review_required": { "const": true }
      }
    },
    "selection_record": {
      "type": "object",
      "required": [
        "schema_version",
        "ldd_extractor_selection_record_id",
        "matter_id",
        "ldd_document_classification_record_id",
        "source_document_id",
        "source_row_kind",
        "document_title",
        "primary_document_class",
        "selected_extractor_id",
        "selected_extractor_name",
        "extractor_kind",
        "selection_status",
        "selection_basis",
        "selection_rationale_id",
        "extractor_execution_performed",
        "extraction_result_generated",
        "attorney_review_required",
        "human_review_required",
        "client_facing_ready",
        "legal_advice_provided",
        "client_facing_output_generated",
        "matter_data_write_allowed",
        "task_state_write_allowed",
        "workflow_transition_allowed",
        "runtime_execution_allowed",
        "delivery_execution_allowed",
        "protected_action_allowed"
      ],
      "properties": {
        "schema_version": { "const": "ldd-extractor-selection-record.v1" },
        "ldd_extractor_selection_record_id": { "type": "string", "minLength": 1 },
        "matter_id": { "type": "string", "minLength": 1 },
        "ldd_document_classification_record_id": { "type": "string", "minLength": 1 },
        "source_document_id": { "type": "string", "minLength": 1 },
        "source_row_kind": { "enum": ["vdr_file", "missing_data"] },
        "document_title": { "type": "string", "minLength": 1 },
        "primary_document_class": { "$ref": "#/$defs/document_class" },
        "selected_extractor_id": { "type": "string", "minLength": 1 },
        "selected_extractor_name": { "type": "string", "minLength": 1 },
        "extractor_kind": { "type": "string", "minLength": 1 },
        "selection_status": { "const": "selected_pending_attorney_review" },
        "selection_basis": { "type": "string", "minLength": 1 },
        "selection_rationale_id": { "type": "string", "minLength": 1 },
        "extractor_execution_performed": { "const": false },
        "extraction_result_generated": { "const": false },
        "attorney_review_required": { "const": true },
        "human_review_required": { "const": true },
        "client_facing_ready": { "const": false },
        "legal_advice_provided": { "const": false },
        "client_facing_output_generated": { "const": false },
        "matter_data_write_allowed": { "const": false },
        "task_state_write_allowed": { "const": false },
        "workflow_transition_allowed": { "const": false },
        "runtime_execution_allowed": { "const": false },
        "delivery_execution_allowed": { "const": false },
        "protected_action_allowed": { "const": false }
      }
    },
    "rationale": {
      "type": "object",
      "required": [
        "schema_version",
        "ldd_extractor_selection_rationale_id",
        "ldd_extractor_selection_record_id",
        "matter_id",
        "source_document_id",
        "primary_document_class",
        "selected_extractor_id",
        "rationale_status",
        "rationale_basis",
        "evidence_summary",
        "extractor_execution_performed",
        "extraction_result_generated",
        "attorney_review_required",
        "human_review_required"
      ],
      "properties": {
        "schema_version": { "const": "ldd-extractor-selection-rationale.v1" },
        "ldd_extractor_selection_rationale_id": { "type": "string", "minLength": 1 },
        "ldd_extractor_selection_record_id": { "type": "string", "minLength": 1 },
        "matter_id": { "type": "string", "minLength": 1 },
        "source_document_id": { "type": "string", "minLength": 1 },
        "primary_document_class": { "$ref": "#/$defs/document_class" },
        "selected_extractor_id": { "type": "string", "minLength": 1 },
        "rationale_status": { "const": "document_class_rule_match" },
        "rationale_basis": { "type": "string", "minLength": 1 },
        "evidence_summary": { "type": "object" },
        "extractor_execution_performed": { "const": false },
        "extraction_result_generated": { "const": false },
        "attorney_review_required": { "const": true },
        "human_review_required": { "const": true }
      }
    },
    "matter_summary": {
      "type": "object",
      "required": [
        "schema_version",
        "ldd_extractor_matter_summary_id",
        "matter_id",
        "ldd_extractor_matter_status",
        "selection_record_count",
        "distinct_selected_extractor_count",
        "extractor_execution_count",
        "extraction_result_generated_count",
        "attorney_review_required",
        "human_review_required",
        "client_facing_ready"
      ],
      "properties": {
        "schema_version": { "const": "ldd-extractor-matter-summary.v1" },
        "ldd_extractor_matter_summary_id": { "type": "string", "minLength": 1 },
        "matter_id": { "type": "string", "minLength": 1 },
        "ldd_extractor_matter_status": { "const": "selected_pending_attorney_review" },
        "selection_record_count": { "type": "integer", "minimum": 1 },
        "distinct_selected_extractor_count": { "type": "integer", "minimum": 1 },
        "extractor_execution_count": { "const": 0 },
        "extraction_result_generated_count": { "const": 0 },
        "attorney_review_required": { "const": true },
        "human_review_required": { "const": true },
        "client_facing_ready": { "const": false }
      }
    },
    "desktop_boundary": {
      "type": "object",
      "required": [
        "schema_version",
        "boundary_status",
        "read_only",
        "desktop_mutation_allowed",
        "desktop_source_of_truth",
        "matter_data_write_allowed",
        "task_state_write_allowed",
        "workflow_transition_allowed",
        "runtime_execution_allowed",
        "delivery_execution_allowed",
        "protected_action_allowed",
        "client_facing_output_allowed_without_attorney_review"
      ],
      "properties": {
        "schema_version": { "const": "ldd-extractor-selection-desktop-boundary.v1" },
        "boundary_status": { "const": "enforced" },
        "read_only": { "const": true },
        "desktop_mutation_allowed": { "const": false },
        "desktop_source_of_truth": { "const": false },
        "matter_data_write_allowed": { "const": false },
        "task_state_write_allowed": { "const": false },
        "workflow_transition_allowed": { "const": false },
        "runtime_execution_allowed": { "const": false },
        "delivery_execution_allowed": { "const": false },
        "protected_action_allowed": { "const": false },
        "client_facing_output_allowed_without_attorney_review": { "const": false }
      }
    },
    "checkpoint": {
      "type": "object",
      "required": ["checkpoint_id", "status", "message"],
      "properties": {
        "checkpoint_id": { "type": "string", "minLength": 1 },
        "status": { "enum": ["passed", "failed"] },
        "message": { "type": "string" }
      }
    },
    "validation_item": {
      "type": "object",
      "required": ["path", "check_id", "status", "message"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "check_id": { "type": "string", "minLength": 1 },
        "status": { "enum": ["passed", "failed"] },
        "message": { "type": "string" }
      }
    },
    "validation": {
      "type": "object",
      "required": ["valid", "errors"],
      "properties": {
        "valid": { "type": "boolean" },
        "errors": { "type": "array" },
        "items": { "type": "array" }
      }
    },
    "summary": {
      "type": "object",
      "required": [
        "ldd_extractor_selection_status",
        "classification_record_count",
        "extractor_registry_count",
        "selection_record_count",
        "selected_extractor_count",
        "distinct_selected_extractor_count",
        "selection_rationale_count",
        "matter_count",
        "extractor_execution_count",
        "extraction_result_generated_count",
        "client_facing_ready_count",
        "legal_advice_provided",
        "client_facing_output_generated",
        "validation_error_count"
      ],
      "properties": {
        "ldd_extractor_selection_status": { "enum": ["complete", "blocked"] },
        "classification_record_count": { "type": "integer", "minimum": 1 },
        "extractor_registry_count": { "type": "integer", "minimum": 1 },
        "selection_record_count": { "type": "integer", "minimum": 1 },
        "selected_extractor_count": { "type": "integer", "minimum": 1 },
        "distinct_selected_extractor_count": { "type": "integer", "minimum": 1 },
        "selection_rationale_count": { "type": "integer", "minimum": 1 },
        "matter_count": { "type": "integer", "minimum": 1 },
        "extractor_execution_count": { "const": 0 },
        "extraction_result_generated_count": { "const": 0 },
        "client_facing_ready_count": { "const": 0 },
        "legal_advice_provided": { "const": false },
        "client_facing_output_generated": { "const": false },
        "validation_error_count": { "const": 0 }
      }
    },
    "document_class": {
      "enum": [
        "contract",
        "registry",
        "license_permit",
        "litigation",
        "labor_employment",
        "tax",
        "corporate_governance",
        "closing_deliverable",
        "other"
      ]
    }
  }
}
