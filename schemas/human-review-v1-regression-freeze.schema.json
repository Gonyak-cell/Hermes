{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://amic.local/hermes/human-review-v1-regression-freeze.schema.json",
  "title": "Hermes Human Review v1 Regression Freeze",
  "type": "object",
  "required": [
    "schema_version",
    "generated_at",
    "freeze_id",
    "output_dir",
    "freeze_status",
    "safe_handling",
    "sources",
    "summary",
    "regression_fixture",
    "freeze_note",
    "verification_checkpoints",
    "validation"
  ],
  "properties": {
    "schema_version": { "const": "human-review-v1-regression-freeze.v1" },
    "generated_at": { "type": "string", "format": "date-time" },
    "freeze_id": { "type": "string" },
    "output_dir": { "type": "string" },
    "freeze_status": {
      "enum": ["blocked", "frozen_with_pending_human_actions", "frozen_clear"]
    },
    "safe_handling": {
      "type": "object",
      "required": [
        "auto_execute_allowed",
        "regression_freeze_only",
        "source_artifact_mutation_allowed",
        "commands_executed",
        "protected_actions_executed",
        "audit_events_emitted"
      ],
      "properties": {
        "auto_execute_allowed": { "const": false },
        "regression_freeze_only": { "const": true },
        "source_artifact_mutation_allowed": { "const": false },
        "commands_executed": { "const": false },
        "protected_actions_executed": { "const": false },
        "audit_events_emitted": { "const": false }
      }
    },
    "sources": {
      "type": "array",
      "items": { "$ref": "#/$defs/source" }
    },
    "summary": {
      "type": "object",
      "required": [
        "freeze_status",
        "required_source_count",
        "available_required_source_count",
        "regression_fixture_artifact_count",
        "regression_fixture_hash_count",
        "verification_checkpoint_count",
        "passed_verification_checkpoint_count",
        "failed_verification_checkpoint_count",
        "closeout_item_count",
        "closeout_pending_count",
        "closeout_unknown_status_count",
        "loop_status",
        "loop_step_count",
        "loop_passed_step_count",
        "loop_failed_step_count",
        "loop_missing_artifact_count",
        "validation_error_count",
        "command_executed_count",
        "patch_applied_count",
        "audit_event_emitted_count",
        "protected_action_executed_count",
        "by_checkpoint_status"
      ],
      "properties": {
        "freeze_status": { "type": "string" },
        "required_source_count": { "type": "integer", "minimum": 0 },
        "available_required_source_count": { "type": "integer", "minimum": 0 },
        "regression_fixture_artifact_count": { "type": "integer", "minimum": 0 },
        "regression_fixture_hash_count": { "type": "integer", "minimum": 0 },
        "verification_checkpoint_count": { "type": "integer", "minimum": 0 },
        "passed_verification_checkpoint_count": { "type": "integer", "minimum": 0 },
        "failed_verification_checkpoint_count": { "type": "integer", "minimum": 0 },
        "closeout_item_count": { "type": "integer", "minimum": 0 },
        "closeout_pending_count": { "type": "integer", "minimum": 0 },
        "closeout_unknown_status_count": { "type": "integer", "minimum": 0 },
        "loop_status": { "type": ["string", "null"] },
        "loop_step_count": { "type": "integer", "minimum": 0 },
        "loop_passed_step_count": { "type": "integer", "minimum": 0 },
        "loop_failed_step_count": { "type": "integer", "minimum": 0 },
        "loop_missing_artifact_count": { "type": "integer", "minimum": 0 },
        "validation_error_count": { "type": "integer", "minimum": 0 },
        "command_executed_count": { "const": 0 },
        "patch_applied_count": { "const": 0 },
        "audit_event_emitted_count": { "const": 0 },
        "protected_action_executed_count": { "const": 0 },
        "by_checkpoint_status": { "type": "object" }
      }
    },
    "regression_fixture": {
      "type": "object",
      "required": [
        "fixture_id",
        "fixture_scope",
        "frozen_slots",
        "source_phase_range",
        "artifact_refs",
        "support_refs",
        "invariant_snapshot",
        "verification_contract"
      ],
      "properties": {
        "fixture_id": { "type": "string" },
        "fixture_scope": { "type": "string" },
        "frozen_slots": { "type": "array", "items": { "type": "string" } },
        "source_phase_range": { "type": "string" },
        "artifact_refs": { "type": "array", "items": { "$ref": "#/$defs/fixture_ref" } },
        "support_refs": { "type": "array", "items": { "$ref": "#/$defs/fixture_ref" } },
        "invariant_snapshot": { "type": "object" },
        "verification_contract": { "type": "array", "items": { "type": "object" } }
      }
    },
    "freeze_note": {
      "type": "object",
      "required": [
        "note_id",
        "freeze_status",
        "frozen_at",
        "scope",
        "next_planned_slot",
        "next_track",
        "residual_human_actions",
        "verification_summary",
        "freeze_decision"
      ],
      "properties": {
        "note_id": { "type": "string" },
        "freeze_status": { "type": "string" },
        "frozen_at": { "type": "string", "format": "date-time" },
        "scope": { "type": "string" },
        "next_planned_slot": { "type": "string" },
        "next_track": { "type": "string" },
        "residual_human_actions": { "type": "object" },
        "verification_summary": { "type": "object" },
        "freeze_decision": { "type": "string" }
      }
    },
    "verification_checkpoints": {
      "type": "array",
      "items": { "$ref": "#/$defs/verification_checkpoint" }
    },
    "validation": {
      "type": "object",
      "required": ["valid", "errors"],
      "properties": {
        "valid": { "type": "boolean" },
        "errors": { "type": "array", "items": { "type": "object" } }
      }
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "required": [
        "source_id",
        "label",
        "option",
        "planned_slot",
        "required",
        "format",
        "path",
        "available",
        "schema_version",
        "generated_at",
        "summary",
        "content_hash",
        "error"
      ],
      "properties": {
        "source_id": { "type": "string" },
        "label": { "type": "string" },
        "option": { "type": "string" },
        "planned_slot": { "type": "string" },
        "required": { "type": "boolean" },
        "format": { "type": "string" },
        "path": { "type": ["string", "null"] },
        "available": { "type": "boolean" },
        "schema_version": { "type": ["string", "null"] },
        "generated_at": { "type": ["string", "null"], "format": "date-time" },
        "summary": { "type": ["object", "null"] },
        "content_hash": { "type": ["string", "null"] },
        "error": { "type": ["string", "null"] }
      }
    },
    "fixture_ref": {
      "type": "object",
      "required": [
        "source_id",
        "label",
        "path",
        "available",
        "schema_version",
        "generated_at",
        "content_hash",
        "summary"
      ],
      "properties": {
        "source_id": { "type": "string" },
        "label": { "type": "string" },
        "planned_slot": { "type": "string" },
        "path": { "type": ["string", "null"] },
        "available": { "type": "boolean" },
        "schema_version": { "type": ["string", "null"] },
        "generated_at": { "type": ["string", "null"], "format": "date-time" },
        "content_hash": { "type": ["string", "null"] },
        "summary": { "type": ["object", "null"] },
        "required": { "type": "boolean" }
      }
    },
    "verification_checkpoint": {
      "type": "object",
      "required": ["checkpoint_id", "key", "message", "status"],
      "properties": {
        "checkpoint_id": { "type": "string" },
        "key": { "type": "string" },
        "message": { "type": "string" },
        "status": { "enum": ["passed", "failed"] }
      }
    }
  }
}
