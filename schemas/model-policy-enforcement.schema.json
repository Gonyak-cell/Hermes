{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://amic.local/hermes/model-policy-enforcement.schema.json",
  "title": "Hermes Model Policy Enforcement",
  "type": "object",
  "required": [
    "schema_version",
    "generated_at",
    "model_policy_enforcement_id",
    "output_dir",
    "inputs",
    "source_data_classification_rule_engine",
    "source_model_routing_ledger",
    "source_policy_contract",
    "model_policy_gate_catalog",
    "validation_items",
    "validation",
    "summary"
  ],
  "properties": {
    "schema_version": { "const": "model-policy-enforcement.v1" },
    "generated_at": { "type": "string", "format": "date-time" },
    "model_policy_enforcement_id": { "type": "string" },
    "output_dir": { "type": "string" },
    "inputs": {
      "type": "object",
      "required": [
        "data_classification_rule_engine_path",
        "model_routing_ledger_path",
        "policy_contract_freeze_path"
      ],
      "properties": {
        "data_classification_rule_engine_path": { "type": "string" },
        "model_routing_ledger_path": { "type": "string" },
        "policy_contract_freeze_path": { "type": "string" }
      }
    },
    "source_data_classification_rule_engine": { "$ref": "#/$defs/source_summary" },
    "source_model_routing_ledger": { "$ref": "#/$defs/source_summary" },
    "source_policy_contract": { "$ref": "#/$defs/source_summary" },
    "model_policy_gate_catalog": {
      "type": "object",
      "required": [
        "schema_version",
        "generated_at",
        "classification_model_gates",
        "resource_model_gates",
        "route_model_gates"
      ],
      "properties": {
        "schema_version": { "const": "model-policy-gate-catalog.v1" },
        "generated_at": { "type": "string", "format": "date-time" },
        "classification_model_gates": { "type": "array", "items": { "$ref": "#/$defs/classification_model_gate" } },
        "resource_model_gates": { "type": "array", "items": { "$ref": "#/$defs/resource_model_gate" } },
        "route_model_gates": { "type": "array", "items": { "$ref": "#/$defs/route_model_gate" } }
      }
    },
    "validation_items": { "type": "array", "items": { "$ref": "#/$defs/validation_item" } },
    "validation": { "$ref": "#/$defs/validation" },
    "summary": { "$ref": "#/$defs/summary" }
  },
  "$defs": {
    "source_summary": {
      "type": "object",
      "properties": {
        "schema_version": { "type": ["string", "null"] },
        "error": { "type": ["string", "null"] }
      },
      "additionalProperties": true
    },
    "classification_model_gate": {
      "type": "object",
      "required": [
        "schema_version",
        "classification_model_gate_id",
        "classification_rule_id",
        "classification",
        "classification_ordinal",
        "sensitive_data",
        "policy_decision_id",
        "external_model_policy",
        "external_model_decision",
        "local_model_policy",
        "redaction_policy",
        "requires_redaction",
        "enforcement_mode",
        "gate_status",
        "audit_required",
        "human_approval_required",
        "required_gates",
        "reason_codes",
        "decided_at",
        "metadata"
      ],
      "properties": {
        "schema_version": { "const": "classification-model-policy-gate.v1" },
        "classification_model_gate_id": { "type": "string" },
        "classification_rule_id": { "type": "string" },
        "classification": { "type": "string" },
        "classification_ordinal": { "type": "integer", "minimum": 0 },
        "sensitive_data": { "type": "boolean" },
        "policy_decision_id": { "type": ["string", "null"] },
        "external_model_policy": { "type": ["string", "null"] },
        "external_model_decision": { "enum": ["allow", "review", "deny"] },
        "local_model_policy": { "type": ["string", "null"] },
        "redaction_policy": { "type": ["string", "null"] },
        "requires_redaction": { "type": "boolean" },
        "enforcement_mode": { "type": "string" },
        "gate_status": { "enum": ["passed", "requires_approval", "blocked"] },
        "audit_required": { "type": "boolean" },
        "human_approval_required": { "type": "boolean" },
        "required_gates": { "type": "array", "items": { "type": "string" } },
        "reason_codes": { "type": "array", "items": { "type": "string" } },
        "decided_at": { "type": "string", "format": "date-time" },
        "metadata": { "type": "object" }
      }
    },
    "resource_model_gate": {
      "type": "object",
      "required": [
        "schema_version",
        "resource_model_gate_id",
        "resource_classification_decision_id",
        "resource_id",
        "resource_version_id",
        "tenant_id",
        "matter_id",
        "classification",
        "classification_ordinal",
        "sensitive_data",
        "policy_decision_id",
        "policy_reference_id",
        "external_model_policy",
        "external_model_decision",
        "local_model_policy",
        "redaction_policy",
        "requires_redaction",
        "resource_policy_decision",
        "external_transfer_gate_status",
        "gate_decision",
        "gate_status",
        "audit_required",
        "human_approval_required",
        "required_gates",
        "reason_codes",
        "decided_at",
        "metadata"
      ],
      "properties": {
        "schema_version": { "const": "resource-model-policy-gate.v1" },
        "resource_model_gate_id": { "type": "string" },
        "resource_classification_decision_id": { "type": "string" },
        "resource_id": { "type": "string" },
        "resource_version_id": { "type": ["string", "null"] },
        "tenant_id": { "type": "string" },
        "matter_id": { "type": ["string", "null"] },
        "classification": { "type": "string" },
        "classification_ordinal": { "type": "integer", "minimum": 0 },
        "sensitive_data": { "type": "boolean" },
        "policy_decision_id": { "type": ["string", "null"] },
        "policy_reference_id": { "type": ["string", "null"] },
        "external_model_policy": { "type": ["string", "null"] },
        "external_model_decision": { "enum": ["allow", "review", "deny"] },
        "local_model_policy": { "type": ["string", "null"] },
        "redaction_policy": { "type": ["string", "null"] },
        "requires_redaction": { "type": "boolean" },
        "resource_policy_decision": { "enum": ["allow", "review", "deny"] },
        "external_transfer_gate_status": { "enum": ["allowed", "requires_approval", "blocked"] },
        "gate_decision": { "enum": ["allow", "review", "deny"] },
        "gate_status": { "enum": ["passed", "requires_approval", "blocked"] },
        "audit_required": { "type": "boolean" },
        "human_approval_required": { "type": "boolean" },
        "required_gates": { "type": "array", "items": { "type": "string" } },
        "reason_codes": { "type": "array", "items": { "type": "string" } },
        "decided_at": { "type": "string", "format": "date-time" },
        "metadata": { "type": "object" }
      }
    },
    "route_model_gate": {
      "type": "object",
      "required": [
        "schema_version",
        "route_model_gate_id",
        "routing_decision_id",
        "context_packet_id",
        "workflow_run_id",
        "agent_run_id",
        "runtime_id",
        "capability_id",
        "domain_pack",
        "tenant_id",
        "matter_id",
        "client_id",
        "policy_snapshot_id",
        "policy_decision_id",
        "classification",
        "classification_ordinal",
        "sensitive_data",
        "source_route_status",
        "source_route_mode",
        "external_transfer",
        "provider_boundary",
        "runtime_policy_status",
        "external_model_policy",
        "external_model_decision",
        "local_model_policy",
        "redaction_policy",
        "redaction_status",
        "gate_decision",
        "gate_status",
        "audit_required",
        "human_approval_required",
        "required_gates",
        "enforcement_reasons",
        "decided_at",
        "metadata"
      ],
      "properties": {
        "schema_version": { "const": "route-model-policy-gate.v1" },
        "route_model_gate_id": { "type": "string" },
        "routing_decision_id": { "type": "string" },
        "context_packet_id": { "type": "string" },
        "workflow_run_id": { "type": "string" },
        "agent_run_id": { "type": "string" },
        "runtime_id": { "type": "string" },
        "capability_id": { "type": "string" },
        "domain_pack": { "type": "string" },
        "tenant_id": { "type": "string" },
        "matter_id": { "type": ["string", "null"] },
        "client_id": { "type": ["string", "null"] },
        "policy_snapshot_id": { "type": ["string", "null"] },
        "policy_decision_id": { "type": ["string", "null"] },
        "classification": { "type": "string" },
        "classification_ordinal": { "type": "integer", "minimum": 0 },
        "sensitive_data": { "type": "boolean" },
        "source_route_status": { "type": "string" },
        "source_route_mode": { "type": "string" },
        "external_transfer": { "type": "boolean" },
        "provider_boundary": { "type": "string" },
        "runtime_policy_status": { "type": "string" },
        "external_model_policy": { "type": "string" },
        "external_model_decision": { "type": "string" },
        "local_model_policy": { "type": "string" },
        "redaction_policy": { "type": "string" },
        "redaction_status": { "type": "string" },
        "gate_decision": { "enum": ["allow", "review", "deny"] },
        "gate_status": { "enum": ["passed", "requires_approval", "blocked"] },
        "audit_required": { "type": "boolean" },
        "human_approval_required": { "type": "boolean" },
        "required_gates": { "type": "array", "items": { "type": "string" } },
        "enforcement_reasons": { "type": "array", "items": { "type": "string" } },
        "decided_at": { "type": "string", "format": "date-time" },
        "metadata": { "type": "object" }
      }
    },
    "validation_item": {
      "type": "object",
      "required": ["schema_version", "validation_id", "subject_type", "subject_id", "check_id", "status", "message"],
      "properties": {
        "schema_version": { "const": "model-policy-enforcement-validation.v1" },
        "validation_id": { "type": "string" },
        "subject_type": { "type": "string" },
        "subject_id": { "type": "string" },
        "check_id": { "type": "string" },
        "status": { "enum": ["passed", "failed"] },
        "message": { "type": "string" }
      }
    },
    "validation": {
      "type": "object",
      "required": ["valid", "errors"],
      "properties": {
        "valid": { "type": "boolean" },
        "errors": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["path", "message"],
            "properties": {
              "path": { "type": "string" },
              "message": { "type": "string" }
            }
          }
        }
      }
    },
    "summary": {
      "type": "object",
      "required": [
        "model_policy_enforcement_status",
        "classification_model_gate_count",
        "resource_model_gate_count",
        "route_model_gate_count",
        "p2_p5_classification_gate_count",
        "p2_p5_resource_gate_count",
        "external_transfer_route_count",
        "p2_p5_external_transfer_route_count",
        "unauthorized_external_allow_count",
        "validation_error_count"
      ],
      "properties": {
        "model_policy_enforcement_status": { "enum": ["complete", "blocked"] },
        "source_data_classification_rule_engine_status": { "type": "string" },
        "source_model_routing_ledger_status": { "type": "string" },
        "source_policy_contract_status": { "type": "string" },
        "classification_model_gate_count": { "type": "integer", "minimum": 0 },
        "resource_model_gate_count": { "type": "integer", "minimum": 0 },
        "route_model_gate_count": { "type": "integer", "minimum": 0 },
        "p2_p5_classification_gate_count": { "type": "integer", "minimum": 0 },
        "p2_p5_resource_gate_count": { "type": "integer", "minimum": 0 },
        "external_transfer_route_count": { "type": "integer", "minimum": 0 },
        "p2_p5_external_transfer_route_count": { "type": "integer", "minimum": 0 },
        "external_transfer_allowed_count": { "type": "integer", "minimum": 0 },
        "external_transfer_review_count": { "type": "integer", "minimum": 0 },
        "external_transfer_denied_count": { "type": "integer", "minimum": 0 },
        "high_sensitivity_external_denied_count": { "type": "integer", "minimum": 0 },
        "unauthorized_external_allow_count": { "type": "integer", "minimum": 0 },
        "redaction_required_resource_gate_count": { "type": "integer", "minimum": 0 },
        "redaction_required_external_route_count": { "type": "integer", "minimum": 0 },
        "redaction_blocked_route_count": { "type": "integer", "minimum": 0 },
        "human_approval_required_gate_count": { "type": "integer", "minimum": 0 },
        "validation_item_count": { "type": "integer", "minimum": 0 },
        "failed_validation_item_count": { "type": "integer", "minimum": 0 },
        "validation_error_count": { "type": "integer", "minimum": 0 },
        "by_gate_status": { "type": "object" },
        "by_gate_decision": { "type": "object" },
        "by_classification": { "type": "object" },
        "by_external_model_policy": { "type": "object" }
      },
      "additionalProperties": true
    }
  }
}
