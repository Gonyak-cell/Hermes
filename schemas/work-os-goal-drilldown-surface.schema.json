              "protected_action_controls_enabled": { "const": false },
              "git_write_controls_enabled": { "const": false },
              "mutation_allowed": { "const": false }
            },
            "additionalProperties": true
          }
        ]
      }
    },
    "goal_api_projection_rows": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/goalRow" } },
    "next_action_api_projection_rows": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/nextActionRow" } },
    "commit_checkpoint_api_projection_rows": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/commitRow" } },
    "session_handoff_api_projection_rows": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/sessionRow" } },
    "project_drilldown_rows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "allOf": [
          { "$ref": "#/$defs/row" },
          {
