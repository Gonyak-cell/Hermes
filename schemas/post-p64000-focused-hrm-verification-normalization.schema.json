        "normalized_capture_ready_now": { "type": "boolean" },
        "recommendations_pending_only_now": { "type": "boolean" },
        "verification_pending_guards_ready_now": { "type": "boolean" },
        "future_review_packet_ready_now": { "type": "boolean" },
