{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://amic.local/hermes/delivery-closeout-receipt-validation.schema.json",
  "title": "Hermes Delivery Closeout Receipt Validation",
  "type": "object",
  "required": [
    "schema_version",
    "generated_at",
    "validation_id",
    "summary",
    "sources",
    "validation_items",
    "receipt_errors",
    "validated_receipts_to_apply"
  ],
  "properties": {
    "schema_version": { "const": "delivery-closeout-receipt-validation.v1" },
    "generated_at": { "type": "string", "format": "date-time" },
    "validation_id": { "type": "string" },
    "summary": {
      "type": "object",
      "required": [
        "closeout_queue_available",
        "receipt_input_available",
        "closeout_item_count",
        "receipt_count",
        "ready_to_apply_count",
        "pending_receipt_count",
        "missing_receipt_count",
        "invalid_receipt_count",
        "unknown_packet_count",
        "error_count",
        "fully_ready_to_apply",
        "by_status",
        "by_receipt_status",
        "by_delivery_channel",
        "by_primary_domain_pack"
      ],
      "properties": {
        "closeout_queue_available": { "type": "boolean" },
        "receipt_input_available": { "type": "boolean" },
        "closeout_item_count": { "type": "integer", "minimum": 0 },
        "receipt_count": { "type": "integer", "minimum": 0 },
        "ready_to_apply_count": { "type": "integer", "minimum": 0 },
        "pending_receipt_count": { "type": "integer", "minimum": 0 },
        "missing_receipt_count": { "type": "integer", "minimum": 0 },
        "invalid_receipt_count": { "type": "integer", "minimum": 0 },
        "unknown_packet_count": { "type": "integer", "minimum": 0 },
        "error_count": { "type": "integer", "minimum": 0 },
        "fully_ready_to_apply": { "type": "boolean" },
        "by_status": { "type": "object" },
        "by_receipt_status": { "type": "object" },
        "by_delivery_channel": { "type": "object" },
        "by_primary_domain_pack": { "type": "object" }
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source_id", "label", "path", "available", "schema_version", "generated_at", "summary", "error"],
        "properties": {
          "source_id": { "type": "string" },
          "label": { "type": "string" },
          "path": { "type": ["string", "null"] },
          "available": { "type": "boolean" },
          "schema_version": { "type": ["string", "null"] },
          "generated_at": { "type": ["string", "null"], "format": "date-time" },
          "summary": { "type": ["object", "null"] },
          "error": { "type": ["string", "null"] }
        }
      }
    },
    "validation_items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "validation_item_id",
          "closeout_item_id",
          "packet_id",
          "tenant_id",
          "matter_id",
          "delivery_channel",
          "delivery_target",
          "priority",
          "primary_domain_pack",
          "validation_status",
          "receipt_status",
          "ready_to_apply",
          "error_count",
          "artifact_ids",
          "errors",
          "receipt"
        ],
        "properties": {
          "validation_item_id": { "type": "string" },
          "closeout_item_id": { "type": ["string", "null"] },
          "packet_id": { "type": "string" },
          "tenant_id": { "type": ["string", "null"] },
          "matter_id": { "type": ["string", "null"] },
          "delivery_channel": { "type": ["string", "null"] },
          "delivery_target": { "type": ["string", "null"] },
          "priority": { "enum": ["critical", "high", "medium", "low", null] },
          "primary_domain_pack": { "type": ["string", "null"] },
          "validation_status": {
            "enum": ["missing_receipt", "pending_receipt", "ready_to_apply", "invalid_receipt", "unknown_packet"]
          },
          "receipt_status": { "type": "string" },
          "ready_to_apply": { "type": "boolean" },
          "error_count": { "type": "integer", "minimum": 0 },
          "artifact_ids": { "type": "array", "items": { "type": "string" } },
          "errors": { "type": "array", "items": { "type": "object" } },
          "receipt": { "type": ["object", "null"] }
        }
      }
    },
    "receipt_errors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["packet_id", "field", "message"],
        "properties": {
          "packet_id": { "type": "string" },
          "field": { "type": "string" },
          "message": { "type": "string" }
        }
      }
    },
    "validated_receipts_to_apply": {
      "type": "object",
      "required": ["schema_version", "generated_at", "execution_plan_id", "instructions", "receipts"],
      "properties": {
        "schema_version": { "const": "delivery-receipts-input.v1" },
        "generated_at": { "type": "string", "format": "date-time" },
        "execution_plan_id": { "type": "string" },
        "instructions": { "type": "string" },
        "receipts": {
          "type": "array",
          "items": { "type": "object" }
        }
      }
    }
  }
}
