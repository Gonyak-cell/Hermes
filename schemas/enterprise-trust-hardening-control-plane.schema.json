{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hermes.local/schemas/enterprise-trust-hardening-control-plane.schema.json",
  "title": "Hermes Enterprise Trust Hardening Control Plane",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "capability_id",
    "program_range",
    "source_program_range",
    "enterprise_trust_hardening_contract",
    "enterprise_trust_phase_rows",
    "enterprise_source_binding_rows",
    "independent_review_hardening_rows",
    "attestation_hardening_rows",
    "sbom_dependency_evidence_rows",
    "supply_chain_policy_rows",
    "audit_trail_hardening_rows",
    "backup_restore_posture_rows",
    "recovery_posture_rows",
    "claude_enterprise_trust_review_rows",
    "enterprise_trust_authority_guard_rows",
    "p13400_freeze_rows",
    "enterprise_trust_boundary",
    "enterprise_trust_validation_items",
    "validation",
    "summary"
  ],
  "properties": {
    "schema_version": { "const": "enterprise-trust-hardening-control-plane.v1" },
    "capability_id": { "const": "platform.enterprise_trust_hardening_control_plane" },
    "program_range": { "const": "P13001-P13400" },
    "source_program_range": { "const": "P12801-P13000" },
    "enterprise_trust_phase_rows": { "type": "array", "minItems": 10, "items": { "$ref": "#/$defs/verdictRow" } },
    "enterprise_source_binding_rows": { "type": "array", "minItems": 8, "items": { "$ref": "#/$defs/verdictRow" } },
    "independent_review_hardening_rows": { "type": "array", "minItems": 6, "items": { "$ref": "#/$defs/verdictRow" } },
    "attestation_hardening_rows": { "type": "array", "minItems": 6, "items": { "$ref": "#/$defs/verdictRow" } },
    "sbom_dependency_evidence_rows": { "type": "array", "minItems": 6, "items": { "$ref": "#/$defs/verdictRow" } },
    "supply_chain_policy_rows": { "type": "array", "minItems": 6, "items": { "$ref": "#/$defs/verdictRow" } },
    "audit_trail_hardening_rows": { "type": "array", "minItems": 6, "items": { "$ref": "#/$defs/verdictRow" } },
    "backup_restore_posture_rows": { "type": "array", "minItems": 6, "items": { "$ref": "#/$defs/verdictRow" } },
    "recovery_posture_rows": { "type": "array", "minItems": 6, "items": { "$ref": "#/$defs/verdictRow" } },
    "claude_enterprise_trust_review_rows": { "type": "array", "minItems": 5, "items": { "$ref": "#/$defs/verdictRow" } },
    "enterprise_trust_authority_guard_rows": { "type": "array", "minItems": 6, "items": { "$ref": "#/$defs/verdictRow" } },
    "p13400_freeze_rows": { "type": "array", "minItems": 12, "items": { "$ref": "#/$defs/verdictRow" } },
    "enterprise_trust_boundary": {
      "type": "object",
      "required": [
        "source_release_readiness_available",
        "source_ready_for_p13001_handoff",
        "source_block_visible_now",
        "independent_review_hardening_ready",
        "attestation_hardening_ready",
        "sbom_dependency_evidence_ready",
        "supply_chain_policy_ready",
        "audit_trail_hardening_ready",
        "backup_restore_posture_ready",
        "recovery_posture_ready",
        "claude_enterprise_trust_review_receipt_present_now",
        "claude_enterprise_trust_review_block_visible_now",
        "p13400_enterprise_trust_hardening_freeze_ready",
        "ready_for_p13401_handoff",
        "enterprise_trust_claim_allowed_now",
        "production_pass_enabled",
        "enterprise_pass_enabled",
        "protected_closeout_enabled",
        "deployment_allowed_now",
        "release_approval_allowed_now",
        "write_action_allowed_now",
        "protected_action_allowed_now",
        "connector_write_enabled",
        "runtime_execution_allowed_now",
        "raw_body_exposure_allowed",
        "secret_read_allowed_now",
        "final_approval_ui_enabled",
        "codex_final_approval_ui_enabled",
        "claude_final_approval_ui_enabled",
        "unsafe_flag_count"
      ],
      "properties": {
        "source_release_readiness_available": { "type": "boolean" },
        "source_ready_for_p13001_handoff": { "type": "boolean" },
        "source_block_visible_now": { "type": "boolean" },
        "independent_review_hardening_ready": { "type": "boolean" },
        "attestation_hardening_ready": { "type": "boolean" },
        "sbom_dependency_evidence_ready": { "type": "boolean" },
        "supply_chain_policy_ready": { "type": "boolean" },
        "audit_trail_hardening_ready": { "type": "boolean" },
        "backup_restore_posture_ready": { "type": "boolean" },
        "recovery_posture_ready": { "type": "boolean" },
        "claude_enterprise_trust_review_receipt_present_now": { "type": "boolean" },
        "claude_enterprise_trust_review_block_visible_now": { "type": "boolean" },
        "p13400_enterprise_trust_hardening_freeze_ready": { "type": "boolean" },
        "ready_for_p13401_handoff": { "type": "boolean" },
        "enterprise_trust_claim_allowed_now": { "const": false },
        "production_pass_enabled": { "const": false },
        "enterprise_pass_enabled": { "const": false },
        "protected_closeout_enabled": { "const": false },
        "deployment_allowed_now": { "const": false },
        "release_approval_allowed_now": { "const": false },
        "write_action_allowed_now": { "const": false },
        "protected_action_allowed_now": { "const": false },
        "connector_write_enabled": { "const": false },
        "runtime_execution_allowed_now": { "const": false },
        "raw_body_exposure_allowed": { "const": false },
        "secret_read_allowed_now": { "const": false },
        "final_approval_ui_enabled": { "const": false },
        "codex_final_approval_ui_enabled": { "const": false },
        "claude_final_approval_ui_enabled": { "const": false },
        "unsafe_flag_count": { "const": 0 }
      }
    },
    "validation": {
      "type": "object",
      "required": ["valid", "error_count", "errors"],
      "properties": {
        "valid": { "type": "boolean" },
        "error_count": { "type": "integer", "minimum": 0 },
        "errors": { "type": "array" }
      }
    },
    "summary": {
      "type": "object",
      "required": [
        "enterprise_trust_hardening_control_plane_status",
        "program_range",
        "source_ready_for_p13001_handoff",
        "source_block_visible_now",
        "claude_enterprise_trust_review_receipt_present_now",
        "claude_enterprise_trust_review_block_visible_now",
        "independent_review_hardening_row_count",
        "attestation_hardening_row_count",
        "sbom_dependency_evidence_row_count",
        "p13400_enterprise_trust_hardening_freeze_ready",
        "ready_for_p13401_handoff",
        "enterprise_trust_claim_allowed_now",
        "production_pass_enabled",
        "enterprise_pass_enabled",
        "protected_closeout_enabled",
        "deployment_allowed_now",
        "validation_error_count"
      ],
      "properties": {
        "enterprise_trust_hardening_control_plane_status": {
          "enum": [
            "ready_for_enterprise_trust_hardening_control_plane",
            "blocked_enterprise_trust_hardening_control_plane"
          ]
        },
        "program_range": { "const": "P13001-P13400" },
        "source_ready_for_p13001_handoff": { "type": "boolean" },
        "source_block_visible_now": { "type": "boolean" },
        "claude_enterprise_trust_review_receipt_present_now": { "type": "boolean" },
        "claude_enterprise_trust_review_block_visible_now": { "type": "boolean" },
        "independent_review_hardening_row_count": { "type": "integer", "minimum": 6 },
        "attestation_hardening_row_count": { "type": "integer", "minimum": 6 },
        "sbom_dependency_evidence_row_count": { "type": "integer", "minimum": 6 },
        "p13400_enterprise_trust_hardening_freeze_ready": { "type": "boolean" },
        "ready_for_p13401_handoff": { "type": "boolean" },
        "enterprise_trust_claim_allowed_now": { "const": false },
        "production_pass_enabled": { "const": false },
        "enterprise_pass_enabled": { "const": false },
        "protected_closeout_enabled": { "const": false },
        "deployment_allowed_now": { "const": false }
      }
    }
  },
  "$defs": {
    "verdictRow": {
      "type": "object",
      "required": [
        "row_id",
        "category",
        "label",
        "required",
        "observed",
        "evidence_ref",
        "current_verdict"
      ],
      "properties": {
        "row_id": { "type": "string", "minLength": 1 },
        "category": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "required": { "type": "boolean" },
        "observed": { "type": "boolean" },
        "evidence_ref": { "type": "string", "minLength": 1 },
        "current_verdict": { "enum": ["pass", "blocked"] },
        "block_reason": { "type": ["string", "null"] }
      }
    }
  }
}
