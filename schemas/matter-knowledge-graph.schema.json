{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/matter-knowledge-graph.schema.json",
  "title": "Hermes Matter Knowledge Graph",
  "type": "object",
  "required": [
    "schema_version",
    "generated_at",
    "matter_knowledge_graph_id",
    "matter_knowledge_graph_status",
    "safe_handling",
    "inputs",
    "source_contracts",
    "matter_knowledge_graph_contract",
    "graph_nodes",
    "graph_edges",
    "matter_knowledge_summaries",
    "matter_knowledge_graph_desktop_boundary",
    "matter_knowledge_graph_checkpoints",
    "validation_items",
    "validation",
    "summary"
  ],
  "properties": {
    "schema_version": { "const": "matter-knowledge-graph.v1" },
    "generated_at": { "type": "string", "minLength": 1 },
    "matter_knowledge_graph_id": { "type": "string", "minLength": 1 },
    "output_dir": { "type": "string" },
    "matter_knowledge_graph_status": { "enum": ["complete", "blocked"] },
    "safe_handling": { "$ref": "#/$defs/safe_handling" },
    "inputs": { "type": "object" },
    "source_contracts": { "type": "object" },
    "matter_knowledge_graph_contract": { "$ref": "#/$defs/contract" },
    "graph_nodes": { "type": "array", "items": { "$ref": "#/$defs/node" } },
    "graph_edges": { "type": "array", "items": { "$ref": "#/$defs/edge" } },
    "matter_knowledge_summaries": { "type": "array", "items": { "$ref": "#/$defs/matter_summary" } },
    "matter_knowledge_graph_desktop_boundary": { "$ref": "#/$defs/desktop_boundary" },
    "matter_knowledge_graph_checkpoints": { "type": "array", "items": { "$ref": "#/$defs/checkpoint" } },
    "validation_items": { "type": "array", "items": { "$ref": "#/$defs/validation_item" } },
    "validation": { "$ref": "#/$defs/validation" },
    "summary": { "$ref": "#/$defs/summary" }
  },
  "$defs": {
    "safe_handling": {
      "type": "object",
      "required": [
        "report_only",
        "legal_advice_provided",
        "client_facing_output_generated",
        "attorney_review_required",
        "human_review_required",
        "matter_data_write_allowed",
        "task_state_write_allowed",
        "workflow_transition_allowed",
        "runtime_execution_performed",
        "delivery_execution_performed",
        "desktop_mutation_allowed",
        "desktop_source_of_truth",
        "protected_mutation_executed",
        "secret_material_exposed",
        "provider_key_visible"
      ],
      "properties": {
        "report_only": { "const": true },
        "legal_advice_provided": { "const": false },
        "client_facing_output_generated": { "const": false },
        "attorney_review_required": { "const": true },
        "human_review_required": { "const": true },
        "matter_data_write_allowed": { "const": false },
        "task_state_write_allowed": { "const": false },
        "workflow_transition_allowed": { "const": false },
        "runtime_execution_performed": { "const": false },
        "delivery_execution_performed": { "const": false },
        "desktop_mutation_allowed": { "const": false },
        "desktop_source_of_truth": { "const": false },
        "protected_mutation_executed": { "const": false },
        "secret_material_exposed": { "const": false },
        "provider_key_visible": { "const": false }
      }
    },
    "contract": {
      "type": "object",
      "required": [
        "schema_version",
        "contract_id",
        "source_of_truth",
        "graph_rule",
        "legal_theory_rule",
        "evidence_rule",
        "matter_boundary_rule",
        "attorney_review_rule",
        "desktop_companion_rule",
        "mutation_policy",
        "created_at"
      ],
      "properties": {
        "schema_version": { "const": "matter-knowledge-graph-contract.v1" },
        "contract_id": { "const": "matter-knowledge-graph.v1" },
        "source_of_truth": { "const": "matter_files_timeline_document_index_task_board_and_output_artifacts" },
        "graph_rule": { "type": "string" },
        "legal_theory_rule": { "type": "string" },
        "evidence_rule": { "type": "string" },
        "matter_boundary_rule": { "type": "string" },
        "attorney_review_rule": { "type": "string" },
        "desktop_companion_rule": { "type": "string" },
        "mutation_policy": { "type": "string" },
        "created_at": { "type": "string" }
      }
    },
    "node": {
      "type": "object",
      "required": [
        "schema_version",
        "node_id",
        "matter_id",
        "node_type",
        "label",
        "node_status",
        "source_kind",
        "source_id",
        "source_record_id",
        "review_status",
        "attorney_review_required",
        "human_review_required",
        "legal_advice_provided",
        "client_facing_output_generated",
        "default_output_status",
        "confidence",
        "created_at",
        "metadata"
      ],
      "properties": {
        "schema_version": { "const": "matter-knowledge-node.v1" },
        "node_id": { "type": "string", "minLength": 1 },
        "matter_id": { "type": "string", "minLength": 1 },
        "node_type": { "enum": ["matter", "fact", "issue", "legal_theory", "evidence"] },
        "label": { "type": "string", "minLength": 1 },
        "node_status": { "type": "string", "minLength": 1 },
        "source_kind": { "type": "string", "minLength": 1 },
        "source_id": { "type": "string", "minLength": 1 },
        "source_path": { "type": ["string", "null"] },
        "source_record_id": { "type": "string", "minLength": 1 },
        "review_status": { "const": "pending_review" },
        "attorney_review_required": { "const": true },
        "human_review_required": { "const": true },
        "legal_advice_provided": { "const": false },
        "client_facing_output_generated": { "const": false },
        "default_output_status": { "const": "pending_review" },
        "confidence": { "type": "string", "minLength": 1 },
        "created_at": { "type": "string" },
        "metadata": { "type": "object" }
      }
    },
    "edge": {
      "type": "object",
      "required": [
        "schema_version",
        "edge_id",
        "matter_id",
        "from_node_id",
        "to_node_id",
        "edge_type",
        "label",
        "edge_status",
        "review_status",
        "attorney_review_required",
        "human_review_required",
        "legal_advice_provided",
        "client_facing_output_generated",
        "protected_action_allowed",
        "runtime_execution_allowed",
        "delivery_execution_allowed",
        "created_at",
        "metadata"
      ],
      "properties": {
        "schema_version": { "const": "matter-knowledge-edge.v1" },
        "edge_id": { "type": "string", "minLength": 1 },
        "matter_id": { "type": "string", "minLength": 1 },
        "from_node_id": { "type": "string", "minLength": 1 },
        "to_node_id": { "type": "string", "minLength": 1 },
        "edge_type": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "edge_status": { "const": "active" },
        "review_status": { "const": "pending_review" },
        "attorney_review_required": { "const": true },
        "human_review_required": { "const": true },
        "legal_advice_provided": { "const": false },
        "client_facing_output_generated": { "const": false },
        "protected_action_allowed": { "const": false },
        "runtime_execution_allowed": { "const": false },
        "delivery_execution_allowed": { "const": false },
        "sequence_number": { "type": "integer", "minimum": 1 },
        "created_at": { "type": "string" },
        "metadata": { "type": "object" }
      }
    },
    "matter_summary": {
      "type": "object",
      "required": [
        "schema_version",
        "matter_id",
        "matter_title",
        "source_id",
        "matter_knowledge_status",
        "graph_node_count",
        "graph_edge_count",
        "fact_node_count",
        "issue_node_count",
        "legal_theory_node_count",
        "evidence_node_count",
        "matter_id_scoped_node_count",
        "attorney_review_required_node_count",
        "human_review_required_node_count",
        "legal_advice_provided",
        "client_facing_output_generated",
        "created_at"
      ],
      "properties": {
        "schema_version": { "const": "matter-knowledge-summary.v1" },
        "matter_id": { "type": "string", "minLength": 1 },
        "matter_title": { "type": "string", "minLength": 1 },
        "source_id": { "type": "string", "minLength": 1 },
        "source_path": { "type": "string" },
        "matter_knowledge_status": { "const": "complete" },
        "graph_node_count": { "type": "integer", "minimum": 1 },
        "graph_edge_count": { "type": "integer", "minimum": 0 },
        "fact_node_count": { "type": "integer", "minimum": 1 },
        "issue_node_count": { "type": "integer", "minimum": 1 },
        "legal_theory_node_count": { "type": "integer", "minimum": 1 },
        "evidence_node_count": { "type": "integer", "minimum": 1 },
        "matter_id_scoped_node_count": { "type": "integer", "minimum": 1 },
        "attorney_review_required_node_count": { "type": "integer", "minimum": 1 },
        "human_review_required_node_count": { "type": "integer", "minimum": 1 },
        "legal_advice_provided": { "const": false },
        "client_facing_output_generated": { "const": false },
        "created_at": { "type": "string" }
      }
    },
    "desktop_boundary": {
      "type": "object",
      "required": [
        "schema_version",
        "boundary_status",
        "read_only",
        "mutation_allowed",
        "source_of_truth",
        "matter_data_write_allowed",
        "task_state_write_allowed",
        "workflow_transition_allowed",
        "runtime_execution_allowed",
        "delivery_execution_allowed",
        "protected_action_allowed",
        "legal_advice_allowed",
        "client_facing_output_allowed_without_attorney_review",
        "allowed_operations",
        "blocked_operations",
        "created_at"
      ],
      "properties": {
        "schema_version": { "const": "matter-knowledge-graph-desktop-boundary.v1" },
        "boundary_status": { "const": "enforced" },
        "read_only": { "const": true },
        "mutation_allowed": { "const": false },
        "source_of_truth": { "const": false },
        "matter_data_write_allowed": { "const": false },
        "task_state_write_allowed": { "const": false },
        "workflow_transition_allowed": { "const": false },
        "runtime_execution_allowed": { "const": false },
        "delivery_execution_allowed": { "const": false },
        "protected_action_allowed": { "const": false },
        "legal_advice_allowed": { "const": false },
        "client_facing_output_allowed_without_attorney_review": { "const": false },
        "allowed_operations": { "type": "array", "items": { "type": "string" } },
        "blocked_operations": { "type": "array", "items": { "type": "string" } },
        "created_at": { "type": "string" }
      }
    },
    "checkpoint": {
      "type": "object",
      "required": ["checkpoint_id", "checkpoint_status", "status", "message"],
      "properties": {
        "checkpoint_id": { "type": "string", "minLength": 1 },
        "checkpoint_status": { "enum": ["passed", "failed"] },
        "status": { "enum": ["passed", "failed"] },
        "message": { "type": "string" }
      }
    },
    "validation_item": {
      "type": "object",
      "required": ["path", "check_id", "status", "message"],
      "properties": {
        "path": { "type": "string" },
        "check_id": { "type": "string" },
        "status": { "enum": ["passed", "failed"] },
        "message": { "type": "string" }
      }
    },
    "validation": {
      "type": "object",
      "required": ["valid", "errors"],
      "properties": {
        "valid": { "type": "boolean" },
        "errors": { "type": "array" }
      }
    },
    "summary": {
      "type": "object",
      "required": [
        "matter_knowledge_graph_status",
        "matter_knowledge_graph_contract_id",
        "source_of_truth",
        "matter_count",
        "graph_node_count",
        "graph_edge_count",
        "fact_node_count",
        "issue_node_count",
        "legal_theory_node_count",
        "evidence_node_count",
        "legal_advice_provided",
        "client_facing_output_generated",
        "desktop_boundary_status",
        "desktop_read_only",
        "desktop_mutation_allowed",
        "matter_data_write_allowed",
        "task_state_write_allowed",
        "workflow_transition_allowed",
        "runtime_execution_allowed",
        "delivery_execution_allowed",
        "protected_action_allowed",
        "validation_error_count"
      ],
      "properties": {
        "matter_knowledge_graph_status": { "enum": ["complete", "blocked"] },
        "matter_knowledge_graph_contract_id": { "const": "matter-knowledge-graph.v1" },
        "source_of_truth": { "const": "matter_files_timeline_document_index_task_board_and_output_artifacts" },
        "source_matter_task_board_status": { "type": "string" },
        "source_matter_document_index_status": { "type": "string" },
        "source_matter_timeline_status": { "type": "string" },
        "source_matter_os_profile_status": { "type": "string" },
        "source_output_catalog_status": { "type": "string" },
        "source_delivery_queue_status": { "type": "string" },
        "matter_file_count": { "type": "integer", "minimum": 0 },
        "available_matter_file_count": { "type": "integer", "minimum": 0 },
        "matter_count": { "type": "integer", "minimum": 0 },
        "matter_summary_count": { "type": "integer", "minimum": 0 },
        "graph_node_count": { "type": "integer", "minimum": 0 },
        "graph_edge_count": { "type": "integer", "minimum": 0 },
        "matter_node_count": { "type": "integer", "minimum": 0 },
        "fact_node_count": { "type": "integer", "minimum": 0 },
        "issue_node_count": { "type": "integer", "minimum": 0 },
        "legal_theory_node_count": { "type": "integer", "minimum": 0 },
        "evidence_node_count": { "type": "integer", "minimum": 0 },
        "legal_advice_provided": { "const": false },
        "client_facing_output_generated": { "const": false },
        "desktop_boundary_status": { "type": "string" },
        "desktop_read_only": { "type": "boolean" },
        "desktop_mutation_allowed": { "type": "boolean" },
        "matter_data_write_allowed": { "type": "boolean" },
        "task_state_write_allowed": { "type": "boolean" },
        "workflow_transition_allowed": { "type": "boolean" },
        "runtime_execution_allowed": { "type": "boolean" },
        "delivery_execution_allowed": { "type": "boolean" },
        "protected_action_allowed": { "type": "boolean" },
        "validation_error_count": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
