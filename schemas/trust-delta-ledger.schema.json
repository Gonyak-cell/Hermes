{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hermes.local/schemas/trust-delta-ledger.schema.json",
  "title": "Hermes Trust Delta Ledger",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "capability_id",
    "program_range",
    "source_program_range",
    "trust_delta_contract",
    "trust_delta_phase_rows",
    "trust_source_binding_rows",
    "trust_baseline_snapshot_rows",
    "evidence_quality_delta_rows",
    "review_finding_delta_rows",
    "validation_freshness_delta_rows",
    "authority_boundary_delta_rows",
    "operator_trust_projection_rows",
    "trust_debt_ledger_rows",
    "p18001_handoff_gate_rows",
    "p18000_freeze_rows",
    "trust_delta_boundary",
    "trust_delta_validation_items",
    "validation",
    "summary"
  ],
  "properties": {
    "schema_version": { "const": "trust-delta-ledger.v1" },
    "capability_id": { "const": "platform.trust_delta_ledger" },
    "program_range": { "const": "P17601-P18000" },
    "source_program_range": { "const": "P17201-P17600" },
    "trust_delta_phase_rows": { "type": "array", "minItems": 10, "items": { "$ref": "#/$defs/verdictRow" } },
    "trust_source_binding_rows": { "type": "array", "minItems": 6, "items": { "$ref": "#/$defs/verdictRow" } },
    "trust_baseline_snapshot_rows": { "type": "array", "minItems": 6, "items": { "$ref": "#/$defs/verdictRow" } },
    "evidence_quality_delta_rows": { "type": "array", "minItems": 6, "items": { "$ref": "#/$defs/verdictRow" } },
    "review_finding_delta_rows": { "type": "array", "minItems": 6, "items": { "$ref": "#/$defs/verdictRow" } },
    "validation_freshness_delta_rows": { "type": "array", "minItems": 6, "items": { "$ref": "#/$defs/verdictRow" } },
    "authority_boundary_delta_rows": { "type": "array", "minItems": 6, "items": { "$ref": "#/$defs/verdictRow" } },
    "operator_trust_projection_rows": { "type": "array", "minItems": 6, "items": { "$ref": "#/$defs/verdictRow" } },
    "trust_debt_ledger_rows": { "type": "array", "minItems": 6, "items": { "$ref": "#/$defs/verdictRow" } },
    "p18001_handoff_gate_rows": { "type": "array", "minItems": 6, "items": { "$ref": "#/$defs/verdictRow" } },
    "p18000_freeze_rows": { "type": "array", "minItems": 6, "items": { "$ref": "#/$defs/verdictRow" } },
    "trust_delta_boundary": {
      "type": "object",
      "required": [
        "source_p17600_available",
        "source_p17600_ready_for_p17601_handoff",
        "source_block_visible_now",
        "trust_debt_count",
        "unresolved_finding_count",
        "blocking_finding_count",
        "validation_blocked_now",
        "full_suite_debt_present_now",
        "p18001_handoff_gate_ready",
        "ready_for_p18001_handoff",
        "deployment_allowed_now",
        "release_approval_allowed_now",
        "production_pass_enabled",
        "enterprise_pass_enabled",
        "enterprise_trust_claim_allowed_now",
        "protected_closeout_enabled",
        "human_gate_bypass_allowed_now",
        "independent_review_bypass_allowed_now",
        "single_owner_enterprise_trust_allowed_now",
        "environment_config_write_allowed_now",
        "migration_execution_allowed_now",
        "rollback_execution_allowed_now",
        "runtime_execution_allowed_now",
        "write_action_allowed_now",
        "protected_action_allowed_now",
        "connector_write_enabled",
        "external_service_mutation_allowed_now",
        "secret_read_allowed_now",
        "raw_source_exposure_allowed",
        "reviewer_mutation_allowed_now",
        "final_approval_ui_enabled",
        "codex_final_approval_ui_enabled",
        "claude_final_approval_ui_enabled",
        "unsafe_flag_count"
      ],
      "properties": {
        "source_p17600_available": { "type": "boolean" },
        "source_p17600_ready_for_p17601_handoff": { "type": "boolean" },
        "source_block_visible_now": { "type": "boolean" },
        "trust_debt_count": { "type": "integer", "minimum": 0 },
        "unresolved_finding_count": { "type": "integer", "minimum": 0 },
        "blocking_finding_count": { "type": "integer", "minimum": 0 },
        "validation_blocked_now": { "type": "boolean" },
        "full_suite_debt_present_now": { "type": "boolean" },
        "p18001_handoff_gate_ready": { "type": "boolean" },
        "ready_for_p18001_handoff": { "type": "boolean" },
        "deployment_allowed_now": { "const": false },
        "release_approval_allowed_now": { "const": false },
        "production_pass_enabled": { "const": false },
        "enterprise_pass_enabled": { "const": false },
        "enterprise_trust_claim_allowed_now": { "const": false },
        "protected_closeout_enabled": { "const": false },
        "human_gate_bypass_allowed_now": { "const": false },
        "independent_review_bypass_allowed_now": { "const": false },
        "single_owner_enterprise_trust_allowed_now": { "const": false },
        "environment_config_write_allowed_now": { "const": false },
        "migration_execution_allowed_now": { "const": false },
        "rollback_execution_allowed_now": { "const": false },
        "runtime_execution_allowed_now": { "const": false },
        "write_action_allowed_now": { "const": false },
        "protected_action_allowed_now": { "const": false },
        "connector_write_enabled": { "const": false },
        "external_service_mutation_allowed_now": { "const": false },
        "secret_read_allowed_now": { "const": false },
        "raw_source_exposure_allowed": { "const": false },
        "reviewer_mutation_allowed_now": { "const": false },
        "final_approval_ui_enabled": { "const": false },
        "codex_final_approval_ui_enabled": { "const": false },
        "claude_final_approval_ui_enabled": { "const": false },
        "unsafe_flag_count": { "const": 0 }
      }
    },
    "validation": {
      "type": "object",
      "required": ["valid", "error_count", "errors"],
      "properties": {
        "valid": { "type": "boolean" },
        "error_count": { "type": "integer", "minimum": 0 },
        "errors": { "type": "array" }
      }
    },
    "summary": {
      "type": "object",
      "required": [
        "trust_delta_ledger_status",
        "program_range",
        "source_p17600_ready_for_p17601_handoff",
        "trust_debt_count",
        "unresolved_finding_count",
        "blocking_finding_count",
        "validation_blocked_now",
        "full_suite_debt_present_now",
        "ready_for_p18001_handoff",
        "deployment_allowed_now",
        "release_approval_allowed_now",
        "production_pass_enabled",
        "enterprise_pass_enabled",
        "enterprise_trust_claim_allowed_now",
        "validation_error_count"
      ],
      "properties": {
        "trust_delta_ledger_status": {
          "enum": ["ready_for_trust_delta_ledger", "blocked_trust_delta_ledger"]
        },
        "program_range": { "const": "P17601-P18000" },
        "deployment_allowed_now": { "const": false },
        "release_approval_allowed_now": { "const": false },
        "production_pass_enabled": { "const": false },
        "enterprise_pass_enabled": { "const": false },
        "enterprise_trust_claim_allowed_now": { "const": false }
      }
    }
  },
  "$defs": {
    "verdictRow": {
      "type": "object",
      "required": ["row_id", "category", "label", "required", "observed", "evidence_ref", "current_verdict"],
      "properties": {
        "row_id": { "type": "string", "minLength": 1 },
        "category": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "required": { "type": "boolean" },
        "observed": { "type": "boolean" },
        "evidence_ref": { "type": "string", "minLength": 1 },
        "current_verdict": { "enum": ["pass", "blocked"] },
        "block_reason": { "type": ["string", "null"] }
      }
    }
  }
}
