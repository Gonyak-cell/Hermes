{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/hermes/dev-projects.schema.json",
  "title": "Developer Project Portfolio",
  "type": "object",
  "required": [
    "owner",
    "generated_on",
    "review_cadence",
    "projects"
  ],
  "properties": {
    "owner": {
      "type": "string"
    },
    "generated_on": {
      "type": "string",
      "format": "date"
    },
    "review_cadence": {
      "type": "string",
      "enum": [
        "daily",
        "weekly",
        "ad-hoc"
      ]
    },
    "projects": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/project"
      }
    }
  },
  "$defs": {
    "project": {
      "type": "object",
      "required": [
        "id",
        "name",
        "status",
        "priority",
        "repository",
        "north_star",
        "next_milestone",
        "tasks"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": [
            "active",
            "paused",
            "blocked",
            "maintenance",
            "shipped"
          ]
        },
        "priority": {
          "type": "string",
          "enum": [
            "p0",
            "p1",
            "p2",
            "p3"
          ]
        },
        "repository": {
          "type": "string"
        },
        "north_star": {
          "type": "string"
        },
        "next_milestone": {
          "$ref": "#/$defs/milestone"
        },
        "tasks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/task"
          }
        },
        "risks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/risk"
          }
        },
        "decisions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/decision"
          }
        },
        "release": {
          "$ref": "#/$defs/release"
        },
        "links": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/link"
          }
        }
      }
    },
    "milestone": {
      "type": "object",
      "required": [
        "name",
        "due",
        "success_criteria"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "due": {
          "type": "string",
          "format": "date"
        },
        "success_criteria": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "task": {
      "type": "object",
      "required": [
        "id",
        "title",
        "status",
        "priority",
        "due",
        "estimate_minutes"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": [
            "next",
            "in-progress",
            "blocked",
            "review",
            "done",
            "backlog"
          ]
        },
        "priority": {
          "type": "string",
          "enum": [
            "p0",
            "p1",
            "p2",
            "p3"
          ]
        },
        "due": {
          "type": "string",
          "format": "date"
        },
        "estimate_minutes": {
          "type": "integer",
          "minimum": 0
        },
        "context": {
          "type": "string"
        },
        "blocker": {
          "type": "string"
        },
        "acceptance": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "risk": {
      "type": "object",
      "required": [
        "id",
        "title",
        "severity",
        "status"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "severity": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "open",
            "watching",
            "mitigated"
          ]
        },
        "mitigation": {
          "type": "string"
        }
      }
    },
    "decision": {
      "type": "object",
      "required": [
        "id",
        "date",
        "decision"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "date": {
          "type": "string",
          "format": "date"
        },
        "decision": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        }
      }
    },
    "release": {
      "type": "object",
      "properties": {
        "target": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "checklist": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/release_check"
          }
        }
      }
    },
    "release_check": {
      "type": "object",
      "required": [
        "name",
        "status"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": [
            "todo",
            "done",
            "blocked"
          ]
        }
      }
    },
    "link": {
      "type": "object",
      "required": [
        "label",
        "url"
      ],
      "properties": {
        "label": {
          "type": "string"
        },
        "url": {
          "type": "string"
        }
      }
    }
  }
}
