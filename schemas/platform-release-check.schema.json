{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hermes.local/schemas/platform-release-check.schema.json",
  "title": "Platform Release Check",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "generated_at",
    "platform_release_check_id",
    "capability_id",
    "release_check_anchor",
    "source_rows",
    "release_check_command_rows",
    "release_check_gate_rows",
    "release_check_boundary",
    "validation_items",
    "validation",
    "summary"
  ],
  "properties": {
    "schema_version": { "const": "platform-release-check.v1" },
    "platform_release_check_id": {
      "type": "string",
      "pattern": "^platform-release-check\\.[0-9]{8}$"
    },
    "capability_id": { "const": "platform.release_check" },
    "release_check_anchor": {
      "type": "object",
      "required": ["phase_slot", "previous_phase_slot", "next_phase_slot", "command_count"],
      "properties": {
        "phase_slot": { "const": "P363" },
        "previous_phase_slot": { "const": "P362" },
        "next_phase_slot": { "const": "P364" },
        "command_count": { "minimum": 6 }
      }
    },
    "source_rows": {
      "type": "array",
      "minItems": 10,
      "items": {
        "type": "object",
        "required": ["phase_slot", "source_status", "human_review_required"],
        "properties": {
          "phase_slot": { "const": "P363" },
          "source_status": { "const": "ready" },
          "human_review_required": { "const": true }
        }
      }
    },
    "release_check_command_rows": {
      "type": "array",
      "minItems": 6,
      "items": {
        "type": "object",
        "required": [
          "phase_slot",
          "release_check_command_status",
          "executed_by_release_check",
          "child_command_guarded",
          "mutation_allowed_by_release_check",
          "artifact_write_allowed_by_child_command",
          "protected_action_allowed_by_release_check",
          "release_publication_allowed_by_release_check",
          "git_operation_allowed_by_release_check",
          "trading_order_submission_allowed_by_release_check",
          "broker_write_allowed_by_release_check",
          "exchange_write_allowed_by_release_check",
          "human_review_required"
        ],
        "properties": {
          "phase_slot": { "const": "P363" },
          "release_check_command_status": { "const": "passed" },
          "executed_by_release_check": { "const": true },
          "child_command_guarded": { "const": true },
          "mutation_allowed_by_release_check": { "const": false },
          "artifact_write_allowed_by_child_command": { "const": false },
          "protected_action_allowed_by_release_check": { "const": false },
          "release_publication_allowed_by_release_check": { "const": false },
          "git_operation_allowed_by_release_check": { "const": false },
          "trading_order_submission_allowed_by_release_check": { "const": false },
          "broker_write_allowed_by_release_check": { "const": false },
          "exchange_write_allowed_by_release_check": { "const": false },
          "human_review_required": { "const": true }
        }
      }
    },
    "release_check_gate_rows": {
      "type": "array",
      "minItems": 11,
      "items": {
        "type": "object",
        "required": [
          "phase_slot",
          "gate_status",
          "protected_action_executed_by_release_check",
          "release_published_by_release_check",
          "git_operation_performed_by_release_check",
          "trading_order_submission_performed_by_release_check",
          "broker_write_performed_by_release_check",
          "exchange_write_performed_by_release_check",
          "human_review_required"
        ],
        "properties": {
          "phase_slot": { "const": "P363" },
          "gate_status": { "const": "ready" },
          "protected_action_executed_by_release_check": { "const": false },
          "release_published_by_release_check": { "const": false },
          "git_operation_performed_by_release_check": { "const": false },
          "trading_order_submission_performed_by_release_check": { "const": false },
          "broker_write_performed_by_release_check": { "const": false },
          "exchange_write_performed_by_release_check": { "const": false },
          "human_review_required": { "const": true }
        }
      }
    },
    "release_check_boundary": {
      "type": "object",
      "required": [
        "boundary_status",
        "phase_slot",
        "control_plane_only",
        "command_execution_performed",
        "package_command_execution_performed",
        "release_check_execution_performed",
        "child_commands_guarded",
        "child_artifact_write_allowed",
        "dependency_install_performed",
        "package_mutation_performed",
        "lockfile_mutation_performed",
        "artifact_regeneration_performed",
        "protected_action_executed",
        "approval_applied",
        "release_published",
        "git_operation_performed",
        "trading_live_enabled",
        "trading_full_auto_enabled",
        "trading_order_submission_allowed",
        "automatic_order_submission_allowed",
        "live_order_submission_allowed",
        "broker_write_allowed",
        "exchange_write_allowed",
        "desktop_source_of_truth",
        "human_review_required",
        "human_review_note"
      ],
      "properties": {
        "boundary_status": { "const": "enforced" },
        "phase_slot": { "const": "P363" },
        "control_plane_only": { "const": true },
        "command_execution_performed": { "const": true },
        "package_command_execution_performed": { "const": true },
        "release_check_execution_performed": { "const": true },
        "child_commands_guarded": { "const": true },
        "child_artifact_write_allowed": { "const": false },
        "dependency_install_performed": { "const": false },
        "package_mutation_performed": { "const": false },
        "lockfile_mutation_performed": { "const": false },
        "artifact_regeneration_performed": { "const": false },
        "protected_action_executed": { "const": false },
        "approval_applied": { "const": false },
        "release_published": { "const": false },
        "git_operation_performed": { "const": false },
        "trading_live_enabled": { "const": false },
        "trading_full_auto_enabled": { "const": false },
        "trading_order_submission_allowed": { "const": false },
        "automatic_order_submission_allowed": { "const": false },
        "live_order_submission_allowed": { "const": false },
        "broker_write_allowed": { "const": false },
        "exchange_write_allowed": { "const": false },
        "desktop_source_of_truth": { "const": false },
        "human_review_required": { "const": true },
        "human_review_note": { "type": "string", "minLength": 1 }
      }
    },
    "summary": {
      "type": "object",
      "required": [
        "platform_release_check_status",
        "phase_slot",
        "previous_phase_slot",
        "next_phase_slot",
        "command_count",
        "passed_command_count",
        "release_check_gate_count",
        "ready_release_check_gate_count",
        "command_execution_performed",
        "package_command_execution_performed",
        "release_check_execution_performed",
        "child_commands_guarded",
        "child_artifact_write_allowed",
        "dependency_install_performed",
        "package_mutation_performed",
        "lockfile_mutation_performed",
        "artifact_regeneration_performed",
        "protected_action_executed",
        "release_published",
        "git_operation_performed",
        "trading_live_enabled",
        "trading_full_auto_enabled",
        "trading_order_submission_allowed",
        "automatic_order_submission_allowed",
        "live_order_submission_allowed",
        "broker_write_allowed",
        "exchange_write_allowed",
        "desktop_source_of_truth",
        "human_review_required",
        "validation_error_count"
      ],
      "properties": {
        "platform_release_check_status": { "const": "complete" },
        "phase_slot": { "const": "P363" },
        "previous_phase_slot": { "const": "P362" },
        "next_phase_slot": { "const": "P364" },
        "command_count": { "minimum": 6 },
        "passed_command_count": { "minimum": 6 },
        "release_check_gate_count": { "minimum": 11 },
        "ready_release_check_gate_count": { "minimum": 11 },
        "command_execution_performed": { "const": true },
        "package_command_execution_performed": { "const": true },
        "release_check_execution_performed": { "const": true },
        "child_commands_guarded": { "const": true },
        "child_artifact_write_allowed": { "const": false },
        "dependency_install_performed": { "const": false },
        "package_mutation_performed": { "const": false },
        "lockfile_mutation_performed": { "const": false },
        "artifact_regeneration_performed": { "const": false },
        "protected_action_executed": { "const": false },
        "release_published": { "const": false },
        "git_operation_performed": { "const": false },
        "trading_live_enabled": { "const": false },
        "trading_full_auto_enabled": { "const": false },
        "trading_order_submission_allowed": { "const": false },
        "automatic_order_submission_allowed": { "const": false },
        "live_order_submission_allowed": { "const": false },
        "broker_write_allowed": { "const": false },
        "exchange_write_allowed": { "const": false },
        "desktop_source_of_truth": { "const": false },
        "human_review_required": { "const": true },
        "validation_error_count": { "const": 0 }
      }
    }
  }
}
