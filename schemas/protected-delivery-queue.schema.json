{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://amic.local/hermes/protected-delivery-queue.schema.json",
  "title": "Hermes Protected Delivery Queue",
  "type": "object",
  "required": [
    "schema_version",
    "generated_at",
    "summary",
    "sources",
    "delivery_actions"
  ],
  "properties": {
    "schema_version": {
      "const": "protected-delivery-queue.v1"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "summary": {
      "type": "object",
      "required": [
        "output_catalog_available",
        "observability_catalog_available",
        "delivery_action_count",
        "protected_action_count",
        "blocked_action_count",
        "pending_approval_count",
        "blocked_by_gate_count",
        "ready_action_count",
        "delivered_action_count",
        "law_firm_action_count",
        "personal_dev_action_count",
        "creative_document_action_count",
        "total_runtime_seconds",
        "by_delivery_status",
        "by_delivery_channel",
        "by_delivery_target",
        "by_domain_pack"
      ],
      "properties": {
        "output_catalog_available": { "type": "boolean" },
        "observability_catalog_available": { "type": "boolean" },
        "delivery_action_count": { "type": "integer", "minimum": 0 },
        "protected_action_count": { "type": "integer", "minimum": 0 },
        "blocked_action_count": { "type": "integer", "minimum": 0 },
        "pending_approval_count": { "type": "integer", "minimum": 0 },
        "blocked_by_gate_count": { "type": "integer", "minimum": 0 },
        "ready_action_count": { "type": "integer", "minimum": 0 },
        "delivered_action_count": { "type": "integer", "minimum": 0 },
        "law_firm_action_count": { "type": "integer", "minimum": 0 },
        "personal_dev_action_count": { "type": "integer", "minimum": 0 },
        "creative_document_action_count": { "type": "integer", "minimum": 0 },
        "total_runtime_seconds": { "type": "number", "minimum": 0 },
        "by_delivery_status": { "type": "object" },
        "by_delivery_channel": { "type": "object" },
        "by_delivery_target": { "type": "object" },
        "by_domain_pack": { "type": "object" }
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "source_id",
          "label",
          "path",
          "available",
          "schema_version",
          "generated_at",
          "error"
        ],
        "properties": {
          "source_id": { "type": "string" },
          "label": { "type": "string" },
          "path": { "type": ["string", "null"] },
          "available": { "type": "boolean" },
          "schema_version": { "type": ["string", "null"] },
          "generated_at": { "type": ["string", "null"], "format": "date-time" },
          "error": { "type": ["string", "null"] }
        }
      }
    },
    "delivery_actions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "delivery_action_id",
          "artifact_id",
          "artifact_type",
          "artifact_uri",
          "domain_pack",
          "capability_id",
          "workflow_run_id",
          "tenant_id",
          "matter_id",
          "delivery_target",
          "delivery_channel",
          "delivery_status",
          "priority",
          "protected_action",
          "required_approval_id",
          "approval_status",
          "blocking_gate_ids",
          "blocked_reasons",
          "recommended_actions",
          "run_status",
          "runtime_seconds",
          "source_id",
          "source_label",
          "created_at",
          "metadata"
        ],
        "properties": {
          "delivery_action_id": { "type": "string" },
          "artifact_id": { "type": "string" },
          "artifact_type": { "type": "string" },
          "artifact_uri": { "type": "string" },
          "domain_pack": { "type": "string" },
          "capability_id": { "type": ["string", "null"] },
          "workflow_run_id": { "type": ["string", "null"] },
          "tenant_id": { "type": "string" },
          "matter_id": { "type": "string" },
          "delivery_target": { "type": "string" },
          "delivery_channel": { "type": "string" },
          "delivery_status": {
            "enum": [
              "draft_only",
              "blocked_pending_approval",
              "blocked_by_gate",
              "blocked_by_decision",
              "ready_for_delivery",
              "delivered"
            ]
          },
          "priority": {
            "enum": ["critical", "high", "medium", "low"]
          },
          "protected_action": { "type": "boolean" },
          "required_approval_id": { "type": ["string", "null"] },
          "approval_status": { "type": ["string", "null"] },
          "blocking_gate_ids": {
            "type": "array",
            "items": { "type": "string" }
          },
          "blocked_reasons": {
            "type": "array",
            "items": { "type": "string" }
          },
          "recommended_actions": {
            "type": "array",
            "items": { "type": "string" }
          },
          "run_status": { "type": ["string", "null"] },
          "runtime_seconds": { "type": "number", "minimum": 0 },
          "source_id": { "type": "string" },
          "source_label": { "type": "string" },
          "created_at": { "type": "string", "format": "date-time" },
          "metadata": { "type": "object" }
        }
      }
    }
  }
}
