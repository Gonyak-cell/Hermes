    "protected_action_rows",
    "rollback_target_rows",
    "protected_work_order_rows",
    "fail_closed_fixture_rows",
    "next_action_rows",
    "protected_action_rollback_closeout_rows",
    "protected_action_rollback_gate_rows",
    "validation_items",
    "validation",
    "summary"
  ],
  "properties": {
    "schema_version": { "const": "zendd-protected-action-rollback.v1" },
    "generated_at": { "type": "string", "format": "date-time" },
