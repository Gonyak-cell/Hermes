{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hermes.local/schemas/zendd-safe-patch-lane.schema.json",
  "title": "Zendd Safe Patch Lane",
  "type": "object",
  "required": [
