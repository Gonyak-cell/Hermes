      "type": "object",
      "required": ["valid", "error_count", "errors"],
      "properties": {
        "valid": { "const": true },
        "error_count": { "const": 0 }
      },
      "additionalProperties": true
    },
    "summary": {
      "type": "object",
      "required": [
        "work_os_goal_drilldown_surface_status",
        "program_range",
        "source_program_range",
        "ready_for_p9401_handoff",
        "validation_error_count"
      ],
      "properties": {
        "work_os_goal_drilldown_surface_status": { "const": "ready_for_work_os_goal_drilldown_surface" },
        "program_range": { "const": "P9201-P9400" },
        "source_program_range": { "const": "P9001-P9200" },
        "ready_for_p9401_handoff": { "const": true },
        "validation_error_count": { "const": 0 }
      },
      "additionalProperties": true
    }
  },
  "$defs": {
    "row": {
      "type": "object",
      "required": ["schema_version", "row_id", "current_verdict", "unsafe_flags_false", "verdict_authority"],
      "properties": {
        "current_verdict": { "const": "pass" },
        "unsafe_flags_false": { "const": true },
        "verdict_authority": { "const": "harness_deterministic_validator" }
      },
      "additionalProperties": true
    },
    "goalRow": {
      "allOf": [
        { "$ref": "#/$defs/row" },
        {
          "type": "object",
          "required": [
            "project_id",
            "goal_id",
            "goal_name",
            "phase_range",
            "claim_ref",
            "evidence_ref",
            "gate_ref",
            "check_ref",
            "review_receipt_ref",
            "read_only",
            "protected_action_enabled",
            "codex_final_approval_allowed",
            "claude_final_approval_allowed"
          ],
          "properties": {
            "read_only": { "const": true },
            "protected_action_enabled": { "const": false },
            "codex_final_approval_allowed": { "const": false },
            "claude_final_approval_allowed": { "const": false }
          },
          "additionalProperties": true
        }
      ]
    },
    "nextActionRow": {
      "allOf": [
        { "$ref": "#/$defs/row" },
        {
          "type": "object",
          "required": ["action_id", "protected_action", "mutates_state", "requires_human_gate_completion", "read_only"],
          "properties": {
            "protected_action": { "const": false },
            "mutates_state": { "const": false },
            "requires_human_gate_completion": { "const": false },
            "read_only": { "const": true }
          },
          "additionalProperties": true
        }
