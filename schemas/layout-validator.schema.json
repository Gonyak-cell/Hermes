{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hermes.local/schemas/layout-validator.schema.json",
  "title": "Creative Document Layout Validator",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "generated_at",
    "layout_validator_id",
    "layout_validator_status",
    "safe_handling",
    "layout_validator_contract",
    "layout_validator_boundary",
    "layout_targets",
    "layout_validation_results",
    "layout_validation_checks",
    "validation_items",
    "validation",
    "summary"
  ],
  "properties": {
    "schema_version": { "const": "layout-validator.v1" },
    "generated_at": { "type": "string", "minLength": 1 },
    "layout_validator_id": { "type": "string", "minLength": 1 },
    "layout_validator_status": { "const": "complete" },
    "safe_handling": {
      "type": "object",
      "required": [
        "report_only",
        "layout_validator_generated",
        "layout_validation_report_only",
        "renderer_execution_performed",
        "document_renderer_runtime_execution_performed",
        "external_renderer_execution_performed",
        "network_access_performed",
        "artifact_write_performed",
        "source_attribution_required",
        "citation_review_required",
        "human_review_required",
        "attorney_review_required",
        "format_validation_required",
        "legal_advice_generated",
        "delivery_execution_performed",
        "protected_mutation_performed",
        "core_registry_mutation_performed",
        "client_facing_output_generated"
      ],
      "properties": {
        "report_only": { "const": true },
        "layout_validator_generated": { "const": true },
        "layout_validation_report_only": { "const": true },
        "renderer_execution_performed": { "const": false },
        "document_renderer_runtime_execution_performed": { "const": false },
        "external_renderer_execution_performed": { "const": false },
        "network_access_performed": { "const": false },
        "artifact_write_performed": { "const": true },
        "source_attribution_required": { "const": true },
        "citation_review_required": { "const": true },
        "human_review_required": { "const": true },
        "attorney_review_required": { "const": true },
        "format_validation_required": { "const": true },
        "legal_advice_generated": { "const": false },
        "delivery_execution_performed": { "const": false },
        "protected_mutation_performed": { "const": false },
        "core_registry_mutation_performed": { "const": false },
        "client_facing_output_generated": { "const": false }
      }
    },
    "layout_validator_contract": {
      "type": "object",
      "required": ["contract_id", "validator_scope", "required_source_renderers", "required_check_types"],
      "properties": {
        "contract_id": { "const": "layout-validator.v1" },
        "validator_scope": { "const": "creative_and_document_domain_pack_layout" },
        "required_source_renderers": {
          "type": "array",
          "contains": { "const": "docx_renderer" }
        },
        "required_check_types": {
          "type": "array",
          "contains": { "const": "broken_table" }
        }
      }
    },
    "layout_validator_boundary": {
      "type": "object",
      "required": [
        "boundary_status",
        "read_only_sources",
        "layout_validation_report_only",
        "renderer_execution_allowed",
        "document_renderer_runtime_execution_allowed",
        "external_renderer_execution_allowed",
        "network_access_allowed",
        "delivery_execution_allowed",
        "protected_action_allowed",
        "client_facing_output_generated",
        "client_facing_ready_count",
        "human_review_required",
        "attorney_review_required",
        "legal_advice_generated"
      ],
      "properties": {
        "boundary_status": { "const": "enforced" },
        "read_only_sources": { "const": true },
        "layout_validation_report_only": { "const": true },
        "renderer_execution_allowed": { "const": false },
        "document_renderer_runtime_execution_allowed": { "const": false },
        "external_renderer_execution_allowed": { "const": false },
        "network_access_allowed": { "const": false },
        "delivery_execution_allowed": { "const": false },
        "protected_action_allowed": { "const": false },
        "client_facing_output_generated": { "const": false },
        "client_facing_ready_count": { "const": 0 },
        "human_review_required": { "const": true },
        "attorney_review_required": { "const": true },
        "legal_advice_generated": { "const": false }
      }
    },
    "layout_targets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "layout_target_id",
          "source_renderer_id",
          "source_artifact_id",
          "output_format",
          "page_count",
          "max_page_count",
          "broken_table_count",
          "overflow_signal_count",
          "metadata_hash"
        ],
        "properties": {
          "source_renderer_id": { "enum": ["docx_renderer", "pptx_renderer", "pdf_html_renderer"] },
          "output_format": { "enum": ["docx", "pptx", "html", "pdf"] },
          "page_count": { "type": "integer", "minimum": 1 },
          "max_page_count": { "type": "integer", "minimum": 1 },
          "broken_table_count": { "const": 0 },
          "overflow_signal_count": { "const": 0 },
          "metadata_hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
        }
      }
    },
    "layout_validation_results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "layout_validation_result_id",
          "layout_target_id",
          "source_renderer_id",
          "output_format",
          "layout_validation_status",
          "page_count",
          "max_page_count",
          "broken_table_count",
          "overflow_signal_count",
          "failed_check_count",
          "checks",
          "human_review_required",
          "attorney_review_required",
          "legal_advice_generated",
          "delivery_execution_performed",
          "protected_action_executed",
          "client_facing_ready",
          "metadata_hash"
        ],
        "properties": {
          "layout_validation_status": { "const": "passed" },
          "failed_check_count": { "const": 0 },
          "checks": { "type": "array", "minItems": 5 },
          "human_review_required": { "const": true },
          "attorney_review_required": { "const": true },
          "legal_advice_generated": { "const": false },
          "delivery_execution_performed": { "const": false },
          "protected_action_executed": { "const": false },
          "client_facing_ready": { "const": false },
          "metadata_hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
        }
      }
    },
    "layout_validation_checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["layout_validation_check_id", "check_id", "check_type", "status"],
        "properties": {
          "check_type": { "enum": ["page_count", "overflow", "broken_table", "source_hash", "review_gate", "safety_gate"] },
          "status": { "const": "passed" }
        }
      }
    },
    "validation": {
      "type": "object",
      "required": ["valid", "errors"],
      "properties": {
        "valid": { "const": true },
        "errors": { "type": "array", "maxItems": 0 }
      }
    },
    "summary": {
      "type": "object",
      "required": [
        "layout_validator_status",
        "layout_validator_contract_id",
        "layout_target_count",
        "layout_validation_result_count",
        "passed_layout_validation_result_count",
        "page_count_check_count",
        "passed_page_count_check_count",
        "layout_overflow_check_count",
        "passed_layout_overflow_check_count",
        "broken_table_check_count",
        "passed_broken_table_check_count",
        "broken_table_count",
        "overflow_signal_count",
        "layout_validation_report_only",
        "renderer_execution_allowed",
        "delivery_execution_allowed",
        "legal_advice_generated",
        "client_facing_ready_count",
        "validation_error_count"
      ],
      "properties": {
        "layout_validator_status": { "const": "complete" },
        "layout_validator_contract_id": { "const": "layout-validator.v1" },
        "layout_target_count": { "type": "integer", "minimum": 1 },
        "layout_validation_result_count": { "type": "integer", "minimum": 1 },
        "passed_layout_validation_result_count": { "type": "integer", "minimum": 1 },
        "page_count_check_count": { "type": "integer", "minimum": 1 },
        "passed_page_count_check_count": { "type": "integer", "minimum": 1 },
        "layout_overflow_check_count": { "type": "integer", "minimum": 1 },
        "passed_layout_overflow_check_count": { "type": "integer", "minimum": 1 },
        "broken_table_check_count": { "type": "integer", "minimum": 1 },
        "passed_broken_table_check_count": { "type": "integer", "minimum": 1 },
        "broken_table_count": { "const": 0 },
        "overflow_signal_count": { "const": 0 },
        "layout_validation_report_only": { "const": true },
        "renderer_execution_allowed": { "const": false },
        "delivery_execution_allowed": { "const": false },
        "legal_advice_generated": { "const": false },
        "client_facing_ready_count": { "const": 0 },
        "validation_error_count": { "const": 0 }
      }
    }
  }
}
