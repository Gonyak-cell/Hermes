    "summary": {
      "type": "object",
      "required": ["phase_range", "phase_slot", "previous_phase_slot", "next_phase_slot", "command_name", "zendd_protected_action_rollback_status", "protected_action_row_count", "rollback_target_row_count", "work_order_row_count", "fail_closed_fixture_row_count", "next_action_row_count", "protected_action_execution_allowed_now", "rollback_execution_allowed_now", "receipt_application_allowed_now", "physical_code_move_allowed_now", "pass_promoted", "validation_error_count"],
      "properties": {
        "phase_range": { "const": "P721-P740" },
        "phase_slot": { "const": "P721" },
        "previous_phase_slot": { "const": "P720" },
        "next_phase_slot": { "const": "P741" },
        "command_name": { "const": "project:zendd-protected-action-rollback" },
        "zendd_protected_action_rollback_status": { "const": "ready_for_physical_integration_decision" },
        "protected_action_execution_allowed_now": { "const": false },
        "rollback_execution_allowed_now": { "const": false },
        "receipt_application_allowed_now": { "const": false },
        "physical_code_move_allowed_now": { "const": false },
        "pass_promoted": { "const": false },
        "validation_error_count": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
