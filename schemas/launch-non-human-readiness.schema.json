{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hermes.local/schemas/launch-non-human-readiness.schema.json",
  "title": "Hermes Launch Non-Human Readiness",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "capability_id",
    "command_name",
    "source_summaries",
    "non_human_source_rows",
    "human_approval_exclusion_rows",
    "non_human_workstream_rows",
    "non_human_command_rows",
    "authority_guard_rows",
    "execution_plan_rows",
    "launch_non_human_boundary",
    "validation_items",
    "validation",
    "summary"
  ],
  "properties": {
    "schema_version": { "const": "launch-non-human-readiness.v1" },
    "capability_id": { "const": "platform.launch_non_human_readiness" },
    "command_name": { "const": "platform:launch-non-human-readiness" },
    "non_human_source_rows": {
      "type": "array",
      "minItems": 6,
      "items": { "$ref": "#/$defs/verdictRow" }
    },
    "human_approval_exclusion_rows": {
      "type": "array",
      "minItems": 4,
      "items": {
        "allOf": [
          { "$ref": "#/$defs/verdictRow" },
          {
            "type": "object",
            "required": [
              "excluded_from_codex_execution_now",
              "requires_human",
              "codex_may_prepare_packet",
              "codex_may_mark_approved"
            ],
            "properties": {
              "excluded_from_codex_execution_now": { "const": true },
              "requires_human": { "const": true },
              "codex_may_prepare_packet": { "const": true },
              "codex_may_mark_approved": { "const": false }
            },
            "additionalProperties": true
          }
        ]
      }
    },
    "non_human_workstream_rows": {
      "type": "array",
      "minItems": 6,
      "items": {
        "allOf": [
          { "$ref": "#/$defs/verdictRow" },
          {
            "type": "object",
            "required": [
              "workstream_id",
              "source_ready",
              "human_approval_required_for_this_workstream",
              "opens_runtime_authority",
              "mutates_external_service",
              "deployment_execution_allowed",
              "production_pass_enabled"
            ],
            "properties": {
              "source_ready": { "type": "boolean" },
              "human_approval_required_for_this_workstream": { "const": false },
              "opens_runtime_authority": { "const": false },
              "mutates_external_service": { "const": false },
              "deployment_execution_allowed": { "const": false },
              "production_pass_enabled": { "const": false }
            },
            "additionalProperties": true
          }
        ]
      }
    },
    "non_human_command_rows": {
      "type": "array",
      "minItems": 8,
      "items": {
        "allOf": [
          { "$ref": "#/$defs/verdictRow" },
          {
            "type": "object",
            "required": [
              "command_name",
              "registered_in_package_json",
              "mutates_external_service",
              "deployment_execution_allowed"
            ],
            "properties": {
              "registered_in_package_json": { "type": "boolean" },
              "mutates_external_service": { "const": false },
              "deployment_execution_allowed": { "const": false }
            },
            "additionalProperties": true
          }
        ]
      }
    },
    "authority_guard_rows": {
      "type": "array",
      "minItems": 12,
      "items": {
        "allOf": [
          { "$ref": "#/$defs/verdictRow" },
          {
            "type": "object",
            "required": ["flag_name", "expected_value", "observed_closed"],
            "properties": {
              "expected_value": { "const": false },
              "observed_closed": { "const": true }
            },
            "additionalProperties": true
          }
        ]
      }
    },
    "execution_plan_rows": {
      "type": "array",
      "minItems": 6,
      "items": {
        "allOf": [
          { "$ref": "#/$defs/verdictRow" },
          {
            "type": "object",
            "required": [
              "sequence",
              "workstream_id",
              "detailed_steps",
              "entry_condition",
              "exit_condition",
              "blocked_by_human_approval"
            ],
            "properties": {
              "sequence": { "type": "integer", "minimum": 1 },
              "detailed_steps": { "type": "array", "minItems": 3 },
              "blocked_by_human_approval": { "const": false }
            },
            "additionalProperties": true
          }
        ]
      }
    },
    "launch_non_human_boundary": {
      "type": "object",
      "required": [
        "human_approval_excluded_now",
        "codex_final_approval_allowed",
        "human_approval_counted_as_done",
        "release_approval_allowed_now",
        "deployment_allowed_now",
        "production_pass_enabled",
        "enterprise_pass_enabled",
        "runtime_authority_open_now",
        "protected_action_allowed_now",
        "non_human_work_allowed_now",
        "all_authority_flags_closed"
      ],
      "properties": {
        "human_approval_excluded_now": { "const": true },
        "codex_final_approval_allowed": { "const": false },
        "human_approval_counted_as_done": { "const": false },
        "release_approval_allowed_now": { "const": false },
        "deployment_allowed_now": { "const": false },
        "production_pass_enabled": { "const": false },
        "enterprise_pass_enabled": { "const": false },
        "runtime_authority_open_now": { "const": false },
        "protected_action_allowed_now": { "const": false },
        "non_human_work_allowed_now": { "const": true },
        "all_authority_flags_closed": { "const": true }
      },
      "additionalProperties": true
    },
    "validation": {
      "type": "object",
      "required": ["valid", "error_count", "errors"],
      "properties": {
        "valid": { "type": "boolean" },
        "error_count": { "type": "integer", "minimum": 0 },
        "errors": { "type": "array" }
      },
      "additionalProperties": true
    },
    "summary": {
      "type": "object",
      "required": [
        "launch_non_human_readiness_status",
        "human_approval_excluded_now",
        "non_human_workstream_count",
        "command_count",
        "authority_flag_count",
        "closed_authority_flag_count",
        "codex_final_approval_allowed",
        "release_approval_allowed_now",
        "deployment_allowed_now",
        "production_pass_enabled",
        "enterprise_pass_enabled",
        "validation_error_count"
      ],
      "properties": {
        "launch_non_human_readiness_status": {
          "enum": ["ready_for_non_human_launch_readiness_execution", "blocked_launch_non_human_readiness"]
        },
        "human_approval_excluded_now": { "const": true },
        "codex_final_approval_allowed": { "const": false },
        "release_approval_allowed_now": { "const": false },
        "deployment_allowed_now": { "const": false },
        "production_pass_enabled": { "const": false },
        "enterprise_pass_enabled": { "const": false }
      },
      "additionalProperties": true
    }
  },
  "$defs": {
    "verdictRow": {
      "type": "object",
      "required": ["schema_version", "row_id", "current_verdict"],
      "properties": {
        "current_verdict": { "enum": ["pass", "blocked"] }
      },
      "additionalProperties": true
    }
  }
}
