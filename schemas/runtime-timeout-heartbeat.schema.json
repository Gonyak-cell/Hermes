      "type": "object",
      "required": [
        "runtime_timeout_heartbeat_status",
        "lifecycle_contract_id",
        "contract_status",
        "heartbeat_authority",
        "timeout_authority",
        "source_of_truth",
        "runtime_self_report_trusted",
        "agent_run_count",
        "heartbeat_record_count",
        "observed_heartbeat_count",
        "recorded_heartbeat_count",
        "heartbeat_missed_count",
        "timeout_record_count",
        "timeout_policy_bound_count",
        "timed_out_count",
        "active_timeout_count",
        "timeout_action_required_count",
        "run_ledger_binding_count",
        "bound_run_ledger_binding_count",
        "known_trace_binding_count",
        "desktop_read_only",
        "desktop_mutation_allowed",
        "desktop_protected_mutation_execution_allowed",
        "desktop_source_of_truth",
        "heartbeat_write_allowed",
        "timeout_override_allowed",
        "cancel_allowed",
        "resume_allowed",
        "clock_edit_allowed",
        "runtime_start_allowed",
        "runtime_process_control_allowed",
        "validation_error_count"
      ],
      "properties": {
        "runtime_timeout_heartbeat_status": { "enum": ["complete", "blocked"] },
        "lifecycle_contract_id": { "const": "runtime-timeout-heartbeat.default" },
        "contract_status": { "const": "locked" },
        "heartbeat_authority": { "const": "harness_control_plane" },
        "timeout_authority": { "const": "harness_control_plane" },
        "source_of_truth": { "const": "runtime_agentrun_contract_agent_run_ledger_and_runtime_logs" },
        "runtime_self_report_trusted": { "const": false },
        "agent_run_count": { "type": "integer", "minimum": 1 },
        "heartbeat_record_count": { "type": "integer", "minimum": 1 },
        "observed_heartbeat_count": { "type": "integer", "minimum": 0 },
        "recorded_heartbeat_count": { "type": "integer", "minimum": 1 },
        "heartbeat_missed_count": { "const": 0 },
        "timeout_record_count": { "type": "integer", "minimum": 1 },
        "timeout_policy_bound_count": { "type": "integer", "minimum": 1 },
        "timed_out_count": { "const": 0 },
        "active_timeout_count": { "const": 0 },
        "timeout_action_required_count": { "const": 0 },
        "run_ledger_binding_count": { "type": "integer", "minimum": 1 },
        "bound_run_ledger_binding_count": { "type": "integer", "minimum": 1 },
        "known_trace_binding_count": { "type": "integer", "minimum": 1 },
        "desktop_read_only": { "const": true },
        "desktop_mutation_allowed": { "const": false },
        "desktop_protected_mutation_execution_allowed": { "const": false },
        "desktop_source_of_truth": { "const": false },
        "heartbeat_write_allowed": { "const": false },
        "timeout_override_allowed": { "const": false },
        "cancel_allowed": { "const": false },
        "resume_allowed": { "const": false },
        "clock_edit_allowed": { "const": false },
        "runtime_start_allowed": { "const": false },
        "runtime_process_control_allowed": { "const": false },
        "validation_error_count": { "type": "integer", "minimum": 0 }
      }
    },
    "validation_items": { "type": "array" },
    "validation": {
      "type": "object",
      "required": ["valid", "errors"],
      "properties": {
        "valid": { "type": "boolean" },
        "errors": { "type": "array" }
      }
    }
  }
}
