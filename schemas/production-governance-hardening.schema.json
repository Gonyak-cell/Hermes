{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hermes.local/schemas/production-governance-hardening.schema.json",
  "title": "Hermes Production Governance Hardening",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "capability_id",
    "program_range",
    "source_program_range",
    "production_governance_contract",
    "production_governance_phase_rows",
    "production_governance_source_binding_rows",
    "release_candidate_governance_rows",
    "production_evidence_bundle_rows",
    "environment_config_boundary_rows",
    "incident_runbook_readiness_rows",
    "backup_restore_readiness_rows",
    "slo_observability_readiness_rows",
    "claude_production_governance_review_rows",
    "production_read_only_projection_rows",
    "production_authority_guard_rows",
    "p16600_freeze_rows",
    "production_governance_boundary",
    "production_governance_validation_items",
    "validation",
    "summary"
  ],
  "properties": {
    "schema_version": { "const": "production-governance-hardening.v1" },
    "capability_id": { "const": "platform.production_governance_hardening" },
    "program_range": { "const": "P16201-P16600" },
    "source_program_range": { "const": "P15801-P16200" },
    "production_governance_phase_rows": { "type": "array", "minItems": 10, "items": { "$ref": "#/$defs/verdictRow" } },
    "production_governance_source_binding_rows": { "type": "array", "minItems": 9, "items": { "$ref": "#/$defs/verdictRow" } },
    "release_candidate_governance_rows": { "type": "array", "minItems": 6, "items": { "$ref": "#/$defs/verdictRow" } },
    "production_evidence_bundle_rows": { "type": "array", "minItems": 6, "items": { "$ref": "#/$defs/verdictRow" } },
    "environment_config_boundary_rows": { "type": "array", "minItems": 6, "items": { "$ref": "#/$defs/verdictRow" } },
    "incident_runbook_readiness_rows": { "type": "array", "minItems": 6, "items": { "$ref": "#/$defs/verdictRow" } },
    "backup_restore_readiness_rows": { "type": "array", "minItems": 6, "items": { "$ref": "#/$defs/verdictRow" } },
    "slo_observability_readiness_rows": { "type": "array", "minItems": 6, "items": { "$ref": "#/$defs/verdictRow" } },
    "claude_production_governance_review_rows": { "type": "array", "minItems": 5, "items": { "$ref": "#/$defs/verdictRow" } },
    "production_read_only_projection_rows": { "type": "array", "minItems": 6, "items": { "$ref": "#/$defs/verdictRow" } },
    "production_authority_guard_rows": { "type": "array", "minItems": 8, "items": { "$ref": "#/$defs/verdictRow" } },
    "p16600_freeze_rows": { "type": "array", "minItems": 12, "items": { "$ref": "#/$defs/verdictRow" } },
    "production_governance_boundary": {
      "type": "object",
      "required": [
        "source_execution_write_authority_available",
        "source_ready_for_p16201_handoff",
        "source_block_visible_now",
        "release_candidate_governance_ready",
        "production_evidence_bundle_ready",
        "environment_config_boundary_ready",
        "incident_runbook_readiness_ready",
        "backup_restore_readiness_ready",
        "slo_observability_readiness_ready",
        "claude_production_governance_review_receipt_present_now",
        "claude_production_governance_review_block_visible_now",
        "production_read_only_projection_ready",
        "production_authority_guard_ready",
        "p16600_production_governance_freeze_ready",
        "ready_for_p16601_handoff",
        "deployment_allowed_now",
        "release_approval_allowed_now",
        "production_pass_enabled",
        "enterprise_pass_enabled",
        "enterprise_trust_claim_allowed_now",
        "protected_closeout_enabled",
        "environment_config_write_allowed_now",
        "migration_execution_allowed_now",
        "rollback_execution_allowed_now",
        "runtime_execution_allowed_now",
        "write_action_allowed_now",
        "protected_action_allowed_now",
        "connector_write_enabled",
        "external_service_mutation_allowed_now",
        "secret_read_allowed_now",
        "raw_source_exposure_allowed",
        "final_approval_ui_enabled",
        "codex_final_approval_ui_enabled",
        "claude_final_approval_ui_enabled",
        "unsafe_flag_count"
      ],
      "properties": {
        "source_execution_write_authority_available": { "type": "boolean" },
        "source_ready_for_p16201_handoff": { "type": "boolean" },
        "source_block_visible_now": { "type": "boolean" },
        "release_candidate_governance_ready": { "type": "boolean" },
        "production_evidence_bundle_ready": { "type": "boolean" },
        "environment_config_boundary_ready": { "type": "boolean" },
        "incident_runbook_readiness_ready": { "type": "boolean" },
        "backup_restore_readiness_ready": { "type": "boolean" },
        "slo_observability_readiness_ready": { "type": "boolean" },
        "claude_production_governance_review_receipt_present_now": { "type": "boolean" },
        "claude_production_governance_review_block_visible_now": { "type": "boolean" },
        "production_read_only_projection_ready": { "type": "boolean" },
        "production_authority_guard_ready": { "type": "boolean" },
        "p16600_production_governance_freeze_ready": { "type": "boolean" },
        "ready_for_p16601_handoff": { "type": "boolean" },
        "deployment_allowed_now": { "const": false },
        "release_approval_allowed_now": { "const": false },
        "production_pass_enabled": { "const": false },
        "enterprise_pass_enabled": { "const": false },
        "enterprise_trust_claim_allowed_now": { "const": false },
        "protected_closeout_enabled": { "const": false },
        "environment_config_write_allowed_now": { "const": false },
        "migration_execution_allowed_now": { "const": false },
        "rollback_execution_allowed_now": { "const": false },
        "runtime_execution_allowed_now": { "const": false },
        "write_action_allowed_now": { "const": false },
        "protected_action_allowed_now": { "const": false },
        "connector_write_enabled": { "const": false },
        "external_service_mutation_allowed_now": { "const": false },
        "secret_read_allowed_now": { "const": false },
        "raw_source_exposure_allowed": { "const": false },
        "final_approval_ui_enabled": { "const": false },
        "codex_final_approval_ui_enabled": { "const": false },
        "claude_final_approval_ui_enabled": { "const": false },
        "unsafe_flag_count": { "const": 0 }
      }
    },
    "validation": {
      "type": "object",
      "required": ["valid", "error_count", "errors"],
      "properties": {
        "valid": { "type": "boolean" },
        "error_count": { "type": "integer", "minimum": 0 },
        "errors": { "type": "array" }
      }
    },
    "summary": {
      "type": "object",
      "required": [
        "production_governance_hardening_status",
        "program_range",
        "source_ready_for_p16201_handoff",
        "source_block_visible_now",
        "release_candidate_governance_row_count",
        "production_evidence_bundle_row_count",
        "environment_config_boundary_row_count",
        "incident_runbook_readiness_row_count",
        "backup_restore_readiness_row_count",
        "slo_observability_readiness_row_count",
        "claude_production_governance_review_receipt_present_now",
        "claude_production_governance_review_block_visible_now",
        "production_read_only_projection_row_count",
        "p16600_production_governance_freeze_ready",
        "ready_for_p16601_handoff",
        "deployment_allowed_now",
        "release_approval_allowed_now",
        "production_pass_enabled",
        "enterprise_pass_enabled",
        "enterprise_trust_claim_allowed_now",
        "environment_config_write_allowed_now",
        "migration_execution_allowed_now",
        "rollback_execution_allowed_now",
        "validation_error_count"
      ],
      "properties": {
        "production_governance_hardening_status": {
          "enum": ["ready_for_production_governance_hardening", "blocked_production_governance_hardening"]
        },
        "program_range": { "const": "P16201-P16600" },
        "release_candidate_governance_row_count": { "type": "integer", "minimum": 6 },
        "production_evidence_bundle_row_count": { "type": "integer", "minimum": 6 },
        "environment_config_boundary_row_count": { "type": "integer", "minimum": 6 },
        "incident_runbook_readiness_row_count": { "type": "integer", "minimum": 6 },
        "backup_restore_readiness_row_count": { "type": "integer", "minimum": 6 },
        "slo_observability_readiness_row_count": { "type": "integer", "minimum": 6 },
        "production_read_only_projection_row_count": { "type": "integer", "minimum": 6 },
        "deployment_allowed_now": { "const": false },
        "release_approval_allowed_now": { "const": false },
        "production_pass_enabled": { "const": false },
        "enterprise_pass_enabled": { "const": false },
        "enterprise_trust_claim_allowed_now": { "const": false },
        "environment_config_write_allowed_now": { "const": false },
        "migration_execution_allowed_now": { "const": false },
        "rollback_execution_allowed_now": { "const": false }
      }
    }
  },
  "$defs": {
    "verdictRow": {
      "type": "object",
      "required": ["row_id", "category", "label", "required", "observed", "evidence_ref", "current_verdict"],
      "properties": {
        "row_id": { "type": "string", "minLength": 1 },
        "category": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "required": { "type": "boolean" },
        "observed": { "type": "boolean" },
        "evidence_ref": { "type": "string", "minLength": 1 },
        "current_verdict": { "enum": ["pass", "blocked"] },
        "block_reason": { "type": ["string", "null"] }
      }
    }
  }
}
