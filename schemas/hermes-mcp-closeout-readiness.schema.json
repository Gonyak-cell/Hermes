{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hermes.local/schemas/hermes-mcp-closeout-readiness.schema.json",
  "title": "Hermes MCP Closeout Readiness",
  "type": "object",
  "required": ["schema_version", "tranche_id", "command_name", "readiness_rows", "source_statuses", "authority_boundary", "validation", "summary"],
  "properties": {
    "schema_version": { "const": "hermes-mcp-closeout-readiness.v1" },
    "tranche_id": { "const": "H-MCP-08" },
    "command_name": { "const": "platform:hermes-mcp-closeout-readiness" },
    "readiness_rows": {
      "type": "array",
      "minItems": 9,
      "items": {
        "type": "object",
        "required": ["tranche_id", "description", "ready"],
        "properties": {
          "ready": { "const": true }
        }
      }
    },
    "summary": {
      "type": "object",
      "required": ["status", "readiness_count", "readiness_ready_count", "repo_write_allowed_now", "filesystem_write_allowed_now", "connector_write_allowed_now", "deployment_allowed_now", "receipt_application_allowed_now", "protected_action_allowed_now", "production_pass_allowed_now", "enterprise_trust_claim_allowed_now", "raw_restricted_payload_allowed", "validation_error_count"],
      "properties": {
        "status": { "const": "ready_for_hermes_mcp_closeout_readiness" },
        "readiness_count": { "const": 9 },
        "readiness_ready_count": { "const": 9 },
        "repo_write_allowed_now": { "const": false },
        "filesystem_write_allowed_now": { "const": false },
        "connector_write_allowed_now": { "const": false },
        "deployment_allowed_now": { "const": false },
        "receipt_application_allowed_now": { "const": false },
        "protected_action_allowed_now": { "const": false },
        "production_pass_allowed_now": { "const": false },
        "enterprise_trust_claim_allowed_now": { "const": false },
        "raw_restricted_payload_allowed": { "const": false },
        "validation_error_count": { "const": 0 }
      }
    }
  }
}
