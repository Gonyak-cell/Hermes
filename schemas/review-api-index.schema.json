{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://amic.local/hermes/review-api-index.schema.json",
  "title": "Hermes Review API Index",
  "type": "object",
  "required": [
    "schema_version",
    "generated_at",
    "dashboard_path",
    "static_index_path",
    "routes"
  ],
  "properties": {
    "schema_version": {
      "const": "review-api-index.v1"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "dashboard_path": {
      "type": "string"
    },
    "static_index_path": {
      "type": "string"
    },
    "routes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["method", "path", "description"],
        "properties": {
          "method": {
            "enum": ["GET"]
          },
          "path": {
            "type": "string"
          },
          "description": {
            "type": "string"
          }
        }
      }
    }
  }
}
