{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://amic.local/hermes/batch-matter-tagging-result.schema.json",
  "title": "Batch Matter Tagging Result",
  "type": "object",
  "required": [
    "schema_version",
    "generated_at",
    "batch_matter_tagging_result_id",
    "batch_matter_tagging_result_status",
    "phase_slot",
    "previous_phase_slot",
    "next_phase_slot",
    "source_contracts",
    "batch_matter_tagging_contract",
    "batch_matter_tagging_rows",
    "automatic_tagging_candidate_rows",
    "human_confirmation_rows",
    "matter_tagging_separation_rows",
    "batch_matter_tagging_checks",
    "batch_matter_tagging_boundary",
    "validation_items",
    "validation",
    "summary"
  ],
  "properties": {
    "schema_version": { "const": "batch-matter-tagging-result.v1" },
    "generated_at": { "type": "string", "format": "date-time" },
    "batch_matter_tagging_result_id": { "type": "string", "minLength": 1 },
    "batch_matter_tagging_result_status": { "const": "complete" },
    "pack_id": { "const": "resource-expansion" },
    "capability_id": { "const": "resource.batch_matter_tagging_result" },
    "phase_slot": { "const": "P282" },
    "previous_phase_slot": { "const": "P281" },
    "next_phase_slot": { "const": "P283" },
    "source_contracts": {
      "type": "array",
      "minItems": 9,
      "items": {
        "type": "object",
        "required": ["label", "available"],
        "properties": {
          "label": { "type": "string" },
          "available": { "type": "boolean" },
          "schema_version": { "type": ["string", "null"] },
          "content_hash": { "type": ["string", "null"], "pattern": "^sha256:" }
        }
      }
    },
    "batch_matter_tagging_contract": {
      "type": "object",
      "required": [
        "schema_version",
        "contract_id",
        "phase_slot",
        "previous_phase_slot",
        "next_phase_slot",
        "tagging_result_rule",
        "batch_matter_tagging_row_count",
        "matter_tag_write_allowed",
        "auto_apply_allowed",
        "client_facing_output_allowed"
      ],
      "properties": {
        "schema_version": { "const": "batch-matter-tagging-contract.v1" },
        "contract_id": { "const": "batch-matter-tagging-result.v1" },
        "phase_slot": { "const": "P282" },
        "previous_phase_slot": { "const": "P281" },
        "next_phase_slot": { "const": "P283" },
        "tagging_result_rule": { "type": "string", "minLength": 1 },
        "batch_matter_tagging_row_count": { "type": "integer", "minimum": 1 },
        "automatic_tagging_candidate_row_count": { "type": "integer", "minimum": 1 },
        "human_confirmation_row_count": { "type": "integer", "minimum": 1 },
        "matter_tag_write_allowed": { "const": false },
        "auto_apply_allowed": { "const": false },
        "client_facing_output_allowed": { "const": false }
      }
    },
    "batch_matter_tagging_rows": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/batch_matter_tagging_row" }
    },
    "automatic_tagging_candidate_rows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "automatic_tagging_candidate_row_id",
          "matter_tagging_candidate_id",
          "resource_id",
          "proposed_matter_id",
          "candidate_status",
          "candidate_separation_status",
          "auto_apply_allowed",
          "matter_tag_write_performed",
          "human_review_required",
          "client_facing_ready"
        ],
        "properties": {
          "automatic_tagging_candidate_row_id": { "type": "string", "minLength": 1 },
          "matter_tagging_candidate_id": { "type": "string", "minLength": 1 },
          "resource_id": { "type": "string", "minLength": 1 },
          "proposed_matter_id": { "type": "string", "minLength": 1 },
          "candidate_status": { "const": "requires_human_confirmation" },
          "confidence": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
          "matter_profile_known": { "type": "boolean" },
          "tenant_boundary_mismatch": { "type": "boolean" },
          "matter_tagging_gate_present": { "type": "boolean" },
          "human_confirmation_required": { "const": true },
          "linked_batch_matter_tagging_row_id": { "type": ["string", "null"] },
          "candidate_separation_status": { "const": "candidate_separated_from_confirmation" },
          "auto_apply_allowed": { "const": false },
          "matter_tag_write_performed": { "const": false },
          "human_review_required": { "const": true },
          "client_facing_ready": { "const": false }
        }
      }
    },
    "human_confirmation_rows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "human_confirmation_row_id",
          "matter_tagging_confirmation_id",
          "matter_tagging_decision_id",
          "resource_id",
          "proposed_matter_id",
          "confirmation_status",
          "confirmation_separation_status",
          "auto_apply_allowed",
          "confirmation_applied",
          "matter_tag_write_performed",
          "human_review_required",
          "client_facing_ready"
        ],
        "properties": {
          "human_confirmation_row_id": { "type": "string", "minLength": 1 },
          "matter_tagging_confirmation_id": { "type": "string", "minLength": 1 },
          "matter_tagging_decision_id": { "type": "string", "minLength": 1 },
          "matter_tagging_candidate_id": { "type": ["string", "null"] },
          "resource_id": { "type": "string", "minLength": 1 },
          "proposed_matter_id": { "type": "string", "minLength": 1 },
          "confirmation_status": { "const": "pending" },
          "required_gates": { "type": "array", "items": { "type": "string" } },
          "linked_batch_matter_tagging_row_id": { "type": ["string", "null"] },
          "confirmation_separation_status": { "const": "pending_human_confirmation_separated" },
          "auto_apply_allowed": { "const": false },
          "confirmation_applied": { "const": false },
          "matter_tag_write_performed": { "const": false },
          "human_review_required": { "const": true },
          "client_facing_ready": { "const": false }
        }
      }
    },
    "matter_tagging_separation_rows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "matter_tagging_separation_row_id",
          "proposed_matter_id",
          "batch_matter_tagging_row_count",
          "automatic_candidate_count",
          "pending_human_confirmation_count",
          "human_confirmation_pending_count",
          "auto_apply_allowed_count",
          "matter_tag_write_performed_count",
          "separation_status",
          "human_review_required",
          "client_facing_ready"
        ],
        "properties": {
          "matter_tagging_separation_row_id": { "type": "string", "minLength": 1 },
          "proposed_matter_id": { "type": "string", "minLength": 1 },
          "batch_matter_tagging_row_count": { "type": "integer", "minimum": 1 },
          "automatic_candidate_count": { "type": "integer", "minimum": 1 },
          "pending_human_confirmation_count": { "type": "integer", "minimum": 1 },
          "human_confirmation_pending_count": { "type": "integer", "minimum": 1 },
          "auto_apply_allowed_count": { "const": 0 },
          "matter_tag_write_performed_count": { "const": 0 },
          "separation_status": { "const": "automatic_candidate_separated_from_human_confirmation" },
          "human_review_required": { "const": true },
          "client_facing_ready": { "const": false }
        }
      }
    },
    "batch_matter_tagging_checks": {
      "type": "array",
      "minItems": 24,
      "items": { "$ref": "#/$defs/validation_item" }
    },
    "batch_matter_tagging_boundary": {
      "type": "object",
      "required": [
        "read_only",
        "batch_matter_tagging_report_only",
        "source_artifact_read_performed",
        "backfill_execution_performed",
        "matter_tag_write_performed",
        "auto_tag_apply_performed",
        "human_confirmation_applied",
        "source_ingest_performed",
        "file_content_read_performed",
        "external_model_used",
        "source_mutation_performed",
        "resource_mutation_performed",
        "state_mutation_performed",
        "matter_data_write_performed",
        "delivery_execution_performed",
        "protected_action_executed",
        "legal_advice_generated",
        "client_facing_output_generated",
        "client_facing_ready_count",
        "windows_baseline_stability_preserved",
        "mac_windows_completion_instability_guard"
      ],
      "properties": {
        "read_only": { "const": true },
        "batch_matter_tagging_report_only": { "const": true },
        "source_artifact_read_performed": { "const": true },
        "backfill_execution_performed": { "const": false },
        "matter_tag_write_performed": { "const": false },
        "auto_tag_apply_performed": { "const": false },
        "human_confirmation_applied": { "const": false },
        "source_ingest_performed": { "const": false },
        "file_content_read_performed": { "const": false },
        "external_model_used": { "const": false },
        "source_mutation_performed": { "const": false },
        "resource_mutation_performed": { "const": false },
        "state_mutation_performed": { "const": false },
        "matter_data_write_performed": { "const": false },
        "delivery_execution_performed": { "const": false },
        "protected_action_executed": { "const": false },
        "legal_advice_generated": { "const": false },
        "client_facing_output_generated": { "const": false },
        "human_review_required": { "const": true },
        "client_facing_ready_count": { "const": 0 },
        "windows_baseline_stability_preserved": { "const": true },
        "mac_windows_completion_instability_guard": { "const": true }
      }
    },
    "validation_items": {
      "type": "array",
      "minItems": 24,
      "items": { "$ref": "#/$defs/validation_item" }
    },
    "validation": {
      "type": "object",
      "required": ["valid", "error_count", "errors"],
      "properties": {
        "valid": { "const": true },
        "error_count": { "const": 0 },
        "errors": { "type": "array", "maxItems": 0 }
      }
    },
    "summary": {
      "type": "object",
      "required": [
        "batch_matter_tagging_result_status",
        "phase_slot",
        "previous_phase_slot",
        "next_phase_slot",
        "source_batch_classification_result_status",
        "source_matter_tagging_ledger_status",
        "batch_matter_tagging_row_count",
        "tagging_decision_present_count",
        "automatic_candidate_present_count",
        "pending_human_confirmation_count",
        "human_confirmation_pending_count",
        "auto_apply_allowed_count",
        "matter_tag_write_performed_count",
        "read_only",
        "batch_matter_tagging_report_only",
        "backfill_execution_performed",
        "matter_tag_write_performed",
        "auto_tag_apply_performed",
        "human_confirmation_applied",
        "source_ingest_performed",
        "file_content_read_performed",
        "external_model_used",
        "source_mutation_performed",
        "resource_mutation_performed",
        "state_mutation_performed",
        "matter_data_write_performed",
        "delivery_execution_performed",
        "protected_action_executed",
        "legal_advice_generated",
        "client_facing_output_generated",
        "windows_baseline_stability_preserved",
        "mac_windows_completion_instability_guard",
        "failed_checkpoint_count",
        "validation_error_count"
      ],
      "properties": {
        "batch_matter_tagging_result_status": { "const": "complete" },
        "phase_slot": { "const": "P282" },
        "previous_phase_slot": { "const": "P281" },
        "next_phase_slot": { "const": "P283" },
        "source_batch_classification_result_status": { "const": "complete" },
        "source_batch_classification_phase_slot": { "const": "P281" },
        "source_batch_classification_next_phase_slot": { "const": "P282" },
        "source_matter_tagging_ledger_status": { "const": "complete" },
        "resource_item_count": { "type": "integer", "minimum": 1 },
        "batch_matter_tagging_row_count": { "type": "integer", "minimum": 1 },
        "tagging_decision_present_count": { "type": "integer", "minimum": 1 },
        "automatic_candidate_present_count": { "type": "integer", "minimum": 1 },
        "pending_human_confirmation_count": { "type": "integer", "minimum": 1 },
        "human_confirmation_pending_count": { "type": "integer", "minimum": 1 },
        "automatic_tagging_candidate_row_count": { "type": "integer", "minimum": 1 },
        "separated_automatic_candidate_row_count": { "type": "integer", "minimum": 1 },
        "human_confirmation_row_count": { "type": "integer", "minimum": 1 },
        "separated_human_confirmation_row_count": { "type": "integer", "minimum": 1 },
        "matter_tagging_separation_row_count": { "type": "integer", "minimum": 1 },
        "passed_separation_row_count": { "type": "integer", "minimum": 1 },
        "human_review_required_count": { "type": "integer", "minimum": 1 },
        "auto_apply_allowed_count": { "const": 0 },
        "auto_tag_apply_performed_count": { "const": 0 },
        "human_confirmation_applied_count": { "const": 0 },
        "matter_tag_write_performed_count": { "const": 0 },
        "resource_mutation_performed_count": { "const": 0 },
        "state_mutation_performed_count": { "const": 0 },
        "protected_action_executed_count": { "const": 0 },
        "legal_advice_generated_count": { "const": 0 },
        "client_facing_ready_count": { "const": 0 },
        "read_only": { "const": true },
        "batch_matter_tagging_report_only": { "const": true },
        "backfill_execution_performed": { "const": false },
        "matter_tag_write_performed": { "const": false },
        "auto_tag_apply_performed": { "const": false },
        "human_confirmation_applied": { "const": false },
        "source_ingest_performed": { "const": false },
        "file_content_read_performed": { "const": false },
        "external_model_used": { "const": false },
        "source_mutation_performed": { "const": false },
        "resource_mutation_performed": { "const": false },
        "state_mutation_performed": { "const": false },
        "matter_data_write_performed": { "const": false },
        "delivery_execution_performed": { "const": false },
        "protected_action_executed": { "const": false },
        "legal_advice_generated": { "const": false },
        "client_facing_output_generated": { "const": false },
        "windows_baseline_stability_preserved": { "const": true },
        "mac_windows_completion_instability_guard": { "const": true },
        "failed_checkpoint_count": { "const": 0 },
        "validation_error_count": { "const": 0 }
      }
    }
  },
  "$defs": {
    "classification": {
      "enum": ["P0_PUBLIC", "P1_INTERNAL", "P2_CLIENT_CONFIDENTIAL", "P3_PRIVILEGED", "P4_HIGHLY_RESTRICTED", "P5_SECRET"]
    },
    "batch_matter_tagging_row": {
      "type": "object",
      "required": [
        "batch_matter_tagging_row_id",
        "item_id",
        "resource_id",
        "data_classification",
        "classification_status",
        "classification_policy_binding_status",
        "matter_tagging_decision_id",
        "automatic_tagging_candidate_id",
        "human_confirmation_id",
        "current_matter_id",
        "proposed_matter_id",
        "tagging_status",
        "auto_tagging_status",
        "automatic_candidate_status",
        "human_confirmation_status",
        "batch_matter_tagging_status",
        "human_confirmation_required",
        "auto_apply_allowed",
        "auto_tag_apply_performed",
        "human_confirmation_applied",
        "matter_tag_write_performed",
        "resource_mutation_performed",
        "state_mutation_performed",
        "protected_action_executed",
        "legal_advice_generated",
        "client_facing_ready"
      ],
      "properties": {
        "batch_matter_tagging_row_id": { "type": "string", "minLength": 1 },
        "item_id": { "type": "string", "minLength": 1 },
        "resource_id": { "type": "string", "minLength": 1 },
        "resource_version_id": { "type": ["string", "null"] },
        "relative_path": { "type": ["string", "null"] },
        "item_status": { "type": "string" },
        "data_classification": { "$ref": "#/$defs/classification" },
        "classification_status": { "const": "classified_pending_human_review" },
        "classification_confidence_score": { "type": ["number", "null"], "minimum": 0.7, "maximum": 1 },
        "classification_policy_binding_status": { "const": "bound" },
        "matter_tagging_decision_id": { "type": "string", "minLength": 1 },
        "automatic_tagging_candidate_id": { "type": "string", "minLength": 1 },
        "human_confirmation_id": { "type": "string", "minLength": 1 },
        "current_matter_id": { "type": ["string", "null"] },
        "proposed_matter_id": { "type": "string", "minLength": 1 },
        "current_tenant_id": { "type": ["string", "null"] },
        "proposed_tenant_id": { "type": ["string", "null"] },
        "tagging_status": { "const": "pending_human_confirmation" },
        "auto_tagging_status": { "const": "candidate_generated" },
        "automatic_candidate_status": { "const": "requires_human_confirmation" },
        "human_confirmation_status": { "const": "pending" },
        "batch_matter_tagging_status": { "const": "pending_human_confirmation" },
        "candidate_confidence": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "tenant_boundary_mismatch": { "type": "boolean" },
        "matter_tagging_gate_required": { "type": "boolean" },
        "human_confirmation_required": { "const": true },
        "auto_apply_allowed": { "const": false },
        "auto_tag_apply_performed": { "const": false },
        "human_confirmation_applied": { "const": false },
        "matter_tag_write_performed": { "const": false },
        "resource_mutation_performed": { "const": false },
        "state_mutation_performed": { "const": false },
        "protected_action_executed": { "const": false },
        "legal_advice_generated": { "const": false },
        "client_facing_ready": { "const": false },
        "reason_codes": { "type": "array", "items": { "type": "string" } }
      }
    },
    "validation_item": {
      "type": "object",
      "required": ["checkpoint_id", "status", "message"],
      "properties": {
        "checkpoint_id": { "type": "string", "minLength": 1 },
        "status": { "const": "passed" },
        "message": { "type": "string" },
        "human_review_required": { "const": true },
        "client_facing_ready": { "const": false }
      }
    }
  }
}
