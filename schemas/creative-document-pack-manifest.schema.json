{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hermes.local/schemas/creative-document-pack-manifest.schema.json",
  "title": "Creative Document Pack Manifest",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "generated_at",
    "creative_document_pack_manifest_id",
    "creative_document_pack_manifest_status",
    "safe_handling",
    "creative_document_pack_manifest_contract",
    "creative_document_pack_registration",
    "creative_document_capability_registrations",
    "creative_document_pack_boundary",
    "creative_document_pack_checkpoints",
    "validation_items",
    "validation",
    "summary"
  ],
  "properties": {
    "schema_version": { "const": "creative-document-pack-manifest.v1" },
    "generated_at": { "type": "string", "minLength": 1 },
    "creative_document_pack_manifest_id": { "type": "string", "minLength": 1 },
    "creative_document_pack_manifest_status": { "enum": ["complete", "blocked"] },
    "safe_handling": {
      "type": "object",
      "required": [
        "report_only",
        "creative_document_pack_manifest_generated",
        "human_review_required",
        "format_validation_required",
        "draft_only_output_required",
        "renderer_execution_performed",
        "delivery_execution_performed",
        "protected_mutation_performed",
        "core_registry_mutation_performed",
        "core_capability_mutation_performed",
        "core_route_mutation_performed",
        "client_facing_output_generated"
      ],
      "properties": {
        "report_only": { "const": true },
        "creative_document_pack_manifest_generated": { "const": true },
        "human_review_required": { "const": true },
        "format_validation_required": { "const": true },
        "draft_only_output_required": { "const": true },
        "renderer_execution_performed": { "const": false },
        "delivery_execution_performed": { "const": false },
        "protected_mutation_performed": { "const": false },
        "core_registry_mutation_performed": { "const": false },
        "core_capability_mutation_performed": { "const": false },
        "core_route_mutation_performed": { "const": false },
        "client_facing_output_generated": { "const": false }
      }
    },
    "creative_document_pack_manifest_contract": {
      "type": "object",
      "required": ["contract_id", "pack_id", "domain_track", "source_of_truth"],
      "properties": {
        "contract_id": { "const": "creative-document-pack-manifest.v1" },
        "pack_id": { "const": "creative-document" },
        "domain_track": { "const": "creative_document_domain_pack" },
        "source_of_truth": { "const": "domain_pack_registry_and_creative_document_pack_manifest" }
      }
    },
    "creative_document_pack_registration": {
      "type": "object",
      "required": [
        "pack_id",
        "registration_status",
        "compatibility_status",
        "common_dependency_declared",
        "capability_count",
        "registered_capability_count",
        "capability_manifest_v2_count",
        "capability_registry_api_pack_card_present",
        "capability_registry_api_capability_card_count",
        "capability_version_api_card_count",
        "template_declared_count",
        "renderer_declared_count",
        "format_validation_required",
        "human_review_required",
        "layout_validation_required",
        "document_renderer_runtime_declared",
        "runtime_freeze_status",
        "document_renderer_adapter_status",
        "output_delivery_contract_freeze_status",
        "default_output_status",
        "core_mutation_required_count",
        "desktop_read_only",
        "desktop_mutation_allowed",
        "desktop_runtime_source_of_truth"
      ],
      "properties": {
        "pack_id": { "const": "creative-document" },
        "registration_status": { "const": "registered" },
        "compatibility_status": { "const": "compatible" },
        "common_dependency_declared": { "const": true },
        "capability_count": { "const": 1 },
        "registered_capability_count": { "const": 1 },
        "capability_manifest_v2_count": { "const": 1 },
        "capability_registry_api_pack_card_present": { "const": true },
        "capability_registry_api_capability_card_count": { "const": 1 },
        "capability_version_api_card_count": { "const": 1 },
        "template_declared_count": { "minimum": 1 },
        "renderer_declared_count": { "minimum": 1 },
        "format_validation_required": { "const": true },
        "human_review_required": { "const": true },
        "layout_validation_required": { "const": true },
        "document_renderer_runtime_declared": { "const": true },
        "runtime_freeze_status": { "const": "complete" },
        "document_renderer_adapter_status": { "const": "complete" },
        "output_delivery_contract_freeze_status": { "const": "complete" },
        "default_output_status": { "const": "draft" },
        "core_mutation_required_count": { "const": 0 },
        "desktop_read_only": { "const": true },
        "desktop_mutation_allowed": { "const": false },
        "desktop_runtime_source_of_truth": { "const": false }
      }
    },
    "creative_document_capability_registrations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "type": "object",
        "required": [
          "pack_id",
          "capability_id",
          "registration_status",
          "domain_registry_present",
          "capability_manifest_v2_present",
          "capability_registry_api_card_present",
          "capability_version_api_card_present",
          "format_validation_gate_required",
          "human_approval_gate_required",
          "draft_only_output_required",
          "renderer_execution_performed",
          "protected_action_executed"
        ],
        "properties": {
          "pack_id": { "const": "creative-document" },
          "capability_id": { "const": "creative_document.pptx.design_system" },
          "registration_status": { "const": "registered" },
          "domain_registry_present": { "const": true },
          "capability_manifest_v2_present": { "const": true },
          "capability_registry_api_card_present": { "const": true },
          "capability_version_api_card_present": { "const": true },
          "format_validation_gate_required": { "const": true },
          "human_approval_gate_required": { "const": true },
          "draft_only_output_required": { "const": true },
          "renderer_execution_performed": { "const": false },
          "protected_action_executed": { "const": false }
        }
      }
    },
    "creative_document_pack_boundary": {
      "type": "object",
      "required": [
        "boundary_status",
        "pack_id",
        "read_only",
        "mutation_allowed",
        "core_registry_mutation_allowed",
        "core_capability_mutation_allowed",
        "core_route_mutation_allowed",
        "runtime_execution_allowed",
        "renderer_execution_allowed",
        "delivery_execution_allowed",
        "protected_action_allowed",
        "final_output_delivery_allowed",
        "client_facing_output_generated",
        "client_facing_ready_count",
        "draft_only_output_required",
        "format_validation_required",
        "human_review_required",
        "layout_validation_required",
        "desktop_runtime_source_of_truth"
      ],
      "properties": {
        "boundary_status": { "const": "enforced" },
        "pack_id": { "const": "creative-document" },
        "read_only": { "const": true },
        "mutation_allowed": { "const": false },
        "core_registry_mutation_allowed": { "const": false },
        "core_capability_mutation_allowed": { "const": false },
        "core_route_mutation_allowed": { "const": false },
        "runtime_execution_allowed": { "const": false },
        "renderer_execution_allowed": { "const": false },
        "delivery_execution_allowed": { "const": false },
        "protected_action_allowed": { "const": false },
        "final_output_delivery_allowed": { "const": false },
        "client_facing_output_generated": { "const": false },
        "client_facing_ready_count": { "const": 0 },
        "draft_only_output_required": { "const": true },
        "format_validation_required": { "const": true },
        "human_review_required": { "const": true },
        "layout_validation_required": { "const": true },
        "desktop_runtime_source_of_truth": { "const": false }
      }
    },
    "validation": {
      "type": "object",
      "required": ["valid", "errors"],
      "properties": {
        "valid": { "const": true },
        "errors": { "type": "array", "maxItems": 0 }
      }
    },
    "summary": {
      "type": "object",
      "required": [
        "creative_document_pack_manifest_status",
        "creative_document_pack_manifest_contract_id",
        "pack_id",
        "registration_status",
        "compatibility_status",
        "capability_count",
        "registered_capability_count",
        "format_validation_required",
        "human_review_required",
        "layout_validation_required",
        "document_renderer_runtime_declared",
        "runtime_freeze_status",
        "document_renderer_adapter_status",
        "output_delivery_contract_freeze_status",
        "default_output_status",
        "core_mutation_required_count",
        "desktop_read_only",
        "desktop_mutation_allowed",
        "desktop_runtime_source_of_truth",
        "renderer_execution_allowed",
        "delivery_execution_allowed",
        "protected_action_allowed",
        "client_facing_output_generated",
        "client_facing_ready_count",
        "failed_checkpoint_count",
        "validation_error_count"
      ],
      "properties": {
        "creative_document_pack_manifest_status": { "const": "complete" },
        "creative_document_pack_manifest_contract_id": { "const": "creative-document-pack-manifest.v1" },
        "pack_id": { "const": "creative-document" },
        "registration_status": { "const": "registered" },
        "compatibility_status": { "const": "compatible" },
        "capability_count": { "const": 1 },
        "registered_capability_count": { "const": 1 },
        "format_validation_required": { "const": true },
        "human_review_required": { "const": true },
        "layout_validation_required": { "const": true },
        "document_renderer_runtime_declared": { "const": true },
        "runtime_freeze_status": { "const": "complete" },
        "document_renderer_adapter_status": { "const": "complete" },
        "output_delivery_contract_freeze_status": { "const": "complete" },
        "default_output_status": { "const": "draft" },
        "core_mutation_required_count": { "const": 0 },
        "desktop_read_only": { "const": true },
        "desktop_mutation_allowed": { "const": false },
        "desktop_runtime_source_of_truth": { "const": false },
        "renderer_execution_allowed": { "const": false },
        "delivery_execution_allowed": { "const": false },
        "protected_action_allowed": { "const": false },
        "client_facing_output_generated": { "const": false },
        "client_facing_ready_count": { "const": 0 },
        "failed_checkpoint_count": { "const": 0 },
        "validation_error_count": { "const": 0 }
      }
    }
  }
}
