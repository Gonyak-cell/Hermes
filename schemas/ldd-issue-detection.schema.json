{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/ldd-issue-detection.schema.json",
  "title": "Hermes LDD Issue Detection",
  "type": "object",
  "required": [
    "schema_version",
    "generated_at",
    "ldd_issue_detection_id",
    "ldd_issue_detection_status",
    "safe_handling",
    "inputs",
    "source_contracts",
    "ldd_issue_detection_contract",
    "ldd_issue_detection_rules",
    "ldd_issue_records",
    "ldd_issue_follow_ups",
    "ldd_issue_severity_summaries",
    "ldd_issue_matter_summaries",
    "ldd_issue_detection_desktop_boundary",
    "ldd_issue_detection_checkpoints",
    "validation_items",
    "validation",
    "summary"
  ],
  "properties": {
    "schema_version": { "const": "ldd-issue-detection.v1" },
    "generated_at": { "type": "string", "minLength": 1 },
    "ldd_issue_detection_id": { "type": "string", "minLength": 1 },
    "output_dir": { "type": "string" },
    "ldd_issue_detection_status": { "enum": ["complete", "blocked"] },
    "safe_handling": { "$ref": "#/$defs/safe_handling" },
    "inputs": { "type": "object" },
    "source_contracts": { "type": "object" },
    "ldd_issue_detection_contract": { "$ref": "#/$defs/contract" },
    "ldd_issue_detection_rules": { "type": "array", "minItems": 5, "items": { "$ref": "#/$defs/rule" } },
    "ldd_issue_records": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/issue_record" } },
    "ldd_issue_follow_ups": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/follow_up" } },
    "ldd_issue_severity_summaries": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/severity_summary" } },
    "ldd_issue_matter_summaries": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/matter_summary" } },
    "ldd_issue_detection_desktop_boundary": { "$ref": "#/$defs/desktop_boundary" },
    "ldd_issue_detection_checkpoints": { "type": "array", "items": { "$ref": "#/$defs/checkpoint" } },
    "validation_items": { "type": "array", "items": { "$ref": "#/$defs/validation_item" } },
    "validation": { "$ref": "#/$defs/validation" },
    "summary": { "$ref": "#/$defs/summary" }
  },
  "$defs": {
    "safe_handling": {
      "type": "object",
      "required": [
        "report_only",
        "deterministic_issue_detection_performed",
        "legal_conclusion_asserted",
        "legal_advice_provided",
        "client_facing_output_generated",
        "attorney_review_required",
        "human_review_required",
        "matter_data_write_allowed",
        "task_state_write_allowed",
        "workflow_transition_allowed",
        "runtime_execution_performed",
        "delivery_execution_performed",
        "desktop_mutation_allowed",
        "desktop_source_of_truth",
        "protected_mutation_executed",
        "secret_material_exposed",
        "provider_key_visible"
      ],
      "properties": {
        "report_only": { "const": true },
        "deterministic_issue_detection_performed": { "const": true },
        "legal_conclusion_asserted": { "const": false },
        "legal_advice_provided": { "const": false },
        "client_facing_output_generated": { "const": false },
        "attorney_review_required": { "const": true },
        "human_review_required": { "const": true },
        "matter_data_write_allowed": { "const": false },
        "task_state_write_allowed": { "const": false },
        "workflow_transition_allowed": { "const": false },
        "runtime_execution_performed": { "const": false },
        "delivery_execution_performed": { "const": false },
        "desktop_mutation_allowed": { "const": false },
        "desktop_source_of_truth": { "const": false },
        "protected_mutation_executed": { "const": false },
        "secret_material_exposed": { "const": false },
        "provider_key_visible": { "const": false }
      }
    },
    "contract": {
      "type": "object",
      "required": [
        "schema_version",
        "contract_id",
        "source_of_truth",
        "detection_rule",
        "no_legal_conclusion_rule",
        "missing_data_rule",
        "client_output_rule",
        "attorney_review_rule",
        "desktop_companion_rule",
        "mutation_policy",
        "created_at"
      ],
      "properties": {
        "schema_version": { "const": "ldd-issue-detection-contract.v1" },
        "contract_id": { "const": "ldd-issue-detection.v1" },
        "source_of_truth": { "const": "ldd_fact_extraction_and_demo_matter_metadata" },
        "detection_rule": { "type": "string" },
        "no_legal_conclusion_rule": { "type": "string" },
        "missing_data_rule": { "type": "string" },
        "client_output_rule": { "type": "string" },
        "attorney_review_rule": { "type": "string" },
        "desktop_companion_rule": { "type": "string" },
        "mutation_policy": { "type": "string" },
        "created_at": { "type": "string" }
      }
    },
    "rule": {
      "type": "object",
      "required": [
        "schema_version",
        "ldd_issue_detection_rule_id",
        "issue_type",
        "rule_status",
        "deterministic_only",
        "legal_conclusion_allowed",
        "client_facing_output_allowed",
        "attorney_review_required",
        "human_review_required"
      ],
      "properties": {
        "schema_version": { "const": "ldd-issue-detection-rule.v1" },
        "ldd_issue_detection_rule_id": { "type": "string", "minLength": 1 },
        "issue_type": { "$ref": "#/$defs/issue_type" },
        "rule_status": { "const": "active" },
        "deterministic_only": { "const": true },
        "legal_conclusion_allowed": { "const": false },
        "client_facing_output_allowed": { "const": false },
        "attorney_review_required": { "const": true },
        "human_review_required": { "const": true }
      }
    },
    "issue_record": {
      "type": "object",
      "required": [
        "schema_version",
        "ldd_issue_record_id",
        "matter_id",
        "issue_type",
        "issue_title",
        "issue_status",
        "issue_severity",
        "issue_flag",
        "source_fact_count",
        "source_gap",
        "follow_up_required",
        "deterministic_issue_detection_performed",
        "legal_conclusion_asserted",
        "legal_advice_provided",
        "client_facing_ready",
        "client_facing_output_generated",
        "attorney_review_required",
        "human_review_required",
        "matter_data_write_allowed",
        "task_state_write_allowed",
        "workflow_transition_allowed",
        "runtime_execution_allowed",
        "delivery_execution_allowed",
        "protected_action_allowed"
      ],
      "properties": {
        "schema_version": { "const": "ldd-issue-record.v1" },
        "ldd_issue_record_id": { "type": "string", "minLength": 1 },
        "matter_id": { "type": "string", "minLength": 1 },
        "issue_type": { "$ref": "#/$defs/issue_type" },
        "issue_title": { "type": "string", "minLength": 1 },
        "issue_status": { "const": "candidate_pending_attorney_review" },
        "issue_severity": { "$ref": "#/$defs/issue_severity" },
        "issue_flag": { "$ref": "#/$defs/issue_flag" },
        "source_fact_ids": { "type": "array" },
        "source_fact_count": { "type": "integer", "minimum": 0 },
        "source_gap": { "type": "boolean" },
        "follow_up_required": { "const": true },
        "deterministic_issue_detection_performed": { "const": true },
        "legal_conclusion_asserted": { "const": false },
        "legal_advice_provided": { "const": false },
        "client_facing_ready": { "const": false },
        "client_facing_output_generated": { "const": false },
        "attorney_review_required": { "const": true },
        "human_review_required": { "const": true },
        "matter_data_write_allowed": { "const": false },
        "task_state_write_allowed": { "const": false },
        "workflow_transition_allowed": { "const": false },
        "runtime_execution_allowed": { "const": false },
        "delivery_execution_allowed": { "const": false },
        "protected_action_allowed": { "const": false }
      }
    },
    "follow_up": {
      "type": "object",
      "required": [
        "schema_version",
        "ldd_issue_follow_up_id",
        "matter_id",
        "ldd_issue_record_id",
        "issue_type",
        "issue_severity",
        "issue_flag",
        "follow_up_title",
        "follow_up_owner",
        "follow_up_status",
        "attorney_review_required",
        "human_review_required",
        "client_facing_ready",
        "task_state_write_allowed",
        "workflow_transition_allowed",
        "runtime_execution_allowed",
        "delivery_execution_allowed",
        "protected_action_allowed"
      ],
      "properties": {
        "schema_version": { "const": "ldd-issue-follow-up.v1" },
        "ldd_issue_follow_up_id": { "type": "string", "minLength": 1 },
        "matter_id": { "type": "string", "minLength": 1 },
        "ldd_issue_record_id": { "type": "string", "minLength": 1 },
        "issue_type": { "$ref": "#/$defs/issue_type" },
        "issue_severity": { "$ref": "#/$defs/issue_severity" },
        "issue_flag": { "$ref": "#/$defs/issue_flag" },
        "follow_up_title": { "type": "string", "minLength": 1 },
        "follow_up_owner": { "type": "string", "minLength": 1 },
        "follow_up_status": { "const": "open_pending_attorney_review" },
        "attorney_review_required": { "const": true },
        "human_review_required": { "const": true },
        "client_facing_ready": { "const": false },
        "task_state_write_allowed": { "const": false },
        "workflow_transition_allowed": { "const": false },
        "runtime_execution_allowed": { "const": false },
        "delivery_execution_allowed": { "const": false },
        "protected_action_allowed": { "const": false }
      }
    },
    "severity_summary": {
      "type": "object",
      "required": [
        "schema_version",
        "ldd_issue_severity_summary_id",
        "issue_severity",
        "issue_record_count",
        "red_flag_count",
        "yellow_flag_count",
        "follow_up_required_count",
        "attorney_review_required_count",
        "client_facing_ready_count"
      ],
      "properties": {
        "schema_version": { "const": "ldd-issue-severity-summary.v1" },
        "ldd_issue_severity_summary_id": { "type": "string", "minLength": 1 },
        "issue_severity": { "$ref": "#/$defs/issue_severity" },
        "issue_record_count": { "type": "integer", "minimum": 1 },
        "red_flag_count": { "type": "integer", "minimum": 0 },
        "yellow_flag_count": { "type": "integer", "minimum": 0 },
        "follow_up_required_count": { "type": "integer", "minimum": 1 },
        "attorney_review_required_count": { "type": "integer", "minimum": 1 },
        "client_facing_ready_count": { "const": 0 }
      }
    },
    "matter_summary": {
      "type": "object",
      "required": [
        "schema_version",
        "ldd_issue_matter_summary_id",
        "matter_id",
        "ldd_issue_matter_status",
        "issue_record_count",
        "red_flag_count",
        "yellow_flag_count",
        "follow_up_count",
        "attorney_review_required",
        "human_review_required",
        "client_facing_ready"
      ],
      "properties": {
        "schema_version": { "const": "ldd-issue-matter-summary.v1" },
        "ldd_issue_matter_summary_id": { "type": "string", "minLength": 1 },
        "matter_id": { "type": "string", "minLength": 1 },
        "ldd_issue_matter_status": { "const": "issues_detected_pending_attorney_review" },
        "issue_record_count": { "type": "integer", "minimum": 1 },
        "red_flag_count": { "type": "integer", "minimum": 1 },
        "yellow_flag_count": { "type": "integer", "minimum": 1 },
        "follow_up_count": { "type": "integer", "minimum": 1 },
        "attorney_review_required": { "const": true },
        "human_review_required": { "const": true },
        "client_facing_ready": { "const": false }
      }
    },
    "desktop_boundary": {
      "type": "object",
      "required": [
        "schema_version",
        "boundary_status",
        "read_only",
        "desktop_mutation_allowed",
        "desktop_source_of_truth",
        "matter_data_write_allowed",
        "task_state_write_allowed",
        "workflow_transition_allowed",
        "runtime_execution_allowed",
        "delivery_execution_allowed",
        "protected_action_allowed",
        "client_facing_output_allowed_without_attorney_review"
      ],
      "properties": {
        "schema_version": { "const": "ldd-issue-detection-desktop-boundary.v1" },
        "boundary_status": { "const": "enforced" },
        "read_only": { "const": true },
        "desktop_mutation_allowed": { "const": false },
        "desktop_source_of_truth": { "const": false },
        "matter_data_write_allowed": { "const": false },
        "task_state_write_allowed": { "const": false },
        "workflow_transition_allowed": { "const": false },
        "runtime_execution_allowed": { "const": false },
        "delivery_execution_allowed": { "const": false },
        "protected_action_allowed": { "const": false },
        "client_facing_output_allowed_without_attorney_review": { "const": false }
      }
    },
    "checkpoint": {
      "type": "object",
      "required": ["checkpoint_id", "status", "message"],
      "properties": {
        "checkpoint_id": { "type": "string", "minLength": 1 },
        "status": { "enum": ["passed", "failed"] },
        "message": { "type": "string" }
      }
    },
    "validation_item": {
      "type": "object",
      "required": ["path", "check_id", "status", "message"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "check_id": { "type": "string", "minLength": 1 },
        "status": { "enum": ["passed", "failed"] },
        "message": { "type": "string" }
      }
    },
    "validation": {
      "type": "object",
      "required": ["valid", "errors"],
      "properties": {
        "valid": { "type": "boolean" },
        "errors": { "type": "array" },
        "items": { "type": "array" }
      }
    },
    "summary": {
      "type": "object",
      "required": [
        "ldd_issue_detection_status",
        "source_ldd_fact_extraction_status",
        "source_ldd_fact_extraction_phase_status",
        "source_matter_status",
        "source_fact_record_count",
        "issue_rule_count",
        "issue_record_count",
        "detected_issue_count",
        "red_flag_count",
        "yellow_flag_count",
        "high_severity_issue_count",
        "medium_severity_issue_count",
        "source_gap_issue_count",
        "follow_up_count",
        "open_follow_up_count",
        "severity_summary_count",
        "matter_count",
        "deterministic_issue_detection_count",
        "client_facing_ready_count",
        "legal_conclusion_asserted_count",
        "legal_advice_provided",
        "client_facing_output_generated",
        "validation_error_count"
      ],
      "properties": {
        "ldd_issue_detection_status": { "enum": ["complete", "blocked"] },
        "source_ldd_fact_extraction_status": { "const": "complete" },
        "source_ldd_fact_extraction_phase_status": { "const": "complete" },
        "source_matter_status": { "const": "complete" },
        "source_fact_record_count": { "type": "integer", "minimum": 1 },
        "issue_rule_count": { "type": "integer", "minimum": 5 },
        "issue_record_count": { "type": "integer", "minimum": 1 },
        "detected_issue_count": { "type": "integer", "minimum": 1 },
        "red_flag_count": { "type": "integer", "minimum": 1 },
        "yellow_flag_count": { "type": "integer", "minimum": 1 },
        "high_severity_issue_count": { "type": "integer", "minimum": 1 },
        "medium_severity_issue_count": { "type": "integer", "minimum": 1 },
        "source_gap_issue_count": { "type": "integer", "minimum": 1 },
        "follow_up_count": { "type": "integer", "minimum": 1 },
        "open_follow_up_count": { "type": "integer", "minimum": 1 },
        "severity_summary_count": { "type": "integer", "minimum": 1 },
        "matter_count": { "type": "integer", "minimum": 1 },
        "deterministic_issue_detection_count": { "type": "integer", "minimum": 1 },
        "client_facing_ready_count": { "const": 0 },
        "legal_conclusion_asserted_count": { "const": 0 },
        "legal_advice_provided": { "const": false },
        "client_facing_output_generated": { "const": false },
        "validation_error_count": { "const": 0 }
      }
    },
    "issue_type": {
      "enum": ["tax_exposure", "missing_deliverable", "negotiation_gap", "source_gap", "closing_condition"]
    },
    "issue_severity": {
      "enum": ["high", "medium", "low"]
    },
    "issue_flag": {
      "enum": ["red", "yellow", "green"]
    }
  }
}
