{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://amic.local/hermes/human-review-cycle-receipt-completion-workbench.schema.json",
  "title": "Hermes Human Review Cycle Receipt Completion Workbench",
  "type": "object",
  "required": [
    "schema_version",
    "generated_at",
    "workbench_id",
    "output_dir",
    "workbench_status",
    "safe_handling",
    "sources",
    "summary",
    "actor_workbenches",
    "workbench_items",
    "validation"
  ],
  "properties": {
    "schema_version": { "const": "human-review-cycle-receipt-completion-workbench.v1" },
    "generated_at": { "type": "string", "format": "date-time" },
    "workbench_id": { "type": "string" },
    "output_dir": { "type": "string" },
    "workbench_status": { "$ref": "#/$defs/status" },
    "safe_handling": { "$ref": "#/$defs/top_safe_handling" },
    "sources": { "type": "array", "items": { "$ref": "#/$defs/source" } },
    "summary": {
      "type": "object",
      "required": [
        "workbench_status",
        "source_available",
        "source_verification_status",
        "source_completion_status",
        "source_verification_item_count",
        "source_actor_verification_count",
        "actor_workbench_count",
        "workbench_item_count",
        "pending_human_input_count",
        "ready_for_validation_count",
        "attention_count",
        "blocked_count",
        "target_file_count",
        "receipt_completion_template_count",
        "field_prompt_count",
        "completed_prompt_count",
        "pending_prompt_count",
        "invalid_prompt_count",
        "protected_action_count",
        "evidence_decision_count",
        "validation_error_count",
        "by_required_actor",
        "by_gate_type",
        "by_workbench_status",
        "by_priority"
      ],
      "properties": {
        "workbench_status": { "$ref": "#/$defs/status" },
        "source_available": { "type": "boolean" },
        "source_verification_status": { "type": ["string", "null"] },
        "source_completion_status": { "type": ["string", "null"] },
        "source_verification_item_count": { "type": "integer", "minimum": 0 },
        "source_actor_verification_count": { "type": "integer", "minimum": 0 },
        "actor_workbench_count": { "type": "integer", "minimum": 0 },
        "workbench_item_count": { "type": "integer", "minimum": 0 },
        "pending_human_input_count": { "type": "integer", "minimum": 0 },
        "ready_for_validation_count": { "type": "integer", "minimum": 0 },
        "attention_count": { "type": "integer", "minimum": 0 },
        "blocked_count": { "type": "integer", "minimum": 0 },
        "target_file_count": { "type": "integer", "minimum": 0 },
        "receipt_completion_template_count": { "type": "integer", "minimum": 0 },
        "field_prompt_count": { "type": "integer", "minimum": 0 },
        "completed_prompt_count": { "type": "integer", "minimum": 0 },
        "pending_prompt_count": { "type": "integer", "minimum": 0 },
        "invalid_prompt_count": { "type": "integer", "minimum": 0 },
        "protected_action_count": { "type": "integer", "minimum": 0 },
        "evidence_decision_count": { "type": "integer", "minimum": 0 },
        "validation_error_count": { "type": "integer", "minimum": 0 },
        "by_required_actor": { "type": "object" },
        "by_gate_type": { "type": "object" },
        "by_workbench_status": { "type": "object" },
        "by_priority": { "type": "object" }
      }
    },
    "actor_workbenches": { "type": "array", "items": { "$ref": "#/$defs/actor_workbench" } },
    "workbench_items": { "type": "array", "items": { "$ref": "#/$defs/workbench_item" } },
    "validation": { "$ref": "#/$defs/validation" }
  },
  "$defs": {
    "status": {
      "enum": ["clear", "pending_human_input", "ready_for_validation", "attention", "blocked"]
    },
    "priority": {
      "enum": ["critical", "high", "medium", "low"]
    },
    "source": {
      "type": "object",
      "required": ["source_id", "label", "path", "available", "schema_version", "generated_at", "summary", "error"],
      "properties": {
        "source_id": { "type": "string" },
        "label": { "type": "string" },
        "path": { "type": "string" },
        "available": { "type": "boolean" },
        "schema_version": { "type": ["string", "null"] },
        "generated_at": { "type": ["string", "null"], "format": "date-time" },
        "summary": { "type": ["object", "null"] },
        "error": { "type": ["string", "null"] }
      }
    },
    "actor_workbench": {
      "type": "object",
      "required": [
        "actor_workbench_id",
        "actor_verification_id",
        "required_actor",
        "workbench_status",
        "priority",
        "workbench_item_count",
        "pending_human_input_count",
        "ready_for_validation_count",
        "attention_count",
        "blocked_count",
        "target_file_count",
        "field_prompt_count",
        "completed_prompt_count",
        "pending_prompt_count",
        "invalid_prompt_count",
        "workbench_item_ids",
        "receipt_completion_template_path",
        "workbench_json_path",
        "workbench_markdown_path",
        "workbench_html_path",
        "safe_handling"
      ],
      "properties": {
        "actor_workbench_id": { "type": "string" },
        "actor_verification_id": { "type": ["string", "null"] },
        "required_actor": { "type": "string" },
        "workbench_status": { "$ref": "#/$defs/status" },
        "priority": { "$ref": "#/$defs/priority" },
        "workbench_item_count": { "type": "integer", "minimum": 0 },
        "pending_human_input_count": { "type": "integer", "minimum": 0 },
        "ready_for_validation_count": { "type": "integer", "minimum": 0 },
        "attention_count": { "type": "integer", "minimum": 0 },
        "blocked_count": { "type": "integer", "minimum": 0 },
        "target_file_count": { "type": "integer", "minimum": 0 },
        "field_prompt_count": { "type": "integer", "minimum": 0 },
        "completed_prompt_count": { "type": "integer", "minimum": 0 },
        "pending_prompt_count": { "type": "integer", "minimum": 0 },
        "invalid_prompt_count": { "type": "integer", "minimum": 0 },
        "workbench_item_ids": { "type": "array", "items": { "type": "string" } },
        "receipt_completion_template_path": { "type": ["string", "null"] },
        "workbench_json_path": { "type": "string" },
        "workbench_markdown_path": { "type": "string" },
        "workbench_html_path": { "type": "string" },
        "safe_handling": { "$ref": "#/$defs/top_safe_handling" }
      }
    },
    "workbench_item": {
      "type": "object",
      "required": [
        "workbench_item_id",
        "workbench_rank",
        "verification_item_id",
        "completion_item_id",
        "field_audit_item_id",
        "console_item_id",
        "gate_item_id",
        "receipt_id",
        "required_actor",
        "gate_type",
        "priority",
        "workbench_status",
        "verification_status",
        "protected_action",
        "evidence_decision",
        "target_receipt_input_path",
        "receipt_completion_template_path",
        "field_prompt_count",
        "completed_prompt_count",
        "pending_prompt_count",
        "invalid_prompt_count",
        "pending_fields",
        "invalid_fields",
        "completed_fields",
        "field_results",
        "manual_instruction",
        "next_actions",
        "source_refs",
        "safe_handling"
      ],
      "properties": {
        "workbench_item_id": { "type": "string" },
        "workbench_rank": { "type": "integer", "minimum": 1 },
        "verification_item_id": { "type": "string" },
        "completion_item_id": { "type": "string" },
        "field_audit_item_id": { "type": "string" },
        "console_item_id": { "type": "string" },
        "gate_item_id": { "type": "string" },
        "receipt_id": { "type": ["string", "null"] },
        "required_actor": { "type": "string" },
        "gate_type": { "type": "string" },
        "priority": { "$ref": "#/$defs/priority" },
        "workbench_status": { "$ref": "#/$defs/status" },
        "verification_status": { "$ref": "#/$defs/status" },
        "protected_action": { "type": "boolean" },
        "evidence_decision": { "type": "boolean" },
        "target_receipt_input_path": { "type": ["string", "null"] },
        "receipt_completion_template_path": { "type": ["string", "null"] },
        "field_prompt_count": { "type": "integer", "minimum": 0 },
        "completed_prompt_count": { "type": "integer", "minimum": 0 },
        "pending_prompt_count": { "type": "integer", "minimum": 0 },
        "invalid_prompt_count": { "type": "integer", "minimum": 0 },
        "pending_fields": { "type": "array", "items": { "type": "string" } },
        "invalid_fields": { "type": "array", "items": { "type": "string" } },
        "completed_fields": { "type": "array", "items": { "type": "string" } },
        "field_results": { "type": "array", "items": { "type": "object" } },
        "manual_instruction": { "type": "string" },
        "next_actions": { "type": "array", "items": { "type": "string" } },
        "source_refs": { "type": "object" },
        "safe_handling": {
          "type": "object",
          "required": ["auto_execute_allowed", "protected_actions_executed", "workbench_only", "receipt_edits_must_be_manual"],
          "properties": {
            "auto_execute_allowed": { "const": false },
            "protected_actions_executed": { "const": false },
            "workbench_only": { "type": "boolean" },
            "receipt_edits_must_be_manual": { "type": "boolean" }
          }
        }
      }
    },
    "top_safe_handling": {
      "type": "object",
      "required": ["auto_execute_allowed", "draft_only", "workbench_only", "protected_actions_executed", "receipt_edits_must_be_manual"],
      "properties": {
        "auto_execute_allowed": { "const": false },
        "draft_only": { "type": "boolean" },
        "workbench_only": { "type": "boolean" },
        "protected_actions_executed": { "const": false },
        "receipt_edits_must_be_manual": { "type": "boolean" }
      }
    },
    "validation": {
      "type": "object",
      "required": ["valid", "errors"],
      "properties": {
        "valid": { "type": "boolean" },
        "errors": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["path", "message"],
            "properties": {
              "path": { "type": "string" },
              "message": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
