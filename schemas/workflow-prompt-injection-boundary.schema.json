{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hermes.local/schemas/workflow-prompt-injection-boundary.schema.json",
  "title": "Workflow Prompt Injection Boundary",
  "type": "object",
  "required": [
    "schema_version",
    "generated_at",
    "workflow_prompt_injection_boundary_id",
    "inputs",
    "source_contracts",
    "prompt_injection_boundary_contract",
    "untrusted_content_wrapper_records",
    "instruction_signal_records",
    "prompt_boundary_guard_records",
    "validation_items",
    "validation",
    "summary"
  ],
  "properties": {
    "schema_version": { "const": "workflow-prompt-injection-boundary.v1" },
    "generated_at": { "type": "string" },
    "workflow_prompt_injection_boundary_id": { "type": "string" },
    "inputs": { "type": "object" },
    "source_contracts": { "type": "object" },
    "prompt_injection_boundary_contract": { "type": "object" },
    "untrusted_content_wrapper_records": {
      "type": "array",
      "items": { "$ref": "#/$defs/untrusted_content_wrapper" }
    },
    "instruction_signal_records": {
      "type": "array",
      "items": { "$ref": "#/$defs/instruction_signal" }
    },
    "prompt_boundary_guard_records": {
      "type": "array",
      "items": { "$ref": "#/$defs/prompt_boundary_guard" }
    },
    "validation_items": {
      "type": "array",
      "items": { "$ref": "#/$defs/validation_item" }
    },
    "validation": {
      "type": "object",
      "required": ["valid", "errors"],
      "properties": {
        "valid": { "type": "boolean" },
        "errors": { "type": "array" }
      },
      "additionalProperties": true
    },
    "summary": {
      "type": "object",
      "required": [
        "workflow_prompt_injection_boundary_status",
        "prompt_injection_boundary_contract_id",
        "untrusted_content_wrapper_count",
        "instruction_signal_record_count",
        "instruction_signal_count",
        "neutralized_instruction_signal_count",
        "promoted_prompt_instruction_count",
        "promoted_tool_instruction_count",
        "policy_override_allowed_count",
        "external_transfer_allowed_count",
        "protected_action_executed_count",
        "validation_error_count"
      ],
      "additionalProperties": true
    }
  },
  "$defs": {
    "untrusted_content_wrapper": {
      "type": "object",
      "required": [
        "schema_version",
        "untrusted_content_wrapper_id",
        "retrieval_candidate_record_id",
        "retrieval_request_record_id",
        "resource_id",
        "content_role",
        "wrapper_status",
        "prompt_injection_handling",
        "instruction_boundary_status",
        "raw_instruction_execution_allowed",
        "tool_instruction_allowed",
        "system_prompt_override_allowed",
        "policy_override_allowed",
        "external_transfer_allowed",
        "protected_action_execution_allowed"
      ],
      "properties": {
        "schema_version": { "const": "untrusted-content-wrapper.v1" },
        "untrusted_content_wrapper_id": { "type": "string" },
        "retrieval_candidate_record_id": { "type": "string" },
        "retrieval_request_record_id": { "type": "string" },
        "context_packet_v2_record_id": { "type": "string" },
        "workflow_run_id": { "type": "string" },
        "resource_id": { "type": "string" },
        "source_span_id": { "type": ["string", "null"] },
        "source_span_bound": { "type": "boolean" },
        "matter_id": { "type": "string" },
        "classification": { "type": "string" },
        "content_origin": { "type": "string" },
        "content_role": { "type": "string" },
        "wrapper_status": { "type": "string" },
        "prompt_injection_handling": { "type": "string" },
        "instruction_boundary_status": { "type": "string" },
        "content_preview_available": { "type": "boolean" },
        "sanitized_content_preview": { "type": "string" },
        "raw_instruction_execution_allowed": { "type": "boolean" },
        "tool_instruction_allowed": { "type": "boolean" },
        "system_prompt_override_allowed": { "type": "boolean" },
        "policy_override_allowed": { "type": "boolean" },
        "client_facing_output_allowed": { "type": "boolean" },
        "external_transfer_allowed": { "type": "boolean" },
        "protected_action_execution_allowed": { "type": "boolean" }
      },
      "additionalProperties": true
    },
    "instruction_signal": {
      "type": "object",
      "required": [
        "schema_version",
        "instruction_signal_record_id",
        "untrusted_content_wrapper_id",
        "retrieval_candidate_record_id",
        "instruction_signal_status",
        "signal_count",
        "matched_signal_types",
        "instruction_treatment",
        "promoted_to_prompt_instruction",
        "promoted_to_tool_instruction",
        "policy_override_allowed",
        "neutralized"
      ],
      "properties": {
        "schema_version": { "const": "prompt-injection-instruction-signal.v1" },
        "instruction_signal_record_id": { "type": "string" },
        "untrusted_content_wrapper_id": { "type": "string" },
        "retrieval_candidate_record_id": { "type": "string" },
        "retrieval_request_record_id": { "type": "string" },
        "source_span_id": { "type": ["string", "null"] },
        "resource_id": { "type": "string" },
        "instruction_signal_status": { "type": "string" },
        "signal_count": { "type": "integer", "minimum": 0 },
        "matched_signal_types": {
          "type": "array",
          "items": { "type": "string" }
        },
        "instruction_treatment": { "type": "string" },
        "promoted_to_prompt_instruction": { "type": "boolean" },
        "promoted_to_tool_instruction": { "type": "boolean" },
        "policy_override_allowed": { "type": "boolean" },
        "neutralized": { "type": "boolean" }
      },
      "additionalProperties": true
    },
    "prompt_boundary_guard": {
      "type": "object",
      "required": [
        "schema_version",
        "prompt_boundary_guard_id",
        "retrieval_request_record_id",
        "prompt_boundary_guard_status",
        "candidate_count",
        "untrusted_content_wrapper_count",
        "instruction_signal_record_count",
        "instruction_signal_count",
        "neutralized_instruction_signal_count",
        "content_role_guard_status",
        "wrapper_guard_status",
        "instruction_promotion_guard_status",
        "query_execution_allowed",
        "external_transfer_allowed",
        "protected_action_execution_allowed"
      ],
      "properties": {
        "schema_version": { "const": "prompt-boundary-guard.v1" },
        "prompt_boundary_guard_id": { "type": "string" },
        "retrieval_request_record_id": { "type": "string" },
        "context_packet_v2_record_id": { "type": "string" },
        "workflow_run_id": { "type": "string" },
        "matter_id": { "type": "string" },
        "classification_floor": { "type": "string" },
        "prompt_boundary_guard_status": { "type": "string" },
        "source_retrieval_guard_status": { "type": "string" },
        "candidate_count": { "type": "integer", "minimum": 0 },
        "untrusted_content_wrapper_count": { "type": "integer", "minimum": 0 },
        "instruction_signal_record_count": { "type": "integer", "minimum": 0 },
        "instruction_signal_count": { "type": "integer", "minimum": 0 },
        "neutralized_instruction_signal_count": { "type": "integer", "minimum": 0 },
        "content_role_guard_status": { "type": "string" },
        "wrapper_guard_status": { "type": "string" },
        "instruction_promotion_guard_status": { "type": "string" },
        "query_execution_allowed": { "type": "boolean" },
        "external_transfer_allowed": { "type": "boolean" },
        "protected_action_execution_allowed": { "type": "boolean" }
      },
      "additionalProperties": true
    },
    "validation_item": {
      "type": "object",
      "required": ["check_id", "path", "status", "message"],
      "properties": {
        "check_id": { "type": "string" },
        "path": { "type": "string" },
        "status": { "type": "string" },
        "message": { "type": "string" }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
