{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hermes.local/schemas/hermes-loop-final-freeze.schema.json",
  "title": "Hermes Loop System v1.1 Final Freeze",
  "type": "object",
  "required": [
    "schema_version",
    "capability_id",
    "program_range",
    "source_program_range",
    "next_program_range",
    "p63600_review_gate_source_rows",
    "read_only_projection_contract_rows",
    "dashboard_status_projection_rows",
    "controlled_execution_candidate_boundary_rows",
    "p64000_freeze_matrix_rows",
    "authority_boundary_carryover_rows",
    "negative_fixture_contract_rows",
    "validation_command_rows",
    "p64000_closeout_rows",
    "post_p64000_handoff_rows",
    "hermes_loop_final_freeze_boundary",
    "summary",
    "validation"
  ],
  "properties": {
    "schema_version": { "const": "hermes-loop-final-freeze.v1" },
    "capability_id": { "const": "platform.hermes_loop_system_v1_1_final_freeze" },
    "program_range": { "const": "P63601-P64000" },
    "source_program_range": { "const": "P63201-P63600" },
    "next_program_range": { "const": "POST-P64000" },
    "p63600_review_gate_source_rows": { "type": "array", "minItems": 5, "items": { "$ref": "#/$defs/verdictRow" } },
    "read_only_projection_contract_rows": { "type": "array", "minItems": 16, "items": { "$ref": "#/$defs/verdictRow" } },
    "dashboard_status_projection_rows": { "type": "array", "minItems": 20, "items": { "$ref": "#/$defs/verdictRow" } },
    "controlled_execution_candidate_boundary_rows": { "type": "array", "minItems": 9, "items": { "$ref": "#/$defs/verdictRow" } },
    "p64000_freeze_matrix_rows": { "type": "array", "minItems": 15, "items": { "$ref": "#/$defs/verdictRow" } },
    "authority_boundary_carryover_rows": { "type": "array", "minItems": 27, "items": { "$ref": "#/$defs/verdictRow" } },
    "negative_fixture_contract_rows": { "type": "array", "minItems": 13, "items": { "$ref": "#/$defs/verdictRow" } },
    "validation_command_rows": { "type": "array", "minItems": 7, "items": { "$ref": "#/$defs/verdictRow" } },
    "p64000_closeout_rows": { "type": "array", "minItems": 10, "items": { "$ref": "#/$defs/verdictRow" } },
    "post_p64000_handoff_rows": { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/verdictRow" } },
    "hermes_loop_final_freeze_boundary": {
      "type": "object",
      "required": [
        "p64000_final_freeze_ready",
        "p63600_source_ready_now",
        "read_only_projection_ready_now",
        "dashboard_status_projection_ready_now",
        "controlled_execution_candidate_boundary_ready_now",
        "p64000_freeze_matrix_ready_now",
        "ready_for_post_p64000_handoff",
        "runtime_execution_allowed_now",
        "write_action_allowed_now",
        "connector_write_allowed_now",
        "protected_action_allowed_now",
        "ui_protected_action_allowed_now",
        "api_mutation_allowed_now",
        "automatic_apply_allowed_now",
        "candidate_execution_allowed_now",
        "p64000_production_pass_claim_allowed_now",
        "p64000_enterprise_pass_claim_allowed_now",
        "production_pass_allowed_now",
        "enterprise_pass_allowed_now",
        "codex_final_approval_allowed",
        "claude_final_approval_allowed",
        "production_pass_enabled",
        "enterprise_pass_enabled",
        "final_approval_enabled"
      ],
      "properties": {
        "p64000_final_freeze_ready": { "type": "boolean" },
        "p63600_source_ready_now": { "type": "boolean" },
        "read_only_projection_ready_now": { "type": "boolean" },
        "dashboard_status_projection_ready_now": { "type": "boolean" },
        "controlled_execution_candidate_boundary_ready_now": { "type": "boolean" },
        "p64000_freeze_matrix_ready_now": { "type": "boolean" },
        "ready_for_post_p64000_handoff": { "type": "boolean" },
        "runtime_execution_allowed_now": { "const": false },
        "write_action_allowed_now": { "const": false },
        "connector_write_allowed_now": { "const": false },
        "protected_action_allowed_now": { "const": false },
        "ui_protected_action_allowed_now": { "const": false },
        "api_mutation_allowed_now": { "const": false },
        "automatic_apply_allowed_now": { "const": false },
        "candidate_execution_allowed_now": { "const": false },
        "p64000_production_pass_claim_allowed_now": { "const": false },
        "p64000_enterprise_pass_claim_allowed_now": { "const": false },
        "production_pass_allowed_now": { "const": false },
        "enterprise_pass_allowed_now": { "const": false },
        "codex_final_approval_allowed": { "const": false },
        "claude_final_approval_allowed": { "const": false },
        "production_pass_enabled": { "const": false },
        "enterprise_pass_enabled": { "const": false },
        "final_approval_enabled": { "const": false }
      },
      "additionalProperties": true
    },
    "summary": {
      "type": "object",
      "required": [
        "hermes_loop_final_freeze_status",
        "program_range",
        "source_program_range",
        "next_program_range",
        "p63600_source_ready_now",
        "p64000_final_freeze_ready",
        "ready_for_post_p64000_handoff",
        "api_mutation_allowed_now",
        "automatic_apply_allowed_now",
        "candidate_execution_allowed_now",
        "production_pass_enabled",
        "enterprise_pass_enabled",
        "final_approval_enabled"
      ],
      "properties": {
        "hermes_loop_final_freeze_status": {
          "enum": [
            "p64000_final_freeze_ready",
            "valid_block_post_p64000_handoff_pending",
            "blocked_hermes_loop_final_freeze"
          ]
        },
        "program_range": { "const": "P63601-P64000" },
        "source_program_range": { "const": "P63201-P63600" },
        "next_program_range": { "const": "POST-P64000" },
        "api_mutation_allowed_now": { "const": false },
        "automatic_apply_allowed_now": { "const": false },
        "candidate_execution_allowed_now": { "const": false },
        "production_pass_enabled": { "const": false },
        "enterprise_pass_enabled": { "const": false },
        "final_approval_enabled": { "const": false }
      },
      "additionalProperties": true
    },
    "validation": {
      "type": "object",
      "required": ["valid", "error_count", "errors"],
      "properties": {
        "valid": { "type": "boolean" },
        "error_count": { "type": "number" },
        "errors": { "type": "array" }
      },
      "additionalProperties": true
    }
  },
  "$defs": {
    "verdictRow": {
      "type": "object",
      "required": [
        "row_id",
        "category",
        "label",
        "observed",
        "current_verdict",
        "evidence_ref",
        "block_reason",
        "next_allowed_action",
        "generated_at"
      ],
      "properties": {
        "row_id": { "type": "string" },
        "category": { "type": "string" },
        "label": { "type": "string" },
        "observed": { "type": "boolean" },
        "current_verdict": { "enum": ["pass", "block"] },
        "evidence_ref": { "type": ["string", "null"] },
        "block_reason": { "type": ["string", "null"] },
        "next_allowed_action": { "type": "string" },
        "generated_at": { "type": "string" }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
