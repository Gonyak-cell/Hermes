{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hermes.local/schemas/plan-request-contract.schema.json",
  "title": "Plan Request Contract",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "generated_at",
    "plan_request_contract_id",
    "plan_request_status",
    "plan_request_contract",
    "shared_planning_context",
    "plan_requests",
    "plan_request_bindings",
    "plan_request_desktop_boundary",
    "plan_request_checkpoints",
    "validation_items",
    "validation",
    "summary"
  ],
  "properties": {
    "schema_version": { "const": "plan-request-contract.v1" },
    "generated_at": { "type": "string", "minLength": 1 },
    "plan_request_contract_id": { "type": "string", "minLength": 1 },
    "plan_request_status": { "enum": ["complete", "blocked"] },
    "plan_request_contract": {
      "type": "object",
      "required": ["schema_version", "contract_id", "pack_id", "capability_id", "source_of_truth"],
      "properties": {
        "schema_version": { "const": "plan-request-contract-definition.v1" },
        "contract_id": { "const": "plan-request-contract.v1" },
        "pack_id": { "const": "personal-dev" },
        "capability_id": { "const": "personal_dev.codex.worktree_patch" },
        "source_of_truth": { "const": "shared_context_plan_requests_for_claude_and_codex" }
      }
    },
    "shared_planning_context": {
      "type": "object",
      "required": [
        "schema_version",
        "shared_context_id",
        "source_normalized_task_id",
        "context_hash",
        "constraints_hash",
        "required_gates",
        "constraints",
        "human_review_note"
      ],
      "properties": {
        "schema_version": { "const": "shared-planning-context.v1" },
        "shared_context_id": { "type": "string", "minLength": 1 },
        "source_normalized_task_id": { "type": "string", "minLength": 1 },
        "context_hash": { "type": "string", "minLength": 32 },
        "constraints_hash": { "type": "string", "minLength": 32 },
        "required_gates": { "type": "array", "minItems": 1 },
        "constraints": { "type": "array", "minItems": 1 },
        "human_review_note": { "type": "string", "minLength": 1 }
      }
    },
    "plan_requests": {
      "type": "array",
      "minItems": 2,
      "items": { "$ref": "#/$defs/plan_request" }
    },
    "plan_request_bindings": {
      "type": "array",
      "minItems": 2,
      "items": { "$ref": "#/$defs/plan_request_binding" }
    },
    "plan_request_desktop_boundary": {
      "type": "object",
      "required": [
        "schema_version",
        "boundary_status",
        "read_only",
        "mutation_allowed",
        "runtime_execution_allowed",
        "external_agent_invocation_allowed",
        "plan_acceptance_allowed",
        "task_state_write_allowed",
        "source_of_truth"
      ],
      "properties": {
        "schema_version": { "const": "plan-request-desktop-boundary.v1" },
        "boundary_status": { "const": "enforced" },
        "read_only": { "const": true },
        "mutation_allowed": { "const": false },
        "runtime_execution_allowed": { "const": false },
        "external_agent_invocation_allowed": { "const": false },
        "plan_acceptance_allowed": { "const": false },
        "task_state_write_allowed": { "const": false },
        "source_of_truth": { "const": false }
      }
    },
    "plan_request_checkpoints": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/checkpoint" }
    },
    "validation_items": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/validation_item" }
    },
    "validation": {
      "type": "object",
      "required": ["valid", "errors"],
      "properties": {
        "valid": { "type": "boolean" },
        "errors": { "type": "array" }
      }
    },
    "summary": {
      "type": "object",
      "required": [
        "plan_request_status",
        "plan_request_contract_id",
        "plan_request_count",
        "claude_plan_request_count",
        "codex_plan_request_count",
        "unique_context_hash_count",
        "unique_constraints_hash_count",
        "external_agent_invocation_performed_count",
        "validation_error_count"
      ],
      "properties": {
        "plan_request_status": { "enum": ["complete", "blocked"] },
        "plan_request_contract_id": { "const": "plan-request-contract.v1" },
        "plan_request_count": { "type": "integer", "minimum": 0 },
        "claude_plan_request_count": { "type": "integer", "minimum": 0 },
        "codex_plan_request_count": { "type": "integer", "minimum": 0 },
        "unique_context_hash_count": { "type": "integer", "minimum": 0 },
        "unique_constraints_hash_count": { "type": "integer", "minimum": 0 },
        "external_agent_invocation_performed_count": { "type": "integer", "minimum": 0 },
        "validation_error_count": { "type": "integer", "minimum": 0 }
      }
    }
  },
  "$defs": {
    "plan_request": {
      "type": "object",
      "required": [
        "schema_version",
        "plan_request_id",
        "runtime_id",
        "agent",
        "request_status",
        "shared_context_id",
        "context_hash",
        "constraints_hash",
        "external_agent_invocation_performed",
        "plan_acceptance_performed",
        "command_execution_performed"
      ],
      "properties": {
        "schema_version": { "const": "plan-request.v1" },
        "agent": { "enum": ["claude_code", "codex"] },
        "request_status": { "const": "ready" },
        "external_agent_invocation_performed": { "const": false },
        "plan_acceptance_performed": { "const": false },
        "command_execution_performed": { "const": false }
      }
    },
    "plan_request_binding": {
      "type": "object",
      "required": [
        "schema_version",
        "binding_id",
        "plan_request_id",
        "shared_context_id",
        "binding_status",
        "context_hash_matches",
        "constraints_hash_matches"
      ],
      "properties": {
        "schema_version": { "const": "plan-request-binding.v1" },
        "binding_status": { "const": "bound" },
        "context_hash_matches": { "const": true },
        "constraints_hash_matches": { "const": true }
      }
    },
    "checkpoint": {
      "type": "object",
      "required": ["schema_version", "checkpoint_id", "status", "message"],
      "properties": {
        "schema_version": { "const": "plan-request-checkpoint.v1" },
        "status": { "enum": ["passed", "failed"] }
      }
    },
    "validation_item": {
      "type": "object",
      "required": ["path", "checkpoint_id", "check_id", "status", "message"],
      "properties": {
        "status": { "enum": ["passed", "failed"] }
      }
    }
  }
}
