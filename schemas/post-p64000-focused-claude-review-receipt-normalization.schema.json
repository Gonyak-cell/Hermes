{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hermes.local/schemas/post-p64000-focused-claude-review-receipt-normalization.schema.json",
  "title": "Post-P64000 Focused Claude Review Receipt Normalization",
  "type": "object",
  "required": [
    "schema_version",
    "capability_id",
    "program_range",
    "source_program_range",
    "dispatch_program_range",
    "reviewed_program_range",
    "next_program_range",
    "post_p64000_focused_claude_review_receipt_normalization_contract",
    "p70000_capture_source_rows",
    "normalized_focused_claude_review_receipt",
    "normalized_focused_review_receipt_rows",
    "focused_finding_classification_rows",
    "focused_finding_loop_rows",
    "focused_finding_action_rows",
    "receipt_boundary_rows",
    "authority_boundary_rows",
    "negative_fixture_contract_rows",
    "validation_command_rows",
    "p70400_wiring_rows",
    "p70400_closeout_rows",
    "p70401_handoff_rows",
    "post_p64000_focused_claude_review_receipt_normalization_boundary",
    "summary",
    "validation"
  ],
  "properties": {
    "schema_version": { "const": "post-p64000-focused-claude-review-receipt-normalization.v1" },
    "capability_id": { "const": "platform.post_p64000_focused_claude_review_receipt_normalization" },
    "program_range": { "const": "P70001-P70400" },
    "source_program_range": { "const": "P69601-P70000" },
    "dispatch_program_range": { "const": "P69201-P69600" },
    "reviewed_program_range": { "const": "P68801-P69200" },
    "next_program_range": { "const": "P70401-P70800" },
    "post_p64000_focused_claude_review_receipt_normalization_contract": {
      "type": "object",
      "required": [
        "blocking_findings_visible",
        "clean_checkpoint_allowed_with_blocking_findings",
        "fixed_verified_resolved_claim_allowed",
        "finding_resolution_allowed",
        "source_mutation_allowed",
        "claude_final_approval_allowed",
        "production_pass_allowed",
        "enterprise_pass_allowed"
      ],
      "properties": {
        "blocking_findings_visible": { "const": true },
        "clean_checkpoint_allowed_with_blocking_findings": { "const": false },
        "fixed_verified_resolved_claim_allowed": { "const": false },
        "finding_resolution_allowed": { "const": false },
        "source_mutation_allowed": { "const": false },
        "claude_final_approval_allowed": { "const": false },
        "production_pass_allowed": { "const": false },
        "enterprise_pass_allowed": { "const": false }
      },
      "additionalProperties": true
    },
    "p70000_capture_source_rows": { "type": "array", "minItems": 11, "items": { "$ref": "#/$defs/verdictRow" } },
    "normalized_focused_claude_review_receipt": {
      "type": "object",
      "required": [
        "schema_version",
        "receipt_status",
        "reviewer",
        "reviewer_lane",
        "dispatch_program_range",
        "reviewed_program_range",
        "review_event_program_range",
        "raw_output_sha256",
        "is_claude_review_event",
        "overall_verdict",
        "blocks_clean_checkpoint",
        "open_blocking_finding_count",
        "normalized_blocking_finding_count",
        "finding_count",
        "reviewed_hrm_ids",
        "findings",
        "source_mutation_performed",
        "finding_resolution_performed",
        "finding_fixed_claimed",
        "finding_verified_claimed",
        "reviewer_final_approval_allowed",
        "protected_closeout_allowed",
        "production_pass_allowed",
        "enterprise_pass_allowed"
      ],
      "properties": {
        "schema_version": { "const": "post-p64000-focused-claude-review-receipt.v1" },
        "receipt_status": { "enum": ["observed_blocking_findings", "observed_clean_candidate"] },
        "reviewer": { "const": "claude-code-opus-max" },
        "reviewer_lane": { "const": "independent_read_only" },
        "dispatch_program_range": { "const": "P69201-P69600" },
        "reviewed_program_range": { "const": "P68801-P69200" },
        "review_event_program_range": { "const": "P69601-P70000" },
        "raw_output_sha256": { "type": "string", "minLength": 64 },
        "is_claude_review_event": { "const": true },
        "overall_verdict": { "type": "string" },
        "blocks_clean_checkpoint": { "type": "boolean" },
        "clean_checkpoint_allowed": { "const": false },
        "open_blocking_finding_count": { "type": "number" },
        "normalized_blocking_finding_count": { "type": "number", "minimum": 3 },
        "finding_count": { "type": "number", "minimum": 3 },
        "reviewed_hrm_ids": {
          "type": "array",
          "allOf": [
            { "contains": { "const": "HRM-04" } },
            { "contains": { "const": "HRM-03" } },
            { "contains": { "const": "HRM-01" } }
          ],
          "minItems": 3
        },
        "findings": { "type": "array", "minItems": 3, "items": { "$ref": "#/$defs/normalizedFinding" } },
        "source_mutation_performed": { "const": false },
        "finding_resolution_performed": { "const": false },
        "finding_fixed_claimed": { "const": false },
        "finding_verified_claimed": { "const": false },
        "reviewer_final_approval_allowed": { "const": false },
        "protected_closeout_allowed": { "const": false },
        "production_pass_allowed": { "const": false },
        "enterprise_pass_allowed": { "const": false }
      },
      "additionalProperties": true
    },
    "normalized_focused_review_receipt_rows": { "type": "array", "minItems": 16, "items": { "$ref": "#/$defs/verdictRow" } },
    "focused_finding_classification_rows": { "type": "array", "minItems": 3, "items": { "$ref": "#/$defs/verdictRow" } },
    "focused_finding_loop_rows": { "type": "array", "minItems": 7, "items": { "$ref": "#/$defs/verdictRow" } },
    "focused_finding_action_rows": { "type": "array", "minItems": 3, "items": { "$ref": "#/$defs/verdictRow" } },
    "receipt_boundary_rows": { "type": "array", "minItems": 9, "items": { "$ref": "#/$defs/verdictRow" } },
    "authority_boundary_rows": { "type": "array", "minItems": 30, "items": { "$ref": "#/$defs/verdictRow" } },
    "negative_fixture_contract_rows": { "type": "array", "minItems": 28, "items": { "$ref": "#/$defs/verdictRow" } },
    "validation_command_rows": { "type": "array", "minItems": 9, "items": { "$ref": "#/$defs/verdictRow" } },
    "p70400_wiring_rows": { "type": "array", "minItems": 3, "items": { "$ref": "#/$defs/verdictRow" } },
    "p70400_closeout_rows": { "type": "array", "minItems": 10, "items": { "$ref": "#/$defs/verdictRow" } },
    "p70401_handoff_rows": { "type": "array", "minItems": 3, "items": { "$ref": "#/$defs/verdictRow" } },
    "post_p64000_focused_claude_review_receipt_normalization_boundary": {
      "type": "object",
      "required": [
        "post_p64000_focused_claude_review_receipt_normalization_ready",
        "p70000_capture_ready_now",
        "normalized_focused_receipt_ready_now",
        "focused_finding_classification_ready_now",
        "focused_finding_loop_visible_now",
        "focused_finding_actions_ready_now",
        "receipt_boundary_ready_now",
        "ready_for_p70401_handoff",
        "clean_checkpoint_allowed_now",
        "blocking_finding_count",
        "finding_count",
        "raw_output_sha256",
        "runtime_execution_allowed_now",
        "command_execution_allowed_now",
        "write_action_allowed_now",
        "direct_file_write_allowed_now",
        "generated_patch_apply_allowed_now",
        "connector_ingestion_allowed_now",
        "connector_write_allowed_now",
        "external_service_mutation_allowed_now",
        "raw_material_access_allowed_now",
        "cross_domain_access_allowed_now",
        "secret_read_allowed_now",
        "protected_action_allowed_now",
        "protected_closeout_allowed_now",
        "deployment_allowed_now",
        "release_approval_allowed_now",
        "production_pass_allowed_now",
        "enterprise_pass_allowed_now",
        "enterprise_trust_claim_allowed_now",
        "codex_final_approval_allowed",
        "claude_final_approval_allowed",
        "final_automated_approval_allowed_now",
        "focused_finding_fixed_claim_allowed_now",
        "focused_finding_verified_claim_allowed_now",
        "focused_finding_resolved_claim_allowed_now",
        "reviewer_mutation_allowed_now",
        "source_mutation_from_review_allowed_now",
        "finding_resolution_allowed_now",
        "finding_auto_resolved_allowed_now",
        "clean_checkpoint_claim_allowed_now",
        "protected_closeout_from_review_allowed_now",
        "claude_review_final_approval_allowed_now",
        "post_p70400_production_pass_claim_allowed_now",
        "post_p70400_enterprise_pass_claim_allowed_now",
        "production_pass_enabled",
        "enterprise_pass_enabled",
        "final_approval_enabled"
      ],
      "properties": {
        "clean_checkpoint_allowed_now": { "const": false },
        "blocking_finding_count": { "minimum": 3 },
        "runtime_execution_allowed_now": { "const": false },
        "command_execution_allowed_now": { "const": false },
        "write_action_allowed_now": { "const": false },
        "direct_file_write_allowed_now": { "const": false },
        "generated_patch_apply_allowed_now": { "const": false },
        "connector_ingestion_allowed_now": { "const": false },
        "connector_write_allowed_now": { "const": false },
        "external_service_mutation_allowed_now": { "const": false },
        "raw_material_access_allowed_now": { "const": false },
        "cross_domain_access_allowed_now": { "const": false },
        "secret_read_allowed_now": { "const": false },
        "protected_action_allowed_now": { "const": false },
        "protected_closeout_allowed_now": { "const": false },
        "deployment_allowed_now": { "const": false },
        "release_approval_allowed_now": { "const": false },
        "production_pass_allowed_now": { "const": false },
        "enterprise_pass_allowed_now": { "const": false },
        "enterprise_trust_claim_allowed_now": { "const": false },
        "codex_final_approval_allowed": { "const": false },
        "claude_final_approval_allowed": { "const": false },
        "final_automated_approval_allowed_now": { "const": false },
        "focused_finding_fixed_claim_allowed_now": { "const": false },
        "focused_finding_verified_claim_allowed_now": { "const": false },
        "focused_finding_resolved_claim_allowed_now": { "const": false },
        "reviewer_mutation_allowed_now": { "const": false },
        "source_mutation_from_review_allowed_now": { "const": false },
        "finding_resolution_allowed_now": { "const": false },
        "finding_auto_resolved_allowed_now": { "const": false },
        "clean_checkpoint_claim_allowed_now": { "const": false },
        "protected_closeout_from_review_allowed_now": { "const": false },
        "claude_review_final_approval_allowed_now": { "const": false },
        "post_p70400_production_pass_claim_allowed_now": { "const": false },
        "post_p70400_enterprise_pass_claim_allowed_now": { "const": false },
        "production_pass_enabled": { "const": false },
        "enterprise_pass_enabled": { "const": false },
        "final_approval_enabled": { "const": false }
      },
      "additionalProperties": true
    },
    "summary": {
      "type": "object",
      "required": [
        "post_p64000_focused_claude_review_receipt_normalization_status",
        "program_range",
        "p70000_capture_ready_now",
        "normalized_focused_receipt_ready_now",
        "focused_finding_loop_visible_now",
        "ready_for_p70401_handoff",
        "clean_checkpoint_allowed_now",
        "blocking_finding_count",
        "finding_count",
        "production_pass_enabled",
        "enterprise_pass_enabled",
        "final_approval_enabled"
      ],
      "properties": {
        "post_p64000_focused_claude_review_receipt_normalization_status": {
          "enum": [
            "focused_receipt_normalized_findings_ready_for_p70401",
            "valid_block_p70401_handoff_pending",
            "blocked_post_p64000_focused_claude_review_receipt_normalization"
          ]
        },
        "program_range": { "const": "P70001-P70400" },
        "clean_checkpoint_allowed_now": { "const": false },
        "blocking_finding_count": { "minimum": 3 },
        "production_pass_enabled": { "const": false },
        "enterprise_pass_enabled": { "const": false },
        "final_approval_enabled": { "const": false }
      },
      "additionalProperties": true
    },
    "validation": {
      "type": "object",
      "required": ["valid", "error_count", "errors"],
      "properties": {
        "valid": { "type": "boolean" },
        "error_count": { "type": "integer" },
        "errors": { "type": "array" }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true,
  "$defs": {
    "normalizedFinding": {
      "type": "object",
      "required": ["id", "severity", "category", "location", "evidence", "issue", "proposed_change", "blocks_clean_checkpoint", "normalized_status", "next_allowed_action"],
      "properties": {
        "id": { "type": "string" },
        "severity": { "type": "string" },
        "category": { "type": "string" },
        "location": { "type": "string" },
        "evidence": { "type": "string" },
        "issue": { "type": "string" },
        "proposed_change": { "type": "string" },
        "blocks_clean_checkpoint": { "type": "boolean" },
        "normalized_status": { "enum": ["blocking_open", "nonblocking_open"] },
        "next_allowed_action": { "type": "string" }
      },
      "additionalProperties": true
    },
    "verdictRow": {
      "type": "object",
      "required": ["row_id", "category", "label", "observed", "current_verdict", "evidence_ref", "generated_at"],
      "properties": {
        "row_id": { "type": "string" },
        "category": { "type": "string" },
        "label": { "type": "string" },
        "observed": { "type": "boolean" },
        "current_verdict": { "enum": ["pass", "block"] },
        "evidence_ref": { "type": "string" },
        "generated_at": { "type": "string" }
      },
      "additionalProperties": true
    }
  }
}
