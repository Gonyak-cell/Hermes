{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hermes.local/schemas/release-readiness-control-plane.schema.json",
  "title": "Hermes Release Readiness Control Plane",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "capability_id",
    "program_range",
    "source_program_range",
    "release_readiness_contract",
    "release_phase_rows",
    "release_source_binding_rows",
    "release_candidate_contract_rows",
    "migration_readiness_rows",
    "release_rollback_restore_rows",
    "incident_response_plan_rows",
    "production_checklist_rows",
    "signed_provenance_gate_rows",
    "claude_release_review_rows",
    "release_operator_projection_rows",
    "release_authority_guard_rows",
    "p13000_freeze_rows",
    "release_readiness_boundary",
    "release_readiness_validation_items",
    "validation",
    "summary"
  ],
  "properties": {
    "schema_version": { "const": "release-readiness-control-plane.v1" },
    "capability_id": { "const": "platform.release_readiness_control_plane" },
    "program_range": { "const": "P12801-P13000" },
    "source_program_range": { "const": "P12601-P12800" },
    "release_phase_rows": { "type": "array", "minItems": 10, "items": { "$ref": "#/$defs/verdictRow" } },
    "release_source_binding_rows": { "type": "array", "minItems": 8, "items": { "$ref": "#/$defs/verdictRow" } },
    "release_candidate_contract_rows": { "type": "array", "minItems": 6, "items": { "$ref": "#/$defs/verdictRow" } },
    "migration_readiness_rows": { "type": "array", "minItems": 6, "items": { "$ref": "#/$defs/verdictRow" } },
    "release_rollback_restore_rows": { "type": "array", "minItems": 6, "items": { "$ref": "#/$defs/verdictRow" } },
    "incident_response_plan_rows": { "type": "array", "minItems": 6, "items": { "$ref": "#/$defs/verdictRow" } },
    "production_checklist_rows": { "type": "array", "minItems": 6, "items": { "$ref": "#/$defs/verdictRow" } },
    "signed_provenance_gate_rows": { "type": "array", "minItems": 6, "items": { "$ref": "#/$defs/verdictRow" } },
    "claude_release_review_rows": { "type": "array", "minItems": 5, "items": { "$ref": "#/$defs/verdictRow" } },
    "release_operator_projection_rows": { "type": "array", "minItems": 6, "items": { "$ref": "#/$defs/verdictRow" } },
    "release_authority_guard_rows": { "type": "array", "minItems": 6, "items": { "$ref": "#/$defs/verdictRow" } },
    "p13000_freeze_rows": { "type": "array", "minItems": 12, "items": { "$ref": "#/$defs/verdictRow" } },
    "release_readiness_boundary": {
      "type": "object",
      "required": [
        "source_human_owner_adjudication_available",
        "source_ready_for_p12801_handoff",
        "source_block_visible_now",
        "signed_provenance_receipt_present_now",
        "signed_provenance_block_visible_now",
        "attestation_verification_passed_now",
        "claude_release_review_receipt_present_now",
        "claude_release_review_block_visible_now",
        "release_candidate_contract_ready",
        "migration_readiness_ready",
        "rollback_restore_plan_ready",
        "incident_response_plan_ready",
        "production_checklist_ready",
        "release_authority_guard_ready",
        "p13000_release_readiness_freeze_ready",
        "ready_for_p13001_handoff",
        "deployment_allowed_now",
        "migration_execution_allowed_now",
        "rollback_execution_allowed_now",
        "release_approval_allowed_now",
        "protected_action_allowed_now",
        "write_action_allowed_now",
        "connector_write_enabled",
        "runtime_execution_allowed_now",
        "raw_body_exposure_allowed",
        "secret_read_allowed_now",
        "final_approval_ui_enabled",
        "codex_final_approval_ui_enabled",
        "claude_final_approval_ui_enabled",
        "production_pass_enabled",
        "enterprise_pass_enabled",
        "enterprise_trust_claim_allowed_now",
        "unsafe_flag_count"
      ],
      "properties": {
        "source_human_owner_adjudication_available": { "type": "boolean" },
        "source_ready_for_p12801_handoff": { "type": "boolean" },
        "source_block_visible_now": { "type": "boolean" },
        "signed_provenance_receipt_present_now": { "type": "boolean" },
        "signed_provenance_block_visible_now": { "type": "boolean" },
        "attestation_verification_passed_now": { "type": "boolean" },
        "claude_release_review_receipt_present_now": { "type": "boolean" },
        "claude_release_review_block_visible_now": { "type": "boolean" },
        "release_candidate_contract_ready": { "type": "boolean" },
        "migration_readiness_ready": { "type": "boolean" },
        "rollback_restore_plan_ready": { "type": "boolean" },
        "incident_response_plan_ready": { "type": "boolean" },
        "production_checklist_ready": { "type": "boolean" },
        "release_authority_guard_ready": { "type": "boolean" },
        "p13000_release_readiness_freeze_ready": { "type": "boolean" },
        "ready_for_p13001_handoff": { "type": "boolean" },
        "deployment_allowed_now": { "const": false },
        "migration_execution_allowed_now": { "const": false },
        "rollback_execution_allowed_now": { "const": false },
        "release_approval_allowed_now": { "const": false },
        "protected_action_allowed_now": { "const": false },
        "write_action_allowed_now": { "const": false },
        "connector_write_enabled": { "const": false },
        "runtime_execution_allowed_now": { "const": false },
        "raw_body_exposure_allowed": { "const": false },
        "secret_read_allowed_now": { "const": false },
        "final_approval_ui_enabled": { "const": false },
        "codex_final_approval_ui_enabled": { "const": false },
        "claude_final_approval_ui_enabled": { "const": false },
        "production_pass_enabled": { "const": false },
        "enterprise_pass_enabled": { "const": false },
        "enterprise_trust_claim_allowed_now": { "const": false },
        "unsafe_flag_count": { "const": 0 }
      }
    },
    "validation": {
      "type": "object",
      "required": ["valid", "error_count", "errors"],
      "properties": {
        "valid": { "type": "boolean" },
        "error_count": { "type": "integer", "minimum": 0 },
        "errors": { "type": "array" }
      }
    },
    "summary": {
      "type": "object",
      "required": [
        "release_readiness_control_plane_status",
        "program_range",
        "source_ready_for_p12801_handoff",
        "source_block_visible_now",
        "signed_provenance_receipt_present_now",
        "signed_provenance_block_visible_now",
        "claude_release_review_receipt_present_now",
        "claude_release_review_block_visible_now",
        "release_candidate_row_count",
        "production_checklist_row_count",
        "p13000_release_readiness_freeze_ready",
        "ready_for_p13001_handoff",
        "deployment_allowed_now",
        "release_approval_allowed_now",
        "production_pass_enabled",
        "enterprise_pass_enabled",
        "enterprise_trust_claim_allowed_now",
        "validation_error_count"
      ],
      "properties": {
        "release_readiness_control_plane_status": {
          "enum": [
            "ready_for_release_readiness_control_plane",
            "blocked_release_readiness_control_plane"
          ]
        },
        "program_range": { "const": "P12801-P13000" },
        "source_ready_for_p12801_handoff": { "type": "boolean" },
        "source_block_visible_now": { "type": "boolean" },
        "signed_provenance_receipt_present_now": { "type": "boolean" },
        "signed_provenance_block_visible_now": { "type": "boolean" },
        "claude_release_review_receipt_present_now": { "type": "boolean" },
        "claude_release_review_block_visible_now": { "type": "boolean" },
        "release_candidate_row_count": { "type": "integer", "minimum": 6 },
        "production_checklist_row_count": { "type": "integer", "minimum": 6 },
        "p13000_release_readiness_freeze_ready": { "type": "boolean" },
        "ready_for_p13001_handoff": { "type": "boolean" },
        "deployment_allowed_now": { "const": false },
        "release_approval_allowed_now": { "const": false },
        "production_pass_enabled": { "const": false },
        "enterprise_pass_enabled": { "const": false },
        "enterprise_trust_claim_allowed_now": { "const": false }
      }
    }
  },
  "$defs": {
    "verdictRow": {
      "type": "object",
      "required": [
        "row_id",
        "category",
        "label",
        "required",
        "observed",
        "evidence_ref",
        "current_verdict"
      ],
      "properties": {
        "row_id": { "type": "string", "minLength": 1 },
        "category": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "required": { "type": "boolean" },
        "observed": { "type": "boolean" },
        "evidence_ref": { "type": "string", "minLength": 1 },
        "current_verdict": { "enum": ["pass", "blocked"] },
        "block_reason": { "type": ["string", "null"] }
      }
    }
  }
}
