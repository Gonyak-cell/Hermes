          "schema_version": { "const": "zendd-protected-action-rollback-closeout-row.v1" },
          "phase_slot": { "const": "P740" },
          "closeout_status": { "const": "ready_for_protected_action_rollback_closeout" },
          "protected_action_execution_allowed_now": { "const": false },
          "rollback_execution_allowed_now": { "const": false },
          "receipt_application_allowed_now": { "const": false },
          "physical_code_move_allowed_now": { "const": false },
          "pass_promoted": { "const": false },
          "next_integration_phase_slot": { "const": "P741" },
          "read_only": { "const": true }
        },
        "additionalProperties": true
      }
