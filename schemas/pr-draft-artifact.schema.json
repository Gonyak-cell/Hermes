{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hermes.local/schemas/pr-draft-artifact.schema.json",
  "title": "PR Draft Artifact",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "generated_at",
    "pr_draft_artifact_id",
    "pr_draft_artifact_status",
    "safe_handling",
    "pr_draft_contract",
    "source_implementation_patch_capture",
    "source_diff_review_gate",
    "source_canonical_test_matrix",
    "source_dev_protected_scan",
    "source_output_delivery_contract_freeze",
    "pr_draft_output_artifacts",
    "pr_draft_sections",
    "pr_draft_test_evidence",
    "pr_draft_risks",
    "pr_draft_rollback_plan",
    "pr_draft_bindings",
    "pr_draft_desktop_boundary",
    "pr_draft_checkpoints",
    "validation_items",
    "validation",
    "summary"
  ],
  "properties": {
    "schema_version": { "const": "pr-draft-artifact.v1" },
    "generated_at": { "type": "string", "minLength": 1 },
    "pr_draft_artifact_id": { "type": "string", "minLength": 1 },
    "pr_draft_artifact_status": { "enum": ["complete", "blocked"] },
    "safe_handling": {
      "type": "object",
      "required": [
        "legal_advice",
        "client_facing_output",
        "human_review_required",
        "pr_draft_artifact_generated",
        "pull_request_creation_performed",
        "github_api_called",
        "branch_push_performed",
        "merge_performed",
        "release_performed",
        "command_execution_performed",
        "patch_application_performed",
        "git_command_executed",
        "filesystem_mutation_performed_outside_artifact_dir",
        "external_agent_invocation_performed",
        "plan_acceptance_performed",
        "protected_mutation_performed",
        "raw_secret_material_exposed",
        "provider_key_exposed"
      ],
      "properties": {
        "legal_advice": { "const": "not_provided" },
        "client_facing_output": { "const": "not_generated" },
        "human_review_required": { "const": true },
        "pr_draft_artifact_generated": { "const": true },
        "pull_request_creation_performed": { "const": false },
        "github_api_called": { "const": false },
        "branch_push_performed": { "const": false },
        "merge_performed": { "const": false },
        "release_performed": { "const": false },
        "command_execution_performed": { "const": false },
        "patch_application_performed": { "const": false },
        "git_command_executed": { "const": false },
        "filesystem_mutation_performed_outside_artifact_dir": { "const": false },
        "external_agent_invocation_performed": { "const": false },
        "plan_acceptance_performed": { "const": false },
        "protected_mutation_performed": { "const": false },
        "raw_secret_material_exposed": { "const": false },
        "provider_key_exposed": { "const": false }
      }
    },
    "pr_draft_contract": {
      "type": "object",
      "required": ["schema_version", "contract_id", "pack_id", "capability_id", "draft_authority", "source_of_truth"],
      "properties": {
        "schema_version": { "const": "pr-draft-contract-definition.v1" },
        "contract_id": { "const": "pr-draft-artifact.v1" },
        "pack_id": { "const": "personal-dev" },
        "capability_id": { "const": "personal_dev.codex.worktree_patch" },
        "draft_authority": { "const": "harness_control_plane" },
        "source_of_truth": { "const": "validated_diff_test_protected_scan_and_output_artifact_contracts" }
      }
    },
    "source_implementation_patch_capture": {
      "type": "object",
      "required": ["implementation_patch_capture_status", "patch_record_count", "touched_file_count", "patch_application_performed_count", "validation_error_count"],
      "properties": {
        "implementation_patch_capture_status": { "const": "complete" },
        "patch_record_count": { "const": 2 },
        "touched_file_count": { "type": "integer", "minimum": 1 },
        "patch_application_performed_count": { "const": 0 },
        "validation_error_count": { "const": 0 }
      }
    },
    "source_diff_review_gate": {
      "type": "object",
      "required": ["diff_review_gate_status", "gate_result_count", "passed_with_human_gate_count", "patch_application_allowed_count", "direct_merge_allowed_count", "validation_error_count"],
      "properties": {
        "diff_review_gate_status": { "const": "complete" },
        "gate_result_count": { "const": 2 },
        "passed_with_human_gate_count": { "const": 2 },
        "patch_application_allowed_count": { "const": 0 },
        "direct_merge_allowed_count": { "const": 0 },
        "validation_error_count": { "const": 0 }
      }
    },
    "source_canonical_test_matrix": {
      "type": "object",
      "required": ["canonical_test_matrix_status", "required_dimension_count", "passed_required_dimension_count", "failed_dimension_count", "timed_out_dimension_count", "binding_count", "validation_error_count"],
      "properties": {
        "canonical_test_matrix_status": { "const": "complete" },
        "required_dimension_count": { "type": "integer", "minimum": 3 },
        "passed_required_dimension_count": { "type": "integer", "minimum": 3 },
        "failed_dimension_count": { "const": 0 },
        "timed_out_dimension_count": { "const": 0 },
        "binding_count": { "const": 2 },
        "validation_error_count": { "const": 0 }
      }
    },
    "source_dev_protected_scan": {
      "type": "object",
      "required": ["dev_protected_scan_status", "protected_candidate_count", "blocked_before_approval_count", "secret_value_materialized_count", "raw_secret_material_exposed", "provider_key_exposed", "validation_error_count"],
      "properties": {
        "dev_protected_scan_status": { "const": "complete" },
        "protected_candidate_count": { "type": "integer", "minimum": 1 },
        "blocked_before_approval_count": { "type": "integer", "minimum": 1 },
        "secret_value_materialized_count": { "const": 0 },
        "raw_secret_material_exposed": { "const": false },
        "provider_key_exposed": { "const": false },
        "validation_error_count": { "const": 0 }
      }
    },
    "source_output_delivery_contract_freeze": {
      "type": "object",
      "required": ["freeze_status", "pr_draft_source_output_artifact_count", "source_output_artifact_status", "validation_error_count"],
      "properties": {
        "freeze_status": { "const": "complete" },
        "pr_draft_source_output_artifact_count": { "type": "integer", "minimum": 1 },
        "source_output_artifact_status": { "const": "available" },
        "validation_error_count": { "const": 0 }
      }
    },
    "pr_draft_output_artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["schema_version", "output_artifact_id", "artifact_type", "artifact_uri", "content_hash", "hash_status", "output_status", "delivery_state", "approval_status", "approval_request_ids", "delivery_action_ids", "blocking_gate_ids"],
        "properties": {
          "schema_version": { "const": "output-artifact.v2" },
          "artifact_type": { "const": "pr_draft" },
          "content_hash": { "type": "string", "minLength": 32 },
          "hash_status": { "const": "present" },
          "output_status": { "const": "draft" },
          "delivery_state": { "const": "blocked_pending_approval" },
          "approval_status": { "const": "pending" },
          "approval_request_ids": { "type": "array", "minItems": 1 },
          "delivery_action_ids": { "type": "array", "minItems": 1 },
          "blocking_gate_ids": { "type": "array", "contains": { "const": "human_approval_gate" } }
        }
      }
    },
    "pr_draft_sections": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "required": ["schema_version", "section_type", "section_status", "content_lines", "human_review_required"],
        "properties": {
          "schema_version": { "const": "pr-draft-section.v1" },
          "section_type": { "enum": ["summary", "tests", "risks", "rollback"] },
          "section_status": { "const": "ready_for_human_review" },
          "content_lines": { "type": "array", "minItems": 1 },
          "human_review_required": { "const": true }
        }
      }
    },
    "pr_draft_test_evidence": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": ["schema_version", "test_dimension", "test_evidence_status", "agent_self_report_trusted", "direct_merge_allowed"],
        "properties": {
          "schema_version": { "const": "pr-draft-test-evidence.v1" },
          "test_evidence_status": { "const": "passed" },
          "agent_self_report_trusted": { "const": false },
          "direct_merge_allowed": { "const": false }
        }
      }
    },
    "pr_draft_risks": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "required": ["schema_version", "risk_key", "risk_level", "risk_status", "mitigation", "human_review_required"],
        "properties": {
          "schema_version": { "const": "pr-draft-risk.v1" },
          "human_review_required": { "const": true }
        }
      }
    },
    "pr_draft_rollback_plan": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": ["schema_version", "rollback_action", "rollback_status", "command_execution_allowed", "protected_action_allowed"],
        "properties": {
          "schema_version": { "const": "pr-draft-rollback-step.v1" },
          "rollback_status": { "const": "draft_not_executed" },
          "command_execution_allowed": { "const": false },
          "protected_action_allowed": { "const": false }
        }
      }
    },
    "pr_draft_bindings": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["schema_version", "pr_draft_binding_status", "output_artifact_binding_status", "pull_request_creation_allowed", "direct_merge_allowed", "release_allowed"],
        "properties": {
          "schema_version": { "const": "pr-draft-binding.v1" },
          "pr_draft_binding_status": { "const": "bound_after_protected_scan" },
          "output_artifact_binding_status": { "const": "bound_to_output_artifact" },
          "pull_request_creation_allowed": { "const": false },
          "direct_merge_allowed": { "const": false },
          "release_allowed": { "const": false }
        }
      }
    },
    "pr_draft_desktop_boundary": {
      "type": "object",
      "required": ["schema_version", "boundary_status", "surface_policy", "read_only", "mutation_allowed", "github_api_allowed", "pull_request_creation_allowed", "direct_merge_allowed", "release_allowed", "source_of_truth"],
      "properties": {
        "schema_version": { "const": "pr-draft-desktop-boundary.v1" },
        "boundary_status": { "const": "enforced" },
        "surface_policy": { "const": "read_only_pr_draft_review_surface" },
        "read_only": { "const": true },
        "mutation_allowed": { "const": false },
        "github_api_allowed": { "const": false },
        "pull_request_creation_allowed": { "const": false },
        "direct_merge_allowed": { "const": false },
        "release_allowed": { "const": false },
        "source_of_truth": { "const": false }
      }
    },
    "summary": {
      "type": "object",
      "required": [
        "pr_draft_artifact_status",
        "pr_draft_artifact_contract_id",
        "pack_id",
        "capability_id",
        "pr_draft_output_artifact_count",
        "pr_draft_section_count",
        "test_evidence_count",
        "risk_count",
        "rollback_step_count",
        "pr_draft_binding_count",
        "pull_request_creation_performed",
        "github_api_called",
        "merge_performed",
        "release_performed",
        "desktop_read_only",
        "desktop_pull_request_creation_allowed",
        "validation_error_count"
      ],
      "properties": {
        "pr_draft_artifact_status": { "enum": ["complete", "blocked"] },
        "pr_draft_artifact_contract_id": { "const": "pr-draft-artifact.v1" },
        "pack_id": { "const": "personal-dev" },
        "capability_id": { "const": "personal_dev.codex.worktree_patch" },
        "pr_draft_output_artifact_count": { "const": 1 },
        "output_artifact_v2_count": { "const": 1 },
        "output_artifact_hash_present_count": { "const": 1 },
        "output_artifact_draft_count": { "const": 1 },
        "output_artifact_blocked_pending_approval_count": { "const": 1 },
        "output_artifact_pending_approval_count": { "const": 1 },
        "pr_draft_section_count": { "const": 4 },
        "summary_section_present": { "const": true },
        "tests_section_present": { "const": true },
        "risks_section_present": { "const": true },
        "rollback_section_present": { "const": true },
        "test_evidence_count": { "type": "integer", "minimum": 3 },
        "passed_test_evidence_count": { "type": "integer", "minimum": 3 },
        "agent_self_report_trusted_test_count": { "const": 0 },
        "risk_count": { "type": "integer", "minimum": 4 },
        "rollback_step_count": { "type": "integer", "minimum": 3 },
        "draft_not_executed_rollback_step_count": { "type": "integer", "minimum": 3 },
        "rollback_command_execution_allowed_count": { "const": 0 },
        "pr_draft_binding_count": { "const": 2 },
        "bound_after_protected_scan_count": { "const": 2 },
        "pull_request_creation_allowed_count": { "const": 0 },
        "direct_merge_allowed_count": { "const": 0 },
        "release_allowed_count": { "const": 0 },
        "pull_request_creation_performed": { "const": false },
        "github_api_called": { "const": false },
        "merge_performed": { "const": false },
        "release_performed": { "const": false },
        "raw_secret_material_exposed": { "const": false },
        "provider_key_exposed": { "const": false },
        "human_review_required": { "const": true },
        "desktop_read_only": { "const": true },
        "desktop_mutation_allowed": { "const": false },
        "desktop_command_execution_allowed": { "const": false },
        "desktop_github_api_allowed": { "const": false },
        "desktop_pull_request_creation_allowed": { "const": false },
        "desktop_direct_merge_allowed": { "const": false },
        "desktop_release_allowed": { "const": false },
        "desktop_source_of_truth": { "const": false },
        "failed_checkpoint_count": { "const": 0 },
        "validation_error_count": { "const": 0 }
      }
    }
  }
}
