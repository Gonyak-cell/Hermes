        "answer_receipt_production_pass_allowed_now": { "const": false },
        "answer_receipt_enterprise_trust_claim_allowed_now": { "const": false },
        "answer_receipt_secret_read_allowed_now": { "const": false },
        "answer_receipt_human_gate_bypass_allowed_now": { "const": false },
        "answer_receipt_independent_review_bypass_allowed_now": { "const": false },
        "answer_receipt_final_automated_approval_allowed_now": { "const": false },
        "production_pass_enabled": { "const": false },
        "enterprise_trust_claim_allowed_now": { "const": false }
      }
