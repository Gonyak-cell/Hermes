{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/ldd-rfi-generator.schema.json",
  "title": "Hermes LDD RFI Generator",
  "type": "object",
  "required": [
    "schema_version",
    "generated_at",
    "ldd_rfi_generator_id",
    "ldd_rfi_generator_status",
    "safe_handling",
    "inputs",
    "source_contracts",
    "ldd_rfi_generator_contract",
    "ldd_rfi_rules",
    "ldd_rfi_drafts",
    "ldd_rfi_questions",
    "ldd_rfi_missing_material_links",
    "ldd_rfi_issue_links",
    "ldd_rfi_matter_summaries",
    "ldd_rfi_generator_desktop_boundary",
    "ldd_rfi_generator_checkpoints",
    "validation_items",
    "validation",
    "summary"
  ],
  "properties": {
    "schema_version": { "const": "ldd-rfi-generator.v1" },
    "generated_at": { "type": "string", "minLength": 1 },
    "ldd_rfi_generator_id": { "type": "string", "minLength": 1 },
    "output_dir": { "type": "string" },
    "ldd_rfi_generator_status": { "enum": ["complete", "blocked"] },
    "safe_handling": { "$ref": "#/$defs/safe_handling" },
    "inputs": { "type": "object" },
    "source_contracts": { "type": "object" },
    "ldd_rfi_generator_contract": { "$ref": "#/$defs/contract" },
    "ldd_rfi_rules": { "type": "array", "minItems": 5, "items": { "$ref": "#/$defs/rule" } },
    "ldd_rfi_drafts": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/draft" } },
    "ldd_rfi_questions": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/question" } },
    "ldd_rfi_missing_material_links": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/missing_material_link" } },
    "ldd_rfi_issue_links": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/issue_link" } },
    "ldd_rfi_matter_summaries": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/matter_summary" } },
    "ldd_rfi_generator_desktop_boundary": { "$ref": "#/$defs/desktop_boundary" },
    "ldd_rfi_generator_checkpoints": { "type": "array", "items": { "$ref": "#/$defs/checkpoint" } },
    "validation_items": { "type": "array", "items": { "$ref": "#/$defs/validation_item" } },
    "validation": { "$ref": "#/$defs/validation" },
    "summary": { "$ref": "#/$defs/summary" }
  },
  "$defs": {
    "safe_handling": {
      "type": "object",
      "required": [
        "report_only",
        "draft_only",
        "deterministic_rfi_generation_performed",
        "legal_conclusion_asserted",
        "legal_advice_provided",
        "client_facing_ready",
        "client_facing_output_generated",
        "attorney_review_required",
        "human_review_required",
        "partner_approval_required_before_client_use",
        "matter_data_write_allowed",
        "task_state_write_allowed",
        "workflow_transition_allowed",
        "runtime_execution_performed",
        "delivery_execution_performed",
        "desktop_mutation_allowed",
        "desktop_source_of_truth",
        "protected_mutation_executed",
        "secret_material_exposed",
        "provider_key_visible"
      ],
      "properties": {
        "report_only": { "const": true },
        "draft_only": { "const": true },
        "deterministic_rfi_generation_performed": { "const": true },
        "legal_conclusion_asserted": { "const": false },
        "legal_advice_provided": { "const": false },
        "client_facing_ready": { "const": false },
        "client_facing_output_generated": { "const": false },
        "attorney_review_required": { "const": true },
        "human_review_required": { "const": true },
        "partner_approval_required_before_client_use": { "const": true },
        "matter_data_write_allowed": { "const": false },
        "task_state_write_allowed": { "const": false },
        "workflow_transition_allowed": { "const": false },
        "runtime_execution_performed": { "const": false },
        "delivery_execution_performed": { "const": false },
        "desktop_mutation_allowed": { "const": false },
        "desktop_source_of_truth": { "const": false },
        "protected_mutation_executed": { "const": false },
        "secret_material_exposed": { "const": false },
        "provider_key_visible": { "const": false }
      }
    },
    "contract": {
      "type": "object",
      "required": [
        "schema_version",
        "contract_id",
        "source_of_truth",
        "generation_rule",
        "issue_link_rule",
        "evidence_link_rule",
        "missing_data_rule",
        "client_output_rule",
        "attorney_review_rule",
        "desktop_companion_rule",
        "mutation_policy",
        "created_at"
      ],
      "properties": {
        "schema_version": { "const": "ldd-rfi-generator-contract.v1" },
        "contract_id": { "const": "ldd-rfi-generator.v1" },
        "source_of_truth": { "const": "ldd_issue_detection_vdr_missing_data_and_demo_matter_metadata" },
        "generation_rule": { "type": "string" },
        "issue_link_rule": { "type": "string" },
        "evidence_link_rule": { "type": "string" },
        "missing_data_rule": { "type": "string" },
        "client_output_rule": { "type": "string" },
        "attorney_review_rule": { "type": "string" },
        "desktop_companion_rule": { "type": "string" },
        "mutation_policy": { "type": "string" },
        "created_at": { "type": "string" }
      }
    },
    "rule": {
      "type": "object",
      "required": [
        "schema_version",
        "ldd_rfi_rule_id",
        "rfi_rule_type",
        "rule_status",
        "deterministic_only",
        "legal_conclusion_allowed",
        "client_facing_ready_allowed",
        "attorney_review_required",
        "human_review_required"
      ],
      "properties": {
        "schema_version": { "const": "ldd-rfi-rule.v1" },
        "ldd_rfi_rule_id": { "type": "string", "minLength": 1 },
        "rfi_rule_type": { "enum": ["missing_material_request", "issue_follow_up_question", "source_gap_request", "negotiation_position_question", "attorney_review_gate"] },
        "rule_status": { "const": "active" },
        "deterministic_only": { "const": true },
        "legal_conclusion_allowed": { "const": false },
        "client_facing_ready_allowed": { "const": false },
        "attorney_review_required": { "const": true },
        "human_review_required": { "const": true }
      }
    },
    "draft": {
      "type": "object",
      "required": [
        "schema_version",
        "ldd_rfi_draft_id",
        "matter_id",
        "rfi_draft_status",
        "question_count",
        "missing_material_link_count",
        "human_review_note",
        "draft_only",
        "client_facing_ready",
        "client_facing_output_generated",
        "attorney_review_required",
        "human_review_required",
        "legal_conclusion_asserted",
        "legal_advice_provided",
        "matter_data_write_allowed",
        "task_state_write_allowed",
        "workflow_transition_allowed",
        "runtime_execution_allowed",
        "delivery_execution_allowed",
        "protected_action_allowed"
      ],
      "properties": {
        "schema_version": { "const": "ldd-rfi-draft.v1" },
        "ldd_rfi_draft_id": { "type": "string", "minLength": 1 },
        "matter_id": { "type": "string", "minLength": 1 },
        "rfi_draft_status": { "const": "internal_attorney_review_required" },
        "question_count": { "type": "integer", "minimum": 1 },
        "missing_material_link_count": { "type": "integer", "minimum": 1 },
        "human_review_note": { "type": "string", "minLength": 1 },
        "draft_only": { "const": true },
        "client_facing_ready": { "const": false },
        "client_facing_output_generated": { "const": false },
        "attorney_review_required": { "const": true },
        "human_review_required": { "const": true },
        "legal_conclusion_asserted": { "const": false },
        "legal_advice_provided": { "const": false },
        "matter_data_write_allowed": { "const": false },
        "task_state_write_allowed": { "const": false },
        "workflow_transition_allowed": { "const": false },
        "runtime_execution_allowed": { "const": false },
        "delivery_execution_allowed": { "const": false },
        "protected_action_allowed": { "const": false }
      }
    },
    "question": {
      "type": "object",
      "required": [
        "schema_version",
        "ldd_rfi_question_id",
        "matter_id",
        "ldd_issue_record_id",
        "issue_type",
        "rfi_question_type",
        "rfi_question_priority",
        "question_text",
        "rfi_question_status",
        "missing_material_count",
        "evidence_ref_count",
        "draft_only",
        "deterministic_rfi_generation_performed",
        "legal_conclusion_asserted",
        "legal_advice_provided",
        "client_facing_ready",
        "client_facing_output_generated",
        "attorney_review_required",
        "human_review_required",
        "human_review_note",
        "matter_data_write_allowed",
        "task_state_write_allowed",
        "workflow_transition_allowed",
        "runtime_execution_allowed",
        "delivery_execution_allowed",
        "protected_action_allowed"
      ],
      "properties": {
        "schema_version": { "const": "ldd-rfi-question.v1" },
        "ldd_rfi_question_id": { "type": "string", "minLength": 1 },
        "matter_id": { "type": "string", "minLength": 1 },
        "ldd_issue_record_id": { "type": "string", "minLength": 1 },
        "issue_type": { "type": "string", "minLength": 1 },
        "rfi_question_type": { "enum": ["document_request", "clarification_request", "source_request"] },
        "rfi_question_priority": { "enum": ["high", "medium", "low"] },
        "question_text": { "type": "string", "minLength": 1 },
        "rfi_question_status": { "const": "draft_pending_attorney_review" },
        "missing_material_count": { "type": "integer", "minimum": 0 },
        "evidence_ref_count": { "type": "integer", "minimum": 1 },
        "draft_only": { "const": true },
        "deterministic_rfi_generation_performed": { "const": true },
        "legal_conclusion_asserted": { "const": false },
        "legal_advice_provided": { "const": false },
        "client_facing_ready": { "const": false },
        "client_facing_output_generated": { "const": false },
        "attorney_review_required": { "const": true },
        "human_review_required": { "const": true },
        "human_review_note": { "type": "string", "minLength": 1 },
        "matter_data_write_allowed": { "const": false },
        "task_state_write_allowed": { "const": false },
        "workflow_transition_allowed": { "const": false },
        "runtime_execution_allowed": { "const": false },
        "delivery_execution_allowed": { "const": false },
        "protected_action_allowed": { "const": false }
      }
    },
    "missing_material_link": {
      "type": "object",
      "required": [
        "schema_version",
        "ldd_rfi_missing_material_link_id",
        "matter_id",
        "ldd_rfi_question_id",
        "ldd_issue_record_id",
        "ldd_vdr_missing_data_record_id",
        "rfi_missing_material_status",
        "evidence_source_kind",
        "attorney_review_required",
        "human_review_required",
        "client_facing_ready"
      ],
      "properties": {
        "schema_version": { "const": "ldd-rfi-missing-material-link.v1" },
        "ldd_rfi_missing_material_link_id": { "type": "string", "minLength": 1 },
        "matter_id": { "type": "string", "minLength": 1 },
        "ldd_rfi_question_id": { "type": "string", "minLength": 1 },
        "ldd_issue_record_id": { "type": "string", "minLength": 1 },
        "ldd_vdr_missing_data_record_id": { "type": "string", "minLength": 1 },
        "rfi_missing_material_status": { "const": "linked_pending_attorney_review" },
        "evidence_source_kind": { "const": "ldd_vdr_missing_data_record" },
        "attorney_review_required": { "const": true },
        "human_review_required": { "const": true },
        "client_facing_ready": { "const": false }
      }
    },
    "issue_link": {
      "type": "object",
      "required": [
        "schema_version",
        "ldd_rfi_issue_link_id",
        "matter_id",
        "ldd_rfi_question_id",
        "ldd_issue_record_id",
        "rfi_issue_link_status",
        "evidence_ref_count",
        "attorney_review_required",
        "human_review_required",
        "client_facing_ready"
      ],
      "properties": {
        "schema_version": { "const": "ldd-rfi-issue-link.v1" },
        "ldd_rfi_issue_link_id": { "type": "string", "minLength": 1 },
        "matter_id": { "type": "string", "minLength": 1 },
        "ldd_rfi_question_id": { "type": "string", "minLength": 1 },
        "ldd_issue_record_id": { "type": "string", "minLength": 1 },
        "rfi_issue_link_status": { "const": "linked_pending_attorney_review" },
        "evidence_ref_count": { "type": "integer", "minimum": 1 },
        "attorney_review_required": { "const": true },
        "human_review_required": { "const": true },
        "client_facing_ready": { "const": false }
      }
    },
    "matter_summary": {
      "type": "object",
      "required": [
        "schema_version",
        "ldd_rfi_matter_summary_id",
        "matter_id",
        "ldd_rfi_matter_status",
        "rfi_draft_count",
        "rfi_question_count",
        "missing_material_link_count",
        "issue_link_count",
        "attorney_review_required",
        "human_review_required",
        "partner_approval_required",
        "client_facing_ready"
      ],
      "properties": {
        "schema_version": { "const": "ldd-rfi-matter-summary.v1" },
        "ldd_rfi_matter_summary_id": { "type": "string", "minLength": 1 },
        "matter_id": { "type": "string", "minLength": 1 },
        "ldd_rfi_matter_status": { "const": "draft_questions_pending_attorney_review" },
        "rfi_draft_count": { "type": "integer", "minimum": 1 },
        "rfi_question_count": { "type": "integer", "minimum": 1 },
        "missing_material_link_count": { "type": "integer", "minimum": 1 },
        "issue_link_count": { "type": "integer", "minimum": 1 },
        "attorney_review_required": { "const": true },
        "human_review_required": { "const": true },
        "partner_approval_required": { "const": true },
        "client_facing_ready": { "const": false }
      }
    },
    "desktop_boundary": {
      "type": "object",
      "required": [
        "schema_version",
        "boundary_status",
        "read_only",
        "desktop_mutation_allowed",
        "desktop_source_of_truth",
        "matter_data_write_allowed",
        "task_state_write_allowed",
        "workflow_transition_allowed",
        "runtime_execution_allowed",
        "delivery_execution_allowed",
        "protected_action_allowed",
        "client_facing_output_allowed_without_attorney_review"
      ],
      "properties": {
        "schema_version": { "const": "ldd-rfi-generator-desktop-boundary.v1" },
        "boundary_status": { "const": "enforced" },
        "read_only": { "const": true },
        "desktop_mutation_allowed": { "const": false },
        "desktop_source_of_truth": { "const": false },
        "matter_data_write_allowed": { "const": false },
        "task_state_write_allowed": { "const": false },
        "workflow_transition_allowed": { "const": false },
        "runtime_execution_allowed": { "const": false },
        "delivery_execution_allowed": { "const": false },
        "protected_action_allowed": { "const": false },
        "client_facing_output_allowed_without_attorney_review": { "const": false }
      }
    },
    "checkpoint": {
      "type": "object",
      "required": ["checkpoint_id", "status", "message"],
      "properties": {
        "checkpoint_id": { "type": "string", "minLength": 1 },
        "status": { "enum": ["passed", "failed"] },
        "message": { "type": "string" }
      }
    },
    "validation_item": {
      "type": "object",
      "required": ["path", "check_id", "status", "message"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "check_id": { "type": "string", "minLength": 1 },
        "status": { "enum": ["passed", "failed"] },
        "message": { "type": "string" }
      }
    },
    "validation": {
      "type": "object",
      "required": ["valid", "errors"],
      "properties": {
        "valid": { "type": "boolean" },
        "errors": { "type": "array" },
        "items": { "type": "array" }
      }
    },
    "summary": {
      "type": "object",
      "required": [
        "ldd_rfi_generator_status",
        "source_ldd_issue_detection_status",
        "source_ldd_issue_detection_phase_status",
        "source_ldd_vdr_inventory_status",
        "source_ldd_vdr_inventory_phase_status",
        "source_matter_status",
        "source_issue_record_count",
        "source_missing_data_record_count",
        "source_rfi_candidate_count",
        "rfi_rule_count",
        "rfi_draft_count",
        "rfi_question_count",
        "missing_material_link_count",
        "issue_link_count",
        "question_with_issue_link_count",
        "question_with_evidence_link_count",
        "draft_only_count",
        "human_review_note_count",
        "deterministic_rfi_generation_count",
        "client_facing_ready_count",
        "legal_conclusion_asserted_count",
        "legal_advice_provided",
        "client_facing_output_generated",
        "validation_error_count"
      ],
      "properties": {
        "ldd_rfi_generator_status": { "enum": ["complete", "blocked"] },
        "source_ldd_issue_detection_status": { "const": "complete" },
        "source_ldd_issue_detection_phase_status": { "const": "complete" },
        "source_ldd_vdr_inventory_status": { "const": "complete" },
        "source_ldd_vdr_inventory_phase_status": { "const": "complete" },
        "source_matter_status": { "const": "complete" },
        "source_issue_record_count": { "type": "integer", "minimum": 1 },
        "source_missing_data_record_count": { "type": "integer", "minimum": 1 },
        "source_rfi_candidate_count": { "type": "integer", "minimum": 1 },
        "rfi_rule_count": { "type": "integer", "minimum": 5 },
        "rfi_draft_count": { "type": "integer", "minimum": 1 },
        "rfi_question_count": { "type": "integer", "minimum": 1 },
        "missing_material_link_count": { "type": "integer", "minimum": 1 },
        "issue_link_count": { "type": "integer", "minimum": 1 },
        "question_with_issue_link_count": { "type": "integer", "minimum": 1 },
        "question_with_evidence_link_count": { "type": "integer", "minimum": 1 },
        "draft_only_count": { "type": "integer", "minimum": 1 },
        "human_review_note_count": { "type": "integer", "minimum": 1 },
        "deterministic_rfi_generation_count": { "type": "integer", "minimum": 1 },
        "client_facing_ready_count": { "const": 0 },
        "legal_conclusion_asserted_count": { "const": 0 },
        "legal_advice_provided": { "const": false },
        "client_facing_output_generated": { "const": false },
        "validation_error_count": { "const": 0 }
      }
    }
  }
}
