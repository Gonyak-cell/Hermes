{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hermes.local/schemas/work-os-goal-drilldown-surface.schema.json",
  "title": "Work OS Goal Drilldown Surface",
  "type": "object",
  "required": [
    "schema_version",
    "generated_at",
    "work_os_goal_drilldown_surface_id",
    "capability_id",
    "program_range",
    "source_program_range",
    "inputs",
    "source_work_os_goal_execution_view_summary",
    "work_os_goal_drilldown_contract",
    "work_os_goal_drilldown_phase_rows",
    "p9200_source_binding_rows",
