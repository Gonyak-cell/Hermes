{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hermes.local/schemas/creative-document-e2e-report.schema.json",
  "title": "Creative Document E2E Report",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "generated_at",
    "creative_document_e2e_report_id",
    "capability_id",
    "creative_document_e2e_report_contract",
    "source_statuses",
    "creative_document_e2e_scenario_rows",
    "creative_document_e2e_chain_stages",
    "creative_document_e2e_gate_results",
    "creative_document_e2e_report_boundary",
    "validation_items",
    "validation",
    "summary"
  ],
  "properties": {
    "schema_version": { "const": "creative-document-e2e-report.v1" },
    "creative_document_e2e_report_id": { "type": "string", "minLength": 1 },
    "capability_id": { "const": "creative_document.e2e.report" },
    "creative_document_e2e_report_contract": {
      "type": "object",
      "required": ["contract_id", "capability_id", "phase_slot", "previous_phase_slot", "next_phase_slot", "scenario", "execution_model"],
      "properties": {
        "contract_id": { "const": "creative-document-e2e-report.v1" },
        "capability_id": { "const": "creative_document.e2e.report" },
        "phase_slot": { "const": "P307" },
        "previous_phase_slot": { "const": "P306" },
        "next_phase_slot": { "const": "P308" },
        "scenario": { "const": "template_to_render_to_layout_to_approval_to_output_artifact" },
        "execution_model": { "const": "deterministic_read_only_report" }
      }
    },
    "source_statuses": {
      "type": "array",
      "minItems": 9,
      "items": {
        "type": "object",
        "required": ["source_id", "source_status", "validation_error_count"],
        "properties": {
          "source_status": { "const": "passed" },
          "validation_error_count": { "const": 0 }
        }
      }
    },
    "creative_document_e2e_scenario_rows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "creative_document_e2e_scenario_id",
          "phase_slot",
          "scenario_status",
          "template_gate_passed",
          "render_gate_passed",
          "layout_gate_passed",
          "approval_gate_passed",
          "output_artifact_gate_passed",
          "human_review_required",
          "approval_required_before_delivery",
          "template_mutation_performed",
          "renderer_execution_performed",
          "delivery_execution_performed",
          "protected_action_executed",
          "legal_advice_generated",
          "client_facing_output_generated",
          "client_facing_ready",
          "mutation_performed"
        ],
        "properties": {
          "phase_slot": { "const": "P307" },
          "scenario_status": { "const": "passed" },
          "template_gate_passed": { "const": true },
          "render_gate_passed": { "const": true },
          "layout_gate_passed": { "const": true },
          "approval_gate_passed": { "const": true },
          "output_artifact_gate_passed": { "const": true },
          "human_review_required": { "const": true },
          "approval_required_before_delivery": { "const": true },
          "template_mutation_performed": { "const": false },
          "renderer_execution_performed": { "const": false },
          "delivery_execution_performed": { "const": false },
          "protected_action_executed": { "const": false },
          "legal_advice_generated": { "const": false },
          "client_facing_output_generated": { "const": false },
          "client_facing_ready": { "const": false },
          "mutation_performed": { "const": false }
        }
      }
    },
    "creative_document_e2e_chain_stages": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "required": ["chain_stage", "stage_status", "read_only", "mutation_performed", "human_review_required"],
        "properties": {
          "chain_stage": { "enum": ["template", "render", "layout", "approval", "output_artifact"] },
          "stage_status": { "const": "passed" },
          "read_only": { "const": true },
          "mutation_performed": { "const": false },
          "human_review_required": { "const": true }
        }
      }
    },
    "creative_document_e2e_gate_results": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "required": ["gate_status", "gate_violation"],
        "properties": {
          "gate_status": { "const": "passed" },
          "gate_violation": { "const": false }
        }
      }
    },
    "creative_document_e2e_report_boundary": {
      "type": "object",
      "required": [
        "boundary_status",
        "phase_slot",
        "read_only",
        "report_only",
        "template_mutation_performed",
        "renderer_execution_performed",
        "delivery_execution_performed",
        "protected_action_executed",
        "legal_advice_generated",
        "client_facing_output_generated",
        "human_review_required",
        "windows_baseline_stability_preserved"
      ],
      "properties": {
        "boundary_status": { "const": "enforced" },
        "phase_slot": { "const": "P307" },
        "read_only": { "const": true },
        "report_only": { "const": true },
        "template_mutation_performed": { "const": false },
        "renderer_execution_performed": { "const": false },
        "delivery_execution_performed": { "const": false },
        "protected_action_executed": { "const": false },
        "legal_advice_generated": { "const": false },
        "client_facing_output_generated": { "const": false },
        "human_review_required": { "const": true },
        "windows_baseline_stability_preserved": { "const": true }
      }
    },
    "summary": {
      "type": "object",
      "required": [
        "creative_document_e2e_report_status",
        "phase_slot",
        "previous_phase_slot",
        "next_phase_slot",
        "failed_source_status_count",
        "scenario_row_count",
        "passed_scenario_row_count",
        "failed_scenario_row_count",
        "chain_stage_count",
        "passed_chain_stage_count",
        "failed_chain_stage_count",
        "template_to_output_artifact_path_complete",
        "gate_violation_count",
        "delivery_execution_performed",
        "legal_advice_generated",
        "client_facing_output_generated",
        "human_review_required",
        "windows_baseline_stability_preserved",
        "validation_error_count"
      ],
      "properties": {
        "creative_document_e2e_report_status": { "const": "complete" },
        "phase_slot": { "const": "P307" },
        "previous_phase_slot": { "const": "P306" },
        "next_phase_slot": { "const": "P308" },
        "failed_source_status_count": { "const": 0 },
        "failed_scenario_row_count": { "const": 0 },
        "failed_chain_stage_count": { "const": 0 },
        "template_to_output_artifact_path_complete": { "const": true },
        "gate_violation_count": { "const": 0 },
        "delivery_execution_performed": { "const": false },
        "legal_advice_generated": { "const": false },
        "client_facing_output_generated": { "const": false },
        "human_review_required": { "const": true },
        "windows_baseline_stability_preserved": { "const": true },
        "validation_error_count": { "const": 0 }
      }
    }
  }
}
