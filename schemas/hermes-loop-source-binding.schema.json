{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hermes.local/schemas/hermes-loop-source-binding.schema.json",
  "title": "Hermes Loop System v1.1 Source Binding",
  "type": "object",
  "required": [
    "schema_version",
    "generated_at",
    "capability_id",
    "program_range",
    "next_program_range",
    "source_refs",
    "hermes_loop_source_binding_contract",
    "p60001_source_binding_rows",
    "loop_overlay_contract_inventory_rows",
    "authority_boundary_baseline_rows",
    "negative_fixture_contract_rows",
    "validation_command_rows",
    "hermes_loop_source_binding_wiring_rows",
    "p60400_closeout_rows",
    "p60401_next_phase_handoff_rows",
    "hermes_loop_source_binding_boundary",
    "hermes_loop_source_binding_validation_items",
    "summary",
    "validation"
  ],
  "properties": {
    "schema_version": { "const": "hermes-loop-source-binding.v1" },
    "generated_at": { "type": "string" },
    "capability_id": { "const": "platform.hermes_loop_system_v1_1_source_binding" },
    "program_range": { "const": "P60001-P60400" },
    "next_program_range": { "const": "P60401-P60800" },
    "source_refs": {
      "type": "object",
      "required": [
        "hermes_loop_system_specification_path",
        "source_hash_sha256",
        "source_of_truth"
      ],
      "properties": {
        "hermes_loop_system_specification_path": { "type": "string" },
        "source_hash_sha256": { "type": "string" },
        "source_commit_ref": { "type": ["string", "null"] },
        "source_of_truth": { "const": "docs/hermes-loop-system-specification.md" }
      },
      "additionalProperties": true
    },
    "p60001_source_binding_rows": { "type": "array", "minItems": 19, "items": { "$ref": "#/$defs/verdictRow" } },
    "loop_overlay_contract_inventory_rows": { "type": "array", "minItems": 12, "items": { "$ref": "#/$defs/verdictRow" } },
    "authority_boundary_baseline_rows": { "type": "array", "minItems": 21, "items": { "$ref": "#/$defs/verdictRow" } },
    "negative_fixture_contract_rows": { "type": "array", "minItems": 19, "items": { "$ref": "#/$defs/verdictRow" } },
    "validation_command_rows": { "type": "array", "minItems": 6, "items": { "$ref": "#/$defs/verdictRow" } },
    "hermes_loop_source_binding_wiring_rows": { "type": "array", "minItems": 3, "items": { "$ref": "#/$defs/verdictRow" } },
    "p60400_closeout_rows": { "type": "array", "minItems": 9, "items": { "$ref": "#/$defs/verdictRow" } },
    "p60401_next_phase_handoff_rows": { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/verdictRow" } },
    "hermes_loop_source_binding_boundary": {
      "type": "object",
      "required": [
        "p60400_contract_ready",
        "source_doc_available_now",
        "source_doc_hash_present_now",
        "source_of_truth_bound_now",
        "phase_a_source_bound_now",
        "overlay_contract_inventory_visible_now",
        "authority_boundary_closed_now",
        "negative_fixture_contract_visible_now",
        "validation_commands_declared_now",
        "wiring_complete_now",
        "ready_for_p60401_handoff",
        "runtime_execution_allowed_now",
        "command_execution_allowed_now",
        "write_action_allowed_now",
        "direct_file_write_allowed_now",
        "generated_patch_apply_allowed_now",
        "connector_ingestion_allowed_now",
        "connector_write_allowed_now",
        "external_service_mutation_allowed_now",
        "raw_material_access_allowed_now",
        "cross_domain_access_allowed_now",
        "secret_read_allowed_now",
        "protected_action_allowed_now",
        "protected_closeout_allowed_now",
        "deployment_allowed_now",
        "release_approval_allowed_now",
        "production_pass_allowed_now",
        "enterprise_pass_allowed_now",
        "enterprise_trust_claim_allowed_now",
        "codex_final_approval_allowed",
        "claude_final_approval_allowed",
        "final_automated_approval_allowed_now",
        "production_pass_enabled",
        "enterprise_pass_enabled",
        "final_approval_enabled"
      ],
      "properties": {
        "p60400_contract_ready": { "type": "boolean" },
        "source_doc_available_now": { "type": "boolean" },
        "source_doc_hash_present_now": { "type": "boolean" },
        "source_of_truth_bound_now": { "type": "boolean" },
        "phase_a_source_bound_now": { "type": "boolean" },
        "overlay_contract_inventory_visible_now": { "type": "boolean" },
        "authority_boundary_closed_now": { "type": "boolean" },
        "negative_fixture_contract_visible_now": { "type": "boolean" },
        "validation_commands_declared_now": { "type": "boolean" },
        "wiring_complete_now": { "type": "boolean" },
        "ready_for_p60401_handoff": { "type": "boolean" },
        "runtime_execution_allowed_now": { "const": false },
        "command_execution_allowed_now": { "const": false },
        "write_action_allowed_now": { "const": false },
        "direct_file_write_allowed_now": { "const": false },
        "generated_patch_apply_allowed_now": { "const": false },
        "connector_ingestion_allowed_now": { "const": false },
        "connector_write_allowed_now": { "const": false },
        "external_service_mutation_allowed_now": { "const": false },
        "raw_material_access_allowed_now": { "const": false },
        "cross_domain_access_allowed_now": { "const": false },
        "secret_read_allowed_now": { "const": false },
        "protected_action_allowed_now": { "const": false },
        "protected_closeout_allowed_now": { "const": false },
        "deployment_allowed_now": { "const": false },
        "release_approval_allowed_now": { "const": false },
        "production_pass_allowed_now": { "const": false },
        "enterprise_pass_allowed_now": { "const": false },
        "enterprise_trust_claim_allowed_now": { "const": false },
        "codex_final_approval_allowed": { "const": false },
        "claude_final_approval_allowed": { "const": false },
        "final_automated_approval_allowed_now": { "const": false },
        "production_pass_enabled": { "const": false },
        "enterprise_pass_enabled": { "const": false },
        "final_approval_enabled": { "const": false }
      },
      "additionalProperties": true
    },
    "summary": {
      "type": "object",
      "required": [
        "hermes_loop_source_binding_status",
        "program_range",
        "next_program_range",
        "source_of_truth_bound_now",
        "p60400_contract_ready",
        "ready_for_p60401_handoff",
        "authority_boundary_closed_now",
        "production_pass_enabled",
        "enterprise_pass_enabled",
        "final_approval_enabled"
      ],
      "properties": {
        "hermes_loop_source_binding_status": {
          "enum": [
            "ready_for_p60401_handoff",
            "valid_block_p60401_handoff_pending",
            "blocked_hermes_loop_source_binding"
          ]
        },
        "program_range": { "const": "P60001-P60400" },
        "next_program_range": { "const": "P60401-P60800" },
        "source_of_truth_bound_now": { "type": "boolean" },
        "p60400_contract_ready": { "type": "boolean" },
        "ready_for_p60401_handoff": { "type": "boolean" },
        "authority_boundary_closed_now": { "type": "boolean" },
        "negative_fixture_contract_visible_now": { "type": "boolean" },
        "production_pass_enabled": { "const": false },
        "enterprise_pass_enabled": { "const": false },
        "final_approval_enabled": { "const": false },
        "validation_error_count": { "type": "number" }
      },
      "additionalProperties": true
    },
    "validation": {
      "type": "object",
      "required": ["valid", "error_count", "errors"],
      "properties": {
        "valid": { "type": "boolean" },
        "error_count": { "type": "number" },
        "errors": { "type": "array" }
      },
      "additionalProperties": true
    }
  },
  "$defs": {
    "verdictRow": {
      "type": "object",
      "required": [
        "row_id",
        "category",
        "label",
        "observed",
        "current_verdict",
        "evidence_ref",
        "block_reason",
        "next_allowed_action",
        "generated_at"
      ],
      "properties": {
        "row_id": { "type": "string" },
        "category": { "type": "string" },
        "label": { "type": "string" },
        "observed": { "type": "boolean" },
        "current_verdict": { "enum": ["pass", "block"] },
        "evidence_ref": { "type": ["string", "null"] },
        "output_ref": { "type": ["string", "null"] },
        "block_reason": { "type": ["string", "null"] },
        "next_allowed_action": { "type": "string" },
        "generated_at": { "type": "string" }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
