{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/ldd-fact-extraction.schema.json",
  "title": "Hermes LDD Fact Extraction",
  "type": "object",
  "required": [
    "schema_version",
    "generated_at",
    "ldd_fact_extraction_id",
    "ldd_fact_extraction_status",
    "safe_handling",
    "inputs",
    "source_contracts",
    "ldd_fact_extraction_contract",
    "ldd_fact_extraction_rules",
    "ldd_fact_records",
    "ldd_fact_source_bindings",
    "ldd_fact_type_summaries",
    "ldd_fact_matter_summaries",
    "ldd_fact_extraction_desktop_boundary",
    "ldd_fact_extraction_checkpoints",
    "validation_items",
    "validation",
    "summary"
  ],
  "properties": {
    "schema_version": { "const": "ldd-fact-extraction.v1" },
    "generated_at": { "type": "string", "minLength": 1 },
    "ldd_fact_extraction_id": { "type": "string", "minLength": 1 },
    "output_dir": { "type": "string" },
    "ldd_fact_extraction_status": { "enum": ["complete", "blocked"] },
    "safe_handling": { "$ref": "#/$defs/safe_handling" },
    "inputs": { "type": "object" },
    "source_contracts": { "type": "object" },
    "ldd_fact_extraction_contract": { "$ref": "#/$defs/contract" },
    "ldd_fact_extraction_rules": { "type": "array", "minItems": 5, "items": { "$ref": "#/$defs/rule" } },
    "ldd_fact_records": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/fact_record" } },
    "ldd_fact_source_bindings": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/source_binding" } },
    "ldd_fact_type_summaries": { "type": "array", "minItems": 5, "items": { "$ref": "#/$defs/type_summary" } },
    "ldd_fact_matter_summaries": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/matter_summary" } },
    "ldd_fact_extraction_desktop_boundary": { "$ref": "#/$defs/desktop_boundary" },
    "ldd_fact_extraction_checkpoints": { "type": "array", "items": { "$ref": "#/$defs/checkpoint" } },
    "validation_items": { "type": "array", "items": { "$ref": "#/$defs/validation_item" } },
    "validation": { "$ref": "#/$defs/validation" },
    "summary": { "$ref": "#/$defs/summary" }
  },
  "$defs": {
    "safe_handling": {
      "type": "object",
      "required": [
        "report_only",
        "deterministic_fact_extraction_performed",
        "external_extractor_execution_performed",
        "legal_advice_provided",
        "client_facing_output_generated",
        "attorney_review_required",
        "human_review_required",
        "legal_conclusion_asserted",
        "matter_data_write_allowed",
        "task_state_write_allowed",
        "workflow_transition_allowed",
        "runtime_execution_performed",
        "delivery_execution_performed",
        "desktop_mutation_allowed",
        "desktop_source_of_truth",
        "protected_mutation_executed",
        "secret_material_exposed",
        "provider_key_visible"
      ],
      "properties": {
        "report_only": { "const": true },
        "deterministic_fact_extraction_performed": { "const": true },
        "external_extractor_execution_performed": { "const": false },
        "legal_advice_provided": { "const": false },
        "client_facing_output_generated": { "const": false },
        "attorney_review_required": { "const": true },
        "human_review_required": { "const": true },
        "legal_conclusion_asserted": { "const": false },
        "matter_data_write_allowed": { "const": false },
        "task_state_write_allowed": { "const": false },
        "workflow_transition_allowed": { "const": false },
        "runtime_execution_performed": { "const": false },
        "delivery_execution_performed": { "const": false },
        "desktop_mutation_allowed": { "const": false },
        "desktop_source_of_truth": { "const": false },
        "protected_mutation_executed": { "const": false },
        "secret_material_exposed": { "const": false },
        "provider_key_visible": { "const": false }
      }
    },
    "contract": {
      "type": "object",
      "required": [
        "schema_version",
        "contract_id",
        "source_of_truth",
        "extraction_rule",
        "no_legal_conclusion_rule",
        "missing_data_rule",
        "external_extractor_rule",
        "attorney_review_rule",
        "desktop_companion_rule",
        "mutation_policy",
        "created_at"
      ],
      "properties": {
        "schema_version": { "const": "ldd-fact-extraction-contract.v1" },
        "contract_id": { "const": "ldd-fact-extraction.v1" },
        "source_of_truth": { "const": "ldd_extractor_selection_and_demo_matter_metadata" },
        "extraction_rule": { "type": "string" },
        "no_legal_conclusion_rule": { "type": "string" },
        "missing_data_rule": { "type": "string" },
        "external_extractor_rule": { "type": "string" },
        "attorney_review_rule": { "type": "string" },
        "desktop_companion_rule": { "type": "string" },
        "mutation_policy": { "type": "string" },
        "created_at": { "type": "string" }
      }
    },
    "rule": {
      "type": "object",
      "required": [
        "schema_version",
        "ldd_fact_extraction_rule_id",
        "fact_type",
        "rule_status",
        "deterministic_only",
        "external_extractor_execution_performed",
        "legal_conclusion_allowed",
        "attorney_review_required",
        "human_review_required"
      ],
      "properties": {
        "schema_version": { "const": "ldd-fact-extraction-rule.v1" },
        "ldd_fact_extraction_rule_id": { "type": "string", "minLength": 1 },
        "fact_type": { "$ref": "#/$defs/fact_type" },
        "fact_label": { "type": "string" },
        "rule_status": { "const": "active" },
        "deterministic_only": { "const": true },
        "external_extractor_execution_performed": { "const": false },
        "legal_conclusion_allowed": { "const": false },
        "attorney_review_required": { "const": true },
        "human_review_required": { "const": true }
      }
    },
    "fact_record": {
      "type": "object",
      "required": [
        "schema_version",
        "ldd_fact_record_id",
        "matter_id",
        "ldd_extractor_selection_record_id",
        "source_document_id",
        "document_title",
        "primary_document_class",
        "selected_extractor_id",
        "fact_type",
        "fact_name",
        "fact_value",
        "fact_status",
        "fact_confidence",
        "source_gap",
        "deterministic_fact_extraction_performed",
        "external_extractor_execution_performed",
        "legal_conclusion_asserted",
        "attorney_review_required",
        "human_review_required",
        "client_facing_ready",
        "legal_advice_provided",
        "client_facing_output_generated",
        "matter_data_write_allowed",
        "task_state_write_allowed",
        "workflow_transition_allowed",
        "runtime_execution_allowed",
        "delivery_execution_allowed",
        "protected_action_allowed"
      ],
      "properties": {
        "schema_version": { "const": "ldd-fact-record.v1" },
        "ldd_fact_record_id": { "type": "string", "minLength": 1 },
        "matter_id": { "type": "string", "minLength": 1 },
        "ldd_extractor_selection_record_id": { "type": "string", "minLength": 1 },
        "source_document_id": { "type": "string", "minLength": 1 },
        "source_row_kind": { "enum": ["vdr_file", "missing_data"] },
        "source_record_id": { "type": "string" },
        "document_title": { "type": "string", "minLength": 1 },
        "primary_document_class": { "type": "string", "minLength": 1 },
        "selected_extractor_id": { "type": "string", "minLength": 1 },
        "fact_type": { "$ref": "#/$defs/fact_type" },
        "fact_name": { "type": "string", "minLength": 1 },
        "fact_value": { "type": "string", "minLength": 1 },
        "fact_status": { "enum": ["candidate_extracted_pending_attorney_review", "source_gap_review_required"] },
        "fact_confidence": { "enum": ["metadata_exact", "metadata_inferred", "source_gap"] },
        "source_gap": { "type": "boolean" },
        "deterministic_fact_extraction_performed": { "const": true },
        "external_extractor_execution_performed": { "const": false },
        "legal_conclusion_asserted": { "const": false },
        "attorney_review_required": { "const": true },
        "human_review_required": { "const": true },
        "client_facing_ready": { "const": false },
        "legal_advice_provided": { "const": false },
        "client_facing_output_generated": { "const": false },
        "matter_data_write_allowed": { "const": false },
        "task_state_write_allowed": { "const": false },
        "workflow_transition_allowed": { "const": false },
        "runtime_execution_allowed": { "const": false },
        "delivery_execution_allowed": { "const": false },
        "protected_action_allowed": { "const": false }
      }
    },
    "source_binding": {
      "type": "object",
      "required": [
        "schema_version",
        "ldd_fact_source_binding_id",
        "matter_id",
        "ldd_fact_record_id",
        "ldd_extractor_selection_record_id",
        "binding_status",
        "source_gap",
        "deterministic_fact_extraction_performed",
        "external_extractor_execution_performed",
        "attorney_review_required",
        "human_review_required",
        "client_facing_ready"
      ],
      "properties": {
        "schema_version": { "const": "ldd-fact-source-binding.v1" },
        "ldd_fact_source_binding_id": { "type": "string", "minLength": 1 },
        "matter_id": { "type": "string", "minLength": 1 },
        "ldd_fact_record_id": { "type": "string", "minLength": 1 },
        "ldd_extractor_selection_record_id": { "type": "string", "minLength": 1 },
        "binding_status": { "enum": ["bound_to_source_metadata", "source_gap_recorded"] },
        "source_gap": { "type": "boolean" },
        "deterministic_fact_extraction_performed": { "const": true },
        "external_extractor_execution_performed": { "const": false },
        "attorney_review_required": { "const": true },
        "human_review_required": { "const": true },
        "client_facing_ready": { "const": false }
      }
    },
    "type_summary": {
      "type": "object",
      "required": [
        "schema_version",
        "ldd_fact_type_summary_id",
        "fact_type",
        "fact_record_count",
        "candidate_fact_count",
        "source_gap_fact_count",
        "attorney_review_required_count",
        "human_review_required_count",
        "client_facing_ready_count"
      ],
      "properties": {
        "schema_version": { "const": "ldd-fact-type-summary.v1" },
        "ldd_fact_type_summary_id": { "type": "string", "minLength": 1 },
        "fact_type": { "$ref": "#/$defs/fact_type" },
        "fact_record_count": { "type": "integer", "minimum": 0 },
        "candidate_fact_count": { "type": "integer", "minimum": 0 },
        "source_gap_fact_count": { "type": "integer", "minimum": 0 },
        "attorney_review_required_count": { "type": "integer", "minimum": 0 },
        "human_review_required_count": { "type": "integer", "minimum": 0 },
        "client_facing_ready_count": { "const": 0 }
      }
    },
    "matter_summary": {
      "type": "object",
      "required": [
        "schema_version",
        "ldd_fact_matter_summary_id",
        "matter_id",
        "ldd_fact_matter_status",
        "fact_record_count",
        "candidate_fact_count",
        "source_gap_fact_count",
        "deterministic_fact_extraction_count",
        "external_extractor_execution_count",
        "attorney_review_required",
        "human_review_required",
        "client_facing_ready"
      ],
      "properties": {
        "schema_version": { "const": "ldd-fact-matter-summary.v1" },
        "ldd_fact_matter_summary_id": { "type": "string", "minLength": 1 },
        "matter_id": { "type": "string", "minLength": 1 },
        "ldd_fact_matter_status": { "const": "complete_pending_attorney_review" },
        "fact_record_count": { "type": "integer", "minimum": 1 },
        "candidate_fact_count": { "type": "integer", "minimum": 0 },
        "source_gap_fact_count": { "type": "integer", "minimum": 0 },
        "deterministic_fact_extraction_count": { "type": "integer", "minimum": 1 },
        "external_extractor_execution_count": { "const": 0 },
        "attorney_review_required": { "const": true },
        "human_review_required": { "const": true },
        "client_facing_ready": { "const": false }
      }
    },
    "desktop_boundary": {
      "type": "object",
      "required": [
        "schema_version",
        "boundary_status",
        "read_only",
        "desktop_mutation_allowed",
        "desktop_source_of_truth",
        "matter_data_write_allowed",
        "task_state_write_allowed",
        "workflow_transition_allowed",
        "runtime_execution_allowed",
        "delivery_execution_allowed",
        "protected_action_allowed",
        "client_facing_output_allowed_without_attorney_review"
      ],
      "properties": {
        "schema_version": { "const": "ldd-fact-extraction-desktop-boundary.v1" },
        "boundary_status": { "const": "enforced" },
        "read_only": { "const": true },
        "desktop_mutation_allowed": { "const": false },
        "desktop_source_of_truth": { "const": false },
        "matter_data_write_allowed": { "const": false },
        "task_state_write_allowed": { "const": false },
        "workflow_transition_allowed": { "const": false },
        "runtime_execution_allowed": { "const": false },
        "delivery_execution_allowed": { "const": false },
        "protected_action_allowed": { "const": false },
        "client_facing_output_allowed_without_attorney_review": { "const": false }
      }
    },
    "checkpoint": {
      "type": "object",
      "required": ["checkpoint_id", "status", "message"],
      "properties": {
        "checkpoint_id": { "type": "string", "minLength": 1 },
        "status": { "enum": ["passed", "failed"] },
        "message": { "type": "string" }
      }
    },
    "validation_item": {
      "type": "object",
      "required": ["path", "check_id", "status", "message"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "check_id": { "type": "string", "minLength": 1 },
        "status": { "enum": ["passed", "failed"] },
        "message": { "type": "string" }
      }
    },
    "validation": {
      "type": "object",
      "required": ["valid", "errors"],
      "properties": {
        "valid": { "type": "boolean" },
        "errors": { "type": "array" },
        "items": { "type": "array" }
      }
    },
    "summary": {
      "type": "object",
      "required": [
        "ldd_fact_extraction_status",
        "source_ldd_extractor_selection_status",
        "source_ldd_extractor_selection_phase_status",
        "source_matter_status",
        "source_selection_record_count",
        "fact_rule_count",
        "fact_record_count",
        "candidate_fact_count",
        "source_gap_fact_count",
        "source_binding_count",
        "matter_count",
        "party_fact_count",
        "date_fact_count",
        "obligation_fact_count",
        "termination_fact_count",
        "change_of_control_fact_count",
        "deterministic_fact_extraction_count",
        "external_extractor_execution_count",
        "client_facing_ready_count",
        "legal_advice_provided",
        "client_facing_output_generated",
        "validation_error_count"
      ],
      "properties": {
        "ldd_fact_extraction_status": { "enum": ["complete", "blocked"] },
        "source_ldd_extractor_selection_status": { "const": "complete" },
        "source_ldd_extractor_selection_phase_status": { "const": "complete" },
        "source_matter_status": { "const": "complete" },
        "source_selection_record_count": { "type": "integer", "minimum": 1 },
        "fact_rule_count": { "type": "integer", "minimum": 5 },
        "fact_record_count": { "type": "integer", "minimum": 1 },
        "candidate_fact_count": { "type": "integer", "minimum": 1 },
        "source_gap_fact_count": { "type": "integer", "minimum": 1 },
        "source_binding_count": { "type": "integer", "minimum": 1 },
        "matter_count": { "type": "integer", "minimum": 1 },
        "party_fact_count": { "type": "integer", "minimum": 1 },
        "date_fact_count": { "type": "integer", "minimum": 1 },
        "obligation_fact_count": { "type": "integer", "minimum": 1 },
        "termination_fact_count": { "type": "integer", "minimum": 1 },
        "change_of_control_fact_count": { "type": "integer", "minimum": 1 },
        "deterministic_fact_extraction_count": { "type": "integer", "minimum": 1 },
        "external_extractor_execution_count": { "const": 0 },
        "client_facing_ready_count": { "const": 0 },
        "legal_advice_provided": { "const": false },
        "client_facing_output_generated": { "const": false },
        "validation_error_count": { "const": 0 }
      }
    },
    "fact_type": {
      "enum": ["party", "date", "obligation", "termination", "change_of_control"]
    }
  }
}
