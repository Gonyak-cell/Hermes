{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://amic.local/hermes/human-review-cycle-work-order-target-audit.schema.json",
  "title": "Hermes Human Review Cycle Work Order Target Audit",
  "type": "object",
  "required": [
    "schema_version",
    "generated_at",
    "target_audit_id",
    "output_dir",
    "target_audit_status",
    "safe_handling",
    "sources",
    "summary",
    "actor_target_audits",
    "target_audit_items",
    "validation"
  ],
  "properties": {
    "schema_version": { "const": "human-review-cycle-work-order-target-audit.v1" },
    "generated_at": { "type": "string", "format": "date-time" },
    "target_audit_id": { "type": "string" },
    "output_dir": { "type": "string" },
    "target_audit_status": { "$ref": "#/$defs/top_status" },
    "safe_handling": { "$ref": "#/$defs/top_safe_handling" },
    "sources": {
      "type": "array",
      "items": { "$ref": "#/$defs/source" }
    },
    "summary": {
      "type": "object",
      "required": [
        "target_audit_status",
        "source_available",
        "source_work_order_status",
        "source_work_order_item_count",
        "source_actor_work_order_count",
        "actor_target_audit_count",
        "target_audit_item_count",
        "ready_target_count",
        "attention_count",
        "blocked_count",
        "target_file_count",
        "missing_target_file_count",
        "missing_decision_file_count",
        "missing_receipt_row_count",
        "missing_required_field_count",
        "mismatch_count",
        "validation_error_count",
        "by_required_actor",
        "by_gate_type",
        "by_target_audit_status"
      ],
      "properties": {
        "target_audit_status": { "$ref": "#/$defs/top_status" },
        "source_available": { "type": "boolean" },
        "source_work_order_status": { "type": ["string", "null"] },
        "source_work_order_item_count": { "type": "integer", "minimum": 0 },
        "source_actor_work_order_count": { "type": "integer", "minimum": 0 },
        "actor_target_audit_count": { "type": "integer", "minimum": 0 },
        "target_audit_item_count": { "type": "integer", "minimum": 0 },
        "ready_target_count": { "type": "integer", "minimum": 0 },
        "attention_count": { "type": "integer", "minimum": 0 },
        "blocked_count": { "type": "integer", "minimum": 0 },
        "target_file_count": { "type": "integer", "minimum": 0 },
        "missing_target_file_count": { "type": "integer", "minimum": 0 },
        "missing_decision_file_count": { "type": "integer", "minimum": 0 },
        "missing_receipt_row_count": { "type": "integer", "minimum": 0 },
        "missing_required_field_count": { "type": "integer", "minimum": 0 },
        "mismatch_count": { "type": "integer", "minimum": 0 },
        "validation_error_count": { "type": "integer", "minimum": 0 },
        "by_required_actor": { "type": "object" },
        "by_gate_type": { "type": "object" },
        "by_target_audit_status": { "type": "object" }
      }
    },
    "actor_target_audits": {
      "type": "array",
      "items": { "$ref": "#/$defs/actor_target_audit" }
    },
    "target_audit_items": {
      "type": "array",
      "items": { "$ref": "#/$defs/target_audit_item" }
    },
    "validation": { "$ref": "#/$defs/validation" }
  },
  "$defs": {
    "top_status": {
      "enum": ["clear", "ready_for_human_review", "attention", "blocked"]
    },
    "actor_status": {
      "enum": ["clear", "ready_for_human_review", "attention", "blocked"]
    },
    "source": {
      "type": "object",
      "required": ["source_id", "label", "path", "available", "schema_version", "generated_at", "summary", "error"],
      "properties": {
        "source_id": { "type": "string" },
        "label": { "type": "string" },
        "path": { "type": "string" },
        "available": { "type": "boolean" },
        "schema_version": { "type": ["string", "null"] },
        "generated_at": { "type": ["string", "null"], "format": "date-time" },
        "summary": { "type": ["object", "null"] },
        "error": { "type": ["string", "null"] }
      }
    },
    "actor_target_audit": {
      "type": "object",
      "required": [
        "actor_target_audit_id",
        "work_order_id",
        "required_actor",
        "target_audit_status",
        "priority",
        "target_audit_item_count",
        "ready_target_count",
        "attention_count",
        "blocked_count",
        "target_file_count",
        "target_audit_item_ids",
        "target_audit_json_path",
        "target_audit_markdown_path",
        "safe_handling"
      ],
      "properties": {
        "actor_target_audit_id": { "type": "string" },
        "work_order_id": { "type": ["string", "null"] },
        "required_actor": { "type": "string" },
        "target_audit_status": { "$ref": "#/$defs/actor_status" },
        "priority": { "enum": ["critical", "high", "medium", "low"] },
        "target_audit_item_count": { "type": "integer", "minimum": 0 },
        "ready_target_count": { "type": "integer", "minimum": 0 },
        "attention_count": { "type": "integer", "minimum": 0 },
        "blocked_count": { "type": "integer", "minimum": 0 },
        "target_file_count": { "type": "integer", "minimum": 0 },
        "target_audit_item_ids": { "type": "array", "items": { "type": "string" } },
        "target_audit_json_path": { "type": "string" },
        "target_audit_markdown_path": { "type": "string" },
        "safe_handling": { "$ref": "#/$defs/top_safe_handling" }
      }
    },
    "target_audit_item": {
      "type": "object",
      "required": [
        "target_audit_item_id",
        "work_order_item_id",
        "work_order_id",
        "cycle_item_id",
        "gate_item_id",
        "receipt_id",
        "required_actor",
        "gate_type",
        "priority",
        "work_order_status",
        "target_audit_status",
        "target_receipt_input_path",
        "target_decision_json_path",
        "target_file_available",
        "target_file_error",
        "target_decision_file_available",
        "target_decision_file_error",
        "receipt_row_present",
        "receipt_row_status",
        "receipt_row_outcome",
        "required_receipt_fields",
        "missing_required_fields",
        "mismatch_fields",
        "next_actions",
        "safe_handling"
      ],
      "properties": {
        "target_audit_item_id": { "type": "string" },
        "work_order_item_id": { "type": "string" },
        "work_order_id": { "type": "string" },
        "cycle_item_id": { "type": "string" },
        "gate_item_id": { "type": "string" },
        "receipt_id": { "type": ["string", "null"] },
        "required_actor": { "type": "string" },
        "gate_type": { "type": "string" },
        "priority": { "enum": ["critical", "high", "medium", "low"] },
        "work_order_status": { "type": "string" },
        "target_audit_status": { "$ref": "#/$defs/actor_status" },
        "target_receipt_input_path": { "type": ["string", "null"] },
        "target_decision_json_path": { "type": ["string", "null"] },
        "target_file_available": { "type": "boolean" },
        "target_file_error": { "type": ["string", "null"] },
        "target_decision_file_available": { "type": "boolean" },
        "target_decision_file_error": { "type": ["string", "null"] },
        "receipt_row_present": { "type": "boolean" },
        "receipt_row_status": { "type": ["string", "null"] },
        "receipt_row_outcome": { "type": ["string", "null"] },
        "required_receipt_fields": { "type": "array", "items": { "type": "string" } },
        "missing_required_fields": { "type": "array", "items": { "type": "string" } },
        "mismatch_fields": { "type": "array", "items": { "type": "string" } },
        "next_actions": { "type": "array", "items": { "type": "string" } },
        "safe_handling": {
          "type": "object",
          "required": ["auto_execute_allowed", "protected_actions_executed", "audit_only"],
          "properties": {
            "auto_execute_allowed": { "const": false },
            "protected_actions_executed": { "const": false },
            "audit_only": { "type": "boolean" }
          }
        }
      }
    },
    "top_safe_handling": {
      "type": "object",
      "required": ["auto_execute_allowed", "draft_only", "audit_only", "protected_actions_executed"],
      "properties": {
        "auto_execute_allowed": { "const": false },
        "draft_only": { "type": "boolean" },
        "audit_only": { "type": "boolean" },
        "protected_actions_executed": { "const": false }
      }
    },
    "validation": {
      "type": "object",
      "required": ["valid", "errors"],
      "properties": {
        "valid": { "type": "boolean" },
        "errors": { "type": "array", "items": { "$ref": "#/$defs/validation_error" } }
      }
    },
    "validation_error": {
      "type": "object",
      "required": ["path", "message"],
      "properties": {
        "path": { "type": "string" },
        "message": { "type": "string" }
      }
    }
  }
}
