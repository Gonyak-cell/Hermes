{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hermes.local/schemas/post-handoff-trust-intake.schema.json",
  "title": "Hermes Post-Handoff Trust Intake",
  "type": "object",
  "required": [
    "schema_version",
    "generated_at",
    "capability_id",
    "program_range",
    "source_program_range",
    "post_handoff_phase_rows",
    "p19200_source_binding_rows",
    "handoff_receipt_materialization_rows",
    "trust_carry_forward_rows",
    "evidence_freshness_window_rows",
    "operator_handoff_packet_rows",
    "authority_boundary_continuation_rows",
    "p19600_freeze_rows",
    "post_handoff_trust_boundary",
    "post_handoff_trust_validation_items",
    "summary",
    "validation"
  ],
  "properties": {
    "schema_version": { "const": "post-handoff-trust-intake.v1" },
    "generated_at": { "type": "string", "format": "date-time" },
    "capability_id": { "const": "platform.post_handoff_trust_intake" },
    "program_range": { "const": "P19201-P19600" },
    "source_program_range": { "const": "P18801-P19200" },
    "post_handoff_phase_rows": { "type": "array", "minItems": 7, "items": { "$ref": "#/$defs/verdictRow" } },
    "p19200_source_binding_rows": { "type": "array", "minItems": 7, "items": { "$ref": "#/$defs/verdictRow" } },
    "handoff_receipt_materialization_rows": { "type": "array", "minItems": 7, "items": { "$ref": "#/$defs/verdictRow" } },
    "trust_carry_forward_rows": { "type": "array", "minItems": 6, "items": { "$ref": "#/$defs/verdictRow" } },
    "evidence_freshness_window_rows": { "type": "array", "minItems": 6, "items": { "$ref": "#/$defs/verdictRow" } },
    "operator_handoff_packet_rows": { "type": "array", "minItems": 5, "items": { "$ref": "#/$defs/verdictRow" } },
    "authority_boundary_continuation_rows": { "type": "array", "minItems": 18, "items": { "$ref": "#/$defs/verdictRow" } },
    "p19600_freeze_rows": { "type": "array", "minItems": 6, "items": { "$ref": "#/$defs/verdictRow" } },
    "post_handoff_trust_validation_items": { "type": "array", "minItems": 11, "items": { "$ref": "#/$defs/validationItem" } },
    "summary": {
      "type": "object",
      "required": [
        "post_handoff_trust_status",
        "source_p19200_ready_for_p19201_handoff",
        "handoff_receipts_passed_now",
        "evidence_freshness_passed_now",
        "source_commit_ref_present_now",
        "carried_forward_trust_debt_count",
        "ready_for_p19601_handoff",
        "production_pass_enabled"
      ],
      "properties": {
        "post_handoff_trust_status": {
          "enum": [
            "ready_for_post_handoff_trust_intake",
            "valid_block_handoff_pending",
            "blocked_post_handoff_trust_intake"
          ]
        },
        "source_p19200_ready_for_p19201_handoff": { "type": "boolean" },
        "handoff_receipts_passed_now": { "type": "boolean" },
        "evidence_freshness_passed_now": { "type": "boolean" },
        "source_commit_ref_present_now": { "type": "boolean" },
        "carried_forward_trust_debt_count": { "type": "number" },
        "ready_for_p19601_handoff": { "type": "boolean" },
        "production_pass_enabled": { "const": false }
      }
    },
    "post_handoff_trust_boundary": {
      "type": "object",
      "required": [
        "p19600_contract_ready",
        "ready_for_p19601_handoff",
        "source_p19200_ready_for_p19201_handoff",
        "source_validation_valid_now",
        "handoff_receipts_passed_now",
        "evidence_freshness_passed_now",
        "source_commit_ref_present_now",
        "carried_forward_trust_debt_count",
        "deployment_allowed_now",
        "release_approval_allowed_now",
        "production_pass_enabled",
        "enterprise_pass_enabled",
        "enterprise_trust_claim_allowed_now",
        "protected_closeout_enabled",
        "human_gate_bypass_allowed_now",
        "independent_review_bypass_allowed_now",
        "single_owner_enterprise_trust_allowed_now",
        "runtime_execution_allowed_now",
        "write_action_allowed_now",
        "protected_action_allowed_now",
        "connector_write_enabled",
        "external_service_mutation_allowed_now",
        "raw_source_exposure_allowed",
        "secret_read_allowed_now",
        "reviewer_mutation_allowed_now",
        "final_automated_approval_allowed"
      ],
      "properties": {
        "p19600_contract_ready": { "type": "boolean" },
        "ready_for_p19601_handoff": { "type": "boolean" },
        "source_p19200_ready_for_p19201_handoff": { "type": "boolean" },
        "source_validation_valid_now": { "type": "boolean" },
        "handoff_receipts_passed_now": { "type": "boolean" },
        "evidence_freshness_passed_now": { "type": "boolean" },
        "source_commit_ref_present_now": { "type": "boolean" },
        "carried_forward_trust_debt_count": { "type": "number" },
        "deployment_allowed_now": { "const": false },
        "release_approval_allowed_now": { "const": false },
        "production_pass_enabled": { "const": false },
        "enterprise_pass_enabled": { "const": false },
        "enterprise_trust_claim_allowed_now": { "const": false },
        "protected_closeout_enabled": { "const": false },
        "human_gate_bypass_allowed_now": { "const": false },
        "independent_review_bypass_allowed_now": { "const": false },
        "single_owner_enterprise_trust_allowed_now": { "const": false },
        "runtime_execution_allowed_now": { "const": false },
        "write_action_allowed_now": { "const": false },
        "protected_action_allowed_now": { "const": false },
        "connector_write_enabled": { "const": false },
        "external_service_mutation_allowed_now": { "const": false },
        "raw_source_exposure_allowed": { "const": false },
        "secret_read_allowed_now": { "const": false },
        "reviewer_mutation_allowed_now": { "const": false },
        "final_automated_approval_allowed": { "const": false }
      }
    },
    "validation": {
      "type": "object",
      "required": ["valid", "error_count", "errors"],
      "properties": {
        "valid": { "type": "boolean" },
        "error_count": { "type": "number" },
        "errors": { "type": "array" }
      }
    }
  },
  "$defs": {
    "verdictRow": {
      "type": "object",
      "required": [
        "row_id",
        "category",
        "label",
        "observed",
        "current_verdict",
        "block_reason",
        "evidence_ref",
        "generated_at"
      ],
      "properties": {
        "row_id": { "type": "string", "minLength": 1 },
        "category": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "observed": { "type": "boolean" },
        "current_verdict": { "enum": ["pass", "blocked"] },
        "block_reason": { "type": ["string", "null"] },
        "evidence_ref": { "type": "string", "minLength": 1 },
        "generated_at": { "type": "string", "format": "date-time" }
      }
    },
    "validationItem": {
      "type": "object",
      "required": ["item_id", "category", "passed", "message", "evidence_ref"],
      "properties": {
        "item_id": { "type": "string", "minLength": 1 },
        "category": { "type": "string", "minLength": 1 },
        "passed": { "type": "boolean" },
        "message": { "type": "string" },
        "evidence_ref": { "type": "string", "minLength": 1 }
      }
    }
  }
}
