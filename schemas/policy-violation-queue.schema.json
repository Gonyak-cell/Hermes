{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://amic.local/hermes/policy-violation-queue.schema.json",
  "title": "Hermes Policy Violation Queue",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "policy_violation_queue_id",
    "policy_violation_queue_status",
    "capability_id",
    "phase_slot",
    "previous_phase_slot",
    "next_phase_slot",
    "generated_at",
    "output_dir",
    "inputs",
    "source_contracts",
    "policy_violation_queue_contract",
    "policy_violation_queue_panels",
    "policy_violation_queue_items",
    "policy_violation_actor_actions",
    "policy_violation_queue_boundary",
    "policy_violation_queue_checks",
    "validation_items",
    "validation",
    "summary"
  ],
  "properties": {
    "schema_version": { "const": "policy-violation-queue.v1" },
    "policy_violation_queue_id": { "type": "string", "minLength": 1 },
    "policy_violation_queue_status": { "enum": ["complete", "attention"] },
    "capability_id": { "const": "desktop.policy_violation_queue" },
    "phase_slot": { "const": "P294" },
    "previous_phase_slot": { "const": "P293" },
    "next_phase_slot": { "const": "P295" },
    "generated_at": { "type": "string", "format": "date-time" },
    "output_dir": { "type": "string" },
    "inputs": { "type": "object" },
    "source_contracts": {
      "type": "object",
      "required": [
        "policy_operations_surface",
        "matter_access_policy_evaluator",
        "model_policy_enforcement",
        "tool_runtime_policy_enforcement",
        "output_destination_policy_enforcement",
        "matter_cockpit_ui"
      ],
      "additionalProperties": { "$ref": "#/$defs/source_contract" }
    },
    "policy_violation_queue_contract": { "type": "object" },
    "policy_violation_queue_panels": {
      "type": "array",
      "minItems": 4,
      "items": { "$ref": "#/$defs/panel" }
    },
    "policy_violation_queue_items": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/queue_item" }
    },
    "policy_violation_actor_actions": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/actor_action" }
    },
    "policy_violation_queue_boundary": { "$ref": "#/$defs/boundary" },
    "policy_violation_queue_checks": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/validation_item" }
    },
    "validation_items": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/validation_item" }
    },
    "validation": { "$ref": "#/$defs/validation" },
    "summary": { "$ref": "#/$defs/summary" }
  },
  "$defs": {
    "source_contract": {
      "type": "object",
      "required": ["schema_version", "status", "generated_at", "validation_error_count"],
      "properties": {
        "schema_version": { "type": ["string", "null"] },
        "status": { "type": "string" },
        "generated_at": { "type": ["string", "null"], "format": "date-time" },
        "validation_error_count": { "type": "integer", "minimum": 0 }
      }
    },
    "panel": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "schema_version",
        "policy_violation_queue_panel_id",
        "panel_key",
        "panel_status",
        "queue_item_count",
        "read_only",
        "preview_only",
        "queue_projection_only",
        "policy_mutation_allowed",
        "approval_application_allowed",
        "protected_action_execution_allowed",
        "delivery_execution_allowed",
        "human_review_required",
        "client_facing_ready"
      ],
      "properties": {
        "schema_version": { "const": "policy-violation-queue-panel.v1" },
        "policy_violation_queue_panel_id": { "type": "string" },
        "panel_key": { "enum": ["model", "tool", "access", "output"] },
        "panel_status": { "const": "ready" },
        "queue_item_count": { "type": "integer", "minimum": 0 },
        "read_only": { "const": true },
        "preview_only": { "const": true },
        "queue_projection_only": { "const": true },
        "policy_mutation_allowed": { "const": false },
        "approval_application_allowed": { "const": false },
        "protected_action_execution_allowed": { "const": false },
        "delivery_execution_allowed": { "const": false },
        "human_review_required": { "const": true },
        "client_facing_ready": { "const": false }
      }
    },
    "queue_item": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "schema_version",
        "policy_violation_queue_item_id",
        "queue_item_status",
        "queue_item_type",
        "policy_family",
        "policy_layer",
        "source_artifact_id",
        "source_record_type",
        "source_record_id",
        "violation_type",
        "severity",
        "decision",
        "gate_status",
        "required_actor",
        "actor_action_type",
        "actor_action_status",
        "read_only",
        "preview_only",
        "queue_projection_only",
        "source_content_read_performed",
        "policy_mutation_allowed",
        "approval_application_allowed",
        "protected_action_execution_allowed",
        "delivery_execution_allowed",
        "route_execution_allowed",
        "server_start_allowed",
        "legal_advice_generated",
        "client_facing_output_generated",
        "human_review_required",
        "client_facing_ready"
      ],
      "properties": {
        "schema_version": { "const": "policy-violation-queue-item.v1" },
        "policy_violation_queue_item_id": { "type": "string" },
        "queue_item_status": { "const": "open" },
        "queue_item_type": { "enum": ["policy_violation", "policy_hold"] },
        "policy_family": { "enum": ["model", "tool", "access", "output"] },
        "policy_layer": { "type": "string" },
        "source_artifact_id": { "type": "string" },
        "source_record_type": { "type": "string" },
        "source_record_id": { "type": "string" },
        "policy_decision_row_id": { "type": ["string", "null"] },
        "policy_violation_row_id": { "type": ["string", "null"] },
        "policy_pending_approval_id": { "type": ["string", "null"] },
        "violation_type": { "type": "string" },
        "severity": { "enum": ["info", "warning", "critical"] },
        "decision": { "enum": ["allow", "review", "deny"] },
        "gate_status": { "type": "string" },
        "tenant_id": { "type": ["string", "null"] },
        "matter_id": { "type": ["string", "null"] },
        "resource_id": { "type": ["string", "null"] },
        "runtime_id": { "type": ["string", "null"] },
        "classification": { "type": ["string", "null"] },
        "policy_snapshot_id": { "type": ["string", "null"] },
        "required_gates": { "type": "array", "items": { "type": "string" } },
        "reason_codes": { "type": "array", "items": { "type": "string" } },
        "required_actor": { "type": "string" },
        "actor_action_type": { "type": "string" },
        "actor_action_status": { "const": "open" },
        "read_only": { "const": true },
        "preview_only": { "const": true },
        "queue_projection_only": { "const": true },
        "source_content_read_performed": { "const": false },
        "policy_mutation_allowed": { "const": false },
        "approval_application_allowed": { "const": false },
        "protected_action_execution_allowed": { "const": false },
        "delivery_execution_allowed": { "const": false },
        "route_execution_allowed": { "const": false },
        "server_start_allowed": { "const": false },
        "legal_advice_generated": { "const": false },
        "client_facing_output_generated": { "const": false },
        "human_review_required": { "const": true },
        "client_facing_ready": { "const": false }
      }
    },
    "actor_action": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "schema_version",
        "policy_violation_actor_action_id",
        "policy_violation_queue_item_id",
        "policy_family",
        "actor_role",
        "actor_action_type",
        "action_status",
        "read_only",
        "preview_only",
        "queue_projection_only",
        "policy_mutation_allowed",
        "approval_application_allowed",
        "protected_action_execution_allowed",
        "delivery_execution_allowed",
        "human_review_required",
        "client_facing_ready"
      ],
      "properties": {
        "schema_version": { "const": "policy-violation-actor-action.v1" },
        "policy_violation_actor_action_id": { "type": "string" },
        "policy_violation_queue_item_id": { "type": "string" },
        "policy_family": { "enum": ["model", "tool", "access", "output"] },
        "actor_role": { "type": "string" },
        "actor_action_type": { "type": "string" },
        "action_status": { "const": "open" },
        "read_only": { "const": true },
        "preview_only": { "const": true },
        "queue_projection_only": { "const": true },
        "policy_mutation_allowed": { "const": false },
        "approval_application_allowed": { "const": false },
        "protected_action_execution_allowed": { "const": false },
        "delivery_execution_allowed": { "const": false },
        "human_review_required": { "const": true },
        "client_facing_ready": { "const": false }
      }
    },
    "boundary": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "schema_version",
        "boundary_status",
        "read_only",
        "preview_only",
        "queue_projection_only",
        "source_content_read_performed",
        "source_ingest_performed",
        "policy_mutation_allowed",
        "approval_application_performed",
        "receipt_application_performed",
        "protected_action_executed",
        "delivery_execution_performed",
        "route_execution_performed",
        "server_started",
        "legal_advice_generated",
        "client_facing_output_generated",
        "human_review_required",
        "client_facing_ready",
        "windows_baseline_stability_preserved",
        "mac_windows_completion_instability_guard"
      ],
      "properties": {
        "schema_version": { "const": "policy-violation-queue-boundary.v1" },
        "boundary_status": { "const": "enforced" },
        "read_only": { "const": true },
        "preview_only": { "const": true },
        "queue_projection_only": { "const": true },
        "source_content_read_performed": { "const": false },
        "source_ingest_performed": { "const": false },
        "policy_mutation_allowed": { "const": false },
        "approval_application_performed": { "const": false },
        "receipt_application_performed": { "const": false },
        "protected_action_executed": { "const": false },
        "delivery_execution_performed": { "const": false },
        "route_execution_performed": { "const": false },
        "server_started": { "const": false },
        "legal_advice_generated": { "const": false },
        "client_facing_output_generated": { "const": false },
        "human_review_required": { "const": true },
        "client_facing_ready": { "const": false },
        "windows_baseline_stability_preserved": { "const": true },
        "mac_windows_completion_instability_guard": { "const": true }
      }
    },
    "validation_item": {
      "type": "object",
      "required": ["validation_item_id", "check_id", "path", "status", "message"],
      "properties": {
        "validation_item_id": { "type": "string" },
        "check_id": { "type": "string" },
        "path": { "type": "string" },
        "status": { "enum": ["passed", "failed"] },
        "message": { "type": "string" },
        "generated_at": { "type": "string", "format": "date-time" }
      }
    },
    "validation": {
      "type": "object",
      "required": ["valid", "errors"],
      "properties": {
        "valid": { "type": "boolean" },
        "errors": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["path", "message", "check_id"],
            "properties": {
              "path": { "type": "string" },
              "message": { "type": "string" },
              "check_id": { "type": "string" }
            }
          }
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "policy_violation_queue_status",
        "policy_violation_queue_id",
        "phase_slot",
        "previous_phase_slot",
        "next_phase_slot",
        "source_policy_operations_surface_status",
        "source_model_policy_enforcement_status",
        "source_tool_runtime_policy_enforcement_status",
        "source_matter_access_policy_status",
        "source_output_destination_policy_status",
        "source_matter_cockpit_ui_status",
        "policy_violation_queue_panel_count",
        "queue_item_count",
        "policy_violation_item_count",
        "policy_hold_item_count",
        "model_queue_item_count",
        "tool_queue_item_count",
        "access_queue_item_count",
        "output_queue_item_count",
        "open_actor_action_count",
        "read_only",
        "preview_only",
        "queue_projection_only",
        "policy_mutation_allowed",
        "approval_application_performed",
        "protected_action_executed",
        "delivery_execution_performed",
        "route_execution_performed",
        "server_started",
        "legal_advice_generated",
        "client_facing_output_generated",
        "windows_baseline_stability_preserved",
        "mac_windows_completion_instability_guard",
        "validation_item_count",
        "failed_checkpoint_count",
        "validation_error_count"
      ],
      "properties": {
        "policy_violation_queue_status": { "enum": ["complete", "attention"] },
        "policy_violation_queue_id": { "type": "string" },
        "phase_slot": { "const": "P294" },
        "previous_phase_slot": { "const": "P293" },
        "next_phase_slot": { "const": "P295" },
        "queue_item_count": { "type": "integer", "minimum": 1 },
        "policy_violation_item_count": { "type": "integer", "minimum": 0 },
        "policy_hold_item_count": { "type": "integer", "minimum": 0 },
        "model_queue_item_count": { "type": "integer", "minimum": 1 },
        "tool_queue_item_count": { "type": "integer", "minimum": 1 },
        "access_queue_item_count": { "type": "integer", "minimum": 1 },
        "output_queue_item_count": { "type": "integer", "minimum": 1 },
        "read_only": { "const": true },
        "preview_only": { "const": true },
        "queue_projection_only": { "const": true },
        "policy_mutation_allowed": { "const": false },
        "approval_application_performed": { "const": false },
        "protected_action_executed": { "const": false },
        "delivery_execution_performed": { "const": false },
        "route_execution_performed": { "const": false },
        "server_started": { "const": false },
        "legal_advice_generated": { "const": false },
        "client_facing_output_generated": { "const": false },
        "windows_baseline_stability_preserved": { "const": true },
        "mac_windows_completion_instability_guard": { "const": true },
        "validation_error_count": { "const": 0 }
      }
    }
  }
}
