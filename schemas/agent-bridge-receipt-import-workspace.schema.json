    "verdictRow": {
      "type": "object",
      "required": ["row_id", "current_verdict", "unsafe_flags_false", "verdict_authority", "opens_authority"],
      "properties": {
        "row_id": { "type": "string", "minLength": 1 },
        "current_verdict": { "enum": ["pass", "blocked"] },
        "unsafe_flags_false": { "type": "boolean" },
        "verdict_authority": { "const": "harness_deterministic_validator" },
        "opens_authority": { "const": false }
      },
      "additionalProperties": true
    },
    "importCandidateRow": {
      "allOf": [
        { "$ref": "#/$defs/verdictRow" },
        {
          "type": "object",
          "required": [
            "import_candidate_id",
            "receipt_id",
            "request_id",
            "normalized_summary_only",
            "raw_output_included",
            "raw_receipt_stored",
            "import_preview_created",
            "receipt_applied",
            "receipt_application_allowed_now",
            "approval_application_allowed_now",
