        "final_approval_ui_enabled": { "const": false },
        "codex_final_approval_ui_enabled": { "const": false },
        "claude_final_approval_ui_enabled": { "const": false },
        "production_pass_ui_enabled": { "const": false },
        "enterprise_pass_ui_enabled": { "const": false },
        "domain_pack_product_identity_enabled": { "const": false },
        "api_write_methods_enabled": { "const": false },
        "phase_tranche_top_nav_allowed": { "const": false },
        "p11201_token_component_handoff_ready": { "const": true },
        "p11800_design_system_freeze_ready": { "const": false },
