{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hermes.local/schemas/ui-projection-replay-ledger.schema.json",
  "title": "Hermes UI Projection Replay Ledger",
  "type": "object",
  "required": [
