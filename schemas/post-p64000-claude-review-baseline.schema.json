{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hermes.local/schemas/post-p64000-claude-review-baseline.schema.json",
  "title": "Post-P64000 Claude Review Baseline",
  "type": "object",
  "required": [
    "schema_version",
    "capability_id",
    "program_range",
    "source_program_range",
    "next_program_range",
    "post_p64000_review_baseline_contract",
    "p64000_final_freeze_source_rows",
    "last_claude_review_receipt_rows",
    "post_review_commit_scope_rows",
    "post_review_changed_file_rows",
    "claude_review_packet_rows",
    "validation_command_rows",
    "authority_boundary_rows",
    "negative_fixture_contract_rows",
    "p64400_wiring_rows",
    "p64400_closeout_rows",
    "p64401_handoff_rows",
    "post_p64000_claude_review_boundary",
    "summary",
    "validation"
  ],
  "properties": {
    "schema_version": { "const": "post-p64000-claude-review-baseline.v1" },
    "capability_id": { "const": "platform.post_p64000_claude_review_baseline" },
    "program_range": { "const": "P64001-P64400" },
    "source_program_range": { "const": "P63601-P64000" },
    "next_program_range": { "const": "P64401-P64800" },
    "post_p64000_review_baseline_contract": {
      "type": "object",
      "required": [
        "claude_review_is_read_only",
        "claude_final_approval_allowed",
        "protected_closeout_allowed",
        "production_pass_allowed",
        "enterprise_pass_allowed"
      ],
      "properties": {
        "claude_review_is_read_only": { "const": true },
        "claude_final_approval_allowed": { "const": false },
        "protected_closeout_allowed": { "const": false },
        "production_pass_allowed": { "const": false },
        "enterprise_pass_allowed": { "const": false }
      },
      "additionalProperties": true
    },
    "p64000_final_freeze_source_rows": { "type": "array", "minItems": 5, "items": { "$ref": "#/$defs/verdictRow" } },
    "last_claude_review_receipt_rows": { "type": "array", "minItems": 11, "items": { "$ref": "#/$defs/verdictRow" } },
    "post_review_commit_scope_rows": { "type": "array", "minItems": 5, "items": { "$ref": "#/$defs/verdictRow" } },
    "post_review_changed_file_rows": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/verdictRow" } },
    "claude_review_packet_rows": { "type": "array", "minItems": 10, "items": { "$ref": "#/$defs/verdictRow" } },
    "validation_command_rows": { "type": "array", "minItems": 6, "items": { "$ref": "#/$defs/verdictRow" } },
    "authority_boundary_rows": { "type": "array", "minItems": 28, "items": { "$ref": "#/$defs/verdictRow" } },
    "negative_fixture_contract_rows": { "type": "array", "minItems": 9, "items": { "$ref": "#/$defs/verdictRow" } },
    "p64400_wiring_rows": { "type": "array", "minItems": 3, "items": { "$ref": "#/$defs/verdictRow" } },
    "p64400_closeout_rows": { "type": "array", "minItems": 9, "items": { "$ref": "#/$defs/verdictRow" } },
    "p64401_handoff_rows": { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/verdictRow" } },
    "post_p64000_claude_review_boundary": {
      "type": "object",
      "required": [
        "post_p64000_review_baseline_ready",
        "p64000_final_freeze_ready_now",
        "last_claude_receipt_valid_now",
        "post_review_scope_ready_now",
        "changed_file_scope_ready_now",
        "claude_review_packet_ready_now",
        "ready_for_p64401_handoff",
        "runtime_execution_allowed_now",
        "write_action_allowed_now",
        "connector_write_allowed_now",
        "protected_action_allowed_now",
        "claude_review_execution_allowed_now",
        "claude_source_mutation_allowed_now",
        "claude_receipt_accept_allowed_now",
        "reviewer_dispatch_allowed_now",
        "finding_resolution_allowed_now",
        "post_p64000_production_pass_claim_allowed_now",
        "post_p64000_enterprise_pass_claim_allowed_now",
        "production_pass_allowed_now",
        "enterprise_pass_allowed_now",
        "codex_final_approval_allowed",
        "claude_final_approval_allowed",
        "production_pass_enabled",
        "enterprise_pass_enabled",
        "final_approval_enabled"
      ],
      "properties": {
        "post_p64000_review_baseline_ready": { "type": "boolean" },
        "p64000_final_freeze_ready_now": { "type": "boolean" },
        "last_claude_receipt_valid_now": { "type": "boolean" },
        "post_review_scope_ready_now": { "type": "boolean" },
        "changed_file_scope_ready_now": { "type": "boolean" },
        "claude_review_packet_ready_now": { "type": "boolean" },
        "ready_for_p64401_handoff": { "type": "boolean" },
        "runtime_execution_allowed_now": { "const": false },
        "write_action_allowed_now": { "const": false },
        "connector_write_allowed_now": { "const": false },
        "protected_action_allowed_now": { "const": false },
        "claude_review_execution_allowed_now": { "const": false },
        "claude_source_mutation_allowed_now": { "const": false },
        "claude_receipt_accept_allowed_now": { "const": false },
        "reviewer_dispatch_allowed_now": { "const": false },
        "finding_resolution_allowed_now": { "const": false },
        "post_p64000_production_pass_claim_allowed_now": { "const": false },
        "post_p64000_enterprise_pass_claim_allowed_now": { "const": false },
        "production_pass_allowed_now": { "const": false },
        "enterprise_pass_allowed_now": { "const": false },
        "codex_final_approval_allowed": { "const": false },
        "claude_final_approval_allowed": { "const": false },
        "production_pass_enabled": { "const": false },
        "enterprise_pass_enabled": { "const": false },
        "final_approval_enabled": { "const": false }
      },
      "additionalProperties": true
    },
    "summary": {
      "type": "object",
      "required": [
        "post_p64000_claude_review_baseline_status",
        "program_range",
        "source_program_range",
        "next_program_range",
        "p64000_final_freeze_ready_now",
        "last_claude_receipt_valid_now",
        "post_review_scope_ready_now",
        "claude_review_packet_ready_now",
        "ready_for_p64401_handoff",
        "claude_review_execution_allowed_now",
        "production_pass_enabled",
        "enterprise_pass_enabled",
        "final_approval_enabled"
      ],
      "properties": {
        "post_p64000_claude_review_baseline_status": {
          "enum": [
            "ready_for_p64401_claude_readonly_review",
            "valid_block_p64401_handoff_pending",
            "blocked_post_p64000_claude_review_baseline"
          ]
        },
        "program_range": { "const": "P64001-P64400" },
        "source_program_range": { "const": "P63601-P64000" },
        "next_program_range": { "const": "P64401-P64800" },
        "claude_review_execution_allowed_now": { "const": false },
        "production_pass_enabled": { "const": false },
        "enterprise_pass_enabled": { "const": false },
        "final_approval_enabled": { "const": false }
      },
      "additionalProperties": true
    },
    "validation": {
      "type": "object",
      "required": ["valid", "error_count", "errors"],
      "properties": {
        "valid": { "type": "boolean" },
        "error_count": { "type": "number" },
        "errors": { "type": "array" }
      },
      "additionalProperties": true
    }
  },
  "$defs": {
    "verdictRow": {
      "type": "object",
      "required": [
        "row_id",
        "category",
        "label",
        "observed",
        "current_verdict",
        "evidence_ref",
        "block_reason",
        "next_allowed_action",
        "generated_at"
      ],
      "properties": {
        "row_id": { "type": "string" },
        "category": { "type": "string" },
        "label": { "type": "string" },
        "observed": { "type": "boolean" },
        "current_verdict": { "enum": ["pass", "block"] },
        "evidence_ref": { "type": ["string", "null"] },
        "block_reason": { "type": ["string", "null"] },
        "next_allowed_action": { "type": "string" },
        "generated_at": { "type": "string" }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
