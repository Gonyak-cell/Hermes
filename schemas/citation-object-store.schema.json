{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://amic.local/hermes/citation-object-store.schema.json",
  "title": "Hermes Citation Object Store",
  "type": "object",
  "required": [
    "schema_version",
    "generated_at",
    "citation_object_store_id",
    "output_dir",
    "inputs",
    "source_issue_graph_store",
    "citation_object_store_contract",
    "citation_catalog",
    "validation_items",
    "validation",
    "summary"
  ],
  "properties": {
    "schema_version": { "const": "citation-object-store.v1" },
    "generated_at": { "type": "string", "format": "date-time" },
    "citation_object_store_id": { "type": "string" },
    "output_dir": { "type": "string" },
    "inputs": {
      "type": "object",
      "required": ["issue_graph_store_path", "package_path", "roadmap_path"],
      "properties": {
        "issue_graph_store_path": { "type": "string" },
        "package_path": { "type": "string" },
        "roadmap_path": { "type": "string" }
      }
    },
    "source_issue_graph_store": { "$ref": "#/$defs/source_summary" },
    "citation_object_store_contract": { "$ref": "#/$defs/store_contract" },
    "citation_catalog": {
      "type": "object",
      "required": [
        "schema_version",
        "generated_at",
        "output_paragraphs",
        "citations",
        "paragraph_source_bindings",
        "review_queue_items",
        "citation_indexes"
      ],
      "properties": {
        "schema_version": { "const": "citation-catalog.v1" },
        "generated_at": { "type": "string", "format": "date-time" },
        "output_paragraphs": { "type": "array", "items": { "$ref": "#/$defs/output_paragraph" } },
        "citations": { "type": "array", "items": { "$ref": "#/$defs/citation" } },
        "paragraph_source_bindings": { "type": "array", "items": { "$ref": "#/$defs/paragraph_source_binding" } },
        "review_queue_items": { "type": "array", "items": { "$ref": "#/$defs/review_queue_item" } },
        "citation_indexes": { "$ref": "#/$defs/indexes" }
      }
    },
    "validation_items": { "type": "array", "items": { "$ref": "#/$defs/validation_item" } },
    "validation": {
      "type": "object",
      "required": ["valid", "errors"],
      "properties": {
        "valid": { "type": "boolean" },
        "errors": { "type": "array", "items": { "$ref": "#/$defs/validation_error" } }
      }
    },
    "summary": { "$ref": "#/$defs/summary" }
  },
  "$defs": {
    "source_summary": {
      "type": "object",
      "required": ["source_id", "schema_version", "generated_at", "summary"],
      "properties": {
        "source_id": { "type": "string" },
        "schema_version": { "type": ["string", "null"] },
        "generated_at": { "type": ["string", "null"] },
        "summary": { "type": ["object", "null"] }
      }
    },
    "store_contract": {
      "type": "object",
      "required": [
        "schema_version",
        "citation_object_store_contract_id",
        "generated_at",
        "issue_schema_version",
        "output_paragraph_schema_version",
        "citation_schema_version",
        "paragraph_source_binding_schema_version",
        "source_inputs",
        "required_identity_fields",
        "required_lineage_links",
        "citation_rule",
        "output_rule",
        "source_binding_rule",
        "matter_boundary_rule"
      ],
      "properties": {
        "schema_version": { "const": "citation-object-store-contract.v1" },
        "citation_object_store_contract_id": { "const": "citation-object-store.v1" },
        "generated_at": { "type": "string", "format": "date-time" },
        "issue_schema_version": { "const": "issue.v2" },
        "output_paragraph_schema_version": { "const": "output-paragraph.v1" },
        "citation_schema_version": { "const": "citation.v2" },
        "paragraph_source_binding_schema_version": { "const": "paragraph-source-binding.v1" },
        "source_inputs": { "type": "array", "items": { "type": "string" } },
        "required_identity_fields": { "type": "array", "items": { "type": "string" } },
        "required_lineage_links": { "type": "array", "items": { "type": "string" } },
        "citation_rule": { "type": "string" },
        "output_rule": { "type": "string" },
        "source_binding_rule": { "type": "string" },
        "matter_boundary_rule": { "type": "string" }
      }
    },
    "output_paragraph": {
      "type": "object",
      "required": [
        "schema_version",
        "output_paragraph_id",
        "draft_artifact_id",
        "paragraph_type",
        "paragraph_text",
        "tenant_id",
        "matter_id",
        "classification",
        "policy_snapshot_id",
        "issue_id",
        "linked_fact_ids",
        "linked_fact_count",
        "evidence_item_ids",
        "evidence_item_count",
        "source_span_ids",
        "source_span_count",
        "citation_ids",
        "citation_count",
        "review_status",
        "approval_status",
        "client_facing_status",
        "created_at",
        "metadata"
      ],
      "properties": {
        "schema_version": { "const": "output-paragraph.v1" },
        "output_paragraph_id": { "type": "string" },
        "draft_artifact_id": { "type": "string" },
        "paragraph_type": { "type": "string" },
        "paragraph_text": { "type": "string" },
        "tenant_id": { "type": ["string", "null"] },
        "matter_id": { "type": ["string", "null"] },
        "classification": { "type": ["string", "null"] },
        "policy_snapshot_id": { "type": ["string", "null"] },
        "issue_id": { "type": "string" },
        "linked_fact_ids": { "type": "array", "items": { "type": "string" } },
        "linked_fact_count": { "type": "integer", "minimum": 0 },
        "evidence_item_ids": { "type": "array", "items": { "type": "string" } },
        "evidence_item_count": { "type": "integer", "minimum": 0 },
        "source_span_ids": { "type": "array", "items": { "type": "string" } },
        "source_span_count": { "type": "integer", "minimum": 0 },
        "citation_ids": { "type": "array", "items": { "type": "string" } },
        "citation_count": { "type": "integer", "minimum": 0 },
        "review_status": { "const": "needs_review" },
        "approval_status": { "const": "not_requested" },
        "client_facing_status": { "const": "not_client_facing" },
        "created_at": { "type": "string", "format": "date-time" },
        "metadata": { "type": "object" }
      }
    },
    "citation": {
      "type": "object",
      "required": [
        "schema_version",
        "citation_id",
        "output_paragraph_id",
        "issue_id",
        "fact_id",
        "evidence_item_id",
        "source_span_id",
        "lineage_id",
        "tenant_id",
        "matter_id",
        "classification",
        "policy_snapshot_id",
        "citation_style",
        "citation_status",
        "verification_status",
        "source_binding_status",
        "human_review_required",
        "client_facing_ready",
        "created_at",
        "metadata"
      ],
      "properties": {
        "schema_version": { "const": "citation.v2" },
        "citation_id": { "type": "string" },
        "output_paragraph_id": { "type": "string" },
        "issue_id": { "type": "string" },
        "fact_id": { "type": ["string", "null"] },
        "evidence_item_id": { "type": ["string", "null"] },
        "source_span_id": { "type": "string" },
        "lineage_id": { "type": "string" },
        "tenant_id": { "type": ["string", "null"] },
        "matter_id": { "type": ["string", "null"] },
        "classification": { "type": ["string", "null"] },
        "policy_snapshot_id": { "type": ["string", "null"] },
        "citation_style": { "const": "source_span_reference" },
        "citation_status": { "const": "needs_review" },
        "verification_status": { "const": "source_span_bound_pending_review" },
        "source_binding_status": { "enum": ["bound", "broken"] },
        "human_review_required": { "const": true },
        "client_facing_ready": { "const": false },
        "created_at": { "type": "string", "format": "date-time" },
        "metadata": { "type": "object" }
      }
    },
    "paragraph_source_binding": {
      "type": "object",
      "required": [
        "schema_version",
        "paragraph_source_binding_id",
        "output_paragraph_id",
        "citation_id",
        "issue_id",
        "fact_id",
        "evidence_item_id",
        "source_span_id",
        "binding_status",
        "tenant_id",
        "matter_id",
        "classification",
        "policy_snapshot_id",
        "matter_preserved",
        "classification_preserved",
        "policy_snapshot_preserved",
        "issue_link_preserved",
        "created_at"
      ],
      "properties": {
        "schema_version": { "const": "paragraph-source-binding.v1" },
        "paragraph_source_binding_id": { "type": "string" },
        "output_paragraph_id": { "type": "string" },
        "citation_id": { "type": "string" },
        "issue_id": { "type": "string" },
        "fact_id": { "type": ["string", "null"] },
        "evidence_item_id": { "type": ["string", "null"] },
        "source_span_id": { "type": "string" },
        "binding_status": { "enum": ["bound", "broken"] },
        "tenant_id": { "type": ["string", "null"] },
        "matter_id": { "type": ["string", "null"] },
        "classification": { "type": ["string", "null"] },
        "policy_snapshot_id": { "type": ["string", "null"] },
        "matter_preserved": { "type": "boolean" },
        "classification_preserved": { "type": "boolean" },
        "policy_snapshot_preserved": { "type": "boolean" },
        "issue_link_preserved": { "type": "boolean" },
        "created_at": { "type": "string", "format": "date-time" }
      }
    },
    "review_queue_item": {
      "type": "object",
      "required": [
        "schema_version",
        "review_queue_item_id",
        "subject_type",
        "subject_id",
        "output_paragraph_id",
        "citation_id",
        "issue_id",
        "source_span_id",
        "matter_id",
        "classification",
        "review_status",
        "review_required",
        "approval_required_before_output",
        "queue_reason",
        "assigned_role",
        "created_at"
      ],
      "properties": {
        "schema_version": { "const": "citation-review-queue-item.v1" },
        "review_queue_item_id": { "type": "string" },
        "subject_type": { "const": "citation" },
        "subject_id": { "type": "string" },
        "output_paragraph_id": { "type": "string" },
        "citation_id": { "type": "string" },
        "issue_id": { "type": "string" },
        "source_span_id": { "type": "string" },
        "matter_id": { "type": ["string", "null"] },
        "classification": { "type": ["string", "null"] },
        "review_status": { "const": "needs_review" },
        "review_required": { "const": true },
        "approval_required_before_output": { "const": true },
        "queue_reason": { "const": "machine_bound_citation_candidate" },
        "assigned_role": { "type": "string" },
        "created_at": { "type": "string", "format": "date-time" }
      }
    },
    "indexes": {
      "type": "object",
      "required": [
        "schema_version",
        "generated_at",
        "by_matter_id",
        "by_classification",
        "by_review_status",
        "by_citation_status",
        "by_verification_status",
        "by_source_binding_status",
        "by_client_facing_ready",
        "by_client_facing_status",
        "by_issue_type",
        "by_risk_severity",
        "by_paragraph_binding_status"
      ],
      "properties": {
        "schema_version": { "const": "citation-indexes.v1" },
        "generated_at": { "type": "string", "format": "date-time" },
        "by_matter_id": { "type": "object" },
        "by_classification": { "type": "object" },
        "by_review_status": { "type": "object" },
        "by_citation_status": { "type": "object" },
        "by_verification_status": { "type": "object" },
        "by_source_binding_status": { "type": "object" },
        "by_client_facing_ready": { "type": "object" },
        "by_client_facing_status": { "type": "object" },
        "by_issue_type": { "type": "object" },
        "by_risk_severity": { "type": "object" },
        "by_paragraph_binding_status": { "type": "object" }
      }
    },
    "validation_item": {
      "type": "object",
      "required": ["validation_id", "path", "check_id", "status", "severity", "message"],
      "properties": {
        "validation_id": { "type": "string" },
        "path": { "type": "string" },
        "check_id": { "type": "string" },
        "status": { "enum": ["passed", "failed"] },
        "severity": { "enum": ["info", "error"] },
        "message": { "type": "string" }
      }
    },
    "validation_error": {
      "type": "object",
      "required": ["path", "message"],
      "properties": {
        "path": { "type": "string" },
        "message": { "type": "string" }
      }
    },
    "summary": {
      "type": "object",
      "required": [
        "citation_object_store_status",
        "citation_object_store_contract_id",
        "citation_schema_version",
        "output_paragraph_schema_version",
        "paragraph_source_binding_schema_version",
        "issue_graph_store_status",
        "issue_count",
        "output_paragraph_count",
        "citation_count",
        "paragraph_source_binding_count",
        "review_queue_item_count",
        "source_span_bound_citation_count",
        "issue_linked_citation_count",
        "paragraph_linked_citation_count",
        "fact_linked_citation_count",
        "evidence_linked_citation_count",
        "matter_preserved_citation_count",
        "classification_preserved_citation_count",
        "policy_snapshot_preserved_citation_count",
        "issue_link_preserved_citation_count",
        "needs_review_count",
        "approved_count",
        "client_facing_ready_count",
        "not_client_facing_paragraph_count",
        "validation_item_count",
        "failed_validation_item_count",
        "validation_error_count",
        "by_matter_id",
        "by_classification",
        "by_review_status",
        "by_citation_status",
        "by_verification_status",
        "by_source_binding_status"
      ],
      "properties": {
        "citation_object_store_status": { "enum": ["complete", "blocked"] },
        "citation_object_store_contract_id": { "const": "citation-object-store.v1" },
        "citation_schema_version": { "const": "citation.v2" },
        "output_paragraph_schema_version": { "const": "output-paragraph.v1" },
        "paragraph_source_binding_schema_version": { "const": "paragraph-source-binding.v1" },
        "issue_graph_store_status": { "type": "string" },
        "issue_count": { "type": "integer", "minimum": 0 },
        "output_paragraph_count": { "type": "integer", "minimum": 0 },
        "citation_count": { "type": "integer", "minimum": 0 },
        "paragraph_source_binding_count": { "type": "integer", "minimum": 0 },
        "review_queue_item_count": { "type": "integer", "minimum": 0 },
        "source_span_bound_citation_count": { "type": "integer", "minimum": 0 },
        "issue_linked_citation_count": { "type": "integer", "minimum": 0 },
        "paragraph_linked_citation_count": { "type": "integer", "minimum": 0 },
        "fact_linked_citation_count": { "type": "integer", "minimum": 0 },
        "evidence_linked_citation_count": { "type": "integer", "minimum": 0 },
        "matter_preserved_citation_count": { "type": "integer", "minimum": 0 },
        "classification_preserved_citation_count": { "type": "integer", "minimum": 0 },
        "policy_snapshot_preserved_citation_count": { "type": "integer", "minimum": 0 },
        "issue_link_preserved_citation_count": { "type": "integer", "minimum": 0 },
        "needs_review_count": { "type": "integer", "minimum": 0 },
        "approved_count": { "type": "integer", "minimum": 0 },
        "client_facing_ready_count": { "type": "integer", "minimum": 0 },
        "not_client_facing_paragraph_count": { "type": "integer", "minimum": 0 },
        "validation_item_count": { "type": "integer", "minimum": 0 },
        "failed_validation_item_count": { "type": "integer", "minimum": 0 },
        "validation_error_count": { "type": "integer", "minimum": 0 },
        "by_matter_id": { "type": "object" },
        "by_classification": { "type": "object" },
        "by_review_status": { "type": "object" },
        "by_citation_status": { "type": "object" },
        "by_verification_status": { "type": "object" },
        "by_source_binding_status": { "type": "object" }
      }
    }
  }
}
