{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/matter-privilege-classifier.schema.json",
  "title": "Hermes Matter Privilege Classifier",
  "type": "object",
  "required": [
    "schema_version",
    "generated_at",
    "matter_privilege_classifier_id",
    "matter_privilege_classifier_status",
    "safe_handling",
    "inputs",
    "source_contracts",
    "matter_privilege_classifier_contract",
    "privilege_classification_records",
    "privilege_evidence_flags",
    "matter_privilege_summaries",
    "matter_privilege_classifier_desktop_boundary",
    "matter_privilege_classifier_checkpoints",
    "validation_items",
    "validation",
    "summary"
  ],
  "properties": {
    "schema_version": { "const": "matter-privilege-classifier.v1" },
    "generated_at": { "type": "string", "minLength": 1 },
    "matter_privilege_classifier_id": { "type": "string", "minLength": 1 },
    "output_dir": { "type": "string" },
    "matter_privilege_classifier_status": { "enum": ["complete", "blocked"] },
    "safe_handling": { "$ref": "#/$defs/safe_handling" },
    "inputs": { "type": "object" },
    "source_contracts": { "type": "object" },
    "matter_privilege_classifier_contract": { "$ref": "#/$defs/contract" },
    "privilege_classification_records": { "type": "array", "items": { "$ref": "#/$defs/classification_record" } },
    "privilege_evidence_flags": { "type": "array", "items": { "$ref": "#/$defs/evidence_flag" } },
    "matter_privilege_summaries": { "type": "array", "items": { "$ref": "#/$defs/matter_summary" } },
    "matter_privilege_classifier_desktop_boundary": { "$ref": "#/$defs/desktop_boundary" },
    "matter_privilege_classifier_checkpoints": { "type": "array", "items": { "$ref": "#/$defs/checkpoint" } },
    "validation_items": { "type": "array", "items": { "$ref": "#/$defs/validation_item" } },
    "validation": { "$ref": "#/$defs/validation" },
    "summary": { "$ref": "#/$defs/summary" }
  },
  "$defs": {
    "safe_handling": {
      "type": "object",
      "required": [
        "report_only",
        "final_privilege_determination_made",
        "legal_advice_provided",
        "client_facing_output_generated",
        "attorney_review_required",
        "human_review_required",
        "matter_data_write_allowed",
        "task_state_write_allowed",
        "workflow_transition_allowed",
        "runtime_execution_performed",
        "delivery_execution_performed",
        "desktop_mutation_allowed",
        "desktop_source_of_truth",
        "protected_mutation_executed",
        "secret_material_exposed",
        "provider_key_visible"
      ],
      "properties": {
        "report_only": { "const": true },
        "final_privilege_determination_made": { "const": false },
        "legal_advice_provided": { "const": false },
        "client_facing_output_generated": { "const": false },
        "attorney_review_required": { "const": true },
        "human_review_required": { "const": true },
        "matter_data_write_allowed": { "const": false },
        "task_state_write_allowed": { "const": false },
        "workflow_transition_allowed": { "const": false },
        "runtime_execution_performed": { "const": false },
        "delivery_execution_performed": { "const": false },
        "desktop_mutation_allowed": { "const": false },
        "desktop_source_of_truth": { "const": false },
        "protected_mutation_executed": { "const": false },
        "secret_material_exposed": { "const": false },
        "provider_key_visible": { "const": false }
      }
    },
    "contract": {
      "type": "object",
      "required": [
        "schema_version",
        "contract_id",
        "source_of_truth",
        "classifier_rule",
        "evidence_rule",
        "privilege_rule",
        "matter_boundary_rule",
        "attorney_review_rule",
        "desktop_companion_rule",
        "mutation_policy",
        "created_at"
      ],
      "properties": {
        "schema_version": { "const": "matter-privilege-classifier-contract.v1" },
        "contract_id": { "const": "matter-privilege-classifier.v1" },
        "source_of_truth": { "const": "matter_knowledge_graph_document_index_task_board_and_matter_files" },
        "classifier_rule": { "type": "string" },
        "evidence_rule": { "type": "string" },
        "privilege_rule": { "type": "string" },
        "matter_boundary_rule": { "type": "string" },
        "attorney_review_rule": { "type": "string" },
        "desktop_companion_rule": { "type": "string" },
        "mutation_policy": { "type": "string" },
        "created_at": { "type": "string" }
      }
    },
    "classification_record": {
      "type": "object",
      "required": [
        "schema_version",
        "classification_record_id",
        "matter_id",
        "evidence_node_id",
        "evidence_label",
        "source_record_id",
        "privilege_flag",
        "work_product_flag",
        "confidentiality_flag",
        "external_transfer_flag",
        "classification_status",
        "review_status",
        "attorney_review_required",
        "human_review_required",
        "privilege_determination_final",
        "legal_advice_provided",
        "client_facing_output_generated",
        "matter_data_write_allowed",
        "task_state_write_allowed",
        "workflow_transition_allowed",
        "runtime_execution_allowed",
        "delivery_execution_allowed",
        "protected_action_allowed",
        "source_confidence",
        "rationale",
        "created_at",
        "sequence_number",
        "metadata"
      ],
      "properties": {
        "schema_version": { "const": "matter-privilege-classification-record.v1" },
        "classification_record_id": { "type": "string", "minLength": 1 },
        "matter_id": { "type": "string", "minLength": 1 },
        "evidence_node_id": { "type": "string", "minLength": 1 },
        "evidence_label": { "type": "string", "minLength": 1 },
        "evidence_status": { "type": "string" },
        "source_kind": { "type": "string" },
        "source_id": { "type": "string" },
        "source_path": { "type": ["string", "null"] },
        "source_record_id": { "type": "string", "minLength": 1 },
        "source_label": { "type": ["string", "null"] },
        "document_record_id": { "type": ["string", "null"] },
        "document_role": { "type": ["string", "null"] },
        "document_type": { "type": ["string", "null"] },
        "issue_key": { "type": ["string", "null"] },
        "confidentiality_level": { "type": "string" },
        "access_tier": { "type": "string" },
        "privilege_flag": { "enum": ["privileged_review_required", "client_confidential_review_required"] },
        "work_product_flag": { "enum": ["work_product_review_required", "no_work_product_signal_detected"] },
        "confidentiality_flag": { "enum": ["privileged_confidential", "restricted_confidential", "client_confidential"] },
        "external_transfer_flag": { "enum": ["external_transfer_blocked", "external_transfer_requires_approval"] },
        "classification_status": { "const": "candidate_review_required" },
        "review_status": { "const": "attorney_review_required" },
        "attorney_review_required": { "const": true },
        "human_review_required": { "const": true },
        "privilege_determination_final": { "const": false },
        "legal_advice_provided": { "const": false },
        "client_facing_output_generated": { "const": false },
        "matter_data_write_allowed": { "const": false },
        "task_state_write_allowed": { "const": false },
        "workflow_transition_allowed": { "const": false },
        "runtime_execution_allowed": { "const": false },
        "delivery_execution_allowed": { "const": false },
        "protected_action_allowed": { "const": false },
        "source_confidence": { "type": "string", "minLength": 1 },
        "rationale": { "type": "array", "items": { "type": "string" } },
        "created_at": { "type": "string" },
        "sequence_number": { "type": "integer", "minimum": 1 },
        "metadata": { "type": "object" }
      }
    },
    "evidence_flag": {
      "type": "object",
      "required": [
        "schema_version",
        "evidence_flag_id",
        "classification_record_id",
        "matter_id",
        "evidence_node_id",
        "flag_type",
        "flag_value",
        "flag_status",
        "review_status",
        "attorney_review_required",
        "human_review_required",
        "privilege_determination_final",
        "legal_advice_provided",
        "client_facing_output_generated",
        "external_transfer_allowed",
        "created_at",
        "sequence_number"
      ],
      "properties": {
        "schema_version": { "const": "matter-privilege-evidence-flag.v1" },
        "evidence_flag_id": { "type": "string", "minLength": 1 },
        "classification_record_id": { "type": "string", "minLength": 1 },
        "matter_id": { "type": "string", "minLength": 1 },
        "evidence_node_id": { "type": "string", "minLength": 1 },
        "flag_type": { "enum": ["privilege", "work_product", "confidentiality", "external_transfer"] },
        "flag_value": { "type": "string", "minLength": 1 },
        "flag_status": { "const": "candidate_review_required" },
        "review_status": { "const": "attorney_review_required" },
        "attorney_review_required": { "const": true },
        "human_review_required": { "const": true },
        "privilege_determination_final": { "const": false },
        "legal_advice_provided": { "const": false },
        "client_facing_output_generated": { "const": false },
        "external_transfer_allowed": { "const": false },
        "created_at": { "type": "string" },
        "sequence_number": { "type": "integer", "minimum": 1 }
      }
    },
    "matter_summary": {
      "type": "object",
      "required": [
        "schema_version",
        "matter_id",
        "matter_title",
        "matter_privilege_status",
        "classification_record_count",
        "privileged_review_required_count",
        "work_product_review_required_count",
        "confidential_flagged_evidence_count",
        "external_transfer_blocked_count",
        "attorney_review_required_count",
        "human_review_required_count",
        "final_privilege_determination_count",
        "legal_advice_provided",
        "client_facing_output_generated",
        "created_at"
      ],
      "properties": {
        "schema_version": { "const": "matter-privilege-summary.v1" },
        "matter_id": { "type": "string", "minLength": 1 },
        "matter_title": { "type": "string", "minLength": 1 },
        "matter_privilege_status": { "const": "complete" },
        "classification_record_count": { "type": "integer", "minimum": 1 },
        "privileged_review_required_count": { "type": "integer", "minimum": 0 },
        "work_product_review_required_count": { "type": "integer", "minimum": 0 },
        "confidential_flagged_evidence_count": { "type": "integer", "minimum": 1 },
        "external_transfer_blocked_count": { "type": "integer", "minimum": 0 },
        "attorney_review_required_count": { "type": "integer", "minimum": 1 },
        "human_review_required_count": { "type": "integer", "minimum": 1 },
        "final_privilege_determination_count": { "const": 0 },
        "legal_advice_provided": { "const": false },
        "client_facing_output_generated": { "const": false },
        "created_at": { "type": "string" }
      }
    },
    "desktop_boundary": {
      "type": "object",
      "required": [
        "schema_version",
        "boundary_status",
        "read_only",
        "mutation_allowed",
        "source_of_truth",
        "matter_data_write_allowed",
        "task_state_write_allowed",
        "workflow_transition_allowed",
        "runtime_execution_allowed",
        "delivery_execution_allowed",
        "protected_action_allowed",
        "legal_advice_allowed",
        "final_privilege_determination_allowed",
        "client_facing_output_allowed_without_attorney_review",
        "allowed_operations",
        "blocked_operations",
        "created_at"
      ],
      "properties": {
        "schema_version": { "const": "matter-privilege-classifier-desktop-boundary.v1" },
        "boundary_status": { "const": "enforced" },
        "read_only": { "const": true },
        "mutation_allowed": { "const": false },
        "source_of_truth": { "const": false },
        "matter_data_write_allowed": { "const": false },
        "task_state_write_allowed": { "const": false },
        "workflow_transition_allowed": { "const": false },
        "runtime_execution_allowed": { "const": false },
        "delivery_execution_allowed": { "const": false },
        "protected_action_allowed": { "const": false },
        "legal_advice_allowed": { "const": false },
        "final_privilege_determination_allowed": { "const": false },
        "client_facing_output_allowed_without_attorney_review": { "const": false },
        "allowed_operations": { "type": "array", "items": { "type": "string" } },
        "blocked_operations": { "type": "array", "items": { "type": "string" } },
        "created_at": { "type": "string" }
      }
    },
    "checkpoint": {
      "type": "object",
      "required": ["checkpoint_id", "checkpoint_status", "status", "message"],
      "properties": {
        "checkpoint_id": { "type": "string", "minLength": 1 },
        "checkpoint_status": { "enum": ["passed", "failed"] },
        "status": { "enum": ["passed", "failed"] },
        "message": { "type": "string" }
      }
    },
    "validation_item": {
      "type": "object",
      "required": ["path", "check_id", "status", "message"],
      "properties": {
        "path": { "type": "string" },
        "check_id": { "type": "string" },
        "status": { "enum": ["passed", "failed"] },
        "message": { "type": "string" }
      }
    },
    "validation": {
      "type": "object",
      "required": ["valid", "errors"],
      "properties": {
        "valid": { "type": "boolean" },
        "errors": { "type": "array" }
      }
    },
    "summary": {
      "type": "object",
      "required": [
        "matter_privilege_classifier_status",
        "matter_privilege_classifier_contract_id",
        "source_of_truth",
        "classification_record_count",
        "evidence_flag_count",
        "privileged_review_required_count",
        "work_product_review_required_count",
        "confidential_flagged_evidence_count",
        "final_privilege_determination_count",
        "legal_advice_provided",
        "client_facing_output_generated",
        "desktop_boundary_status",
        "desktop_read_only",
        "desktop_mutation_allowed",
        "matter_data_write_allowed",
        "task_state_write_allowed",
        "workflow_transition_allowed",
        "runtime_execution_allowed",
        "delivery_execution_allowed",
        "protected_action_allowed",
        "validation_error_count"
      ],
      "properties": {
        "matter_privilege_classifier_status": { "enum": ["complete", "blocked"] },
        "matter_privilege_classifier_contract_id": { "const": "matter-privilege-classifier.v1" },
        "source_of_truth": { "const": "matter_knowledge_graph_document_index_task_board_and_matter_files" },
        "classification_record_count": { "type": "integer", "minimum": 0 },
        "evidence_flag_count": { "type": "integer", "minimum": 0 },
        "privileged_review_required_count": { "type": "integer", "minimum": 0 },
        "work_product_review_required_count": { "type": "integer", "minimum": 0 },
        "confidential_flagged_evidence_count": { "type": "integer", "minimum": 0 },
        "final_privilege_determination_count": { "const": 0 },
        "legal_advice_provided": { "const": false },
        "client_facing_output_generated": { "const": false },
        "desktop_boundary_status": { "type": "string" },
        "desktop_read_only": { "type": "boolean" },
        "desktop_mutation_allowed": { "type": "boolean" },
        "matter_data_write_allowed": { "type": "boolean" },
        "task_state_write_allowed": { "type": "boolean" },
        "workflow_transition_allowed": { "type": "boolean" },
        "runtime_execution_allowed": { "type": "boolean" },
        "delivery_execution_allowed": { "type": "boolean" },
        "protected_action_allowed": { "type": "boolean" },
        "validation_error_count": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
