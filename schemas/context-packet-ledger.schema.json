{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://amic.local/hermes/context-packet-ledger.schema.json",
  "title": "Hermes Context Packet Ledger",
  "type": "object",
  "required": [
    "schema_version",
    "generated_at",
    "ledger_id",
    "output_dir",
    "domain_pack_registry_path",
    "runtime_adapters_path",
    "policy_snapshot_ledger_path",
    "ledger_status",
    "summary",
    "sources",
    "context_packets",
    "context_items",
    "retrieval_filters",
    "validation"
  ],
  "properties": {
    "schema_version": { "const": "context-packet-ledger.v1" },
    "generated_at": { "type": "string", "format": "date-time" },
    "ledger_id": { "type": "string" },
    "output_dir": { "type": "string" },
    "domain_pack_registry_path": { "type": "string" },
    "runtime_adapters_path": { "type": "string" },
    "policy_snapshot_ledger_path": { "type": "string" },
    "ledger_status": { "enum": ["valid", "blocked"] },
    "summary": {
      "type": "object",
      "required": [
        "source_count",
        "available_source_count",
        "missing_source_count",
        "context_packet_count",
        "ready_packet_count",
        "blocked_packet_count",
        "redacted_packet_count",
        "raw_packet_count",
        "context_item_count",
        "redacted_item_count",
        "retrieval_filter_count",
        "missing_filter_count",
        "runtime_mismatch_count",
        "classification_blocked_count",
        "redaction_required_count",
        "prompt_injection_protected_count",
        "validation_error_count",
        "by_source",
        "by_runtime_id",
        "by_context_mode",
        "by_packet_status",
        "by_classification",
        "by_item_type"
      ],
      "properties": {
        "source_count": { "type": "integer", "minimum": 0 },
        "available_source_count": { "type": "integer", "minimum": 0 },
        "missing_source_count": { "type": "integer", "minimum": 0 },
        "context_packet_count": { "type": "integer", "minimum": 0 },
        "ready_packet_count": { "type": "integer", "minimum": 0 },
        "blocked_packet_count": { "type": "integer", "minimum": 0 },
        "redacted_packet_count": { "type": "integer", "minimum": 0 },
        "raw_packet_count": { "type": "integer", "minimum": 0 },
        "context_item_count": { "type": "integer", "minimum": 0 },
        "redacted_item_count": { "type": "integer", "minimum": 0 },
        "retrieval_filter_count": { "type": "integer", "minimum": 0 },
        "missing_filter_count": { "type": "integer", "minimum": 0 },
        "runtime_mismatch_count": { "type": "integer", "minimum": 0 },
        "classification_blocked_count": { "type": "integer", "minimum": 0 },
        "redaction_required_count": { "type": "integer", "minimum": 0 },
        "prompt_injection_data_handling_count": { "type": "integer", "minimum": 0 },
        "prompt_injection_protected_count": { "type": "integer", "minimum": 0 },
        "validation_error_count": { "type": "integer", "minimum": 0 },
        "by_source": { "type": "object" },
        "by_runtime_id": { "type": "object" },
        "by_context_mode": { "type": "object" },
        "by_packet_status": { "type": "object" },
        "by_classification": { "type": "object" },
        "by_item_type": { "type": "object" }
      }
    },
    "sources": { "type": "array", "items": { "$ref": "#/$defs/source" } },
    "context_packets": { "type": "array", "items": { "$ref": "#/$defs/context_packet" } },
    "context_items": { "type": "array", "items": { "$ref": "#/$defs/context_item" } },
    "retrieval_filters": { "type": "array", "items": { "$ref": "#/$defs/retrieval_filter" } },
    "validation": { "$ref": "#/$defs/validation" }
  },
  "$defs": {
    "source": {
      "type": "object",
      "required": [
        "source_id",
        "label",
        "slice_path",
        "available",
        "schema_version",
        "generated_at",
        "workflow_run_count",
        "agent_run_count",
        "resource_count",
        "evidence_count",
        "error"
      ],
      "properties": {
        "source_id": { "type": "string" },
        "label": { "type": "string" },
        "slice_path": { "type": "string" },
        "available": { "type": "boolean" },
        "schema_version": { "type": ["string", "null"] },
        "generated_at": { "type": ["string", "null"] },
        "workflow_run_count": { "type": "integer", "minimum": 0 },
        "agent_run_count": { "type": "integer", "minimum": 0 },
        "resource_count": { "type": "integer", "minimum": 0 },
        "evidence_count": { "type": "integer", "minimum": 0 },
        "error": { "type": ["string", "null"] }
      }
    },
    "context_packet": {
      "type": "object",
      "required": [
        "context_packet_id",
        "source_id",
        "workflow_run_id",
        "agent_run_id",
        "runtime_id",
        "capability_id",
        "domain_pack",
        "tenant_id",
        "matter_id",
        "client_id",
        "wall_ids",
        "policy_snapshot_id",
        "packet_status",
        "context_mode",
        "max_classification",
        "classification_allowed",
        "runtime_allowed_by_capability",
        "redaction_required",
        "redaction_applied",
        "prompt_injection_handling",
        "required_filter_keys",
        "missing_filter_keys",
        "included_context_types",
        "excluded_context_types",
        "context_item_count",
        "context_item_ids",
        "blocker_count",
        "blockers",
        "metadata"
      ],
      "properties": {
        "context_packet_id": { "type": "string" },
        "source_id": { "type": "string" },
        "source_label": { "type": "string" },
        "workflow_run_id": { "type": "string" },
        "agent_run_id": { "type": "string" },
        "runtime_id": { "type": "string" },
        "capability_id": { "type": "string" },
        "domain_pack": { "type": "string" },
        "tenant_id": { "type": "string" },
        "matter_id": { "type": "string" },
        "client_id": { "type": ["string", "null"] },
        "wall_ids": { "type": "array", "items": { "type": "string" } },
        "policy_snapshot_id": { "type": "string" },
        "policy_snapshot_declared": { "type": "boolean" },
        "packet_status": { "enum": ["ready", "blocked"] },
        "context_mode": { "enum": ["raw", "redacted", "metadata_only", "blocked"] },
        "max_classification": { "type": "string" },
        "classification_allowed": { "type": "boolean" },
        "runtime_allowed_by_capability": { "type": "boolean" },
        "redaction_required": { "type": "boolean" },
        "redaction_applied": { "type": "boolean" },
        "prompt_injection_handling": { "type": "string" },
        "required_filter_keys": { "type": "array", "items": { "type": "string" } },
        "missing_filter_keys": { "type": "array", "items": { "type": "string" } },
        "included_context_types": { "type": "array", "items": { "type": "string" } },
        "excluded_context_types": { "type": "array", "items": { "type": "string" } },
        "context_item_count": { "type": "integer", "minimum": 0 },
        "context_item_ids": { "type": "array", "items": { "type": "string" } },
        "blocker_count": { "type": "integer", "minimum": 0 },
        "blockers": { "type": "array", "items": { "type": "string" } },
        "metadata": { "type": "object" }
      }
    },
    "context_item": {
      "type": "object",
      "required": [
        "context_item_id",
        "context_packet_id",
        "item_type",
        "source_ref_type",
        "source_ref_id",
        "resource_id",
        "matter_id",
        "classification",
        "content_mode",
        "redaction_applied",
        "content_hash",
        "preview",
        "metadata"
      ],
      "properties": {
        "context_item_id": { "type": "string" },
        "context_packet_id": { "type": "string" },
        "item_type": { "type": "string" },
        "source_ref_type": { "type": "string" },
        "source_ref_id": { "type": "string" },
        "resource_id": { "type": ["string", "null"] },
        "matter_id": { "type": ["string", "null"] },
        "classification": { "type": ["string", "null"] },
        "content_mode": { "type": "string" },
        "redaction_applied": { "type": "boolean" },
        "content_hash": { "type": "string" },
        "preview": { "type": "string" },
        "metadata": { "type": "object" }
      }
    },
    "retrieval_filter": {
      "type": "object",
      "required": [
        "retrieval_filter_id",
        "context_packet_id",
        "source_id",
        "workflow_run_id",
        "agent_run_id",
        "runtime_id",
        "required_filter_keys",
        "missing_filter_keys",
        "filter_values",
        "filter_status"
      ],
      "properties": {
        "retrieval_filter_id": { "type": "string" },
        "context_packet_id": { "type": "string" },
        "source_id": { "type": "string" },
        "workflow_run_id": { "type": "string" },
        "agent_run_id": { "type": "string" },
        "runtime_id": { "type": "string" },
        "required_filter_keys": { "type": "array", "items": { "type": "string" } },
        "missing_filter_keys": { "type": "array", "items": { "type": "string" } },
        "filter_values": { "type": "object" },
        "filter_status": { "enum": ["complete", "missing_required_filter"] }
      }
    },
    "validation": {
      "type": "object",
      "required": ["valid", "errors"],
      "properties": {
        "valid": { "type": "boolean" },
        "errors": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["path", "message"],
            "properties": {
              "path": { "type": "string" },
              "message": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
