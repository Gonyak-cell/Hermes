{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hermes.local/schemas/validation-receipt-candidate-queue.schema.json",
  "title": "Hermes Validation Receipt Candidate Queue",
  "type": "object",
  "required": [
    "schema_version",
    "generated_at",
    "capability_id",
    "program_range",
    "source_program_range",
    "validation_receipt_candidate_queue_phase_rows",
    "p21600_source_binding_rows",
    "receipt_candidate_metadata_rows",
    "result_digest_redaction_index_rows",
    "acceptance_decision_matrix_rows",
    "operator_verification_index_rows",
    "no_finality_boundary_rows",
    "p22000_clean_checkpoint_rows",
    "validation_receipt_candidate_queue_boundary",
    "validation_receipt_candidate_queue_validation_items",
    "summary",
    "validation"
  ],
  "properties": {
    "schema_version": { "const": "validation-receipt-candidate-queue.v1" },
    "generated_at": { "type": "string", "format": "date-time" },
    "capability_id": { "const": "platform.validation_receipt_candidate_queue" },
    "program_range": { "const": "P21601-P22000" },
    "source_program_range": { "const": "P21201-P21600" },
    "validation_receipt_candidate_queue_phase_rows": { "type": "array", "minItems": 7, "items": { "$ref": "#/$defs/verdictRow" } },
    "p21600_source_binding_rows": { "type": "array", "minItems": 12, "items": { "$ref": "#/$defs/verdictRow" } },
    "receipt_candidate_metadata_rows": { "type": "array", "minItems": 7, "items": { "$ref": "#/$defs/verdictRow" } },
    "result_digest_redaction_index_rows": { "type": "array", "minItems": 7, "items": { "$ref": "#/$defs/verdictRow" } },
    "acceptance_decision_matrix_rows": { "type": "array", "minItems": 7, "items": { "$ref": "#/$defs/verdictRow" } },
    "operator_verification_index_rows": { "type": "array", "minItems": 8, "items": { "$ref": "#/$defs/verdictRow" } },
    "no_finality_boundary_rows": { "type": "array", "minItems": 26, "items": { "$ref": "#/$defs/verdictRow" } },
    "p22000_clean_checkpoint_rows": { "type": "array", "minItems": 8, "items": { "$ref": "#/$defs/verdictRow" } },
    "validation_receipt_candidate_queue_validation_items": { "type": "array", "minItems": 12, "items": { "$ref": "#/$defs/validationItem" } },
    "summary": {
      "type": "object",
      "required": [
        "validation_receipt_candidate_queue_status",
        "source_p21600_ready_for_p21601_handoff",
        "candidate_slot_count",
        "candidate_present_count",
        "accepted_candidate_count",
        "missing_candidate_count",
        "ready_for_p22001_handoff",
        "final_automated_approval_allowed",
        "production_pass_enabled"
      ],
      "properties": {
        "validation_receipt_candidate_queue_status": {
          "enum": [
            "ready_for_validation_receipt_candidate_queue",
            "valid_block_validation_receipt_candidate_queue_pending",
            "blocked_validation_receipt_candidate_queue"
          ]
        },
        "source_p21600_ready_for_p21601_handoff": { "type": "boolean" },
        "candidate_slot_count": { "type": "number" },
        "candidate_present_count": { "type": "number" },
        "accepted_candidate_count": { "type": "number" },
        "missing_candidate_count": { "type": "number" },
        "ready_for_p22001_handoff": { "type": "boolean" },
        "final_automated_approval_allowed": { "const": false },
        "production_pass_enabled": { "const": false },
        "enterprise_trust_claim_allowed_now": { "const": false },
        "validation_error_count": { "type": "number" }
      }
    },
    "validation_receipt_candidate_queue_boundary": {
      "type": "object",
      "required": [
        "p22000_contract_ready",
        "ready_for_p22001_handoff",
        "source_p21600_ready_for_p21601_handoff",
        "source_validation_valid_now",
        "candidate_queue_visible_now",
        "digest_redaction_index_visible_now",
        "acceptance_decision_matrix_visible_now",
        "operator_verification_index_visible_now",
        "no_finality_boundary_closed_now",
        "candidate_slot_count",
        "candidate_present_count",
        "accepted_candidate_count",
        "missing_candidate_count",
        "digest_index_count",
        "acceptance_matrix_count",
        "operator_verification_index_count",
        "command_execution_allowed_now",
        "raw_stdout_capture_allowed_now",
        "raw_stderr_capture_allowed_now",
        "raw_secret_material_allowed_now",
        "receipt_completion_claim_allowed_now",
        "receipt_candidate_auto_accept_allowed_now",
        "verifier_finality_allowed_now",
        "operator_merge_allowed_now",
        "deployment_allowed_now",
        "release_approval_allowed_now",
        "production_pass_enabled",
        "enterprise_pass_enabled",
        "enterprise_trust_claim_allowed_now",
        "protected_closeout_enabled",
        "human_gate_bypass_allowed_now",
        "independent_review_bypass_allowed_now",
        "single_owner_enterprise_trust_allowed_now",
        "runtime_execution_allowed_now",
        "write_action_allowed_now",
        "protected_action_allowed_now",
        "connector_write_enabled",
        "external_service_mutation_allowed_now",
        "raw_source_exposure_allowed",
        "secret_read_allowed_now",
        "reviewer_mutation_allowed_now",
        "final_automated_approval_allowed"
      ],
      "properties": {
        "p22000_contract_ready": { "type": "boolean" },
        "ready_for_p22001_handoff": { "type": "boolean" },
        "source_p21600_ready_for_p21601_handoff": { "type": "boolean" },
        "source_validation_valid_now": { "type": "boolean" },
        "candidate_queue_visible_now": { "type": "boolean" },
        "digest_redaction_index_visible_now": { "type": "boolean" },
        "acceptance_decision_matrix_visible_now": { "type": "boolean" },
        "operator_verification_index_visible_now": { "type": "boolean" },
        "no_finality_boundary_closed_now": { "type": "boolean" },
        "candidate_slot_count": { "type": "number" },
        "candidate_present_count": { "type": "number" },
        "accepted_candidate_count": { "type": "number" },
        "missing_candidate_count": { "type": "number" },
        "digest_index_count": { "type": "number" },
        "acceptance_matrix_count": { "type": "number" },
        "operator_verification_index_count": { "type": "number" },
        "command_execution_allowed_now": { "const": false },
        "raw_stdout_capture_allowed_now": { "const": false },
        "raw_stderr_capture_allowed_now": { "const": false },
        "raw_secret_material_allowed_now": { "const": false },
        "receipt_completion_claim_allowed_now": { "const": false },
        "receipt_candidate_auto_accept_allowed_now": { "const": false },
        "verifier_finality_allowed_now": { "const": false },
        "operator_merge_allowed_now": { "const": false },
        "deployment_allowed_now": { "const": false },
        "release_approval_allowed_now": { "const": false },
        "production_pass_enabled": { "const": false },
        "enterprise_pass_enabled": { "const": false },
        "enterprise_trust_claim_allowed_now": { "const": false },
        "protected_closeout_enabled": { "const": false },
        "human_gate_bypass_allowed_now": { "const": false },
        "independent_review_bypass_allowed_now": { "const": false },
        "single_owner_enterprise_trust_allowed_now": { "const": false },
        "runtime_execution_allowed_now": { "const": false },
        "write_action_allowed_now": { "const": false },
        "protected_action_allowed_now": { "const": false },
        "connector_write_enabled": { "const": false },
        "external_service_mutation_allowed_now": { "const": false },
        "raw_source_exposure_allowed": { "const": false },
        "secret_read_allowed_now": { "const": false },
        "reviewer_mutation_allowed_now": { "const": false },
        "final_automated_approval_allowed": { "const": false }
      }
    },
    "validation": {
      "type": "object",
      "required": ["valid", "error_count", "errors"],
      "properties": {
        "valid": { "type": "boolean" },
        "error_count": { "type": "number" },
        "errors": { "type": "array" }
      }
    }
  },
  "$defs": {
    "verdictRow": {
      "type": "object",
      "required": [
        "row_id",
        "category",
        "label",
        "observed",
        "current_verdict",
        "block_reason",
        "evidence_ref",
        "generated_at"
      ],
      "properties": {
        "row_id": { "type": "string", "minLength": 1 },
        "category": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "observed": { "type": "boolean" },
        "current_verdict": { "enum": ["pass", "blocked"] },
        "block_reason": { "type": ["string", "null"] },
        "evidence_ref": { "type": "string", "minLength": 1 },
        "generated_at": { "type": "string", "format": "date-time" }
      }
    },
    "validationItem": {
      "type": "object",
      "required": ["item_id", "category", "passed", "message", "evidence_ref"],
      "properties": {
        "item_id": { "type": "string", "minLength": 1 },
        "category": { "type": "string", "minLength": 1 },
        "passed": { "type": "boolean" },
        "message": { "type": "string" },
        "evidence_ref": { "type": "string", "minLength": 1 }
      }
    }
  }
}
