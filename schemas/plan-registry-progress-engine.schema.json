{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hermes.local/schemas/plan-registry-progress-engine.schema.json",
  "title": "Plan Registry Progress Engine",
  "type": "object",
  "required": [
    "schema_version",
    "generated_at",
    "plan_registry_progress_engine_id",
    "capability_id",
    "program_range",
    "source_program_range",
    "inputs",
    "source_conversation_capture_summary",
    "plan_registry_progress_contract",
    "plan_registry_progress_phase_rows",
    "long_term_plan_registry_rows",
    "phase_progress_rows",
    "progress_status_calculation_rows",
    "validation_gate_review_link_rows",
    "stale_context_drift_rows",
    "plan_progress_negative_fixture_rows",
    "plan_progress_gate_rows",
    "plan_progress_boundary",
    "validation_items",
    "validation",
    "summary"
  ],
  "properties": {
    "schema_version": { "const": "plan-registry-progress-engine.v1" },
    "capability_id": { "const": "platform.plan_registry_progress_engine" },
    "program_range": { "const": "P8161-P8240" },
    "source_program_range": { "const": "P8081-P8160" },
    "plan_registry_progress_contract": {
      "type": "object",
      "required": [
        "schema_version",
        "program_range",
        "source_program_range",
        "required_plan_fields",
        "phase_status_enum",
        "validator_evidence_review_refs_required",
        "stale_plan_visible",
        "missing_conversation_visible",
        "validation_not_run_visible",
        "context_drift_visible",
        "codex_primary_engine_lane",
        "claude_review_lane",
        "harness_validation_lane",
        "human_gate_in_scope",
        "production_pass_enabled",
        "enterprise_pass_enabled",
        "protected_closeout_enabled",
        "runtime_execution_enabled",
        "write_action_enabled"
      ],
      "properties": {
        "schema_version": { "const": "plan-registry-progress-contract.v1" },
        "program_range": { "const": "P8161-P8240" },
        "source_program_range": { "const": "P8081-P8160" },
        "required_plan_fields": { "type": "array", "minItems": 5 },
        "phase_status_enum": { "type": "array", "minItems": 5 },
        "validator_evidence_review_refs_required": { "const": true },
        "stale_plan_visible": { "const": true },
        "missing_conversation_visible": { "const": true },
        "validation_not_run_visible": { "const": true },
        "context_drift_visible": { "const": true },
        "codex_primary_engine_lane": { "const": true },
        "claude_review_lane": { "const": true },
        "harness_validation_lane": { "const": true },
        "human_gate_in_scope": { "const": false },
        "production_pass_enabled": { "const": false },
        "enterprise_pass_enabled": { "const": false },
        "protected_closeout_enabled": { "const": false },
        "runtime_execution_enabled": { "const": false },
        "write_action_enabled": { "const": false }
      },
      "additionalProperties": true
    },
    "plan_registry_progress_phase_rows": { "type": "array", "minItems": 4, "items": { "$ref": "#/$defs/row" } },
    "long_term_plan_registry_rows": { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/row" } },
    "phase_progress_rows": { "type": "array", "minItems": 7, "items": { "$ref": "#/$defs/row" } },
    "progress_status_calculation_rows": { "type": "array", "minItems": 5, "items": { "$ref": "#/$defs/row" } },
    "validation_gate_review_link_rows": { "type": "array", "minItems": 7, "items": { "$ref": "#/$defs/row" } },
    "stale_context_drift_rows": { "type": "array", "minItems": 5, "items": { "$ref": "#/$defs/row" } },
    "plan_progress_negative_fixture_rows": { "type": "array", "minItems": 8, "items": { "$ref": "#/$defs/row" } },
    "plan_progress_gate_rows": { "type": "array", "minItems": 16, "items": { "$ref": "#/$defs/row" } },
    "plan_progress_boundary": {
      "type": "object",
      "required": [
        "schema_version",
        "program_range",
        "source_program_range",
        "source_conversation_capture_ready",
        "plan_registry_progress_engine_ready",
        "plan_registry_ready",
        "phase_progress_ready",
        "all_statuses_visible",
        "validation_gate_review_links_ready",
        "stale_context_drift_visible",
        "ready_for_work_os_ui_v0_handoff",
        "human_gate_in_scope",
        "production_pass_enabled",
        "enterprise_pass_enabled",
        "protected_closeout_enabled",
        "runtime_execution_enabled",
        "write_action_enabled",
        "unsafe_flag_count"
      ],
      "properties": {
        "schema_version": { "const": "plan-progress-boundary.v1" },
        "program_range": { "const": "P8161-P8240" },
        "source_program_range": { "const": "P8081-P8160" },
        "source_conversation_capture_ready": { "type": "boolean" },
        "plan_registry_progress_engine_ready": { "type": "boolean" },
        "plan_registry_ready": { "type": "boolean" },
        "phase_progress_ready": { "type": "boolean" },
        "all_statuses_visible": { "type": "boolean" },
        "validation_gate_review_links_ready": { "type": "boolean" },
        "stale_context_drift_visible": { "type": "boolean" },
        "ready_for_work_os_ui_v0_handoff": { "type": "boolean" },
        "human_gate_in_scope": { "const": false },
        "production_pass_enabled": { "const": false },
        "enterprise_pass_enabled": { "const": false },
        "protected_closeout_enabled": { "const": false },
        "runtime_execution_enabled": { "const": false },
        "write_action_enabled": { "const": false },
        "unsafe_flag_count": { "type": "number", "minimum": 0 }
      },
      "additionalProperties": true
    },
    "summary": {
      "type": "object",
      "required": [
        "schema_version",
        "plan_registry_progress_engine_status",
        "program_range",
        "source_program_range",
        "source_conversation_capture_ready",
        "plan_registry_count",
        "phase_progress_count",
        "status_enum",
        "validation_gate_review_link_count",
        "stale_context_drift_count",
        "ready_for_work_os_ui_v0_handoff",
        "human_gate_in_scope",
        "production_pass_enabled",
        "enterprise_pass_enabled",
        "protected_closeout_enabled",
        "runtime_execution_enabled",
        "write_action_enabled",
        "unsafe_flag_count",
        "validation_error_count"
      ],
      "properties": {
        "schema_version": { "const": "plan-registry-progress-engine-summary.v1" },
        "plan_registry_progress_engine_status": {
          "enum": ["ready_for_plan_registry_progress_engine", "blocked"]
        },
        "program_range": { "const": "P8161-P8240" },
        "source_program_range": { "const": "P8081-P8160" },
        "source_conversation_capture_ready": { "type": "boolean" },
        "plan_registry_count": { "type": "number", "minimum": 2 },
        "phase_progress_count": { "type": "number", "minimum": 7 },
        "status_enum": { "type": "array", "minItems": 5 },
        "validation_gate_review_link_count": { "type": "number", "minimum": 7 },
        "stale_context_drift_count": { "type": "number", "minimum": 5 },
        "ready_for_work_os_ui_v0_handoff": { "type": "boolean" },
        "human_gate_in_scope": { "const": false },
        "production_pass_enabled": { "const": false },
        "enterprise_pass_enabled": { "const": false },
        "protected_closeout_enabled": { "const": false },
        "runtime_execution_enabled": { "const": false },
        "write_action_enabled": { "const": false },
        "unsafe_flag_count": { "type": "number", "minimum": 0 },
        "validation_error_count": { "type": "number", "minimum": 0 }
      },
      "additionalProperties": true
    },
    "validation": {
      "type": "object",
      "required": ["valid", "item_count", "error_count", "errors"],
      "properties": {
        "valid": { "type": "boolean" },
        "item_count": { "type": "number", "minimum": 1 },
        "error_count": { "type": "number", "minimum": 0 },
        "errors": { "type": "array" }
      },
      "additionalProperties": true
    }
  },
  "$defs": {
    "row": {
      "type": "object",
      "required": ["schema_version", "row_id"],
      "properties": {
        "schema_version": { "type": "string", "minLength": 1 },
        "row_id": { "type": "string", "minLength": 1 },
        "current_verdict": { "enum": ["pass", "blocked"] },
        "unsafe_flags_false": { "type": "boolean" },
        "verdict_authority": { "type": "string" }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
