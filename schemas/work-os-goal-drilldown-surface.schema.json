    "browser_drilldown_smoke_rows": { "type": "array", "minItems": 6, "items": { "$ref": "#/$defs/browserSmokeRow" } },
    "work_os_goal_drilldown_negative_fixture_rows": {
      "type": "array",
      "minItems": 11,
      "items": {
        "allOf": [
          { "$ref": "#/$defs/row" },
          {
            "type": "object",
            "required": ["fixture_id", "expected_blocked", "observed_blocked", "unsafe_claim_allowed"],
            "properties": {
              "expected_blocked": { "const": true },
              "observed_blocked": { "const": true },
              "unsafe_claim_allowed": { "const": false }
            },
            "additionalProperties": true
          }
        ]
      }
    },
    "p9400_freeze_rows": { "type": "array", "minItems": 13, "items": { "$ref": "#/$defs/row" } },
    "work_os_goal_drilldown_gate_rows": { "type": "array", "minItems": 20, "items": { "$ref": "#/$defs/row" } },
