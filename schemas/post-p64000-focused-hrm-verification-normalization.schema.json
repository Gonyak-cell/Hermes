        "normalized_capture_ready_now",
        "recommendations_pending_only_now",
        "focused_review_completed_now",
        "finding_status_fixed_allowed_now",
        "finding_status_verified_allowed_now",
        "finding_status_resolved_allowed_now",
        "ready_for_p69201_handoff",
        "clean_checkpoint_allowed_now",
        "production_pass_enabled",
        "enterprise_pass_enabled",
        "final_approval_enabled"
