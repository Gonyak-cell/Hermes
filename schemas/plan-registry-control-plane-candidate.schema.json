{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hermes.local/schemas/plan-registry-control-plane-candidate.schema.json",
  "title": "Hermes Plan Registry Control-Plane Candidate",
  "type": "object",
  "required": [
    "schema_version",
    "generated_at",
    "capability_id",
    "program_range",
    "source_program_range",
    "plan_registry_control_plane_phase_rows",
    "p35200_source_binding_rows",
    "plan_registry_control_plane_candidate_rows",
    "goal_phase_manifest_binding_candidate_rows",
    "project_workflow_registration_candidate_rows",
    "registry_blocker_ledger_rows",
    "operator_plan_registry_projection_rows",
    "no_registry_mutation_boundary_rows",
    "plan_registry_control_plane_wiring_rows",
    "p35600_clean_checkpoint_rows",
    "plan_registry_control_plane_boundary",
    "plan_registry_control_plane_validation_items",
    "summary",
    "validation"
  ],
  "properties": {
    "schema_version": { "const": "plan-registry-control-plane-candidate.v1" },
    "generated_at": { "type": "string", "format": "date-time" },
    "capability_id": { "const": "platform.plan_registry_control_plane_candidate" },
    "program_range": { "const": "P35201-P35600" },
    "source_program_range": { "const": "P34801-P35200" },
    "plan_registry_control_plane_phase_rows": { "type": "array", "minItems": 8, "items": { "$ref": "#/$defs/verdictRow" } },
    "p35200_source_binding_rows": { "type": "array", "minItems": 12, "items": { "$ref": "#/$defs/verdictRow" } },
    "plan_registry_control_plane_candidate_rows": { "type": "array", "minItems": 3, "items": { "$ref": "#/$defs/verdictRow" } },
    "goal_phase_manifest_binding_candidate_rows": { "type": "array", "minItems": 3, "items": { "$ref": "#/$defs/verdictRow" } },
    "project_workflow_registration_candidate_rows": { "type": "array", "minItems": 3, "items": { "$ref": "#/$defs/verdictRow" } },
    "registry_blocker_ledger_rows": { "type": "array", "minItems": 12, "items": { "$ref": "#/$defs/verdictRow" } },
    "operator_plan_registry_projection_rows": { "type": "array", "minItems": 3, "items": { "$ref": "#/$defs/verdictRow" } },
    "no_registry_mutation_boundary_rows": { "type": "array", "minItems": 340, "items": { "$ref": "#/$defs/verdictRow" } },
    "plan_registry_control_plane_wiring_rows": { "type": "array", "minItems": 5, "items": { "$ref": "#/$defs/verdictRow" } },
    "p35600_clean_checkpoint_rows": { "type": "array", "minItems": 10, "items": { "$ref": "#/$defs/verdictRow" } },
    "plan_registry_control_plane_validation_items": { "type": "array", "minItems": 15, "items": { "$ref": "#/$defs/validationItem" } },
    "summary": {
      "type": "object",
      "required": [
        "plan_registry_control_plane_status",
        "source_p35200_ready_for_plan_registry",
        "plan_registry_control_plane_candidate_count",
        "goal_phase_manifest_binding_candidate_count",
        "project_workflow_registration_candidate_count",
        "blocker_count",
        "operator_projection_count",
        "registry_mutation_allowed_count",
        "workflow_registration_allowed_count",
        "goal_phase_create_allowed_count",
        "ready_for_work_os_plan_state_handoff",
        "plan_registry_actual_record_create_allowed_now",
        "plan_registry_mutation_allowed_now",
        "plan_registry_goal_create_allowed_now",
        "plan_registry_phase_create_allowed_now",
        "plan_registry_workflow_registration_allowed_now",
        "plan_registry_runtime_execution_allowed_now",
        "plan_registry_write_action_allowed_now",
        "plan_registry_protected_action_allowed_now",
        "plan_registry_final_approval_allowed_now",
        "plan_registry_production_pass_allowed_now",
        "production_pass_enabled"
      ],
      "properties": {
        "plan_registry_control_plane_status": {
          "enum": [
            "ready_for_plan_registry_control_plane_candidate",
            "valid_block_plan_registry_control_plane_candidate_pending",
            "blocked_plan_registry_control_plane_candidate"
          ]
        },
        "source_p35200_ready_for_plan_registry": { "type": "boolean" },
        "plan_registry_control_plane_candidate_count": { "type": "number" },
        "goal_phase_manifest_binding_candidate_count": { "type": "number" },
        "project_workflow_registration_candidate_count": { "type": "number" },
        "blocker_count": { "type": "number" },
        "operator_projection_count": { "type": "number" },
        "registry_mutation_allowed_count": { "const": 0 },
        "workflow_registration_allowed_count": { "const": 0 },
        "goal_phase_create_allowed_count": { "const": 0 },
        "ready_for_work_os_plan_state_handoff": { "type": "boolean" },
        "plan_registry_actual_record_create_allowed_now": { "const": false },
        "plan_registry_mutation_allowed_now": { "const": false },
        "plan_registry_goal_create_allowed_now": { "const": false },
        "plan_registry_phase_create_allowed_now": { "const": false },
        "plan_registry_workflow_registration_allowed_now": { "const": false },
        "plan_registry_runtime_execution_allowed_now": { "const": false },
        "plan_registry_write_action_allowed_now": { "const": false },
        "plan_registry_protected_action_allowed_now": { "const": false },
        "plan_registry_final_approval_allowed_now": { "const": false },
        "plan_registry_production_pass_allowed_now": { "const": false },
        "production_pass_enabled": { "const": false },
        "enterprise_trust_claim_allowed_now": { "const": false },
        "validation_error_count": { "type": "number" }
      }
    },
    "plan_registry_control_plane_boundary": {
      "type": "object",
      "required": [
        "p35600_contract_ready",
        "ready_for_work_os_plan_state_handoff",
        "source_p35200_ready_for_plan_registry",
        "plan_registry_control_plane_candidate_visible_now",
        "goal_phase_manifest_binding_candidate_visible_now",
        "project_workflow_registration_candidate_visible_now",
        "registry_blocker_ledger_visible_now",
        "operator_plan_registry_projection_visible_now",
        "no_registry_mutation_boundary_closed_now",
        "plan_registry_control_plane_wiring_complete_now",
        "registry_mutation_allowed_count",
        "workflow_registration_allowed_count",
        "goal_phase_create_allowed_count",
        "plan_registry_actual_record_create_allowed_now",
        "plan_registry_mutation_allowed_now",
        "plan_registry_goal_create_allowed_now",
        "plan_registry_phase_create_allowed_now",
        "plan_registry_workflow_registration_allowed_now",
        "plan_registry_final_approval_allowed_now",
        "plan_registry_production_pass_allowed_now"
      ],
      "properties": {
        "p35600_contract_ready": { "type": "boolean" },
        "ready_for_work_os_plan_state_handoff": { "type": "boolean" },
        "source_p35200_ready_for_plan_registry": { "type": "boolean" },
        "source_validation_valid_now": { "type": "boolean" },
        "plan_registry_control_plane_candidate_visible_now": { "type": "boolean" },
        "goal_phase_manifest_binding_candidate_visible_now": { "type": "boolean" },
        "project_workflow_registration_candidate_visible_now": { "type": "boolean" },
        "registry_blocker_ledger_visible_now": { "type": "boolean" },
        "operator_plan_registry_projection_visible_now": { "type": "boolean" },
        "no_registry_mutation_boundary_closed_now": { "type": "boolean" },
        "plan_registry_control_plane_wiring_complete_now": { "type": "boolean" },
        "plan_registry_control_plane_candidate_count": { "type": "number" },
        "goal_phase_manifest_binding_candidate_count": { "type": "number" },
        "project_workflow_registration_candidate_count": { "type": "number" },
        "blocker_count": { "type": "number" },
        "operator_projection_count": { "type": "number" },
        "registry_mutation_allowed_count": { "const": 0 },
        "workflow_registration_allowed_count": { "const": 0 },
        "goal_phase_create_allowed_count": { "const": 0 },
        "plan_registry_actual_record_create_allowed_now": { "const": false },
        "plan_registry_mutation_allowed_now": { "const": false },
        "plan_registry_goal_create_allowed_now": { "const": false },
        "plan_registry_phase_create_allowed_now": { "const": false },
        "plan_registry_workflow_registration_allowed_now": { "const": false },
        "plan_registry_status_pass_allowed_now": { "const": false },
        "plan_registry_requirement_traceability_pass_allowed_now": { "const": false },
        "plan_registry_owner_assignment_bypass_allowed_now": { "const": false },
        "plan_registry_review_bypass_allowed_now": { "const": false },
        "plan_registry_freshness_bypass_allowed_now": { "const": false },
        "plan_registry_operator_register_button_allowed_now": { "const": false },
        "plan_registry_runtime_execution_allowed_now": { "const": false },
        "plan_registry_write_action_allowed_now": { "const": false },
        "plan_registry_protected_action_allowed_now": { "const": false },
        "plan_registry_connector_write_allowed_now": { "const": false },
        "plan_registry_deployment_allowed_now": { "const": false },
        "plan_registry_review_completion_allowed_now": { "const": false },
        "plan_registry_final_approval_allowed_now": { "const": false },
        "plan_registry_production_pass_allowed_now": { "const": false },
        "plan_registry_enterprise_trust_claim_allowed_now": { "const": false },
        "plan_registry_secret_read_allowed_now": { "const": false },
        "plan_registry_human_gate_bypass_allowed_now": { "const": false },
        "plan_registry_independent_review_bypass_allowed_now": { "const": false },
        "plan_registry_final_automated_approval_allowed_now": { "const": false },
        "production_pass_enabled": { "const": false },
        "enterprise_trust_claim_allowed_now": { "const": false }
      }
    },
    "validation": {
      "type": "object",
      "required": ["valid", "error_count", "errors"],
      "properties": {
        "valid": { "type": "boolean" },
        "error_count": { "type": "number" },
        "errors": { "type": "array" }
      }
    }
  },
  "$defs": {
    "verdictRow": {
      "type": "object",
      "required": ["row_id", "category", "label", "observed", "current_verdict", "block_reason", "evidence_ref"],
      "properties": {
        "row_id": { "type": "string" },
        "category": { "type": "string" },
        "label": { "type": "string" },
        "observed": { "type": "boolean" },
        "current_verdict": { "enum": ["pass", "block"] },
        "block_reason": { "type": ["string", "null"] },
        "evidence_ref": { "type": ["string", "null"] },
        "generated_at": { "type": "string" }
      },
      "additionalProperties": true
    },
    "validationItem": {
      "allOf": [{ "$ref": "#/$defs/verdictRow" }]
    }
  }
}
