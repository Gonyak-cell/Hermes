          "schema_version": { "const": "zendd-protected-next-action-row.v1" },
          "action_execution_allowed_now": { "const": false }
        },
        "additionalProperties": true
      }
    },
    "protected_action_rollback_closeout_rows": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "type": "object",
