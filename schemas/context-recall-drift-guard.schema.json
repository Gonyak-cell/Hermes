{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hermes.local/schemas/context-recall-drift-guard.schema.json",
  "title": "Hermes Context Recall Drift Guard",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "generated_at",
    "capability_id",
    "program_range",
    "source_program_range",
    "context_recall_contract",
    "context_recall_phase_rows",
    "p10600_source_binding_rows",
    "next_session_recall_candidate_rows",
    "recall_citation_enforcement_rows",
    "recall_freshness_policy_rows",
    "recall_conflict_detection_rows",
    "uncited_memory_blocker_rows",
    "cross_domain_boundary_rows",
    "context_recall_api_route_rows",
    "context_recall_api_smoke_rows",
    "context_recall_browser_smoke_rows",
    "context_recall_negative_fixture_rows",
    "claude_review_receipt_rows",
    "p10800_freeze_rows",
    "context_recall_gate_rows",
    "context_recall_boundary",
    "validation_items",
    "validation",
    "summary"
  ],
  "properties": {
    "schema_version": { "const": "context-recall-drift-guard.v1" },
    "capability_id": { "const": "platform.context_recall_drift_guard" },
    "program_range": { "const": "P10601-P10800" },
    "source_program_range": { "const": "P10401-P10600" },
    "context_recall_contract": {
      "type": "object",
      "required": [
        "source_local_session_capture_required",
        "next_session_recall_candidates_required",
        "citation_enforcement_required",
        "freshness_policy_required",
        "conflict_detection_required",
        "uncited_memory_blocker_required",
        "cross_domain_boundary_required",
        "read_only_api_projection_required",
        "claude_review_receipt_required",
        "uncited_recall_allowed",
        "stale_fact_as_current_allowed",
        "cross_domain_recall_allowed",
        "auto_context_mutation_enabled",
        "codex_final_approval_allowed",
        "claude_final_approval_allowed",
        "production_pass_enabled",
        "enterprise_pass_enabled"
      ],
      "properties": {
        "source_local_session_capture_required": { "const": true },
        "next_session_recall_candidates_required": { "const": true },
        "citation_enforcement_required": { "const": true },
        "freshness_policy_required": { "const": true },
        "conflict_detection_required": { "const": true },
        "uncited_memory_blocker_required": { "const": true },
        "cross_domain_boundary_required": { "const": true },
        "read_only_api_projection_required": { "const": true },
        "claude_review_receipt_required": { "const": true },
        "uncited_recall_allowed": { "const": false },
        "stale_fact_as_current_allowed": { "const": false },
        "cross_domain_recall_allowed": { "const": false },
        "auto_context_mutation_enabled": { "const": false },
        "codex_final_approval_allowed": { "const": false },
        "claude_final_approval_allowed": { "const": false },
        "production_pass_enabled": { "const": false },
        "enterprise_pass_enabled": { "const": false }
      }
    },
    "context_recall_phase_rows": { "type": "array", "minItems": 10, "items": { "$ref": "#/$defs/verdictRow" } },
    "p10600_source_binding_rows": { "type": "array", "minItems": 3, "items": { "$ref": "#/$defs/verdictRow" } },
    "next_session_recall_candidate_rows": { "type": "array", "minItems": 6, "items": { "$ref": "#/$defs/verdictRow" } },
    "recall_citation_enforcement_rows": { "type": "array", "minItems": 6, "items": { "$ref": "#/$defs/verdictRow" } },
    "recall_freshness_policy_rows": { "type": "array", "minItems": 5, "items": { "$ref": "#/$defs/verdictRow" } },
    "recall_conflict_detection_rows": { "type": "array", "minItems": 4, "items": { "$ref": "#/$defs/verdictRow" } },
    "uncited_memory_blocker_rows": { "type": "array", "minItems": 4, "items": { "$ref": "#/$defs/verdictRow" } },
    "cross_domain_boundary_rows": { "type": "array", "minItems": 5, "items": { "$ref": "#/$defs/verdictRow" } },
    "context_recall_api_route_rows": { "type": "array", "minItems": 9, "items": { "$ref": "#/$defs/verdictRow" } },
    "context_recall_api_smoke_rows": { "type": "array", "minItems": 10, "items": { "$ref": "#/$defs/verdictRow" } },
    "context_recall_browser_smoke_rows": { "type": "array", "minItems": 6, "items": { "$ref": "#/$defs/verdictRow" } },
    "context_recall_negative_fixture_rows": { "type": "array", "minItems": 12, "items": { "$ref": "#/$defs/verdictRow" } },
    "claude_review_receipt_rows": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/verdictRow" } },
    "p10800_freeze_rows": { "type": "array", "minItems": 11, "items": { "$ref": "#/$defs/verdictRow" } },
    "context_recall_gate_rows": { "type": "array", "minItems": 22, "items": { "$ref": "#/$defs/verdictRow" } },
    "context_recall_boundary": {
      "type": "object",
      "required": [
        "source_p10600_ready",
        "p10800_claude_review_required_now",
        "p10800_claude_review_completed_now",
        "recall_candidates_ready",
        "citation_enforcement_ready",
        "freshness_policy_ready",
        "conflict_detection_ready",
        "uncited_memory_blocker_ready",
        "cross_domain_boundary_ready",
        "read_only_api_projection_ready",
        "next_session_recall_bundle_ready",
        "uncited_recall_allowed",
        "raw_transcript_recall_allowed",
        "full_transcript_recall_allowed",
        "stale_fact_as_current_allowed",
        "hidden_conflict_allowed",
        "cross_domain_recall_allowed",
        "auto_context_mutation_enabled",
        "runtime_recall_enabled",
        "retrieval_truth_enabled",
        "api_write_methods_enabled",
        "codex_final_approval_allowed",
        "claude_final_approval_allowed",
        "production_pass_enabled",
        "enterprise_pass_enabled",
        "ready_for_p10801_handoff",
        "unsafe_flag_count"
      ],
      "properties": {
        "p10800_claude_review_required_now": { "const": true },
        "uncited_recall_allowed": { "const": false },
        "raw_transcript_recall_allowed": { "const": false },
        "full_transcript_recall_allowed": { "const": false },
        "stale_fact_as_current_allowed": { "const": false },
        "hidden_conflict_allowed": { "const": false },
        "cross_domain_recall_allowed": { "const": false },
        "auto_context_mutation_enabled": { "const": false },
        "runtime_recall_enabled": { "const": false },
        "retrieval_truth_enabled": { "const": false },
        "api_write_methods_enabled": { "const": false },
        "codex_final_approval_allowed": { "const": false },
        "claude_final_approval_allowed": { "const": false },
        "production_pass_enabled": { "const": false },
        "enterprise_pass_enabled": { "const": false },
        "unsafe_flag_count": { "const": 0 }
      }
    },
    "validation": {
      "type": "object",
      "required": ["valid", "error_count", "errors"],
      "properties": {
        "valid": { "type": "boolean" },
        "error_count": { "type": "integer", "minimum": 0 },
        "errors": { "type": "array" }
      }
    },
    "summary": {
      "type": "object",
      "required": [
        "context_recall_drift_guard_status",
        "source_p10600_ready",
        "p10800_claude_review_required_now",
        "p10800_claude_review_completed_now",
        "context_recall_guard_ready",
        "next_session_recall_bundle_ready",
        "ready_for_p10801_handoff",
        "uncited_recall_allowed",
        "stale_fact_as_current_allowed",
        "cross_domain_recall_allowed",
        "auto_context_mutation_enabled",
        "codex_final_approval_allowed",
        "claude_final_approval_allowed",
        "production_pass_enabled",
        "enterprise_pass_enabled",
        "validation_error_count"
      ],
      "properties": {
        "context_recall_drift_guard_status": {
          "enum": [
            "ready_for_context_recall_drift_guard",
            "ready_for_required_claude_review",
            "blocked_context_recall_drift_guard"
          ]
        },
        "p10800_claude_review_required_now": { "const": true },
        "uncited_recall_allowed": { "const": false },
        "stale_fact_as_current_allowed": { "const": false },
        "cross_domain_recall_allowed": { "const": false },
        "auto_context_mutation_enabled": { "const": false },
        "codex_final_approval_allowed": { "const": false },
        "claude_final_approval_allowed": { "const": false },
        "production_pass_enabled": { "const": false },
        "enterprise_pass_enabled": { "const": false }
      }
    }
  },
  "$defs": {
    "verdictRow": {
      "type": "object",
      "required": ["row_id", "category", "label", "required", "observed", "current_verdict", "evidence_ref"],
      "properties": {
        "current_verdict": { "enum": ["pass", "blocked"] },
        "required": { "type": "boolean" },
        "observed": { "type": "boolean" },
        "evidence_ref": { "type": "string" }
      }
    }
  }
}
