{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://amic.local/hermes/expansion-cursor-ledger.schema.json",
  "title": "Expansion Cursor Ledger",
  "type": "object",
  "required": [
    "schema_version",
    "generated_at",
    "expansion_cursor_ledger_id",
    "expansion_cursor_ledger_status",
    "safe_handling",
    "expansion_cursor_schema",
    "cursor_state_rows",
    "batch_state_rows",
    "resume_checkpoint_rows",
    "batch_item_positions",
    "path_portability_checks",
    "expansion_cursor_boundary",
    "expansion_cursor_checkpoints",
    "validation_items",
    "validation",
    "summary"
  ],
  "properties": {
    "schema_version": { "const": "expansion-cursor-ledger.v1" },
    "generated_at": { "type": "string", "format": "date-time" },
    "expansion_cursor_ledger_id": { "type": "string", "minLength": 1 },
    "expansion_cursor_ledger_status": { "const": "complete" },
    "safe_handling": {
      "type": "object",
      "required": [
        "cursor_ledger_report_only",
        "backfill_execution_performed",
        "source_ingest_performed",
        "file_content_read_performed",
        "legal_advice_generated",
        "client_facing_output_generated"
      ],
      "properties": {
        "cursor_ledger_report_only": { "const": true },
        "backfill_execution_performed": { "const": false },
        "source_ingest_performed": { "const": false },
        "file_content_read_performed": { "const": false },
        "source_mutation_allowed": { "const": false },
        "resource_mutation_allowed": { "const": false },
        "state_mutation_allowed": { "const": false },
        "protected_actions_executed": { "const": false },
        "external_delivery_executed": { "const": false },
        "external_model_call_executed": { "const": false },
        "legal_advice_generated": { "const": false },
        "client_facing_output_generated": { "const": false },
        "human_review_note": { "type": "string", "minLength": 1 }
      }
    },
    "source_contracts": {
      "type": "array",
      "minItems": 10,
      "items": {
        "type": "object",
        "required": ["label", "available"],
        "properties": {
          "label": { "type": "string" },
          "available": { "type": "boolean" },
          "schema_version": { "type": ["string", "null"] },
          "content_hash": { "type": ["string", "null"], "pattern": "^sha256:" },
          "error": { "type": ["string", "null"] }
        }
      }
    },
    "expansion_cursor_schema": {
      "type": "object",
      "required": [
        "schema_version",
        "contract_id",
        "phase_slot",
        "previous_phase_slot",
        "next_phase_slot",
        "same_batch_resume_contract"
      ],
      "properties": {
        "schema_version": { "const": "expansion-cursor-ledger-schema.v1" },
        "contract_id": { "const": "expansion-cursor-ledger.v1" },
        "phase_slot": { "const": "P278" },
        "previous_phase_slot": { "const": "P277" },
        "next_phase_slot": { "const": "P279" },
        "required_cursor_state_row_count": { "type": "integer", "minimum": 6 },
        "required_batch_state_row_count": { "type": "integer", "minimum": 5 },
        "required_resume_checkpoint_count": { "type": "integer", "minimum": 18 },
        "required_path_portability_check_count": { "type": "integer", "minimum": 6 },
        "batch_item_position_count": { "type": "integer", "minimum": 1 },
        "same_batch_resume_contract": {
          "type": "object",
          "required": [
            "batch_identity_fields",
            "cursor_fields",
            "state_fields",
            "absolute_path_identity_allowed",
            "raw_cursor_material_allowed"
          ],
          "properties": {
            "batch_identity_fields": { "type": "array", "minItems": 5 },
            "cursor_fields": { "type": "array", "minItems": 3 },
            "state_fields": { "type": "array", "minItems": 3 },
            "absolute_path_identity_allowed": { "const": false },
            "raw_cursor_material_allowed": { "const": false }
          }
        }
      }
    },
    "cursor_state_rows": {
      "type": "array",
      "minItems": 6,
      "items": {
        "type": "object",
        "required": ["cursor_state_row_id", "cursor_state_status", "same_batch_resume_supported", "human_review_required", "client_facing_ready"],
        "properties": {
          "cursor_state_row_id": { "type": "string" },
          "cursor_state_status": { "const": "passed" },
          "same_batch_resume_supported": { "const": true },
          "raw_cursor_material_allowed": { "const": false },
          "state_path_treated_as_opaque": { "type": "boolean" },
          "human_review_required": { "const": true },
          "client_facing_ready": { "const": false }
        }
      }
    },
    "batch_state_rows": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "required": ["batch_state_row_id", "batch_state_status", "human_review_required", "client_facing_ready"],
        "properties": {
          "batch_state_row_id": { "type": "string" },
          "batch_state_status": { "const": "passed" },
          "same_batch_replay_supported": { "type": "boolean" },
          "human_review_required": { "const": true },
          "client_facing_ready": { "const": false }
        }
      }
    },
    "resume_checkpoint_rows": {
      "type": "array",
      "minItems": 18,
      "items": {
        "type": "object",
        "required": ["resume_checkpoint_id", "checkpoint_status", "human_review_required", "client_facing_ready"],
        "properties": {
          "resume_checkpoint_id": { "type": "string" },
          "checkpoint_status": { "const": "passed" },
          "human_review_required": { "const": true },
          "client_facing_ready": { "const": false }
        }
      }
    },
    "batch_item_positions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "batch_item_position_id",
          "batch_index",
          "batch_position",
          "item_status",
          "resume_key_status",
          "portable_resume_key",
          "source_path_used_for_resume_identity",
          "human_review_required",
          "client_facing_ready"
        ],
        "properties": {
          "batch_item_position_id": { "type": "string" },
          "batch_index": { "type": "integer", "minimum": 1 },
          "batch_position": { "type": "integer", "minimum": 1 },
          "item_status": { "type": "string" },
          "resume_key_status": { "const": "portable" },
          "portable_resume_key": { "type": "string", "pattern": "^resume:" },
          "source_idempotency_key_present": { "type": "boolean" },
          "idempotency_key_hash": { "type": ["string", "null"], "pattern": "^sha256:" },
          "source_path_reference_hash": { "type": ["string", "null"], "pattern": "^sha256:" },
          "source_path_used_for_resume_identity": { "const": false },
          "legal_advice_generated": { "const": false },
          "human_review_required": { "const": true },
          "client_facing_ready": { "const": false }
        }
      }
    },
    "path_portability_checks": {
      "type": "array",
      "minItems": 6,
      "items": {
        "type": "object",
        "required": [
          "path_portability_check_id",
          "path_portability_status",
          "source_absolute_path_identity_allowed",
          "state_path_treated_as_opaque",
          "human_review_required",
          "client_facing_ready"
        ],
        "properties": {
          "path_portability_check_id": { "type": "string" },
          "path_portability_status": { "const": "passed" },
          "source_absolute_path_identity_allowed": { "const": false },
          "state_path_treated_as_opaque": { "const": true },
          "human_review_required": { "const": true },
          "client_facing_ready": { "const": false }
        }
      }
    },
    "expansion_cursor_boundary": {
      "type": "object",
      "required": [
        "read_only",
        "cursor_ledger_report_only",
        "backfill_execution_performed",
        "source_ingest_performed",
        "file_content_read_performed",
        "source_mutation_performed",
        "resource_mutation_performed",
        "state_mutation_performed",
        "delivery_execution_performed",
        "protected_action_executed",
        "legal_advice_generated",
        "client_facing_output_generated",
        "windows_baseline_stability_preserved",
        "mac_windows_completion_instability_guard"
      ],
      "properties": {
        "read_only": { "const": true },
        "cursor_ledger_report_only": { "const": true },
        "source_artifact_read_performed": { "const": true },
        "backfill_execution_performed": { "const": false },
        "source_ingest_performed": { "const": false },
        "file_content_read_performed": { "const": false },
        "source_mutation_performed": { "const": false },
        "resource_mutation_performed": { "const": false },
        "state_mutation_performed": { "const": false },
        "next_batch_mutation_performed": { "const": false },
        "delivery_execution_performed": { "const": false },
        "protected_action_executed": { "const": false },
        "legal_advice_generated": { "const": false },
        "client_facing_output_generated": { "const": false },
        "client_facing_ready_count": { "const": 0 },
        "windows_baseline_stability_preserved": { "const": true },
        "mac_windows_completion_instability_guard": { "const": true }
      }
    },
    "expansion_cursor_checkpoints": {
      "type": "array",
      "minItems": 23,
      "items": {
        "type": "object",
        "required": ["checkpoint_id", "status", "message"],
        "properties": {
          "checkpoint_id": { "type": "string" },
          "status": { "const": "passed" },
          "message": { "type": "string" }
        }
      }
    },
    "validation_items": {
      "type": "array",
      "minItems": 23,
      "items": {
        "type": "object",
        "required": ["path", "status", "message"],
        "properties": {
          "path": { "type": "string" },
          "status": { "const": "passed" },
          "message": { "type": "string" }
        }
      }
    },
    "validation": {
      "type": "object",
      "required": ["valid", "errors", "items"],
      "properties": {
        "valid": { "const": true },
        "errors": { "type": "array", "maxItems": 0 },
        "items": { "type": "array", "minItems": 23 }
      }
    },
    "summary": {
      "type": "object",
      "required": [
        "expansion_cursor_ledger_status",
        "phase_slot",
        "previous_phase_slot",
        "next_phase_slot",
        "same_batch_resume_supported",
        "interrupted_resume_returns_same_batch_state",
        "resume_batch_state_stable",
        "cursor_state_stable",
        "state_snapshot_hash_stable",
        "next_batch_artifact_matches_cursor",
        "raw_cursor_material_allowed",
        "source_absolute_path_identity_allowed",
        "state_path_treated_as_opaque",
        "backfill_execution_performed",
        "source_ingest_performed",
        "file_content_read_performed",
        "source_mutation_performed",
        "resource_mutation_performed",
        "state_mutation_performed",
        "delivery_execution_performed",
        "protected_action_executed",
        "legal_advice_generated",
        "client_facing_output_generated",
        "windows_baseline_stability_preserved",
        "mac_windows_completion_instability_guard",
        "validation_error_count"
      ],
      "properties": {
        "expansion_cursor_ledger_status": { "const": "complete" },
        "phase_slot": { "const": "P278" },
        "previous_phase_slot": { "const": "P277" },
        "next_phase_slot": { "const": "P279" },
        "requested_batch_size": { "type": "integer", "minimum": 1 },
        "batch_item_position_count": { "type": "integer", "minimum": 1 },
        "portable_resume_key_complete_count": { "type": "integer", "minimum": 1 },
        "cursor_state_row_count": { "type": "integer", "minimum": 6 },
        "passed_cursor_state_row_count": { "type": "integer", "minimum": 6 },
        "batch_state_row_count": { "type": "integer", "minimum": 5 },
        "passed_batch_state_row_count": { "type": "integer", "minimum": 5 },
        "resume_checkpoint_count": { "type": "integer", "minimum": 18 },
        "passed_resume_checkpoint_count": { "type": "integer", "minimum": 18 },
        "path_portability_check_count": { "type": "integer", "minimum": 6 },
        "passed_path_portability_check_count": { "type": "integer", "minimum": 6 },
        "same_batch_resume_supported": { "const": true },
        "interrupted_resume_returns_same_batch_state": { "const": true },
        "resume_batch_state_stable": { "const": true },
        "cursor_state_stable": { "const": true },
        "state_snapshot_hash_stable": { "const": true },
        "next_batch_artifact_matches_cursor": { "const": true },
        "raw_cursor_material_allowed": { "const": false },
        "source_absolute_path_identity_allowed": { "const": false },
        "state_path_treated_as_opaque": { "const": true },
        "read_only": { "const": true },
        "cursor_ledger_report_only": { "const": true },
        "backfill_execution_performed": { "const": false },
        "source_ingest_performed": { "const": false },
        "file_content_read_performed": { "const": false },
        "source_mutation_performed": { "const": false },
        "resource_mutation_performed": { "const": false },
        "state_mutation_performed": { "const": false },
        "next_batch_mutation_performed": { "const": false },
        "delivery_execution_performed": { "const": false },
        "protected_action_executed": { "const": false },
        "legal_advice_generated": { "const": false },
        "client_facing_output_generated": { "const": false },
        "client_facing_ready_count": { "const": 0 },
        "windows_baseline_stability_preserved": { "const": true },
        "mac_windows_completion_instability_guard": { "const": true },
        "failed_checkpoint_count": { "const": 0 },
        "validation_error_count": { "const": 0 }
      }
    }
  }
}
