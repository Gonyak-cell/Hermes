{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://amic.local/hermes/meeting-minutes-workflow.schema.json",
  "title": "Meeting Minutes Workflow",
  "type": "object",
  "required": [
    "schema_version",
    "generated_at",
    "meeting_minutes_workflow_id",
    "meeting_minutes_workflow_status",
    "safe_handling",
    "source_contracts",
    "meeting_minutes_workflow_contract",
    "meeting_minutes_rules",
    "meeting_minutes_sources",
    "meeting_minutes_agenda_items",
    "meeting_minutes_decisions",
    "meeting_minutes_action_items",
    "meeting_minutes_evidence_links",
    "meeting_minutes_matter_summaries",
    "meeting_minutes_workflow_desktop_boundary",
    "validation_items",
    "validation",
    "summary"
  ],
  "properties": {
    "schema_version": { "const": "meeting-minutes-workflow.v1" },
    "generated_at": { "type": "string" },
    "meeting_minutes_workflow_id": { "type": "string", "minLength": 1 },
    "output_dir": { "type": "string" },
    "meeting_minutes_workflow_status": { "enum": ["complete", "attention"] },
    "safe_handling": { "$ref": "#/$defs/safe_handling" },
    "inputs": { "type": "object" },
    "source_contracts": { "type": "object" },
    "meeting_minutes_workflow_contract": { "type": "object" },
    "meeting_minutes_rules": {
      "type": "array",
      "minItems": 6,
      "items": { "$ref": "#/$defs/rule" }
    },
    "meeting_minutes_sources": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/source" }
    },
    "meeting_minutes_agenda_items": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/agenda" }
    },
    "meeting_minutes_decisions": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/decision" }
    },
    "meeting_minutes_action_items": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/action_item" }
    },
    "meeting_minutes_evidence_links": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/evidence_link" }
    },
    "meeting_minutes_matter_summaries": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/matter_summary" }
    },
    "meeting_minutes_workflow_desktop_boundary": { "$ref": "#/$defs/desktop_boundary" },
    "meeting_minutes_workflow_checkpoints": { "type": "array" },
    "validation_items": { "type": "array" },
    "validation": { "$ref": "#/$defs/validation" },
    "summary": { "$ref": "#/$defs/summary" }
  },
  "$defs": {
    "safe_handling": {
      "type": "object",
      "required": [
        "report_only",
        "draft_only",
        "deterministic_meeting_minutes_generation_performed",
        "legal_conclusion_asserted",
        "legal_advice_provided",
        "client_facing_ready",
        "client_facing_output_generated",
        "attorney_review_required",
        "human_review_required",
        "partner_approval_required_before_client_use",
        "matter_data_write_allowed",
        "task_state_write_allowed",
        "workflow_transition_allowed",
        "runtime_execution_performed",
        "delivery_execution_performed",
        "desktop_mutation_allowed",
        "desktop_source_of_truth",
        "protected_mutation_executed"
      ],
      "properties": {
        "report_only": { "const": true },
        "draft_only": { "const": true },
        "deterministic_meeting_minutes_generation_performed": { "const": true },
        "legal_conclusion_asserted": { "const": false },
        "legal_advice_provided": { "const": false },
        "client_facing_ready": { "const": false },
        "client_facing_output_generated": { "const": false },
        "attorney_review_required": { "const": true },
        "human_review_required": { "const": true },
        "partner_approval_required_before_client_use": { "const": true },
        "matter_data_write_allowed": { "const": false },
        "task_state_write_allowed": { "const": false },
        "workflow_transition_allowed": { "const": false },
        "runtime_execution_performed": { "const": false },
        "delivery_execution_performed": { "const": false },
        "desktop_mutation_allowed": { "const": false },
        "desktop_source_of_truth": { "const": false },
        "protected_mutation_executed": { "const": false }
      }
    },
    "rule": {
      "type": "object",
      "required": [
        "schema_version",
        "meeting_minutes_rule_id",
        "meeting_minutes_rule_type",
        "rule_status",
        "deterministic_only",
        "attorney_review_required",
        "human_review_required"
      ],
      "properties": {
        "schema_version": { "const": "meeting-minutes-rule.v1" },
        "meeting_minutes_rule_id": { "type": "string" },
        "meeting_minutes_rule_type": { "type": "string" },
        "rule_status": { "const": "active" },
        "deterministic_only": { "const": true },
        "attorney_review_required": { "const": true },
        "human_review_required": { "const": true }
      }
    },
    "source_ref": {
      "type": "object",
      "required": ["source_kind", "source_id", "source_field"],
      "properties": {
        "source_kind": { "type": "string" },
        "source_id": { "type": "string" },
        "source_field": { "type": "string" }
      }
    },
    "source": {
      "type": "object",
      "required": [
        "schema_version",
        "meeting_minutes_source_id",
        "matter_id",
        "source_kind",
        "source_type",
        "meeting_minutes_source_status",
        "source_refs",
        "source_ref_count",
        "attorney_review_required",
        "human_review_required",
        "client_facing_ready",
        "legal_conclusion_asserted"
      ],
      "properties": {
        "schema_version": { "const": "meeting-minutes-source.v1" },
        "meeting_minutes_source_id": { "type": "string" },
        "matter_id": { "type": "string" },
        "source_kind": { "type": "string" },
        "source_type": { "type": "string" },
        "meeting_minutes_source_status": { "const": "source_loaded_pending_attorney_review" },
        "source_refs": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/source_ref" } },
        "source_ref_count": { "type": "integer", "minimum": 1 },
        "attorney_review_required": { "const": true },
        "human_review_required": { "const": true },
        "client_facing_ready": { "const": false },
        "legal_conclusion_asserted": { "const": false }
      }
    },
    "agenda": {
      "type": "object",
      "required": [
        "schema_version",
        "meeting_minutes_agenda_item_id",
        "matter_id",
        "meeting_minutes_source_id",
        "agenda_status",
        "source_ref_count",
        "decision_count",
        "action_item_count",
        "evidence_link_count",
        "attorney_review_required",
        "human_review_required",
        "client_facing_ready",
        "legal_conclusion_asserted"
      ],
      "properties": {
        "schema_version": { "const": "meeting-minutes-agenda-item.v1" },
        "meeting_minutes_agenda_item_id": { "type": "string" },
        "matter_id": { "type": "string" },
        "meeting_minutes_source_id": { "type": "string" },
        "agenda_status": { "const": "draft_pending_attorney_review" },
        "source_ref_count": { "type": "integer", "minimum": 1 },
        "decision_count": { "type": "integer", "minimum": 1 },
        "action_item_count": { "type": "integer", "minimum": 1 },
        "evidence_link_count": { "type": "integer", "minimum": 1 },
        "attorney_review_required": { "const": true },
        "human_review_required": { "const": true },
        "client_facing_ready": { "const": false },
        "legal_conclusion_asserted": { "const": false }
      }
    },
    "decision": {
      "type": "object",
      "required": [
        "schema_version",
        "meeting_minutes_decision_id",
        "matter_id",
        "meeting_minutes_agenda_item_id",
        "decision_status",
        "source_ref_count",
        "action_item_count",
        "evidence_link_count",
        "attorney_review_required",
        "human_review_required",
        "client_facing_ready",
        "client_facing_output_generated",
        "legal_conclusion_asserted",
        "legal_advice_provided"
      ],
      "properties": {
        "schema_version": { "const": "meeting-minutes-decision.v1" },
        "meeting_minutes_decision_id": { "type": "string" },
        "matter_id": { "type": "string" },
        "meeting_minutes_agenda_item_id": { "type": "string" },
        "decision_status": { "const": "draft_pending_attorney_review" },
        "source_ref_count": { "type": "integer", "minimum": 1 },
        "action_item_count": { "type": "integer", "minimum": 1 },
        "evidence_link_count": { "type": "integer", "minimum": 1 },
        "attorney_review_required": { "const": true },
        "human_review_required": { "const": true },
        "client_facing_ready": { "const": false },
        "client_facing_output_generated": { "const": false },
        "legal_conclusion_asserted": { "const": false },
        "legal_advice_provided": { "const": false }
      }
    },
    "action_item": {
      "type": "object",
      "required": [
        "schema_version",
        "meeting_minutes_action_item_id",
        "matter_id",
        "meeting_minutes_source_id",
        "meeting_minutes_agenda_item_id",
        "meeting_minutes_decision_id",
        "action_status",
        "source_ref_count",
        "evidence_required",
        "evidence_link_count",
        "task_state_write_allowed",
        "workflow_transition_allowed",
        "runtime_execution_allowed",
        "delivery_execution_allowed",
        "attorney_review_required",
        "human_review_required",
        "client_facing_ready",
        "client_facing_output_generated",
        "legal_conclusion_asserted",
        "legal_advice_provided"
      ],
      "properties": {
        "schema_version": { "const": "meeting-minutes-action-item.v1" },
        "meeting_minutes_action_item_id": { "type": "string" },
        "matter_id": { "type": "string" },
        "meeting_minutes_source_id": { "type": "string" },
        "meeting_minutes_agenda_item_id": { "type": "string" },
        "meeting_minutes_decision_id": { "type": "string" },
        "action_status": { "const": "draft_pending_attorney_review" },
        "source_ref_count": { "type": "integer", "minimum": 1 },
        "evidence_required": { "const": true },
        "evidence_link_count": { "type": "integer", "minimum": 1 },
        "task_state_write_allowed": { "const": false },
        "workflow_transition_allowed": { "const": false },
        "runtime_execution_allowed": { "const": false },
        "delivery_execution_allowed": { "const": false },
        "attorney_review_required": { "const": true },
        "human_review_required": { "const": true },
        "client_facing_ready": { "const": false },
        "client_facing_output_generated": { "const": false },
        "legal_conclusion_asserted": { "const": false },
        "legal_advice_provided": { "const": false }
      }
    },
    "evidence_link": {
      "type": "object",
      "required": [
        "schema_version",
        "meeting_minutes_evidence_link_id",
        "matter_id",
        "meeting_minutes_action_item_id",
        "evidence_source_kind",
        "evidence_link_status",
        "source_ref_count",
        "attorney_review_required",
        "human_review_required",
        "client_facing_ready",
        "legal_conclusion_asserted"
      ],
      "properties": {
        "schema_version": { "const": "meeting-minutes-evidence-link.v1" },
        "meeting_minutes_evidence_link_id": { "type": "string" },
        "matter_id": { "type": "string" },
        "meeting_minutes_action_item_id": { "type": "string" },
        "evidence_source_kind": { "type": "string" },
        "evidence_link_status": { "const": "linked_pending_attorney_review" },
        "source_ref_count": { "type": "integer", "minimum": 1 },
        "attorney_review_required": { "const": true },
        "human_review_required": { "const": true },
        "client_facing_ready": { "const": false },
        "legal_conclusion_asserted": { "const": false }
      }
    },
    "matter_summary": {
      "type": "object",
      "required": [
        "schema_version",
        "meeting_minutes_matter_summary_id",
        "matter_id",
        "meeting_minutes_matter_status",
        "agenda_item_count",
        "decision_count",
        "action_item_count",
        "evidence_link_count",
        "draft_only",
        "attorney_review_required",
        "human_review_required",
        "client_facing_ready"
      ],
      "properties": {
        "schema_version": { "const": "meeting-minutes-matter-summary.v1" },
        "meeting_minutes_matter_summary_id": { "type": "string" },
        "matter_id": { "type": "string" },
        "meeting_minutes_matter_status": { "const": "draft_pending_attorney_review" },
        "agenda_item_count": { "type": "integer", "minimum": 1 },
        "decision_count": { "type": "integer", "minimum": 1 },
        "action_item_count": { "type": "integer", "minimum": 1 },
        "evidence_link_count": { "type": "integer", "minimum": 1 },
        "draft_only": { "const": true },
        "attorney_review_required": { "const": true },
        "human_review_required": { "const": true },
        "client_facing_ready": { "const": false }
      }
    },
    "desktop_boundary": {
      "type": "object",
      "required": [
        "boundary_status",
        "read_only",
        "desktop_mutation_allowed",
        "desktop_source_of_truth",
        "matter_data_write_allowed",
        "task_state_write_allowed",
        "workflow_transition_allowed",
        "runtime_execution_allowed",
        "delivery_execution_allowed",
        "protected_action_allowed",
        "client_facing_output_allowed_without_attorney_review"
      ],
      "properties": {
        "boundary_status": { "const": "enforced" },
        "read_only": { "const": true },
        "desktop_mutation_allowed": { "const": false },
        "desktop_source_of_truth": { "const": false },
        "matter_data_write_allowed": { "const": false },
        "task_state_write_allowed": { "const": false },
        "workflow_transition_allowed": { "const": false },
        "runtime_execution_allowed": { "const": false },
        "delivery_execution_allowed": { "const": false },
        "protected_action_allowed": { "const": false },
        "client_facing_output_allowed_without_attorney_review": { "const": false }
      }
    },
    "validation": {
      "type": "object",
      "required": ["valid", "errors"],
      "properties": {
        "valid": { "const": true },
        "errors": { "type": "array", "maxItems": 0 }
      }
    },
    "summary": {
      "type": "object",
      "required": [
        "meeting_minutes_workflow_status",
        "source_matter_status",
        "source_matter_id",
        "source_matter_timeline_status",
        "source_matter_timeline_phase_status",
        "source_meeting_note_status",
        "meeting_minutes_rule_count",
        "meeting_minutes_source_count",
        "agenda_item_count",
        "decision_count",
        "action_item_count",
        "evidence_link_count",
        "matter_count",
        "action_item_with_evidence_link_count",
        "agenda_with_decision_count",
        "agenda_with_action_item_count",
        "decision_with_action_item_count",
        "client_facing_ready_count",
        "legal_conclusion_asserted_count",
        "legal_advice_provided",
        "client_facing_output_generated",
        "matter_data_write_allowed",
        "task_state_write_allowed",
        "workflow_transition_allowed",
        "runtime_execution_allowed",
        "delivery_execution_allowed",
        "protected_action_allowed",
        "client_facing_output_allowed_without_attorney_review",
        "desktop_boundary_status",
        "desktop_read_only",
        "desktop_mutation_allowed",
        "desktop_source_of_truth",
        "failed_checkpoint_count",
        "validation_error_count"
      ],
      "properties": {
        "meeting_minutes_workflow_status": { "const": "complete" },
        "source_matter_status": { "const": "complete" },
        "source_matter_id": { "type": "string", "minLength": 1 },
        "source_matter_timeline_status": { "const": "complete" },
        "source_matter_timeline_phase_status": { "const": "complete" },
        "source_meeting_note_status": { "const": "complete" },
        "meeting_minutes_rule_count": { "type": "integer", "minimum": 6 },
        "meeting_minutes_source_count": { "type": "integer", "minimum": 1 },
        "agenda_item_count": { "type": "integer", "minimum": 1 },
        "decision_count": { "type": "integer", "minimum": 1 },
        "action_item_count": { "type": "integer", "minimum": 1 },
        "evidence_link_count": { "type": "integer", "minimum": 1 },
        "matter_count": { "const": 1 },
        "action_item_with_evidence_link_count": { "type": "integer", "minimum": 1 },
        "agenda_with_decision_count": { "type": "integer", "minimum": 1 },
        "agenda_with_action_item_count": { "type": "integer", "minimum": 1 },
        "decision_with_action_item_count": { "type": "integer", "minimum": 1 },
        "client_facing_ready_count": { "const": 0 },
        "legal_conclusion_asserted_count": { "const": 0 },
        "legal_advice_provided": { "const": false },
        "client_facing_output_generated": { "const": false },
        "matter_data_write_allowed": { "const": false },
        "task_state_write_allowed": { "const": false },
        "workflow_transition_allowed": { "const": false },
        "runtime_execution_allowed": { "const": false },
        "delivery_execution_allowed": { "const": false },
        "protected_action_allowed": { "const": false },
        "client_facing_output_allowed_without_attorney_review": { "const": false },
        "desktop_boundary_status": { "const": "enforced" },
        "desktop_read_only": { "const": true },
        "desktop_mutation_allowed": { "const": false },
        "desktop_source_of_truth": { "const": false },
        "failed_checkpoint_count": { "const": 0 },
        "validation_error_count": { "const": 0 }
      }
    }
  }
}
