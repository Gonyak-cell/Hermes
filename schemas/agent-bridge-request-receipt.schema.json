{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hermes.local/schemas/agent-bridge-request-receipt.schema.json",
  "title": "Hermes Agent Bridge Request Receipt",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "capability_id",
    "program_range",
    "source_agent_bridge_manifest_summary",
    "agent_bridge_request_receipt_contract",
    "agent_task_request_queue_rows",
    "agent_request_lifecycle_rows",
    "agent_receipt_intake_rows",
    "agent_evidence_binding_rows",
    "malicious_request_fixture_rows",
    "malicious_receipt_fixture_rows",
    "agent_request_receipt_gate_rows",
    "agent_request_receipt_boundary",
    "validation_items",
    "validation",
    "summary"
  ],
  "properties": {
    "schema_version": { "const": "agent-bridge-request-receipt.v1" },
    "capability_id": { "const": "platform.agent_bridge_request_receipt" },
    "program_range": { "const": "AGENT-BRIDGE-L5-L6-SLICE-B" },
    "agent_bridge_request_receipt_contract": {
      "type": "object",
      "required": [
        "contract_id",
        "local_only",
