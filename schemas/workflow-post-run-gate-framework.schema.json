{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hermes.local/schemas/workflow-post-run-gate-framework.schema.json",
  "title": "Workflow Post-run Gate Framework",
  "type": "object",
  "required": [
    "schema_version",
    "generated_at",
    "workflow_post_run_gate_framework_id",
    "inputs",
    "source_contracts",
    "post_run_gate_framework_contract",
    "post_run_gate_records",
    "post_run_gate_decision_records",
    "post_run_guard_records",
    "validation_items",
    "validation",
    "summary"
  ],
  "properties": {
    "schema_version": { "const": "workflow-post-run-gate-framework.v1" },
    "generated_at": { "type": "string" },
    "workflow_post_run_gate_framework_id": { "type": "string" },
    "inputs": { "type": "object" },
    "source_contracts": { "type": "object" },
    "post_run_gate_framework_contract": { "type": "object" },
    "post_run_gate_records": {
      "type": "array",
      "items": { "$ref": "#/$defs/post_run_gate_record" }
    },
    "post_run_gate_decision_records": {
      "type": "array",
      "items": { "$ref": "#/$defs/post_run_gate_decision" }
    },
    "post_run_guard_records": {
      "type": "array",
      "items": { "$ref": "#/$defs/post_run_guard" }
    },
    "validation_items": {
      "type": "array",
      "items": { "$ref": "#/$defs/validation_item" }
    },
    "validation": {
      "type": "object",
      "required": ["valid", "errors"],
      "properties": {
        "valid": { "type": "boolean" },
        "errors": { "type": "array" }
      },
      "additionalProperties": true
    },
    "summary": {
      "type": "object",
      "required": [
        "workflow_post_run_gate_framework_status",
        "post_run_gate_framework_contract_id",
        "source_agent_run_record_count",
        "post_run_gate_record_count",
        "post_run_gate_decision_count",
        "post_run_guard_count",
        "evidence_gate_count",
        "citation_gate_count",
        "test_gate_count",
        "approval_gate_count",
        "delivery_gate_count",
        "execution_allowed_count",
        "execution_performed_count",
        "external_transfer_allowed_count",
        "protected_action_executed_count",
        "client_facing_ready_count",
        "delivery_ready_count",
        "final_action_executed_count",
        "validation_error_count"
      ],
      "additionalProperties": true
    }
  },
  "$defs": {
    "post_run_gate_record": {
      "type": "object",
      "required": [
        "schema_version",
        "post_run_gate_record_id",
        "post_run_gate_framework_contract_id",
        "gate_type",
        "gate_stage",
        "agent_run_id",
        "workflow_run_id",
        "post_run_gate_decision",
        "post_run_gate_status",
        "execution_allowed",
        "execution_performed",
        "external_transfer_allowed",
        "protected_action_execution_allowed",
        "client_facing_ready",
        "delivery_ready",
        "final_action_executed",
        "human_review_required",
        "required_after_execution"
      ],
      "properties": {
        "schema_version": { "const": "workflow-post-run-gate-record.v1" },
        "post_run_gate_record_id": { "type": "string" },
        "post_run_gate_framework_contract_id": { "const": "workflow-post-run-gate-framework.v1" },
        "gate_type": {
          "enum": ["evidence_gate", "citation_gate", "test_gate", "approval_gate", "delivery_gate"]
        },
        "gate_stage": { "const": "post_run" },
        "agent_run_id": { "type": "string" },
        "workflow_run_id": { "type": "string" },
        "matter_id": { "type": "string" },
        "domain_pack": { "type": "string" },
        "runtime_id": { "type": "string" },
        "output_ref": { "type": ["string", "null"] },
        "source_record_ids": {
          "type": "array",
          "items": { "type": "string" }
        },
        "source_statuses": {
          "type": "array",
          "items": { "type": "string" }
        },
        "post_run_gate_decision": { "enum": ["allow", "review", "block"] },
        "post_run_gate_status": { "enum": ["passed", "review_required", "blocked"] },
        "execution_allowed": { "type": "boolean" },
        "execution_performed": { "type": "boolean" },
        "external_transfer_allowed": { "type": "boolean" },
        "protected_action_execution_allowed": { "type": "boolean" },
        "client_facing_ready": { "type": "boolean" },
        "delivery_ready": { "type": "boolean" },
        "final_action_executed": { "type": "boolean" },
        "human_review_required": { "type": "boolean" },
        "required_after_execution": { "type": "boolean" },
        "reason_codes": {
          "type": "array",
          "items": { "type": "string" }
        },
        "metadata": { "type": "object" }
      },
      "additionalProperties": true
    },
    "post_run_gate_decision": {
      "type": "object",
      "required": [
        "schema_version",
        "post_run_gate_decision_record_id",
        "post_run_gate_framework_contract_id",
        "agent_run_id",
        "workflow_run_id",
        "required_gate_types",
        "resolved_gate_types",
        "post_run_gate_record_ids",
        "post_run_gate_decision",
        "post_run_gate_set_status",
        "execution_allowed",
        "execution_performed",
        "external_transfer_allowed",
        "protected_action_execution_allowed",
        "client_facing_ready",
        "delivery_ready",
        "final_action_executed",
        "human_review_required",
        "post_run_only"
      ],
      "properties": {
        "schema_version": { "const": "workflow-post-run-gate-decision.v1" },
        "post_run_gate_decision_record_id": { "type": "string" },
        "post_run_gate_framework_contract_id": { "const": "workflow-post-run-gate-framework.v1" },
        "agent_run_id": { "type": "string" },
        "workflow_run_id": { "type": "string" },
        "required_gate_types": {
          "type": "array",
          "items": { "type": "string" }
        },
        "resolved_gate_types": {
          "type": "array",
          "items": { "type": "string" }
        },
        "post_run_gate_record_ids": {
          "type": "array",
          "items": { "type": "string" }
        },
        "post_run_gate_decision": {
          "enum": ["blocked_after_run", "hold_for_human_review", "ready_after_post_run_gates"]
        },
        "post_run_gate_set_status": { "enum": ["blocked", "review_required", "passed"] },
        "execution_allowed": { "type": "boolean" },
        "execution_performed": { "type": "boolean" },
        "external_transfer_allowed": { "type": "boolean" },
        "protected_action_execution_allowed": { "type": "boolean" },
        "client_facing_ready": { "type": "boolean" },
        "delivery_ready": { "type": "boolean" },
        "final_action_executed": { "type": "boolean" },
        "human_review_required": { "type": "boolean" },
        "post_run_only": { "type": "boolean" }
      },
      "additionalProperties": true
    },
    "post_run_guard": {
      "type": "object",
      "required": [
        "schema_version",
        "post_run_guard_record_id",
        "post_run_gate_framework_contract_id",
        "agent_run_id",
        "workflow_run_id",
        "required_gate_types",
        "missing_gate_types",
        "gate_record_count",
        "post_run_guard_status",
        "execution_allowed",
        "execution_performed",
        "external_transfer_allowed",
        "protected_action_execution_allowed",
        "client_facing_ready",
        "delivery_ready",
        "final_action_executed",
        "human_review_required"
      ],
      "properties": {
        "schema_version": { "const": "workflow-post-run-guard.v1" },
        "post_run_guard_record_id": { "type": "string" },
        "post_run_gate_framework_contract_id": { "const": "workflow-post-run-gate-framework.v1" },
        "agent_run_id": { "type": "string" },
        "workflow_run_id": { "type": "string" },
        "required_gate_types": {
          "type": "array",
          "items": { "type": "string" }
        },
        "missing_gate_types": {
          "type": "array",
          "items": { "type": "string" }
        },
        "gate_record_count": { "type": "integer", "minimum": 0 },
        "post_run_guard_status": { "enum": ["passed", "blocked"] },
        "execution_allowed": { "type": "boolean" },
        "execution_performed": { "type": "boolean" },
        "external_transfer_allowed": { "type": "boolean" },
        "protected_action_execution_allowed": { "type": "boolean" },
        "client_facing_ready": { "type": "boolean" },
        "delivery_ready": { "type": "boolean" },
        "final_action_executed": { "type": "boolean" },
        "human_review_required": { "type": "boolean" }
      },
      "additionalProperties": true
    },
    "validation_item": {
      "type": "object",
      "required": ["check_id", "path", "status", "message"],
      "properties": {
        "check_id": { "type": "string" },
        "path": { "type": "string" },
        "status": { "enum": ["passed", "failed"] },
        "message": { "type": "string" }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
