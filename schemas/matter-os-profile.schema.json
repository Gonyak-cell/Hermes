{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hermes.local/schemas/matter-os-profile.schema.json",
  "title": "Hermes Matter OS Profile",
  "type": "object",
  "required": [
    "schema_version",
    "generated_at",
    "matter_os_profile_id",
    "output_dir",
    "matter_os_profile_status",
    "safe_handling",
    "inputs",
    "source_contracts",
    "matter_os_profile_contract",
    "matter_os_profiles",
    "matter_os_display_fields",
    "matter_os_profile_desktop_boundary",
    "matter_os_profile_checkpoints",
    "validation_items",
    "validation",
    "summary"
  ],
  "properties": {
    "schema_version": { "const": "matter-os-profile.v1" },
    "generated_at": { "type": "string", "format": "date-time" },
    "matter_os_profile_id": { "type": "string", "minLength": 1 },
    "output_dir": { "type": "string", "minLength": 1 },
    "matter_os_profile_status": { "enum": ["complete", "blocked"] },
    "safe_handling": { "$ref": "#/$defs/safe_handling" },
    "inputs": { "$ref": "#/$defs/inputs" },
    "source_contracts": { "type": "object" },
    "matter_os_profile_contract": { "$ref": "#/$defs/contract" },
    "matter_os_profiles": { "type": "array", "items": { "$ref": "#/$defs/profile_card" } },
    "matter_os_display_fields": { "type": "array", "items": { "$ref": "#/$defs/display_fields" } },
    "matter_os_profile_desktop_boundary": { "$ref": "#/$defs/desktop_boundary" },
    "matter_os_profile_checkpoints": { "type": "array", "items": { "$ref": "#/$defs/checkpoint" } },
    "validation_items": { "type": "array", "items": { "$ref": "#/$defs/validation_item" } },
    "validation": { "$ref": "#/$defs/validation" },
    "summary": { "$ref": "#/$defs/summary" }
  },
  "$defs": {
    "inputs": {
      "type": "object",
      "required": [
        "matter_profile_team_ledger_path",
        "client_counterparty_registry_path",
        "matter_contract_freeze_path",
        "law_firm_pack_manifest_path",
        "package_path",
        "roadmap_path"
      ],
      "properties": {
        "matter_profile_team_ledger_path": { "type": "string" },
        "client_counterparty_registry_path": { "type": "string" },
        "matter_contract_freeze_path": { "type": "string" },
        "law_firm_pack_manifest_path": { "type": "string" },
        "package_path": { "type": "string" },
        "roadmap_path": { "type": "string" }
      }
    },
    "safe_handling": {
      "type": "object",
      "required": [
        "report_only",
        "legal_advice_provided",
        "client_facing_output_generated",
        "attorney_review_required",
        "human_review_required",
        "matter_data_write_allowed",
        "runtime_execution_performed",
        "delivery_execution_performed",
        "desktop_mutation_allowed",
        "desktop_source_of_truth",
        "protected_mutation_executed",
        "secret_material_exposed",
        "provider_key_visible"
      ],
      "properties": {
        "report_only": { "const": true },
        "legal_advice_provided": { "const": false },
        "client_facing_output_generated": { "const": false },
        "attorney_review_required": { "const": true },
        "human_review_required": { "const": true },
        "matter_data_write_allowed": { "const": false },
        "runtime_execution_performed": { "const": false },
        "delivery_execution_performed": { "const": false },
        "desktop_mutation_allowed": { "const": false },
        "desktop_source_of_truth": { "const": false },
        "protected_mutation_executed": { "const": false },
        "secret_material_exposed": { "const": false },
        "provider_key_visible": { "const": false }
      }
    },
    "contract": {
      "type": "object",
      "required": [
        "schema_version",
        "contract_id",
        "source_of_truth",
        "profile_card_rule",
        "matter_boundary_rule",
        "attorney_review_rule",
        "desktop_companion_rule",
        "mutation_policy",
        "created_at"
      ],
      "properties": {
        "schema_version": { "const": "matter-os-profile-contract.v1" },
        "contract_id": { "const": "matter-os-profile.v1" },
        "source_of_truth": { "const": "matter_profile_team_ledger_and_client_counterparty_registry" },
        "profile_card_rule": { "type": "string" },
        "matter_boundary_rule": { "type": "string" },
        "attorney_review_rule": { "type": "string" },
        "desktop_companion_rule": { "type": "string" },
        "mutation_policy": { "type": "string" },
        "created_at": { "type": "string", "format": "date-time" }
      }
    },
    "profile_card": {
      "type": "object",
      "required": [
        "schema_version",
        "matter_os_profile_card_id",
        "matter_id",
        "tenant_id",
        "client_id",
        "client_registry_id",
        "client_display_name",
        "client_legal_name",
        "counterparty_party_ids",
        "counterparty_display_names",
        "counterparty_roles",
        "matter_number",
        "matter_name",
        "practice_area",
        "matter_status",
        "profile_status",
        "security_grade",
        "classification",
        "classification_floor",
        "access_scope",
        "matter_boundary_id",
        "wall_ids",
        "conflict_ref_ids",
        "default_policy_snapshot_id",
        "responsible_owner_user_ids",
        "responsible_owner_display_names",
        "reviewer_user_ids",
        "reviewer_display_names",
        "team_member_count",
        "active_team_member_count",
        "attorney_review_required",
        "human_review_required",
        "default_output_status",
        "client_facing_output_generated",
        "legal_advice_provided",
        "desktop_read_only",
        "desktop_mutation_allowed",
        "created_at",
        "source_profile_id",
        "source_team_roster_id",
        "source_schema_version",
        "display_fields",
        "profile_card_status",
        "metadata"
      ],
      "properties": {
        "schema_version": { "const": "matter-os-profile-card.v1" },
        "matter_os_profile_card_id": { "type": "string" },
        "matter_id": { "type": "string" },
        "tenant_id": { "type": "string" },
        "client_id": { "type": "string" },
        "client_registry_id": { "type": ["string", "null"] },
        "client_display_name": { "type": "string", "minLength": 1 },
        "client_legal_name": { "type": "string", "minLength": 1 },
        "counterparty_party_ids": { "type": "array", "items": { "type": "string" } },
        "counterparty_display_names": { "type": "array", "items": { "type": "string" } },
        "counterparty_roles": { "type": "array", "items": { "type": "string" } },
        "matter_number": { "type": "string", "minLength": 1 },
        "matter_name": { "type": "string" },
        "practice_area": { "type": "string" },
        "matter_status": { "type": "string" },
        "profile_status": { "type": "string" },
        "security_grade": { "type": "string", "minLength": 1 },
        "classification": { "type": "string" },
        "classification_floor": { "type": "string" },
        "access_scope": { "type": "string" },
        "matter_boundary_id": { "type": ["string", "null"] },
        "wall_ids": { "type": "array", "items": { "type": "string" } },
        "conflict_ref_ids": { "type": "array", "items": { "type": "string" } },
        "default_policy_snapshot_id": { "type": ["string", "null"] },
        "responsible_owner_user_ids": { "type": "array", "items": { "type": "string" } },
        "responsible_owner_display_names": { "type": "array", "items": { "type": "string" } },
        "reviewer_user_ids": { "type": "array", "items": { "type": "string" } },
        "reviewer_display_names": { "type": "array", "items": { "type": "string" } },
        "team_member_count": { "type": "integer", "minimum": 0 },
        "active_team_member_count": { "type": "integer", "minimum": 0 },
        "attorney_review_required": { "const": true },
        "human_review_required": { "const": true },
        "default_output_status": { "const": "pending_review" },
        "client_facing_output_generated": { "const": false },
        "legal_advice_provided": { "const": false },
        "desktop_read_only": { "const": true },
        "desktop_mutation_allowed": { "const": false },
        "created_at": { "type": "string", "format": "date-time" },
        "source_profile_id": { "type": "string" },
        "source_team_roster_id": { "type": ["string", "null"] },
        "source_schema_version": { "type": ["string", "null"] },
        "display_fields": { "$ref": "#/$defs/display_fields" },
        "profile_card_status": { "enum": ["complete", "blocked"] },
        "metadata": { "type": "object" }
      }
    },
    "display_fields": {
      "type": "object",
      "required": [
        "schema_version",
        "matter_id",
        "client",
        "counterparty",
        "matter_number",
        "security_grade",
        "responsible_owner",
        "display_field_status"
      ],
      "properties": {
        "schema_version": { "const": "matter-os-display-fields.v1" },
        "matter_id": { "type": "string" },
        "client": { "type": "string", "minLength": 1 },
        "counterparty": { "type": "string", "minLength": 1 },
        "matter_number": { "type": "string", "minLength": 1 },
        "security_grade": { "type": "string", "minLength": 1 },
        "responsible_owner": { "type": "string", "minLength": 1 },
        "display_field_status": { "enum": ["complete", "blocked"] }
      }
    },
    "desktop_boundary": {
      "type": "object",
      "required": [
        "schema_version",
        "boundary_id",
        "boundary_status",
        "read_only",
        "mutation_allowed",
        "source_of_truth",
        "matter_data_write_allowed",
        "runtime_execution_allowed",
        "delivery_execution_allowed",
        "legal_advice_allowed",
        "client_facing_output_allowed_without_attorney_review",
        "attorney_review_required",
        "human_review_required",
        "default_output_status",
        "created_at"
      ],
      "properties": {
        "schema_version": { "const": "matter-os-profile-desktop-boundary.v1" },
        "boundary_id": { "type": "string" },
        "boundary_status": { "const": "enforced" },
        "read_only": { "const": true },
        "mutation_allowed": { "const": false },
        "source_of_truth": { "const": false },
        "matter_data_write_allowed": { "const": false },
        "runtime_execution_allowed": { "const": false },
        "delivery_execution_allowed": { "const": false },
        "legal_advice_allowed": { "const": false },
        "client_facing_output_allowed_without_attorney_review": { "const": false },
        "attorney_review_required": { "const": true },
        "human_review_required": { "const": true },
        "default_output_status": { "const": "pending_review" },
        "created_at": { "type": "string", "format": "date-time" }
      }
    },
    "checkpoint": {
      "type": "object",
      "required": ["schema_version", "checkpoint_id", "checkpoint_status", "status", "message"],
      "properties": {
        "schema_version": { "const": "matter-os-profile-checkpoint.v1" },
        "checkpoint_id": { "type": "string" },
        "checkpoint_status": { "enum": ["passed", "failed"] },
        "status": { "enum": ["passed", "failed"] },
        "message": { "type": "string" },
        "passed_count": { "type": "integer", "minimum": 0 },
        "expected_count": { "type": "integer", "minimum": 0 }
      }
    },
    "validation_item": {
      "type": "object",
      "required": ["path", "check_id", "status", "message"],
      "properties": {
        "path": { "type": "string" },
        "check_id": { "type": "string" },
        "status": { "enum": ["passed", "failed"] },
        "message": { "type": "string" },
        "schema_version": { "type": "string" },
        "checkpoint_status": { "enum": ["passed", "failed"] },
        "checkpoint_id": { "type": "string" },
        "passed_count": { "type": "integer", "minimum": 0 },
        "expected_count": { "type": "integer", "minimum": 0 }
      }
    },
    "validation": {
      "type": "object",
      "required": ["valid", "errors"],
      "properties": {
        "valid": { "type": "boolean" },
        "errors": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["path", "message", "status"],
            "properties": {
              "path": { "type": "string" },
              "message": { "type": "string" },
              "status": { "type": "string" }
            }
          }
        }
      }
    },
    "summary": {
      "type": "object",
      "required": [
        "matter_os_profile_status",
        "matter_os_profile_contract_id",
        "source_of_truth",
        "source_matter_profile_team_ledger_status",
        "source_client_counterparty_registry_status",
        "source_matter_contract_freeze_status",
        "source_law_firm_pack_manifest_status",
        "matter_os_profile_count",
        "complete_profile_card_count",
        "display_field_coverage_count",
        "client_display_coverage_count",
        "counterparty_display_coverage_count",
        "matter_number_coverage_count",
        "security_grade_coverage_count",
        "responsible_owner_coverage_count",
        "matter_boundary_coverage_count",
        "profile_card_complete_count",
        "attorney_review_required_profile_count",
        "human_review_required_profile_count",
        "default_pending_review_profile_count",
        "legal_advice_provided",
        "client_facing_output_generated",
        "desktop_boundary_status",
        "desktop_read_only",
        "desktop_mutation_allowed",
        "desktop_source_of_truth",
        "matter_data_write_allowed",
        "runtime_execution_allowed",
        "delivery_execution_allowed",
        "client_facing_output_allowed_without_attorney_review",
        "failed_checkpoint_count",
        "validation_item_count",
        "validation_error_count"
      ],
      "properties": {
        "matter_os_profile_status": { "enum": ["complete", "blocked"] },
        "matter_os_profile_contract_id": { "const": "matter-os-profile.v1" },
        "source_of_truth": { "const": "matter_profile_team_ledger_and_client_counterparty_registry" },
        "source_matter_profile_team_ledger_status": { "type": "string" },
        "source_client_counterparty_registry_status": { "type": "string" },
        "source_matter_contract_freeze_status": { "type": "string" },
        "source_law_firm_pack_manifest_status": { "type": "string" },
        "matter_os_profile_count": { "type": "integer", "minimum": 0 },
        "complete_profile_card_count": { "type": "integer", "minimum": 0 },
        "display_field_coverage_count": { "type": "integer", "minimum": 0 },
        "client_display_coverage_count": { "type": "integer", "minimum": 0 },
        "counterparty_display_coverage_count": { "type": "integer", "minimum": 0 },
        "matter_number_coverage_count": { "type": "integer", "minimum": 0 },
        "security_grade_coverage_count": { "type": "integer", "minimum": 0 },
        "responsible_owner_coverage_count": { "type": "integer", "minimum": 0 },
        "matter_boundary_coverage_count": { "type": "integer", "minimum": 0 },
        "profile_card_complete_count": { "type": "integer", "minimum": 0 },
        "attorney_review_required_profile_count": { "type": "integer", "minimum": 0 },
        "human_review_required_profile_count": { "type": "integer", "minimum": 0 },
        "default_pending_review_profile_count": { "type": "integer", "minimum": 0 },
        "legal_advice_provided": { "const": false },
        "client_facing_output_generated": { "const": false },
        "desktop_boundary_status": { "type": "string" },
        "desktop_read_only": { "const": true },
        "desktop_mutation_allowed": { "const": false },
        "desktop_source_of_truth": { "const": false },
        "matter_data_write_allowed": { "const": false },
        "runtime_execution_allowed": { "const": false },
        "delivery_execution_allowed": { "const": false },
        "client_facing_output_allowed_without_attorney_review": { "const": false },
        "failed_checkpoint_count": { "type": "integer", "minimum": 0 },
        "validation_item_count": { "type": "integer", "minimum": 0 },
        "validation_error_count": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
