        "production_pass_enabled": { "const": false },
        "enterprise_trust_claim_allowed_now": { "const": false },
        "validation_error_count": { "type": "number" }
      }
    },
    "ui_projection_replay_ledger_boundary": {
      "type": "object",
      "required": [
        "p33600_contract_ready",
        "ready_for_clarification_replay_capture_handoff",
        "source_p33200_ready_for_ui_projection_replay_ledger",
