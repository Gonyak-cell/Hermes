            "properties": {
              "codex_final_approval_allowed": { "const": false },
              "claude_final_approval_allowed": { "const": false },
              "human_gate_completion_enabled": { "const": false }
            },
            "additionalProperties": true
          }
        ]
      }
    },
    "combined_status_rows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "allOf": [
          { "$ref": "#/$defs/row" },
          {
            "type": "object",
            "required": [
              "project_id",
              "validation_ready",
              "review_boundary_ready",
              "next_actions_ready",
              "commit_checkpoint_ready",
              "session_handoff_ready",
              "production_pass_enabled",
              "enterprise_pass_enabled",
              "read_only"
            ],
            "properties": {
              "production_pass_enabled": { "const": false },
              "enterprise_pass_enabled": { "const": false },
              "read_only": { "const": true }
            },
            "additionalProperties": true
          }
        ]
      }
    },
