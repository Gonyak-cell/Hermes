{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://amic.local/hermes/human-review-cycle-reviewer-console.schema.json",
  "title": "Hermes Human Review Cycle Reviewer Console",
  "type": "object",
  "required": [
    "schema_version",
    "generated_at",
    "console_id",
    "output_dir",
    "console_status",
    "safe_handling",
    "sources",
    "summary",
    "actor_consoles",
    "console_items",
    "validation"
  ],
  "properties": {
    "schema_version": { "const": "human-review-cycle-reviewer-console.v1" },
    "generated_at": { "type": "string", "format": "date-time" },
    "console_id": { "type": "string" },
    "output_dir": { "type": "string" },
    "console_status": { "$ref": "#/$defs/status" },
    "safe_handling": { "$ref": "#/$defs/top_safe_handling" },
    "sources": { "type": "array", "items": { "$ref": "#/$defs/source" } },
    "summary": {
      "type": "object",
      "required": [
        "console_status",
        "source_count",
        "unavailable_source_count",
        "source_triage_item_count",
        "source_context_card_count",
        "source_decision_row_count",
        "actor_console_count",
        "console_item_count",
        "ready_for_human_review_count",
        "ready_for_application_count",
        "attention_count",
        "blocked_count",
        "protected_action_count",
        "evidence_decision_count",
        "target_file_count",
        "missing_context_card_count",
        "missing_decision_row_count",
        "validation_error_count",
        "by_required_actor",
        "by_gate_type",
        "by_console_status",
        "by_priority"
      ],
      "properties": {
        "console_status": { "$ref": "#/$defs/status" },
        "source_count": { "type": "integer", "minimum": 0 },
        "unavailable_source_count": { "type": "integer", "minimum": 0 },
        "source_triage_item_count": { "type": "integer", "minimum": 0 },
        "source_context_card_count": { "type": "integer", "minimum": 0 },
        "source_decision_row_count": { "type": "integer", "minimum": 0 },
        "actor_console_count": { "type": "integer", "minimum": 0 },
        "console_item_count": { "type": "integer", "minimum": 0 },
        "ready_for_human_review_count": { "type": "integer", "minimum": 0 },
        "ready_for_application_count": { "type": "integer", "minimum": 0 },
        "attention_count": { "type": "integer", "minimum": 0 },
        "blocked_count": { "type": "integer", "minimum": 0 },
        "protected_action_count": { "type": "integer", "minimum": 0 },
        "evidence_decision_count": { "type": "integer", "minimum": 0 },
        "target_file_count": { "type": "integer", "minimum": 0 },
        "missing_context_card_count": { "type": "integer", "minimum": 0 },
        "missing_decision_row_count": { "type": "integer", "minimum": 0 },
        "validation_error_count": { "type": "integer", "minimum": 0 },
        "by_required_actor": { "type": "object" },
        "by_gate_type": { "type": "object" },
        "by_console_status": { "type": "object" },
        "by_priority": { "type": "object" }
      }
    },
    "actor_consoles": { "type": "array", "items": { "$ref": "#/$defs/actor_console" } },
    "console_items": { "type": "array", "items": { "$ref": "#/$defs/console_item" } },
    "validation": { "$ref": "#/$defs/validation" }
  },
  "$defs": {
    "status": {
      "enum": ["clear", "ready_for_human_review", "ready_for_application", "attention", "blocked"]
    },
    "source": {
      "type": "object",
      "required": ["source_id", "label", "path", "available", "schema_version", "generated_at", "summary", "error"],
      "properties": {
        "source_id": { "type": "string" },
        "label": { "type": "string" },
        "path": { "type": "string" },
        "available": { "type": "boolean" },
        "schema_version": { "type": ["string", "null"] },
        "generated_at": { "type": ["string", "null"], "format": "date-time" },
        "summary": { "type": ["object", "null"] },
        "error": { "type": ["string", "null"] }
      }
    },
    "actor_console": {
      "type": "object",
      "required": [
        "actor_console_id",
        "required_actor",
        "console_status",
        "priority",
        "console_item_count",
        "ready_for_human_review_count",
        "ready_for_application_count",
        "attention_count",
        "blocked_count",
        "protected_action_count",
        "evidence_decision_count",
        "target_file_count",
        "missing_context_card_count",
        "missing_decision_row_count",
        "top_console_item_ids",
        "console_json_path",
        "console_markdown_path",
        "console_html_path",
        "safe_handling"
      ],
      "properties": {
        "actor_console_id": { "type": "string" },
        "required_actor": { "type": "string" },
        "console_status": { "$ref": "#/$defs/status" },
        "priority": { "enum": ["critical", "high", "medium", "low"] },
        "console_item_count": { "type": "integer", "minimum": 0 },
        "ready_for_human_review_count": { "type": "integer", "minimum": 0 },
        "ready_for_application_count": { "type": "integer", "minimum": 0 },
        "attention_count": { "type": "integer", "minimum": 0 },
        "blocked_count": { "type": "integer", "minimum": 0 },
        "protected_action_count": { "type": "integer", "minimum": 0 },
        "evidence_decision_count": { "type": "integer", "minimum": 0 },
        "target_file_count": { "type": "integer", "minimum": 0 },
        "missing_context_card_count": { "type": "integer", "minimum": 0 },
        "missing_decision_row_count": { "type": "integer", "minimum": 0 },
        "top_console_item_ids": { "type": "array", "items": { "type": "string" } },
        "console_json_path": { "type": "string" },
        "console_markdown_path": { "type": "string" },
        "console_html_path": { "type": "string" },
        "safe_handling": { "$ref": "#/$defs/actor_safe_handling" }
      }
    },
    "console_item": {
      "type": "object",
      "required": [
        "console_item_id",
        "console_rank",
        "triage_item_id",
        "triage_rank",
        "actor_console_id",
        "gate_item_id",
        "receipt_id",
        "required_actor",
        "gate_type",
        "priority",
        "console_status",
        "triage_status",
        "protected_action",
        "evidence_decision",
        "target_receipt_input_path",
        "target_decision_json_path",
        "title",
        "reason",
        "subject_ref",
        "context_card_id",
        "decision_row_id",
        "context_summary",
        "allowed_outcomes",
        "required_receipt_fields",
        "missing_required_fields",
        "mismatch_fields",
        "receipt_row_status",
        "receipt_row_outcome",
        "review_instructions",
        "recommended_actions",
        "next_commands",
        "source_refs",
        "safe_handling"
      ],
      "properties": {
        "console_item_id": { "type": "string" },
        "console_rank": { "type": "integer", "minimum": 1 },
        "triage_item_id": { "type": "string" },
        "triage_rank": { "type": "integer", "minimum": 1 },
        "actor_console_id": { "type": "string" },
        "gate_item_id": { "type": "string" },
        "receipt_id": { "type": ["string", "null"] },
        "required_actor": { "type": "string" },
        "gate_type": { "type": "string" },
        "priority": { "enum": ["critical", "high", "medium", "low"] },
        "console_status": { "$ref": "#/$defs/status" },
        "triage_status": { "type": "string" },
        "protected_action": { "type": "boolean" },
        "evidence_decision": { "type": "boolean" },
        "target_receipt_input_path": { "type": ["string", "null"] },
        "target_decision_json_path": { "type": ["string", "null"] },
        "title": { "type": "string" },
        "reason": { "type": "string" },
        "subject_ref": { "type": ["object", "null"] },
        "context_card_id": { "type": ["string", "null"] },
        "decision_row_id": { "type": ["string", "null"] },
        "context_summary": { "type": "object" },
        "allowed_outcomes": { "type": "array", "items": { "type": "string" } },
        "required_receipt_fields": { "type": "array", "items": { "type": "string" } },
        "missing_required_fields": { "type": "array", "items": { "type": "string" } },
        "mismatch_fields": { "type": "array", "items": { "type": "string" } },
        "receipt_row_status": { "type": ["string", "null"] },
        "receipt_row_outcome": { "type": ["string", "null"] },
        "review_instructions": { "type": "array", "items": { "type": "string" } },
        "recommended_actions": { "type": "array", "items": { "type": "string" } },
        "next_commands": { "type": "array", "items": { "type": "string" } },
        "source_refs": { "type": "object" },
        "safe_handling": {
          "type": "object",
          "required": ["auto_execute_allowed", "view_only", "protected_actions_executed", "receipt_edits_must_be_manual"],
          "properties": {
            "auto_execute_allowed": { "const": false },
            "view_only": { "type": "boolean" },
            "protected_actions_executed": { "const": false },
            "receipt_edits_must_be_manual": { "type": "boolean" }
          }
        }
      }
    },
    "top_safe_handling": {
      "type": "object",
      "required": ["auto_execute_allowed", "draft_only", "view_only", "protected_actions_executed", "receipt_edits_must_be_manual"],
      "properties": {
        "auto_execute_allowed": { "const": false },
        "draft_only": { "type": "boolean" },
        "view_only": { "type": "boolean" },
        "protected_actions_executed": { "const": false },
        "receipt_edits_must_be_manual": { "type": "boolean" }
      }
    },
    "actor_safe_handling": {
      "type": "object",
      "required": ["auto_execute_allowed", "draft_only", "view_only", "protected_actions_executed"],
      "properties": {
        "auto_execute_allowed": { "const": false },
        "draft_only": { "type": "boolean" },
        "view_only": { "type": "boolean" },
        "protected_actions_executed": { "const": false }
      }
    },
    "validation": {
      "type": "object",
      "required": ["valid", "errors"],
      "properties": {
        "valid": { "type": "boolean" },
        "errors": { "type": "array", "items": { "$ref": "#/$defs/validation_error" } }
      }
    },
    "validation_error": {
      "type": "object",
      "required": ["path", "message"],
      "properties": {
        "path": { "type": "string" },
        "message": { "type": "string" }
      }
    }
  }
}
