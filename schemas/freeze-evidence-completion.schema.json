{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hermes.local/schemas/freeze-evidence-completion.schema.json",
  "title": "Hermes Freeze Evidence Completion",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "capability_id",
    "program_range",
    "source_program_range",
    "freeze_completion_contract",
    "freeze_completion_phase_rows",
    "freeze_completion_inventory_rows",
    "claude_review_execution_rows",
    "completion_review_receipt_rows",
    "finding_remediation_rows",
    "revalidation_evidence_rows",
    "p17601_handoff_gate_rows",
    "blocker_burndown_rows",
    "completion_operator_projection_rows",
    "completion_authority_guard_rows",
    "p17600_closeout_rows",
    "freeze_completion_boundary",
    "freeze_completion_validation_items",
    "validation",
    "summary"
  ],
  "properties": {
    "schema_version": { "const": "freeze-evidence-completion.v1" },
    "capability_id": { "const": "platform.freeze_evidence_completion" },
    "program_range": { "const": "P17201-P17600" },
    "source_program_range": { "const": "P16801-P17200" },
    "freeze_completion_phase_rows": { "type": "array", "minItems": 10, "items": { "$ref": "#/$defs/verdictRow" } },
    "freeze_completion_inventory_rows": { "type": "array", "minItems": 6, "items": { "$ref": "#/$defs/verdictRow" } },
    "claude_review_execution_rows": { "type": "array", "minItems": 6, "items": { "$ref": "#/$defs/verdictRow" } },
    "completion_review_receipt_rows": { "type": "array", "minItems": 6, "items": { "$ref": "#/$defs/verdictRow" } },
    "finding_remediation_rows": { "type": "array", "minItems": 6, "items": { "$ref": "#/$defs/verdictRow" } },
    "revalidation_evidence_rows": { "type": "array", "minItems": 6, "items": { "$ref": "#/$defs/verdictRow" } },
    "p17601_handoff_gate_rows": { "type": "array", "minItems": 6, "items": { "$ref": "#/$defs/verdictRow" } },
    "blocker_burndown_rows": { "type": "array", "minItems": 6, "items": { "$ref": "#/$defs/verdictRow" } },
    "completion_operator_projection_rows": { "type": "array", "minItems": 6, "items": { "$ref": "#/$defs/verdictRow" } },
    "completion_authority_guard_rows": { "type": "array", "minItems": 6, "items": { "$ref": "#/$defs/verdictRow" } },
    "p17600_closeout_rows": { "type": "array", "minItems": 6, "items": { "$ref": "#/$defs/verdictRow" } },
    "freeze_completion_boundary": {
      "type": "object",
      "required": [
        "source_p17200_available",
        "source_p17200_ready_for_p17201_handoff",
        "source_block_visible_now",
        "claude_completion_review_receipt_present_now",
        "claude_completion_review_block_visible_now",
        "finding_remediation_ready",
        "unresolved_finding_count",
        "blocking_finding_count",
        "revalidation_receipt_present_now",
        "revalidation_block_visible_now",
        "p17601_handoff_gate_ready",
        "blocker_burndown_ready",
        "completion_operator_projection_ready",
        "completion_authority_guard_ready",
        "p17600_closeout_ready",
        "ready_for_p17601_handoff",
        "deployment_allowed_now",
        "release_approval_allowed_now",
        "production_pass_enabled",
        "enterprise_pass_enabled",
        "enterprise_trust_claim_allowed_now",
        "protected_closeout_enabled",
        "human_gate_bypass_allowed_now",
        "independent_review_bypass_allowed_now",
        "single_owner_enterprise_trust_allowed_now",
        "environment_config_write_allowed_now",
        "migration_execution_allowed_now",
        "rollback_execution_allowed_now",
        "runtime_execution_allowed_now",
        "write_action_allowed_now",
        "protected_action_allowed_now",
        "connector_write_enabled",
        "external_service_mutation_allowed_now",
        "secret_read_allowed_now",
        "raw_source_exposure_allowed",
        "reviewer_mutation_allowed_now",
        "final_approval_ui_enabled",
        "codex_final_approval_ui_enabled",
        "claude_final_approval_ui_enabled",
        "unsafe_flag_count"
      ],
      "properties": {
        "source_p17200_available": { "type": "boolean" },
        "source_p17200_ready_for_p17201_handoff": { "type": "boolean" },
        "source_block_visible_now": { "type": "boolean" },
        "claude_completion_review_receipt_present_now": { "type": "boolean" },
        "claude_completion_review_block_visible_now": { "type": "boolean" },
        "finding_remediation_ready": { "type": "boolean" },
        "unresolved_finding_count": { "type": "integer", "minimum": 0 },
        "blocking_finding_count": { "type": "integer", "minimum": 0 },
        "revalidation_receipt_present_now": { "type": "boolean" },
        "revalidation_block_visible_now": { "type": "boolean" },
        "p17601_handoff_gate_ready": { "type": "boolean" },
        "blocker_burndown_ready": { "type": "boolean" },
        "completion_operator_projection_ready": { "type": "boolean" },
        "completion_authority_guard_ready": { "type": "boolean" },
        "p17600_closeout_ready": { "type": "boolean" },
        "ready_for_p17601_handoff": { "type": "boolean" },
        "deployment_allowed_now": { "const": false },
        "release_approval_allowed_now": { "const": false },
        "production_pass_enabled": { "const": false },
        "enterprise_pass_enabled": { "const": false },
        "enterprise_trust_claim_allowed_now": { "const": false },
        "protected_closeout_enabled": { "const": false },
        "human_gate_bypass_allowed_now": { "const": false },
        "independent_review_bypass_allowed_now": { "const": false },
        "single_owner_enterprise_trust_allowed_now": { "const": false },
        "environment_config_write_allowed_now": { "const": false },
        "migration_execution_allowed_now": { "const": false },
        "rollback_execution_allowed_now": { "const": false },
        "runtime_execution_allowed_now": { "const": false },
        "write_action_allowed_now": { "const": false },
        "protected_action_allowed_now": { "const": false },
        "connector_write_enabled": { "const": false },
        "external_service_mutation_allowed_now": { "const": false },
        "secret_read_allowed_now": { "const": false },
        "raw_source_exposure_allowed": { "const": false },
        "reviewer_mutation_allowed_now": { "const": false },
        "final_approval_ui_enabled": { "const": false },
        "codex_final_approval_ui_enabled": { "const": false },
        "claude_final_approval_ui_enabled": { "const": false },
        "unsafe_flag_count": { "const": 0 }
      }
    },
    "validation": {
      "type": "object",
      "required": ["valid", "error_count", "errors"],
      "properties": {
        "valid": { "type": "boolean" },
        "error_count": { "type": "integer", "minimum": 0 },
        "errors": { "type": "array" }
      }
    },
    "summary": {
      "type": "object",
      "required": [
        "freeze_evidence_completion_status",
        "program_range",
        "source_p17200_ready_for_p17201_handoff",
        "source_block_visible_now",
        "claude_completion_review_receipt_present_now",
        "claude_completion_review_block_visible_now",
        "finding_remediation_ready",
        "unresolved_finding_count",
        "blocking_finding_count",
        "revalidation_receipt_present_now",
        "revalidation_block_visible_now",
        "p17601_handoff_gate_ready",
        "ready_for_p17601_handoff",
        "deployment_allowed_now",
        "release_approval_allowed_now",
        "production_pass_enabled",
        "enterprise_pass_enabled",
        "enterprise_trust_claim_allowed_now",
        "validation_error_count"
      ],
      "properties": {
        "freeze_evidence_completion_status": {
          "enum": ["ready_for_freeze_evidence_completion", "blocked_freeze_evidence_completion"]
        },
        "program_range": { "const": "P17201-P17600" },
        "deployment_allowed_now": { "const": false },
        "release_approval_allowed_now": { "const": false },
        "production_pass_enabled": { "const": false },
        "enterprise_pass_enabled": { "const": false },
        "enterprise_trust_claim_allowed_now": { "const": false }
      }
    }
  },
  "$defs": {
    "verdictRow": {
      "type": "object",
      "required": ["row_id", "category", "label", "required", "observed", "evidence_ref", "current_verdict"],
      "properties": {
        "row_id": { "type": "string", "minLength": 1 },
        "category": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "required": { "type": "boolean" },
        "observed": { "type": "boolean" },
        "evidence_ref": { "type": "string", "minLength": 1 },
        "current_verdict": { "enum": ["pass", "blocked"] },
        "block_reason": { "type": ["string", "null"] }
      }
    }
  }
}
