{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://amic.local/hermes/tool-runtime-policy-enforcement.schema.json",
  "title": "Hermes Tool Runtime Policy Enforcement",
  "type": "object",
  "required": [
    "schema_version",
    "generated_at",
    "tool_runtime_policy_enforcement_id",
    "output_dir",
    "inputs",
    "source_runtime_agentrun_contract",
    "source_policy_matrix_catalog",
    "source_capability_workflow_contract",
    "source_model_policy_enforcement",
    "tool_runtime_policy_catalog",
    "validation_items",
    "validation",
    "summary"
  ],
  "properties": {
    "schema_version": { "const": "tool-runtime-policy-enforcement.v1" },
    "generated_at": { "type": "string", "format": "date-time" },
    "tool_runtime_policy_enforcement_id": { "type": "string" },
    "output_dir": { "type": "string" },
    "inputs": {
      "type": "object",
      "required": [
        "runtime_agentrun_contract_freeze_path",
        "policy_matrix_catalog_path",
        "capability_workflow_contract_freeze_path",
        "model_policy_enforcement_path"
      ],
      "properties": {
        "runtime_agentrun_contract_freeze_path": { "type": "string" },
        "policy_matrix_catalog_path": { "type": "string" },
        "capability_workflow_contract_freeze_path": { "type": "string" },
        "model_policy_enforcement_path": { "type": "string" }
      }
    },
    "source_runtime_agentrun_contract": { "$ref": "#/$defs/source_summary" },
    "source_policy_matrix_catalog": { "$ref": "#/$defs/source_summary" },
    "source_capability_workflow_contract": { "$ref": "#/$defs/source_summary" },
    "source_model_policy_enforcement": { "$ref": "#/$defs/source_summary" },
    "tool_runtime_policy_catalog": {
      "type": "object",
      "required": ["schema_version", "generated_at", "runtime_policy_gates", "tool_permission_gates", "agent_run_tool_gates"],
      "properties": {
        "schema_version": { "const": "tool-runtime-policy-catalog.v1" },
        "generated_at": { "type": "string", "format": "date-time" },
        "runtime_policy_gates": { "type": "array", "items": { "$ref": "#/$defs/runtime_policy_gate" } },
        "tool_permission_gates": { "type": "array", "items": { "$ref": "#/$defs/tool_permission_gate" } },
        "agent_run_tool_gates": { "type": "array", "items": { "$ref": "#/$defs/agent_run_tool_gate" } }
      }
    },
    "validation_items": { "type": "array", "items": { "$ref": "#/$defs/validation_item" } },
    "validation": { "$ref": "#/$defs/validation" },
    "summary": { "$ref": "#/$defs/summary" }
  },
  "$defs": {
    "source_summary": {
      "type": "object",
      "properties": {
        "schema_version": { "type": ["string", "null"] },
        "error": { "type": ["string", "null"] }
      },
      "additionalProperties": true
    },
    "runtime_policy_gate": {
      "type": "object",
      "required": [
        "schema_version",
        "runtime_policy_gate_id",
        "runtime_id",
        "adapter_id",
        "classification",
        "runtime_rule_id",
        "runtime_policy_decision",
        "gate_status",
        "external_execution",
        "sandbox_required",
        "network_policy",
        "workspace_isolation_type",
        "command_binding_id",
        "command_availability_status",
        "required_gates",
        "reason_codes",
        "decided_at",
        "metadata"
      ],
      "properties": {
        "schema_version": { "const": "runtime-policy-gate.v1" },
        "runtime_policy_gate_id": { "type": "string" },
        "runtime_id": { "type": "string" },
        "adapter_id": { "type": "string" },
        "classification": { "type": "string" },
        "runtime_rule_id": { "type": "string" },
        "runtime_policy_decision": { "enum": ["allow", "review", "deny"] },
        "gate_status": { "enum": ["passed", "requires_approval", "blocked"] },
        "external_execution": { "type": "boolean" },
        "sandbox_required": { "type": "boolean" },
        "network_policy": { "type": "string" },
        "workspace_isolation_type": { "type": "string" },
        "command_binding_id": { "type": ["string", "null"] },
        "command_availability_status": { "type": "string" },
        "required_gates": { "type": "array", "items": { "type": "string" } },
        "reason_codes": { "type": "array", "items": { "type": "string" } },
        "decided_at": { "type": "string", "format": "date-time" },
        "metadata": { "type": "object" }
      }
    },
    "tool_permission_gate": {
      "type": "object",
      "required": [
        "schema_version",
        "tool_permission_gate_id",
        "runtime_id",
        "adapter_id",
        "tool_id",
        "requested_state",
        "tool_policy_known",
        "default_policy",
        "approval_required",
        "gate_decision",
        "gate_status",
        "protected_action",
        "required_gates",
        "forbidden_by_runtime",
        "allowed_by_runtime",
        "reason_codes",
        "decided_at",
        "metadata"
      ],
      "properties": {
        "schema_version": { "const": "tool-permission-gate.v1" },
        "tool_permission_gate_id": { "type": "string" },
        "runtime_id": { "type": "string" },
        "adapter_id": { "type": "string" },
        "tool_id": { "type": "string" },
        "requested_state": { "enum": ["allowed", "forbidden"] },
        "tool_policy_known": { "type": "boolean" },
        "default_policy": { "type": "string" },
        "approval_required": { "type": "boolean" },
        "gate_decision": { "enum": ["allow", "review", "deny"] },
        "gate_status": { "enum": ["passed", "requires_approval", "blocked"] },
        "protected_action": { "type": "boolean" },
        "required_gates": { "type": "array", "items": { "type": "string" } },
        "forbidden_by_runtime": { "type": "boolean" },
        "allowed_by_runtime": { "type": "boolean" },
        "reason_codes": { "type": "array", "items": { "type": "string" } },
        "decided_at": { "type": "string", "format": "date-time" },
        "metadata": { "type": "object" }
      }
    },
    "agent_run_tool_gate": {
      "type": "object",
      "required": [
        "schema_version",
        "agent_run_tool_gate_id",
        "agent_run_id",
        "workflow_run_id",
        "capability_id",
        "domain_pack",
        "runtime_id",
        "adapter_id",
        "runtime_known",
        "runtime_allowed_by_capability",
        "capability_requires_tool_permission_gate",
        "runtime_requires_tool_permission_gate",
        "requested_tool_count",
        "allowed_tool_count",
        "forbidden_tool_count",
        "approval_required_tool_count",
        "runtime_blocked_classification_count",
        "runtime_review_classification_count",
        "model_route_blocked_count",
        "gate_decision",
        "gate_status",
        "audit_required",
        "human_approval_required",
        "required_gates",
        "reason_codes",
        "decided_at",
        "metadata"
      ],
      "properties": {
        "schema_version": { "const": "agent-run-tool-gate.v1" },
        "agent_run_tool_gate_id": { "type": "string" },
        "agent_run_id": { "type": "string" },
        "workflow_run_id": { "type": "string" },
        "capability_id": { "type": "string" },
        "domain_pack": { "type": "string" },
        "runtime_id": { "type": "string" },
        "adapter_id": { "type": ["string", "null"] },
        "runtime_known": { "type": "boolean" },
        "runtime_allowed_by_capability": { "type": "boolean" },
        "capability_requires_tool_permission_gate": { "type": "boolean" },
        "runtime_requires_tool_permission_gate": { "type": "boolean" },
        "requested_tool_count": { "type": "integer", "minimum": 0 },
        "allowed_tool_count": { "type": "integer", "minimum": 0 },
        "forbidden_tool_count": { "type": "integer", "minimum": 0 },
        "approval_required_tool_count": { "type": "integer", "minimum": 0 },
        "runtime_blocked_classification_count": { "type": "integer", "minimum": 0 },
        "runtime_review_classification_count": { "type": "integer", "minimum": 0 },
        "model_route_blocked_count": { "type": "integer", "minimum": 0 },
        "gate_decision": { "enum": ["allow", "review", "deny"] },
        "gate_status": { "enum": ["passed", "requires_approval", "blocked"] },
        "audit_required": { "type": "boolean" },
        "human_approval_required": { "type": "boolean" },
        "required_gates": { "type": "array", "items": { "type": "string" } },
        "reason_codes": { "type": "array", "items": { "type": "string" } },
        "decided_at": { "type": "string", "format": "date-time" },
        "metadata": { "type": "object" }
      }
    },
    "validation_item": {
      "type": "object",
      "required": ["schema_version", "validation_id", "subject_type", "subject_id", "check_id", "status", "message"],
      "properties": {
        "schema_version": { "const": "tool-runtime-policy-validation.v1" },
        "validation_id": { "type": "string" },
        "subject_type": { "type": "string" },
        "subject_id": { "type": "string" },
        "check_id": { "type": "string" },
        "status": { "enum": ["passed", "failed"] },
        "message": { "type": "string" }
      }
    },
    "validation": {
      "type": "object",
      "required": ["valid", "errors"],
      "properties": {
        "valid": { "type": "boolean" },
        "errors": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["path", "message"],
            "properties": {
              "path": { "type": "string" },
              "message": { "type": "string" }
            }
          }
        }
      }
    },
    "summary": {
      "type": "object",
      "required": [
        "tool_runtime_policy_enforcement_status",
        "runtime_policy_gate_count",
        "tool_permission_gate_count",
        "agent_run_tool_gate_count",
        "forbidden_tool_gate_count",
        "forbidden_tool_blocked_count",
        "validation_error_count"
      ],
      "properties": {
        "tool_runtime_policy_enforcement_status": { "enum": ["complete", "blocked"] },
        "source_runtime_contract_status": { "type": "string" },
        "source_policy_matrix_status": { "type": "string" },
        "source_capability_workflow_status": { "type": "string" },
        "source_model_policy_status": { "type": "string" },
        "runtime_policy_gate_count": { "type": "integer", "minimum": 0 },
        "runtime_policy_allow_count": { "type": "integer", "minimum": 0 },
        "runtime_policy_review_count": { "type": "integer", "minimum": 0 },
        "runtime_policy_deny_count": { "type": "integer", "minimum": 0 },
        "tool_permission_gate_count": { "type": "integer", "minimum": 0 },
        "allowed_tool_gate_count": { "type": "integer", "minimum": 0 },
        "forbidden_tool_gate_count": { "type": "integer", "minimum": 0 },
        "forbidden_tool_blocked_count": { "type": "integer", "minimum": 0 },
        "approval_required_tool_gate_count": { "type": "integer", "minimum": 0 },
        "protected_action_tool_gate_count": { "type": "integer", "minimum": 0 },
        "agent_run_tool_gate_count": { "type": "integer", "minimum": 0 },
        "agent_run_tool_gate_passed_count": { "type": "integer", "minimum": 0 },
        "agent_run_tool_gate_review_count": { "type": "integer", "minimum": 0 },
        "agent_run_tool_gate_blocked_count": { "type": "integer", "minimum": 0 },
        "validation_item_count": { "type": "integer", "minimum": 0 },
        "failed_validation_item_count": { "type": "integer", "minimum": 0 },
        "validation_error_count": { "type": "integer", "minimum": 0 },
        "by_runtime_id": { "type": "object" },
        "by_tool_id": { "type": "object" },
        "by_gate_status": { "type": "object" },
        "by_gate_decision": { "type": "object" }
      },
      "additionalProperties": true
    }
  }
}
