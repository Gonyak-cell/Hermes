{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://amic.local/hermes/provided-material-review-ledger.schema.json",
  "title": "Provided Material Review Ledger",
  "type": "object",
  "required": [
    "schema_version",
    "generated_at",
    "provided_material_review_ledger_id",
    "provided_material_review_status",
    "safe_handling",
    "source_contracts",
    "provided_material_review_contract",
    "provided_material_review_rules",
    "provided_material_review_items",
    "provided_material_index_statuses",
    "provided_material_gap_links",
    "provided_material_review_gates",
    "provided_material_matter_summaries",
    "provided_material_review_desktop_boundary",
    "validation_items",
    "validation",
    "summary"
  ],
  "properties": {
    "schema_version": { "const": "provided-material-review-ledger.v1" },
    "generated_at": { "type": "string" },
    "provided_material_review_ledger_id": { "type": "string", "minLength": 1 },
    "output_dir": { "type": "string" },
    "provided_material_review_status": { "enum": ["complete", "attention"] },
    "safe_handling": { "$ref": "#/$defs/safe_handling" },
    "inputs": { "type": "object" },
    "source_contracts": { "type": "object" },
    "provided_material_review_contract": { "type": "object" },
    "provided_material_review_rules": {
      "type": "array",
      "minItems": 6,
      "items": { "$ref": "#/$defs/rule" }
    },
    "provided_material_review_items": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/material_item" }
    },
    "provided_material_index_statuses": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/index_status" }
    },
    "provided_material_gap_links": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/gap_link" }
    },
    "provided_material_review_gates": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/review_gate" }
    },
    "provided_material_matter_summaries": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/matter_summary" }
    },
    "provided_material_review_desktop_boundary": { "$ref": "#/$defs/desktop_boundary" },
    "provided_material_review_checkpoints": { "type": "array" },
    "validation_items": { "type": "array" },
    "validation": { "$ref": "#/$defs/validation" },
    "summary": { "$ref": "#/$defs/summary" }
  },
  "$defs": {
    "safe_handling": {
      "type": "object",
      "required": [
        "report_only",
        "draft_only",
        "deterministic_material_review_performed",
        "legal_conclusion_asserted",
        "legal_advice_provided",
        "client_facing_ready",
        "client_facing_output_generated",
        "final_review_decision_recorded",
        "attorney_review_required",
        "human_review_required",
        "partner_approval_required_before_client_use",
        "matter_data_write_allowed",
        "task_state_write_allowed",
        "workflow_transition_allowed",
        "runtime_execution_performed",
        "delivery_execution_performed",
        "desktop_mutation_allowed",
        "desktop_source_of_truth",
        "protected_mutation_executed"
      ],
      "properties": {
        "report_only": { "const": true },
        "draft_only": { "const": true },
        "deterministic_material_review_performed": { "const": true },
        "legal_conclusion_asserted": { "const": false },
        "legal_advice_provided": { "const": false },
        "client_facing_ready": { "const": false },
        "client_facing_output_generated": { "const": false },
        "final_review_decision_recorded": { "const": false },
        "attorney_review_required": { "const": true },
        "human_review_required": { "const": true },
        "partner_approval_required_before_client_use": { "const": true },
        "matter_data_write_allowed": { "const": false },
        "task_state_write_allowed": { "const": false },
        "workflow_transition_allowed": { "const": false },
        "runtime_execution_performed": { "const": false },
        "delivery_execution_performed": { "const": false },
        "desktop_mutation_allowed": { "const": false },
        "desktop_source_of_truth": { "const": false },
        "protected_mutation_executed": { "const": false }
      }
    },
    "source_ref": {
      "type": "object",
      "required": ["source_kind", "source_id", "source_field"],
      "properties": {
        "source_kind": { "type": "string" },
        "source_id": { "type": "string" },
        "source_field": { "type": "string" }
      }
    },
    "common_review_fields": {
      "type": "object",
      "required": [
        "source_refs",
        "source_ref_count",
        "attorney_review_required",
        "human_review_required",
        "client_facing_ready",
        "legal_conclusion_asserted",
        "legal_advice_provided"
      ],
      "properties": {
        "source_refs": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/source_ref" } },
        "source_ref_count": { "type": "integer", "minimum": 1 },
        "attorney_review_required": { "const": true },
        "human_review_required": { "const": true },
        "client_facing_ready": { "const": false },
        "legal_conclusion_asserted": { "const": false },
        "legal_advice_provided": { "const": false }
      }
    },
    "rule": {
      "type": "object",
      "required": [
        "schema_version",
        "provided_material_review_rule_id",
        "provided_material_review_rule_type",
        "rule_status",
        "deterministic_only",
        "attorney_review_required",
        "human_review_required"
      ],
      "properties": {
        "schema_version": { "const": "provided-material-review-rule.v1" },
        "provided_material_review_rule_id": { "type": "string" },
        "provided_material_review_rule_type": { "type": "string" },
        "rule_status": { "const": "active" },
        "deterministic_only": { "const": true },
        "attorney_review_required": { "const": true },
        "human_review_required": { "const": true }
      }
    },
    "material_item": {
      "allOf": [
        { "$ref": "#/$defs/common_review_fields" },
        {
          "type": "object",
          "required": [
            "schema_version",
            "provided_material_review_item_id",
            "matter_id",
            "source_document_id",
            "source_record_id",
            "document_title",
            "material_review_status",
            "provided_material_index_status_id",
            "provided_material_review_gate_id",
            "classification_bound",
            "client_facing_output_generated",
            "final_review_decision_recorded",
            "matter_data_write_allowed",
            "task_state_write_allowed",
            "workflow_transition_allowed",
            "runtime_execution_allowed",
            "delivery_execution_allowed",
            "protected_action_allowed"
          ],
          "properties": {
            "schema_version": { "const": "provided-material-review-item.v1" },
            "provided_material_review_item_id": { "type": "string" },
            "matter_id": { "type": "string" },
            "source_document_id": { "type": "string" },
            "source_record_id": { "type": "string" },
            "document_title": { "type": "string" },
            "material_review_status": { "enum": ["indexed_pending_attorney_review", "gap_pending_follow_up_review"] },
            "provided_material_index_status_id": { "type": "string" },
            "provided_material_review_gate_id": { "type": "string" },
            "classification_bound": { "const": true },
            "client_facing_output_generated": { "const": false },
            "final_review_decision_recorded": { "const": false },
            "matter_data_write_allowed": { "const": false },
            "task_state_write_allowed": { "const": false },
            "workflow_transition_allowed": { "const": false },
            "runtime_execution_allowed": { "const": false },
            "delivery_execution_allowed": { "const": false },
            "protected_action_allowed": { "const": false }
          }
        }
      ]
    },
    "index_status": {
      "allOf": [
        { "$ref": "#/$defs/common_review_fields" },
        {
          "type": "object",
          "required": [
            "schema_version",
            "provided_material_index_status_id",
            "matter_id",
            "source_document_id",
            "source_record_id",
            "index_binding_status",
            "index_status",
            "matter_data_write_allowed",
            "task_state_write_allowed",
            "workflow_transition_allowed",
            "runtime_execution_allowed",
            "delivery_execution_allowed",
            "protected_action_allowed"
          ],
          "properties": {
            "schema_version": { "const": "provided-material-index-status.v1" },
            "provided_material_index_status_id": { "type": "string" },
            "matter_id": { "type": "string" },
            "source_document_id": { "type": "string" },
            "source_record_id": { "type": "string" },
            "index_binding_status": { "const": "indexed_in_matter_document_index" },
            "index_status": { "type": "string" },
            "matter_data_write_allowed": { "const": false },
            "task_state_write_allowed": { "const": false },
            "workflow_transition_allowed": { "const": false },
            "runtime_execution_allowed": { "const": false },
            "delivery_execution_allowed": { "const": false },
            "protected_action_allowed": { "const": false }
          }
        }
      ]
    },
    "gap_link": {
      "allOf": [
        { "$ref": "#/$defs/common_review_fields" },
        {
          "type": "object",
          "required": [
            "schema_version",
            "provided_material_gap_link_id",
            "matter_id",
            "provided_material_review_item_id",
            "gap_link_status",
            "absence_not_factual_nonexistence"
          ],
          "properties": {
            "schema_version": { "const": "provided-material-gap-link.v1" },
            "provided_material_gap_link_id": { "type": "string" },
            "matter_id": { "type": "string" },
            "provided_material_review_item_id": { "type": "string" },
            "gap_link_status": { "const": "follow_up_required_pending_attorney_review" },
            "absence_not_factual_nonexistence": { "const": true }
          }
        }
      ]
    },
    "review_gate": {
      "allOf": [
        { "$ref": "#/$defs/common_review_fields" },
        {
          "type": "object",
          "required": [
            "schema_version",
            "provided_material_review_gate_id",
            "matter_id",
            "provided_material_review_item_id",
            "review_gate_status",
            "final_review_decision_recorded"
          ],
          "properties": {
            "schema_version": { "const": "provided-material-review-gate.v1" },
            "provided_material_review_gate_id": { "type": "string" },
            "matter_id": { "type": "string" },
            "provided_material_review_item_id": { "type": "string" },
            "review_gate_status": { "const": "pending_attorney_review" },
            "final_review_decision_recorded": { "const": false }
          }
        }
      ]
    },
    "matter_summary": {
      "allOf": [
        { "$ref": "#/$defs/common_review_fields" },
        {
          "type": "object",
          "required": [
            "schema_version",
            "provided_material_matter_summary_id",
            "matter_id",
            "provided_material_matter_status",
            "final_review_decision_recorded"
          ],
          "properties": {
            "schema_version": { "const": "provided-material-matter-summary.v1" },
            "provided_material_matter_summary_id": { "type": "string" },
            "matter_id": { "type": "string" },
            "provided_material_matter_status": { "const": "pending_attorney_review" },
            "final_review_decision_recorded": { "const": false }
          }
        }
      ]
    },
    "desktop_boundary": {
      "type": "object",
      "required": [
        "schema_version",
        "boundary_status",
        "read_only",
        "desktop_mutation_allowed",
        "desktop_source_of_truth",
        "matter_data_write_allowed",
        "task_state_write_allowed",
        "workflow_transition_allowed",
        "runtime_execution_allowed",
        "delivery_execution_allowed",
        "protected_action_allowed",
        "client_facing_output_allowed_without_attorney_review"
      ],
      "properties": {
        "schema_version": { "const": "provided-material-review-desktop-boundary.v1" },
        "boundary_status": { "const": "enforced" },
        "read_only": { "const": true },
        "desktop_mutation_allowed": { "const": false },
        "desktop_source_of_truth": { "const": false },
        "matter_data_write_allowed": { "const": false },
        "task_state_write_allowed": { "const": false },
        "workflow_transition_allowed": { "const": false },
        "runtime_execution_allowed": { "const": false },
        "delivery_execution_allowed": { "const": false },
        "protected_action_allowed": { "const": false },
        "client_facing_output_allowed_without_attorney_review": { "const": false }
      }
    },
    "validation": {
      "type": "object",
      "required": ["valid", "errors"],
      "properties": {
        "valid": { "type": "boolean" },
        "errors": { "type": "array" }
      }
    },
    "summary": {
      "type": "object",
      "required": [
        "provided_material_review_status",
        "source_ldd_vdr_inventory_status",
        "source_matter_document_index_status",
        "source_ldd_document_classification_status",
        "source_contract_draft_workflow_status",
        "provided_material_review_rule_count",
        "material_review_item_count",
        "index_status_count",
        "gap_link_count",
        "review_gate_count",
        "client_facing_ready_count",
        "final_review_decision_count",
        "legal_conclusion_asserted_count",
        "legal_advice_provided",
        "client_facing_output_generated",
        "desktop_boundary_status",
        "desktop_read_only",
        "desktop_mutation_allowed",
        "failed_checkpoint_count",
        "validation_error_count"
      ],
      "properties": {
        "provided_material_review_status": { "enum": ["complete", "attention"] },
        "source_ldd_vdr_inventory_status": { "type": "string" },
        "source_matter_document_index_status": { "type": "string" },
        "source_ldd_document_classification_status": { "type": "string" },
        "source_contract_draft_workflow_status": { "type": "string" },
        "provided_material_review_rule_count": { "type": "integer", "minimum": 6 },
        "material_review_item_count": { "type": "integer", "minimum": 1 },
        "index_status_count": { "type": "integer", "minimum": 1 },
        "gap_link_count": { "type": "integer", "minimum": 1 },
        "review_gate_count": { "type": "integer", "minimum": 1 },
        "client_facing_ready_count": { "const": 0 },
        "final_review_decision_count": { "const": 0 },
        "legal_conclusion_asserted_count": { "const": 0 },
        "legal_advice_provided": { "const": false },
        "client_facing_output_generated": { "const": false },
        "desktop_boundary_status": { "const": "enforced" },
        "desktop_read_only": { "const": true },
        "desktop_mutation_allowed": { "const": false },
        "failed_checkpoint_count": { "const": 0 },
        "validation_error_count": { "const": 0 }
      }
    }
  }
}
