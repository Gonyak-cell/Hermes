{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hermes.local/schemas/docx-renderer.schema.json",
  "title": "DOCX Renderer",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "generated_at",
    "docx_renderer_id",
    "docx_renderer_status",
    "safe_handling",
    "docx_renderer_contract",
    "docx_renderer_boundary",
    "docx_render_jobs",
    "docx_template_data_packets",
    "docx_openxml_parts",
    "docx_output_artifacts",
    "docx_format_validation_results",
    "validation_items",
    "validation",
    "summary"
  ],
  "properties": {
    "schema_version": { "const": "docx-renderer.v1" },
    "generated_at": { "type": "string", "minLength": 1 },
    "docx_renderer_id": { "type": "string", "minLength": 1 },
    "docx_renderer_status": { "const": "complete" },
    "safe_handling": {
      "type": "object",
      "required": [
        "report_only",
        "docx_renderer_generated",
        "draft_artifact_only",
        "template_data_packet_generated",
        "local_deterministic_render_performed",
        "document_renderer_runtime_execution_performed",
        "external_renderer_execution_performed",
        "network_access_performed",
        "docx_binary_write_performed",
        "source_attribution_required",
        "citation_review_required",
        "human_review_required",
        "attorney_review_required",
        "format_validation_required",
        "legal_advice_generated",
        "delivery_execution_performed",
        "protected_mutation_performed",
        "core_registry_mutation_performed",
        "client_facing_output_generated"
      ],
      "properties": {
        "report_only": { "const": true },
        "docx_renderer_generated": { "const": true },
        "draft_artifact_only": { "const": true },
        "template_data_packet_generated": { "const": true },
        "local_deterministic_render_performed": { "const": true },
        "document_renderer_runtime_execution_performed": { "const": false },
        "external_renderer_execution_performed": { "const": false },
        "network_access_performed": { "const": false },
        "docx_binary_write_performed": { "const": true },
        "source_attribution_required": { "const": true },
        "citation_review_required": { "const": true },
        "human_review_required": { "const": true },
        "attorney_review_required": { "const": true },
        "format_validation_required": { "const": true },
        "legal_advice_generated": { "const": false },
        "delivery_execution_performed": { "const": false },
        "protected_mutation_performed": { "const": false },
        "core_registry_mutation_performed": { "const": false },
        "client_facing_output_generated": { "const": false }
      }
    },
    "docx_renderer_contract": {
      "type": "object",
      "required": ["contract_id", "renderer_scope", "source_of_truth", "required_template_format", "required_openxml_parts"],
      "properties": {
        "contract_id": { "const": "docx-renderer.v1" },
        "renderer_scope": { "const": "creative_and_document_domain_pack_docx" },
        "required_template_format": { "const": "docx" },
        "required_openxml_parts": {
          "type": "array",
          "minItems": 4,
          "contains": { "const": "word/document.xml" }
        }
      }
    },
    "docx_renderer_boundary": {
      "type": "object",
      "required": [
        "boundary_status",
        "read_only_sources",
        "local_deterministic_renderer",
        "renderer_execution_allowed",
        "document_renderer_runtime_execution_allowed",
        "external_renderer_execution_allowed",
        "network_access_allowed",
        "docx_binary_write_allowed",
        "core_registry_mutation_allowed",
        "delivery_execution_allowed",
        "protected_action_allowed",
        "client_facing_output_generated",
        "client_facing_ready_count",
        "human_review_required",
        "attorney_review_required",
        "legal_advice_generated"
      ],
      "properties": {
        "boundary_status": { "const": "enforced" },
        "read_only_sources": { "const": true },
        "local_deterministic_renderer": { "const": true },
        "renderer_execution_allowed": { "const": true },
        "document_renderer_runtime_execution_allowed": { "const": false },
        "external_renderer_execution_allowed": { "const": false },
        "network_access_allowed": { "const": false },
        "docx_binary_write_allowed": { "const": true },
        "core_registry_mutation_allowed": { "const": false },
        "delivery_execution_allowed": { "const": false },
        "protected_action_allowed": { "const": false },
        "client_facing_output_generated": { "const": false },
        "client_facing_ready_count": { "const": 0 },
        "human_review_required": { "const": true },
        "attorney_review_required": { "const": true },
        "legal_advice_generated": { "const": false }
      }
    },
    "docx_render_jobs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "docx_render_job_id",
          "docx_render_job_status",
          "template_id",
          "template_format",
          "output_artifact_id",
          "metadata_hash",
          "renderer_execution_performed",
          "local_deterministic_render_performed",
          "document_renderer_runtime_execution_performed",
          "external_renderer_execution_performed",
          "network_access_performed",
          "docx_binary_write_performed",
          "format_validation_required",
          "human_review_required",
          "attorney_review_required",
          "legal_advice_generated",
          "delivery_execution_performed",
          "protected_action_executed",
          "client_facing_ready",
          "client_facing_output_generated"
        ],
        "properties": {
          "docx_render_job_status": { "const": "complete" },
          "template_format": { "const": "docx" },
          "metadata_hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
          "renderer_execution_performed": { "const": true },
          "local_deterministic_render_performed": { "const": true },
          "document_renderer_runtime_execution_performed": { "const": false },
          "external_renderer_execution_performed": { "const": false },
          "network_access_performed": { "const": false },
          "docx_binary_write_performed": { "const": true },
          "format_validation_required": { "const": true },
          "human_review_required": { "const": true },
          "attorney_review_required": { "const": true },
          "legal_advice_generated": { "const": false },
          "delivery_execution_performed": { "const": false },
          "protected_action_executed": { "const": false },
          "client_facing_ready": { "const": false },
          "client_facing_output_generated": { "const": false }
        }
      }
    },
    "docx_template_data_packets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["docx_template_data_packet_id", "packet_status", "template_format", "matter_id", "sections", "human_review_note", "packet_hash"],
        "properties": {
          "packet_status": { "const": "generated" },
          "template_format": { "const": "docx" },
          "sections": { "type": "array", "minItems": 5 },
          "human_review_note": { "type": "string", "minLength": 20 },
          "packet_hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
        }
      }
    },
    "docx_openxml_parts": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "required": ["docx_openxml_part_id", "openxml_part_name", "openxml_part_status", "openxml_payload_hash"],
        "properties": {
          "openxml_part_status": { "const": "generated" },
          "openxml_payload_hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
        }
      }
    },
    "docx_output_artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "docx_output_artifact_id",
          "output_format",
          "output_artifact_status",
          "docx_binary_path",
          "docx_binary_hash",
          "metadata_hash",
          "docx_binary_write_performed",
          "human_review_required",
          "attorney_review_required",
          "legal_advice_generated",
          "delivery_execution_performed",
          "protected_action_executed",
          "client_facing_ready",
          "client_facing_output_generated"
        ],
        "properties": {
          "output_format": { "const": "docx" },
          "output_artifact_status": { "const": "draft_generated" },
          "docx_binary_hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
          "metadata_hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
          "docx_binary_write_performed": { "const": true },
          "human_review_required": { "const": true },
          "attorney_review_required": { "const": true },
          "legal_advice_generated": { "const": false },
          "delivery_execution_performed": { "const": false },
          "protected_action_executed": { "const": false },
          "client_facing_ready": { "const": false },
          "client_facing_output_generated": { "const": false }
        }
      }
    },
    "docx_format_validation_results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["docx_format_validation_result_id", "docx_format_validation_status", "check_count", "passed_check_count", "failed_check_count"],
        "properties": {
          "docx_format_validation_status": { "const": "passed" },
          "failed_check_count": { "const": 0 }
        }
      }
    },
    "validation": {
      "type": "object",
      "required": ["valid", "errors"],
      "properties": {
        "valid": { "const": true },
        "errors": { "type": "array", "maxItems": 0 }
      }
    },
    "summary": {
      "type": "object",
      "required": [
        "docx_renderer_status",
        "docx_renderer_contract_id",
        "source_asset_registry_status",
        "source_style_registry_status",
        "source_template_registry_status",
        "docx_template_count",
        "docx_render_job_count",
        "completed_render_job_count",
        "docx_template_data_packet_count",
        "docx_openxml_part_count",
        "docx_output_artifact_count",
        "draft_output_artifact_count",
        "docx_format_validation_result_count",
        "passed_format_validation_result_count",
        "human_review_required_output_count",
        "attorney_review_required_output_count",
        "local_deterministic_renderer",
        "renderer_execution_performed",
        "document_renderer_runtime_execution_performed",
        "external_renderer_execution_performed",
        "network_access_performed",
        "docx_binary_write_performed",
        "delivery_execution_performed",
        "protected_action_executed",
        "legal_advice_generated",
        "client_facing_output_generated",
        "client_facing_ready_count",
        "failed_checkpoint_count",
        "validation_error_count"
      ],
      "properties": {
        "docx_renderer_status": { "const": "complete" },
        "docx_renderer_contract_id": { "const": "docx-renderer.v1" },
        "source_asset_registry_status": { "const": "complete" },
        "source_style_registry_status": { "const": "complete" },
        "source_template_registry_status": { "const": "complete" },
        "docx_template_count": { "type": "integer", "minimum": 1 },
        "docx_render_job_count": { "type": "integer", "minimum": 1 },
        "completed_render_job_count": { "type": "integer", "minimum": 1 },
        "docx_template_data_packet_count": { "type": "integer", "minimum": 1 },
        "docx_openxml_part_count": { "type": "integer", "minimum": 4 },
        "docx_output_artifact_count": { "type": "integer", "minimum": 1 },
        "draft_output_artifact_count": { "type": "integer", "minimum": 1 },
        "docx_format_validation_result_count": { "type": "integer", "minimum": 1 },
        "passed_format_validation_result_count": { "type": "integer", "minimum": 1 },
        "human_review_required_output_count": { "type": "integer", "minimum": 1 },
        "attorney_review_required_output_count": { "type": "integer", "minimum": 1 },
        "local_deterministic_renderer": { "const": true },
        "renderer_execution_performed": { "const": true },
        "document_renderer_runtime_execution_performed": { "const": false },
        "external_renderer_execution_performed": { "const": false },
        "network_access_performed": { "const": false },
        "docx_binary_write_performed": { "const": true },
        "delivery_execution_performed": { "const": false },
        "protected_action_executed": { "const": false },
        "legal_advice_generated": { "const": false },
        "client_facing_output_generated": { "const": false },
        "client_facing_ready_count": { "const": 0 },
        "failed_checkpoint_count": { "const": 0 },
        "validation_error_count": { "const": 0 }
      }
    }
  }
}
