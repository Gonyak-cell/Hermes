{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hermes.local/schemas/hermes-loop-runtime-tool-governance.schema.json",
  "title": "Hermes Loop System v1.1 Runtime Tool Governance",
  "type": "object",
  "required": [
    "schema_version",
    "capability_id",
    "program_range",
    "source_program_range",
    "next_program_range",
    "p62800_model_budget_source_rows",
    "runtime_adapter_contract_rows",
    "tool_policy_contract_rows",
    "command_allowlist_candidate_rows",
    "sandbox_timeout_log_artifact_rows",
    "runtime_verification_guard_rows",
    "authority_boundary_carryover_rows",
    "negative_fixture_contract_rows",
    "validation_command_rows",
    "p63200_closeout_rows",
    "p63201_next_phase_handoff_rows",
    "hermes_loop_runtime_tool_boundary",
    "summary",
    "validation"
  ],
  "properties": {
    "schema_version": { "const": "hermes-loop-runtime-tool-governance.v1" },
    "capability_id": { "const": "platform.hermes_loop_system_v1_1_runtime_tool_governance" },
    "program_range": { "const": "P62801-P63200" },
    "source_program_range": { "const": "P62401-P62800" },
    "next_program_range": { "const": "P63201-P63600" },
    "p62800_model_budget_source_rows": { "type": "array", "minItems": 5, "items": { "$ref": "#/$defs/verdictRow" } },
    "runtime_adapter_contract_rows": { "type": "array", "minItems": 15, "items": { "$ref": "#/$defs/verdictRow" } },
    "tool_policy_contract_rows": { "type": "array", "minItems": 15, "items": { "$ref": "#/$defs/verdictRow" } },
    "command_allowlist_candidate_rows": { "type": "array", "minItems": 10, "items": { "$ref": "#/$defs/verdictRow" } },
    "sandbox_timeout_log_artifact_rows": { "type": "array", "minItems": 9, "items": { "$ref": "#/$defs/verdictRow" } },
    "runtime_verification_guard_rows": { "type": "array", "minItems": 9, "items": { "$ref": "#/$defs/verdictRow" } },
    "authority_boundary_carryover_rows": { "type": "array", "minItems": 27, "items": { "$ref": "#/$defs/verdictRow" } },
    "negative_fixture_contract_rows": { "type": "array", "minItems": 13, "items": { "$ref": "#/$defs/verdictRow" } },
    "validation_command_rows": { "type": "array", "minItems": 6, "items": { "$ref": "#/$defs/verdictRow" } },
    "p63200_closeout_rows": { "type": "array", "minItems": 10, "items": { "$ref": "#/$defs/verdictRow" } },
    "p63201_next_phase_handoff_rows": { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/verdictRow" } },
    "hermes_loop_runtime_tool_boundary": {
      "type": "object",
      "required": [
        "p63200_contract_ready",
        "p62800_source_ready_now",
        "runtime_adapter_contract_ready_now",
        "tool_policy_contract_ready_now",
        "command_allowlist_candidate_ready_now",
        "sandbox_timeout_log_artifact_ready_now",
        "runtime_verification_guard_ready_now",
        "ready_for_p63201_handoff",
        "runtime_execution_allowed_now",
        "write_action_allowed_now",
        "connector_write_allowed_now",
        "protected_action_allowed_now",
        "command_execution_allowed_now",
        "tool_invocation_allowed_now",
        "secret_read_allowed_now",
        "rollback_execution_allowed_now",
        "api_mutation_allowed_now",
        "direct_file_write_allowed_now",
        "production_pass_allowed_now",
        "enterprise_pass_allowed_now",
        "codex_final_approval_allowed",
        "claude_final_approval_allowed",
        "production_pass_enabled",
        "enterprise_pass_enabled",
        "final_approval_enabled"
      ],
      "properties": {
        "p63200_contract_ready": { "type": "boolean" },
        "p62800_source_ready_now": { "type": "boolean" },
        "runtime_adapter_contract_ready_now": { "type": "boolean" },
        "tool_policy_contract_ready_now": { "type": "boolean" },
        "command_allowlist_candidate_ready_now": { "type": "boolean" },
        "sandbox_timeout_log_artifact_ready_now": { "type": "boolean" },
        "runtime_verification_guard_ready_now": { "type": "boolean" },
        "ready_for_p63201_handoff": { "type": "boolean" },
        "runtime_execution_allowed_now": { "const": false },
        "write_action_allowed_now": { "const": false },
        "connector_write_allowed_now": { "const": false },
        "protected_action_allowed_now": { "const": false },
        "command_execution_allowed_now": { "const": false },
        "tool_invocation_allowed_now": { "const": false },
        "secret_read_allowed_now": { "const": false },
        "rollback_execution_allowed_now": { "const": false },
        "api_mutation_allowed_now": { "const": false },
        "direct_file_write_allowed_now": { "const": false },
        "production_pass_allowed_now": { "const": false },
        "enterprise_pass_allowed_now": { "const": false },
        "codex_final_approval_allowed": { "const": false },
        "claude_final_approval_allowed": { "const": false },
        "production_pass_enabled": { "const": false },
        "enterprise_pass_enabled": { "const": false },
        "final_approval_enabled": { "const": false }
      },
      "additionalProperties": true
    },
    "summary": {
      "type": "object",
      "required": [
        "hermes_loop_runtime_tool_status",
        "program_range",
        "source_program_range",
        "next_program_range",
        "p62800_source_ready_now",
        "p63200_contract_ready",
        "ready_for_p63201_handoff",
        "command_execution_allowed_now",
        "tool_invocation_allowed_now",
        "secret_read_allowed_now",
        "direct_file_write_allowed_now",
        "production_pass_enabled",
        "enterprise_pass_enabled",
        "final_approval_enabled"
      ],
      "properties": {
        "hermes_loop_runtime_tool_status": {
          "enum": [
            "ready_for_p63201_handoff",
            "valid_block_p63201_handoff_pending",
            "blocked_hermes_loop_runtime_tool_governance"
          ]
        },
        "program_range": { "const": "P62801-P63200" },
        "source_program_range": { "const": "P62401-P62800" },
        "next_program_range": { "const": "P63201-P63600" },
        "command_execution_allowed_now": { "const": false },
        "tool_invocation_allowed_now": { "const": false },
        "secret_read_allowed_now": { "const": false },
        "direct_file_write_allowed_now": { "const": false },
        "production_pass_enabled": { "const": false },
        "enterprise_pass_enabled": { "const": false },
        "final_approval_enabled": { "const": false }
      },
      "additionalProperties": true
    },
    "validation": {
      "type": "object",
      "required": ["valid", "error_count", "errors"],
      "properties": {
        "valid": { "type": "boolean" },
        "error_count": { "type": "number" },
        "errors": { "type": "array" }
      },
      "additionalProperties": true
    }
  },
  "$defs": {
    "verdictRow": {
      "type": "object",
      "required": [
        "row_id",
        "category",
        "label",
        "observed",
        "current_verdict",
        "evidence_ref",
        "block_reason",
        "next_allowed_action",
        "generated_at"
      ],
      "properties": {
        "row_id": { "type": "string" },
        "category": { "type": "string" },
        "label": { "type": "string" },
        "observed": { "type": "boolean" },
        "current_verdict": { "enum": ["pass", "block"] },
        "evidence_ref": { "type": ["string", "null"] },
        "block_reason": { "type": ["string", "null"] },
        "next_allowed_action": { "type": "string" },
        "generated_at": { "type": "string" }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
