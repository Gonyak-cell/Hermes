{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://amic.local/hermes/control-plane-work-packet-receipt-drafts.schema.json",
  "title": "Hermes Control Plane Work Packet Receipt Drafts",
  "type": "object",
  "required": [
    "schema_version",
    "generated_at",
    "receipt_draft_id",
    "output_dir",
    "receipt_status",
    "sources",
    "summary",
    "receipt_requirements",
    "receipt_input_draft"
  ],
  "properties": {
    "schema_version": { "const": "control-plane-work-packet-receipt-drafts.v1" },
    "generated_at": { "type": "string", "format": "date-time" },
    "receipt_draft_id": { "type": "string" },
    "output_dir": { "type": "string" },
    "receipt_status": { "enum": ["clear", "pending_receipts", "blocked_missing_work_packets"] },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source_id", "label", "path", "available", "schema_version", "generated_at", "summary", "error"],
        "properties": {
          "source_id": { "type": "string" },
          "label": { "type": "string" },
          "path": { "type": ["string", "null"] },
          "available": { "type": "boolean" },
          "schema_version": { "type": ["string", "null"] },
          "generated_at": { "type": ["string", "null"], "format": "date-time" },
          "summary": { "type": ["object", "null"] },
          "error": { "type": ["string", "null"] }
        }
      }
    },
    "summary": {
      "type": "object",
      "required": [
        "receipt_status",
        "work_packets_available",
        "source_work_packet_run_id",
        "source_work_packet_count",
        "receipt_requirement_count",
        "receipt_draft_count",
        "pending_receipt_count",
        "protected_receipt_count",
        "human_receipt_count",
        "command_receipt_count",
        "required_field_count",
        "by_packet_type",
        "by_source_stage"
      ],
      "properties": {
        "receipt_status": { "enum": ["clear", "pending_receipts", "blocked_missing_work_packets"] },
        "work_packets_available": { "type": "boolean" },
        "source_work_packet_run_id": { "type": ["string", "null"] },
        "source_work_packet_count": { "type": "integer", "minimum": 0 },
        "receipt_requirement_count": { "type": "integer", "minimum": 0 },
        "receipt_draft_count": { "type": "integer", "minimum": 0 },
        "pending_receipt_count": { "type": "integer", "minimum": 0 },
        "protected_receipt_count": { "type": "integer", "minimum": 0 },
        "human_receipt_count": { "type": "integer", "minimum": 0 },
        "command_receipt_count": { "type": "integer", "minimum": 0 },
        "required_field_count": { "type": "integer", "minimum": 0 },
        "by_packet_type": { "type": "object" },
        "by_source_stage": { "type": "object" }
      }
    },
    "receipt_requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "receipt_requirement_id",
          "work_packet_id",
          "packet_type",
          "source_stage",
          "priority",
          "packet_status",
          "requires_human",
          "protected_action",
          "required_receipt_fields",
          "acceptance_criteria",
          "next_commands",
          "work_item_ids",
          "receipt_form_draft"
        ],
        "properties": {
          "receipt_requirement_id": { "type": "string" },
          "work_packet_id": { "type": "string" },
          "packet_type": { "type": "string" },
          "source_stage": { "type": "string" },
          "priority": { "enum": ["critical", "high", "medium", "low"] },
          "packet_status": { "type": "string" },
          "requires_human": { "type": "boolean" },
          "protected_action": { "type": "boolean" },
          "required_receipt_fields": { "type": "array", "items": { "type": "string" } },
          "acceptance_criteria": { "type": "array", "items": { "type": "string" } },
          "next_commands": { "type": "array", "items": { "type": "string" } },
          "work_item_ids": { "type": "array", "items": { "type": "string" } },
          "receipt_form_draft": { "$ref": "#/$defs/receipt" }
        }
      }
    },
    "receipt_input_draft": {
      "type": "object",
      "required": ["schema_version", "generated_at", "work_packet_run_id", "instructions", "receipts"],
      "properties": {
        "schema_version": { "const": "control-plane-work-packet-receipts-input.v1" },
        "generated_at": { "type": "string", "format": "date-time" },
        "work_packet_run_id": { "type": "string" },
        "instructions": { "type": "string" },
        "receipts": {
          "type": "array",
          "items": { "$ref": "#/$defs/receipt" }
        }
      }
    }
  },
  "$defs": {
    "receipt": {
      "type": "object",
      "required": [
        "receipt_id",
        "work_packet_id",
        "packet_type",
        "source_stage",
        "receipt_status",
        "resolved_by",
        "resolved_at",
        "resolution_reference",
        "resolution_notes",
        "reviewer",
        "protected_action_reference",
        "command_result",
        "commands_run",
        "completed_work_item_ids",
        "required_receipt_fields",
        "generated_at"
      ],
      "properties": {
        "receipt_id": { "type": "string" },
        "work_packet_id": { "type": "string" },
        "packet_type": { "type": "string" },
        "source_stage": { "type": "string" },
        "receipt_status": { "type": "string" },
        "resolved_by": { "type": "string" },
        "resolved_at": { "type": "string" },
        "resolution_reference": { "type": "string" },
        "resolution_notes": { "type": "string" },
        "reviewer": { "type": ["string", "null"] },
        "protected_action_reference": { "type": ["string", "null"] },
        "command_result": { "type": ["string", "null"] },
        "commands_run": { "type": "array", "items": { "type": "string" } },
        "completed_work_item_ids": { "type": "array", "items": { "type": "string" } },
        "required_receipt_fields": { "type": "array", "items": { "type": "string" } },
        "generated_at": { "type": "string", "format": "date-time" }
      }
    }
  }
}
