    "commitRow": {
      "allOf": [
        { "$ref": "#/$defs/row" },
        {
          "type": "object",
          "required": ["checkpoint_id", "read_only", "git_write_enabled", "commit_created_by_ui", "push_enabled", "merge_enabled"],
          "properties": {
            "read_only": { "const": true },
            "git_write_enabled": { "const": false },
            "commit_created_by_ui": { "const": false },
            "push_enabled": { "const": false },
            "merge_enabled": { "const": false }
          },
          "additionalProperties": true
        }
      ]
    },
    "sessionRow": {
      "allOf": [
        { "$ref": "#/$defs/row" },
        {
          "type": "object",
          "required": [
            "source_id",
            "engine_id",
            "session_id",
            "transcript_ref",
            "redacted_summary_ref",
            "raw_body_visible",
            "full_transcript_body_visible",
            "source_cited",
            "read_only",
            "mutates_source_store",
            "mutates_plan_state"
          ],
          "properties": {
            "raw_body_visible": { "const": false },
            "full_transcript_body_visible": { "const": false },
            "source_cited": { "const": true },
            "read_only": { "const": true },
            "mutates_source_store": { "const": false },
            "mutates_plan_state": { "const": false }
          },
          "additionalProperties": true
        }
      ]
    },
    "apiSmokeRow": {
      "allOf": [
        { "$ref": "#/$defs/row" },
        {
          "type": "object",
          "required": ["api_path", "method", "observed_status", "expected_status", "raw_transcript_body_present", "secret_keys_present"],
          "properties": {
            "raw_transcript_body_present": { "const": false },
            "secret_keys_present": { "const": false }
          },
          "additionalProperties": true
        }
      ]
    },
    "browserSmokeRow": {
      "allOf": [
        { "$ref": "#/$defs/row" },
        {
          "type": "object",
          "required": ["smoke_id", "raw_transcript_body_present", "secret_keys_present", "protected_action_token_present", "post_fetch_present"],
          "properties": {
            "raw_transcript_body_present": { "const": false },
            "secret_keys_present": { "const": false },
            "protected_action_token_present": { "const": false },
            "post_fetch_present": { "const": false }
          },
          "additionalProperties": true
        }
      ]
    },
    "validationItem": {
      "type": "object",
      "required": ["schema_version", "path", "category", "status", "message"],
      "properties": {
        "status": { "const": "pass" }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
