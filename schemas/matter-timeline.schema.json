{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hermes.local/schemas/matter-timeline.schema.json",
  "title": "Hermes Matter Timeline",
  "type": "object",
  "required": [
    "schema_version",
    "generated_at",
    "matter_timeline_id",
    "output_dir",
    "matter_timeline_status",
    "safe_handling",
    "inputs",
    "source_contracts",
    "matter_timeline_contract",
    "matter_timeline_events",
    "matter_timelines",
    "matter_timeline_desktop_boundary",
    "matter_timeline_checkpoints",
    "validation_items",
    "validation",
    "summary"
  ],
  "properties": {
    "schema_version": { "const": "matter-timeline.v1" },
    "generated_at": { "type": "string", "format": "date-time" },
    "matter_timeline_id": { "type": "string", "minLength": 1 },
    "output_dir": { "type": "string", "minLength": 1 },
    "matter_timeline_status": { "enum": ["complete", "blocked"] },
    "safe_handling": { "$ref": "#/$defs/safe_handling" },
    "inputs": { "$ref": "#/$defs/inputs" },
    "source_contracts": { "type": "object" },
    "matter_timeline_contract": { "$ref": "#/$defs/contract" },
    "matter_timeline_events": { "type": "array", "items": { "$ref": "#/$defs/timeline_event" } },
    "matter_timelines": { "type": "array", "items": { "$ref": "#/$defs/matter_timeline" } },
    "matter_timeline_desktop_boundary": { "$ref": "#/$defs/desktop_boundary" },
    "matter_timeline_checkpoints": { "type": "array", "items": { "$ref": "#/$defs/checkpoint" } },
    "validation_items": { "type": "array", "items": { "$ref": "#/$defs/validation_item" } },
    "validation": { "$ref": "#/$defs/validation" },
    "summary": { "$ref": "#/$defs/summary" }
  },
  "$defs": {
    "inputs": {
      "type": "object",
      "required": [
        "matter_os_profile_path",
        "matter_files",
        "output_catalog_path",
        "delivery_queue_path",
        "package_path",
        "roadmap_path"
      ],
      "properties": {
        "matter_os_profile_path": { "type": "string" },
        "matter_files": { "type": "array", "items": { "type": "string" } },
        "output_catalog_path": { "type": "string" },
        "delivery_queue_path": { "type": "string" },
        "package_path": { "type": "string" },
        "roadmap_path": { "type": "string" }
      }
    },
    "safe_handling": {
      "type": "object",
      "required": [
        "report_only",
        "legal_advice_provided",
        "client_facing_output_generated",
        "attorney_review_required",
        "human_review_required",
        "matter_data_write_allowed",
        "runtime_execution_performed",
        "delivery_execution_performed",
        "desktop_mutation_allowed",
        "desktop_source_of_truth",
        "protected_mutation_executed",
        "secret_material_exposed",
        "provider_key_visible"
      ],
      "properties": {
        "report_only": { "const": true },
        "legal_advice_provided": { "const": false },
        "client_facing_output_generated": { "const": false },
        "attorney_review_required": { "const": true },
        "human_review_required": { "const": true },
        "matter_data_write_allowed": { "const": false },
        "runtime_execution_performed": { "const": false },
        "delivery_execution_performed": { "const": false },
        "desktop_mutation_allowed": { "const": false },
        "desktop_source_of_truth": { "const": false },
        "protected_mutation_executed": { "const": false },
        "secret_material_exposed": { "const": false },
        "provider_key_visible": { "const": false }
      }
    },
    "contract": {
      "type": "object",
      "required": [
        "schema_version",
        "contract_id",
        "source_of_truth",
        "timeline_rule",
        "matter_boundary_rule",
        "attorney_review_rule",
        "desktop_companion_rule",
        "mutation_policy",
        "created_at"
      ],
      "properties": {
        "schema_version": { "const": "matter-timeline-contract.v1" },
        "contract_id": { "const": "matter-timeline.v1" },
        "source_of_truth": { "const": "matter_files_and_review_artifacts" },
        "timeline_rule": { "type": "string" },
        "matter_boundary_rule": { "type": "string" },
        "attorney_review_rule": { "type": "string" },
        "desktop_companion_rule": { "type": "string" },
        "mutation_policy": { "type": "string" },
        "created_at": { "type": "string", "format": "date-time" }
      }
    },
    "timeline_event": {
      "type": "object",
      "required": [
        "schema_version",
        "event_id",
        "matter_id",
        "event_type",
        "event_subtype",
        "event_title",
        "event_date",
        "event_at",
        "sequence_number",
        "sort_key",
        "source_kind",
        "source_id",
        "event_status",
        "review_status",
        "attorney_review_required",
        "human_review_required",
        "default_output_status",
        "legal_advice_provided",
        "client_facing_output_generated",
        "desktop_read_only",
        "desktop_mutation_allowed",
        "matter_data_write_allowed",
        "runtime_execution_allowed",
        "delivery_execution_allowed",
        "confidence",
        "created_at",
        "metadata"
      ],
      "properties": {
        "schema_version": { "const": "matter-timeline-event.v1" },
        "event_id": { "type": "string" },
        "matter_id": { "type": "string", "minLength": 1 },
        "event_type": { "enum": ["meeting", "received", "submission", "deadline"] },
        "event_subtype": { "type": "string" },
        "event_title": { "type": "string", "minLength": 1 },
        "event_summary": { "type": ["string", "null"] },
        "event_date": { "type": "string" },
        "event_at": { "type": "string", "format": "date-time" },
        "sequence_number": { "type": "integer", "minimum": 1 },
        "sort_key": { "type": "string", "minLength": 1 },
        "source_kind": { "enum": ["matter_file", "output_catalog"] },
        "source_id": { "type": "string" },
        "source_path": { "type": ["string", "null"] },
        "source_record_id": { "type": ["string", "null"] },
        "owner": { "type": ["string", "null"] },
        "event_status": { "type": "string" },
        "review_status": { "type": "string" },
        "attorney_review_required": { "const": true },
        "human_review_required": { "const": true },
        "default_output_status": { "const": "pending_review" },
        "legal_advice_provided": { "const": false },
        "client_facing_output_generated": { "const": false },
        "desktop_read_only": { "const": true },
        "desktop_mutation_allowed": { "const": false },
        "matter_data_write_allowed": { "const": false },
        "runtime_execution_allowed": { "const": false },
        "delivery_execution_allowed": { "const": false },
        "confidence": { "type": "string" },
        "created_at": { "type": "string", "format": "date-time" },
        "metadata": { "type": "object" }
      }
    },
    "matter_timeline": {
      "type": "object",
      "required": [
        "schema_version",
        "matter_timeline_matter_id",
        "matter_id",
        "event_count",
        "event_type_counts",
        "attorney_review_required",
        "human_review_required",
        "legal_advice_provided",
        "client_facing_output_generated",
        "desktop_read_only",
        "desktop_mutation_allowed",
        "timeline_status",
        "created_at"
      ],
      "properties": {
        "schema_version": { "const": "matter-timeline-matter.v1" },
        "matter_timeline_matter_id": { "type": "string" },
        "matter_id": { "type": "string", "minLength": 1 },
        "profile_card_id": { "type": ["string", "null"] },
        "client_display_name": { "type": ["string", "null"] },
        "matter_number": { "type": ["string", "null"] },
        "security_grade": { "type": ["string", "null"] },
        "event_count": { "type": "integer", "minimum": 0 },
        "first_event_at": { "type": ["string", "null"] },
        "last_event_at": { "type": ["string", "null"] },
        "event_type_counts": { "type": "object" },
        "attorney_review_required": { "const": true },
        "human_review_required": { "const": true },
        "legal_advice_provided": { "const": false },
        "client_facing_output_generated": { "const": false },
        "desktop_read_only": { "const": true },
        "desktop_mutation_allowed": { "const": false },
        "timeline_status": { "enum": ["complete", "pending_events"] },
        "created_at": { "type": "string", "format": "date-time" }
      }
    },
    "desktop_boundary": {
      "type": "object",
      "required": [
        "schema_version",
        "boundary_id",
        "boundary_status",
        "read_only",
        "mutation_allowed",
        "source_of_truth",
        "matter_data_write_allowed",
        "runtime_execution_allowed",
        "delivery_execution_allowed",
        "legal_advice_allowed",
        "client_facing_output_allowed_without_attorney_review",
        "attorney_review_required",
        "human_review_required",
        "default_output_status",
        "supported_event_types",
        "created_at"
      ],
      "properties": {
        "schema_version": { "const": "matter-timeline-desktop-boundary.v1" },
        "boundary_id": { "type": "string" },
        "boundary_status": { "const": "enforced" },
        "read_only": { "const": true },
        "mutation_allowed": { "const": false },
        "source_of_truth": { "const": false },
        "matter_data_write_allowed": { "const": false },
        "runtime_execution_allowed": { "const": false },
        "delivery_execution_allowed": { "const": false },
        "legal_advice_allowed": { "const": false },
        "client_facing_output_allowed_without_attorney_review": { "const": false },
        "attorney_review_required": { "const": true },
        "human_review_required": { "const": true },
        "default_output_status": { "const": "pending_review" },
        "supported_event_types": { "type": "array", "items": { "enum": ["meeting", "received", "submission", "deadline"] } },
        "created_at": { "type": "string", "format": "date-time" }
      }
    },
    "checkpoint": {
      "type": "object",
      "required": ["schema_version", "checkpoint_id", "checkpoint_status", "status", "message"],
      "properties": {
        "schema_version": { "const": "matter-timeline-checkpoint.v1" },
        "checkpoint_id": { "type": "string" },
        "checkpoint_status": { "enum": ["passed", "failed"] },
        "status": { "enum": ["passed", "failed"] },
        "message": { "type": "string" },
        "passed_count": { "type": "integer", "minimum": 0 },
        "expected_count": { "type": "integer", "minimum": 0 }
      }
    },
    "validation_item": {
      "type": "object",
      "required": ["path", "check_id", "status", "message"],
      "properties": {
        "path": { "type": "string" },
        "check_id": { "type": "string" },
        "status": { "enum": ["passed", "failed"] },
        "message": { "type": "string" },
        "schema_version": { "type": "string" },
        "checkpoint_status": { "enum": ["passed", "failed"] },
        "checkpoint_id": { "type": "string" },
        "passed_count": { "type": "integer", "minimum": 0 },
        "expected_count": { "type": "integer", "minimum": 0 }
      }
    },
    "validation": {
      "type": "object",
      "required": ["valid", "errors"],
      "properties": {
        "valid": { "type": "boolean" },
        "errors": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["path", "message", "status"],
            "properties": {
              "path": { "type": "string" },
              "message": { "type": "string" },
              "status": { "type": "string" }
            }
          }
        }
      }
    },
    "summary": {
      "type": "object",
      "required": [
        "matter_timeline_status",
        "matter_timeline_contract_id",
        "source_of_truth",
        "source_matter_os_profile_status",
        "source_output_catalog_status",
        "source_delivery_queue_status",
        "matter_file_count",
        "available_matter_file_count",
        "matter_file_with_matter_id_count",
        "matter_timeline_count",
        "complete_matter_timeline_count",
        "timeline_event_count",
        "meeting_event_count",
        "received_event_count",
        "submission_event_count",
        "deadline_event_count",
        "sorted_event_count",
        "unsorted_event_count",
        "matter_id_scoped_event_count",
        "attorney_review_required_event_count",
        "human_review_required_event_count",
        "pending_review_submission_count",
        "blocked_delivery_submission_count",
        "legal_advice_provided",
        "client_facing_output_generated",
        "desktop_boundary_status",
        "desktop_read_only",
        "desktop_mutation_allowed",
        "desktop_source_of_truth",
        "matter_data_write_allowed",
        "runtime_execution_allowed",
        "delivery_execution_allowed",
        "client_facing_output_allowed_without_attorney_review",
        "failed_checkpoint_count",
        "validation_item_count",
        "validation_error_count"
      ],
      "properties": {
        "matter_timeline_status": { "enum": ["complete", "blocked"] },
        "matter_timeline_contract_id": { "const": "matter-timeline.v1" },
        "source_of_truth": { "const": "matter_files_and_review_artifacts" },
        "source_matter_os_profile_status": { "type": "string" },
        "source_output_catalog_status": { "type": "string" },
        "source_delivery_queue_status": { "type": "string" },
        "matter_file_count": { "type": "integer", "minimum": 0 },
        "available_matter_file_count": { "type": "integer", "minimum": 0 },
        "matter_file_with_matter_id_count": { "type": "integer", "minimum": 0 },
        "matter_timeline_count": { "type": "integer", "minimum": 0 },
        "complete_matter_timeline_count": { "type": "integer", "minimum": 0 },
        "timeline_event_count": { "type": "integer", "minimum": 0 },
        "meeting_event_count": { "type": "integer", "minimum": 0 },
        "received_event_count": { "type": "integer", "minimum": 0 },
        "submission_event_count": { "type": "integer", "minimum": 0 },
        "deadline_event_count": { "type": "integer", "minimum": 0 },
        "sorted_event_count": { "type": "integer", "minimum": 0 },
        "unsorted_event_count": { "type": "integer", "minimum": 0 },
        "matter_id_scoped_event_count": { "type": "integer", "minimum": 0 },
        "attorney_review_required_event_count": { "type": "integer", "minimum": 0 },
        "human_review_required_event_count": { "type": "integer", "minimum": 0 },
        "pending_review_submission_count": { "type": "integer", "minimum": 0 },
        "blocked_delivery_submission_count": { "type": "integer", "minimum": 0 },
        "legal_advice_provided": { "const": false },
        "client_facing_output_generated": { "const": false },
        "desktop_boundary_status": { "type": "string" },
        "desktop_read_only": { "const": true },
        "desktop_mutation_allowed": { "const": false },
        "desktop_source_of_truth": { "const": false },
        "matter_data_write_allowed": { "const": false },
        "runtime_execution_allowed": { "const": false },
        "delivery_execution_allowed": { "const": false },
        "client_facing_output_allowed_without_attorney_review": { "const": false },
        "failed_checkpoint_count": { "type": "integer", "minimum": 0 },
        "validation_item_count": { "type": "integer", "minimum": 0 },
        "validation_error_count": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
