      "input_ref": "examples/trading/signal-engine.json",
      "expected_gate_results": ["classification_gate", "tool_permission_gate", "secrets_gate", "test_gate", "human_approval_gate"]
    },
    {
      "case_id": "golden.trading.model_improvement.p126_p165",
      "description": "P126-P165 model improvement layer validates model and dataset registries, leakage guards, scorecards, drift/degradation checks, promotion and rollback controls, and live-deployment blocking.",
      "input_ref": "examples/trading/model-improvement-layer.json",
      "expected_gate_results": ["classification_gate", "tool_permission_gate", "secrets_gate", "test_gate", "human_approval_gate"]
    },
    {
      "case_id": "golden.trading.backtest_validation.p166_p195",
      "description": "P166-P195 backtest validation layer validates deterministic backtest artifacts, cost models, bias checks, walk-forward validation, stress replay, and read-only dashboard/API without generating orders or promotion candidates.",
      "input_ref": "examples/trading/backtest-validation.json",
      "expected_gate_results": ["classification_gate", "tool_permission_gate", "secrets_gate", "test_gate", "human_approval_gate"]
    },
    {
      "case_id": "golden.trading.risk_engine.p196_p220",
      "description": "P196-P220 risk engine validates exposure, loss, drawdown, volatility, liquidity, data, leverage, short-selling, throttle, cooldown, model, outage, override, audit, and freeze gates before any order-intent boundary.",
      "input_ref": "examples/trading/risk-engine.json",
      "expected_gate_results": ["classification_gate", "tool_permission_gate", "secrets_gate", "test_gate", "human_approval_gate"]
    },
    {
      "case_id": "golden.trading.paper_shadow_live.p221_p245",
      "description": "P221-P245 paper and shadow layer validates paper order ledger, simulated fills, paper scorecards, read-only shadow data, non-executable shadow intents, no-order shadow mode, drift, kill-switch dry run, and operator integration.",
      "input_ref": "examples/trading/paper-shadow-live.json",
      "expected_gate_results": ["classification_gate", "tool_permission_gate", "secrets_gate", "test_gate", "human_approval_gate"]
    },
    {
      "case_id": "golden.trading.execution_engine.p246_p280",
      "description": "P246-P280 execution engine validates frozen order intent, pre-trade risk gate, order whitelist, idempotency, state machine, adapter interfaces, credential/secret boundaries, simulated execution artifacts, fill reconciliation, halt, manual resume, and read-only execution dashboard/API.",
      "input_ref": "examples/trading/execution-engine.json",
      "expected_gate_results": ["classification_gate", "tool_permission_gate", "secrets_gate", "test_gate", "human_approval_gate"]
    },
    {
      "case_id": "golden.trading.limited_live_governance.p281_p310",
      "description": "P281-P310 limited live governance validates explicit approval, capital caps, whitelists, order caps, halt gates, first-trade confirmation, reconciliation, incident notification, rollback, daily report, full-auto promotion blocking, and read-only dashboard/API without enabling live order submission.",
      "input_ref": "examples/trading/limited-live-governance.json",
      "expected_gate_results": ["classification_gate", "tool_permission_gate", "secrets_gate", "test_gate", "human_approval_gate"]
    },
    {
      "case_id": "golden.trading.full_auto_governance.p311_p340",
      "description": "P311-P340 full-auto governance validates approval checklist, strategy/model health scoring, automatic disable controls, allocators, failover policies, monthly review, audit replay, disaster recovery, tax/export placeholder, operator handbook, read-only dashboard/API, final safety regression suite, and Trading Pack v1 freeze while keeping full-auto and automatic order submission disabled.",
      "input_ref": "examples/trading/full-auto-governance.json",
      "expected_gate_results": ["classification_gate", "tool_permission_gate", "secrets_gate", "test_gate", "human_approval_gate"]
