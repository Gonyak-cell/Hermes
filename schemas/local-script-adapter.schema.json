{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://amic.local/hermes/local-script-adapter.schema.json",
  "title": "Hermes Local Script Adapter",
  "type": "object",
  "required": [
    "schema_version",
    "generated_at",
    "adapter_projection_id",
    "output_dir",
    "inputs",
    "source_contracts",
    "local_script_adapter_contract",
    "local_script_execution_contracts",
    "local_script_agent_run_ledger_bindings",
    "local_script_desktop_boundary",
    "summary",
    "validation_items",
    "validation"
  ],
  "properties": {
    "schema_version": { "const": "local-script-adapter.v1" },
    "generated_at": { "type": "string", "format": "date-time" },
    "adapter_projection_id": { "type": "string" },
    "output_dir": { "type": "string" },
    "inputs": {
      "type": "object",
      "required": [
        "runtime_adapter_interface_v2_path",
        "runtime_agentrun_contract_freeze_path",
        "runtime_command_bindings_path",
        "agent_run_ledger_path",
        "workflow_gate_freeze_path",
        "desktop_companion_integration_path"
      ]
    },
    "source_contracts": {
      "type": "object",
      "required": [
        "runtime_adapter_interface_v2",
        "runtime_agentrun_contract_freeze",
        "runtime_command_bindings",
        "agent_run_ledger",
        "workflow_gate_freeze",
        "desktop_companion_integration"
      ],
      "properties": {
        "runtime_adapter_interface_v2": {
          "type": "object",
          "required": ["runtime_adapter_interface_status", "local_script_interface_status", "local_script_operator_surface_policy_status"],
          "properties": {
            "runtime_adapter_interface_status": { "const": "complete" },
            "local_script_interface_status": { "const": "locked" },
            "local_script_operator_surface_policy_status": { "const": "locked" }
          }
        },
        "runtime_agentrun_contract_freeze": {
          "type": "object",
          "required": ["freeze_status", "local_script_runtime_adapter_found", "local_script_runtime_execution_contract_found", "current_local_script_agent_run_contract_count"],
          "properties": {
            "freeze_status": { "const": "complete" },
            "local_script_runtime_adapter_found": { "const": true },
            "local_script_runtime_execution_contract_found": { "const": true },
            "current_local_script_agent_run_contract_count": { "type": "integer", "minimum": 1 }
          }
        },
        "runtime_command_bindings": {
          "type": "object",
          "required": ["schema_version", "local_script_command_binding_found", "local_script_prompt_delivery", "local_script_deterministic"],
          "properties": {
            "schema_version": { "const": "runtime-command-bindings.v1" },
            "local_script_command_binding_found": { "const": true },
            "local_script_prompt_delivery": { "const": "none" },
            "local_script_deterministic": { "const": true }
          }
        },
        "agent_run_ledger": {
          "type": "object",
          "required": ["agent_run_ledger_status", "current_local_script_agent_run_record_count"],
          "properties": {
            "agent_run_ledger_status": { "const": "complete" },
            "current_local_script_agent_run_record_count": { "type": "integer", "minimum": 1 }
          }
        },
        "workflow_gate_freeze": {
          "type": "object",
          "required": ["workflow_gate_freeze_status"],
          "properties": {
            "workflow_gate_freeze_status": { "const": "complete" }
          }
        },
        "desktop_companion_integration": {
          "type": "object",
          "required": ["declares_read_only", "declares_not_runtime_source_of_truth"],
          "properties": {
            "declares_read_only": { "const": true },
            "declares_not_runtime_source_of_truth": { "const": true }
          }
        }
      }
    },
    "local_script_adapter_contract": {
      "type": "object",
      "required": ["contract_id", "runtime_id", "adapter_id", "adapter_status", "output_trust", "deterministic_execution_policy", "gate_policy", "collection_policy"],
      "properties": {
        "contract_id": { "const": "local-script-adapter.default" },
        "runtime_id": { "const": "local_script" },
        "adapter_id": { "const": "runtime.local_script.default" },
        "adapter_status": { "const": "locked" },
        "command_binding_id": { "const": "binding.local_script.node.default" },
        "output_trust": { "const": "trusted_after_deterministic_validation" },
        "deterministic_execution_policy": {
          "type": "object",
          "required": [
            "execution_mode",
            "network_access_allowed",
            "external_execution_allowed",
            "sandbox_required",
            "workspace_isolation_type",
            "prompt_delivery",
            "direct_final_delivery_allowed",
            "protected_path_write_allowed",
            "secret_material_allowed",
            "runtime_self_report_trusted",
            "renderer_preparation_only"
          ],
          "properties": {
            "execution_mode": { "const": "local_process" },
            "network_access_allowed": { "const": false },
            "external_execution_allowed": { "const": false },
            "sandbox_required": { "const": true },
            "workspace_isolation_type": { "const": "temp_dir" },
            "prompt_delivery": { "const": "none" },
            "direct_final_delivery_allowed": { "const": false },
            "protected_path_write_allowed": { "const": false },
            "secret_material_allowed": { "const": false },
            "runtime_self_report_trusted": { "const": false },
            "renderer_preparation_only": { "const": true }
          }
        },
        "gate_policy": {
          "type": "object",
          "required": [
            "gate_binding_status",
            "matter_access_gate_required",
            "classification_gate_required",
            "tool_permission_gate_required",
            "protected_file_gate_required",
            "evidence_coverage_gate_required",
            "test_gate_required",
            "human_approval_gate_required"
          ],
          "properties": {
            "gate_binding_status": { "const": "ready" },
            "matter_access_gate_required": { "const": true },
            "classification_gate_required": { "const": true },
            "tool_permission_gate_required": { "const": true },
            "protected_file_gate_required": { "const": true },
            "evidence_coverage_gate_required": { "const": true },
            "test_gate_required": { "const": true },
            "human_approval_gate_required": { "const": true }
          }
        },
        "collection_policy": {
          "type": "object",
          "required": ["sink_ledger", "collect_deterministic_validation_status", "runtime_self_report_trusted", "collection_status"],
          "properties": {
            "sink_ledger": { "const": "agent_run_ledger" },
            "collect_deterministic_validation_status": { "const": true },
            "runtime_self_report_trusted": { "const": false },
            "collection_status": { "const": "ready" }
          }
        }
      }
    },
    "local_script_execution_contracts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "runtime_id",
          "adapter_id",
          "execution_mode",
          "network_access_allowed",
          "external_execution_allowed",
          "sandbox_required",
          "output_hash_status",
          "log_capture_status",
          "artifact_capture_status",
          "deterministic_validation_status",
          "contract_status"
        ],
        "properties": {
          "runtime_id": { "const": "local_script" },
          "adapter_id": { "const": "runtime.local_script.default" },
          "execution_mode": { "const": "local_process" },
          "network_access_allowed": { "const": false },
          "external_execution_allowed": { "const": false },
          "sandbox_required": { "const": true },
          "output_hash_status": { "const": "present" },
          "log_capture_status": { "const": "captured" },
          "artifact_capture_status": { "const": "captured" },
          "deterministic_validation_status": { "const": "ready" },
          "direct_final_delivery_allowed": { "const": false },
          "protected_path_write_allowed": { "const": false },
          "secret_material_allowed": { "const": false },
          "runtime_self_report_trusted": { "const": false },
          "contract_status": { "const": "locked" }
        }
      }
    },
    "local_script_agent_run_ledger_bindings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["runtime_id", "adapter_id", "sink_ledger_status", "collection_status", "binding_status"],
        "properties": {
          "runtime_id": { "const": "local_script" },
          "adapter_id": { "const": "runtime.local_script.default" },
          "sink_ledger_status": { "const": "complete" },
          "collection_status": { "const": "ready" },
          "binding_status": { "const": "locked" }
        }
      }
    },
    "local_script_desktop_boundary": {
      "type": "object",
      "required": ["runtime_id", "read_only", "mutation_allowed", "runtime_source_of_truth", "boundary_status"],
      "properties": {
        "runtime_id": { "const": "local_script" },
        "read_only": { "const": true },
        "mutation_allowed": { "const": false },
        "protected_mutation_request_allowed": { "const": false },
        "protected_mutation_execution_allowed": { "const": false },
        "secret_material_exposed": { "const": false },
        "installer_or_gateway_control": { "const": false },
        "runtime_source_of_truth": { "const": false },
        "boundary_status": { "const": "locked" }
      }
    },
    "summary": {
      "type": "object",
      "required": [
        "local_script_adapter_status",
        "runtime_id",
        "adapter_id",
        "adapter_status",
        "local_script_interface_bound",
        "local_script_runtime_execution_contract_bound",
        "local_script_command_binding_declared",
        "agent_run_ledger_bound",
        "execution_contract_count",
        "network_access_allowed",
        "external_execution_allowed",
        "sandbox_required",
        "workspace_isolation_type",
        "prompt_delivery",
        "direct_final_delivery_allowed",
        "protected_path_write_allowed",
        "secret_material_allowed",
        "runtime_self_report_trusted",
        "renderer_preparation_only",
        "output_trust",
        "test_gate_required",
        "human_review_required",
        "deterministic_validation_capture_ready",
        "desktop_read_only",
        "desktop_mutation_allowed",
        "desktop_runtime_source_of_truth",
        "validation_error_count"
      ],
      "properties": {
        "local_script_adapter_status": { "const": "complete" },
        "runtime_id": { "const": "local_script" },
        "adapter_id": { "const": "runtime.local_script.default" },
        "adapter_status": { "const": "locked" },
        "local_script_interface_bound": { "const": true },
        "local_script_runtime_execution_contract_bound": { "const": true },
        "local_script_command_binding_declared": { "const": true },
        "agent_run_ledger_bound": { "const": true },
        "execution_contract_count": { "type": "integer", "minimum": 1 },
        "network_access_allowed": { "const": false },
        "external_execution_allowed": { "const": false },
        "sandbox_required": { "const": true },
        "workspace_isolation_type": { "const": "temp_dir" },
        "prompt_delivery": { "const": "none" },
        "direct_final_delivery_allowed": { "const": false },
        "protected_path_write_allowed": { "const": false },
        "secret_material_allowed": { "const": false },
        "runtime_self_report_trusted": { "const": false },
        "renderer_preparation_only": { "const": true },
        "output_trust": { "const": "trusted_after_deterministic_validation" },
        "test_gate_required": { "const": true },
        "human_review_required": { "const": true },
        "deterministic_validation_capture_ready": { "const": true },
        "desktop_read_only": { "const": true },
        "desktop_mutation_allowed": { "const": false },
        "desktop_runtime_source_of_truth": { "const": false },
        "validation_error_count": { "const": 0 }
      }
    },
    "validation_items": { "type": "array", "minItems": 1 },
    "validation": {
      "type": "object",
      "required": ["valid", "errors"],
      "properties": {
        "valid": { "const": true },
        "errors": { "type": "array", "maxItems": 0 }
      }
    }
  }
}
