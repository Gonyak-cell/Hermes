{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://amic.local/hermes/human-review-correction-workspace-merge.schema.json",
  "title": "Hermes Human Review Correction Workspace Merge",
  "type": "object",
  "required": [
    "schema_version",
    "generated_at",
    "merge_id",
    "output_dir",
    "merge_status",
    "safe_handling",
    "sources",
    "summary",
    "actor_inputs",
    "merge_items",
    "receipt_input",
    "validation"
  ],
  "properties": {
    "schema_version": { "const": "human-review-correction-workspace-merge.v1" },
    "generated_at": { "type": "string", "format": "date-time" },
    "merge_id": { "type": "string" },
    "output_dir": { "type": "string" },
    "merge_status": { "enum": ["clear", "pending_receipts", "ready_for_validation", "blocked"] },
    "safe_handling": {
      "type": "object",
      "required": ["auto_execute_allowed", "draft_only", "merge_only", "protected_actions_executed"],
      "properties": {
        "auto_execute_allowed": { "const": false },
        "draft_only": { "type": "boolean" },
        "merge_only": { "type": "boolean" },
        "protected_actions_executed": { "const": false }
      }
    },
    "sources": {
      "type": "array",
      "items": { "$ref": "#/$defs/source" }
    },
    "summary": {
      "type": "object",
      "required": [
        "actor_input_count",
        "available_actor_input_count",
        "expected_receipt_count",
        "merge_item_count",
        "receipt_row_count",
        "pending_receipt_count",
        "ready_for_validation_count",
        "missing_receipt_count",
        "duplicate_receipt_count",
        "unknown_receipt_count",
        "invalid_correction_receipt_count",
        "protected_action_count",
        "evidence_decision_count",
        "validation_error_count",
        "by_required_actor",
        "by_gate_type",
        "by_merge_status"
      ],
      "properties": {
        "actor_input_count": { "type": "integer", "minimum": 0 },
        "available_actor_input_count": { "type": "integer", "minimum": 0 },
        "expected_receipt_count": { "type": "integer", "minimum": 0 },
        "merge_item_count": { "type": "integer", "minimum": 0 },
        "receipt_row_count": { "type": "integer", "minimum": 0 },
        "pending_receipt_count": { "type": "integer", "minimum": 0 },
        "ready_for_validation_count": { "type": "integer", "minimum": 0 },
        "missing_receipt_count": { "type": "integer", "minimum": 0 },
        "duplicate_receipt_count": { "type": "integer", "minimum": 0 },
        "unknown_receipt_count": { "type": "integer", "minimum": 0 },
        "invalid_correction_receipt_count": { "type": "integer", "minimum": 0 },
        "protected_action_count": { "type": "integer", "minimum": 0 },
        "evidence_decision_count": { "type": "integer", "minimum": 0 },
        "validation_error_count": { "type": "integer", "minimum": 0 },
        "by_required_actor": { "type": "object" },
        "by_gate_type": { "type": "object" },
        "by_merge_status": { "type": "object" }
      }
    },
    "actor_inputs": {
      "type": "array",
      "items": { "$ref": "#/$defs/actor_input" }
    },
    "merge_items": {
      "type": "array",
      "items": { "$ref": "#/$defs/merge_item" }
    },
    "receipt_input": { "$ref": "#/$defs/receipt_input" },
    "validation": { "$ref": "#/$defs/validation" }
  },
  "$defs": {
    "source": {
      "type": "object",
      "required": ["source_id", "label", "path", "available", "schema_version", "generated_at", "summary", "error"],
      "properties": {
        "source_id": { "type": "string" },
        "label": { "type": "string" },
        "path": { "type": "string" },
        "available": { "type": "boolean" },
        "schema_version": { "type": ["string", "null"] },
        "generated_at": { "type": ["string", "null"], "format": "date-time" },
        "summary": { "type": ["object", "null"] },
        "error": { "type": ["string", "null"] }
      }
    },
    "actor_input": {
      "type": "object",
      "required": [
        "actor_input_id",
        "actor_correction_workspace_id",
        "required_actor",
        "input_path",
        "correction_json_path",
        "available",
        "expected_receipt_count",
        "receipt_count",
        "pending_receipt_count",
        "ready_for_validation_count",
        "receipt_ids",
        "errors",
        "receipt_input"
      ],
      "properties": {
        "actor_input_id": { "type": "string" },
        "actor_correction_workspace_id": { "type": "string" },
        "required_actor": { "type": "string" },
        "input_path": { "type": "string" },
        "correction_json_path": { "type": "string" },
        "available": { "type": "boolean" },
        "expected_receipt_count": { "type": "integer", "minimum": 0 },
        "receipt_count": { "type": "integer", "minimum": 0 },
        "pending_receipt_count": { "type": "integer", "minimum": 0 },
        "ready_for_validation_count": { "type": "integer", "minimum": 0 },
        "receipt_ids": { "type": "array", "items": { "type": "string" } },
        "errors": { "type": "array", "items": { "$ref": "#/$defs/error" } },
        "receipt_input": { "anyOf": [{ "$ref": "#/$defs/receipt_input" }, { "type": "null" }] }
      }
    },
    "merge_item": {
      "type": "object",
      "required": [
        "merge_item_id",
        "actor_input_id",
        "actor_correction_workspace_id",
        "required_actor",
        "correction_item_id",
        "feedback_item_id",
        "merge_item_source_id",
        "validation_item_id",
        "decision_row_id",
        "context_card_id",
        "receipt_id",
        "gate_item_id",
        "source_plan_item_id",
        "gate_type",
        "priority",
        "protected_action",
        "evidence_decision",
        "receipt_status",
        "outcome",
        "allowed_outcomes",
        "target_receipt_input_path",
        "target_decision_json_path",
        "merge_status",
        "ready_for_validation",
        "error_count",
        "errors",
        "receipt",
        "safe_handling"
      ],
      "properties": {
        "merge_item_id": { "type": "string" },
        "actor_input_id": { "type": ["string", "null"] },
        "actor_correction_workspace_id": { "type": ["string", "null"] },
        "required_actor": { "type": "string" },
        "correction_item_id": { "type": ["string", "null"] },
        "feedback_item_id": { "type": ["string", "null"] },
        "merge_item_source_id": { "type": ["string", "null"] },
        "validation_item_id": { "type": ["string", "null"] },
        "decision_row_id": { "type": ["string", "null"] },
        "context_card_id": { "type": ["string", "null"] },
        "receipt_id": { "type": ["string", "null"] },
        "gate_item_id": { "type": ["string", "null"] },
        "source_plan_item_id": { "type": ["string", "null"] },
        "gate_type": { "type": "string" },
        "priority": { "enum": ["critical", "high", "medium", "low"] },
        "protected_action": { "type": "boolean" },
        "evidence_decision": { "type": "boolean" },
        "receipt_status": { "type": "string" },
        "outcome": { "type": "string" },
        "allowed_outcomes": { "type": "array", "items": { "type": "string" } },
        "target_receipt_input_path": { "type": ["string", "null"] },
        "target_decision_json_path": { "type": ["string", "null"] },
        "merge_status": { "enum": ["pending_receipt", "ready_for_validation", "missing_actor_receipt", "duplicate_receipt", "unknown_receipt", "invalid_correction_receipt"] },
        "ready_for_validation": { "type": "boolean" },
        "error_count": { "type": "integer", "minimum": 0 },
        "errors": { "type": "array", "items": { "$ref": "#/$defs/error" } },
        "receipt": { "anyOf": [{ "$ref": "#/$defs/receipt" }, { "type": "null" }] },
        "safe_handling": {
          "type": "object",
          "required": ["auto_execute_allowed", "protected_actions_executed", "validation_required_before_application"],
          "properties": {
            "auto_execute_allowed": { "const": false },
            "protected_actions_executed": { "const": false },
            "validation_required_before_application": { "type": "boolean" }
          }
        }
      }
    },
    "receipt_input": {
      "type": "object",
      "required": ["schema_version", "generated_at", "human_gate_id", "instructions", "receipts"],
      "properties": {
        "schema_version": { "const": "control-plane-human-gate-receipts-input.v1" },
        "generated_at": { "type": "string", "format": "date-time" },
        "human_gate_id": { "type": "string" },
        "instructions": { "type": "string" },
        "receipts": {
          "type": "array",
          "items": { "$ref": "#/$defs/receipt" }
        }
      }
    },
    "receipt": {
      "type": "object",
      "required": [
        "receipt_id",
        "gate_item_id",
        "source_plan_item_id",
        "gate_type",
        "receipt_status",
        "outcome",
        "required_receipt_fields"
      ],
      "properties": {
        "receipt_id": { "type": "string" },
        "gate_item_id": { "type": "string" },
        "source_plan_item_id": { "type": "string" },
        "gate_type": { "type": "string" },
        "receipt_status": { "type": "string" },
        "outcome": { "type": "string" },
        "decided_by": { "type": "string" },
        "decided_at": { "type": "string" },
        "reviewer": { "type": "string" },
        "decision_reference": { "type": "string" },
        "decision_notes": { "type": "string" },
        "protected_action_reference": { "type": ["string", "null"] },
        "command_result": { "type": ["string", "null"] },
        "commands_run": { "type": "array" },
        "completed_action_refs": { "type": "array" },
        "required_receipt_fields": { "type": "array", "items": { "type": "string" } },
        "generated_at": { "type": ["string", "null"], "format": "date-time" }
      }
    },
    "validation": {
      "type": "object",
      "required": ["valid", "errors"],
      "properties": {
        "valid": { "type": "boolean" },
        "errors": { "type": "array", "items": { "$ref": "#/$defs/error" } }
      }
    },
    "error": {
      "type": "object",
      "required": ["path", "message"],
      "properties": {
        "path": { "type": "string" },
        "message": { "type": "string" }
      }
    }
  }
}
