        "next_program_range",
        "p68400_source_ready_now",
        "focused_verification_evidence_ready_now",
        "candidate_digests_match_now",
        "focused_verification_review_event_completed_now",
        "findings_remain_open_now",
        "ready_for_p68801_handoff",
        "clean_checkpoint_allowed_now",
        "finding_resolution_allowed_now",
        "focused_verification_fixed_claim_allowed_now",
        "focused_verification_verified_claim_allowed_now",
        "production_pass_enabled",
        "enterprise_pass_enabled",
        "final_approval_enabled"
