{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://amic.local/hermes/human-review-cycle-triage-inbox.schema.json",
  "title": "Hermes Human Review Cycle Triage Inbox",
  "type": "object",
  "required": [
    "schema_version",
    "generated_at",
    "triage_inbox_id",
    "output_dir",
    "triage_status",
    "safe_handling",
    "sources",
    "summary",
    "actor_triage_inboxes",
    "triage_items",
    "validation"
  ],
  "properties": {
    "schema_version": { "const": "human-review-cycle-triage-inbox.v1" },
    "generated_at": { "type": "string", "format": "date-time" },
    "triage_inbox_id": { "type": "string" },
    "output_dir": { "type": "string" },
    "triage_status": { "$ref": "#/$defs/top_status" },
    "safe_handling": { "$ref": "#/$defs/top_safe_handling" },
    "sources": { "type": "array", "items": { "$ref": "#/$defs/source" } },
    "summary": {
      "type": "object",
      "required": [
        "triage_status",
        "source_count",
        "unavailable_source_count",
        "source_work_order_item_count",
        "source_target_audit_item_count",
        "actor_triage_inbox_count",
        "triage_item_count",
        "ready_for_human_review_count",
        "ready_for_application_count",
        "attention_count",
        "blocked_count",
        "protected_action_count",
        "evidence_decision_count",
        "target_file_count",
        "missing_target_audit_count",
        "validation_error_count",
        "by_required_actor",
        "by_gate_type",
        "by_triage_status",
        "by_priority"
      ],
      "properties": {
        "triage_status": { "$ref": "#/$defs/top_status" },
        "source_count": { "type": "integer", "minimum": 0 },
        "unavailable_source_count": { "type": "integer", "minimum": 0 },
        "source_work_order_item_count": { "type": "integer", "minimum": 0 },
        "source_target_audit_item_count": { "type": "integer", "minimum": 0 },
        "actor_triage_inbox_count": { "type": "integer", "minimum": 0 },
        "triage_item_count": { "type": "integer", "minimum": 0 },
        "ready_for_human_review_count": { "type": "integer", "minimum": 0 },
        "ready_for_application_count": { "type": "integer", "minimum": 0 },
        "attention_count": { "type": "integer", "minimum": 0 },
        "blocked_count": { "type": "integer", "minimum": 0 },
        "protected_action_count": { "type": "integer", "minimum": 0 },
        "evidence_decision_count": { "type": "integer", "minimum": 0 },
        "target_file_count": { "type": "integer", "minimum": 0 },
        "missing_target_audit_count": { "type": "integer", "minimum": 0 },
        "validation_error_count": { "type": "integer", "minimum": 0 },
        "by_required_actor": { "type": "object" },
        "by_gate_type": { "type": "object" },
        "by_triage_status": { "type": "object" },
        "by_priority": { "type": "object" }
      }
    },
    "actor_triage_inboxes": {
      "type": "array",
      "items": { "$ref": "#/$defs/actor_triage_inbox" }
    },
    "triage_items": {
      "type": "array",
      "items": { "$ref": "#/$defs/triage_item" }
    },
    "validation": { "$ref": "#/$defs/validation" }
  },
  "$defs": {
    "top_status": {
      "enum": ["clear", "ready_for_human_review", "ready_for_application", "attention", "blocked"]
    },
    "actor_status": {
      "enum": ["clear", "ready_for_human_review", "ready_for_application", "attention", "blocked"]
    },
    "source": {
      "type": "object",
      "required": ["source_id", "label", "path", "available", "schema_version", "generated_at", "summary", "error"],
      "properties": {
        "source_id": { "type": "string" },
        "label": { "type": "string" },
        "path": { "type": "string" },
        "available": { "type": "boolean" },
        "schema_version": { "type": ["string", "null"] },
        "generated_at": { "type": ["string", "null"], "format": "date-time" },
        "summary": { "type": ["object", "null"] },
        "error": { "type": ["string", "null"] }
      }
    },
    "actor_triage_inbox": {
      "type": "object",
      "required": [
        "actor_triage_inbox_id",
        "work_order_id",
        "actor_target_audit_id",
        "required_actor",
        "triage_status",
        "priority",
        "triage_item_count",
        "ready_for_human_review_count",
        "ready_for_application_count",
        "attention_count",
        "blocked_count",
        "protected_action_count",
        "evidence_decision_count",
        "target_file_count",
        "top_triage_item_ids",
        "triage_json_path",
        "triage_markdown_path",
        "safe_handling"
      ],
      "properties": {
        "actor_triage_inbox_id": { "type": "string" },
        "work_order_id": { "type": ["string", "null"] },
        "actor_target_audit_id": { "type": ["string", "null"] },
        "required_actor": { "type": "string" },
        "triage_status": { "$ref": "#/$defs/actor_status" },
        "priority": { "enum": ["critical", "high", "medium", "low"] },
        "triage_item_count": { "type": "integer", "minimum": 0 },
        "ready_for_human_review_count": { "type": "integer", "minimum": 0 },
        "ready_for_application_count": { "type": "integer", "minimum": 0 },
        "attention_count": { "type": "integer", "minimum": 0 },
        "blocked_count": { "type": "integer", "minimum": 0 },
        "protected_action_count": { "type": "integer", "minimum": 0 },
        "evidence_decision_count": { "type": "integer", "minimum": 0 },
        "target_file_count": { "type": "integer", "minimum": 0 },
        "top_triage_item_ids": { "type": "array", "items": { "type": "string" } },
        "triage_json_path": { "type": "string" },
        "triage_markdown_path": { "type": "string" },
        "safe_handling": { "$ref": "#/$defs/top_safe_handling" }
      }
    },
    "triage_item": {
      "type": "object",
      "required": [
        "triage_item_id",
        "triage_rank",
        "actor_triage_inbox_id",
        "work_order_item_id",
        "work_order_id",
        "target_audit_item_id",
        "cycle_item_id",
        "gate_item_id",
        "receipt_id",
        "required_actor",
        "gate_type",
        "priority",
        "triage_status",
        "work_order_status",
        "target_audit_status",
        "protected_action",
        "evidence_decision",
        "receipt_row_status",
        "receipt_row_outcome",
        "target_receipt_input_path",
        "target_decision_json_path",
        "target_file_available",
        "receipt_row_present",
        "required_receipt_fields",
        "missing_required_fields",
        "mismatch_fields",
        "review_instructions",
        "next_actions",
        "source_refs",
        "safe_handling"
      ],
      "properties": {
        "triage_item_id": { "type": "string" },
        "triage_rank": { "type": "integer", "minimum": 1 },
        "actor_triage_inbox_id": { "type": "string" },
        "work_order_item_id": { "type": "string" },
        "work_order_id": { "type": "string" },
        "target_audit_item_id": { "type": ["string", "null"] },
        "cycle_item_id": { "type": "string" },
        "gate_item_id": { "type": "string" },
        "receipt_id": { "type": ["string", "null"] },
        "required_actor": { "type": "string" },
        "gate_type": { "type": "string" },
        "priority": { "enum": ["critical", "high", "medium", "low"] },
        "triage_status": { "$ref": "#/$defs/actor_status" },
        "work_order_status": { "type": "string" },
        "target_audit_status": { "type": "string" },
        "protected_action": { "type": "boolean" },
        "evidence_decision": { "type": "boolean" },
        "receipt_row_status": { "type": ["string", "null"] },
        "receipt_row_outcome": { "type": ["string", "null"] },
        "target_receipt_input_path": { "type": ["string", "null"] },
        "target_decision_json_path": { "type": ["string", "null"] },
        "target_file_available": { "type": "boolean" },
        "receipt_row_present": { "type": "boolean" },
        "required_receipt_fields": { "type": "array", "items": { "type": "string" } },
        "missing_required_fields": { "type": "array", "items": { "type": "string" } },
        "mismatch_fields": { "type": "array", "items": { "type": "string" } },
        "review_instructions": { "type": "array", "items": { "type": "string" } },
        "next_actions": { "type": "array", "items": { "type": "string" } },
        "source_refs": { "type": "object" },
        "safe_handling": {
          "type": "object",
          "required": ["auto_execute_allowed", "protected_actions_executed", "inbox_only"],
          "properties": {
            "auto_execute_allowed": { "const": false },
            "protected_actions_executed": { "const": false },
            "inbox_only": { "type": "boolean" }
          }
        }
      }
    },
    "top_safe_handling": {
      "type": "object",
      "required": ["auto_execute_allowed", "draft_only", "inbox_only", "protected_actions_executed"],
      "properties": {
        "auto_execute_allowed": { "const": false },
        "draft_only": { "type": "boolean" },
        "inbox_only": { "type": "boolean" },
        "protected_actions_executed": { "const": false }
      }
    },
    "validation": {
      "type": "object",
      "required": ["valid", "errors"],
      "properties": {
        "valid": { "type": "boolean" },
        "errors": { "type": "array", "items": { "$ref": "#/$defs/validation_error" } }
      }
    },
    "validation_error": {
      "type": "object",
      "required": ["path", "message"],
      "properties": {
        "path": { "type": "string" },
        "message": { "type": "string" }
      }
    }
  }
}
