{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hermes.local/schemas/global-ui-design-foundation.schema.json",
  "title": "Hermes Global UI Design Foundation",
  "type": "object",
  "additionalProperties": true,
