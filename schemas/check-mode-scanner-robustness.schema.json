{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hermes.local/schemas/check-mode-scanner-robustness.schema.json",
  "title": "Hermes Check-Mode Scanner Robustness",
  "type": "object",
  "required": [
    "schema_version",
    "generated_at",
    "capability_id",
    "program_range",
    "source_program_range",
    "scanner_robustness_phase_rows",
    "scanner_finding_closure_rows",
    "parser_shape_fixture_rows",
    "tokenizer_fixture_rows",
    "guard_convention_rows",
    "schema_readiness_rows",
    "p18800_freeze_rows",
    "scanner_robustness_boundary",
    "scanner_robustness_validation_items",
    "summary",
    "validation"
  ],
  "properties": {
    "schema_version": { "const": "check-mode-scanner-robustness.v1" },
    "generated_at": { "type": "string", "format": "date-time" },
    "capability_id": { "const": "platform.check_mode_scanner_robustness" },
    "program_range": { "const": "P18401-P18800" },
    "source_program_range": { "const": "P18001-P18400" },
    "scanner_robustness_phase_rows": { "type": "array", "minItems": 6 },
    "scanner_finding_closure_rows": { "type": "array", "minItems": 7 },
    "parser_shape_fixture_rows": { "type": "array", "minItems": 6 },
    "tokenizer_fixture_rows": { "type": "array", "minItems": 5 },
    "guard_convention_rows": { "type": "array", "minItems": 6 },
    "schema_readiness_rows": { "type": "array", "minItems": 3 },
    "p18800_freeze_rows": { "type": "array", "minItems": 5 },
    "summary": {
      "type": "object",
      "required": [
        "scanner_robustness_status",
        "source_offender_count",
        "finding_closure_count",
        "blocking_finding_count",
        "parser_fixture_passed_now",
        "tokenizer_fixture_passed_now",
        "ready_for_p18801_handoff",
        "production_pass_enabled"
      ],
      "properties": {
        "scanner_robustness_status": { "type": "string" },
        "source_offender_count": { "type": "number" },
        "finding_closure_count": { "type": "number" },
        "blocking_finding_count": { "type": "number" },
        "parser_fixture_passed_now": { "type": "boolean" },
        "tokenizer_fixture_passed_now": { "type": "boolean" },
        "ready_for_p18801_handoff": { "type": "boolean" },
        "production_pass_enabled": { "const": false }
      }
    },
    "scanner_robustness_boundary": {
      "type": "object",
      "required": [
        "ready_for_p18801_handoff",
        "source_p18400_ready_for_p18401_handoff",
        "source_offender_count",
        "parser_fixture_passed_now",
        "tokenizer_fixture_passed_now",
        "finding_closure_count",
        "blocking_finding_count",
        "deployment_allowed_now",
        "release_approval_allowed_now",
        "production_pass_enabled",
        "enterprise_pass_enabled",
        "enterprise_trust_claim_allowed_now",
        "protected_closeout_enabled",
        "human_gate_bypass_allowed_now",
        "independent_review_bypass_allowed_now",
        "single_owner_enterprise_trust_allowed_now",
        "runtime_execution_allowed_now",
        "write_action_allowed_now",
        "protected_action_allowed_now",
        "connector_write_enabled",
        "external_service_mutation_allowed_now",
        "raw_source_exposure_allowed",
        "secret_read_allowed_now",
        "reviewer_mutation_allowed_now",
        "final_automated_approval_allowed"
      ],
      "properties": {
        "ready_for_p18801_handoff": { "type": "boolean" },
        "source_p18400_ready_for_p18401_handoff": { "type": "boolean" },
        "source_offender_count": { "type": ["number", "null"] },
        "parser_fixture_passed_now": { "type": "boolean" },
        "tokenizer_fixture_passed_now": { "type": "boolean" },
        "finding_closure_count": { "type": "number" },
        "blocking_finding_count": { "type": "number" },
        "deployment_allowed_now": { "const": false },
        "release_approval_allowed_now": { "const": false },
        "production_pass_enabled": { "const": false },
        "enterprise_pass_enabled": { "const": false },
        "enterprise_trust_claim_allowed_now": { "const": false },
        "protected_closeout_enabled": { "const": false },
        "human_gate_bypass_allowed_now": { "const": false },
        "independent_review_bypass_allowed_now": { "const": false },
        "single_owner_enterprise_trust_allowed_now": { "const": false },
        "runtime_execution_allowed_now": { "const": false },
        "write_action_allowed_now": { "const": false },
        "protected_action_allowed_now": { "const": false },
        "connector_write_enabled": { "const": false },
        "external_service_mutation_allowed_now": { "const": false },
        "raw_source_exposure_allowed": { "const": false },
        "secret_read_allowed_now": { "const": false },
        "reviewer_mutation_allowed_now": { "const": false },
        "final_automated_approval_allowed": { "const": false }
      }
    },
    "validation": {
      "type": "object",
      "required": ["valid", "error_count", "errors"],
      "properties": {
        "valid": { "type": "boolean" },
        "error_count": { "type": "number" },
        "errors": { "type": "array" }
      }
    }
  }
}
