{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hermes.local/schemas/platform-replay-handoff-map.schema.json",
  "title": "Platform Replay Handoff Map",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "generated_at",
    "platform_replay_handoff_map_id",
    "capability_id",
    "replay_handoff_anchor",
    "replay_handoff_rows",
    "replay_handoff_gate_rows",
    "replay_handoff_boundary",
    "validation_items",
    "validation",
    "summary"
  ],
  "properties": {
    "schema_version": { "const": "platform-replay-handoff-map.v1" },
    "platform_replay_handoff_map_id": { "type": "string", "minLength": 1 },
    "capability_id": { "const": "platform.replay_handoff_map" },
    "replay_handoff_anchor": {
      "type": "object",
      "required": ["phase_slot", "previous_phase_slot", "next_phase_slot", "source_lockfile_policy_status"],
      "properties": {
        "phase_slot": { "const": "P353" },
        "previous_phase_slot": { "const": "P352" },
        "next_phase_slot": { "const": "P354" },
        "source_lockfile_policy_status": { "const": "ready" }
      }
    },
    "replay_handoff_rows": {
      "type": "array",
      "minItems": 6,
      "items": {
        "type": "object",
        "required": [
          "phase_slot",
          "replay_handoff_status",
          "owner_role",
          "expected_evidence",
          "next_operator_action",
          "command_execution_allowed_by_report",
          "protected_action_allowed_by_report",
          "desktop_source_of_truth",
          "human_review_required"
        ],
        "properties": {
          "phase_slot": { "const": "P353" },
          "replay_handoff_status": { "const": "ready" },
          "command_execution_allowed_by_report": { "const": false },
          "protected_action_allowed_by_report": { "const": false },
          "desktop_source_of_truth": { "const": false },
          "human_review_required": { "const": true }
        }
      }
    },
    "replay_handoff_gate_rows": {
      "type": "array",
      "minItems": 7,
      "items": {
        "type": "object",
        "required": [
          "phase_slot",
          "gate_status",
          "command_execution_performed_by_report",
          "protected_action_executed_by_report",
          "artifact_regeneration_performed_by_report",
          "git_operation_performed_by_report",
          "desktop_mutation_performed_by_report",
          "trading_order_submission_performed_by_report",
          "human_review_required"
        ],
        "properties": {
          "phase_slot": { "const": "P353" },
          "gate_status": { "const": "ready" },
          "command_execution_performed_by_report": { "const": false },
          "protected_action_executed_by_report": { "const": false },
          "artifact_regeneration_performed_by_report": { "const": false },
          "git_operation_performed_by_report": { "const": false },
          "desktop_mutation_performed_by_report": { "const": false },
          "trading_order_submission_performed_by_report": { "const": false },
          "human_review_required": { "const": true }
        }
      }
    },
    "replay_handoff_boundary": {
      "type": "object",
      "required": [
        "boundary_status",
        "phase_slot",
        "read_only",
        "report_only",
        "command_execution_performed",
        "dependency_install_performed",
        "package_mutation_performed",
        "lockfile_mutation_performed",
        "artifact_overwrite_performed",
        "artifact_regeneration_performed",
        "history_import_performed",
        "repository_checkout_changed",
        "git_operation_performed",
        "release_published",
        "recovery_execution_performed",
        "protected_action_executed",
        "approval_applied",
        "desktop_source_of_truth",
        "desktop_mutation_allowed",
        "trading_live_enabled",
        "trading_full_auto_enabled",
        "trading_order_submission_allowed",
        "broker_write_allowed",
        "human_review_required_for_replay"
      ],
      "properties": {
        "boundary_status": { "const": "enforced" },
        "phase_slot": { "const": "P353" },
        "read_only": { "const": true },
        "report_only": { "const": true },
        "command_execution_performed": { "const": false },
        "dependency_install_performed": { "const": false },
        "package_mutation_performed": { "const": false },
        "lockfile_mutation_performed": { "const": false },
        "artifact_overwrite_performed": { "const": false },
        "artifact_regeneration_performed": { "const": false },
        "history_import_performed": { "const": false },
        "repository_checkout_changed": { "const": false },
        "git_operation_performed": { "const": false },
        "release_published": { "const": false },
        "recovery_execution_performed": { "const": false },
        "protected_action_executed": { "const": false },
        "approval_applied": { "const": false },
        "desktop_source_of_truth": { "const": false },
        "desktop_mutation_allowed": { "const": false },
        "trading_live_enabled": { "const": false },
        "trading_full_auto_enabled": { "const": false },
        "trading_order_submission_allowed": { "const": false },
        "broker_write_allowed": { "const": false },
        "human_review_required_for_replay": { "const": true }
      }
    },
    "summary": {
      "type": "object",
      "required": [
        "platform_replay_handoff_map_status",
        "phase_slot",
        "previous_phase_slot",
        "next_phase_slot",
        "source_lockfile_policy_status",
        "replay_handoff_count",
        "ready_replay_handoff_count",
        "replay_handoff_gate_count",
        "ready_replay_handoff_gate_count",
        "read_only",
        "report_only",
        "command_execution_performed",
        "dependency_install_performed",
        "package_mutation_performed",
        "lockfile_mutation_performed",
        "artifact_overwrite_performed",
        "artifact_regeneration_performed",
        "history_import_performed",
        "repository_checkout_changed",
        "git_operation_performed",
        "release_published",
        "recovery_execution_performed",
        "protected_action_executed",
        "approval_applied",
        "desktop_source_of_truth",
        "desktop_mutation_allowed",
        "trading_live_enabled",
        "trading_full_auto_enabled",
        "trading_order_submission_allowed",
        "broker_write_allowed",
        "validation_error_count"
      ],
      "properties": {
        "platform_replay_handoff_map_status": { "const": "ready" },
        "phase_slot": { "const": "P353" },
        "previous_phase_slot": { "const": "P352" },
        "next_phase_slot": { "const": "P354" },
        "source_lockfile_policy_status": { "const": "ready" },
        "read_only": { "const": true },
        "report_only": { "const": true },
        "command_execution_performed": { "const": false },
        "dependency_install_performed": { "const": false },
        "package_mutation_performed": { "const": false },
        "lockfile_mutation_performed": { "const": false },
        "artifact_overwrite_performed": { "const": false },
        "artifact_regeneration_performed": { "const": false },
        "history_import_performed": { "const": false },
        "repository_checkout_changed": { "const": false },
        "git_operation_performed": { "const": false },
        "release_published": { "const": false },
        "recovery_execution_performed": { "const": false },
        "protected_action_executed": { "const": false },
        "approval_applied": { "const": false },
        "desktop_source_of_truth": { "const": false },
        "desktop_mutation_allowed": { "const": false },
        "trading_live_enabled": { "const": false },
        "trading_full_auto_enabled": { "const": false },
        "trading_order_submission_allowed": { "const": false },
        "broker_write_allowed": { "const": false },
        "validation_error_count": { "const": 0 }
      }
    }
  }
