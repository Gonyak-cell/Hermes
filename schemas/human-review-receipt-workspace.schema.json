{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://amic.local/hermes/human-review-receipt-workspace.schema.json",
  "title": "Hermes Human Review Receipt Workspace",
  "type": "object",
  "required": [
    "schema_version",
    "generated_at",
    "workspace_id",
    "output_dir",
    "workspace_status",
    "safe_handling",
    "sources",
    "summary",
    "actor_workspaces",
    "workspace_entries",
    "validation"
  ],
  "properties": {
    "schema_version": { "const": "human-review-receipt-workspace.v1" },
    "generated_at": { "type": "string", "format": "date-time" },
    "workspace_id": { "type": "string" },
    "output_dir": { "type": "string" },
    "workspace_status": { "enum": ["clear", "pending_human_review", "ready_for_validation", "blocked"] },
    "safe_handling": {
      "type": "object",
      "required": ["auto_execute_allowed", "draft_only", "writes_editable_receipt_inputs", "protected_actions_executed"],
      "properties": {
        "auto_execute_allowed": { "const": false },
        "draft_only": { "type": "boolean" },
        "writes_editable_receipt_inputs": { "type": "boolean" },
        "protected_actions_executed": { "const": false }
      }
    },
    "sources": {
      "type": "array",
      "items": { "$ref": "#/$defs/source" }
    },
    "summary": {
      "type": "object",
      "required": [
        "actor_workspace_count",
        "workspace_entry_count",
        "receipt_row_count",
        "pending_receipt_count",
        "ready_for_validation_count",
        "protected_action_count",
        "human_required_count",
        "evidence_decision_count",
        "editable_file_count",
        "blocked_workspace_count",
        "validation_error_count",
        "by_required_actor",
        "by_gate_type",
        "by_workspace_status",
        "by_priority"
      ],
      "properties": {
        "actor_workspace_count": { "type": "integer", "minimum": 0 },
        "workspace_entry_count": { "type": "integer", "minimum": 0 },
        "receipt_row_count": { "type": "integer", "minimum": 0 },
        "pending_receipt_count": { "type": "integer", "minimum": 0 },
        "ready_for_validation_count": { "type": "integer", "minimum": 0 },
        "protected_action_count": { "type": "integer", "minimum": 0 },
        "human_required_count": { "type": "integer", "minimum": 0 },
        "evidence_decision_count": { "type": "integer", "minimum": 0 },
        "editable_file_count": { "type": "integer", "minimum": 0 },
        "blocked_workspace_count": { "type": "integer", "minimum": 0 },
        "validation_error_count": { "type": "integer", "minimum": 0 },
        "by_required_actor": { "type": "object" },
        "by_gate_type": { "type": "object" },
        "by_workspace_status": { "type": "object" },
        "by_priority": { "type": "object" }
      }
    },
    "actor_workspaces": {
      "type": "array",
      "items": { "$ref": "#/$defs/actor_workspace" }
    },
    "workspace_entries": {
      "type": "array",
      "items": { "$ref": "#/$defs/workspace_entry" }
    },
    "validation": { "$ref": "#/$defs/validation" }
  },
  "$defs": {
    "source": {
      "type": "object",
      "required": ["source_id", "label", "path", "available", "schema_version", "generated_at", "summary", "error"],
      "properties": {
        "source_id": { "type": "string" },
        "label": { "type": "string" },
        "path": { "type": ["string", "null"] },
        "available": { "type": "boolean" },
        "schema_version": { "type": ["string", "null"] },
        "generated_at": { "type": ["string", "null"], "format": "date-time" },
        "summary": { "type": ["object", "null"] },
        "error": { "type": ["string", "null"] }
      }
    },
    "actor_workspace": {
      "type": "object",
      "required": [
        "actor_workspace_id",
        "required_actor",
        "workspace_status",
        "priority",
        "receipt_row_count",
        "pending_receipt_count",
        "ready_for_validation_count",
        "protected_action_count",
        "evidence_decision_count",
        "gate_types",
        "receipt_input_path",
        "review_markdown_path",
        "workspace_entry_ids",
        "receipt_ids",
        "safe_handling",
        "receipt_input"
      ],
      "properties": {
        "actor_workspace_id": { "type": "string" },
        "required_actor": { "type": "string" },
        "workspace_status": { "enum": ["clear", "pending_human_review", "ready_for_validation", "blocked"] },
        "priority": { "enum": ["critical", "high", "medium", "low"] },
        "receipt_row_count": { "type": "integer", "minimum": 0 },
        "pending_receipt_count": { "type": "integer", "minimum": 0 },
        "ready_for_validation_count": { "type": "integer", "minimum": 0 },
        "protected_action_count": { "type": "integer", "minimum": 0 },
        "evidence_decision_count": { "type": "integer", "minimum": 0 },
        "gate_types": { "type": "object" },
        "receipt_input_path": { "type": "string" },
        "review_markdown_path": { "type": "string" },
        "workspace_entry_ids": { "type": "array", "items": { "type": "string" } },
        "receipt_ids": { "type": "array", "items": { "type": "string" } },
        "safe_handling": { "$ref": "#/$defs/safe_handling" },
        "receipt_input": { "$ref": "#/$defs/receipt_input" }
      }
    },
    "workspace_entry": {
      "type": "object",
      "required": [
        "workspace_entry_id",
        "intake_item_id",
        "receipt_requirement_id",
        "gate_item_id",
        "source_plan_item_id",
        "source_stage",
        "gate_type",
        "priority",
        "required_actor",
        "requires_human",
        "protected_action",
        "receipt_id",
        "receipt_status",
        "outcome",
        "intake_status",
        "ready_for_validation",
        "allowed_outcomes",
        "required_receipt_fields",
        "subject_ref",
        "decision_reference",
        "decision_notes",
        "receipt",
        "editable",
        "safe_handling"
      ],
      "properties": {
        "workspace_entry_id": { "type": "string" },
        "intake_item_id": { "type": "string" },
        "receipt_requirement_id": { "type": ["string", "null"] },
        "gate_item_id": { "type": "string" },
        "source_plan_item_id": { "type": "string" },
        "source_stage": { "type": "string" },
        "gate_type": { "type": "string" },
        "priority": { "enum": ["critical", "high", "medium", "low"] },
        "required_actor": { "type": "string" },
        "requires_human": { "type": "boolean" },
        "protected_action": { "type": "boolean" },
        "receipt_id": { "type": ["string", "null"] },
        "receipt_status": { "type": "string" },
        "outcome": { "type": "string" },
        "intake_status": { "type": "string" },
        "ready_for_validation": { "type": "boolean" },
        "allowed_outcomes": { "type": "array", "items": { "type": "string" } },
        "required_receipt_fields": { "type": "array", "items": { "type": "string" } },
        "subject_ref": { "type": ["object", "null"] },
        "decision_reference": { "type": "string" },
        "decision_notes": { "type": "string" },
        "receipt": { "$ref": "#/$defs/receipt" },
        "editable": { "type": "boolean" },
        "safe_handling": { "$ref": "#/$defs/safe_handling" }
      }
    },
    "safe_handling": {
      "type": "object",
      "required": ["auto_execute_allowed", "protected_actions_executed", "validation_required_before_application"],
      "properties": {
        "auto_execute_allowed": { "const": false },
        "protected_actions_executed": { "const": false },
        "validation_required_before_application": { "type": "boolean" }
      }
    },
    "receipt_input": {
      "type": "object",
      "required": ["schema_version", "generated_at", "human_gate_id", "instructions", "receipts"],
      "properties": {
        "schema_version": { "const": "control-plane-human-gate-receipts-input.v1" },
        "generated_at": { "type": "string", "format": "date-time" },
        "human_gate_id": { "type": "string" },
        "instructions": { "type": "string" },
        "receipts": {
          "type": "array",
          "items": { "$ref": "#/$defs/receipt" }
        }
      }
    },
    "receipt": {
      "type": "object",
      "required": [
        "receipt_id",
        "gate_item_id",
        "source_plan_item_id",
        "gate_type",
        "receipt_status",
        "outcome",
        "decided_by",
        "decided_at",
        "reviewer",
        "decision_reference",
        "decision_notes",
        "protected_action_reference",
        "command_result",
        "commands_run",
        "completed_action_refs",
        "required_receipt_fields",
        "generated_at"
      ],
      "properties": {
        "receipt_id": { "type": ["string", "null"] },
        "gate_item_id": { "type": ["string", "null"] },
        "source_plan_item_id": { "type": ["string", "null"] },
        "gate_type": { "type": ["string", "null"] },
        "receipt_status": { "type": "string" },
        "outcome": { "type": "string" },
        "decided_by": { "type": "string" },
        "decided_at": { "type": "string" },
        "reviewer": { "type": ["string", "null"] },
        "decision_reference": { "type": "string" },
        "decision_notes": { "type": "string" },
        "protected_action_reference": { "type": ["string", "null"] },
        "command_result": { "type": ["string", "null"] },
        "commands_run": { "type": "array", "items": { "type": "string" } },
        "completed_action_refs": { "type": "array", "items": { "type": "string" } },
        "required_receipt_fields": { "type": "array", "items": { "type": "string" } },
        "generated_at": { "type": "string", "format": "date-time" }
      }
    },
    "validation": {
      "type": "object",
      "required": ["valid", "errors"],
      "properties": {
        "valid": { "type": "boolean" },
        "errors": {
          "type": "array",
          "items": { "$ref": "#/$defs/error" }
        }
      }
    },
    "error": {
      "type": "object",
      "required": ["path", "message"],
      "properties": {
        "path": { "type": "string" },
        "message": { "type": "string" }
      }
    }
  }
}
