    "verdictRow": {
      "type": "object",
      "required": ["row_id", "current_verdict", "unsafe_flags_false", "verdict_authority", "opens_authority"],
      "properties": {
        "row_id": { "type": "string", "minLength": 1 },
        "current_verdict": { "enum": ["pass", "blocked"] },
        "unsafe_flags_false": { "type": "boolean" },
        "verdict_authority": { "const": "harness_deterministic_validator" },
        "opens_authority": { "const": false }
      },
      "additionalProperties": true
    },
    "findingRow": {
      "allOf": [
        { "$ref": "#/$defs/verdictRow" },
        {
          "type": "object",
          "required": [
            "finding_id",
            "finding_status",
            "blocking",
            "finding_resolution_allowed_now",
            "finding_status_fixed_allowed_now",
            "finding_status_verified_allowed_now",
            "finding_status_resolved_allowed_now",
            "clean_checkpoint_allowed_now",
            "patch_apply_allowed_now",
