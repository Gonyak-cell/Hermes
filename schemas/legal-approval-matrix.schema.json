{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://amic.local/hermes/legal-approval-matrix.schema.json",
  "title": "Legal Approval Matrix",
  "type": "object",
  "required": [
    "schema_version",
    "generated_at",
    "legal_approval_matrix_id",
    "legal_approval_matrix_status",
    "safe_handling",
    "source_contracts",
    "legal_approval_matrix_contract",
    "legal_approval_matrix_rules",
    "legal_approval_output_rows",
    "legal_approval_requirements",
    "legal_approval_gate_links",
    "legal_approval_matter_summaries",
    "legal_approval_matrix_desktop_boundary",
    "validation_items",
    "validation",
    "summary"
  ],
  "properties": {
    "schema_version": { "const": "legal-approval-matrix.v1" },
    "generated_at": { "type": "string" },
    "legal_approval_matrix_id": { "type": "string", "minLength": 1 },
    "output_dir": { "type": "string" },
    "legal_approval_matrix_status": { "enum": ["complete", "attention"] },
    "safe_handling": { "$ref": "#/$defs/safe_handling" },
    "inputs": { "type": "object" },
    "source_contracts": { "type": "object" },
    "legal_approval_matrix_contract": { "type": "object" },
    "legal_approval_matrix_rules": {
      "type": "array",
      "minItems": 6,
      "items": { "$ref": "#/$defs/rule" }
    },
    "legal_approval_output_rows": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/output_row" }
    },
    "legal_approval_requirements": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/requirement" }
    },
    "legal_approval_gate_links": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/gate_link" }
    },
    "legal_approval_matter_summaries": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/matter_summary" }
    },
    "legal_approval_matrix_desktop_boundary": { "$ref": "#/$defs/desktop_boundary" },
    "legal_approval_matrix_checkpoints": { "type": "array" },
    "validation_items": { "type": "array" },
    "validation": { "$ref": "#/$defs/validation" },
    "summary": { "$ref": "#/$defs/summary" }
  },
  "$defs": {
    "safe_handling": {
      "type": "object",
      "required": [
        "report_only",
        "deterministic_approval_matrix_performed",
        "approval_decision_recorded",
        "attorney_approval_recorded",
        "partner_approval_recorded",
        "final_review_decision_recorded",
        "attorney_review_required",
        "human_review_required",
        "partner_approval_required_before_client_use",
        "legal_conclusion_asserted",
        "legal_advice_provided",
        "client_facing_ready",
        "client_facing_output_generated",
        "matter_data_write_allowed",
        "task_state_write_allowed",
        "workflow_transition_allowed",
        "runtime_execution_performed",
        "delivery_execution_performed",
        "desktop_mutation_allowed",
        "desktop_source_of_truth",
        "protected_mutation_executed"
      ],
      "properties": {
        "report_only": { "const": true },
        "deterministic_approval_matrix_performed": { "const": true },
        "approval_decision_recorded": { "const": false },
        "attorney_approval_recorded": { "const": false },
        "partner_approval_recorded": { "const": false },
        "final_review_decision_recorded": { "const": false },
        "attorney_review_required": { "const": true },
        "human_review_required": { "const": true },
        "partner_approval_required_before_client_use": { "const": true },
        "legal_conclusion_asserted": { "const": false },
        "legal_advice_provided": { "const": false },
        "client_facing_ready": { "const": false },
        "client_facing_output_generated": { "const": false },
        "matter_data_write_allowed": { "const": false },
        "task_state_write_allowed": { "const": false },
        "workflow_transition_allowed": { "const": false },
        "runtime_execution_performed": { "const": false },
        "delivery_execution_performed": { "const": false },
        "desktop_mutation_allowed": { "const": false },
        "desktop_source_of_truth": { "const": false },
        "protected_mutation_executed": { "const": false }
      }
    },
    "source_ref": {
      "type": "object",
      "required": ["source_kind", "source_id", "source_field"],
      "properties": {
        "source_kind": { "type": "string" },
        "source_id": { "type": "string" },
        "source_field": { "type": "string" }
      }
    },
    "common_review_fields": {
      "type": "object",
      "required": [
        "attorney_review_required",
        "human_review_required",
        "partner_approval_required_before_client_use",
        "client_facing_ready",
        "legal_conclusion_asserted",
        "legal_advice_provided",
        "source_refs",
        "source_ref_count"
      ],
      "properties": {
        "attorney_review_required": { "const": true },
        "human_review_required": { "const": true },
        "partner_approval_required_before_client_use": { "const": true },
        "client_facing_ready": { "const": false },
        "legal_conclusion_asserted": { "const": false },
        "legal_advice_provided": { "const": false },
        "source_refs": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/source_ref" } },
        "source_ref_count": { "type": "integer", "minimum": 1 }
      }
    },
    "rule": {
      "type": "object",
      "required": [
        "schema_version",
        "legal_approval_rule_id",
        "legal_approval_rule_type",
        "rule_status",
        "deterministic_only",
        "attorney_review_required",
        "human_review_required",
        "partner_approval_required_before_client_use"
      ],
      "properties": {
        "schema_version": { "const": "legal-approval-matrix-rule.v1" },
        "legal_approval_rule_id": { "type": "string" },
        "legal_approval_rule_type": { "type": "string" },
        "rule_status": { "const": "active" },
        "deterministic_only": { "const": true },
        "attorney_review_required": { "const": true },
        "human_review_required": { "const": true },
        "partner_approval_required_before_client_use": { "const": true }
      }
    },
    "output_row": {
      "allOf": [
        { "$ref": "#/$defs/common_review_fields" },
        {
          "type": "object",
          "required": [
            "schema_version",
            "legal_approval_output_id",
            "matter_id",
            "source_artifact_id",
            "legal_approval_output_kind",
            "source_artifact_status",
            "approval_requirement_status",
            "client_use_blocked_until_approval",
            "finalization_blocked_until_approval",
            "delivery_blocked_until_approval",
            "filing_blocked_until_approval",
            "approval_decision_recorded",
            "attorney_approval_recorded",
            "partner_approval_recorded",
            "final_review_decision_recorded",
            "client_facing_output_generated",
            "matter_data_write_allowed",
            "task_state_write_allowed",
            "workflow_transition_allowed",
            "runtime_execution_allowed",
            "delivery_execution_allowed",
            "protected_action_allowed"
          ],
          "properties": {
            "schema_version": { "const": "legal-approval-output-row.v1" },
            "legal_approval_output_id": { "type": "string" },
            "matter_id": { "type": "string" },
            "source_artifact_id": { "type": "string" },
            "legal_approval_output_kind": { "type": "string" },
            "source_artifact_status": { "enum": ["complete", "attention"] },
            "approval_requirement_status": { "const": "attorney_and_partner_approval_required" },
            "client_use_blocked_until_approval": { "const": true },
            "finalization_blocked_until_approval": { "const": true },
            "delivery_blocked_until_approval": { "const": true },
            "filing_blocked_until_approval": { "const": true },
            "approval_decision_recorded": { "const": false },
            "attorney_approval_recorded": { "const": false },
            "partner_approval_recorded": { "const": false },
            "final_review_decision_recorded": { "const": false },
            "client_facing_output_generated": { "const": false },
            "matter_data_write_allowed": { "const": false },
            "task_state_write_allowed": { "const": false },
            "workflow_transition_allowed": { "const": false },
            "runtime_execution_allowed": { "const": false },
            "delivery_execution_allowed": { "const": false },
            "protected_action_allowed": { "const": false }
          }
        }
      ]
    },
    "requirement": {
      "allOf": [
        { "$ref": "#/$defs/common_review_fields" },
        {
          "type": "object",
          "required": [
            "schema_version",
            "legal_approval_requirement_id",
            "legal_approval_output_id",
            "matter_id",
            "source_artifact_id",
            "approval_requirement_type",
            "required_actor",
            "required_approval_level",
            "approval_requirement_status",
            "gate_status",
            "approval_decision_recorded",
            "approval_granted",
            "approval_rejected",
            "client_use_blocked_until_approval",
            "finalization_blocked_until_approval"
          ],
          "properties": {
            "schema_version": { "const": "legal-approval-requirement.v1" },
            "legal_approval_requirement_id": { "type": "string" },
            "legal_approval_output_id": { "type": "string" },
            "matter_id": { "type": "string" },
            "source_artifact_id": { "type": "string" },
            "approval_requirement_type": { "enum": ["attorney_review", "partner_approval"] },
            "required_actor": { "enum": ["attorney_reviewer", "partner"] },
            "required_approval_level": { "enum": ["attorney_review", "partner_approval"] },
            "approval_requirement_status": { "const": "pending_required" },
            "gate_status": { "const": "blocked_until_human_approval" },
            "approval_decision_recorded": { "const": false },
            "approval_granted": { "const": false },
            "approval_rejected": { "const": false },
            "client_use_blocked_until_approval": { "const": true },
            "finalization_blocked_until_approval": { "const": true }
          }
        }
      ]
    },
    "gate_link": {
      "allOf": [
        { "$ref": "#/$defs/common_review_fields" },
        {
          "type": "object",
          "required": [
            "schema_version",
            "legal_approval_gate_link_id",
            "legal_approval_output_id",
            "matter_id",
            "source_artifact_id",
            "native_review_gate_count",
            "linked_requirement_count",
            "gate_link_status",
            "attorney_requirement_linked",
            "partner_requirement_linked",
            "client_use_blocked_until_approval",
            "finalization_blocked_until_approval",
            "approval_decision_recorded"
          ],
          "properties": {
            "schema_version": { "const": "legal-approval-gate-link.v1" },
            "legal_approval_gate_link_id": { "type": "string" },
            "legal_approval_output_id": { "type": "string" },
            "matter_id": { "type": "string" },
            "source_artifact_id": { "type": "string" },
            "native_review_gate_count": { "type": "integer", "minimum": 1 },
            "linked_requirement_count": { "type": "integer", "minimum": 2 },
            "gate_link_status": { "const": "linked_pending_approval" },
            "attorney_requirement_linked": { "const": true },
            "partner_requirement_linked": { "const": true },
            "client_use_blocked_until_approval": { "const": true },
            "finalization_blocked_until_approval": { "const": true },
            "approval_decision_recorded": { "const": false }
          }
        }
      ]
    },
    "matter_summary": {
      "allOf": [
        { "$ref": "#/$defs/common_review_fields" },
        {
          "type": "object",
          "required": [
            "schema_version",
            "legal_approval_matter_summary_id",
            "matter_id",
            "legal_approval_matter_status",
            "legal_approval_output_count",
            "legal_approval_requirement_count",
            "legal_approval_gate_link_count",
            "approval_decision_recorded_count",
            "client_facing_ready_count"
          ],
          "properties": {
            "schema_version": { "const": "legal-approval-matter-summary.v1" },
            "legal_approval_matter_summary_id": { "type": "string" },
            "matter_id": { "type": "string" },
            "legal_approval_matter_status": { "const": "pending_attorney_and_partner_approval" },
            "legal_approval_output_count": { "type": "integer", "minimum": 1 },
            "legal_approval_requirement_count": { "type": "integer", "minimum": 2 },
            "legal_approval_gate_link_count": { "type": "integer", "minimum": 1 },
            "approval_decision_recorded_count": { "const": 0 },
            "client_facing_ready_count": { "const": 0 }
          }
        }
      ]
    },
    "desktop_boundary": {
      "type": "object",
      "required": [
        "schema_version",
        "boundary_status",
        "read_only",
        "desktop_mutation_allowed",
        "desktop_source_of_truth",
        "matter_data_write_allowed",
        "task_state_write_allowed",
        "workflow_transition_allowed",
        "runtime_execution_allowed",
        "delivery_execution_allowed",
        "protected_action_allowed",
        "approval_decision_write_allowed",
        "client_facing_output_allowed_without_attorney_review",
        "partner_approval_bypass_allowed"
      ],
      "properties": {
        "schema_version": { "const": "legal-approval-matrix-desktop-boundary.v1" },
        "boundary_status": { "const": "enforced" },
        "read_only": { "const": true },
        "desktop_mutation_allowed": { "const": false },
        "desktop_source_of_truth": { "const": false },
        "matter_data_write_allowed": { "const": false },
        "task_state_write_allowed": { "const": false },
        "workflow_transition_allowed": { "const": false },
        "runtime_execution_allowed": { "const": false },
        "delivery_execution_allowed": { "const": false },
        "protected_action_allowed": { "const": false },
        "approval_decision_write_allowed": { "const": false },
        "client_facing_output_allowed_without_attorney_review": { "const": false },
        "partner_approval_bypass_allowed": { "const": false }
      }
    },
    "validation": {
      "type": "object",
      "required": ["valid", "errors"],
      "properties": {
        "valid": { "type": "boolean" },
        "errors": { "type": "array" }
      }
    },
    "summary": {
      "type": "object",
      "required": [
        "legal_approval_matrix_status",
        "legal_approval_rule_count",
        "legal_approval_output_count",
        "legal_approval_requirement_count",
        "legal_approval_gate_link_count",
        "attorney_review_required_output_count",
        "partner_approval_required_output_count",
        "client_use_blocked_output_count",
        "approval_decision_recorded_count",
        "client_facing_ready_count",
        "validation_error_count"
      ],
      "properties": {
        "legal_approval_matrix_status": { "enum": ["complete", "attention"] },
        "legal_approval_rule_count": { "type": "integer", "minimum": 6 },
        "legal_approval_output_count": { "type": "integer", "minimum": 1 },
        "legal_approval_requirement_count": { "type": "integer", "minimum": 1 },
        "legal_approval_gate_link_count": { "type": "integer", "minimum": 1 },
        "attorney_review_required_output_count": { "type": "integer", "minimum": 1 },
        "partner_approval_required_output_count": { "type": "integer", "minimum": 1 },
        "client_use_blocked_output_count": { "type": "integer", "minimum": 1 },
        "approval_decision_recorded_count": { "const": 0 },
        "client_facing_ready_count": { "const": 0 },
        "validation_error_count": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": true
    }
  }
}
